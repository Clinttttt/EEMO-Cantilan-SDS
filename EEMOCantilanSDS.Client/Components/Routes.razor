@using EEMOCantilanSDS.Client.Components.Shared

@inject NavigationManager Navigation
@inject ISetupApiClient SetupApi
@* Prerendering is enabled at the interactive root. The setup check is persisted so the static
   prerender and interactive pass don't both call the setup endpoint. *@


<CascadingAuthenticationState>
    @* NotFoundPage, not <NotFound> markup. The framework documents plainly that "Blazor Web Apps don't use the NotFound
       parameter... placing the markup doesn't result in an exception, but using the markup isn't effective either" - it is kept
       only for backward compatibility. That was verified the hard way: the <NotFound> branch shipped, and production still
       answered a mistyped address with 404 and an empty body, because endpoint routing rejects an unmatched path before any
       component renders.

       NotFoundPage is the .NET 10 mechanism for the same intent and, unlike the markup, it is designed to work together with
       status-code re-execution middleware - which Program.cs adds for the requests that never reach Blazor at all. *@
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(EEMOCantilanSDS.Client.Components.Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <AccessDenied />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>


@code {
    private bool _hasCheckedSetup = false;

    [PersistentState]
    public bool? IsSetupRequired { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (_hasCheckedSetup) return;
        _hasCheckedSetup = true;

        var currentUri = Navigation.Uri;
        if (currentUri.Contains("/account-setup-admin") || currentUri.Contains("/login"))
            return;

        try
        {
            if (IsSetupRequired is null)
            {
                var result = await SetupApi.GetSetupStatusAsync();
                IsSetupRequired = result.IsSuccess && result.Value?.IsSetupRequired == true;
            }

            if (IsSetupRequired == true)
            {
                Navigation.NavigateTo("/account-setup-admin", true);
            }
        }
        catch
        {
            
        }
    }

}
