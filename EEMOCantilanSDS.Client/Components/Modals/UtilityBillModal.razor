@using EEMOCantilanSDS.Application.Command.Utilities.RecordUtilityReading
@using EEMOCantilanSDS.Application.Command.Utilities.RecordUtilityPayment
@using EEMOCantilanSDS.Application.Dtos.Utilities
@using EEMOCantilanSDS.Domain.Enums
@inject IUtilitiesApiClient UtilitiesApi

@*
    UtilityBillModal — record an NPM stall's meter readings with per-bill rates, and optionally collect
    payment. Electricity and water are settled independently. Admin/office use.

    Only the utilities the STALL is actually billed for are shown: a stall registered with water alone has no
    electricity meter, so offering an electricity reading invited a charge against a service the vendor does
    not have. Applicability comes from the stall's own ApplicableFees flags, passed in by the caller.
*@

@* Line icons, drawn from this component's own markup so CSS isolation reaches them — a hand-built render tree
   or raw markup content would carry no scope attribute and the glyph would lose its size and ink. No emoji:
   this is an official form, and a character that renders as a colour picture on one machine and a black square
   on another has no place on it. The two delegates are rebuilt per render, which is a rounding error next to
   the render itself and the price of keeping them styled. *@
@{
    RenderFragment lockIcon =
        @<svg class="ub-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="5" y="11" width="14" height="9" rx="2" />
            <path d="M8.5 11V8a3.5 3.5 0 0 1 7 0v3" />
        </svg>;
    RenderFragment pencilIcon =
        @<svg class="ub-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 20h4L19 9l-4-4L4 16v4z" />
            <path d="M14 6l4 4" />
        </svg>;
    RenderFragment calendarIcon =
        @<svg class="ub-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 10h18M8 3v4M16 3v4" />
        </svg>;
    RenderFragment gaugeIcon =
        @<svg class="ub-ico-lg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 17a8 8 0 1 1 16 0" />
            <path d="M12 17l4-5" />
        </svg>;
    RenderFragment boltIcon =
        @<svg class="ub-ico-lg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" />
        </svg>;
    RenderFragment dropIcon =
        @<svg class="ub-ico-lg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3.2 17.3 8.5a7.5 7.5 0 1 1-10.6 0z" />
        </svg>;

    var billingPeriod = new DateTime(Year, Month, 1).ToString("MMMM yyyy");
}

@if (Show)
{
    <div class="ub-overlay" @onclick="Close">
        <div class="ub-modal" @onclick:stopPropagation="true">
            <div class="ub-head">
                <div>
                    <div class="ub-title">Utility Bill</div>
                    <div class="ub-sub">Stall @StallNo · @Occupant@(string.IsNullOrWhiteSpace(Section) ? "" : " · " + Section)</div>
                </div>
                <button class="ub-x" type="button" @onclick="Close" aria-label="Close">&times;</button>
            </div>

            <div class="ub-body">
                @if (!ShowElec && !ShowWater)
                {
                    @* Defensive: the caller should not offer this at all for such a stall. *@
                    <div class="ub-none">
                        This stall is not billed for electricity or water. Add a utility charge on the stall's
                        record first, then record a reading here.
                    </div>
                }
                @if (ShowElec)
                {
                <div class="ub-meter @(_elecStatusAsked ? "asked" : "")">
                    <div class="ub-meter-head">
                        <div class="ub-meter-id">
                            <span class="ub-meter-badge">@boltIcon</span>
                            <span class="ub-meter-name">Electricity</span>
                            <span class="ub-meter-unit">kWh</span>
                        </div>
                        <div class="ub-meter-period">@calendarIcon<span>Billing Period:</span><strong>@billingPeriod</strong></div>
                    </div>
                    <div class="ub-grid3">
                        <label>Previous Reading
                            @if (ElecReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">@ElecPrev.ToString("N2")<span class="ub-unit">kWh</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else if (ElecPrevOpen)
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" @bind="ElecPrev" @bind:event="oninput" /><span class="ub-unit">kWh</span></span>
                            }
                            else
                            {
                                <button type="button" class="ub-locked"
                                        @onclick="OpenElecPrev"
                                        title="@PrevLockHint(false)"
                                        aria-label="@($"Previous electricity reading {ElecPrev:N2}. {PrevLockHint(false)}")">
                                    <span class="ub-locked-value">@ElecPrev.ToString("N2")<span class="ub-unit">kWh</span></span>
                                    <span class="ub-locked-mark ub-locked-edit">@pencilIcon</span>
                                </button>
                            }
                        </label>
                        <label>Current Reading
                            @if (ElecReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">@ElecReadingNow.ToString("N2")<span class="ub-unit">kWh</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" placeholder="Meter now"
                                       @bind="ElecCur" @bind:event="oninput" /><span class="ub-unit">kWh</span></span>
                            }
                        </label>
                        <label>Rate
                            @if (ElecReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">₱@ElecRate.ToString("N2")<span class="ub-unit">/kWh</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" @bind="ElecRate" @bind:event="oninput" /><span class="ub-unit">/kWh</span></span>
                            }
                        </label>
                    </div>
                    @* What the readings come to. The office reads a usage figure and an amount due, not the
                       multiplication that produced them. *@
                    <div class="ub-usage">
                        <span class="ub-usage-badge">@gaugeIcon</span>
                        <div class="ub-usage-cell">
                            <span class="ub-usage-label">Usage (kWh)</span>
                            <strong class="ub-usage-value">@ElecConsumption.ToString("N2")<span class="ub-unit">kWh</span></strong>
                        </div>
                        <span class="ub-usage-sep"></span>
                        <div class="ub-usage-cell">
                            <span class="ub-usage-label">Amount Due</span>
                            <strong class="ub-usage-amount">₱@ElecCharge.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="ub-meter-foot">
                        @if (ElecReadingsSettled)
                        {
                            <div class="ub-lock-note" title="@PrevLockHint(true)">
                                <span class="ub-lock-badge">@lockIcon</span><span>@ReadingsLockedNote</span>
                            </div>
                        }
                        @if (ElecStatusLocked)
                        {
                            <button type="button" class="ub-status-unlock" @onclick="() => _elecStatusUnlocked = true"
                                    title="This electricity status is on record. Open it to change it.">
                                @pencilIcon <span>Update status</span>
                            </button>
                        }
                    </div>
                    <div class="ub-status-wrap @(ElecStatusLocked ? "locked" : "") @(_elecStatusAsked ? "asked" : "")">
                        <div class="ub-status-row">
                            <button type="button" class="ub-status @(ElecPay == PaymentStatus.Unpaid ? "on" : "")"
                                    title="@StatusChipHint(ElecStatusLocked, PaymentStatus.Unpaid)"
                                    @onclick="() => SetElecPay(PaymentStatus.Unpaid)">
                                <span>Unpaid</span>
                                @if (ElecStatusLocked && ElecPay == PaymentStatus.Unpaid) { @lockIcon }
                            </button>
                            <button type="button" class="ub-status @(ElecPay == PaymentStatus.Paid ? "on" : "")"
                                    title="@StatusChipHint(ElecStatusLocked, PaymentStatus.Paid)"
                                    @onclick="() => SetElecPay(PaymentStatus.Paid)">
                                <span>Paid</span>
                                @if (ElecStatusLocked && ElecPay == PaymentStatus.Paid) { @lockIcon }
                            </button>
                            <button type="button" class="ub-status @(ElecPay == PaymentStatus.Partial ? "on" : "")"
                                    title="@StatusChipHint(ElecStatusLocked, PaymentStatus.Partial)"
                                    @onclick="() => SetElecPay(PaymentStatus.Partial)">
                                <span>Partial</span>
                                @if (ElecStatusLocked && ElecPay == PaymentStatus.Partial) { @lockIcon }
                            </button>
                        </div>
                    </div>
                    @if (ElecPay == PaymentStatus.Partial)
                    {
                        <label class="ub-amount">Electricity partial amount<input type="number" step="0.01" min="0" @bind="ElecPartial" @bind:event="oninput" /></label>
                    }
                </div>
                }

                @if (ShowWater)
                {
                <div class="ub-meter @(_waterStatusAsked ? "asked" : "")">
                    <div class="ub-meter-head">
                        <div class="ub-meter-id">
                            <span class="ub-meter-badge">@dropIcon</span>
                            <span class="ub-meter-name">Water</span>
                            <span class="ub-meter-unit">cu.m</span>
                        </div>
                        <div class="ub-meter-period">@calendarIcon<span>Billing Period:</span><strong>@billingPeriod</strong></div>
                    </div>
                    <div class="ub-grid3">
                        <label>Previous Reading
                            @if (WaterReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">@WaterPrev.ToString("N2")<span class="ub-unit">cu.m</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else if (WaterPrevOpen)
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" @bind="WaterPrev" @bind:event="oninput" /><span class="ub-unit">cu.m</span></span>
                            }
                            else
                            {
                                <button type="button" class="ub-locked"
                                        @onclick="OpenWaterPrev"
                                        title="@PrevLockHint(false)"
                                        aria-label="@($"Previous water reading {WaterPrev:N2}. {PrevLockHint(false)}")">
                                    <span class="ub-locked-value">@WaterPrev.ToString("N2")<span class="ub-unit">cu.m</span></span>
                                    <span class="ub-locked-mark ub-locked-edit">@pencilIcon</span>
                                </button>
                            }
                        </label>
                        <label>Current Reading
                            @if (WaterReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">@WaterReadingNow.ToString("N2")<span class="ub-unit">cu.m</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" placeholder="Meter now"
                                       @bind="WaterCur" @bind:event="oninput" /><span class="ub-unit">cu.m</span></span>
                            }
                        </label>
                        <label>Rate
                            @if (WaterReadingsSettled)
                            {
                                <span class="ub-locked ub-locked-fixed" title="@PrevLockHint(true)">
                                    <span class="ub-locked-value">₱@WaterRate.ToString("N2")<span class="ub-unit">/cu.m</span></span>
                                    <span class="ub-locked-mark">@lockIcon</span>
                                </span>
                            }
                            else
                            {
                                <span class="ub-field"><input type="number" step="0.01" min="0" @bind="WaterRate" @bind:event="oninput" /><span class="ub-unit">/cu.m</span></span>
                            }
                        </label>
                    </div>
                    <div class="ub-usage">
                        <span class="ub-usage-badge">@gaugeIcon</span>
                        <div class="ub-usage-cell">
                            <span class="ub-usage-label">Usage (cu.m)</span>
                            <strong class="ub-usage-value">@WaterConsumption.ToString("N2")<span class="ub-unit">cu.m</span></strong>
                        </div>
                        <span class="ub-usage-sep"></span>
                        <div class="ub-usage-cell">
                            <span class="ub-usage-label">Amount Due</span>
                            <strong class="ub-usage-amount">₱@WaterCharge.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="ub-meter-foot">
                        @if (WaterReadingsSettled)
                        {
                            <div class="ub-lock-note" title="@PrevLockHint(true)">
                                <span class="ub-lock-badge">@lockIcon</span><span>@ReadingsLockedNote</span>
                            </div>
                        }
                        @if (WaterStatusLocked)
                        {
                            <button type="button" class="ub-status-unlock" @onclick="() => _waterStatusUnlocked = true"
                                    title="This water status is on record. Open it to change it.">
                                @pencilIcon <span>Update status</span>
                            </button>
                        }
                    </div>
                    <div class="ub-status-wrap @(WaterStatusLocked ? "locked" : "") @(_waterStatusAsked ? "asked" : "")">
                        <div class="ub-status-row">
                            <button type="button" class="ub-status @(WaterPay == PaymentStatus.Unpaid ? "on" : "")"
                                    title="@StatusChipHint(WaterStatusLocked, PaymentStatus.Unpaid)"
                                    @onclick="() => SetWaterPay(PaymentStatus.Unpaid)">
                                <span>Unpaid</span>
                                @if (WaterStatusLocked && WaterPay == PaymentStatus.Unpaid) { @lockIcon }
                            </button>
                            <button type="button" class="ub-status @(WaterPay == PaymentStatus.Paid ? "on" : "")"
                                    title="@StatusChipHint(WaterStatusLocked, PaymentStatus.Paid)"
                                    @onclick="() => SetWaterPay(PaymentStatus.Paid)">
                                <span>Paid</span>
                                @if (WaterStatusLocked && WaterPay == PaymentStatus.Paid) { @lockIcon }
                            </button>
                            <button type="button" class="ub-status @(WaterPay == PaymentStatus.Partial ? "on" : "")"
                                    title="@StatusChipHint(WaterStatusLocked, PaymentStatus.Partial)"
                                    @onclick="() => SetWaterPay(PaymentStatus.Partial)">
                                <span>Partial</span>
                                @if (WaterStatusLocked && WaterPay == PaymentStatus.Partial) { @lockIcon }
                            </button>
                        </div>
                    </div>
                    @if (WaterPay == PaymentStatus.Partial)
                    {
                        <label class="ub-amount">Water partial amount<input type="number" step="0.01" min="0" @bind="WaterPartial" @bind:event="oninput" /></label>
                    }
                </div>
                }

                <div class="ub-total"><span>Total Utility Charge</span><strong>₱@TotalCharge.ToString("N2")</strong></div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="ub-error">@Error</div>
                }

                @if (ConfirmingUpdate)
                {
                    <div class="ub-confirm">
                        <strong>Update existing utility bill?</strong>
                        <span>This month already has saved utility details. Confirming will update the readings, payment status and partial amounts currently shown here. The receipt number recorded when the payment was collected is left as it is.</span>
                    </div>
                }
            </div>

            <div class="ub-foot">
                <button type="button" class="ub-cancel" @onclick="Close" disabled="@Saving">Cancel</button>
                <button type="button" class="ub-save" @onclick="SaveAsync" disabled="@(Saving || SeedFailed)">@(Saving ? "Saving…" : ConfirmingUpdate ? "Confirm update" : "Save")</button>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public bool Show { get; set; }
    [Parameter] public Guid StallId { get; set; }
    [Parameter] public string StallNo { get; set; } = string.Empty;
    [Parameter] public string Occupant { get; set; } = string.Empty;
    [Parameter] public string Section { get; set; } = string.Empty;
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public bool RequireUpdateConfirmation { get; set; }

    /// <summary>
    /// Whether the stall is billed for electricity (its <c>ApplicableFees</c> carries the Electricity flag).
    /// Defaults to true so an older caller keeps working, but every caller in this app passes the stall's own
    /// flag — a stall with water only must not be offered an electricity reading.
    /// </summary>
    [Parameter] public bool HasElectricity { get; set; } = true;

    /// <summary>Whether the stall is billed for water.</summary>
    [Parameter] public bool HasWater { get; set; } = true;

    // What the dialog actually offers: the stall's current charges, OR a utility that already carries figures
    // on THIS month's bill. A utility can be removed from a stall after a bill was raised, and hiding it then
    // would leave a real balance impossible to see or settle.
    private bool ShowElec => HasElectricity || _seedHasElecData;
    private bool ShowWater => HasWater || _seedHasWaterData;
    private bool _seedHasElecData;
    private bool _seedHasWaterData;

    private decimal ElecPrev, ElecRate, WaterPrev, WaterRate, ElecPartial, WaterPartial;

    // This month's meter readings, unset until the office states them. A new month has no current reading by
    // definition: the box used to open pre-filled with last month's figure, which read as though the month had
    // already been read, and invited a clerk to overwrite it with the month's CONSUMPTION — refused, correctly
    // but bafflingly, as a reading that had gone backwards. Left unset, the month simply charges nothing until
    // a reading is entered.
    private decimal? ElecCur, WaterCur;
    private PaymentStatus ElecPay = PaymentStatus.Unpaid;
    private PaymentStatus WaterPay = PaymentStatus.Unpaid;
    /// <summary>
    /// The receipt numbers already on the bill. This dialog records READINGS and a payment status; the receipt
    /// number is captured where the money is taken (the collection dialog and the collector's app), so it is not
    /// asked for again here — it is sent back unchanged so re-saving a receipted month keeps its receipt.
    /// </summary>
    private string ElecOr = string.Empty;
    private string WaterOr = string.Empty;
    private string Error = string.Empty;
    private bool Saving;
    private bool ExistingBill;
    private bool ExistingRecordedPayment;
    private bool ConfirmingUpdate;
    private bool SeedFailed;
    private Guid _seededStall;
    private int _seededYear;
    private int _seededMonth;

    // A utility the stall is not billed for contributes nothing, whatever is left in the fields.
    // A reading that was never stated charges nothing: the meter stands where it did.
    private decimal ElecReadingNow => ElecCur ?? ElecPrev;
    private decimal WaterReadingNow => WaterCur ?? WaterPrev;

    private decimal ElecConsumption => ShowElec ? Math.Max(0m, ElecReadingNow - ElecPrev) : 0m;
    private decimal WaterConsumption => ShowWater ? Math.Max(0m, WaterReadingNow - WaterPrev) : 0m;
    private decimal ElecCharge => ElecConsumption * ElecRate;
    private decimal WaterCharge => WaterConsumption * WaterRate;
    private decimal TotalCharge => ElecCharge + WaterCharge;

    // ── Locks ─────────────────────────────────────────────────────────────────
    // Two things in this dialog are a record rather than an entry, and were being typed over by accident:
    //
    //  · The PREVIOUS reading is carried forward from the last bill. It is shown as the figure it is, and only
    //    becomes an input when the clerk asks for it (hover or keyboard focus reveals the pencil). A utility
    //    whose payment is already recorded cannot be reopened at all — the server locks settled readings, and
    //    the dialog says so instead of letting the clerk find out from a rejected save.
    //
    //  · The payment STATUS of a bill that is already saved is locked. Pressing a chip does not silently
    //    re-mark a receipted month; it asks first, and the row opens only when the clerk says to update it.
    private bool _elecPrevUnlocked, _waterPrevUnlocked;
    private bool _elecStatusUnlocked, _waterStatusUnlocked;
    private bool _elecStatusAsked, _waterStatusAsked;
    private bool _elecSeedSettled, _waterSeedSettled;

    /// <summary>Readings the server will refuse to change, because that utility's payment is on record.</summary>
    private bool ElecReadingsSettled => _elecSeedSettled;
    private bool WaterReadingsSettled => _waterSeedSettled;

    private bool ElecPrevOpen => _elecPrevUnlocked && !ElecReadingsSettled;
    private bool WaterPrevOpen => _waterPrevUnlocked && !WaterReadingsSettled;

    private bool ElecStatusLocked => ExistingBill && !_elecStatusUnlocked;
    private bool WaterStatusLocked => ExistingBill && !_waterStatusUnlocked;

    // A lock glyph and a pencil are drawn as line icons in the markup above; nothing here emits a character
    // that a machine might render as a picture.
    private static string StatusChipHint(bool locked, PaymentStatus status) =>
        locked
            ? "This status is on record. Use \u201cUpdate status\u201d to change it."
            : $"Mark as {status.ToString().ToLowerInvariant()}";

    private static string PrevLockHint(bool settled) =>
        settled
            ? "A payment is recorded for this utility, so its readings are locked. Reverse the payment to change them."
            : "Carried from the last reading. Click to correct it.";

    /// <summary>The same fact, short enough to sit on one line beside the lock.</summary>
    private const string ReadingsLockedNote = "Readings locked — a payment is recorded.";
    private void OpenElecPrev()
    {
        // Settled readings never render as this control, so there is nothing to refuse here — the guard only
        // keeps the invariant true if the markup ever changes.
        if (!ElecReadingsSettled) _elecPrevUnlocked = true;
    }

    private void OpenWaterPrev()
    {
        if (!WaterReadingsSettled) _waterPrevUnlocked = true;
    }

    // A locked chip does not change the status: it asks. The row opens from the prompt, never from the press
    // that was probably a mis-tap.
    private void SetElecPay(PaymentStatus status)
    {
        if (ElecStatusLocked)
        {
            _elecStatusAsked = true;
            return;
        }
        ElecPay = status;
    }

    private void SetWaterPay(PaymentStatus status)
    {
        if (WaterStatusLocked)
        {
            _waterStatusAsked = true;
            return;
        }
        WaterPay = status;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Show && (_seededStall != StallId || _seededYear != Year || _seededMonth != Month))
        {
            _seededStall = StallId;
            _seededYear = Year;
            _seededMonth = Month;
            Error = string.Empty; ElecOr = string.Empty; WaterOr = string.Empty;
            ExistingBill = false; ExistingRecordedPayment = false; ConfirmingUpdate = false; SeedFailed = false;
            ElecPay = PaymentStatus.Unpaid; WaterPay = PaymentStatus.Unpaid;
            ElecPartial = WaterPartial = 0m;
            // Every lock starts closed on a freshly opened bill: nothing carries over from the last stall.
            _elecPrevUnlocked = _waterPrevUnlocked = false;
            _elecStatusUnlocked = _waterStatusUnlocked = false;
            _elecStatusAsked = _waterStatusAsked = false;
            _elecSeedSettled = _waterSeedSettled = false;
            _seedHasElecData = false; _seedHasWaterData = false;
            ElecPrev = ElecRate = WaterPrev = WaterRate = 0m;
            ElecCur = WaterCur = null;

            var seed = await UtilitiesApi.GetBillForEntryAsync(StallId, Year, Month);
            if (seed.IsSuccess && seed.Value is { } s)
            {
                ElecPrev = s.ElecPreviousReading; ElecRate = s.ElecRatePerKwh;
                WaterPrev = s.WaterPreviousReading; WaterRate = s.WaterRatePerCubicMeter;
                // Only a month already on record has a current reading. For a new one the server carries the
                // previous forward and repeats it as the current; the form does not repeat it back at the clerk.
                ElecCur = s.Exists ? s.ElecCurrentReading : null;
                WaterCur = s.Exists ? s.WaterCurrentReading : null;

                // Keep a utility visible when this month's bill already carries figures for it, even if the
                // stall is no longer metered for it — otherwise that balance could not be seen or settled.
                _seedHasElecData = s.ElecPreviousReading > 0m || s.ElecCurrentReading > 0m;
                _seedHasWaterData = s.WaterPreviousReading > 0m || s.WaterCurrentReading > 0m;

                if (s.Exists)
                {
                    ExistingBill = true;
                    ElecPay = ParseStatus(s.ElecStatus);
                    ElecPartial = s.ElecPartialAmount;
                    WaterPay = ParseStatus(s.WaterStatus);
                    WaterPartial = s.WaterPartialAmount;
                    ElecOr = s.ElecORNumber ?? string.Empty;
                    WaterOr = s.WaterORNumber ?? string.Empty;
                    ExistingRecordedPayment = HasRecordedPayment(ElecPay, WaterPay, ElecOr, WaterOr);
                    // Per utility, as the server locks them: a settled utility's readings are fixed, the
                    // still-unpaid one on the same bill stays correctable.
                    _elecSeedSettled = ElecPay != PaymentStatus.Unpaid;
                    _waterSeedSettled = WaterPay != PaymentStatus.Unpaid;
                }
            }
            else
            {
                SeedFailed = true;
                Error = seed.Error ?? "Unable to load this utility bill. Close and try again.";
            }
            StateHasChanged();
        }
        else if (!Show)
        {
            _seededStall = Guid.Empty;
            _seededYear = 0;
            _seededMonth = 0;
            ConfirmingUpdate = false;
            SeedFailed = false;
        }
    }

    private static PaymentStatus ParseStatus(string s) =>
        Enum.TryParse<PaymentStatus>(s, out var v) ? v : PaymentStatus.Unpaid;

    private static bool HasRecordedPayment(PaymentStatus elecStatus, PaymentStatus waterStatus, string? elecOr, string? waterOr) =>
        elecStatus != PaymentStatus.Unpaid
        || waterStatus != PaymentStatus.Unpaid
        || !string.IsNullOrWhiteSpace(elecOr)
        || !string.IsNullOrWhiteSpace(waterOr);

    private Task Close()
    {
        ConfirmingUpdate = false;
        return OnClose.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (SeedFailed)
        {
            Error = "Unable to save because the bill details did not load correctly.";
            return;
        }

        if (!ShowElec && !ShowWater)
        {
            Error = "This stall is not billed for electricity or water.";
            return;
        }

        // A meter is cumulative, so this month's reading cannot be below the last one. Said with the figure it
        // must clear, because "less than the previous reading" on its own reads as a refusal without a reason.
        if (ShowElec && ElecCur is { } elecNow && elecNow < ElecPrev)
        {
            Error = $"The electricity reading must be at least {ElecPrev:N2} — a meter does not go backwards. "
                  + "Enter the figure on the meter now, not the month's consumption.";
            return;
        }
        if (ShowWater && WaterCur is { } waterNow && waterNow < WaterPrev)
        {
            Error = $"The water reading must be at least {WaterPrev:N2} — a meter does not go backwards. "
                  + "Enter the figure on the meter now, not the month's consumption.";
            return;
        }
        if (ShowElec && ElecPay == PaymentStatus.Partial && ElecPartial <= 0m)
        {
            Error = "Enter an electricity partial amount greater than ₱0.";
            return;
        }
        if (ShowWater && WaterPay == PaymentStatus.Partial && WaterPartial <= 0m)
        {
            Error = "Enter a water partial amount greater than ₱0.";
            return;
        }

        if (RequireUpdateConfirmation && ExistingBill && !ConfirmingUpdate)
        {
            Error = string.Empty;
            ConfirmingUpdate = true;
            return;
        }

        Saving = true; Error = string.Empty;

        // A utility the stall is not billed for is simply not shown, so its fields still hold exactly what the
        // server seeded and are sent back unchanged. Deliberately NOT zeroed: if a caller's flag ever
        // disagreed with stored data, zeroing would erase a real reading or a recorded payment.
        var reading = await UtilitiesApi.RecordReadingAsync(new RecordUtilityReadingCommand(
            StallId, Year, Month, ElecPrev, ElecReadingNow, ElecRate, WaterPrev, WaterReadingNow, WaterRate, null));
        if (!reading.IsSuccess || reading.Value is null)
        {
            Error = reading.Error ?? "Unable to save the readings.";
            Saving = false;
            return;
        }

        if (ExistingRecordedPayment || ElecPay != PaymentStatus.Unpaid || WaterPay != PaymentStatus.Unpaid)
        {
            var payment = await UtilitiesApi.RecordPaymentAsync(new RecordUtilityPaymentCommand(
                reading.Value.Id,
                ElecPay, ElecPay == PaymentStatus.Partial ? ElecPartial : null,
                WaterPay, WaterPay == PaymentStatus.Partial ? WaterPartial : null,
                string.IsNullOrWhiteSpace(ElecOr) ? null : ElecOr.Trim(),
                string.IsNullOrWhiteSpace(WaterOr) ? null : WaterOr.Trim(),
                null));
            if (!payment.IsSuccess)
            {
                Error = payment.Error ?? "Readings saved, but the payment could not be recorded.";
                Saving = false;
                return;
            }
        }

        Saving = false;
        await OnSaved.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
