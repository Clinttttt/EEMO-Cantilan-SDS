@page "/reset-password/{Token}"
@attribute [AllowAnonymous]

@using EEMOCantilanSDS.Application.Command.Auth.AdminAuth.ResetPasswordByToken
@using EEMOCantilanSDS.Application.Dtos.Tenancy
@using Microsoft.AspNetCore.WebUtilities
@inject IAuthApiClient AuthApi
@inject IMunicipalitiesApiClient MunicipalitiesApi
@inject NavigationManager Navigation

<PageTitle>@OfficeAcronym StallTrack — Reset Password</PageTitle>

@*
    Self-service password reset — step 2 of 2 (set the new password).

    The one-time token from the emailed link is the only credential; the server validates it, consumes it,
    and never says WHY a token failed (invalid / expired / already used all return one generic message).
    Per-LGU: ?lgu={code} carried in the emailed link themes this page to the right municipality.
*@

<div class="setup-root">

    <!-- Left panel — per-LGU branding (defaults to Cantilan, the default LGU) -->
    <div class="setup-left">
        <div class="setup-left-inner">
            <div class="setup-seal government-seals">
                <div class="government-logo-card">
                    <img src="@SealPath" alt="@MunicipalityName seal" />
                </div>
            </div>
            <div class="setup-brand">
                <div class="setup-brand-label">Republic of the Philippines</div>
                <div class="setup-brand-city">Municipality of @MunicipalityName</div>
                <div class="setup-brand-title">@OfficeAcronym</div>
                <div class="setup-brand-sub">@OfficeName</div>
            </div>
            <div class="login-secure-access">
                <div class="login-secure-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                        <rect x="9" y="10" width="6" height="5" rx="1" />
                        <path d="M10.5 10V8.5a1.5 1.5 0 013 0V10" />
                    </svg>
                </div>
                <div>
                    <div class="login-secure-title">Secure single-use link</div>
                    <p>This link works once and expires shortly after it was sent.</p>
                </div>
            </div>
            <div class="setup-left-footer">
                <div class="setup-system-name">Revenue Collection System</div>
                <div class="setup-version">Password Reset</div>
            </div>
        </div>
    </div>

    <!-- Right panel -->
    <div class="setup-right @(Done ? "setup-right-activated" : "")">
        <div class="setup-form-wrap">
            <section class="login-card">

                @if (Done)
                {
                    <div class="setup-form-header">
                        <div class="login-header-icon activated-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </div>
                        <div class="setup-form-title">Password updated</div>
                        <div class="setup-form-desc">
                            Your new password is active and you have been signed out everywhere else.
                            Sign in with your username and new password.
                        </div>
                    </div>
                    <button class="setup-submit" @onclick="GoToLogin">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                        </svg>
                        <span>Continue to sign in</span>
                    </button>
                }
                else if (string.IsNullOrWhiteSpace(Token))
                {
                    <div class="setup-form-header">
                        <div class="setup-form-title">Invalid reset link</div>
                        <div class="setup-form-desc">
                            This link is missing its secure token. Please open the exact link from your
                            password reset email.
                        </div>
                    </div>
                    <button class="setup-submit" @onclick="GoToForgot">
                        <span>Request a new link</span>
                    </button>
                }
                else
                {
                    <div class="setup-form-header">
                        <div class="login-header-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </div>
                        <div class="setup-form-title">Set a new password</div>
                        <div class="setup-form-desc">
                            Choose a new password for your account. Your username does not change.
                        </div>
                    </div>

                    <div class="setup-form">

                        <!-- New Password -->
                        <div class="form-group">
                            <label class="form-label">New Password</label>
                            <div class="form-input-wrap-password">
                                <div class="form-input-wrap @(GetFieldError("Password") != string.Empty ? "form-input-error" : "")">
                                    <svg class="form-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                        <path d="M7 11V7a5 5 0 0110 0v4" />
                                    </svg>
                                    <input @key="@ShowPassword"
                                           value="@Password"
                                           @oninput="@((e) => Password = e.Value?.ToString() ?? string.Empty)"
                                           type="@(ShowPassword ? "text" : "password")"
                                           class="form-input form-input-password"
                                           placeholder="Min. 8 characters, with a letter and a number"
                                           autocomplete="new-password" />
                                    <button type="button" class="form-eye-btn" @onclick="TogglePassword" @onclick:stopPropagation="true">
                                        @if (ShowPassword)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
                                                <line x1="1" y1="1" x2="23" y2="23" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </div>
                            @if (GetFieldError("Password") != string.Empty)
                            {
                                <span class="form-error">@GetFieldError("Password")</span>
                            }
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group">
                            <label class="form-label">Confirm Password</label>
                            <div class="form-input-wrap @(GetFieldError("ConfirmPassword") != string.Empty ? "form-input-error" : "")">
                                <svg class="form-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0110 0v4" />
                                </svg>
                                <input @key="@ShowPassword"
                                       value="@ConfirmPassword"
                                       @oninput="@((e) => ConfirmPassword = e.Value?.ToString() ?? string.Empty)"
                                       type="@(ShowPassword ? "text" : "password")"
                                       class="form-input"
                                       placeholder="Re-enter password"
                                       autocomplete="new-password" />
                            </div>
                            @if (GetFieldError("ConfirmPassword") != string.Empty)
                            {
                                <span class="form-error">@GetFieldError("ConfirmPassword")</span>
                            }
                        </div>

                        <!-- Password strength -->
                        @if (!string.IsNullOrEmpty(Password))
                        {
                            var strength = GetPasswordStrength(Password);
                            <div class="pw-strength">
                                <div class="pw-strength-bars">
                                    <div class="pw-bar @(strength >= 1 ? "pw-bar-fill pw-" + GetStrengthClass(strength) : "")"></div>
                                    <div class="pw-bar @(strength >= 2 ? "pw-bar-fill pw-" + GetStrengthClass(strength) : "")"></div>
                                    <div class="pw-bar @(strength >= 3 ? "pw-bar-fill pw-" + GetStrengthClass(strength) : "")"></div>
                                    <div class="pw-bar @(strength >= 4 ? "pw-bar-fill pw-" + GetStrengthClass(strength) : "")"></div>
                                </div>
                                <span class="pw-strength-label pw-@GetStrengthClass(strength)">@GetStrengthLabel(strength)</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="setup-error">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="15" y1="9" x2="9" y2="15" />
                                    <line x1="9" y1="9" x2="15" y2="15" />
                                </svg>
                                @ErrorMessage
                            </div>
                        }

                        <button class="setup-submit @(IsLoading ? "setup-submit-loading" : "")"
                                @onclick="HandleSubmit"
                                disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="setup-spinner"></span>
                                <span>Updating…</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                                <span>Update password</span>
                            }
                        </button>

                        @if (LinkFailed)
                        {
                            <button type="button" class="login-forgot" @onclick="GoToForgot">Request a new reset link</button>
                        }

                        <div class="setup-secure-note">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                            <span>Please keep your credentials secure and do not share them with anyone.</span>
                        </div>

                    </div><!-- end form -->
                }

            </section>
        </div>
    </div>

</div>

@code {
    [Parameter] public string? Token { get; set; }

    string Password = string.Empty;
    string ConfirmPassword = string.Empty;
    bool ShowPassword;
    bool IsLoading;
    bool Done;
    bool LinkFailed;
    string ErrorMessage = string.Empty;
    Dictionary<string, string> FieldErrors = new();

    // ── Per-LGU branding (defaults are Cantilan's, so the default LGU is unchanged) ──
    const string DefaultSealPath = "/images/LGU_CANTILAN_LOGO.jpg";
    const string NeutralSealPath = "/images/stalltrack-seal.png";
    string SealPath = DefaultSealPath;
    string MunicipalityName = "Cantilan";
    string OfficeAcronym = "EEMO";
    string OfficeName = "Economic Enterprise and Management Office";
    string LguParam = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("lgu", out var lguValues))
        {
            var lgu = lguValues.ToString().Trim();
            if (!string.IsNullOrEmpty(lgu))
            {
                LguParam = lgu;
                try
                {
                    var branding = await MunicipalitiesApi.GetBrandingByIdentifierAsync(lgu);
                    if (branding.IsSuccess && branding.Value is not null)
                        ApplyBranding(branding.Value);
                }
                catch { /* keep the default branding on any failure — never block the reset */ }
            }
        }
    }

    void ApplyBranding(MunicipalityBrandingDto b)
    {
        var isCantilan = string.Equals(b.Code, "CANTILAN", StringComparison.OrdinalIgnoreCase);
        SealPath = !string.IsNullOrWhiteSpace(b.SealPath) ? b.SealPath!
            : isCantilan ? DefaultSealPath : NeutralSealPath;
        MunicipalityName = string.IsNullOrWhiteSpace(b.Name) ? "Cantilan" : b.Name;
        OfficeAcronym = !string.IsNullOrWhiteSpace(b.OfficeAcronym) ? b.OfficeAcronym!
            : isCantilan ? "EEMO" : MunicipalityName;
        OfficeName = string.IsNullOrWhiteSpace(b.OfficeName) ? "Economic Enterprise and Management Office" : b.OfficeName;
    }

    void TogglePassword(MouseEventArgs e)
    {
        ShowPassword = !ShowPassword;
        StateHasChanged();
    }

    string GetFieldError(string fieldName) => FieldErrors.TryGetValue(fieldName, out var v) ? v : string.Empty;

    async Task HandleSubmit()
    {
        ErrorMessage = string.Empty;
        LinkFailed = false;
        FieldErrors.Clear();

        if (string.IsNullOrWhiteSpace(Token))
        {
            ErrorMessage = "This reset link is invalid.";
            return;
        }
        // Mirrors the server-side policy (and the activation page) so the user gets immediate feedback.
        if (string.IsNullOrWhiteSpace(Password) || Password.Length < 8)
        {
            FieldErrors["Password"] = "Password must be at least 8 characters.";
            return;
        }
        if (!Password.Any(char.IsLetter) || !Password.Any(char.IsDigit))
        {
            FieldErrors["Password"] = "Password must contain a letter and a number.";
            return;
        }
        if (Password != ConfirmPassword)
        {
            FieldErrors["ConfirmPassword"] = "Passwords do not match.";
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            var result = await AuthApi.ResetPasswordByTokenAsync(new ResetPasswordByTokenCommand(Token!, Password));

            if (result.IsSuccess)
            {
                Done = true;
            }
            else if (result.ValidationErrors is not null && result.ValidationErrors.Any())
            {
                var first = result.ValidationErrors.First();
                FieldErrors["Password"] = first.Value.FirstOrDefault() ?? "Please choose a stronger password.";
            }
            else
            {
                // Single generic server message (invalid / expired / already used) — offer a fresh link.
                ErrorMessage = result.Error ?? "This password reset link is invalid or has expired.";
                LinkFailed = true;
            }
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    void GoToLogin() =>
        Navigation.NavigateTo(string.IsNullOrEmpty(LguParam) ? "/login" : $"/login?lgu={Uri.EscapeDataString(LguParam)}");

    void GoToForgot() =>
        Navigation.NavigateTo(string.IsNullOrEmpty(LguParam) ? "/forgot-password" : $"/forgot-password?lgu={Uri.EscapeDataString(LguParam)}");

    int GetPasswordStrength(string pw)
    {
        int score = 0;
        if (pw.Length >= 8) score++;
        if (pw.Any(char.IsUpper)) score++;
        if (pw.Any(char.IsDigit)) score++;
        if (pw.Any(c => !char.IsLetterOrDigit(c))) score++;
        return score;
    }

    string GetStrengthClass(int strength) => strength switch
    {
        1 => "weak",
        2 => "fair",
        3 => "good",
        4 => "strong",
        _ => ""
    };

    string GetStrengthLabel(int strength) => strength switch
    {
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => ""
    };
}
