@page "/stall-holders"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.StallHolders
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Client.Exports
@inject IStallsApiClient StallsApi
@inject IJSRuntime JS
@inject IObligationsApiClient ObligationsApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

@* ───────────────────────────────────────────────────────────────────────────────
   All-facilities Stall & Space Holder Register. Two kinds of holder, each owned by its own source:

   - STALL rentals: the rental/stall facilities — NPM, TCC, NCC, BBQ, ICE. SLH (per-head), TRM (per-trip) and TPM (weekly
     market) are NOT stall-based and are intentionally excluded. Per-facility shape differs: NPM is grouped by market
     section; NCC carries an Area Location column; the rest are a flat list. Data reuses GetStallHoldersListAsync (one call
     per stall facility).
   - SPACE rentals: the recurring monthly space rentals (Vegetable / Fruits, Kanmanggay), read from their own obligation
     accounts. Fiesta / Araw is event-based — a lot is let for an event, not held — so it is deliberately not a holder here.

   Facility/source filter, scope and search are client-side over the loaded data. Rates are never summed across sources: a
   daily stall fee, a monthly stall rent and a monthly space rent are different things, so each source states its own total.
   ─────────────────────────────────────────────────────────────────────────────── *@

<PageTitle>StallTrack — Stall &amp; Space Holder Register</PageTitle>

<header class="topbar no-print">
    <div class="topbar-left">
        <div class="topbar-title">Stall &amp; Space Holder Register</div>
        <div class="topbar-breadcrumb">
            <a href="/menu" class="breadcrumb-link">@Branding.OfficeAcronym Admin</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Stall &amp; Space Holder Register</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-period">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            As of <strong>@PhilippineTime.Today.ToString("MMM d, yyyy")</strong>
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    @* ONE coordinated control band. Holder kind and source on the left; search, the joined export actions and the year on the
       right. The source selector follows the kind: stall facilities, space sources, or both. *@
    <div class="sh-bar no-print">
        <div class="sh-bar-filters">
            <div class="sh-filter" role="group" aria-label="Kind of holder">
                <button class="sh-chip @(_scope == HolderScope.All ? "sh-chip-active" : "")" type="button" aria-pressed="@(_scope == HolderScope.All ? "true" : "false")" @onclick="@(() => SelectScope(HolderScope.All))">All holders</button>
                <button class="sh-chip @(_scope == HolderScope.Stall ? "sh-chip-active" : "")" type="button" aria-pressed="@(_scope == HolderScope.Stall ? "true" : "false")" @onclick="@(() => SelectScope(HolderScope.Stall))">Stall rentals</button>
                <button class="sh-chip @(_scope == HolderScope.Space ? "sh-chip-active" : "")" type="button" aria-pressed="@(_scope == HolderScope.Space ? "true" : "false")" @onclick="@(() => SelectScope(HolderScope.Space))">Space rentals</button>
            </div>
            <FhSelect Caption="Source" Value="@SourceValue" Options="@SourceOptions" ValueChanged="@SelectSource" />
        </div>
        <div class="sh-bar-tools">
            <div class="sh-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="Search occupant, contract, stall / space…" value="@_search" @oninput="OnSearchInput" aria-label="Search stall and space holders" />
                @if (HasSearch)
                {
                    <button class="sh-search-clear" type="button" @onclick="ClearSearch" aria-label="Clear search">&times;</button>
                }
            </div>
            @* Print, Excel, CSV and Save as PDF are one joined control: four ways to take the same register, each its own action. *@
            <div class="sh-split sh-export" role="group" aria-label="Print or download the stall and space holder register">
                <button class="sh-print-btn sh-split-part" type="button" disabled="@_loading" @onclick="Print"
                        title="Opens the print dialog — the sheet prints landscape so every column fits.">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                    Print
                </button>
                <button class="sh-print-btn sh-split-part" type="button" disabled="@_loading" @onclick="DownloadExcel"
                        title="Downloads an Excel workbook with the columns already sized.">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Excel
                </button>
                <a class="sh-print-btn sh-split-part" download="@CsvFileName" href="@CsvHref"
                   title="Downloads the same list as a plain CSV data file.">
                    CSV
                </a>
                <button class="sh-print-btn sh-print-btn-primary sh-split-part" type="button" disabled="@_loading" @onclick="Print"
                        title="Opens the print dialog — choose &quot;Save as PDF&quot; as the destination.">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    Save as PDF
                </button>
            </div>

            @* The year the roster is stated AS OF, so the office can answer who held the stalls in an earlier year. The same
               control the report pages use, in year mode - a roster is always as of some year, so there is no "all years". *@
            <div class="sh-year-nav">
                <ReportPeriodNav Year="_year" Month="1" Yearly="true" Label="@YearLabel"
                                 OnPrev="PrevYear" OnNext="NextYear"
                                 OnPick="PickYear" OnToday="JumpToCurrentYear" />
            </div>
        </div>
    </div>

    @* Sections of the selected facility, straight from its data: a facility with a single section shows no
       rail, and each LGU's own section labels appear without being named here. *@
    @if (_scope != HolderScope.Space && SelectableSections.Count > 1)
    {
        <div class="sh-controls sh-controls-sub no-print">
            <div class="sh-filter">
                <button class="sh-chip @(_section is null ? "sh-chip-active" : "")" type="button"
                        @onclick="@(() => SelectSection(null))">All Sections</button>
                @foreach (var section in SelectableSections)
                {
                    var name = section.SectionName;
                    <button class="sh-chip @(_section == name ? "sh-chip-active" : "")" type="button"
                            @onclick="@(() => SelectSection(name))">@SectionDisplay(name)</button>
                }
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="sh-loading no-print" aria-busy="true" aria-label="Loading stall and space holder register">
            <div class="sh-summary">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="sh-sum-card">
                        <Skeleton Width="58%" Height="21px" Radius="7px" Class="sh-sk-center" />
                        <Skeleton Width="50%" Height="11px" Radius="5px" Class="sh-sk-center sh-sk-gap" />
                    </div>
                }
            </div>

            <section class="sh-sheet">
                <header class="sh-rpt-head">
                    <Skeleton Width="54px" Height="54px" Radius="999px" Class="sh-sk-center" />
                    <Skeleton Width="190px" Height="9px" Radius="5px" Class="sh-sk-center sh-sk-gap" />
                    <Skeleton Width="280px" Height="16px" Radius="6px" Class="sh-sk-center sh-sk-gap" />
                    <Skeleton Width="230px" Height="11px" Radius="5px" Class="sh-sk-center sh-sk-gap" />
                    <Skeleton Width="300px" Height="20px" Radius="999px" Class="sh-sk-center sh-sk-gap" />
                </header>

                @for (var section = 0; section < 2; section++)
                {
                    <div class="sh-facility">
                        <div class="sh-fac-head">
                            <div class="sh-fac-title">
                                <Skeleton Width="42px" Height="24px" Radius="7px" />
                                <Skeleton Width="180px" Height="17px" Radius="6px" />
                                <Skeleton Width="96px" Height="18px" Radius="999px" />
                            </div>
                            <Skeleton Width="190px" Height="14px" Radius="6px" />
                        </div>
                        <Skeleton Height="34px" Radius="7px" />
                        <div class="sh-table-skeleton">
                            <Skeleton Height="34px" Radius="7px" />
                            @for (var row = 0; row < 3; row++)
                            {
                                <Skeleton Height="32px" Radius="7px" />
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
    else if (NeedsStalls && _data.Count == 0)
    {
        <div class="sh-state sh-state-error" role="alert">
            Unable to load the stall holder register.
            <button class="sh-retry" type="button" @onclick="Load">Try again</button>
        </div>
    }
    else
    {
        var visible = NeedsStalls ? VisibleFacilities() : [];
        var allRows = visible.SelectMany(RowsFor).ToList();
        var activeRows = allRows.Where(r => !r.IsClosed).ToList();
        var spaceGroups = NeedsSpaces ? VisibleSpaceGroups() : [];
        var spaceRows = spaceGroups.SelectMany(g => g.Rows).ToList();
        var anyRows = allRows.Count > 0 || spaceRows.Count > 0;

        if (NeedsSpaces && _spaceError is not null)
        {
            <div class="sh-state sh-state-error no-print" role="alert">
                @_spaceError
                <button class="sh-retry" type="button" @onclick="LoadSpaces">Try again</button>
            </div>
        }

        <!-- Quick-glance counts (screen only — excluded from print / PDF). Counts only: a daily stall fee, a monthly stall rent
             and a monthly space rent are different things, so no rate is summed across sources — each source states its own. -->
        <div class="sh-summary no-print">
            @if (NeedsStalls)
            {
                <div class="sh-sum-card">
                    <div class="sh-sum-val">@activeRows.Count</div>
                    <div class="sh-sum-lbl">Active Stalls</div>
                </div>
            }
            @if (NeedsSpaces && AsOfYear is null)
            {
                <div class="sh-sum-card">
                    <div class="sh-sum-val">@spaceGroups.Where(g => !IsEvent(g.Source.Kind)).Sum(g => g.Rows.Count)</div>
                    <div class="sh-sum-lbl">Active Spaces</div>
                </div>
            }
            @if (NeedsSpaces && spaceGroups.Any(g => IsEvent(g.Source.Kind) && g.Rows.Count > 0))
            {
                <div class="sh-sum-card">
                    <div class="sh-sum-val">@spaceGroups.Where(g => IsEvent(g.Source.Kind)).Sum(g => g.Rows.Count)</div>
                    <div class="sh-sum-lbl">Event Lots · @_year</div>
                </div>
            }
            <div class="sh-sum-card">
                <div class="sh-sum-val">@(visible.Count(f => RowsFor(f).Any()) + spaceGroups.Count(g => g.Rows.Count > 0))</div>
                <div class="sh-sum-lbl">Sources</div>
            </div>
        </div>

        <section class="sh-sheet @(_facility is not null ? "sh-sheet-single" : "") @(IsSectionFiltered ? "sh-sheet-section" : "")">
            <header class="sh-rpt-head">
                <img class="sh-seal" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
                <div class="sh-gov">Republic of the Philippines</div>
                <div class="sh-org">@Branding.OfficeName</div>
                <div class="sh-muni">Municipality of @Branding.Municipality, @Branding.Province</div>
                @* Stacked like the per-facility roster: the document is named, then its scope on its own line,
                   instead of both crammed into one sentence. *@
                <div class="sh-doc">Stall &amp; Space Holder Register</div>
                <div class="sh-doc-scope">@ScopeLabel</div>
                @if (AsOfYear is { } statedYear)
                {
                    @* A historical roster says so ON THE SHEET, not merely in the toolbar that produced it. A printed page
                       leaves the screen behind, and a 2019 register handed to a panel while presenting itself as the current
                       one is the sort of document nobody can correct later. *@
                    <div class="sh-doc-asof">AS OF DECEMBER 31, @statedYear</div>
                }
                @if (IsSectionFiltered)
                {
                    @* Stated once here, so the band inside the table is not repeated. *@
                    <div class="sh-doc-section">@SectionDisplay(_section!).ToUpper()</div>
                }
            </header>

            @if (!anyRows)
            {
                <div class="sh-state">No stall or space holders match your current filter@(HasSearch ? " and search" : "").</div>
            }

            @if (NeedsSpaces && AsOfYear is not null)
            {
                @* The space accounts keep their current amounts and contract particulars, not a year-end snapshot, so they are
                   left out of an earlier year rather than stated as if they were reconstructed. *@
                <p class="sh-asof-note">Monthly space rentals are a current register and are not shown for an earlier year. Event lots are listed by the year of their event.</p>
            }

            @foreach (var fc in visible)
            {
                var facRows = RowsFor(fc).ToList();
                if (facRows.Count == 0) continue;
                var facActive = facRows.Where(r => !r.IsClosed).ToList();

                <div class="sh-facility">
                    <div class="sh-fac-head">
                        <div class="sh-fac-title">
                            <span class="sh-fac-name">@FacilityCatalog.NameOf(fc)</span>
                            <span class="sh-tag">@Model(fc)</span>
                        </div>
                        <div class="sh-fac-stats">
                            <span><strong>@facActive.Count</strong> active</span>
                            <span><strong>@Money(facActive.Sum(r => r.MonthlyRentalRate))</strong> monthly</span>
                        </div>
                    </div>

                    @if (fc == FacilityCode.NPM)
                    {
                        @foreach (var section in SectionsFor(fc))
                        {
                            var secRows = section.Rows.Where(MatchSearch).ToList();
                            if (secRows.Count == 0) continue;
                            <div class="sh-section-label">
                                @SectionDisplay(section.SectionName)
                                <span>@secRows.Count stall@(secRows.Count != 1 ? "s" : "")</span>
                            </div>
                            @HolderTable(fc, secRows)
                        }
                    }
                    else
                    {
                        @HolderTable(fc, facRows)
                    }
                </div>
            }

            @foreach (var group in spaceGroups)
            {
                if (group.Rows.Count == 0) continue;
                var isEvent = IsEvent(group.Source.Kind);
                var groupMonthly = group.Rows.Sum(a => a.CurrentAmount ?? 0m);

                <div class="sh-facility">
                    <div class="sh-fac-head">
                        <div class="sh-fac-title">
                            <span class="sh-fac-name">@group.Source.Name</span>
                            <span class="sh-tag">@(isEvent ? "Event lots" : "Space rental")</span>
                        </div>
                        <div class="sh-fac-stats">
                            @if (isEvent)
                            {
                                @* An event fee is not a rent: lots are counted, and no monthly or annual figure is worked out from them. *@
                                <span><strong>@group.Rows.Count</strong> lot@(group.Rows.Count != 1 ? "s" : "") in @_year</span>
                            }
                            else
                            {
                                <span><strong>@group.Rows.Count</strong> active</span>
                                <span><strong>@Money(groupMonthly)</strong> monthly</span>
                            }
                        </div>
                    </div>
                    @if (isEvent) { @EventTable(group.Rows) } else { @SpaceTable(group.Rows) }
                </div>
            }

            <div class="sh-rpt-foot no-print">
                <SignatureStrip ShowDatePrepared="true" />
            </div>
        </section>
    }
</div>

@code {
    private IReadOnlyList<FacilityCode> StallFacilities => FacilityCatalog.Rental;

    private enum HolderScope { All, Stall, Space }

    private readonly Dictionary<FacilityCode, StallHoldersListDto> _data = new();
    private bool _loading = true;
    private HolderScope _scope = HolderScope.All;
    private FacilityCode? _facility;   // null = all
    private string? _section;          // null = every section of the selected facility
    private string _search = "";

    // The space sources, each read from its own obligation account register: the recurring monthly space rentals, and the
    // event-based Fiesta / Araw lots.
    private static readonly IReadOnlyList<SpaceAccountPresentation> SpaceSources =
        [SpaceAccountPresentation.VegetableFruit, SpaceAccountPresentation.Kanmanggay, SpaceAccountPresentation.FiestaAraw];

    // Fiesta / Araw lots are let for an event, not held month to month: they are listed as event lots with their event and date,
    // never given a monthly rate, a term or a contract the source does not hold.
    private static bool IsEvent(ObligationKind kind) => kind == ObligationKind.FiestaArawLotRental;
    private ObligationKind? _spaceSource;   // null = every space source
    private readonly Dictionary<ObligationKind, IReadOnlyList<ObligationAccountDto>> _spaces = new();
    private string? _spaceError;

    [PersistentState(AllowUpdates = true)]
    public List<ObligationAccountDto>? CachedSpaceHolders { get; set; }

    // A space source chosen while viewing every holder narrows the register to that source, exactly as the Space rentals kind does.
    private HolderScope ViewScope => _scope == HolderScope.All && _spaceSource is not null ? HolderScope.Space : _scope;
    private bool NeedsStalls => ViewScope != HolderScope.Space;
    private bool NeedsSpaces => ViewScope == HolderScope.Space || (ViewScope == HolderScope.All && _facility is null);

    // The one Source selector: stall facilities and/or space sources, following the kind of holder being viewed.
    private string SourceValue => _spaceSource is { } kind ? $"S:{(int)kind}" : _facility is { } code ? $"F:{code}" : "";

    private IReadOnlyList<(string Value, string Label)> SourceOptions
    {
        get
        {
            var options = new List<(string, string)> { ("", _scope == HolderScope.Space ? "All spaces" : _scope == HolderScope.Stall ? "All facilities" : "All sources") };
            if (_scope != HolderScope.Space)
                options.AddRange(StallFacilities.Select(code => ($"F:{code}", FacilityCatalog.NameOf(code))));
            if (_scope != HolderScope.Stall)
                options.AddRange(SpaceSources.Select(source => ($"S:{(int)source.Kind}", source.Name)));
            return options;
        }
    }

    private void SelectSource(string value)
    {
        _section = null;
        _facility = null;
        _spaceSource = null;
        if (value.StartsWith("F:", StringComparison.Ordinal) && Enum.TryParse<FacilityCode>(value[2..], out var code)) _facility = code;
        else if (value.StartsWith("S:", StringComparison.Ordinal) && int.TryParse(value[2..], out var kind)) _spaceSource = (ObligationKind)kind;
    }

    // The year the roster is stated AS OF. Defaults to the current year, where it means today — so the register the office
    // opens every day is what it has always been, and only stepping back changes the question being asked.
    private int _year = DateTime.Now.Year;

    /// <summary>Null for the current year, so the everyday request is the same one it always was.</summary>
    private int? AsOfYear => _year == DateTime.Now.Year ? null : _year;

    private string YearLabel => _year == DateTime.Now.Year ? $"{_year}" : $"As of {_year}";

    [PersistentState(AllowUpdates = true)]
    public List<StallHolderFacilityState>? CachedStallHolders { get; set; }

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    // Changing facility drops any section filter: sections belong to a facility, so keeping one would silently
    // filter the new facility by a section it does not have.
    private void SelectFacility(FacilityCode? code)
    {
        _facility = code;
        _section = null;
    }

    // A scope is a different question, so the facility and section filters of the other scope do not carry over.
    private void SelectScope(HolderScope scope)
    {
        _scope = scope;
        _facility = null;
        _section = null;
        _spaceSource = null;
    }

    private void SelectSpaceSource(ObligationKind? kind) => _spaceSource = kind;

    private void SelectSection(string? section) => _section = section;
    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";
    private void ClearSearch() => _search = "";

    // Stepping the year re-reads the register, because the answer comes from the server: an earlier year is drawn from the
    // contract history, and the rows already on screen hold only the people who are here now.
    //
    // Not stepped past the current year. There is no roster for a year that has not happened, and offering one would invite
    // the office to print an empty sheet and wonder what it had done wrong.
    private Task PrevYear() => GoToYear(_year - 1);

    private Task NextYear() => GoToYear(Math.Min(_year + 1, DateTime.Now.Year));

    private Task PickYear((int Year, int Month) picked) => GoToYear(Math.Min(picked.Year, DateTime.Now.Year));

    private Task JumpToCurrentYear() => GoToYear(DateTime.Now.Year);

    private async Task GoToYear(int year)
    {
        if (year == _year) return;

        _year = year;

        // The cached copy is this page's fast reopen for the CURRENT register. A historical read must not overwrite it, or
        // the office would come back tomorrow to a roster stating 2019 with nothing on screen saying so.
        CachedStallHolders = null;
        await Load();
    }

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();

        // The space accounts are a second, independent source, read alongside the stalls rather than after them. A cached copy
        // answers a reopen without another call, exactly as the stall cache does.
        Task spaces = Task.CompletedTask;
        if (CachedSpaceHolders is not null) ApplySpaces(CachedSpaceHolders);
        else spaces = LoadSpaces();

        if (CachedStallHolders is not null)
        {
            ApplyStallHolders(CachedStallHolders);
            _loading = false;
            await spaces;
            return;
        }

        await Load();
        await spaces;
    }

    private async Task LoadSpaces()
    {
        _spaceError = null;
        List<ObligationAccountDto>? loaded = null;

        // Cold-start resilience, as for the stalls: tolerate the brief window before the circuit attaches the JWT.
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var tasks = SpaceSources.ToDictionary(s => s.Kind, s => ObligationsApi.GetAccountsAsync(s.Kind));
            await Task.WhenAll(tasks.Values);

            var accounts = new List<ObligationAccountDto>();
            var authPending = false;
            var failed = new List<string>();
            foreach (var source in SpaceSources)
            {
                var result = await tasks[source.Kind];
                if (result.IsSuccess && result.Value is not null) accounts.AddRange(result.Value);
                else if (result.Status is ResultStatus.Unauthorized or ResultStatus.Forbidden) authPending = true;
                else failed.Add(source.Name);
            }

            if (!authPending)
            {
                loaded = accounts;
                if (failed.Count > 0)
                    _spaceError = $"The {string.Join(" and ", failed)} space holders could not be loaded.";
                break;
            }
            await Task.Delay(400);
        }

        if (loaded is null) _spaceError = "The space holders could not be loaded.";
        else
        {
            ApplySpaces(loaded);
            // Only a complete read is cached, so a partial failure is retried rather than reopened as the full register.
            CachedSpaceHolders = _spaceError is null ? loaded : null;
        }
    }

    private void ApplySpaces(IEnumerable<ObligationAccountDto> accounts)
    {
        _spaces.Clear();
        foreach (var group in accounts.GroupBy(a => a.Kind))
            _spaces[group.Key] = group.ToList();
    }

    private async Task Load()
    {
        _loading = true;
        _data.Clear();
        await PaintLoadingStateAsync();

        // Cold-start resilience: tolerate the brief window before the circuit attaches the JWT.
        for (var attempt = 0; attempt < 5; attempt++)
        {
            // Load every facility in parallel (independent requests) — ~1 round-trip instead of 5
            // sequential ones. Mirrors the Task.WhenAll pattern used by the facility pages.
            var tasks = StallFacilities.ToDictionary(
                code => code,
                code => StallsApi.GetStallHoldersListAsync(code, null, null, AsOfYear));
            await Task.WhenAll(tasks.Values);

            var loaded = new Dictionary<FacilityCode, StallHoldersListDto>();
            var authPending = false;
            foreach (var (code, task) in tasks)
            {
                var result = await task;
                if (result.IsSuccess && result.Value is not null)
                    loaded[code] = result.Value;
                else if (result.Status is ResultStatus.Unauthorized or ResultStatus.Forbidden)
                    authPending = true;
            }

            if (!authPending)
            {
                foreach (var kvp in loaded) _data[kvp.Key] = kvp.Value;

                // Only the CURRENT register is cached for a fast reopen. Persisting a historical read would have the office
                // return to a 2019 roster presented as today's.
                CachedStallHolders = AsOfYear is null
                    ? _data.Select(kvp => new StallHolderFacilityState(kvp.Key, kvp.Value)).ToList()
                    : null;
                break;
            }
            await Task.Delay(400);
        }

        _loading = false;
    }

    private void ApplyStallHolders(IEnumerable<StallHolderFacilityState> states)
    {
        _data.Clear();
        foreach (var state in states)
            _data[state.FacilityCode] = state.Data;
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private IReadOnlyList<FacilityCode> VisibleFacilities() =>
        StallFacilities.Where(c => (_facility is null || _facility == c) && _data.ContainsKey(c)).ToList();

    /// <summary>
    /// Sections of the selected facility that still have rows, in the order the API returned them. Drives the
    /// section rail, so a facility with one section (or none) shows no rail and every LGU's own section names
    /// appear without being hardcoded here.
    /// </summary>
    private IReadOnlyList<StallHoldersSectionDto> SelectableSections =>
        _facility is not null && _data.TryGetValue(_facility.Value, out var dto)
            ? dto.Sections.Where(s => s.Rows.Count > 0).ToList()
            : Array.Empty<StallHoldersSectionDto>();

    private bool IsSectionFiltered => _section is not null;

    private bool MatchSection(StallHoldersSectionDto section) =>
        _section is null || string.Equals(section.SectionName, _section, StringComparison.OrdinalIgnoreCase);

    /// <summary>Sections of a facility that pass the section filter and still have rows after the search.</summary>
    private IEnumerable<StallHoldersSectionDto> SectionsFor(FacilityCode code) =>
        _data.TryGetValue(code, out var dto)
            ? dto.Sections.Where(s => MatchSection(s) && s.Rows.Any(MatchSearch))
            : Enumerable.Empty<StallHoldersSectionDto>();

    private IEnumerable<StallHolderRowDto> RowsFor(FacilityCode code) =>
        SectionsFor(code).SelectMany(s => s.Rows).Where(MatchSearch);

    private sealed record SpaceGroup(SpaceAccountPresentation Source, IReadOnlyList<ObligationAccountDto> Rows);

    /// <summary>
    /// The space sources on screen, each with its current holders after the source filter and search. Active accounts only,
    /// like the stall register: a closed account keeps its history elsewhere. Empty for an earlier year, because the space
    /// accounts hold current amounts and contract particulars, not a year-end snapshot.
    /// </summary>
    private IReadOnlyList<SpaceGroup> VisibleSpaceGroups() =>
        SpaceSources
            .Where(s => _spaceSource is null || _spaceSource == s.Kind)
            // Monthly space rentals are a current register, so an earlier year leaves them out; event lots belong to the year
            // of their own event date, so they answer for any year.
            .Where(s => IsEvent(s.Kind) || AsOfYear is null)
            .Select(s => new SpaceGroup(s, _spaces.TryGetValue(s.Kind, out var accounts)
                ? accounts.Where(a => (IsEvent(s.Kind) ? EventYear(a) == _year : RentalAccountStatus.IsCurrent(a)) && MatchSpaceSearch(a))
                    .OrderBy(a => IsEvent(s.Kind) ? (a.EventDate ?? a.ActiveFrom).DayNumber : 0)
                    .ThenBy(a => int.TryParse(a.SubjectLabel, out var number) ? number : int.MaxValue)
                    .ThenBy(a => a.SubjectLabel, StringComparer.OrdinalIgnoreCase)
                    .ToList()
                : []))
            .ToList();

    /// <summary>The year an event lot belongs to: the year of its event, from the source's own record.</summary>
    private static int EventYear(ObligationAccountDto a) => (a.EventDate ?? a.ActiveFrom).Year;

    private static string EventName(ObligationAccountDto a) => a.Event?.ToString() ?? "Event";

    private static string LotStatus(ObligationAccountDto a) => RentalAccountStatus.LabelWithDate(a);

    private bool MatchSpaceSearch(ObligationAccountDto a)
    {
        if (!HasSearch) return true;
        var q = _search.Trim();
        return Contains(SpaceAccountPresentation.Occupant(a), q) || Contains(a.ContractName, q)
            || Contains(a.SubjectLabel, q) || Contains(SpaceAccountPresentation.Reference(a), q);
    }

    /// <summary>The scope line under the document title, so a printed sheet says which register it is.</summary>
    private string ScopeLabel => ViewScope switch
    {
        HolderScope.Space => (_spaceSource is { } kind ? SpaceSources.Single(s => s.Kind == kind).Name : "ALL SPACE RENTALS").ToUpper(),
        HolderScope.Stall => _facility is null ? "ALL STALL RENTALS" : FacilityCatalog.NameOf(_facility.Value).ToUpper(),
        _ => _facility is null ? "ALL STALL AND SPACE HOLDERS" : FacilityCatalog.NameOf(_facility.Value).ToUpper(),
    };

    private bool MatchSearch(StallHolderRowDto r)
    {
        if (!HasSearch) return true;
        var q = _search.Trim();
        return Contains(r.ActualOccupant, q) || Contains(r.NameOnContract, q) || Contains(r.StallNo, q);
    }

    private static bool Contains(string? value, string q) =>
        !string.IsNullOrEmpty(value) && value.Contains(q, StringComparison.OrdinalIgnoreCase);

    // Landscape: the official roster is a landscape form with eleven columns. js/print.js injects the @page
    // rule just before printing, because a scoped stylesheet's @page does not reach the print engine.
    private async Task Print() => await JS.InvokeVoidAsync("stalltrackPrint.landscape");

    // The as-of year is in the filename when there is one, so a historical export cannot be mistaken on disk for the
    // current register. A stall-only export keeps the name it always had; the other scopes say what they hold.
    private string CsvFileName => ViewScope switch
    {
        HolderScope.Space => $"spaceholders_{(_spaceSource is { } kind ? SpaceSources.Single(s => s.Kind == kind).Route.Split('/').Last() : "all")}_{PhilippineTime.Now:yyyy-MM-dd}.csv",
        _ => $"{(_scope == HolderScope.All ? "stall-space-holders" : "stallholders")}_{(_facility?.ToString().ToLower() ?? "all")}{(IsSectionFiltered ? "_" + _section!.Replace(' ', '-').ToLower() : "")}{(AsOfYear is { } y ? $"_as-of-{y}" : "")}_{PhilippineTime.Now:yyyy-MM-dd}.csv",
    };

    private string ExcelFileName => Path.ChangeExtension(CsvFileName, ".xlsx");

    // One table for every kind of holder, grouped by Source. Stall and space rows share the columns that mean the same thing
    // for both; the rate columns are each the source's own figure and are never added together, and a figure the source does
    // not state (a whole year of a space rental) is left empty rather than worked out.
    private static readonly IReadOnlyList<SheetColumn> ExportColumns =
    [
        new("Source", SheetValueKind.Text),
        new("Holding", SheetValueKind.Text),
        new("Section", SheetValueKind.Text),
        new("Name of Lessee (Actual Occupant)", SheetValueKind.Text),
        new("Name on Signed Contract", SheetValueKind.Text),
        new("Stall/Space No.", SheetValueKind.Text),
        new("Contract Reference", SheetValueKind.Text),
        new("Effectivity", SheetValueKind.Date),
        new("No. of Years", SheetValueKind.Number),
        new("Area (sq.m)", SheetValueKind.Number),
        new("Billing Basis", SheetValueKind.Text),
        new("Daily Rate", SheetValueKind.Money),
        new("Monthly Rental", SheetValueKind.Money),
        new("Actual Monthly Rental", SheetValueKind.Money),
        new("Whole Year Rental", SheetValueKind.Money),
        new("Status", SheetValueKind.Text),
        new("Event", SheetValueKind.Text),
        new("Event Date", SheetValueKind.Date),
        new("Event Amount", SheetValueKind.Money),
        new("Location / Note", SheetValueKind.Text),
    ];

    /// <summary>
    /// What is on the sheet, row for row, so the printed register, the spreadsheet and the CSV reconcile exactly: the same
    /// scope, source filter, section filter and search decide all three.
    /// </summary>
    private List<IReadOnlyList<object?>> ExportLines()
    {
        var lines = new List<IReadOnlyList<object?>>();

        if (NeedsStalls)
        {
            foreach (var code in VisibleFacilities())
            {
                foreach (var section in SectionsFor(code))
                {
                    foreach (var r in section.Rows.Where(MatchSearch))
                    {
                        var pureDays = IsPureDays(code);
                        lines.Add(new object?[]
                        {
                            FacilityCatalog.NameOf(code),
                            "Stall rental",
                            SectionDisplay(section.SectionName),
                            r.ActualOccupant,
                            // A row without a signed contract carries the office's own wording and no contract particulars, so
                            // the export reconciles line for line with the printed sheet.
                            r.HasSignedContract ? r.NameOnContract ?? string.Empty : NoContractLabel(r),
                            r.HasSignedContract ? r.StallNo : null,
                            null,
                            r.HasSignedContract && r.EffectivityDate != default ? r.EffectivityDate : null,
                            r.HasSignedContract ? r.DurationYears : null,
                            r.HasSignedContract && r.AreaSqm is > 0 ? r.AreaSqm!.Value : null,
                            pureDays ? "Calendar-day" : "Fixed monthly rent",
                            pureDays ? r.DailyRate : null,
                            pureDays || !r.HasSignedContract ? null : r.MonthlyRentalRate,
                            pureDays ? null : r.ActualMonthlyRental,
                            pureDays ? null : r.WholeYearRental,
                            r.IsClosed ? "Closed" : "Active",
                            null, null, null, null,
                        });
                    }
                }
            }
        }

        if (NeedsSpaces)
        {
            foreach (var group in VisibleSpaceGroups())
            {
                foreach (var a in group.Rows)
                {
                    var signed = a.Arrangement == OccupancyArrangement.SignedContract;
                    if (IsEvent(group.Source.Kind))
                    {
                        // An event lot: the event, its date and its approved amount. No monthly, whole-year, term or area figure is
                        // stated, because the source holds none.
                        lines.Add(new object?[]
                        {
                            group.Source.Name,
                            "Event lot",
                            null,
                            SpaceAccountPresentation.Occupant(a),
                            signed ? (string.IsNullOrWhiteSpace(a.ContractName) ? string.Empty : a.ContractName) : SpaceAccountPresentation.Basis(a),
                            a.SubjectLabel,
                            signed ? SpaceAccountPresentation.Reference(a) : null,
                            null, null, null,
                            "Event-based",
                            null, null, null, null,
                            LotStatus(a),
                            EventName(a),
                            a.EventDate ?? a.ActiveFrom,
                            a.CurrentAmount,
                            string.IsNullOrWhiteSpace(a.AreaLocation) ? null : a.AreaLocation,
                        });
                        continue;
                    }

                    lines.Add(new object?[]
                    {
                        group.Source.Name,
                        "Space rental",
                        null,
                        SpaceAccountPresentation.Occupant(a),
                        signed ? (string.IsNullOrWhiteSpace(a.ContractName) ? string.Empty : a.ContractName) : SpaceAccountPresentation.Basis(a),
                        a.SubjectLabel,
                        signed ? SpaceAccountPresentation.Reference(a) : null,
                        signed ? a.ContractEffectiveDate ?? a.ActiveFrom : null,
                        signed ? a.ContractYears : null,
                        signed && a.AreaSqm is > 0 ? a.AreaSqm : null,
                        "Monthly space rental",
                        null,
                        a.CurrentAmount,
                        a.CurrentAmount,
                        null,
                        "Active",
                        null, null, null, null,
                    });
                }
            }
        }

        return lines;
    }

    /// <summary>The tab's name: the scope on screen, so a file opened months later says what it is.</summary>
    private string SheetTabName()
    {
        var scope = ViewScope switch
        {
            HolderScope.Space => _spaceSource is { } kind ? SpaceSources.Single(s => s.Kind == kind).Name : "Space rentals",
            _ => _facility is null ? (_scope == HolderScope.All ? "All holders" : "All Facilities") : FacilityCatalog.ShortNameOf(_facility.Value),
        };
        return AsOfYear is { } y ? $"{scope} {y}" : scope;
    }

    /// <summary>
    /// Builds the spreadsheet and hands it to the browser. Built on the click rather than exposed as a property like the CSV: a
    /// workbook is assembled bytes-and-all, and doing that on every render of the page would be work nobody asked for.
    /// Values are given as they ARE — a date as a date, pesos as a decimal — not preformatted into text, so the sheet sorts and
    /// filters properly and each is shown in the reader's own locale.
    /// </summary>
    private async Task DownloadExcel()
    {
        var bytes = SpreadsheetBuilder.Build(SheetTabName(), ExportColumns, ExportLines());

        await JS.InvokeVoidAsync(
            "downloadFileFromBytes",
            ExcelFileName,
            Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    /// <summary>The same lines as CSV, honouring the scope, source filter, section filter and search.</summary>
    private string CsvHref
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(string.Join(',', ExportColumns.Select(c => Csv(c.Header))));

            foreach (var line in ExportLines())
            {
                sb.AppendLine(string.Join(',', line.Select(value => Csv(value switch
                {
                    null => string.Empty,
                    DateOnly date => date.ToString("M/d/yyyy"),
                    decimal amount => amount.ToString("0.00"),
                    double number => number.ToString("0.##"),
                    _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty,
                }))));
            }

            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(sb.ToString());
        }
    }

    // Quote a field only when it needs it, and double any embedded quote (RFC 4180).
    // Delegates to the shared rule so every export is neutralised against formula injection, not just quoted.
    private static string Csv(string value) => CsvCell.Escape(value);

    private static string Money(decimal v) => "₱" + v.ToString("N2");

    /// <summary>
    /// What the office writes where a signed contract would be named. An extension names the facility it extends, in
    /// that LGU's own short name, so the sheet reads exactly as the office's own form does.
    /// </summary>
    private string NoContractLabel(StallHolderRowDto row) => row.Arrangement switch
    {
        OccupancyArrangement.Extension when _facility is { } facility
            => $"No contract (Extension {FacilityCatalog.ShortNameOf(facility)})",
        OccupancyArrangement.Extension => "No contract (extension)",
        _ => "No contract (space only)",
    };

    // Market-section headers show the tenant's label (e.g. "Gulayan") — the enum-name string stays the
    // key from the server; only the DISPLAY is resolved. Sections exist only for NPM.
    private string SectionDisplay(string name)
    {
        var section = name switch
        {
            "VegetableArea" => (MarketSection?)MarketSection.VegetableArea,
            "FishSection" => MarketSection.FishSection,
            "MeatSection" => MarketSection.MeatSection,
            _ => null
        };
        return section is { } s
            ? FacilityCatalog.SectionLabelOf(FacilityCode.NPM, s)
            : (string.IsNullOrWhiteSpace(name) ? "All Stalls" : name);
    }

        /// <summary>
    /// The LGU's own name for a facility. Was a hardcoded table of Cantilan's names, which is how another
    /// municipality's report carried Cantilan's wording; the tenant catalog answers it now.
    /// </summary>    private string FacilityName(FacilityCode code) => FacilityCatalog.NameOf(code);

    public sealed record StallHolderFacilityState(
        FacilityCode FacilityCode,
        StallHoldersListDto Data);

    private static string Model(FacilityCode code) => code == FacilityCode.NPM ? "Daily stall" : "Monthly rental";
    private bool IsPureDays(FacilityCode code) => code == FacilityCode.NPM
        && _data.TryGetValue(code, out var data)
        && data.MonthBasis == NpmMonthBasis.PureDays;
    private bool OnlyPureDaysNpm => VisibleFacilities() is var visible
        && visible.Count == 1
        && IsPureDays(visible[0]);

    // Shared per-facility table. NCC adds an Area Location column; NPM rows are passed per section.
    private RenderFragment HolderTable(FacilityCode code, IReadOnlyList<StallHolderRowDto> rows) => __builder =>
    {
        var isNcc = code == FacilityCode.NCC;
        var isPureDays = IsPureDays(code);
        var activeRows = rows.Where(r => !r.IsClosed).ToList();
        <div class="sh-table-wrap">
        <table class="sh-table">
            @* First row of the head, so it repeats at the top of every sheet the table runs onto. It is the only way
               to put space above a continuation: the page margin is 0 on purpose (it is what keeps the browser's date,
               URL and page number off the document), and padding or a margin on the table is drawn once, where the
               table STARTS, not again after a break. Empty, borderless, and cancelled on the sheet the table begins on
               by an equal negative margin, so nothing about the first sheet changes. Hidden on screen. *@
            <thead>
                <tr class="sh-gap-row" aria-hidden="true"><td colspan="99"></td></tr>
                <tr>
                    <th class="sh-c">#</th>
                    <th>Name of Lessee<br /><span class="sh-th-sub">(Actual Occupants)</span></th>
                    <th>Name of Lessee per<br />Signed Contract</th>
                    <th class="sh-c">Stall /<br />Space No.</th>
                    <th class="sh-c">Effectivity of<br />Lessee Contract</th>
                    <th class="sh-c">No. of<br />Years</th>
                    <th class="sh-c">Area</th>
                    @if (isPureDays)
                    {
                        <th class="sh-c">Billing<br />Basis</th>
                        <th class="sh-r">Daily<br />Rate</th>
                        <th class="sh-r">Fixed Annual<br />Rental</th>
                    }
                    else
                    {
                        <th class="sh-r">Monthly Rentals<br />per Contract</th>
                        <th class="sh-r">Actual Mo.<br />Rentals</th>
                        <th class="sh-r">Whole Year<br />Rental</th>
                    }
                    @if (isNcc)
                    {
                        <th class="sh-c">Area Loc.</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{ var n = 1; }
                @foreach (var r in rows)
                {
                    @* A space held without a signed contract has no leasee name, effectivity, term, area or contract
                       rate to state, so the office's sheet says so once across those columns and leaves the rest
                       blank. Only the rent actually charged appears. *@
                    var noContract = !r.HasSignedContract;
                    <tr class="@(r.IsClosed ? "sh-row-closed" : "")">
                        <td class="sh-c">@n</td>
                        <td>@r.ActualOccupant</td>
                        @if (noContract)
                        {
                            <td class="sh-nc" colspan="5">@NoContractLabel(r)</td>
                        }
                        else
                        {
                            <td>@(string.IsNullOrWhiteSpace(r.NameOnContract) ? "—" : r.NameOnContract)</td>
                            <td class="sh-c">@SpaceNumber.Display(r.StallNo)</td>
                            <td class="sh-c">@(r.EffectivityDate == default ? "—" : r.EffectivityDate.ToString("M/d/yyyy"))</td>
                            <td class="sh-c">@(r.DurationYears > 0 ? r.DurationYears + " yr" + (r.DurationYears != 1 ? "s" : "") : "—")</td>
                            <td class="sh-c">@(r.AreaSqm is > 0 ? $"{r.AreaSqm} sq.m." : "—")</td>
                        }
                        @if (isPureDays)
                        {
                            <td class="sh-c">@(r.IsClosed ? "—" : "Calendar-day")</td>
                            <td class="sh-r">@(r.IsClosed ? "—" : $"{Money(r.DailyRate)}/day")</td>
                            <td class="sh-r">—</td>
                        }
                        else
                        {
                            <td class="sh-r">@(r.IsClosed || noContract || r.MonthlyRentalRate <= 0m ? "—" : Money(r.MonthlyRentalRate))</td>
                            <td class="sh-r">@(r.IsClosed ? "—" : Money(r.ActualMonthlyRental))</td>
                            <td class="sh-r">@(r.IsClosed || r.WholeYearRental <= 0m ? "—" : Money(r.WholeYearRental))</td>
                        }
                        @if (isNcc)
                        {
                            <td class="sh-c">@(string.IsNullOrWhiteSpace(r.AreaLocation) ? "—" : r.AreaLocation)</td>
                        }
                    </tr>
                    n++;
                }
            </tbody>
            <tfoot>
                @* The band above already states the section and its stall count, so the total row carries only
                   its figures — a government form repeats nothing. *@
                <tr class="sh-tfoot-row">
                    <td colspan="7" class="sh-tfoot-label">Total</td>
                    @if (isPureDays)
                    {
                        <td class="sh-c sh-tfoot-val">Calendar-day</td><td class="sh-c sh-tfoot-val">Per stall</td><td class="sh-r sh-tfoot-val">—</td>
                    }
                    else
                    {
                        <td class="sh-r sh-tfoot-val">@Money(activeRows.Sum(r => r.MonthlyRentalRate))</td>
                        <td class="sh-r sh-tfoot-val">@Money(activeRows.Sum(r => r.ActualMonthlyRental))</td>
                        <td class="sh-r sh-tfoot-val">@Money(activeRows.Sum(r => r.WholeYearRental))</td>
                    }
                    @if (isNcc)
                    {
                        <td></td>
                    }
                </tr>
            </tfoot>
        </table>
        </div>
    };

    // A recurring space rental: the space is the unit, held with or without a signed lease. The account register states the
