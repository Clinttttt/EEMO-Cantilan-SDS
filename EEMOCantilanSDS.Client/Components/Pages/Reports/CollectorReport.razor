@page "/collectors/{CollectorId:guid}/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Queries.Collectors.GetReportOfCollections
@using EEMOCantilanSDS.Domain.Enums
@inject ICollectorsApiClient CollectorsApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject IJSRuntime JS

@*
    The office's Report of Collections for one collector: what they took, receipt by receipt, and what they have since
    turned in. Distinct from the collector's own copy in the app, and from the facility reports, which state a facility
    across every collector.

    Every figure comes from one query, so the summary, the facility breakdown, the daily record and the receipt listing
    cannot disagree. The shell and document styles are those the facility reports already carry.
*@

<PageTitle>StallTrack — Report of Collections</PageTitle>

<!-- ══ Topbar ══ -->
<div class="rpt-topbar no-print">
    <div class="rpt-topbar-left">
        <a href="/collectors" class="rpt-back-btn" title="Back to Collectors">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div class="rpt-topbar-icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></svg>
        </div>
        <div>
            <div class="rpt-eyebrow">COLLECTORS · REPORT OF COLLECTIONS</div>
            <div class="rpt-title">Report of Collections</div>
            <div class="rpt-subtitle">@(Report is null ? PeriodLabel : $"{Report.CollectorName} · {PeriodLabel}")</div>
        </div>
    </div>
    <div class="rpt-topbar-right">
        <button type="button" class="rpt-action-btn" disabled="@(Report is null)" @onclick="PrintPage">
            <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
            Print
        </button>
    </div>
</div>

<!-- ══ Period: a day is a cash view, a month the accountability view, so Monthly opens ══ -->
<div class="rpt-period-bar no-print">
    <div class="rpt-period-tabs">
        @foreach (var p in new[] { "Daily", "Weekly", "Monthly", "Yearly", "Whole Time" })
        {
            var period = p;
            <button type="button" class="rpt-period-tab @(ActivePeriod == period ? "active" : "")"
                    aria-pressed="@(ActivePeriod == period)"
                    @onclick="() => SetPeriod(period)">@period</button>
        }
    </div>
    @if (ActivePeriod != "Whole Time")
    {
        @* Nothing to step through when the period is the whole record, so the navigator stands down rather than
           pretending a year or a month is being chosen. *@
        <ReportPeriodNav Year="CurrentDate.Year" Month="CurrentDate.Month"
                         Yearly="@(ActivePeriod == "Yearly")"
                         Label="@PeriodLabel"
                         OnPrev="PrevPeriod" OnNext="NextPeriod"
                         OnPick="PickPeriod" OnToday="JumpToCurrent" />
    }
</div>

<div class="rpt-content print-document-content">
    <section class="print-report-sheet status-sheet">

        <header class="print-report-header">
            <img class="print-report-logo" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
            <div class="print-republic">Republic of the Philippines</div>
            <h2>@Branding.OfficeName</h2>
            <p>Municipality of @Branding.Municipality, @Branding.Province</p>
            <div class="print-report-title">Report of Collections</div>
        </header>

        @if (CollectorId is null)
        {
            <div class="print-empty">Open this report from a collector's row so it names the officer it answers for.</div>
        }
        else if (Loading)
        {
            <div class="print-empty">Reading the period's collections…</div>
        }
        else if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="print-empty">@LoadError</div>
        }
        else if (Report is { } r)
        {
            <div class="print-report-meta">
                <div><span>Collector</span><strong>@r.CollectorName</strong></div>
                <div><span>Employee ID</span><strong>@(string.IsNullOrWhiteSpace(r.EmployeeId) ? "—" : r.EmployeeId)</strong></div>
                <div><span>Assigned Facilities</span><strong>@(r.AssignedFacilities.Count == 0 ? "—" : string.Join(", ", r.AssignedFacilities.Select(f => FacilityCatalog.ShortNameOf(f))))</strong></div>
                <div><span>Report Period</span><strong>@PeriodLabel</strong></div>
            </div>

            <div class="print-report-summary">
                <div><span>Total Collected</span><strong>&#8369;@r.TotalCollected.ToString("N2")</strong></div>
                <div><span>Receipts Issued</span><strong>@r.ReceiptsIssued</strong></div>
                <div><span>Payors Served</span><strong>@r.PayorsServed</strong></div>
                <div><span>Days With Collections</span><strong>@r.DaysWithCollections</strong></div>
            </div>

            <!-- ══ This collector across their facilities, which no facility report answers ══ -->
            <div class="print-section-block">
                <div class="print-section-heading">Collections by Facility</div>
                <div class="print-table-wrap">
                    <table class="print-status-table">
                        <thead>
                            <tr>
                                <th>Facility</th>
                                <th class="cr-num">Receipts</th>
                                <th class="cr-num">Payors</th>
                                <th class="cr-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.Facilities.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted-cell">No collections in this period.</td></tr>
                            }
                            @foreach (var f in r.Facilities)
                            {
                                <tr>
                                    <td>@FacilityCatalog.NameOf(f.Facility)</td>
                                    <td class="cr-num">@f.Receipts</td>
                                    <td class="cr-num">@f.Payors</td>
                                    <td class="cr-num">&#8369;@f.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        @if (r.Facilities.Count > 0)
                        {
                            <tfoot>
                                <tr class="cr-total-row">
                                    <td><strong>Total</strong></td>
                                    <td class="cr-num"><strong>@r.ReceiptsIssued</strong></td>
                                    <td class="cr-num"><strong>@r.PayorsServed</strong></td>
                                    <td class="cr-num"><strong>&#8369;@r.TotalCollected.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>

            <!-- ══ The verification row. "For Earlier Days" is why a day can collect more than it could owe ══ -->
            <div class="print-section-block">
                <div class="print-section-heading">Daily Record of Collections</div>
                <div class="print-table-wrap">
                    <table class="print-status-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Receipts</th>
                                <th class="cr-num">Payors</th>
                                <th class="cr-num">For Earlier Days</th>
                                <th class="cr-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.Days.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted-cell">No collections in this period.</td></tr>
                            }
                            @foreach (var d in r.Days)
                            {
                                <tr>
                                    <td>@d.Day.ToString("MMM d, yyyy")</td>
                                    <td class="text-muted-cell">@d.ReceiptSpan</td>
                                    <td class="cr-num">@d.Payors</td>
                                    <td class="cr-num">@(d.ForEarlierDays > 0m ? "₱" + d.ForEarlierDays.ToString("N2") : "—")</td>
                                    <td class="cr-num">&#8369;@d.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        @if (r.Days.Count > 0)
                        {
                            <tfoot>
                                <tr class="cr-total-row">
                                    <td colspan="3"><strong>Total</strong></td>
                                    <td class="cr-num"><strong>&#8369;@r.Days.Sum(d => d.ForEarlierDays).ToString("N2")</strong></td>
                                    <td class="cr-num"><strong>&#8369;@r.TotalCollected.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                @if (r.OfficeRecorded > 0m)
                {
                    <p class="cr-note">
                        A further &#8369;@r.OfficeRecorded.ToString("N2") was taken at the office for these facilities in the
                        same period, across @r.OfficeReceipts entr@(r.OfficeReceipts == 1 ? "y" : "ies"). It is not this
                        collector's accountability and is stated so the facility totals and this sheet can be reconciled.
                    </p>
                }
            </div>

            <!-- ══ The evidence: every receipt in the period ══ -->
            <div class="print-section-block">
                <div class="print-section-heading">Receipts Issued</div>
                <div class="print-table-wrap">
                    <table class="print-status-table">
                        <thead>
                            <tr>
                                <th>OR No.</th>
                                <th>Date &amp; Time</th>
                                <th>Payor</th>
                                <th>Stall / Unit</th>
                                <th>Facility</th>
                                <th>Fee For</th>
                                <th class="cr-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.Receipts.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted-cell">No collections in this period.</td></tr>
                            }
                            @foreach (var t in r.Receipts)
                            {
                                <tr>
                                    <td>@(t.OrNumber == "—" ? "—" : "#" + t.OrNumber)</td>
                                    <td>@t.TakenAt.ToString("MMM d, yyyy · hh:mm tt")</td>
                                    <td>@t.PayorName</td>
                                    <td>@(string.IsNullOrWhiteSpace(t.StallNo) ? "—" : t.StallNo)</td>
                                    <td>@FacilityCatalog.ShortNameOf(t.Facility)</td>
                                    <td class="text-muted-cell">@t.FeeFor</td>
                                    <td class="cr-num">&#8369;@t.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        @if (r.Receipts.Count > 0)
                        {
                            <tfoot>
                                <tr class="cr-total-row">
                                    <td colspan="6"><strong>Total</strong></td>
                                    <td class="cr-num"><strong>&#8369;@r.TotalCollected.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                <p class="cr-note">
                    Receipt numbers are entered one by one, so the daily record states a range only where the numbers run
                    unbroken, and their count where they do not.
                </p>
            </div>

            @if (r.Absences.Count > 0)
            {
                <!-- ══ ₱0 statements the collector marked, which explain the gaps above ══ -->
                <div class="print-section-block">
                    <div class="print-section-heading">Absences and Excused Days Marked</div>
                    <div class="print-table-wrap">
                        <table class="print-status-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Payor</th>
                                    <th>Stall / Unit</th>
                                    <th>Facility</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in r.Absences)
                                {
                                    <tr>
                                        <td>@a.Day.ToString("MMM d, yyyy")</td>
                                        <td>@a.PayorName</td>
                                        <td>@(string.IsNullOrWhiteSpace(a.StallNo) ? "—" : a.StallNo)</td>
                                        <td>@FacilityCatalog.ShortNameOf(a.Facility)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (r.UtilityBilled > 0m || r.UtilityCollected > 0m)
            {
                <!-- ══ A meter charge is not a stall or daily fee, and the office banks it separately ══ -->
                <div class="print-section-block">
                    <div class="print-section-heading">Electricity and Water Collected</div>
                    <div class="print-table-wrap">
                        <table class="print-status-table">
                            <thead>
                                <tr>
                                    <th>Charge</th>
                                    <th class="cr-num">Billed</th>
                                    <th class="cr-num">Collected</th>
                                    <th class="cr-num">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Electricity and water</td>
                                    <td class="cr-num">&#8369;@r.UtilityBilled.ToString("N2")</td>
                                    <td class="cr-num">&#8369;@r.UtilityCollected.ToString("N2")</td>
                                    <td class="cr-num">&#8369;@((r.UtilityBilled - r.UtilityCollected).ToString("N2"))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="cr-note">
                        Banked separately as additional income, so these figures are outside the collections and the
                        remittances above.
                    </p>
                </div>
            }

            @* The strip hands its layout to whatever hosts it, so a sheet has to supply the footer's three columns. Without
               this wrapper the lines stacked one under another down the page. *@
            <div class="print-report-signatures">
                <SignatureStrip ShowDatePrepared="true" />
            </div>
        }

    </section>
</div>

@code {
    /// <summary>The collector this report answers for, taken from the route.</summary>
    [Parameter] public Guid? CollectorId { get; set; }

    ReportOfCollectionsDto? Report;
    bool Loading;
    string? LoadError;

    string ActivePeriod = "Monthly";
    DateTime CurrentDate = PhilippineTime.Now.Date;

    string PeriodLabel => ActivePeriod switch
    {
        "Daily" => CurrentDate.ToString("MMMM d, yyyy"),
        "Weekly" => $"Week of {WeekStart:MMM d} to {WeekStart.AddDays(6):MMM d, yyyy}",
        "Yearly" => CurrentDate.ToString("yyyy"),
        "Whole Time" => "Every collection on record",
        _ => CurrentDate.ToString("MMMM yyyy")
    };

    /// <summary>Weeks run Sunday to Saturday, as the facility reports read them.</summary>
    DateTime WeekStart => CurrentDate.AddDays(-(int)CurrentDate.DayOfWeek);

    /// <summary>
    /// The earliest day the whole record can start from. The office's books do not predate the platform, and a report has to
    /// bound itself somewhere rather than ask the database for every row since the epoch.
    /// </summary>
    static readonly DateOnly RecordBegins = new(2020, 1, 1);

    (DateOnly From, DateOnly To) Range => ActivePeriod switch
    {
        "Daily" => (DateOnly.FromDateTime(CurrentDate), DateOnly.FromDateTime(CurrentDate)),
        "Weekly" => (DateOnly.FromDateTime(WeekStart), DateOnly.FromDateTime(WeekStart.AddDays(6))),
        "Yearly" => (new DateOnly(CurrentDate.Year, 1, 1), new DateOnly(CurrentDate.Year, 12, 31)),
        // Up to today, never beyond it: a document must not imply it covers days that have not happened.
        "Whole Time" => (RecordBegins, PhilippineTime.Today),
        _ => (new DateOnly(CurrentDate.Year, CurrentDate.Month, 1),
              new DateOnly(CurrentDate.Year, CurrentDate.Month, DateTime.DaysInMonth(CurrentDate.Year, CurrentDate.Month)))
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        if (CollectorId is not { } id) return;

        Loading = true;
        LoadError = null;

        var (from, to) = Range;
        var result = await CollectorsApi.GetReportOfCollectionsAsync(id, from, to);

        Loading = false;

        if (result.IsSuccess)
        {
            Report = result.Value;
            return;
        }

        Report = null;
        LoadError = string.IsNullOrWhiteSpace(result.Error)
            ? "This report could not be read."
            : result.Error;
    }

    async Task SetPeriod(string period)
    {
        ActivePeriod = period;
        await LoadAsync();
    }

    async Task PrevPeriod() { CurrentDate = Step(-1); await LoadAsync(); }
    async Task NextPeriod() { CurrentDate = Step(1); await LoadAsync(); }

    DateTime Step(int direction) => ActivePeriod switch
    {
        "Daily" => CurrentDate.AddDays(direction),
        "Weekly" => CurrentDate.AddDays(7 * direction),
        "Yearly" => CurrentDate.AddYears(direction),
        "Whole Time" => CurrentDate,
        _ => CurrentDate.AddMonths(direction)
    };

    async Task PickPeriod((int Year, int Month) picked)
    {
        CurrentDate = new DateTime(picked.Year, picked.Month, 1);
        await LoadAsync();
    }

    async Task JumpToCurrent()
    {
        CurrentDate = PhilippineTime.Now.Date;
        await LoadAsync();
    }

    async Task PrintPage() => await JS.InvokeVoidAsync("print");
}
