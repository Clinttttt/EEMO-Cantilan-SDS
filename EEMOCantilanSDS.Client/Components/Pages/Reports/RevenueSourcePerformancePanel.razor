@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Reports
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Enums
@inject IOfficialReportsApiClient Api

@* REVENUE SOURCE PERFORMANCE — every source the office collects, facility or not.

   The register's money is the server's official Monthly Income for the same period (legacy before cutover plus canonical
   after it, once). The Overview uses a static management table; its contribution uses the existing source-group amount,
   and recurring coverage or outstanding amounts appear only when the same-period facility register supplies them. The
   Reports presentation retains its existing analysis and target-management behavior. *@
<section class="rsp" aria-labelledby="rsp-title" aria-busy="@(_loading ? "true" : "false")">
    <div class="rsp-head">
        <div>
            <h2 id="rsp-title" class="rsp-title">Revenue source performance — @PeriodLabel</h2>
            <div class="rsp-sub">@(OverviewMode
                ? "Official collections and operating activity by revenue source for the selected period."
                : "Collected is the official Monthly Income for the period; secondary figures follow each source's model")</div>
            @if (_data?.TargetCoverage is { } coverage)
            {
                <div class="rsp-cov" role="status">@CoverageText(coverage)</div>
            }
        </div>
        <div class="rsp-filter no-print">
            <FhSelect Caption="Sources" Value="@_group" Options="@GroupOptions" ValueChanged="@(v => _group = v)" />
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="rsp-state" role="alert">@_error</p>
    }
    else if (_data is null)
    {
        <p class="rsp-state" role="status">Loading revenue sources…</p>
    }
    else
    {
        <div class="rsp-scroll" role="region" aria-label="Revenue source performance" tabindex="0">
            <table class="rsp-table">
                <caption class="v3-sr-only">Revenue source performance for @PeriodLabel</caption>
                <thead>
                    <tr>
                        @if (OverviewMode)
                        {
                            <th scope="col">Source</th>
                            <th scope="col" class="rsp-num">Collected</th>
                            <th scope="col">Activity</th>
                            <th scope="col" class="rsp-num">Contribution</th>
                            <th scope="col">Attention</th>
                        }
                        else
                        {
                            <th scope="col">Source</th>
                            <th scope="col">Basis</th>
                            <th scope="col" class="rsp-num">Collected</th>
                            <th scope="col" class="rsp-num">Annual target</th>
                            <th scope="col">Activity</th>
                            <th scope="col">Position</th>
                            <th scope="col">Status</th>
                        }
                    </tr>
                </thead>
                @foreach (var group in VisibleGroups)
                {
                    <tbody>
                        <tr class="rsp-group">
                            @if (OverviewMode)
                            {
                                <th scope="rowgroup">@group.Label</th>
                                <td class="rsp-num">@(CrossGroupScope ? "" : Money(group.Collected))</td>
                                <td colspan="3"></td>
                            }
                            else
                            {
                                <th scope="rowgroup" colspan="2">@group.Label</th>
                                <td class="rsp-num">@(CrossGroupScope ? "" : Money(group.Collected))</td>
                                <td colspan="4"></td>
                            }
                        </tr>
                        @foreach (var row in _data.Rows.Where(r => r.GroupKey == group.Key && RowVisible(r)))
                        {
                            var open = _reportOpen.Contains(row.Key);
                            var facility = FacilityOf(row);
                            @if (OverviewMode)
                            {
                                <tr class="rsp-row">
                                    <th scope="row" class="rsp-source">@row.Label</th>
                                    <td class="rsp-num rsp-collected">@Money(row.Collected)</td>
                                    <td>@OverviewActivity(row)</td>
                                    <td class="rsp-num rsp-contribution">@Contribution(row)</td>
                                    <td class="rsp-attention @AttentionClass(row, facility)">@Attention(row, facility)</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="rsp-row @(open ? "open" : "")">
                                    <th scope="row" class="rsp-source">
                                        <button type="button" class="rsp-toggle" aria-expanded="@(open ? "true" : "false")"
                                                aria-controls="@($"rsp-d-{row.Key}")" @onclick="() => ToggleReportRow(row.Key)">
                                            <span class="rsp-caret" aria-hidden="true"></span>@row.Label
                                        </button>
                                    </th>
                                    <td class="rsp-basis">@ModelLabel(row.Model)@(row.Instruments is { } i ? $" · {i}" : "")</td>
                                    <td class="rsp-num rsp-collected">@Money(row.Collected)</td>
                                    <td class="rsp-num rsp-target">
                                        @if (row.AnnualTarget is { } target)
                                        {
                                            <span>@Money(target)</span>
                                            @if (row.Attainment is { } attainment) { <span class="rsp-attain">@(attainment.ToString("N1", CultureInfo.InvariantCulture) + "%")</span> }
                                        }
                                        else { <span class="rsp-quiet">Not set</span> }
                                        <AuthorizeView Roles="SuperAdmin">
                                            <Authorized>
                                                @if (!row.AwaitingPlacement)
                                                {
                                                    <button type="button" class="rsp-target-btn no-print" aria-label="@($"Set annual target for {row.Label}")" @onclick="() => _targetRow = row">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                                                    </button>
                                                }
                                            </Authorized>
                                        </AuthorizeView>
                                    </td>
                                    <td>@ReportActivity(row)</td>
                                    <td>@Position(row, facility)</td>
                                    <td><span class="rsp-status @StatusClass(row, facility)">@Status(row, facility)</span></td>
                                </tr>
                                @if (open)
                                {
                                    <tr class="rsp-detail" id="@($"rsp-d-{row.Key}")">
                                        <td colspan="7">
                                            <dl class="rsp-facts">
                                                <div><dt>Posted collections</dt><dd>@Money(row.CanonicalCollected)</dd></div>
                                                @if (row.LegacyCollected != 0m)
                                                {
                                                    <div><dt>Legacy records before cutover</dt><dd>@Money(row.LegacyCollected)</dd></div>
                                                }
                                                <div><dt>Transactions</dt><dd>@Count(row.TransactionCount)</dd></div>
                                                <div><dt>Documents</dt><dd>@Count(row.DocumentCount)</dd></div>
                                                <div><dt>Collectors</dt><dd>@Count(row.CollectorCount)</dd></div>
                                                @if (facility is { } f && !f.PaidOnService)
                                                {
                                                    <div><dt>Unpaid this period</dt><dd>@(f.Unpaid is { } u ? Money(u) : "—")</dd></div>
                                                    <div><dt>Paid / expected</dt><dd>@(f.ExpectedRecords > 0 ? $"{f.PaidRecords} / {f.ExpectedRecords}" : "—")</dd></div>
                                                }
                                            </dl>
                                            @if (row.LegacyCollected != 0m)
                                            {
                                                <p class="rsp-note">Counts describe posted collections only, so they are not stated while legacy records remain in the period.</p>
                                            }
                                            @if (row.AwaitingPlacement)
                                            {
                                                <p class="rsp-note">This source has no approved official Monthly Income placement; the statement lists it apart.</p>
                                            }
                                            @if (LinkOf(row.Key) is { } link)
                                            {
                                                <a class="rsp-link" href="@link">View report →</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                }
                <tfoot>
                    <tr class="rsp-total">
                        @if (OverviewMode)
                        {
                            <th scope="row">@TotalLabel</th>
                            <td class="rsp-num">@(CrossGroupScope ? "—" : Money(VisibleTotal))</td>
                            <td colspan="3"></td>
                        }
                        else
                        {
                            <th scope="row" colspan="2">@TotalLabel</th>
                            <td class="rsp-num">@(CrossGroupScope ? "—" : Money(VisibleTotal))</td>
                            <td colspan="4"></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (!OverviewMode)
    {
        <AnnualTargetDrawer Show="_targetRow is not null" Year="Year" RowKey="@(_targetRow?.Key ?? string.Empty)" RowLabel="@(_targetRow?.Label ?? string.Empty)"
                            OnClose="CloseTarget" OnSaved="ReloadAsync" />
    }
</section>

@code {
    [Parameter, EditorRequired] public int Year { get; set; }

    /// <summary>The selected month, or null for the whole year.</summary>
    [Parameter] public int? Month { get; set; }

    /// <summary>Uses the management-only static table presentation on the Overview Dashboard.</summary>
    [Parameter] public bool OverviewMode { get; set; }

    /// <summary>The facility register's rows for the same period: the only place balances and coverage are measured.</summary>
    [Parameter] public IReadOnlyList<FinancialFacilityRowDto>? Facilities { get; set; }

    /// <summary>Tells the page how completely targets are configured, so the Summary can state attainment truthfully.</summary>
    [Parameter] public EventCallback<TargetCoverageDto?> OnCoverage { get; set; }

    private RevenueSourcePerformanceRowDto? _targetRow;
    private void CloseTarget() => _targetRow = null;
    private async Task ReloadAsync()
    {
        _loadedYear = 0;
        await OnParametersSetAsync();
    }

    private static string CoverageText(TargetCoverageDto c) => c.State switch
    {
        TargetCoverageState.Complete => $"Targets configured{(c.Attainment is { } a ? $" · {a.ToString("N1", CultureInfo.InvariantCulture) + "%"} attained" : "")}",
        TargetCoverageState.Partial => $"Targets partially configured · {c.TargetedRows} of {c.TotalRows} sources",
        _ => "Targets not configured"
    };

    private RevenueSourcePerformanceDto? _data;
    private string? _error;
    private bool _loading;
    private int _loadedYear;
    private int? _loadedMonth;
    private string _group = "all";
    private readonly HashSet<string> _reportOpen = new(StringComparer.Ordinal);

    private string PeriodLabel => Month is { } m
        ? $"{CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)} {Year}" : Year.ToString(CultureInfo.InvariantCulture);

    // All sources by default; a facility-backed / non-facility split cuts across the groups, so it lists rows only and
    // states no subtotal (money totals stay the server's group and statement totals, never re-added here).
    private IReadOnlyList<(string Value, string Label)> GroupOptions =>
        new[] { ("all", "All sources"), ("facilities", "Facilities only"), ("operations", "Non-facility operations") }
            .Concat(_data?.Groups.Select(g => (g.Key, g.Label)) ?? []).ToList();

    private bool CrossGroupScope => _group is "facilities" or "operations";

    private bool RowVisible(RevenueSourcePerformanceRowDto row) => _group switch
    {
        "facilities" => row.Facility is not null,
        "operations" => row.Facility is null,
        _ => true
    };

    private IEnumerable<RevenueSourceGroupDto> VisibleGroups =>
        _data?.Groups.Where(g => (_group is "all" || CrossGroupScope || g.Key == _group)
            && _data.Rows.Any(r => r.GroupKey == g.Key && RowVisible(r))) ?? [];

    private decimal VisibleTotal => _group == "all" ? _data?.TotalCollected ?? 0m : VisibleGroups.Sum(g => g.Collected);

    private string TotalLabel => _group switch
    {
        "all" => "Total — all sources",
        "facilities" => "Facility-backed sources",
        "operations" => "Non-facility operations",
        _ => "Total — " + (_data?.Groups.FirstOrDefault(g => g.Key == _group)?.Label ?? "selected group")
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedYear == Year && _loadedMonth == Month && (_data is not null || _error is not null)) return;
        _loadedYear = Year;
        _loadedMonth = Month;
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetSourcePerformanceAsync(Year, Month);
            if (result.IsSuccess && result.Value is not null) _data = result.Value;
            else { _data = null; _error = "Revenue sources could not be loaded."; }
        }
        catch { _data = null; _error = "Revenue sources could not be loaded."; }
        finally { _loading = false; }
        await OnCoverage.InvokeAsync(_data?.TargetCoverage);
    }

    private void ToggleReportRow(string key)
    {
        if (!_reportOpen.Remove(key)) _reportOpen.Add(key);
    }

    private FinancialFacilityRowDto? FacilityOf(RevenueSourcePerformanceRowDto row) =>
        row.Facility is { } code ? Facilities?.FirstOrDefault(f => f.Code == code) : null;

    private static string ModelLabel(string model) => model switch
    {
        RevenueSourceModel.RecurringObligation => "Recurring obligation",
        RevenueSourceModel.Transactional => "Paid on service",
        RevenueSourceModel.QuantityService => "Quantity / service",
        RevenueSourceModel.EventRental => "Event rental",
        RevenueSourceModel.Receivable => "Receivable",
        _ => model
    };

    private string OverviewActivity(RevenueSourcePerformanceRowDto row)
    {
        if (row.Model == RevenueSourceModel.Receivable) return "—";
        if (row.Model == RevenueSourceModel.RecurringObligation && FacilityOf(row) is { PaidOnService: false, ExpectedRecords: > 0 } facility)
            return $"{facility.PaidRecords} / {facility.ExpectedRecords} paid";
        if (row.TransactionCount is not { } n) return row.LegacyCollected != 0m ? "Legacy included" : "—";
        if (n == 0) return "—";
        return Plural(n, "transaction");
    }

    private static string ReportActivity(RevenueSourcePerformanceRowDto row)
    {
        if (row.Model == RevenueSourceModel.Receivable) return "—";
        if (row.TransactionCount is not { } n) return "Includes legacy records";
        if (n == 0) return "—";
        var parts = new List<string> { Plural(n, "transaction") };
        if (row.CollectorCount is { } c and > 0) parts.Add(Plural(c, "collector"));
        return string.Join(" · ", parts);
    }

    // Contribution uses the existing server group amount, even under cross-group source filters; never create a filtered subtotal.
    private string Contribution(RevenueSourcePerformanceRowDto row)
    {
        var group = _data?.Groups.FirstOrDefault(g => g.Key == row.GroupKey);
        return group is null || group.Collected == 0m
            ? "—"
            : (row.Collected / group.Collected * 100m).ToString("N1", CultureInfo.InvariantCulture) + "%";
    }

    // An outstanding amount belongs only to a recurring source whose facility register supplied it.
    private static string Attention(RevenueSourcePerformanceRowDto row, FinancialFacilityRowDto? facility)
    {
        if (row.AwaitingPlacement) return "Needs official placement";
        if (row.Model == RevenueSourceModel.RecurringObligation && facility is { PaidOnService: false, Unpaid: > 0m } f)
            return $"{Money(f.Unpaid.Value)} outstanding";
        if (row.LegacyCollected != 0m && row.TransactionCount is null) return "Legacy data included";
        return "—";
    }

    private static string AttentionClass(RevenueSourcePerformanceRowDto row, FinancialFacilityRowDto? facility) =>
        row.AwaitingPlacement || row.Model == RevenueSourceModel.RecurringObligation && facility is { PaidOnService: false, Unpaid: > 0m }
            ? "warn" : "quiet";

    // The Reports view retains its existing model-aware analysis beside the Overview's management summary.
    private static string Position(RevenueSourcePerformanceRowDto row, FinancialFacilityRowDto? facility) => row.Model switch
    {
        RevenueSourceModel.Transactional or RevenueSourceModel.QuantityService => "Paid on service",
        RevenueSourceModel.Receivable => "See Receivables",
        _ when facility is { PaidOnService: false } f =>
            string.Join(" · ", new[]
            {
                f.Unpaid is { } u ? $"{Money(u)} unpaid" : null,
                f.ExpectedRecords > 0 ? $"{f.PaidRecords}/{f.ExpectedRecords} paid" : null,
                f.RatePct is { } r && f.ExpectedRecords > 0 ? $"{r}%" : null
            }.Where(s => s is not null)) is { Length: > 0 } text ? text : "—",
        _ => "—"
    };

    private static string Status(RevenueSourcePerformanceRowDto row, FinancialFacilityRowDto? facility) =>
        facility is { PaidOnService: false, Unpaid: > 0m } && !row.AwaitingPlacement ? "Outstanding balances" : row.Status;

    private static string StatusClass(RevenueSourcePerformanceRowDto row, FinancialFacilityRowDto? facility) =>
        Status(row, facility) switch
        {
            "Active" => "ok",
            "Outstanding balances" or "Needs official placement" => "warn",
            _ => "quiet"
        };

    private static string? LinkOf(string key) => key switch
    {
        "MARKET_FEES" => "/operations/market-fees/report",
        "ECF" => "/operations/ecf/report",
        "WCF" => "/operations/water-consumption-fees/report",
        "TABO" => "/tpm/reports",
        "FISH_MEAT_VENDOR_FEE" => "/operations/fish-meat-vendor-fees/report",
        "LANDING_BERTHING" => "/operations/landing-berthing/report",
        "TRANSPORTATION_PARKING" => "/operations/transportation/report",
        "WEIGHT_AND_MEASURE" => "/operations/weight-and-measure",
        "TRANSFER_LARGE_CATTLE" => "/operations/transfer-large-cattle/report",
        "ICE_PLANT" => "/ice/reports",
        "RENT_NPM" => "/npm/reports",
        "RENT_NCC" => "/ncc/reports",
        "RENT_TCC" => "/tcc/reports",
        "RENT_BBQ" => "/bbq/reports",
        "VEGETABLE_FRUIT_SPACE_RENTAL" => "/operations/vegetable-fruit/report",
        "KANMANGGAY_SPACE_RENTAL" => "/operations/kanmanggay/report",
        "FIESTA_ARAW_LOT_RENTAL" => "/operations/fiesta-araw/report",
        "PENALTIES_AND_FINES" => "/operations/fines",
        "SLAUGHTERHOUSE" => "/reports/slaughterhouse",
        "ARREARS" => "/operations/arrears/report",
        _ => null
    };

    private static string Count(int? value) => value is { } v ? v.ToString(CultureInfo.InvariantCulture) : "—";
    private static string Plural(int n, string one) => $"{n} {(n == 1 ? one : one + "s")}";

    private static string Money(decimal amount) => "₱" + amount.ToString("N0", CultureInfo.InvariantCulture);
}
