@page "/reports/closed-accounts"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Application.Dtos.Stalls
@using EEMOCantilanSDS.Application.Requests.Stalls
@using EEMOCantilanSDS.Application.Command.Stalls.AssignPastOccupantStall
@inject IStallsApiClient StallsApi
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

@* ───────────────────────────────────────────────────────────────────────────────
   Closed / Inactive Accounts — transparency register of CLOSED (frozen) and EXPIRED
   (contract lapsed) stall accounts with lifetime collected + uncollected-at-end.
   Read-only printable sheet; on-screen it also offers Reopen (closed) / Renew (expired).
   Scope: stall facilities only (NPM/TCC/NCC/BBQ/ICE). Data: GET /api/stalls/closed-accounts.
   ─────────────────────────────────────────────────────────────────────────────── *@

<PageTitle>StallTrack — Closed Accounts</PageTitle>

<header class="topbar no-print">
    <div class="topbar-left">
        <div class="topbar-title">Closed Accounts</div>
        <div class="topbar-breadcrumb">
            <a href="/menu" class="breadcrumb-link">@Branding.OfficeAcronym Admin</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Closed Accounts</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-period">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            As of <strong>@PhilippineTime.Today.ToString("MMM d, yyyy")</strong>
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    <!-- Controls: year + state + facility + search + print -->
    <div class="ca-controls no-print">
        <div class="ca-filter" role="group" aria-label="Year">
            <span class="ca-filter-cap">Year</span>
            <ReportPeriodNav YearFilterMode="true" SelectedYear="_year" FilterYears="Years" AlignRight="false"
                             Label="@(_year?.ToString() ?? "Whole Time")"
                             OnSelectYear="OnPickYear" />
        </div>

        <div class="ca-filter" role="group" aria-label="Status">
            <button class="ca-chip @(_state is null ? "ca-chip-active" : "")" type="button" @onclick="() => { _state = null; _endedOnly = false; }">All Status</button>
            <button class="ca-chip @(_state == InactiveAccountState.Closed ? "ca-chip-active" : "")" type="button" @onclick="() => _state = InactiveAccountState.Closed">Closed</button>
            <button class="ca-chip @(_state == InactiveAccountState.Renewed ? "ca-chip-active" : "")" type="button" @onclick="() => _state = InactiveAccountState.Renewed">Renewed</button>
            <button class="ca-chip @(_state == InactiveAccountState.Superseded ? "ca-chip-active" : "")" type="button" @onclick="() => _state = InactiveAccountState.Superseded">Handed over</button>
            <button class="ca-chip @(_state == InactiveAccountState.Lapsed ? "ca-chip-active" : "")" type="button" @onclick="() => _state = InactiveAccountState.Lapsed">Lapsed</button>
        </div>

        <div class="ca-filter" role="group" aria-label="Facility">
            <button class="ca-chip @(_facility is null ? "ca-chip-active" : "")" type="button" @onclick="() => SelectFacility(null)">All Facilities</button>
            @foreach (var fc in Facilities)
            {
                <button class="ca-chip @(_facility == fc ? "ca-chip-active" : "")" type="button" @onclick="() => SelectFacility(fc)">@(System.Enum.TryParse<FacilityCode>(fc, out var _cc) ? FacilityCatalog.ShortNameOf(_cc) : fc)</button>
            }
        </div>

        @* Sections of the selected facility, from its own accounts — same affordance as the stallholder list.
           Shown whenever the facility has sections at all, so a market always states how its register is
           divided even when every inactive account happens to sit in one section. *@
        @if (SelectableSections.Count > 0)
        {
            <div class="ca-filter" role="group" aria-label="Section">
                <button class="ca-chip @(_section is null ? "ca-chip-active" : "")" type="button" @onclick="() => SelectSection(null)">All Sections</button>
                @foreach (var section in SelectableSections)
                {
                    var name = section;
                    <button class="ca-chip @(string.Equals(_section, name, StringComparison.OrdinalIgnoreCase) ? "ca-chip-active" : "")" type="button" @onclick="() => SelectSection(name)">@name</button>
                }
            </div>
        }

        <div class="ca-actions">
            <div class="ca-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="Search occupant, contract, or stall no.…" value="@_search" @oninput="OnSearch" aria-label="Search closed accounts" />
                @if (HasSearch)
                {
                    <button class="ca-search-clear" type="button" @onclick="@(() => _search = "")" aria-label="Clear search">&times;</button>
                }
            </div>
            <button class="ca-print-btn" type="button" @onclick="Print">
                <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Print
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="ca-loading no-print" aria-busy="true" aria-label="Loading closed accounts">
            <!-- Summary KPI card skeletons -->
            <div class="ca-summary">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="ca-sum-card">
                        <Skeleton Width="56%" Height="21px" Radius="7px" Class="ca-sk-center" />
                        <Skeleton Width="70%" Height="11px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                    </div>
                }
            </div>

            <!-- Document sheet skeleton -->
            <section class="ca-sheet">
                <header class="ca-rpt-head">
                    <Skeleton Width="54px" Height="54px" Radius="999px" Class="ca-sk-center" />
                    <Skeleton Width="190px" Height="9px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                    <Skeleton Width="320px" Height="16px" Radius="6px" Class="ca-sk-center ca-sk-gap" />
                    <Skeleton Width="240px" Height="11px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                </header>

                @for (var grp = 0; grp < 2; grp++)
                {
                    <div class="ca-year">
                        <div class="ca-year-head">
                            <Skeleton Width="70px" Height="16px" Radius="6px" />
                            <Skeleton Width="220px" Height="12px" Radius="5px" />
                        </div>
                        <div class="ca-table-skeleton">
                            <Skeleton Height="34px" Radius="6px" />
                            @for (var row = 0; row < 4; row++)
                            {
                                <Skeleton Height="32px" Radius="6px" />
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
    else
    {
        var rows = Filtered();
        var withBalance = rows.Where(r => r.Uncollected > 0).ToList();
        var groups = rows.GroupBy(r => EndOf(r).Year).OrderByDescending(g => g.Key).ToList();

        <!-- Summary KPI cards — top of page (screen only) -->
        <div class="ca-summary no-print">
            <div class="ca-sum-card">
                <div class="ca-sum-val">@rows.Count</div>
                <div class="ca-sum-lbl">Inactive Accounts</div>
            </div>
            @*  The two kinds of money must never be added into one figure, and each must carry its own count or
                "₱32,430" beside "58 accounts" reads as though it covered all of them. Money on an account that has
                ENDED or on a current lessee's PRIOR term is stated by this register alone. Money on a LAPSED term
                is a live receivable the arrears and follow-up lists already state in full, so adding the two would
                double the municipality's receivables.  *@
            <div class="ca-sum-card ca-sum-warn">
                <div class="ca-sum-val">@Money(EndedUncollected(rows))</div>
                <div class="ca-sum-lbl">Stated here only</div>
                <div class="ca-sum-sub">@CountLabel(EndedRows(rows).Count) · ended or a prior term</div>
            </div>
            <div class="ca-sum-card">
                <div class="ca-sum-val">@Money(LapsedUncollected(rows))</div>
                <div class="ca-sum-lbl">Lapsed · already in follow-up</div>
                <div class="ca-sum-sub">@CountLabel(LapsedRows(rows).Count) · still collected</div>
            </div>
            <div class="ca-sum-card">
                <div class="ca-sum-val">@Money(rows.Sum(r => r.LifetimeCollected))</div>
                <div class="ca-sum-lbl">Lifetime Collected</div>
            </div>
        </div>

        <section class="ca-sheet">
            <table class="ca-frame">
                <thead><tr><td><div class="ca-frame-space"></div></td></tr></thead>
                <tfoot><tr><td><div class="ca-frame-space"></div></td></tr></tfoot>
                <tbody><tr><td>
            <header class="ca-rpt-head">
                <img class="ca-seal" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
                <div class="ca-gov">Republic of the Philippines</div>
                <div class="ca-org">@Branding.OfficeName</div>
                <div class="ca-muni">Municipality of @Branding.Municipality, @Branding.Province</div>
                <div class="ca-doc">Register of Inactive Stall Accounts</div>
                <div class="ca-doc-scope">@(_year?.ToString() ?? "Whole Time")@(_state is null ? "" : " · " + _state)@(_facility is null ? "" : " · " + _facility)</div>
                @if (_section is not null)
                {
                    @* Stated once here, in the document's own navy, rather than repeated down the register. *@
                    <div class="ca-doc-section">@_section.ToUpper()</div>
                }
                <div class="ca-doc-period">As of @PhilippineTime.Today.ToString("MMMM d, yyyy")</div>
            </header>

            <div class="ca-note">
                Retained for transparency and audit. A balance here is <strong>stated by this register alone</strong>
                when the account has ended — closed, handed to another lessee, or the earlier term of a lessee who
                renewed. A <strong>lapsed</strong> term is different: the tenant is still in place and the office
                keeps collecting, so that balance also appears in the arrears and follow-up lists, and the two
                figures above are deliberately never added. Renewing writes nothing off.
            </div>

            @if (_endedOnly)
            {
                <div class="ca-scope-note no-print">
                    Showing only accounts whose balance this register alone reports, as quoted on the Financial
                    Reports. Lapsed terms still under collection are excluded.
                    <button type="button" class="ca-scope-clear" @onclick="() => _endedOnly = false">Show all inactive accounts</button>
                </div>
            }

            @if (_error is not null)
            {
                <div class="ca-state">@_error</div>
            }
            else if (rows.Count == 0)
            {
                <div class="ca-state">No inactive accounts match the current filter@(HasSearch ? " and search" : "").</div>
            }

            @foreach (var grp in groups)
            {
                var yr = grp.ToList();
                var facGroups = yr.GroupBy(r => r.FacilityName, StringComparer.OrdinalIgnoreCase)
                                  .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase).ToList();
                var singleFacility = facGroups.Count == 1;
                // Bulk renew covers accounts whose stall is actually free. A past occupancy on a stall that has
                // since been re-let is history — renewing it would displace the sitting lessee.
                var expiredInGroup = yr.Where(r => r.State != InactiveAccountState.Closed && !r.StallReLet).ToList();
                <div class="ca-year">
                    <div class="ca-year-head">
                        <span class="ca-year-label">@grp.Key@(singleFacility ? " · " + facGroups[0].Key : "")</span>
                        <div class="ca-year-right">
                            <span class="ca-year-stats">
                                <strong>@yr.Count</strong> account@(yr.Count != 1 ? "s" : "") ·
                                <strong>@Money(EndedUncollected(yr))</strong> on @CountLabel(EndedRows(yr).Count) stated here only ·
                                <strong>@Money(LapsedUncollected(yr))</strong> on @CountLabel(LapsedRows(yr).Count) also in follow-up
                            </span>
                            @if (expiredInGroup.Count > 0)
                            {
                                <button class="ca-renew-all-btn no-print" type="button"
                                        @onclick="() => OpenRenewAll(expiredInGroup)"
                                        title="Start a new contract term for every expired account in this group">
                                    <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                                    Renew all (@expiredInGroup.Count)
                                </button>
                            }
                        </div>
                    </div>

                    @foreach (var facGrp in facGroups)
                    {
                        var facRows = facGrp.OrderByDescending(r => EndOf(r)).ToList();
                        <div class="ca-fac-group">
                            @if (!singleFacility)
                            {
                                <div class="ca-fac-head">
                                    <span class="ca-fac-title">@facGrp.Key</span>
                                    <span class="ca-fac-stats">
                                        <strong>@facRows.Count</strong> account@(facRows.Count != 1 ? "s" : "") ·
                                        <strong>@Money(EndedUncollected(facRows))</strong> on @CountLabel(EndedRows(facRows).Count) stated here only ·
                                        <strong>@Money(LapsedUncollected(facRows))</strong> on @CountLabel(LapsedRows(facRows).Count) also in follow-up
                                    </span>
                                </div>
                            }

                            <table class="ca-table">
                                <thead>
                                    <tr>
                                        <th class="ca-c">#</th>
                                        <th class="ca-c">Status</th>
                                        <th class="ca-c">Stall</th>
                                        <th>Last Occupant</th>
                                        <th>Name on Contract</th>
                                        <th class="ca-c">Period (Effectivity → End)</th>
                                        <th class="ca-r">Lifetime Collected</th>
                                        <th class="ca-r">Uncollected</th>
                                        <th>Recorded By</th>
                                        <th class="ca-act no-print">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var n = 1; }
                                    @foreach (var r in facRows)
                                    {
                                        <tr>
                                            <td class="ca-c">@n</td>
                                            <td class="ca-c ca-status-text">@StateLabel(r.State)</td>
                                            <td class="ca-c">@r.StallNo</td>
                                            <td class="ca-fw">@r.Occupant</td>
                                            <td class="ca-muted">@(string.IsNullOrWhiteSpace(r.ContractName) ? "—" : r.ContractName)</td>
                                            <td class="ca-c ca-period">@r.EffectivityDate.ToString("MMM yyyy") <span>→</span> @EndOf(r).ToString("MMM d, yyyy")</td>
                                            <td class="ca-r">@Money(r.LifetimeCollected)</td>
                                            <td class="ca-r">
                                                @if (r.Uncollected > 0)
                                                {
                                                    <span class="ca-amt-due">@Money(r.Uncollected)</span>
                                                }
                                                else
                                                {
                                                    <span class="ca-amt-clear">@Money(0)</span>
                                                }
                                            </td>
                                            <td class="ca-muted">@(string.IsNullOrWhiteSpace(r.ClosedBy) ? "—" : r.ClosedBy)</td>
                                            <td class="ca-act no-print">
                                              <div class="ca-act-icons">
                                                @if (r.State == InactiveAccountState.Renewed)
                                                {
                                                    @* The same lessee is still in this stall on a fresh term. There
                                                       is nothing to renew and nothing to assign — the row is the
                                                       record of their earlier term, and its balance is still theirs. *@
                                                    <a class="ca-row-icon ca-row-view"
                                                       href="/profile/@r.FacilityCode.ToString().ToLowerInvariant()/@r.StallNo"
                                                       aria-label="View account"
                                                       title="The same lessee holds this stall on a new term. Open their account to collect this balance.">
                                                        @IconView
                                                    </a>
                                                }
                                                else if (r.StallReLet)
                                                {
                                                    @* Somebody else holds this stall now, so this row is a record
                                                       of a past occupancy: it cannot be renewed in place. If the
                                                       payor returns, they are placed in a stall of their own —
                                                       this account and its balance stay exactly as they are. *@
                                                    <button class="ca-row-icon ca-row-renew" type="button"
                                                            @onclick="() => OpenAssignNewStall(r)"
                                                            aria-label="Assign new stall"
                                                            title="This stall is taken. Place this payor in a new stall; this account and its balance are untouched.">
                                                        @IconAssign
                                                    </button>
                                                }
                                                else if (r.State == InactiveAccountState.Closed)
                                                {
                                                    @* The stall was frozen and nobody else has taken it, so the same
                                                       lessee can be put back in the same space. "Resume" is the plain
                                                       word for that: where the space was let without a contract there
                                                       is no term to renew, and "Reopen" read as an office procedure
                                                       rather than what happens to the vendor. *@
                                                    <button class="ca-row-icon ca-row-reopen" type="button"
                                                            @onclick="() => OpenReopen(r)"
                                                            aria-label="Resume account"
                                                            title="Resume this account — put this lessee back in the same space. The balance stays exactly as it is.">
                                                        @IconResume
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="ca-row-icon ca-row-renew" type="button"
                                                            @onclick="() => OpenRenew(r)"
                                                            aria-label="Renew term"
                                                            title="Renew this term. Renewing writes nothing off.">
                                                        @IconRenew
                                                    </button>
                                                }
                                                @if (!r.StallReLet)
                                                {
                                                    <AuthorizeView Roles="SuperAdmin" Context="authCtx">
                                                        <button class="ca-row-icon ca-row-remove" type="button"
                                                                @onclick="() => OpenRemove(r)"
                                                                aria-label="Remove account"
                                                                title="Remove this inactive account (frees the stall number)">
                                                            @IconRemove
                                                        </button>
                                                    </AuthorizeView>
                                                }
                                              </div>
                                            </td>
                                        </tr>
                                        n++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6">
                                            <strong>Subtotal — @facRows.Count account@(facRows.Count != 1 ? "s" : "")</strong>
                                        </td>
                                        <td class="ca-r"><strong>@Money(facRows.Sum(r => r.LifetimeCollected))</strong></td>
                                        <td class="ca-r">
                                            @if (EndedUncollected(facRows) > 0m)
                                            {
                                                <strong>@Money(EndedUncollected(facRows))</strong>
                                                <span class="ca-subtotal-note">stated here only</span>
                                            }
                                            @if (LapsedUncollected(facRows) > 0m)
                                            {
                                                <strong>@Money(LapsedUncollected(facRows))</strong>
                                                <span class="ca-subtotal-note">also in follow-up</span>
                                            }
                                            @if (EndedUncollected(facRows) <= 0m && LapsedUncollected(facRows) <= 0m)
                                            {
                                                <strong>@Money(0m)</strong>
                                            }
                                        </td>
                                        <td></td>
                                        <td class="ca-act no-print"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            }

            <div class="ca-rpt-foot">
                <SignatureStrip ShowDatePrepared="true" />
            </div>
                </td></tr></tbody>
            </table>
        </section>
    }
</div>

@* ── Reopen confirm modal ── *@
@if (_reopenTarget is not null)
{
    <div class="eemo-modal-overlay" @onclick="CloseModals">
        <div class="eemo-modal eemo-modal-sm" @onclick:stopPropagation="true">
            <div class="eemo-modal-header"><div class="eemo-modal-title">Reopen Stall?</div></div>
            <div class="eemo-modal-body">
                <p class="confirm-text">
                    Reopen stall @_reopenTarget.StallNo (@_reopenTarget.Occupant)? It resumes the same contract and
                    the closed period is recorded as excused — it will not be back-billed.
                </p>
                @if (_actionError is not null)
                {
                    <p class="ca-form-err">@_actionError</p>
                }
            </div>
            <div class="eemo-modal-footer">
                <button class="btn-ghost" @onclick="CloseModals" disabled="@_busy">Cancel</button>
                <button class="btn-primary" @onclick="ConfirmReopen" disabled="@_busy">@(_busy ? "Working…" : "Yes, Reopen")</button>
            </div>
        </div>
    </div>
}

@* ── Renew modal (Proceed / Edit) ── *@
@if (_assignTarget is not null)
{
    @* Placing a returning payor in a stall of their own. The account behind this dialog is NOT touched: its
       balance, its receipts and its dates stay exactly where they are, and remain collectable under "Whole time".
       The number offered is only a suggestion — the API decides, so two clerks cannot both take it. *@
    <div class="eemo-modal-overlay" @onclick="CloseModals">
        <div class="eemo-modal eemo-modal-sm" @onclick:stopPropagation="true">
            <div class="eemo-modal-header">
                <div class="eemo-modal-title">Assign @_assignTarget.Occupant a new stall</div>
            </div>
            <div class="eemo-modal-body">
                @if (_assignLoadingPreview)
                {
                    <p class="confirm-text">Preparing the new stall…</p>
                }
                else if (_assignPreview is not null)
                {
                    <p class="confirm-text">
                        Stall @_assignTarget.StallNo is held by another lessee, so a new stall is registered for
                        <strong>@_assignPreview.Occupant</strong> in <strong>@_assignPreview.FacilityName</strong>@(string.IsNullOrWhiteSpace(_assignPreview.SectionLabel) ? "" : $" ({_assignPreview.SectionLabel})").
                        Their closed account and its <strong>@Money(_assignTarget.Uncollected)</strong> balance are
                        left as they are, and stay collectable.
                    </p>

                    <div class="ca-form">
                        <label>Stall / space no.
                            <input type="text" maxlength="20" @bind="_assignStallNo" />
                        </label>
                        <label>Start date
                            <input type="date" @bind="_assignEffectivity" />
                        </label>
                        <label>Duration (years)
                            <input type="number" min="1" max="10" @bind="_assignDuration" />
                        </label>
                        <label>@(_assignPreview.IsDailyBilled ? "Monthly equivalent (₱)" : "Monthly rental (₱)")
                            <input type="number" min="0" step="0.01" @bind="_assignMonthlyRate" />
                        </label>
                        <label>Name on contract
                            <input type="text" @bind="_assignContractName" />
                        </label>
                    </div>
                }

                @if (_actionError is not null)
                {
                    <p class="ca-form-err">@_actionError</p>
                }
            </div>
            <div class="eemo-modal-footer">
                <button class="btn-ghost" @onclick="CloseModals" disabled="@_busy">Cancel</button>
                <button class="btn-primary" @onclick="ConfirmAssignNewStall" disabled="@(_busy || _assignPreview is null)">
                    @(_busy ? "Working…" : "Register stall")
                </button>
            </div>
        </div>
    </div>
}

@if (_renewTarget is not null)
{
    <div class="eemo-modal-overlay" @onclick="CloseModals">
        <div class="eemo-modal eemo-modal-sm" @onclick:stopPropagation="true">
            <div class="eemo-modal-header"><div class="eemo-modal-title">Renew Stall @_renewTarget.StallNo</div></div>
            <div class="eemo-modal-body">
                @if (!_renewEditing)
                {
                    <p class="confirm-text">
                        Start a new contract term for <strong>@_renewTarget.Occupant</strong> — beginning
                        <strong>@_renewEffectivity.ToString("MMM d, yyyy")</strong> for <strong>@_renewDuration year(s)</strong>,
                        same details as before. The lapsed period is not back-billed.
                    </p>
                }
                else
                {
                    @* Editing states the whole record the new term is let on, in the order the register form uses:
                       who holds it, the space it is, the term, then the rent. The space it is (facility, number,
                       section) is shown but not editable — moving a lessee to a different space is a transfer, not
                       a renewal, and the register row is identified by it. *@
                    <div class="ca-renew-facts">
                        <div><span>Facility</span><strong>@_renewTarget.FacilityName</strong></div>
                        <div><span>Stall / space no.</span><strong>@_renewTarget.StallNo</strong></div>
                        @if (!string.IsNullOrWhiteSpace(_renewTarget.Section))
                        {
                            <div><span>Section</span><strong>@_renewTarget.Section</strong></div>
                        }
                        <div><span>Term that lapsed</span><strong>@_renewTarget.EffectivityDate.ToString("MMM d, yyyy") — @_renewTarget.ExpiryDate.ToString("MMM d, yyyy")</strong></div>
                    </div>

                    <div class="ca-form-heading">Lessee</div>
                    <div class="ca-form">
                        <label>Actual occupant
                            <input type="text" @bind="_renewOccupant" />
                        </label>
                        <label>Name on contract
                            <input type="text" @bind="_renewName" />
                        </label>
                    </div>

                    <div class="ca-form-heading">New term</div>
                    <div class="ca-form">
                        <label>Start date
                            <input type="date" @bind="_renewEffectivity" />
                        </label>
                        <label>Duration (years)
                            <input type="number" min="1" max="50" @bind="_renewDuration" />
                        </label>
                    </div>

                    <div class="ca-form-heading">Space and rent</div>
                    <div class="ca-form">
                        <label>Area (sq.m)
                            <input type="number" min="0" step="0.01" @bind="_renewAreaSqm" />
                        </label>
                        <label>Area note
                            <input type="text" @bind="_renewAreaNote" placeholder="e.g. Corner, Extension" />
                        </label>
                        <label>Monthly rental (₱)
                            <input class="ca-renew-rate" type="number" min="0" step="0.01" @bind="_renewMonthlyRate" />
                        </label>
                    </div>
                    <p class="ca-renew-note">Whole year: @Money(_renewMonthlyRate * 12). The lapsed period is not back-billed.</p>
                }
                @if (_actionError is not null)
                {
                    <p class="ca-form-err">@_actionError</p>
                }
            </div>
            <div class="eemo-modal-footer">
                <button class="btn-ghost" @onclick="CloseModals" disabled="@_busy">Cancel</button>
                @if (!_renewEditing)
                {
                    <button class="btn-ghost" @onclick="() => _renewEditing = true" disabled="@_busy">Edit</button>
                    <button class="btn-primary" @onclick="ConfirmRenew" disabled="@_busy">@(_busy ? "Working…" : "Proceed")</button>
                }
                else
                {
                    <button class="btn-primary" @onclick="ConfirmRenew" disabled="@_busy">@(_busy ? "Working…" : "Confirm Renew")</button>
                }
            </div>
        </div>
    </div>
}

@* ── Renew all (bulk) confirm modal ── *@
@if (_renewAllOpen)
{
    <div class="eemo-modal-overlay" @onclick="CloseModals">
        <div class="eemo-modal eemo-modal-sm" @onclick:stopPropagation="true">
            <div class="eemo-modal-header"><div class="eemo-modal-title">Renew all expired accounts</div></div>
            <div class="eemo-modal-body">
                <p class="confirm-text">
                    Start a new contract term for <strong>@_renewAllTargets.Count expired account@(_renewAllTargets.Count != 1 ? "s" : "")</strong>@(_facility is null ? "" : " in this facility") — beginning
                    <strong>@_renewAllEffectivity.ToString("MMM d, yyyy")</strong> for <strong>@_renewAllDuration year(s)</strong>.
                    Each keeps its own occupant and contract name. The lapsed period is not back-billed.
                </p>
                <div class="ca-form">
                    <label>Start date
                        <input type="date" @bind="_renewAllEffectivity" />
                    </label>
                    <label>Duration (years)
                        <input type="number" min="1" max="50" @bind="_renewAllDuration" />
                    </label>
                </div>
                @if (_renewAllProgress is not null)
                {
                    <p class="confirm-text">@_renewAllProgress</p>
                }
                @if (_actionError is not null)
                {
                    <p class="ca-form-err">@_actionError</p>
                }
            </div>
            <div class="eemo-modal-footer">
                <button class="btn-ghost" @onclick="CloseModals" disabled="@_busy">Cancel</button>
                <button class="btn-primary" @onclick="ConfirmRenewAll" disabled="@_busy">@(_busy ? "Working…" : $"Renew {_renewAllTargets.Count}")</button>
            </div>
        </div>
    </div>
}

@* ── Remove confirm modal (SuperAdmin) ── *@
@if (_removeTarget is not null)
{
    <div class="eemo-modal-overlay" @onclick="CloseModals">
        <div class="eemo-modal eemo-modal-sm" @onclick:stopPropagation="true">
            <div class="eemo-modal-header"><div class="eemo-modal-title">Remove Account?</div></div>
            <div class="eemo-modal-body">
                <p class="confirm-text">
                    Remove @(_removeTarget.State == InactiveAccountState.Closed ? "closed" : "expired") stall
                    <strong>@_removeTarget.StallNo</strong> (@_removeTarget.Occupant) from the roster?
                    Its collection history is kept for audit, but the stall <strong>number @_removeTarget.StallNo is freed</strong>
                    for reuse. Only closed/expired accounts can be removed — a currently active stall never can.
                </p>
                @if (_actionError is not null)
                {
                    <p class="ca-form-err">@_actionError</p>
                }
            </div>
            <div class="eemo-modal-footer">
                <button class="btn-ghost" @onclick="CloseModals" disabled="@_busy">Cancel</button>
                <button class="btn-danger" @onclick="ConfirmRemove" disabled="@_busy">@(_busy ? "Working…" : "Yes, Remove")</button>
            </div>
        </div>
    </div>
}

@code {
    // ── Data ──
    private List<ClosedStallAccountDto> _accounts = new();

    // ── Row action glyphs ──
    // Sized by attribute rather than by stylesheet: a hand-built render fragment carries no CSS-isolation attribute,
    // so a scoped ".ca-row-icon svg" rule would never match it and the icons would render at their natural size.
    private static readonly RenderFragment IconView = @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>;
    private static readonly RenderFragment IconAssign = @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8l7-4 7 4v13" /><path d="M10 21v-6h4v6" /><path d="M19 4v6" /><path d="M16 7h6" /></svg>;
    private static readonly RenderFragment IconResume = @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /><path d="M11 10l5 3-5 3v-6Z" /></svg>;
    private static readonly RenderFragment IconRenew = @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /></svg>;
    private static readonly RenderFragment IconRemove = @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M6 7l1 13h10l1-13" /><path d="M9 7V4h6v3" /></svg>;

    private bool _loading = true;
    private string? _error;

    [PersistentState(AllowUpdates = true)]
    public List<ClosedStallAccountDto>? CachedClosedAccounts { get; set; }

    // ── Filters ──
    private int? _year;
    private string? _facility;
    private string? _section;
    private InactiveAccountState? _state;
    private string _search = "";

    /// <summary>
    /// Sections present in the selected facility's inactive accounts, from the data itself — so each LGU's own
    /// section labels appear and a facility without sections shows no rail.
    /// </summary>
    private IReadOnlyList<string> SelectableSections =>
        _facility is null
            ? Array.Empty<string>()
            : _accounts
                .Where(r => r.FacilityCode.ToString() == _facility && !string.IsNullOrWhiteSpace(r.Section))
                .Select(r => r.Section)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();

    // A section belongs to a facility, so changing facility drops the section filter.
    private void SelectFacility(string? code)
    {
        _facility = code;
        _section = null;
    }

    private void SelectSection(string? section) => _section = section;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    /// <summary>
    /// Lets a caller land on the accounts it was quoting. The Financial Reports state one figure for balances on
    /// former occupancies; following it to a page listing all 58 accounts and ₱1.9M answered a different question
    /// than the one that was clicked. <c>?status=ended</c> opens on those accounts alone.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "status")]
    public string? StatusFromQuery { get; set; }

    /// <summary>True when the view is scoped to accounts this register alone reports — everything but a lapsed term.</summary>
    private bool _endedOnly;

    /// <summary>
    /// Accounts whose balance this register alone states: closed, handed to a different lessee, or the prior term of
    /// a lessee who renewed. Nothing else in the system reports this money.
    /// </summary>
    private static List<ClosedStallAccountDto> EndedRows(IEnumerable<ClosedStallAccountDto> rows)
        => rows.Where(r => r.State != InactiveAccountState.Lapsed).ToList();

    /// <summary>Accounts whose term merely lapsed — a live receivable the arrears and follow-up lists carry in full.</summary>
    private static List<ClosedStallAccountDto> LapsedRows(IEnumerable<ClosedStallAccountDto> rows)
        => rows.Where(r => r.State == InactiveAccountState.Lapsed).ToList();

    private static string CountLabel(int count) => $"{count} account{(count == 1 ? "" : "s")}";

    private static decimal EndedUncollected(IEnumerable<ClosedStallAccountDto> rows)
        => EndedRows(rows).Sum(r => r.Uncollected);

    private static decimal LapsedUncollected(IEnumerable<ClosedStallAccountDto> rows)
        => LapsedRows(rows).Sum(r => r.Uncollected);

    /// <summary>
    /// What the office calls each kind of account. "Lapsed" must read as an account still being collected, not as
    /// a finished one — the enum name alone ("Expired") is what let the register imply the debt was set aside.
    /// </summary>
    private static string StateLabel(InactiveAccountState state) => state switch
    {
        InactiveAccountState.Closed => "Closed",
        InactiveAccountState.Renewed => "Renewed",
        InactiveAccountState.Superseded => "Handed over",
        InactiveAccountState.Lapsed => "Lapsed",
        _ => "Expired",
    };    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";
    private async Task Print() => await JS.InvokeVoidAsync("print");

    private IEnumerable<string> Facilities => FacilityCatalog.Rental.Select(c => c.ToString());
    private int[] Years = Array.Empty<int>();

    private void OnPickYear(int? year) => _year = year;

    // ── Action state ──
    private ClosedStallAccountDto? _reopenTarget;
    private ClosedStallAccountDto? _renewTarget;
    private ClosedStallAccountDto? _removeTarget;
    private bool _renewEditing;
    private DateOnly _renewEffectivity;
    private int _renewDuration;
    private string _renewOccupant = "";
    private string? _renewName;
    // The space and the money for the new term. Seeded from the record, and each kept alongside the figure it
    // was seeded with so an untouched box is never sent back as a change.
    private decimal _renewMonthlyRate, _renewSeedMonthlyRate;
    private double? _renewAreaSqm, _renewSeedAreaSqm;
    private string? _renewAreaNote, _renewSeedAreaNote;
    private bool _busy;
    private string? _actionError;

    // ── Renew all (bulk renew of the expired accounts currently in view) ──
    private bool _renewAllOpen;
    private DateOnly _renewAllEffectivity;
    private int _renewAllDuration = 3;
    private List<ClosedStallAccountDto> _renewAllTargets = new();
    private string? _renewAllProgress;

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();

        _endedOnly = string.Equals(StatusFromQuery, "ended", StringComparison.OrdinalIgnoreCase);

        if (CachedClosedAccounts is not null)
        {
            ApplyClosedAccounts(CachedClosedAccounts);
            _loading = false;
            return;
        }

        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        await PaintLoadingStateAsync();

        var result = await StallsApi.GetClosedStallAccountsAsync();
        if (result.IsSuccess && result.Value is not null)
        {
            ApplyClosedAccounts(result.Value.ToList());
            CachedClosedAccounts = _accounts;
        }
        else
        {
            _error = result.Error ?? "Failed to load closed accounts.";
            _accounts = new();
        }
        _loading = false;
    }

    private void ApplyClosedAccounts(IReadOnlyList<ClosedStallAccountDto> accounts)
    {
        _accounts = accounts as List<ClosedStallAccountDto> ?? accounts.ToList();
        Years = _accounts.Select(a => EndOf(a).Year).Distinct().OrderByDescending(y => y).ToArray();
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    // The lifecycle end point used for grouping/sorting: close date (closed) or expiry (expired).
    // The day the account actually ended: the closure date, else the day this lessee stopped holding the stall
    // (a handover ends an occupancy before its term would have run out), else the term's expiry.
    private static DateOnly EndOf(ClosedStallAccountDto r) => r.ClosedOn ?? r.OccupancyEndedOn ?? r.ExpiryDate;

    private IReadOnlyList<ClosedStallAccountDto> Filtered()
    {
        IEnumerable<ClosedStallAccountDto> q = _accounts;
        if (_year is int y) q = q.Where(r => EndOf(r).Year == y);
        if (_state is InactiveAccountState st) q = q.Where(r => r.State == st);

        // Arrived from a figure that quoted only the accounts this register alone reports.
        if (_endedOnly) q = q.Where(r => r.State != InactiveAccountState.Lapsed);
        if (_facility is not null) q = q.Where(r => r.FacilityCode.ToString() == _facility);
        if (_section is not null) q = q.Where(r => string.Equals(r.Section, _section, StringComparison.OrdinalIgnoreCase));
        if (HasSearch)
        {
            var s = _search.Trim();
            q = q.Where(r =>
                r.Occupant.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (r.ContractName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                r.StallNo.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        return q.OrderByDescending(r => EndOf(r)).ToList();
    }

    // ── Assign a returning payor a stall of their own ─────────────────────────────────────────────────
    // A past occupancy cannot be renewed in place: the space belongs to somebody else now. The payor is instead
    // registered on a NEW stall, and the old account is left completely alone — its balance was incurred under
    // that contract, its receipts reference it, and the register is the record of it. Nothing is transferred.
    //
    // The server prepares the move (it knows the old stall's facility, section, fee shape and daily rate, and
    // which number is next), so this page never has to infer any of it from a facility name.

    private ClosedStallAccountDto? _assignTarget;
    private StallReassignmentPreviewDto? _assignPreview;
    private string _assignStallNo = string.Empty;
    private DateOnly _assignEffectivity;
    private int _assignDuration = 3;
    private decimal _assignMonthlyRate;
    private string? _assignContractName;
    private bool _assignLoadingPreview;

    private async Task OpenAssignNewStall(ClosedStallAccountDto row)
    {
        _assignTarget = row;
        _assignPreview = null;
        _actionError = null;
        _assignLoadingPreview = true;
        _assignEffectivity = PhilippineTime.Today;
        _assignDuration = Math.Clamp(row.DurationYears, 1, 10);
        _assignMonthlyRate = row.MonthlyRate;
        _assignContractName = row.ContractName ?? row.Occupant;
        _assignStallNo = string.Empty;

        var preview = await StallsApi.GetStallReassignmentPreviewAsync(row.StallId, row.ContractId);
        _assignLoadingPreview = false;

        if (!preview.IsSuccess || preview.Value is null)
        {
            _actionError = preview.Error ?? "Couldn't prepare the new stall. Close this and try again.";
            return;
        }

        _assignPreview = preview.Value;
        _assignStallNo = preview.Value.SuggestedStallNo;
        _assignMonthlyRate = preview.Value.MonthlyRate;
        _assignDuration = preview.Value.SuggestedDurationYears;
        _assignContractName = preview.Value.NameOnContract ?? preview.Value.Occupant;
    }

    private async Task ConfirmAssignNewStall()
    {
        if (_assignTarget is null || _busy) return;

        if (string.IsNullOrWhiteSpace(_assignStallNo))
        {
            _actionError = "Give the new stall a number.";
            return;
        }

        _busy = true;
        _actionError = null;

        var result = await StallsApi.AssignPastOccupantStallAsync(new AssignPastOccupantStallCommand(
            _assignTarget.StallId,
            _assignStallNo.Trim(),
            _assignEffectivity.ToDateTime(TimeOnly.MinValue),
            _assignDuration,
            _assignMonthlyRate,
            string.IsNullOrWhiteSpace(_assignContractName) ? null : _assignContractName!.Trim(),
            // The term this row is the record of — on a re-let stall the latest term is the sitting lessee's.
            _assignTarget.ContractId));

        _busy = false;

        if (!result.IsSuccess)
        {
            _actionError = result.ValidationErrors?.Values.FirstOrDefault()?.FirstOrDefault()
                ?? result.Error
                ?? "Couldn't register the new stall.";
            return;
        }

        CloseModals();
        await Load();   // the old account stays on the register; the new stall now appears in its facility
    }

    // ── Reopen ──
    private void OpenReopen(ClosedStallAccountDto r) { _reopenTarget = r; _actionError = null; }

    private async Task ConfirmReopen()
    {
        if (_reopenTarget is null) return;
        _busy = true; _actionError = null;
        var result = await StallsApi.ToggleStallStatusAsync(_reopenTarget.StallId, close: false);
        _busy = false;
        if (result.IsSuccess) { CloseModals(); await Load(); }
        else _actionError = result.Error ?? "Failed to reopen the stall.";
    }

    // ── Renew ──
    private void OpenRenew(ClosedStallAccountDto r)
    {
        _renewTarget = r;
        _renewEditing = false;
        _renewEffectivity = PhilippineTime.Today;     // Proceed default: fresh start today (no back-billing of the gap)
        _renewDuration = r.DurationYears > 0 ? r.DurationYears : 1;
        _renewOccupant = r.Occupant;
        _renewName = r.ContractName;
        // The record as it stands. Editing starts from these, and each is sent only if the clerk actually
        // changed it — the register states a DERIVED rent (a daily-collected space shows thirty of its daily
        // fee; a monthly one shows the rate the LAPSED term was let at), so sending an untouched box back
        // would write that display figure over the stall's own stored rate.
        _renewMonthlyRate = _renewSeedMonthlyRate = r.MonthlyRate;
        _renewAreaSqm = _renewSeedAreaSqm = r.AreaSqm;
        _renewAreaNote = _renewSeedAreaNote = r.AreaNote;
        _actionError = null;
    }

    private async Task ConfirmRenew()
    {
        if (_renewTarget is null) return;
        if (string.IsNullOrWhiteSpace(_renewOccupant)) { _actionError = "Occupant is required."; return; }
        if (_renewDuration < 1) { _actionError = "Duration must be at least 1 year."; return; }
        if (_renewEditing && _renewMonthlyRate < 0) { _actionError = "Monthly rental cannot be negative."; return; }
        if (_renewEditing && _renewAreaSqm is < 0) { _actionError = "Area cannot be negative."; return; }

        _busy = true; _actionError = null;
        // Only what the clerk actually changed is stated. Everything else is sent as null, which the server
        // reads as "as it stands" — so both Proceed and an Edit that only fixed the occupant leave the stall's
        // rate, area and note exactly where they were.
        var rate = _renewEditing && _renewMonthlyRate != _renewSeedMonthlyRate ? (decimal?)_renewMonthlyRate : null;
        var area = _renewEditing && _renewAreaSqm != _renewSeedAreaSqm ? _renewAreaSqm : null;
        var note = _renewEditing && !string.Equals(_renewAreaNote ?? "", _renewSeedAreaNote ?? "", StringComparison.Ordinal)
            ? (_renewAreaNote ?? string.Empty)
            : null;
        var req = new RenewStallContractRequest(_renewEffectivity, _renewDuration, _renewOccupant.Trim(), _renewName,
                                                rate, area, note);
        var result = await StallsApi.RenewStallContractAsync(_renewTarget.StallId, req);
        _busy = false;
        if (result.IsSuccess) { CloseModals(); await Load(); }
        else _actionError = result.Error ?? "Failed to renew the contract.";
    }

    // ── Renew all (bulk) ──
    private void OpenRenewAll(IReadOnlyList<ClosedStallAccountDto> expired)
    {
        _renewAllTargets = expired.ToList();
        _renewAllEffectivity = PhilippineTime.Today;   // fresh start today; the lapsed gap is never back-billed
        _renewAllDuration = 3;
        _renewAllProgress = null;
        _actionError = null;
        _renewAllOpen = true;
    }

    private async Task ConfirmRenewAll()
    {
        if (_renewAllTargets.Count == 0) { CloseModals(); return; }
        if (_renewAllDuration < 1) { _actionError = "Duration must be at least 1 year."; return; }

        _busy = true;
        _actionError = null;
        var ok = 0;
        var failed = 0;
        // Each account keeps its own occupant + contract name; only the (common) start date + term are applied.
        foreach (var r in _renewAllTargets)
        {
            _renewAllProgress = $"Renewing {ok + failed + 1} of {_renewAllTargets.Count}…";
            await InvokeAsync(StateHasChanged);
            try
            {
                var req = new RenewStallContractRequest(_renewAllEffectivity, _renewAllDuration, r.Occupant, r.ContractName);
                var res = await StallsApi.RenewStallContractAsync(r.StallId, req);
                if (res.IsSuccess) ok++; else failed++;
            }
            catch { failed++; }
        }
        _busy = false;

        if (failed == 0)
        {
            CloseModals();
            await Load();
        }
        else
        {
            _actionError = $"{ok} renewed, {failed} failed. Please retry the remaining accounts.";
            var targetIds = _renewAllTargets.Select(t => t.StallId).ToHashSet();
            await Load();   // refresh so the successfully-renewed rows drop off the list
            _renewAllTargets = _accounts
                .Where(r => r.State != InactiveAccountState.Closed && targetIds.Contains(r.StallId))
                .ToList();
            _renewAllProgress = null;
        }
    }

    private void CloseModals()
    {
        _reopenTarget = null;
        _renewTarget = null;
        _removeTarget = null;
        _assignTarget = null;
        _assignPreview = null;
        _assignLoadingPreview = false;
        _renewEditing = false;
        _renewAllOpen = false;
        _renewAllProgress = null;
        _actionError = null;
    }

    // ── Remove (soft-delete an inactive account; frees the stall number) ──
    private void OpenRemove(ClosedStallAccountDto r) { _removeTarget = r; _actionError = null; }

    private async Task ConfirmRemove()
    {
        if (_removeTarget is null) return;
        _busy = true; _actionError = null;
        var result = await StallsApi.SoftDeleteStallAsync(_removeTarget.StallId);
        _busy = false;
        if (result.IsSuccess) { CloseModals(); await Load(); }
        else _actionError = result.Error ?? "Failed to remove the account.";
    }

    private static string Money(decimal v) => "₱" + v.ToString("N0");
}
