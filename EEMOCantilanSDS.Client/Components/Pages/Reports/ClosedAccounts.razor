@page "/reports/closed-accounts"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Application.Dtos.Stalls
@using EEMOCantilanSDS.Application.Requests.Stalls
@using EEMOCantilanSDS.Application.Command.Stalls.AssignPastOccupantStall
@inject IStallsApiClient StallsApi
@inject IObligationsApiClient ObligationsApi
@inject ILifecycleApiClient LifecycleApi
@using EEMOCantilanSDS.Application.Common.Lifecycle
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Client.Exports
@using System.Globalization
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

@* ───────────────────────────────────────────────────────────────────────────────
   Closed / Inactive Accounts — transparency register of CLOSED (frozen) and EXPIRED
   (contract lapsed) stall accounts with lifetime collected + uncollected-at-end.
   Read-only printable sheet; on-screen it also offers Reopen (closed) / Renew (expired).
   Facility history: GET /api/stalls/closed-accounts. Source-owned KM/VF/FA closures use the obligation workspaces;
   their still-live balances are separate from the stall-only receivable figures.
   ─────────────────────────────────────────────────────────────────────────────── *@

<PageTitle>StallTrack — Closed Accounts</PageTitle>

<header class="topbar no-print">
    <div class="topbar-left">
        <div class="topbar-title">Closed Accounts</div>
        <div class="topbar-breadcrumb">
            <a href="/menu" class="breadcrumb-link">Dashboard</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Closed Accounts</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-period">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            As of <strong>@PhilippineTime.Today.ToString("MMM d, yyyy")</strong>
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    <!-- Controls: year + state + facility + search + print -->
    <div class="ca-controls no-print">
        @* One cluster of filters — period, status, source and (when the facility has sections) section — so they read as one
           control group at the same height. *@
        <div class="ca-filters" role="group" aria-label="Filters">
            <div class="ca-filter" role="group" aria-label="Year">
                <ReportPeriodNav YearFilterMode="true" SelectedYear="_year" FilterYears="Years" AlignRight="false"
                                 Label="@(_year?.ToString() ?? "Whole Time")"
                                 OnSelectYear="OnPickYear" />
            </div>
            <FhSelect Caption="Status" Value="@StatusValue" Options="@StatusOptions" ValueChanged="@SelectStatus" />
            <FhSelect Caption="Source" Value="@(_facility ?? "")" Options="@SourceOptions" ValueChanged="@(v => SelectFacility(v.Length == 0 ? null : v))" />
            @if (SelectableSections.Count > 0)
            {
                <FhSelect Caption="Section" Value="@(_section ?? "")" Options="@SectionOptions" ValueChanged="@(v => SelectSection(v.Length == 0 ? null : v))" />
            }
        </div>

        <div class="ca-actions">
            <div class="ca-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="Search occupant, contract, or stall no.…" value="@_search" @oninput="OnSearch" aria-label="Search closed accounts" />
                @if (HasSearch)
                {
                    <button class="ca-search-clear" type="button" @onclick="@(() => _search = "")" aria-label="Clear search">&times;</button>
                }
            </div>
            @* Print, CSV and Excel are one control: three ways to take the same filtered register, each usable alone. *@
            <div class="ca-export" role="group" aria-label="Print or export the register">
                <button class="ca-export-btn" type="button" @onclick="Print">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                    Print
                </button>
                @if (!_loading && _error is null && _obligationErrors.Count == 0)
                {
                    <a class="ca-export-btn" href="@ExportCsvHref" download="inactive-rental-accounts.csv">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                        CSV
                    </a>
                    <button class="ca-export-btn" type="button" @onclick="ExportExcel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18" /><path d="M3 15h18" /><path d="M9 3v18" /></svg>
                        Excel
                    </button>
                }
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="ca-loading no-print" aria-busy="true" aria-label="Loading closed accounts">
            <!-- Summary KPI card skeletons -->
            <div class="ca-summary">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="ca-sum-card">
                        <Skeleton Width="56%" Height="21px" Radius="7px" Class="ca-sk-center" />
                        <Skeleton Width="70%" Height="11px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                    </div>
                }
            </div>

            <!-- Document sheet skeleton -->
            <section class="ca-sheet">
                <header class="ca-rpt-head">
                    <Skeleton Width="54px" Height="54px" Radius="999px" Class="ca-sk-center" />
                    <Skeleton Width="190px" Height="9px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                    <Skeleton Width="320px" Height="16px" Radius="6px" Class="ca-sk-center ca-sk-gap" />
                    <Skeleton Width="240px" Height="11px" Radius="5px" Class="ca-sk-center ca-sk-gap" />
                </header>

                @for (var grp = 0; grp < 2; grp++)
                {
                    <div class="ca-year">
                        <div class="ca-year-head">
                            <Skeleton Width="70px" Height="16px" Radius="6px" />
                            <Skeleton Width="220px" Height="12px" Radius="5px" />
                        </div>
                        <div class="ca-table-skeleton">
                            <Skeleton Height="34px" Radius="6px" />
                            @for (var row = 0; row < 4; row++)
                            {
                                <Skeleton Height="32px" Radius="6px" />
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
    else
    {
        var rows = Filtered();
        var withBalance = rows.Where(r => r.Uncollected > 0).ToList();
        var groups = rows.GroupBy(r => EndOf(r).Year).OrderByDescending(g => g.Key).ToList();

        <!-- Summary KPI cards — top of page (screen only) -->
        <div class="ca-summary no-print">
            <div class="ca-sum-card">
                <div class="ca-sum-val">@(rows.Count + FilteredObligations().Count)</div>
                <div class="ca-sum-lbl">Inactive Accounts</div>
            </div>
            @*  The two kinds of money must never be added into one figure, and each must carry its own count or
                "₱32,430" beside "58 accounts" reads as though it covered all of them. Money on an account that has
                ENDED or on a current lessee's PRIOR term is stated by this register alone. Money on a LAPSED term
                is a live receivable the delinquency and follow-up lists already state in full, so adding the two would
                double the municipality's receivables.  *@
            <div class="ca-sum-card ca-sum-warn">
                <div class="ca-sum-val">@Money(EndedUncollected(rows))</div>
                <div class="ca-sum-lbl">Stated here only</div>
                <div class="ca-sum-sub">@CountLabel(EndedRows(rows).Count) · ended or a prior term</div>
            </div>
            <div class="ca-sum-card">
                <div class="ca-sum-val">@Money(LapsedUncollected(rows))</div>
                <div class="ca-sum-lbl">Lapsed · already in follow-up</div>
                <div class="ca-sum-sub">@CountLabel(LapsedRows(rows).Count) · still collected</div>
            </div>
            <div class="ca-sum-card">
                <div class="ca-sum-val">@Money(rows.Sum(r => r.LifetimeCollected))</div>
                <div class="ca-sum-lbl">Stall lifetime collected</div>
                <div class="ca-sum-sub">Facility stall accounts only</div>
            </div>
        </div>

        <section class="ca-sheet">
            <table class="ca-frame">
                <thead><tr><td><div class="ca-frame-space"></div></td></tr></thead>
                <tfoot><tr><td><div class="ca-frame-space"></div></td></tr></tfoot>
                <tbody><tr><td>
            <header class="ca-rpt-head">
                <img class="ca-seal" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
                <div class="ca-gov">Republic of the Philippines</div>
                <div class="ca-org">@Branding.OfficeName</div>
                <div class="ca-muni">Municipality of @Branding.Municipality, @Branding.Province</div>
                <div class="ca-doc">Register of Inactive Rental Accounts</div>
                <div class="ca-doc-scope">@(_year?.ToString() ?? "Whole Time")@(_state is null ? "" : " · " + _state)@(_facility is null ? "" : " · " + _facility)</div>
                @if (_section is not null)
                {
                    @* Stated once here, in the document's own navy, rather than repeated down the register. *@
                    <div class="ca-doc-section">@_section.ToUpper()</div>
                }
                <div class="ca-doc-period">As of @PhilippineTime.Today.ToString("MMMM d, yyyy")</div>
            </header>

            @* The qualifier a filed copy needs, in one line; the reasoning is a disclosure on screen rather than a paragraph
               repeated above every table. *@
            <div class="ca-note">
                A balance on an ended account is <strong>stated by this register alone</strong>. A <strong>lapsed</strong> term is still
                collected and also appears in follow-up, so the two are never added.
            </div>
            <details class="ca-why no-print">
                <summary>How these balances are counted</summary>
                <p>
                    Retained for transparency and audit. An account has <strong>ended</strong> when it was closed, handed to another lessee, or
                    is the earlier term of a lessee who renewed; its balance is stated here and nowhere else. A <strong>lapsed</strong> term is
                    different: the tenant is still in place and the office keeps collecting, so that balance also appears in the delinquency and
                    follow-up lists. Renewing writes nothing off.
                </p>
            </details>

            @if (_endedOnly)
            {
                <div class="ca-scope-note no-print">
                    Showing only accounts whose balance this register alone reports, as quoted on the Financial
                    Reports. Lapsed terms still under collection are excluded.
                    <button type="button" class="ca-scope-clear" @onclick="() => _endedOnly = false">Show all inactive accounts</button>
                </div>
            }

            @if (_error is not null)
            {
                <div class="ca-state">@_error</div>
            }
            else if (rows.Count == 0 && FilteredObligations().Count == 0 && _obligationErrors.Count == 0)
            {
                <div class="ca-state">No inactive accounts match the current filter@(HasSearch ? " and search" : "").</div>
            }

            @foreach (var grp in groups)
            {
                var yr = grp.ToList();
                var facGroups = yr.GroupBy(r => r.FacilityName, StringComparer.OrdinalIgnoreCase)
                                  .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase).ToList();
                <div class="ca-year">
                    <div class="ca-year-head">
                        <span class="ca-year-label">@grp.Key</span>
                        <div class="ca-year-right">
                            <span class="ca-year-stats"><strong>@yr.Count</strong> account@(yr.Count != 1 ? "s" : "")</span>
                        </div>
                    </div>

                    @foreach (var facGrp in facGroups)
                    {
                        var facRows = facGrp.OrderByDescending(r => EndOf(r)).ToList();
                        // Bulk renewal is decided one facility at a time, from THIS facility's rows in THIS year group — never
                        // from the year as a whole — and by the same test the row's own Renew action uses.
                        var renewable = facRows.Where(EEMOCantilanSDS.Client.Components.Pages.Menus.Facilities.StallTermRenewals.IsBulkRenewable).DistinctBy(r => r.StallId).ToList();
                        <div class="ca-fac-group">
                            <div class="ca-fac-head">
                                <span class="ca-fac-title">@facGrp.Key</span>
                                <div class="ca-fac-right">
                                    <span class="ca-fac-stats"><strong>@facRows.Count</strong> account@(facRows.Count != 1 ? "s" : "")</span>
                                    @if (renewable.Count > 0)
                                    {
                                        <a class="ca-renew-all-btn no-print" href="@($"/facility/{renewable[0].FacilityCode.ToString().ToLowerInvariant()}/renewals")"
                                                aria-label="@($"Renew eligible accounts — {facGrp.Key} ({renewable.Count})")"
                                                title="@($"Start a new contract term for the {renewable.Count} eligible account{(renewable.Count != 1 ? "s" : "")} in {facGrp.Key} only")">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                                            Renew eligible (@renewable.Count)
                                        </a>
                                    }
                                </div>
                            </div>

                            <table class="ca-table">
                                <thead>
                                    <tr>
                                        <th class="ca-c">#</th>
                                        <th class="ca-c">Status</th>
                                        <th class="ca-c">Stall</th>
                                        <th>Last Occupant</th>
                                        <th>Name on Contract</th>
                                        <th class="ca-c">Period (Effectivity → End)</th>
                                        <th class="ca-r">Lifetime Collected</th>
                                        <th class="ca-r">Uncollected</th>
                                        <th>Recorded By</th>
                                        <th class="ca-act no-print">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var n = 1; }
                                    @foreach (var r in facRows)
                                    {
                                        <tr>
                                            <td class="ca-c">@n</td>
                                            <td class="ca-c ca-status-text">@StateLabel(r.State)</td>
                                            @* Blank for a space the office does not number, matching its own list.
                                               The identifier still exists behind this and still drives the link
                                               below; it is simply not a fact the office would recognise. *@
                                            <td class="ca-c">@SpaceNumber.Display(r.StallNo)</td>
                                            <td class="ca-fw">@r.Occupant</td>
                                            <td class="ca-muted">@(string.IsNullOrWhiteSpace(r.ContractName) ? "—" : r.ContractName)</td>
                                            <td class="ca-c ca-period">@r.EffectivityDate.ToString("MMM yyyy") <span>→</span> @EndOf(r).ToString("MMM d, yyyy")</td>
                                            <td class="ca-r">@Money(r.LifetimeCollected)</td>
                                            <td class="ca-r">
                                                @if (r.Uncollected > 0)
                                                {
                                                    <span class="ca-amt-due">@Money(r.Uncollected)</span>
                                                }
                                                else
                                                {
                                                    <span class="ca-amt-clear">@Money(0)</span>
                                                }
                                            </td>
                                            <td class="ca-muted">@(string.IsNullOrWhiteSpace(r.ClosedBy) ? "—" : r.ClosedBy)</td>
                                            <td class="ca-act no-print">
                                              <div class="ca-act-icons">
                                                @if (r.State == InactiveAccountState.Renewed)
                                                {
                                                    @* The same lessee is still in this stall on a fresh term. There
                                                       is nothing to renew and nothing to assign — the row is the
                                                       record of their earlier term, and its balance is still theirs. *@
                                                    <a class="ca-row-icon ca-row-view"
                                                       href="/profile/@r.FacilityCode.ToString().ToLowerInvariant()/@(r.StallId == Guid.Empty ? r.StallNo : r.StallId.ToString())"
                                                       aria-label="View account"
                                                       title="The same lessee holds this stall on a new term. Open their account to collect this balance.">
                                                        @IconView
                                                    </a>
                                                }
                                                else if (r.StallReLet)
                                                {
                                                    @* Somebody else holds this stall now, so this row is a record
                                                       of a past occupancy: it cannot be renewed in place. If the
                                                       payor returns, they are placed in a stall of their own —
                                                       this account and its balance stay exactly as they are. *@
                                                    <a class="ca-row-icon ca-row-renew" href="@StallActionHref(r, "assign")"
                                                            aria-label="Assign new stall"
                                                            title="This stall is taken. Place this payor in a new stall; this account and its balance are untouched.">
                                                        @IconAssign
                                                    </a>
                                                }
                                                else if (r.State == InactiveAccountState.Closed)
                                                {
                                                    @* The stall was frozen and nobody else has taken it, so the same
                                                       lessee can be put back in the same space. "Resume" is the plain
                                                       word for that: where the space was let without a contract there
                                                       is no term to renew, and "Reopen" read as an office procedure
                                                       rather than what happens to the vendor.

                                                       Refused while its SECTION is closed: resuming would start billing
                                                       a space the market page does not show, so the money would accrue
                                                       where nobody can see it. Reopening the section returns every stall
                                                       its closure closed, this one among them. The server refuses it too. *@
                                                    <a class="ca-row-icon ca-row-reopen" href="@(r.SectionClosed ? null : StallActionHref(r, "resume"))" aria-disabled="@(r.SectionClosed ? "true" : null)"
                                                            aria-label="Resume account"
                                                            title="@(r.SectionClosed
                                                                ? $"{r.Section} is closed. Reopen the section in Facility Configuration to bring its stalls back."
                                                                : "Resume this account — put this lessee back in the same space. The balance stays exactly as it is.")">
                                                        @IconResume
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="ca-row-icon ca-row-renew" href="@StallActionHref(r, "renew")"
                                                            aria-label="Renew term"
                                                            title="Renew this term. Renewing writes nothing off.">
                                                        @IconRenew
                                                    </a>
                                                }
                                                @if (!r.StallReLet)
                                                {
                                                    <AuthorizeView Roles="SuperAdmin" Context="authCtx">
                                                        <a class="ca-row-icon ca-row-remove" href="@StallActionHref(r, "remove")"
                                                                aria-label="Remove account"
                                                                title="Remove this inactive account (frees the stall number)">
                                                            @IconRemove
                                                        </a>
                                                    </AuthorizeView>
                                                }
                                              </div>
                                            </td>
                                        </tr>
                                        n++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6">
                                            <strong>Subtotal — @facRows.Count account@(facRows.Count != 1 ? "s" : "")</strong>
                                        </td>
                                        <td class="ca-r"><strong>@Money(facRows.Sum(r => r.LifetimeCollected))</strong></td>
                                        <td class="ca-r">
                                            @if (EndedUncollected(facRows) > 0m)
                                            {
                                                <strong>@Money(EndedUncollected(facRows))</strong>
                                                <span class="ca-subtotal-note">stated here only</span>
                                            }
                                            @if (LapsedUncollected(facRows) > 0m)
                                            {
                                                <strong>@Money(LapsedUncollected(facRows))</strong>
                                                <span class="ca-subtotal-note">also in follow-up</span>
                                            }
                                            @if (EndedUncollected(facRows) <= 0m && LapsedUncollected(facRows) <= 0m)
                                            {
                                                <strong>@Money(0m)</strong>
                                            }
                                        </td>
                                        <td></td>
                                        <td class="ca-act no-print"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            }

            @foreach (var error in _obligationErrors)
            {
                <div class="ca-state" role="alert">@error <button class="no-print" type="button" @onclick="ReloadObligations">Retry rental sources</button></div>
            }
            @foreach (var source in FilteredObligations().GroupBy(x => x.Code))
            {
                var spaceRows = source.OrderByDescending(x => x.Account.ActiveTo).ToList();
                <div class="ca-year ca-obligation-source">
                    <div class="ca-year-head">
                        <span class="ca-year-label">@source.First().Source.Name</span>
                        <span class="ca-year-stats"><strong>@spaceRows.Count</strong> account@(spaceRows.Count != 1 ? "s" : "")</span>
                    </div>
                    @* Source-owned accounts keep their balances in their own workspaces, so these are never added to the stall figures
                       above, and no contract expiry is inferred for them. *@
                    <p class="ca-source-note">Balances stay in the account workspace and are not part of the totals above.</p>
                    @if (_lifecycleFailed && source.Key != "FA")
                    {
                        <p class="ca-source-note no-print" role="status">Row actions could not be loaded. <button type="button" class="btn-ghost" @onclick="LoadLifecycleAsync">Try again</button></p>
                    }
                    <table class="ca-table">
                        <thead><tr><th>Space / Unit</th><th>Holder</th><th>@(source.Key == "FA" ? "Event" : "Recorded basis")</th><th class="ca-c">Start → Closure</th><th class="ca-c">Status</th><th class="ca-r">Assessed</th><th class="ca-r">Collected</th><th class="ca-r">Remaining</th>
                            <th class="ca-act no-print">Action</th></tr></thead>
                        <tbody>@foreach (var item in spaceRows)
                        {
                            var a = item.Account;
                            <tr data-account="@a.Id"><td class="ca-fw">@item.Unit @a.SubjectLabel</td><td>@SpaceAccountPresentation.Occupant(a)</td><td class="ca-muted">@(item.Code == "FA" ? $"{a.Event} · {a.EventDate:MMM d, yyyy}" : SpaceAccountPresentation.Basis(a))</td><td class="ca-c ca-period">@a.ActiveFrom.ToString("MMM d, yyyy") <span>→</span> @a.ActiveTo?.ToString("MMM d, yyyy")</td><td class="ca-c ca-status-text">@(item.Code == "FA" ? "Closed event lot" : "Closed")</td><td class="ca-r">@Money(a.AssessedToDate)</td><td class="ca-r">@Money(a.CollectedToDate)</td>
                                <td class="ca-r">@if (a.OutstandingToDate > 0) { <span class="ca-amt-due">@Money(a.OutstandingToDate)</span> } else { <span class="ca-amt-clear">@Money(0)</span> }</td>
                                <td class="ca-act no-print"><div class="ca-act-icons"><a class="ca-row-icon ca-row-view" href="@item.ProfileHref" aria-label="View account" title="Open the account">@IconView</a>
                                    @foreach (var action in SpaceRowActions(item))
                                    {
                                        @if (action.Allowed)
                                        {
                                            <a class="ca-row-icon @RowClass(action.Action)" href="@($"{item.ProfileHref}?action={LifecyclePresentation.QueryName(action.Action)}")"
                                               aria-label="@LifecyclePresentation.Label(action.Action, LifecycleSource.SpaceRental)" title="@RowTitle(action.Action)">@RowIcon(action.Action)</a>
                                        }
                                        else
                                        {
                                            <span class="ca-row-icon ca-row-off" role="img" aria-disabled="true" aria-label="@LifecyclePresentation.Label(action.Action, LifecycleSource.SpaceRental)" title="@action.Reason">@RowIcon(action.Action)</span>
                                        }
                                    }
                                </div></td></tr>
                        }</tbody>
                    </table>
                </div>
            }
            <div class="ca-rpt-foot">
                <SignatureStrip ShowDatePrepared="true" />
            </div>
                </td></tr></tbody>
            </table>
        </section>
    }
</div>

@code {

    private static readonly IReadOnlyList<SheetColumn> ExportColumns = [new("Source", SheetValueKind.Text), new("Unit", SheetValueKind.Text), new("Account identity", SheetValueKind.Text), new("Holder", SheetValueKind.Text), new("Start", SheetValueKind.Date), new("End", SheetValueKind.Date), new("Status", SheetValueKind.Text), new("Assessed", SheetValueKind.Money), new("Collected", SheetValueKind.Money), new("Remaining", SheetValueKind.Money), new("Balance scope", SheetValueKind.Text)];
    private IReadOnlyList<IReadOnlyList<object?>> ExportRows => Filtered().Select(a => (IReadOnlyList<object?>)new object?[] {
        SourceName(a.FacilityCode.ToString()), $"{FacilityCatalog.HolderUnitFor(a.FacilityCode.ToString())} {SpaceNumber.Display(a.StallNo)}", $"Stall {a.StallId}; contract {a.ContractId}", a.Occupant, a.EffectivityDate, EndOf(a), StateLabel(a.State), null, a.LifetimeCollected, a.Uncollected,
        a.State == InactiveAccountState.Lapsed ? "Also in live follow-up" : "Stated here only" })
        .Concat(FilteredObligations().Select(x => (IReadOnlyList<object?>)new object?[] { x.Source.Name, $"{x.Unit} {x.Account.SubjectLabel}", x.Account.Id.ToString(), SpaceAccountPresentation.Occupant(x.Account), x.Account.ActiveFrom, x.Account.ActiveTo, x.Code == "FA" ? "Closed event lot" : "Closed", x.Account.AssessedToDate, x.Account.CollectedToDate, x.Account.OutstandingToDate, "Already in source account workspace" })).ToArray();
    private string ExportCsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join("\r\n", new[] {
        ExportCsv("Register of Inactive Rental Accounts", Branding.OfficeName, Branding.Municipality, Branding.Province),
        ExportCsv("As of", PhilippineTime.Today.ToString("yyyy-MM-dd"), "Year", _year?.ToString() ?? "All", "Source", _facility ?? "All", "Status", _state?.ToString() ?? "All", "Search", _search),
        ExportCsv(ExportColumns.Select(x => x.Header).ToArray()) }
        .Concat(ExportRows.Select(r => ExportCsv(r.Select(x => x switch { DateOnly d => d.ToString("yyyy-MM-dd"), decimal m => m.ToString("0.00", CultureInfo.InvariantCulture), _ => Convert.ToString(x, CultureInfo.InvariantCulture) }).ToArray())))));
    private static string ExportCsv(params string?[] cells) => string.Join(',', cells.Select(x => CsvCell.Escape(x ?? "")));
    private async Task ExportExcel()
    {
        if (_loading || _error is not null || _obligationErrors.Count > 0) return;
        var bytes = SpreadsheetBuilder.Build("Inactive Rental Accounts", ExportColumns, ExportRows);
        await JS.InvokeVoidAsync("downloadFileFromBytes", "inactive-rental-accounts.xlsx", Convert.ToBase64String(bytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private readonly List<ClosedObligationRentalRow> _obligationRows = [];
    private readonly List<string> _obligationErrors = [];
    // Lifecycle eligibility for the monthly-space rows: ONE batched read once the page has rendered (never during prerender), so each row shows the same
    // compact icons a stall row does. The report changes nothing: an action is a link to the account's profile, where it is previewed and confirmed.
    private readonly Dictionary<Guid, AccountLifecycleDto> _lifecycle = [];
    private bool _lifecycleRequested, _lifecycleFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lifecycleRequested || !_obligationRows.Any(x => x.Code != "FA")) return;
        _lifecycleRequested = true;
        await LoadLifecycleAsync();
    }

    private async Task LoadLifecycleAsync()
    {
        _lifecycleFailed = false;
        try
        {
            var ids = _obligationRows.Where(x => x.Code != "FA").Select(x => x.Account.Id).Distinct().ToList();
            foreach (var chunk in ids.Chunk(200))
            {
                var result = await LifecycleApi.GetManyAsync(LifecycleSource.SpaceRental, chunk);
                if (result is not { IsSuccess: true }) { _lifecycleFailed = true; break; }
                foreach (var dto in result.Value ?? []) _lifecycle[dto.AccountId] = dto;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _lifecycleFailed = true; }
        StateHasChanged();
    }

    // Only what applies to the row, as for a stall: the actions the server allows, and Resume-type actions that merely wait for the account's one-time space setup.
    private IEnumerable<AllowedAction> SpaceRowActions(ClosedObligationRentalRow item)
    {
        if (item.Code == "FA" || !_lifecycle.TryGetValue(item.Account.Id, out var life)) yield break;
        foreach (var action in life.Actions)
            if (LifecyclePresentation.SpaceActions.Contains(action.Action) && (action.Allowed || action.ReasonCode == SpaceLifecycleWorkflow.NoSpaceRegistration))
                yield return action;
    }

    private static string RowClass(LifecycleAction action) => action switch { LifecycleAction.Resume => "ca-row-reopen", LifecycleAction.Remove => "ca-row-remove", _ => "ca-row-renew" };
    private static RenderFragment RowIcon(LifecycleAction action) => action switch { LifecycleAction.Resume => IconResume, LifecycleAction.Remove => IconRemove, LifecycleAction.Renew => IconRenew, _ => IconAssign };
    private static string RowTitle(LifecycleAction action) => action switch
    {
        LifecycleAction.Resume => "Resume this account — put this holder back in the same space. The balance stays exactly as it is.",
        LifecycleAction.Reassign => "Reassign this space to a different holder. This account and its balance are untouched.",
        LifecycleAction.Renew => "Renew this contract term.",
        _ => "Retire this closed account. Its history and balance are kept."
    };

    private async Task ReloadObligations()
    {
        _obligationRows.Clear();
        _obligationErrors.Clear();
        // Each read retains its tenant-scoped authoritative identity. No common receivable is calculated.
        foreach (var entry in new[] { ("KM", "Space", SpaceAccountPresentation.Kanmanggay), ("Vegetable/Fruits", "Space", SpaceAccountPresentation.VegetableFruit), ("FA", "Lot", SpaceAccountPresentation.FiestaAraw) })
        {
            try
            {
                var result = await ObligationsApi.GetWorkspaceAsync(entry.Item3.Kind);
                if (result?.IsSuccess == true && result.Value is not null)
                    _obligationRows.AddRange(result.Value.Accounts.Where(a => a.Kind == entry.Item3.Kind && RentalAccountStates.HasEnded(a.ActiveTo, PhilippineTime.Today)).Select(a => new ClosedObligationRentalRow(entry.Item1, entry.Item2, entry.Item3, a)));
                else _obligationErrors.Add($"{entry.Item1}: {result?.Error ?? "Account register could not be loaded."}");
            }
            catch { _obligationErrors.Add($"{entry.Item1}: Account register could not be loaded."); }
        }
        UpdateYears();
    }
    private void UpdateYears() => Years = _accounts.Select(a => EndOf(a).Year).Concat(_obligationRows.Select(x => x.Account.ActiveTo!.Value.Year)).Distinct().OrderByDescending(x => x).ToArray();
    private IReadOnlyList<ClosedObligationRentalRow> FilteredObligations() => _obligationRows.Where(x =>
        !_endedOnly && _section is null && (_state is null || _state == InactiveAccountState.Closed)
        && (_facility is null || x.Code == _facility)
        && (_year is null || x.Account.ActiveTo!.Value.Year == _year)
        && (!HasSearch || SpaceAccountPresentation.Occupant(x.Account).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || x.Account.SubjectLabel.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.Account.ContractReference?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderByDescending(x => x.Account.ActiveTo).ToList();
    // ── Data ──
    private List<ClosedStallAccountDto> _accounts = new();

    // ── Row action glyphs ──
    // Sized by attribute rather than by stylesheet: a hand-built render fragment carries no CSS-isolation attribute,
    // so a scoped ".ca-row-icon svg" rule would never match it and the icons would render at their natural size.
