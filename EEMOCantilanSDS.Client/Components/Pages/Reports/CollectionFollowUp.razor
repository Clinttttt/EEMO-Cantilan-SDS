@page "/reports/collection-follow-up"
@page "/reports/follow-up"
@page "/reports/follow-up/history"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav

<PageTitle>StallTrack — Collection Follow-up</PageTitle>

@*
    Collection Follow-up — one module, two scopes.

    The office had two separate pages for one job, and the split was the source of most of the confusion we have
    spent this week correcting: a current-period page carrying cumulative balances, a whole-time page reporting no
    delinquents, and the same account reading differently depending on which you happened to open.

    They are now one page with an explicit scope. CURRENT QUEUE is the collector's work for the month. WHOLE-TIME
    HISTORY is the account review. Each scope keeps its own summary, filters, row wording and actions, because they
    answer different questions — and each states which span its figures cover, so a figure can never be read as the
    other scope's.

    This is presentation only. Neither scope's figures are computed here: they come from the same composer, under the
    invariant it enforces — one occupancy, one row per scope, one balance contribution, statuses as labels.

    The two former routes still resolve here so existing links, bookmarks and the office's own shortcuts keep
    working; the URL decides which scope opens.
*@

<div class="cfu-scope no-print" role="tablist" aria-label="Collection follow-up scope">
    <button type="button"
            role="tab"
            aria-selected="@(_scope == Scope.Current)"
            class="cfu-scope-tab @(_scope == Scope.Current ? "cfu-scope-active" : "")"
            @onclick="() => SetScope(Scope.Current)">
        Current Queue
        <span class="cfu-scope-hint">This collection period</span>
    </button>
    <button type="button"
            role="tab"
            aria-selected="@(_scope == Scope.History)"
            class="cfu-scope-tab @(_scope == Scope.History ? "cfu-scope-active" : "")"
            @onclick="() => SetScope(Scope.History)">
        Whole-time History
        <span class="cfu-scope-hint">Accounts and earlier terms</span>
    </button>
</div>

@* Both scopes stay mounted once opened so switching back does not refetch or lose a filter the clerk had set. *@
@if (_scope == Scope.Current)
{
    <FollowUpQueue />
}
else
{
    <PastFollowUpQueue />
}

@code {
    private enum Scope { Current, History }

    private Scope _scope = Scope.Current;

    protected override void OnInitialized()
    {
        _scope = ScopeFromUrl();

        // Both former routes resolve to this one component, so the router does not re-initialise when the office
        // follows an in-page link from one scope to the other — the address would change and the view would not.
        // Watching for the location change keeps the two in step.
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var scope = ScopeFromUrl();
        if (scope == _scope) return;
        _scope = scope;
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>
    /// The scope the URL asks for. The history route opens on the account review; everything else opens on the
    /// collector's queue, which is what the office wants first thing in the morning.
    /// </summary>
    private Scope ScopeFromUrl()
        => Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').EndsWith("history", StringComparison.OrdinalIgnoreCase)
            ? Scope.History
            : Scope.Current;

    /// <summary>
    /// Switching scope rewrites the address without reloading, so the two views remain linkable on their own — the
    /// office pastes these URLs into notes and messages.
    /// </summary>
    private void SetScope(Scope scope)
    {
        if (_scope == scope) return;
        _scope = scope;
        Nav.NavigateTo(scope == Scope.History ? "/reports/follow-up/history" : "/reports/follow-up", forceLoad: false);
    }
}
