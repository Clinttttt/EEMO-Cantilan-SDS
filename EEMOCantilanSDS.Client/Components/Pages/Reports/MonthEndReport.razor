@page "/reports/month-end"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Common.Revenue
@using EEMOCantilanSDS.Application.Dtos.Facilities
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Common
@inject IFacilitiesApiClient FacilitiesApi
@inject IOfficialReportsApiClient OfficialApi
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.FacilityState Facilities

<PageTitle>StallTrack — Monthly Collection Report</PageTitle>

<header class="topbar no-print">
    <div class="topbar-left">
        <div class="topbar-title">Monthly Collection Report</div>
        <div class="topbar-breadcrumb">
            <a href="/menu" class="breadcrumb-link">Dashboard</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Monthly Collection Report</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-period">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            Collection Period: <strong>@PeriodLabel</strong>
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    <!-- Period nav + print -->
    <div class="me-controls no-print">
        <div class="me-period-nav">
            <button class="me-nav-btn" type="button" @onclick="PrevMonth" aria-label="Previous month">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div class="me-period-picker">
                <button class="me-period-btn" type="button" @onclick="TogglePicker" aria-haspopup="true" aria-expanded="@_pickerOpen">
                    <span class="me-period">@PeriodLabel</span>
                    <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </button>
                @if (_pickerOpen)
                {
                    <div class="me-picker-backdrop" @onclick="ClosePicker"></div>
                    <div class="me-picker">
                        <div class="me-picker-head">
                            <button class="me-picker-yr-btn" type="button" @onclick="PickerPrevYear" aria-label="Previous year">
                                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
                            </button>
                            <span class="me-picker-year">@_pickerYear</span>
                            <button class="me-picker-yr-btn" type="button" @onclick="PickerNextYear" aria-label="Next year">
                                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                            </button>
                        </div>
                        <div class="me-picker-grid">
                            @for (var m = 1; m <= 12; m++)
                            {
                                var month = m;
                                var isSelected = _pickerYear == Year && month == Month;
                                var isCurrent = _pickerYear == PhilippineTime.Now.Year && month == PhilippineTime.Now.Month;
                                <button type="button"
                                        class="me-picker-month @(isSelected ? "selected" : "") @(isCurrent && !isSelected ? "current" : "")"
                                        @onclick="() => SelectMonth(month)">
                                    @MonthAbbr(month)
                                </button>
                            }
                        </div>
                        <div class="me-picker-foot">
                            <button class="me-picker-today" type="button" @onclick="JumpToCurrentMonth">Go to current month</button>
                        </div>
                    </div>
                }
            </div>
            <button class="me-nav-btn" type="button" @onclick="NextMonth" aria-label="Next month">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
        </div>
        @* One compact selector per question — which group of the office's revenue, then which source within it. Replaces a
           row of one button per facility, which could not cover the sources that have no facility. *@
        <div class="me-filter">
            <FhSelect Caption="Group" Value="@_group" Options="@GroupOptions" ValueChanged="@SelectGroup" />
            <FhSelect Caption="Source" Value="@_source" Options="@SourceOptions" ValueChanged="@(v => _source = v)" />
        </div>
        <div class="me-actions">
            <div class="me-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="Search payor, stall, or OR no.…" value="@_search" @oninput="OnSearchInput" aria-label="Search account detail" />
                @if (HasSearch)
                {
                    <button class="me-search-clear" type="button" @onclick="ClearSearch" aria-label="Clear search">&times;</button>
                }
            </div>
            <button class="me-print-btn" type="button" disabled="@Loading" @onclick="Print">
                <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Print
            </button>
        </div>
    </div>

    @if (Loading)
    {
        <div class="me-loading no-print" aria-busy="true" aria-label="Loading month-end report">
            <div class="me-summary">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="me-sum-card">
                        <Skeleton Width="64%" Height="22px" Radius="7px" Class="me-sk-center" />
                        <Skeleton Width="48%" Height="11px" Radius="5px" Class="me-sk-center me-sk-gap" />
                    </div>
                }
            </div>

            <section class="me-sheet">
                <header class="me-rpt-head">
                    <Skeleton Width="54px" Height="54px" Radius="999px" Class="me-sk-center" />
                    <Skeleton Width="190px" Height="9px" Radius="5px" Class="me-sk-center me-sk-gap" />
                    <Skeleton Width="280px" Height="16px" Radius="6px" Class="me-sk-center me-sk-gap" />
                    <Skeleton Width="220px" Height="11px" Radius="5px" Class="me-sk-center me-sk-gap" />
                    <Skeleton Width="360px" Height="20px" Radius="999px" Class="me-sk-center me-sk-gap" />
                </header>

                @for (var section = 0; section < 2; section++)
                {
                    <div class="me-facility">
                        <div class="me-fac-head">
                            <div class="me-fac-title">
                                <Skeleton Width="150px" Height="17px" Radius="6px" />
                                <Skeleton Width="92px" Height="18px" Radius="999px" />
                            </div>
                            <Skeleton Width="220px" Height="14px" Radius="6px" />
                        </div>
                        <div class="me-table-skeleton">
                            <Skeleton Height="34px" Radius="7px" />
                            @for (var row = 0; row < 4; row++)
                            {
                                <Skeleton Height="32px" Radius="7px" />
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
    else if (Report is null)
    {
        <div class="me-state me-state-error">
            Unable to load the report.
            <button class="me-retry" type="button" @onclick="Load">Try again</button>
        </div>
    }
    else
    {
        var visibleFacilities = VisibleFacilities().ToList();
        var officialRows = OfficialRows;
        var rentalDetail = visibleFacilities.Where(f => f.IsRental).ToList();
        var detailCollected = visibleFacilities.Sum(ShownCollected);
        var detailOutstanding = rentalDetail.Sum(ShownOutstanding);
        var (sumPaid, sumPartial, sumUnpaid) = ShownStatusCounts(visibleFacilities);
        // A rate has a denominator only where something is billed: it is shown for a rental-only scope, never across sources.
        var rentalOnly = rentalDetail.Count > 0 && rentalDetail.Count == visibleFacilities.Count && (HasSearch || _group == RevenueSourceCatalog.RentGroup || _source != MonthlyCollectionReport.All);

        <!-- Quick-glance totals (screen only; excluded from print / PDF) -->
        <div class="me-summary no-print">
            @if (HasSearch)
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@Money(detailCollected)</div>
                    <div class="me-sum-lbl">Collected · matching accounts</div>
                </div>
            }
            else if (Official is not null)
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@Money(officialRows.Sum(r => r.Collected))</div>
                    <div class="me-sum-lbl">@(_group == MonthlyCollectionReport.All && _source == MonthlyCollectionReport.All ? "Collected · all sources" : "Collected · selected scope")</div>
                </div>
            }
            else
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@Money(detailCollected)</div>
                    <div class="me-sum-lbl">Collected · account detail only</div>
                </div>
            }
            @if (rentalDetail.Count > 0)
            {
                <div class="me-sum-card">
                    <div class="me-sum-val me-red">@Money(detailOutstanding)</div>
                    <div class="me-sum-lbl">Outstanding rent</div>
                </div>
            }
            @if (rentalOnly)
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@RateOf(rentalDetail.Sum(ShownCollected), detailOutstanding)%</div>
                    <div class="me-sum-lbl">Rental collection rate</div>
                </div>
            }
            @if (rentalDetail.Count > 0)
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@sumPaid / @sumPartial / @sumUnpaid</div>
                    <div class="me-sum-lbl">Rental accounts paid / partial / unpaid</div>
                </div>
            }
            @if (!HasSearch && Official is not null && officialRows.Count > 0 && officialRows.All(r => r.TransactionCount is not null))
            {
                <div class="me-sum-card">
                    <div class="me-sum-val">@officialRows.Sum(r => r.TransactionCount!.Value).ToString("N0")</div>
                    <div class="me-sum-lbl">Collection records</div>
                </div>
            }
        </div>

        <!-- Printable report -->
        <section class="me-sheet">
            <header class="me-rpt-head">
                <img class="me-seal" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
                <div class="me-gov">Republic of the Philippines</div>
                <div class="me-org">@Branding.OfficeName</div>
                <div class="me-muni">Municipality of @Branding.Municipality, @Branding.Province</div>
                <div class="me-doc">Monthly Collection Report</div>
                <div class="me-period-line">@PeriodLine</div>
            </header>

            @if (_group != MonthlyCollectionReport.All || _source != MonthlyCollectionReport.All || HasSearch)
            {
                <div class="me-scope-row">
                    <span class="me-scope">@ScopeLabel</span>
                </div>
            }

            @* ── The official collections, by the office's revenue groups ──────────────────────────────────────────
               Every figure here is the official source projection for the month — legacy before cutover plus canonical
               after it, each collection once — so the total is the statement's total, not a sum of facility subtotals.
               Hidden while searching, because a search is about accounts, which only the detail below holds. *@
            @if (!HasSearch)
            {
                <div class="me-facility me-official">
                    <div class="me-fac-head">
                        <div class="me-fac-title"><span class="me-fac-name">Collections by revenue source</span></div>
                        @if (Official is not null)
                        {
                            <div class="me-fac-stats"><span><strong>@Money(officialRows.Sum(r => r.Collected))</strong> collected</span></div>
                        }
                    </div>

                    @if (Official is null)
                    {
                        <div class="me-fac-note" role="alert">
                            The official collections could not be loaded, so no all-source total is shown. The account detail below is unaffected.
                            <button class="me-retry no-print" type="button" @onclick="ReloadOfficial">Try again</button>
                        </div>
                    }
                    else if (officialRows.Count == 0)
                    {
                        <div class="me-fac-note">No sources match your current filter.</div>
                    }
                    else
                    {
                        <div class="me-table-wrap"><table class="me-table me-src-table">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Basis</th>
                                    <th>Receipt</th>
                                    <th class="me-num">Records</th>
                                    <th class="me-num">Collected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in OfficialGroups(officialRows))
                                {
                                    <tr class="me-area-row"><td colspan="5">@MonthlyCollectionReport.GroupLabel(group.Key)</td></tr>
                                    @foreach (var row in group)
                                    {
                                        <tr>
                                            <td>@row.Label@if (row.AwaitingPlacement) { <span class="me-tag me-tag-warn">Needs official placement</span> }</td>
                                            <td class="me-quiet">@BasisLabel(row)</td>
                                            <td class="me-quiet">@(string.IsNullOrWhiteSpace(row.Instruments) ? "—" : row.Instruments)</td>
                                            <td class="me-num">@(row.TransactionCount is { } count ? count.ToString("N0") : "—")</td>
                                            <td class="me-num">@Money(row.Collected)</td>
                                        </tr>
                                    }
                                    <tr class="me-area-sub">
                                        <td colspan="4">@MonthlyCollectionReport.GroupLabel(group.Key) subtotal</td>
                                        <td class="me-num">@Money(group.Sum(r => r.Collected))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"><strong>@(_group == MonthlyCollectionReport.All && _source == MonthlyCollectionReport.All ? "Total — all sources" : "Total — selected scope")</strong></td>
                                    <td class="me-num"><strong>@Money(officialRows.Sum(r => r.Collected))</strong></td>
                                </tr>
                            </tfoot>
                        </table></div>
                    }
                </div>
            }

            @if (visibleFacilities.Count > 0)
            {
                <div class="me-section-title">Account detail</div>
            }
            else if (HasSearch)
            {
                <div class="me-state">No account detail matches your search.</div>
            }
            else
            {
                <div class="me-fac-note">Account-level detail is not kept for this scope; the figures above are the official collection totals.</div>
            }
            @foreach (var f in visibleFacilities)
            {
                var payors = VisiblePayors(f);
                var txnPayors = VisibleTxnPayors(f);
                var collectedShown = f.IsRental
                    ? (HasSearch ? payors.Sum(p => p.AmountPaid) : f.Collected)
                    : (HasSearch ? txnPayors.Sum(p => p.TotalCollected) : f.Collected);
                var outstandingShown = HasSearch ? payors.Sum(p => p.Balance) : f.Outstanding;
                var rateShown = HasSearch ? RateOf(collectedShown, outstandingShown) : f.CollectionRate;
                <div class="me-facility">
                    <div class="me-fac-head">
                        <div class="me-fac-title">
                            <span class="me-fac-name">@f.Name</span>
                            @if (MonthlyCollectionReport.IsCustom(f.Code))
                            {
                                <span class="me-tag">@(f.CustomCategory == EEMOCantilanSDS.Domain.Enums.CustomFacilityCategory.SpaceRental
                                    ? "Space Rental" : "Stall Rent")</span>
                            }
                            @if (f.Code == FacilityCode.TRM)
                            {
                                @* The facility record is the legacy trip ledger. Terminal cash recorded since cutover is itemised in the
                                   official source rows above, so this table is never read as the whole of Income From Terminal. *@
                                <span class="me-tag">Legacy trip records</span>
                            }
                            else if (!f.IsRental)
                            {
                                <span class="me-tag">Transaction-based</span>
                            }
                        </div>
                        <div class="me-fac-stats">
                            <span><strong>@Money(collectedShown)</strong> collected</span>
                            @if (f.IsRental)
                            {
                                <span class="me-red"><strong>@Money(outstandingShown)</strong> outstanding</span>
                                <span><strong>@rateShown%</strong> rate</span>
                            }
                        </div>
                    </div>

                    @if (f.IsRental && payors.Count > 0)
                    {
                        var isDaily = f.Code == FacilityCode.NPM;
                        @* The kilos column appears only when the view holds kilos, so a market with no weighing and
                           every other facility print the sheet they printed before. *@
                        var showKilos = isDaily && payors.Any(p => p.FishKilos > 0);
                        var areas = PayorAreas(payors);
                        var columnCount = (isDaily ? 8 : 7) + (showKilos ? 1 : 0);
                        <div class="me-table-wrap"><table class="me-table">
                            <thead>
                                <tr>
                                    <th>Stall</th>
                                    <th>@(isDaily ? "Vendor" : "Payor")</th>
                                    <th class="me-num">@(isDaily ? "Daily Rate" : "Monthly Rate")</th>
                                    <th>Status</th>
                                    @if (showKilos)
                                    {
                                        <th class="me-num">Fish (kg)</th>
                                    }
                                    <th class="me-num">Collected</th>
                                    <th class="me-num">@(isDaily ? "Due to Date" : "Balance")</th>
                                    @if (isDaily)
                                    {
                                        <th class="me-num">Monthly Coverage</th>
                                        <th class="me-num">Monthly Balance</th>
                                    }
                                    @if (!isDaily)
                                    {
                                        <th>OR No.</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @* Read area by area when the facility has areas, because that is how the market is
                                   walked and how the office reconciles it. One group, or none, prints as a plain list. *@
                                @foreach (var area in areas)
                                {
                                    @if (area.Key.Length > 0)
                                    {
                                        <tr class="me-area-row">
                                            <td colspan="@columnCount">@SectionLabel(f.Code, area.Key)</td>
                                        </tr>
                                    }
                                    @foreach (var p in area)
                                    {
                                        <tr class="@RowClass(p.Status)">
                                            <td>@SpaceNumber.Display(p.StallNo)</td>
                                            <td>@p.Payor</td>
                                            <td class="me-num">@Money(isDaily ? p.DailyRate : p.MonthlyRate)</td>
                                            <td><span class="me-status @StatusClass(p.Status)">@p.Status</span></td>
                                            @if (showKilos)
                                            {
                                                <td class="me-num">@(p.FishKilos > 0 ? Kilos(p.FishKilos) : "—")</td>
                                            }
                                            <td class="me-num">@(p.AmountPaid > 0 ? Money(p.AmountPaid) : "—")</td>
                                            <td class="me-num @(p.Balance > 0 ? "me-red" : "")">@(p.Balance > 0 ? Money(p.Balance) : "—")</td>
                                            @if (isDaily)
                                            {
                                                <td class="me-num">@Money(p.MonthlyCoverage)</td>
                                                <td class="me-num @(p.MonthlyCoverageBalance > 0 ? "me-red" : "")">@(p.MonthlyCoverageBalance > 0 ? Money(p.MonthlyCoverageBalance) : "—")</td>
                                            }
                                            @if (!isDaily)
                                            {
                                                <td>@(string.IsNullOrWhiteSpace(p.ORNumber) ? "—" : p.ORNumber)</td>
                                            }
                                        </tr>
                                    }
                                    @if (area.Key.Length > 0 && areas.Count > 1)
                                    {
                                        var areaCollected = area.Sum(p => p.AmountPaid);
                                        var areaBalance = area.Sum(p => p.Balance);
                                        <tr class="me-area-sub">
                                            <td colspan="4">@SectionLabel(f.Code, area.Key) subtotal</td>
                                            @if (showKilos)
                                            {
                                                var areaKilos = area.Sum(p => p.FishKilos);
                                                <td class="me-num">@(areaKilos > 0 ? Kilos(areaKilos) : "—")</td>
                                            }
                                            <td class="me-num">@Money(areaCollected)</td>
                                            <td class="me-num @(areaBalance > 0 ? "me-red" : "")">@(areaBalance > 0 ? Money(areaBalance) : "—")</td>
                                            @if (isDaily)
                                            {
                                                <td class="me-num">@Money(area.Sum(p => p.MonthlyCoverage))</td>
                                                <td class="me-num">@Money(area.Sum(p => p.MonthlyCoverageBalance))</td>
                                            }
                                            @if (!isDaily)
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"><strong>Subtotal — @f.Name</strong></td>
                                    @if (showKilos)
                                    {
                                        var kilosTotal = payors.Sum(p => p.FishKilos);
                                        <td class="me-num"><strong>@(kilosTotal > 0 ? Kilos(kilosTotal) : "—")</strong></td>
                                    }
                                    <td class="me-num"><strong>@Money(collectedShown)</strong></td>
                                    <td class="me-num @(outstandingShown > 0 ? "me-red" : "")"><strong>@(outstandingShown > 0 ? Money(outstandingShown) : "—")</strong></td>
                                    @if (isDaily)
                                    {
                                        var coverageTotal = payors.Sum(p => p.MonthlyCoverage);
                                        var coverageBalanceTotal = payors.Sum(p => p.MonthlyCoverageBalance);
                                        <td class="me-num"><strong>@Money(coverageTotal)</strong></td>
                                        <td class="me-num @(coverageBalanceTotal > 0 ? "me-red" : "")"><strong>@(coverageBalanceTotal > 0 ? Money(coverageBalanceTotal) : "—")</strong></td>
                                    }
                                    @if (!isDaily)
                                    {
                                        <td></td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                        </div>
                    }
                    else if (!f.IsRental && txnPayors.Count > 0)
                    {
                        // One table shape, context-labelled per facility:
                        //   SLH → Owner | Animal Types | Heads | Total
                        //   TRM → Driver | Route(s)     | Trips | Total
                        //   TPM → Vendor | Goods        | Market days | Total
                        var (payorCol, detailCol, qtyCol) = f.Code switch
                        {
                            FacilityCode.SLH => ("Owner", "Animal Types", "Heads"),
                            FacilityCode.TRM => ("Driver", "Route(s)", "Trips"),
                            FacilityCode.TPM => ("Vendor", "Goods", "Market days"),
                            _ => ("Payor", "Detail", "Records")
                        };
                        <div class="me-table-wrap"><table class="me-table">
                            <thead>
                                <tr>
                                    <th>@payorCol</th>
                                    <th>Date</th>
                                    <th>OR No.</th>
                                    <th>@detailCol</th>
                                    <th class="me-num">@qtyCol</th>
                                    <th class="me-num">Total Collected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tp in txnPayors)
                                {
                                    var key = $"{f.Code}|{tp.Payor}";
                                    var expandable = tp.RecordCount > 1;
                                    var isOpen = _expanded.Contains(key);
                                    <tr class="me-txn-row @(expandable ? "me-expandable" : "")" @onclick="() => Toggle(key, expandable)">
                                        <td>
                                            @if (expandable)
                                            {
                                                <span class="me-caret @(isOpen ? "open" : "")">&#9654;</span>
                                            }
                                            <span class="me-txn-payor">@tp.Payor</span>
                                        </td>
                                        <td>@TxnDateCell(tp)</td>
                                        <td class="me-mono">@TxnOrCell(tp)</td>
                                        <td>@(string.IsNullOrWhiteSpace(tp.Summary) ? "—" : tp.Summary)</td>
                                        <td class="me-num">@tp.Quantity</td>
                                        <td class="me-num">@Money(tp.TotalCollected)</td>
                                    </tr>
                                    @if (expandable && isOpen)
                                    {
                                        @foreach (var r in tp.Records)
                                        {
                                            <tr class="me-txn-detail">
                                                <td></td>
                                                <td>@r.Date</td>
                                                <td class="me-mono">@(string.IsNullOrWhiteSpace(r.ORNumber) ? "—" : r.ORNumber)</td>
                                                <td>@r.Description</td>
                                                <td></td>
                                                <td class="me-num">@Money(r.Amount)</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5"><strong>Subtotal — @f.Name</strong></td>
                                    <td class="me-num"><strong>@Money(collectedShown)</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        </div>
                    }
                    else if (!f.IsRental)
                    {
                        <div class="me-fac-note">No records for @Report.PeriodLabel.</div>
                    }
                    else
                    {
                        <div class="me-fac-note">No active payors under contract for @Report.PeriodLabel.</div>
                    }

                    @* ── Metered utilities, as their own table ───────────────────────────────────────────────
                       Electricity and water are not stall fees: they are metered, billed per reading, and settled on
                       their own receipt, so folding them into the payor lines above would leave a total that no longer
                       ties to its own rows. Behind a button because most months the office is reading collections, and
                       once opened it prints with the sheet. *@
                    @if (UtilityRows(f) is { Count: > 0 } utilities)
                    {
                        <button type="button" class="me-util-btn no-print" @onclick="() => ToggleUtilities(f.Code)">
                            @(_utilitiesOpen.Contains(f.Code) ? "Hide" : "Show") Miscellaneous
                        </button>

                        @if (_utilitiesOpen.Contains(f.Code))
                        {
                            <div class="me-util-block">
                                <div class="me-util-head">Miscellaneous — Electricity and Water</div>
                                <div class="me-table-wrap"><table class="me-table">
                                    <thead>
                                        <tr>
                                            <th>Stall</th>
                                            <th>Payor</th>
                                            <th class="me-num">Electricity</th>
                                            <th class="me-num">Water</th>
                                            <th class="me-num">Charged</th>
                                            <th class="me-num">Collected</th>
                                            <th class="me-num">Balance</th>
                                            <th>OR No.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in utilities)
                                        {
                                            <tr>
                                                <td>@SpaceNumber.Display(u.StallNo)</td>
                                                <td>@u.Payor</td>
                                                <td class="me-num">@Money(u.ElecCharge)</td>
                                                <td class="me-num">@Money(u.WaterCharge)</td>
                                                <td class="me-num">@Money(u.Charged)</td>
                                                <td class="me-num">@(u.Collected > 0 ? Money(u.Collected) : "—")</td>
                                                <td class="me-num @(u.Balance > 0 ? "me-red" : "")">@(u.Balance > 0 ? Money(u.Balance) : "—")</td>
                                                <td>@(string.IsNullOrWhiteSpace(u.ORNumber) ? "—" : u.ORNumber)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="2"><strong>Subtotal — electricity and water</strong></td>
                                            <td class="me-num"><strong>@Money(utilities.Sum(u => u.ElecCharge))</strong></td>
                                            <td class="me-num"><strong>@Money(utilities.Sum(u => u.WaterCharge))</strong></td>
                                            <td class="me-num"><strong>@Money(utilities.Sum(u => u.Charged))</strong></td>
                                            <td class="me-num"><strong>@Money(utilities.Sum(u => u.Collected))</strong></td>
                                            @{ var utilBalance = utilities.Sum(u => u.Balance); }
                                            <td class="me-num @(utilBalance > 0 ? "me-red" : "")"><strong>@(utilBalance > 0 ? Money(utilBalance) : "—")</strong></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table></div>
                            </div>
                        }
                    }
                </div>
            }

            @* ── Reconciliation: the account detail above against the official collections ─────────────────────────────
               A difference is stated, never adjusted away: it means the facility aggregation and the statement read
               different money (for example fees one classifies separately) and the office should look at it. *@
            @if (!HasSearch && Official is not null && Report is not null)
            {
                var recon = MonthlyCollectionReport.Reconcile(Report, Official);
                var reconRows = recon.Rows.Where(ReconInScope).ToList();
                var allScope = _group == MonthlyCollectionReport.All && _source == MonthlyCollectionReport.All;
                @if (reconRows.Count > 0)
                {
                    <div class="me-facility me-recon">
                        <div class="me-fac-head">
                            <div class="me-fac-title"><span class="me-fac-name">Reconciliation to the official collections</span></div>
                            <div class="me-fac-stats">
                                <span class="@(reconRows.All(r => r.Agrees) ? "" : "me-red")"><strong>@(reconRows.All(r => r.Agrees) ? "Agrees" : "Differences shown")</strong></span>
                            </div>
                        </div>
                        <div class="me-table-wrap"><table class="me-table me-src-table">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th class="me-num">Account detail</th>
                                    <th class="me-num">Official</th>
                                    <th class="me-num">Difference</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in reconRows)
                                {
                                    <tr title="@r.Scope">
                                        <td>@r.Label@if (!r.Agrees || r.Label.Contains("legacy")) { <span class="me-fine-line">@r.Scope</span> }</td>
                                        <td class="me-num">@Money(r.Detail)</td>
                                        <td class="me-num">@Money(r.Official)</td>
                                        <td class="me-num @(r.Agrees ? "" : "me-red")">@(r.Agrees ? "—" : SignedMoney(r.Difference))</td>
                                    </tr>
                                }
                            </tbody>
                            @if (allScope)
                            {
                                <tfoot>
                                    <tr><td colspan="3"><strong>Itemised by account detail</strong></td><td class="me-num"><strong>@Money(recon.OfficialWithDetail)</strong></td></tr>
                                    <tr><td colspan="3"><strong>Stated by source total only</strong></td><td class="me-num"><strong>@Money(recon.WithoutDetail)</strong></td></tr>
                                    <tr><td colspan="3"><strong>Official total collected</strong></td><td class="me-num"><strong>@Money(recon.OfficialTotal)</strong></td></tr>
                                </tfoot>
                            }
                        </table></div>
                    </div>
                }
            }

            <div class="me-rpt-foot">
                <SignatureStrip ShowDatePrepared="true" />
            </div>
        </section>
    }
</div>

@code {
    private int Year = PhilippineTime.Now.Year;
    private int Month = PhilippineTime.Now.Month;
    private MonthEndReportDto? Report;
    private bool Loading = true;
    private readonly HashSet<string> _expanded = new();

    [PersistentState(AllowUpdates = true)]
    public MonthEndPageState? CachedMonthEnd { get; set; }

    // The official collections for the same month: the single source of the report's money. Null when they could not be
    // read, which is stated on the sheet; it is never shown as a zero.
    public RevenueSourcePerformanceDto? Official { get; private set; }

    // ── Group / source filter + search (client-side view filtering; never alters the underlying figures) ──
    private string _group = MonthlyCollectionReport.All;     // an official revenue group, or all
    private string _source = MonthlyCollectionReport.All;    // an official source within it, or all
    private string _search = "";

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";
    private void ClearSearch() => _search = "";

    private void SelectGroup(string group)
    {
        _group = group;
        // A source belongs to one group, so a source from another group cannot stay selected.
        if (_source != MonthlyCollectionReport.All && !ScopedRows.Any(r => r.Key == _source)) _source = MonthlyCollectionReport.All;
    }

    private IReadOnlyList<(string Value, string Label)> GroupOptions =>
        new[] { (MonthlyCollectionReport.All, "All sources") }.Concat(MonthlyCollectionReport.Groups.Select(g => (g.Key, g.Label))).ToList();

    private IReadOnlyList<(string Value, string Label)> SourceOptions =>
        new[] { (MonthlyCollectionReport.All, _group == MonthlyCollectionReport.All ? "All sources" : "All in group") }
            .Concat(ScopedRows.Select(r => (r.Key, r.Label))).ToList();

    // The listed official sources inside the chosen group (before the source selection narrows them further).
    private IEnumerable<RevenueSourcePerformanceRowDto> ScopedRows => Official is null
        ? Array.Empty<RevenueSourcePerformanceRowDto>()
        : MonthlyCollectionReport.ListedRows(Official)
            .Where(r => _group == MonthlyCollectionReport.All || MonthlyCollectionReport.DisplayGroup(r) == _group);

    private IReadOnlyList<RevenueSourcePerformanceRowDto> OfficialRows =>
        ScopedRows.Where(r => _source == MonthlyCollectionReport.All || r.Key == _source).ToList();

    private static IEnumerable<IGrouping<string, RevenueSourcePerformanceRowDto>> OfficialGroups(IEnumerable<RevenueSourcePerformanceRowDto> rows)
    {
        var order = MonthlyCollectionReport.Groups.Select((g, i) => (g.Key, i)).ToDictionary(x => x.Key, x => x.i);
        return rows.GroupBy(r => MonthlyCollectionReport.DisplayGroup(r)).OrderBy(g => order.GetValueOrDefault(g.Key, 99));
    }

    // How the source is paid, in the office's terms. A paid-on-service source has no billed amount, so nothing here
    // implies one.
    private static string BasisLabel(RevenueSourcePerformanceRowDto row) => row.Model switch
    {
        RevenueSourceModel.RecurringObligation => "Monthly obligation",
        RevenueSourceModel.QuantityService => "Per quantity",
        RevenueSourceModel.EventRental => "Per event",
        RevenueSourceModel.Receivable => "Recovery",
        _ => "Paid on service"
    };

    private bool ReconInScope(MonthlyReconciliationRowDto row) =>
        (_group == MonthlyCollectionReport.All || row.GroupKey == _group)
        && (_source == MonthlyCollectionReport.All || row.SourceKeys.Contains(_source));

    private static string SignedMoney(decimal v) => (v > 0 ? "+" : v < 0 ? "−" : "") + "₱" + Math.Abs(v).ToString("N2");

    private async Task ReloadOfficial()
    {
        await LoadOfficialAsync();
        if (Report is not null) CachedMonthEnd = new MonthEndPageState(Year, Month, Report, Official);
    }

    private async Task LoadOfficialAsync()
    {
        try
        {
            var result = await OfficialApi.GetSourcePerformanceAsync(Year, Month);
            Official = result is { IsSuccess: true, Value: not null } ? result.Value : null;
        }
        catch { Official = null; }
    }

    private IEnumerable<MonthEndFacilityDto> VisibleFacilities()
    {
        if (Report is null) return Array.Empty<MonthEndFacilityDto>();
        var facilities = Report.Facilities.AsEnumerable();
        if (_group != MonthlyCollectionReport.All)
            facilities = facilities.Where(f => MonthlyCollectionReport.GroupOf(f.Code) == _group);
        if (_source != MonthlyCollectionReport.All)
            facilities = facilities.Where(f => MonthlyCollectionReport.DetailBelongsTo(f.Code, _source));
        if (HasSearch)
            facilities = facilities.Where(f => VisiblePayors(f).Count > 0 || VisibleTxnPayors(f).Count > 0);
        return facilities;
    }

    private List<MonthEndPayorDto> VisiblePayors(MonthEndFacilityDto f) =>
        (HasSearch ? f.Payors.Where(MatchesPayor) : f.Payors).ToList();

    private List<MonthEndTxnPayorDto> VisibleTxnPayors(MonthEndFacilityDto f) =>
        (HasSearch ? f.TransactionPayors.Where(MatchesTxnPayor) : f.TransactionPayors).ToList();

    private bool MatchesPayor(MonthEndPayorDto p) =>
        Match(p.Payor) || Match(p.StallNo) || Match(p.ORNumber);

    private bool MatchesTxnPayor(MonthEndTxnPayorDto p) =>
        Match(p.Payor) || Match(p.Summary) || p.Records.Any(r => Match(r.Description) || Match(r.ORNumber));

    private bool Match(string? value) =>
        !string.IsNullOrEmpty(value) && value.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private static int RateOf(decimal collected, decimal outstanding)
    {
        var billed = collected + outstanding;
        return billed > 0m ? (int)Math.Round(collected / billed * 100m) : 0;
    }

    // Per-facility figures for the current view: the true DTO totals when unfiltered, recomputed from the
    // visible rows when a search is active. Summed across the visible facilities they drive the summary cards.
    private decimal ShownCollected(MonthEndFacilityDto f) =>
        !HasSearch ? f.Collected
        : f.IsRental ? VisiblePayors(f).Sum(p => p.AmountPaid)
        : VisibleTxnPayors(f).Sum(p => p.TotalCollected);

    private decimal ShownOutstanding(MonthEndFacilityDto f) =>
        !HasSearch ? f.Outstanding
        : f.IsRental ? VisiblePayors(f).Sum(p => p.Balance)
        : 0m;

    private (int paid, int partial, int unpaid) ShownStatusCounts(IEnumerable<MonthEndFacilityDto> facilities)
    {
        if (!HasSearch)
            return (
                facilities.Where(f => f.IsRental).Sum(f => f.PaidCount),
                facilities.Where(f => f.IsRental).Sum(f => f.PartialCount),
                facilities.Where(f => f.IsRental).Sum(f => f.UnpaidCount));

        var rows = facilities.Where(f => f.IsRental).SelectMany(VisiblePayors).ToList();
        return (
            rows.Count(p => p.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase)),
            rows.Count(p => p.Status.Equals("Partial", StringComparison.OrdinalIgnoreCase)),
            rows.Count(p => !p.Status.Equals("Paid", StringComparison.OrdinalIgnoreCase)
                         && !p.Status.Equals("Partial", StringComparison.OrdinalIgnoreCase)
                         && !p.Status.Equals("Absent", StringComparison.OrdinalIgnoreCase)));
    }

    private string ScopeLabel
    {
        get
        {
            // The group and source in the office's own words; the sheet states what it covers so a filtered copy is never
            // mistaken for the whole month.
            var scope = _source != MonthlyCollectionReport.All
                ? Official?.Rows.FirstOrDefault(r => r.Key == _source)?.Label ?? _source
                : _group != MonthlyCollectionReport.All ? MonthlyCollectionReport.GroupLabel(_group) : "All sources";
            return HasSearch ? $"{scope} · matching “{_search.Trim()}”" : scope;
        }
    }

        /// <summary>
    /// The LGU's own name for a facility. Was a hardcoded table of Cantilan's names, which is how another
    /// municipality's report carried Cantilan's wording; the tenant catalog answers it now.
    /// </summary>    private string FacilityName(FacilityCode code) => Facilities.NameOf(code);

    private string PeriodLabel => new DateTime(Year, Month, 1).ToString("MMMM yyyy");

    private void Toggle(string key, bool expandable)
    {
        if (!expandable) return;
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    protected override async Task OnInitializedAsync()
    {
        await Facilities.EnsureLoadedAsync();

        if (TryApplyCachedMonthEnd())
            return;

        await Load();
    }

    private async Task Load()
    {
        Loading = true;
        Report = null;
        Official = null;
        await PaintLoadingStateAsync();

        // Cold-start resilience: tolerate the brief window before the circuit attaches the JWT.
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var result = await FacilitiesApi.GetMonthEndReportAsync(Year, Month);
            if (result.IsSuccess)
            {
                Report = result.Value;
                if (Report is not null)
                {
                    // The official collections for the same month, read with the account detail so the page, its cache and
                    // its print always describe one period.
                    await LoadOfficialAsync();
                    CachedMonthEnd = new MonthEndPageState(Year, Month, Report, Official);
                }

                break;
            }
            if (result.Status is not (ResultStatus.Unauthorized or ResultStatus.Forbidden))
                break;
            await Task.Delay(400);
        }

        Loading = false;
    }

    private bool TryApplyCachedMonthEnd()
    {
        if (CachedMonthEnd is not { } state
            || state.Year != Year
            || state.Month != Month)
        {
            return false;
        }

        Report = state.Report;
        Official = state.Official;
        Loading = false;
        return true;
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private async Task PrevMonth()
    {
        var d = new DateTime(Year, Month, 1).AddMonths(-1);
        Year = d.Year; Month = d.Month;
        await Load();
    }

    private async Task NextMonth()
    {
        var d = new DateTime(Year, Month, 1).AddMonths(1);
        Year = d.Year; Month = d.Month;
        await Load();
    }

    // ── Custom month/year picker ──
    private bool _pickerOpen;
    private int _pickerYear;   // the year currently browsed in the picker (independent of the selected Year)

    private void TogglePicker()
    {
        _pickerOpen = !_pickerOpen;
        if (_pickerOpen) _pickerYear = Year;   // open on the currently selected year
    }

    private void ClosePicker() => _pickerOpen = false;
    private void PickerPrevYear() => _pickerYear--;
    private void PickerNextYear() => _pickerYear++;

    private async Task SelectMonth(int month)
    {
        _pickerOpen = false;
        if (Year == _pickerYear && Month == month) return;   // no change
        Year = _pickerYear;
        Month = month;
        await Load();
    }

    private async Task JumpToCurrentMonth()
    {
        _pickerOpen = false;
        var now = PhilippineTime.Now;
        if (Year == now.Year && Month == now.Month) return;
        Year = now.Year; Month = now.Month;
        await Load();
    }

    private static string MonthAbbr(int month) => new DateTime(2000, month, 1).ToString("MMM");

    private async Task Print() => await JS.InvokeVoidAsync("print");

    private static string Money(decimal v) => "₱" + v.ToString("N2");

    /// <summary>
    /// Kilos as the office writes them: whole numbers plain, fractions to two places, never trailing zeros on a
    /// round figure. A weighing scale reads 12.5, not 12.50, and 12 is not 12.00.
    /// </summary>
    private static string Kilos(decimal v) =>
        v == decimal.Truncate(v) ? v.ToString("N0") : v.ToString("0.##");

    // Aggregate Date/OR for a transaction payor row. A single date/OR shows directly; multiple values
    // (a payor with several receipts across the month) collapse to a professional summary, with the
    // per-record breakdown available in the expandable detail rows.
    private static string TxnDateCell(MonthEndTxnPayorDto tp)
    {
        var dates = tp.Records
            .Select(r => r.Date)
            .Where(d => !string.IsNullOrWhiteSpace(d))
            .Distinct()
            .ToList();
        return dates.Count switch
        {
            0 => "—",
            1 => dates[0],
            _ => "Various"
        };
    }

    private static string TxnOrCell(MonthEndTxnPayorDto tp)
    {
        var ors = tp.Records
            .Where(r => !string.IsNullOrWhiteSpace(r.ORNumber))
            .Select(r => r.ORNumber!)
            .Distinct()
            .ToList();
        return ors.Count switch
        {
            0 => "—",
            1 => ors[0],
            _ => $"{ors.Count} ORs"
        };
    }

    /// <summary>
    /// The period the sheet covers, and for a month still running, the day the figures stop at.
    ///
    /// <para>
    /// The sheet used to be titled a month-end report, which claimed something it does not do: nothing here waits for
    /// the month to close, and the office reads August on the twenty-second. A closed month is stated plainly; the
    /// current one states the day it was taken, so a printed copy cannot be mistaken for the final position. The month
    /// is not repeated before it: the date already carries the month, and stating both said it twice.
    /// </para>
    /// </summary>
    private string PeriodLine
    {
        get
        {
            var today = PhilippineTime.Today;
            return Year == today.Year && Month == today.Month
                ? $"As of {today:MMMM d, yyyy}"
                : Report!.PeriodLabel;
        }
    }

    /// <summary>Which facilities have their utilities table open. Nothing is open until the office asks.</summary>
    private readonly HashSet<FacilityCode> _utilitiesOpen = new();

    private void ToggleUtilities(FacilityCode code)
    {
        if (!_utilitiesOpen.Remove(code)) _utilitiesOpen.Add(code);
    }

    /// <summary>
    /// A facility's metered utility rows, narrowed by the search when one is in force so the table agrees with the
    /// payor rows above it rather than showing spaces the sheet is not currently listing.
    /// </summary>
    private IReadOnlyList<MonthEndUtilityRowDto> UtilityRows(MonthEndFacilityDto f)
    {
        var rows = f.Utilities ?? Array.Empty<MonthEndUtilityRowDto>();
        if (!HasSearch || rows.Count == 0) return rows;

        var term = _search.Trim();
        return rows.Where(u =>
            u.Payor.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            u.StallNo.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>
    /// The payors of a facility grouped by the area they occupy, areas in a stable order, unnamed spaces last.
    ///
    /// <para>
    /// Grouping is on the key the server sends, never on the words shown, which is the same rule the rest of the
    /// portal follows: an office that calls its vegetable area something else must not fall into a separate group
    /// from one that does not.
    /// </para>
    /// </summary>
    private static List<IGrouping<string, MonthEndPayorDto>> PayorAreas(IReadOnlyList<MonthEndPayorDto> payors) =>
        payors.GroupBy(p => p.Section ?? string.Empty)
              .OrderBy(g => g.Key.Length == 0)
              .ThenBy(g => g.Key, StringComparer.Ordinal)
              .ToList();

    /// <summary>
    /// What this office calls that area. The server sends the canonical wording for a canonical section, so it is
    /// mapped back to its key and then asked of the facility's own record; a section the office invented arrives as
    /// its own name already and is printed as it stands.
    /// </summary>
    private string SectionLabel(FacilityCode code, string section)
    {
        var canonical = EEMOCantilanSDS.Client.Services.FacilityState.SectionFromCanonical(section);
        return canonical is { } s ? Facilities.SectionLabelOf(code, s) : section;
    }

    private static string StatusClass(string status) => status switch
    {
        "Paid" => "me-paid",
        "Partial" => "me-partial",
        _ => "me-unpaid"
    };

    private static string RowClass(string status) => status switch
    {
        "Paid" => "",
        "Partial" => "me-row-partial",
        _ => "me-row-unpaid"
    };

    public sealed record MonthEndPageState(
        int Year,
        int Month,
        MonthEndReportDto Report,
        RevenueSourcePerformanceDto? Official = null);
}
