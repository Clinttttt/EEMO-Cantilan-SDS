@page "/collections/current"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject NavigationManager Navigation

@* Current Collection was retired: collections are recorded on the Collector Mobile, and Collection Activity is where they are read.
   The old route stays so saved links and bookmarks land on the activity register instead of a 404. *@

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/collections/activity", replace: true);
}
