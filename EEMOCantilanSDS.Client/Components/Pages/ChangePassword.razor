@page "/change-password"
@attribute [Authorize]

@using EEMOCantilanSDS.Application.Command.Auth.AdminAuth.ChangeMyPassword
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Client.Securities.AuthService Auth

<PageTitle>StallTrack - Change Password</PageTitle>

@*
    The signed-in administrator sets their own password.

    Reached two ways: chosen from the account menu, or REQUIRED because the office issued the current password. In the
    required case there is deliberately no way past this screen except changing the password or signing out - the API refuses
    every other endpoint until it is done, so offering a "later" would only produce a portal that appears to work and then
    refuses everything.

    Posts to the portal's own proxy rather than the API directly, because the session lives in a cookie: the proxy rebuilds it
    from the new tokens, and without that the requirement would still be in the old claim and the user would be asked again.
*@

<div class="cp-root">
    <div class="cp-wrap">
        <section class="login-card" aria-labelledby="cp-title">

            <div class="setup-form-header">
                <div class="login-header-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </div>
                <h1 id="cp-title" class="setup-form-title">Change your password</h1>
                <div class="setup-form-desc">
                    @if (Required)
                    {
                        <span>
                            Your current password was issued by the office. Choose one only you know before continuing.
                        </span>
                    }
                    else
                    {
                        <span>Choose a new password for your account. Your username does not change.</span>
                    }
                </div>
            </div>

            <div class="setup-form">

                <div class="form-group">
                    <label class="form-label" for="cp-current">Current password</label>
                    <div class="form-input-wrap">
                        <input id="cp-current"
                               type="@(ShowCurrent ? "text" : "password")"
                               class="form-input form-input-password"
                               placeholder="Your current password"
                               autocomplete="current-password"
                               @bind="Current" @bind:event="oninput" />
                        <PasswordRevealButton Shown="ShowCurrent" ShownChanged="v => ShowCurrent = v" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="cp-new">New password</label>
                    <div class="form-input-wrap">
                        <input id="cp-new"
                               type="@(ShowNew ? "text" : "password")"
                               class="form-input form-input-password"
                               placeholder="Enter a new password"
                               autocomplete="new-password"
                               aria-describedby="cp-rule"
                               @bind="New" @bind:event="oninput" />
                        <PasswordRevealButton Shown="ShowNew" ShownChanged="v => ShowNew = v" />
                    </div>
                    @* Stated where it stays visible while typing, and stated exactly as the server enforces it, so the
                       requirement is never first learned from a rejection. *@
                    <div id="cp-rule" class="form-hint">At least 8 characters, including a letter and a number.</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="cp-confirm">Confirm new password</label>
                    <div class="form-input-wrap">
                        <input id="cp-confirm"
                               type="@(ShowConfirm ? "text" : "password")"
                               class="form-input form-input-password"
                               placeholder="Re-enter the new password"
                               autocomplete="new-password"
                               @bind="Confirm" @bind:event="oninput" />
                        <PasswordRevealButton Shown="ShowConfirm" ShownChanged="v => ShowConfirm = v" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="form-error" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@Error</span>
                    </div>
                }

                <button class="setup-submit" disabled="@Busy" @onclick="SubmitAsync">
                    <span>@(Busy ? "Saving…" : "Change password")</span>
                </button>

                @if (Required)
                {
                    @* The only other way off this screen. Without the app shell there is no menu to sign out from, and a
                       required change must not leave an account with nowhere to go. *@
                    <button class="btn-ghost cp-secondary" type="button" disabled="@Busy" @onclick="SignOutAsync">
                        Sign out instead
                    </button>
                }
                else
                {
                    <button class="btn-ghost cp-secondary" type="button" disabled="@Busy" @onclick="GoBack">Cancel</button>
                }
            </div>
        </section>
    </div>
</div>

@code {
    /// <summary>
    /// True when the office issued the current password and the account may do nothing else until it is replaced. Read from
    /// the query string, which the guard sets, so the copy states WHY the user is here rather than leaving them to guess.
    /// </summary>
    private bool Required;

    private string Current = string.Empty;
    private string New = string.Empty;
    private string Confirm = string.Empty;
    private bool ShowCurrent;
    private bool ShowNew;
    private bool ShowConfirm;
    private bool Busy;
    private string? Error;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Required = Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(uri.Query).TryGetValue("required", out var flag) && flag == "1";
    }

    private async Task SubmitAsync()
    {
        Error = null;

        // Checked here as well as on the server, and stated in the SAME terms the server uses. The confirmation field exists
        // only in the browser, so nothing else can catch a mistyped repeat; the rest is checked here only to save the user a
        // round trip, never instead of the server.
        if (string.IsNullOrEmpty(Current)) { Error = "Enter your current password."; return; }
        if (New.Length < 8) { Error = "Password must be at least 8 characters."; return; }
        if (!New.Any(char.IsLetter)) { Error = "Password must contain a letter."; return; }
        if (!New.Any(char.IsDigit)) { Error = "Password must contain a number."; return; }
        if (New != Confirm) { Error = "The two new passwords do not match."; return; }

        Busy = true;
        try
        {
            var outcome = await Auth.ChangeMyPasswordAsync(Current, New);

            if (outcome.Success)
            {
                // Full reload rather than client-side navigation: the cookie carrying the requirement has just been
                // replaced, and every component that read the old claim needs to see the new one.
                Navigation.NavigateTo("/menu", forceLoad: true);
                return;
            }

            Error = string.IsNullOrWhiteSpace(outcome.Error) ? "We could not change your password." : outcome.Error;
        }
        finally
        {
            Busy = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/menu");

    /// <summary>Leaves the account signed out at the sign-in page; <see cref="AuthService"/> handles the redirect.</summary>
    private async Task SignOutAsync()
    {
        Busy = true;
        await Auth.LogoutAsync();
    }
}
