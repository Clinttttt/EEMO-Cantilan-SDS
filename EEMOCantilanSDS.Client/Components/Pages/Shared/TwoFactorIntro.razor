@*
    Shared explanatory rows for the two-factor dialogs: why the step matters, then what it involves, followed
    by the supported-app note.

    Extracted rather than duplicated because both dialogs (required setup for Heads, and opt-in from Settings)
    must read identically — and because scoped CSS only applies to the component that declares the markup, so
    a copy in each host would mean a copy of the stylesheet too.

    The first row's wording differs by context: a Head is told what their account can reach, while an Admin
    opening Settings gets the neutral statement. The host supplies it; the default suits any signed-in admin.
*@

<div class="tfi-rows">
    <div class="tfi-row">
        <span class="tfi-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-4A3.5 3.5 0 0 0 5 18.5V20" />
                <circle cx="10.5" cy="8.5" r="3.2" />
                <path d="M17.5 12.2a3 3 0 0 0 0-5.9" />
                <path d="M19 20v-1.3a3.2 3.2 0 0 0-1.6-2.8" />
            </svg>
        </span>
        <p class="tfi-text">@Reason</p>
    </div>

    <div class="tfi-row">
        <span class="tfi-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
                <path d="M9.5 7h5M9.5 10.5h5M9.5 14h5" />
                <path d="M10.75 17.5h2.5" />
            </svg>
        </span>
        <p class="tfi-text">
            Use an authenticator app to enter a 6-digit code. Setup takes about a minute and recovery codes
            will be provided.
        </p>
    </div>
</div>

<div class="tfi-apps">
    <span class="tfi-apps-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.6h.01" />
        </svg>
    </span>
    <span>Supported apps: Google Authenticator, Microsoft Authenticator, or similar.</span>
</div>

@code {
    /// <summary>
    /// First row's wording. Defaults to a statement true of any admin account; the required-setup dialog
    /// passes the Head-specific version naming the municipality.
    /// </summary>
    [Parameter]
    public string Reason { get; set; } =
        "A stolen password on its own will no longer be enough — signing in will also ask for a code from your phone.";
}
