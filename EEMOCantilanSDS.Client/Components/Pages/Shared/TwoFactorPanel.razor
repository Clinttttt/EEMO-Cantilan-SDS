@using EEMOCantilanSDS.Application.Command.Auth.Mfa
@using EEMOCantilanSDS.Application.Common.Security
@using EEMOCantilanSDS.Application.Dtos.Auth
@inject IMfaApiClient MfaApi

@*
    Two-factor authentication panel for the signed-in user's own account (Settings page).

    Asymmetric on purpose: turning two-factor ON needs no password (the user is already authenticated and the
    change only adds protection), while turning it OFF requires the password AND a valid code, and generating
    new recovery codes requires the password. A session alone can never weaken the second factor.

    Styles are self-contained (mfa-* classes in this component's own scoped stylesheet) rather than reusing
    the Settings page's `set-card` classes, because scoped CSS only applies to the component that declares
    the markup.
*@

<section class="mfa-card @(Flat ? "mfa-card-flat" : "")">
    @if (!Flat)
    {
        <div class="mfa-head">
            <div class="mfa-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><path d="M12 15v3" />
                </svg>
            </div>
            <div class="mfa-titles">
                <div class="mfa-title">Two-Factor Authentication</div>
                <div class="mfa-sub">Authenticator app code in addition to your password</div>
            </div>
            @if (_status is not null)
            {
                <span class="mfa-state @(_status.Enabled ? "mfa-state-on" : "mfa-state-off")">
                    @(_status.Enabled ? "On" : _status.PendingEnrollment ? "Setup unfinished" : "Off")
                </span>
            }
        </div>
    }

    @if (_statusUnavailable && _status is null)
    {
        @* Unknown ≠ off. Saying "Off" here would misrepresent a protected account. *@
        <div class="mfa-body">
            <div class="mfa-notice mfa-notice-warn">
                We couldn't read your two-factor status. Your current setting has not changed. Sign in again
                and reopen this window.
            </div>
        </div>
    }
    else if (_status is null)
    {
        <div class="mfa-body"><Skeleton Width="70%" Height="12px" Radius="6px" /></div>
    }
    else if (_recoveryCodes is not null)
    {
        @* Shown exactly once — the codes are not recoverable afterwards. *@
        <div class="mfa-body">
            <div class="mfa-notice mfa-notice-warn">
                Save these recovery codes now. Each one works once if you lose your phone, and they cannot be
                shown again — you can only generate a new set.
            </div>
            <ul class="mfa-codes">
                @foreach (var recoveryCode in _recoveryCodes)
                {
                    <li>@recoveryCode</li>
                }
            </ul>
            <div class="mfa-actions">
                <button class="mfa-btn mfa-btn-primary" type="button" @onclick="AcknowledgeCodes">I've saved them</button>
            </div>
        </div>
    }
    else if (_enrollment is not null)
    {
        <div class="mfa-body">
            <div class="mfa-enroll">
                <img class="mfa-qr" src="@_enrollment.QrCodeDataUri" alt="Two-factor setup QR code" />
                <div class="mfa-manual">
                    <div class="mfa-manual-label">Can't scan? Type this key <strong>into your authenticator app</strong></div>
                    <code class="mfa-key">@_enrollment.ManualKey</code>
                    <div class="mfa-manual-hint">Time-based · 6 digits · 30 seconds</div>
                </div>
            </div>

            <label class="mfa-label" for="mfa-confirm-code">Enter the 6-digit code your app shows</label>
            <div class="mfa-inline">
                <input id="mfa-confirm-code" class="mfa-input" inputmode="numeric" autocomplete="one-time-code"
                       maxlength="6" placeholder="000000"
                       @key="@($"code-{_formNonce}")" @oninput="OnCodeInput" />
                <button class="mfa-btn mfa-btn-primary" type="button" disabled="@_busy" @onclick="ConfirmAsync">
                    @(_busy ? "Verifying…" : "Turn on")
                </button>
                <button class="mfa-btn" type="button" disabled="@_busy" @onclick="CancelEnrollment">Cancel</button>
            </div>
        </div>
    }
    else if (_status.Enabled)
    {
        <div class="mfa-body">
            <div class="mfa-rows">
                <div class="mfa-row">
                    <span class="mfa-key-label">Enabled on</span>
                    <span class="mfa-val">@(_status.EnrolledAt.HasValue ? PhilippineTime.ToPhilippineTime(_status.EnrolledAt.Value).ToString("MMM d, yyyy") : "—")</span>
                </div>
                <div class="mfa-row">
                    <span class="mfa-key-label">Recovery codes left</span>
                    <span class="mfa-val">
                        @_status.RecoveryCodesRemaining of @RecoveryCodes.SetSize
                        @if (_status.RecoveryCodesRemaining <= 2)
                        {
                            <span class="mfa-pill-warn">running low</span>
                        }
                    </span>
                </div>
            </div>

            <div class="mfa-actions">
                <button class="mfa-btn" type="button" @onclick="() => _mode = Mode.Regenerate">New recovery codes</button>
                <button class="mfa-btn mfa-btn-danger" type="button" @onclick="() => _mode = Mode.Disable">Turn off</button>
            </div>

            @if (_mode == Mode.Regenerate || _mode == Mode.Disable)
            {
                <div class="mfa-confirm">
                    <div class="mfa-step">
                        @(_mode == Mode.Disable
                            ? "Confirm with your password and a current code (or a recovery code) to switch two-factor off."
                            : "Confirm with your password. Your existing recovery codes will stop working.")
                    </div>
                    <div class="mfa-inline">
                        <div class="pw-reveal-wrap">
                            @* The show flag is deliberately NOT part of @key. This input is uncontrolled (no value binding,
                               so the browser owns the text); recreating it on reveal would clear whatever had been typed.
                               Patching the type attribute in place keeps the value. *@
                            <input class="mfa-input mfa-input-wide" type="@(_showPassword ? "text" : "password")" autocomplete="current-password"
                                   placeholder="Current password"
                                   @key="@($"pw-{_formNonce}")" @oninput="e => _password = e.Value?.ToString() ?? string.Empty" />
                            <PasswordRevealButton Shown="_showPassword" ShownChanged="v => _showPassword = v" />
                        </div>
                        @if (_mode == Mode.Disable)
                        {
                            <input class="mfa-input" inputmode="numeric" autocomplete="one-time-code" maxlength="11"
                                   placeholder="Code"
                                   @key="@($"code2-{_formNonce}")" @oninput="e => _code = e.Value?.ToString() ?? string.Empty" />
                        }
                        <button class="mfa-btn @(_mode == Mode.Disable ? "mfa-btn-danger" : "mfa-btn-primary")"
                                type="button" disabled="@_busy"
                                @onclick="@(_mode == Mode.Disable ? DisableAsync : RegenerateAsync)">
                            @(_busy ? "Working…" : _mode == Mode.Disable ? "Turn off" : "Generate")
                        </button>
                        <button class="mfa-btn" type="button" disabled="@_busy" @onclick="ResetPrompts">Cancel</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mfa-body">
            @if (ShowIntro)
            {
                <div class="mfa-step">
                    Add a second step to your sign-in. You'll enter a 6-digit code from an authenticator app
                    along with your password.
                </div>
            }
            @if (_status.PendingEnrollment)
            {
                @* Always shown, intro or not: it changes what the button will do. *@
                <div class="mfa-step"><strong>A previous setup wasn't finished — starting again issues a new key.</strong></div>
            }
            @* No password prompt to ENABLE: the user is already signed in, and switching two-factor ON only
               ever increases protection. The password IS still required to switch it off or to regenerate
               recovery codes, where the risk runs the other way. *@
            <div class="mfa-actions">
                <button class="mfa-btn mfa-btn-primary" type="button" disabled="@_busy" @onclick="BeginAsync">
                    @(_busy ? "Preparing…" : "Set up two-factor")
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mfa-notice mfa-notice-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_ok))
    {
        <div class="mfa-notice mfa-notice-ok">@_ok</div>
    }

    @* ── Two-factor recovery, folded into this same dialog ──
       Kept here rather than in a separate Settings card: it is the same subject (two-factor) seen from the
       administering side, and a government portal reads better with one authoritative place per topic. Shown
       to a Head, who administers their own office's staff; the API decides the scope independently — an
       office's own accounts, or every LGU's for the platform operator. *@
    @if (ShowRecoveryTool)
    {
        <div class="mfa-divider"></div>
        <TwoFactorRecoveryPanel Flat="true" @ref="_recoveryPanel" />
    }
</section>

@code {
    private enum Mode { None, Disable, Regenerate }

    /// <summary>
    /// True when hosted inside a modal: the modal already supplies the card surface and title, so the panel
    /// drops its own border/padding/header instead of drawing a card inside a card.
    /// </summary>
    [Parameter] public bool Flat { get; set; }

    /// <summary>Raised whenever the two-factor state changes, so the host can refresh its own badge.</summary>
    [Parameter] public EventCallback<MfaStatusDto> OnStatusChanged { get; set; }

    /// <summary>
    /// Set false when the host already explains what two-factor is (the required-setup dialog does), so the
    /// same sentence is not printed twice in one dialog. The "previous setup unfinished" warning is never
    /// suppressed — it changes what the button does.
    /// </summary>
    [Parameter] public bool ShowIntro { get; set; } = true;

    /// <summary>
    /// Renders the two-factor recovery section inside this dialog. The host decides whether to offer it (it
    /// knows the signed-in user's role); the API enforces both the role and the scope regardless.
    /// </summary>
    [Parameter] public bool ShowRecoveryTool { get; set; }

    /// <summary>
    /// The nested recovery list, so it can be re-read when this panel changes what it lists. Without this it initialises
    /// once and then contradicts the panel above it — stating "0 enrolled" immediately after an account enrolled here.
    /// </summary>
    private TwoFactorRecoveryPanel? _recoveryPanel;

    private MfaStatusDto? _status;

    /// <summary>True when the status could not be read (expired session / network) — distinct from "off".</summary>
    private bool _statusUnavailable;
    private MfaEnrollmentDto? _enrollment;
    private IReadOnlyList<string>? _recoveryCodes;
    private Mode _mode = Mode.None;

    private string _password = string.Empty;
    private string _code = string.Empty;
    private bool _busy;
    private string? _error;
    private string? _ok;

    /// <summary>Whether the confirm-password field is revealed. Reset with the rest of the prompt state.</summary>
    private bool _showPassword;

    protected override async Task OnInitializedAsync() => await LoadStatusAsync();

    /// <summary>
    /// Re-reads two-factor status and everything that depends on it. Public so a test can drive the same refresh that
    /// enrolling, disabling and regenerating codes perform, which is where the nested recovery list used to go stale.
    /// </summary>
    public Task RefreshStatusAsync() => LoadStatusAsync();

    /// <summary>
    /// Records what was typed and warns if it looks like the setup key rather than a code. The value is NOT
    /// rewritten here: the inputs are uncontrolled (no value= binding) so the browser owns the text, which is
    /// what keeps typing instant on a slow connection. Normalisation happens at submit instead.
    /// </summary>
    private void OnCodeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        _code = raw;

        var digits = new string(raw.Where(char.IsDigit).ToArray());
        _error = raw.Length > 0 && digits.Length == 0
            ? "That looks like the setup key. Enter the 6-digit number your authenticator app shows."
            : null;
    }

    /// <summary>
    /// Bumped when a field must be cleared from code. Because the inputs are uncontrolled, changing this
    /// @key recreates the element — the only way a programmatic clear reaches the DOM.
    /// </summary>
    private int _formNonce;

    /// <summary>Digits only, capped at 6 — applied when submitting an authenticator code.</summary>
    private static string NormaliseTotp(string value)
    {
        var digits = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());
        return digits.Length > 6 ? digits[..6] : digits;
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            var result = await MfaApi.GetMfaStatusAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                _status = result.Value;
                _statusUnavailable = false;
            }
            else
            {
                // Never claim "Off" when the answer is simply unknown — that previously made a protected
                // account look unprotected (and invited a pointless re-enrolment). Say so instead.
                _statusUnavailable = true;
                if (result.Status is ResultStatus.Unauthorized or ResultStatus.Forbidden)
                    _error = "Your session has expired. Please sign in again to manage two-factor.";
            }
        }
        catch
        {
            _statusUnavailable = true;
        }

        if (_status is not null && OnStatusChanged.HasDelegate)
            await OnStatusChanged.InvokeAsync(_status);

        // The operator recovery list below shows which accounts are enrolled, so it is stale the moment this status
        // changes. Refreshing it here keeps one dialog from contradicting itself.
        if (_recoveryPanel is not null)
            await _recoveryPanel.RefreshAsync();
    }

    private async Task BeginAsync()
    {
        // Deliberately NO password check here. The enable path renders no password field (the user is already
        // signed in and turning two-factor ON only ever increases protection), so requiring one made the
        // button fail with "Enter your current password." against a field that does not exist. The password
        // IS still required by Validate() for disable and for regenerating recovery codes, where the risk
        // runs the other way.
        _busy = true; _error = null; _ok = null;
        try
        {
            var result = await MfaApi.BeginMfaEnrollmentAsync(new BeginMfaEnrollmentCommand());
            if (result.IsSuccess && result.Value is not null)
            {
                _enrollment = result.Value;
                _password = string.Empty;   // don't keep it in memory longer than needed
                _code = string.Empty;
                _formNonce++;               // clears the uncontrolled inputs in the DOM
            }
            else _error = Explain(result.StatusCode, result.Error, "We couldn't start the setup.");
        }
        catch { _error = "We couldn't start the setup. Please try again."; }
        finally { _busy = false; }
    }

    /// <summary>
    /// Turns an API failure into something the user can act on. Several statuses carry NO message from the
    /// server (401/403/404 by design), which previously surfaced as a bare "we couldn't…" and hid the real
    /// cause — most often an expired session, since the page's cookie outlives the API access token.
    /// </summary>
    private static string Explain(int? statusCode, string? serverMessage, string fallback) => statusCode switch
    {
        401 => "Your session has expired. Please sign in again, then retry.",
        403 => "You're not allowed to change this setting.",
        404 => "Your account could not be found. Please sign in again.",
        429 => "Too many attempts. Please wait a minute and try again.",
        _ => string.IsNullOrWhiteSpace(serverMessage) ? fallback : serverMessage!
    };

    private async Task ConfirmAsync()
    {
        if (!Validate(needPassword: false, needCode: true)) return;

        // Normalise here (not while typing) so the uncontrolled input is never rewritten under the user.
        _code = NormaliseTotp(_code);
        if (_code.Length != 6)
        {
            _error = "Enter all 6 digits shown in your authenticator app.";
            return;
        }

        _busy = true; _error = null;
        try
        {
            var result = await MfaApi.ConfirmMfaEnrollmentAsync(new ConfirmMfaEnrollmentCommand(_code));
            if (result.IsSuccess && result.Value is not null)
            {
                _recoveryCodes = result.Value.Codes;    // shown once
                _enrollment = null;
                _code = string.Empty;
                _formNonce++;
                await LoadStatusAsync();
            }
            else _error = Explain(result.StatusCode, result.Error, "That code wasn't accepted.");
        }
        catch { _error = "We couldn't verify that code. Please try again."; }
        finally { _busy = false; }
    }

    private async Task DisableAsync()
    {
        if (!Validate(needPassword: true, needCode: true)) return;

        _busy = true; _error = null;
        try
        {
            var result = await MfaApi.DisableMfaAsync(new DisableMfaCommand(_password, _code));
            if (result.IsSuccess)
            {
                ResetPrompts();
                _ok = "Two-factor authentication is now off.";
                await LoadStatusAsync();
            }
            else _error = Explain(result.StatusCode, result.Error, "We couldn't switch two-factor off.");
        }
        catch { _error = "We couldn't switch two-factor off. Please try again."; }
        finally { _busy = false; }
    }

    private async Task RegenerateAsync()
    {
        if (!Validate(needPassword: true, needCode: false)) return;

        _busy = true; _error = null;
        try
        {
            var result = await MfaApi.RegenerateRecoveryCodesAsync(new RegenerateRecoveryCodesCommand(_password));
            if (result.IsSuccess && result.Value is not null)
            {
                _recoveryCodes = result.Value.Codes;
                ResetPrompts();
                await LoadStatusAsync();
            }
            else _error = Explain(result.StatusCode, result.Error, "We couldn't generate new codes.");
        }
        catch { _error = "We couldn't generate new codes. Please try again."; }
        finally { _busy = false; }
    }

    private bool Validate(bool needPassword, bool needCode)
    {
        _error = null;
        if (needPassword && string.IsNullOrWhiteSpace(_password))
        {
            _error = "Enter your current password.";
            return false;
        }
        if (needCode && string.IsNullOrWhiteSpace(_code))
        {
            _error = "Enter the code from your authenticator app (or a recovery code).";
            return false;
        }
        return true;
    }

    private void CancelEnrollment()
    {
        // The pending secret stays server-side and is replaced on the next attempt; nothing is enabled.
        _enrollment = null;
        ResetPrompts();
    }

    private void AcknowledgeCodes()
    {
        _recoveryCodes = null;
        _ok = "Two-factor authentication is on.";
    }

    private void ResetPrompts()
    {
        _mode = Mode.None;
        _password = string.Empty;
        _code = string.Empty;
        _error = null;
        _showPassword = false;      // a dismissed prompt must not leave the next one revealed
        _formNonce++;               // clears the uncontrolled inputs in the DOM
    }
}
