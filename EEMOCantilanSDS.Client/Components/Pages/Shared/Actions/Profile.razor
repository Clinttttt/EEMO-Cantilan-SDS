    }

    // Populate the monthly grid for a given year. The current year reuses the rolling history already
    // loaded (which preserves Absent/Excused detail); past years fetch each month's record in parallel.
    private async Task LoadMonthlyYear(int year)
    {
        if (year == EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year)
        {
            _monthlyStatus = new Dictionary<string, string>(Stall.PaymentHistory);
            return;
        }

        var tasks = Enumerable.Range(1, 12)
            .Select(m => PaymentsApi.GetPaymentRecordAsync(StallGuid, year, m))
            .ToArray();
        var results = await Task.WhenAll(tasks);

        var dict = new Dictionary<string, string>();
        for (var m = 1; m <= 12; m++)
        {
            var r = results[m - 1];
            if (r.IsSuccess && r.Value is not null)
            {
                dict[$"{year:0000}-{m:00}"] = r.Value.Status switch
                {
                    Domain.Enums.PaymentStatus.Paid => "Paid",
                    Domain.Enums.PaymentStatus.Partial => "Partial",
                    _ => "Unpaid"
                };
            }
        }
        _monthlyStatus = dict;
    }

    // Month abbreviation above the week where the month first changes (skips the clipped left edge).
    /// <summary>
    /// The month strip above the calendar, as one segment per month sized to the weeks that month covers.
    /// A label in a fixed 14px cell is wider than the cell, so the names ran into each other and the last one
    /// spilled out of the card; giving each month its own width keeps them apart and inside.
    /// </summary>
    /// <summary>
    /// What the month's bill is actually made of on THIS space: rent, then only the services it is billed for,
    /// then the section fee where the office charges one. Naming a charge the stall does not carry told the
    /// office it was billing for meters and fees that were never on the record.
    /// </summary>
    private string BillComposition()
    {
        var parts = new List<string> { "Rental" };
        if (Stall.HasElectricity) parts.Add("Electricity");
        if (Stall.HasWater) parts.Add("Water");
        if (Stall.CarriesSectionFee && _npmFishRate > 0m) parts.Add($"{Stall.Section} fee");
        return string.Join(" + ", parts);
    }

    private IEnumerable<(string Label, int Weeks)> MonthSegments()
    {
        if (_heatWeeks.Count == 0) yield break;

        var label = _heatWeeks[0][0].Date;
        var weeks = 1;

        for (var w = 1; w < _heatWeeks.Count; w++)
        {
            var month = _heatWeeks[w][0].Date;
            if (month.Month == label.Month && month.Year == label.Year)
            {
                weeks++;
                continue;
            }

            // A month that only just started at the end of the strip has no room for its name.
            yield return (weeks >= 2 ? label.ToString("MMM") : string.Empty, weeks);
            label = month;
            weeks = 1;
        }

        yield return (weeks >= 2 ? label.ToString("MMM") : string.Empty, weeks);
    }

    private static string HeatLabel(string kind) => kind switch
    {
        "collected" => "Collected",
        "excused" => "Excused",
        "missed" => "Uncollected",
        "future" => "Upcoming",
        _ => "No obligation"
    };

    async Task SaveEdit()
    {
        IsSavingEdit = true;
        
        var fees = Domain.Enums.ApplicableFees.BaseRental;
        if (Stall.HasElectricity) fees |= Domain.Enums.ApplicableFees.Electricity;
        if (Stall.HasWater) fees |= Domain.Enums.ApplicableFees.Water;
        if (Stall.CarriesSectionFee) fees |= Domain.Enums.ApplicableFees.FishFee;
        
        var command = new UpdateStallCommand(
            StallGuid,
            Stall.MonthlyRate,
            fees,
            Stall.AreaSqm,
            Stall.AreaNote,
            null,
            Stall.ActualOccupant,
            Stall.ContractName,
            Stall.Remarks,
            Stall.ContractDate,
            Stall.ContractYears
        );
        
        var result = await StallsApi.UpdateStallAsync(StallGuid, command);
        
        if (result.IsSuccess)
        {
            ShowEditModal = false;
            await LoadStallData();
        }
        
        IsSavingEdit = false;
    }
