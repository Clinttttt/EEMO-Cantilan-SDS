<!-- ----------------------------------------------
     RECORD PAYMENT — removed. Collection (per-day NPM, per-month TCC/NCC/ICE/BBQ,
     Excused, and market closures) is now managed centrally in the Collection Manager
     (/reports/collections). The hero "Manage Collection" button links there.
---------------------------------------------- -->

@* Collecting an earlier term's balance. The payment is posted against that term's own contract, so the money is
   never credited to the term in force — the two are separate accounts of the same space. *@
<PayBillModal Show="@(_priorTermPayment is not null)"
              StallId="@(_priorTermPayment?.StallId ?? Guid.Empty)"
              Facility="@(_priorTermPayment?.FacilityCode ?? FacilityCode.NPM)"
              StallNo="@(_priorTermPayment?.StallNo ?? string.Empty)"
              Occupant="@(_priorTermPayment?.Occupant ?? string.Empty)"
              ContractId="@(_priorTermPayment?.ContractId)"
              OnClose="ClosePriorTermPayment"
              OnChanged="OnPriorTermPaid" />

@code {

    [Parameter]
    public string FacilityId { get; set; } = string.Empty;

    /// <summary>
    /// The facility whose mark the hero draws. Falls back to the market only so the component has something to ask
    /// for; an unrecognised code has no artwork and renders the hero's own fallback glyph instead.
    /// </summary>
    private FacilityCode HeroFacility =>
        System.Enum.TryParse<FacilityCode>(FacilityId, true, out var code) ? code : FacilityCode.NPM;

    /// <summary>
    /// The line above the name: the facility's short code and the stall number, in the office's own words.
    ///
    /// <para>A space the office does not number contributes no number - SpaceNumber.Describe returns nothing for
    /// those - so the eyebrow states the facility alone rather than printing an internal key the office has never
    /// used on paper.</para>
    /// </summary>
    private string HeroEyebrow
    {
        get
        {
            var facility = System.Enum.TryParse<FacilityCode>(FacilityId, true, out var code)
                ? FacilityCatalog.ShortNameOf(code)
                : FacilityId.ToUpperInvariant();

            var stall = SpaceNumber.Describe(Stall?.StallNo ?? string.Empty);
            return stall.Length > 0 ? $"{facility} · {stall}" : facility;
        }
    }

    // Slug for the facility link/redirect: custom facilities resolve to their acronym (…/facility/fe),
    // canonical facilities keep their code (…/facility/npm). Falls back to the raw route value.
    private string FacilitySlug =>
        System.Enum.TryParse<FacilityCode>(FacilityId, true, out var _fc) ? FacilityCatalog.SlugOf(_fc) : FacilityId.ToLower();

    [Parameter]
    public string StallKey { get; set; } = string.Empty;

    bool ShowEditModal = false;
    bool IsSavingEdit = false;
    bool IsLoading = true;
    Guid StallGuid = Guid.Empty;

    /// <summary>
    /// Terms on THIS stall that have ended and still owe money — the current term is never listed. Read from the
    /// same register the office reconciles against, so the two documents cannot disagree.
    /// </summary>
    private List<ClosedStallAccountDto> _priorTerms = new();

    private async Task LoadPriorTermsAsync()
    {
        if (StallGuid == Guid.Empty) return;

        var result = await StallsApi.GetClosedStallAccountsAsync();
        if (!result.IsSuccess || result.Value is null) return;

        // Terms of THIS stall that still owe money and are not the one in force. A lapsed term is the exception: it
        // IS the term in force, but its span has run out, so the office needs it stated here too — those 57 accounts
        // otherwise showed nothing on the very screen the clerk collects from, with no prompt to renew.
        _priorTerms = result.Value
            .Where(a => a.StallId == StallGuid && a.Uncollected > 0m)
            .OrderByDescending(a => a.OccupancyEndedOn ?? a.ExpiryDate)
            .ToList();

        // Every earlier occupancy of this space, balance or not, as a span. The activity grid needs it: a day is
        // chargeable if it fell inside ANY term of this stall, not only the one in force. Judging it by the current
        // contract's start alone painted the whole of 2025 as "no obligation" for a stall that was let throughout
        // 2025 and collected nothing — the grid was hiding uncollected days, not merely looking empty.
        _occupiedSpans = result.Value
            .Where(a => a.StallId == StallGuid)
            .Select(a => (Start: a.EffectivityDate, End: a.OccupancyEndedOn ?? a.ExpiryDate))
            .ToList();

        StateHasChanged();
    }

    /// <summary>Earlier occupancy spans of this stall, used to decide whether a past day was chargeable.</summary>
    private List<(DateOnly Start, DateOnly End)> _occupiedSpans = new();

    /// <summary>
    /// What this stall's earlier terms still owe, as the register states it. Shown beside the current term's balance
    /// because the activity grid spans both: without it, hundreds of uncollected days sit next to a figure that only
    /// covers the days since the current term began.
    /// </summary>
    private decimal PriorTermsOutstanding => _priorTerms
        .Where(p => p.State != InactiveAccountState.Lapsed)
        .Sum(p => p.Uncollected);

    /// <summary>Whether the stall was under some term on this day — the current one, or any earlier one.</summary>
    private bool WasUnderContract(DateOnly day, DateOnly? currentStart)
        => (currentStart.HasValue && day >= currentStart.Value)
        || _occupiedSpans.Any(s => day >= s.Start && day <= s.End);

    /// <summary>
    /// Whether the name on an earlier term is the same person as the name on the term in force.
    ///
    /// <para>
    /// Uses the platform's one rule for that — <see cref="PersonName.Matches"/> — so it agrees with the slaughterhouse rather
    /// than having its own opinion. It was a trim-and-compare, which meant "Kim  Chui" and "Kim Chui" were the same person to
    /// one screen and different people to another. The office confirmed (2026-08-16) that within one LGU a name identifies the
    /// client, however it happens to be spelled or spaced.
    /// </para>
    ///
    /// <para>
    /// It is still not a claim that the office has verified an identity. Occupancies carry occupant names as free text with no
    /// payor record behind them — which is how the word "Closed" came to be stored as a person's name on three market stalls —
    /// so the tag states what was compared and leaves the identification to the clerk.
    /// </para>
    /// </summary>
    private bool OccupantNameMatchesCurrentTerm(ClosedStallAccountDto prior)
        => Stall is not null
        && PersonName.Matches(prior.Occupant, Stall.ActualOccupant);

    /// <summary>The earlier term a collection is being recorded against, or null when the dialog is closed.</summary>
    private ClosedStallAccountDto? _priorTermPayment;

    private void OpenPriorTermPayment(ClosedStallAccountDto prior) => _priorTermPayment = prior;

    private void ClosePriorTermPayment() => _priorTermPayment = null;

    private async Task OnPriorTermPaid()
    {
        _priorTermPayment = null;
        await LoadStallData();
        await LoadPriorTermsAsync();
    }
    string DisplayStallNo = string.Empty;

    private bool IsNpm => FacilityId.ToUpper() == "NPM";

    // The tenant's own resolved NPM daily rate. Zero until the office's rates answer, so this page never quotes
    // another municipality's ordinance: a ₱30 seed here showed Cantilan's fee on a profile whose tenant charges
    // something else, or whose rates call failed. The rate line states nothing rather than a wrong figure.
    private decimal _npmDailyRate;

    // The tenant's own per-kilo section fee. Zero means this office charges none, and the profile then states
    // no such fee at all rather than quoting another municipality's.
    private decimal _npmFishRate;

    // GitHub-style daily heatmap (NPM only): last ~12 months of per-day collection status.
    private sealed record HeatCell(DateOnly Date, string Kind);
    private List<List<HeatCell>> _heatWeeks = new();   // each inner list = 7 cells (Sun→Sat)
    private int _heatCollected;
    private int _heatMissed;
    private int _heatYear = EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year;

    // Collection history (transparency log) — cursor-paginated 10/page (NPM days / monthly records).
    private readonly List<StallCollectionHistoryRowDto> _history = new();
    private DateTime? _historyCursor;
    private bool _historyHasMore;
    private bool _historyLoading;
    private bool _historyError;

    private async Task LoadHistory(bool reset)
    {
        if (StallGuid == Guid.Empty || _historyLoading) return;
        if (reset)
        {
            _history.Clear();
            _historyCursor = null;
            _historyHasMore = false;
        }
        _historyLoading = true;
        _historyError = false;
        try
        {
            var result = await StallsApi.GetStallCollectionHistoryAsync(StallGuid, _historyCursor, 10);
            if (result.IsSuccess && result.Value is not null)
            {
                _history.AddRange(result.Value.Items);
                _historyCursor = result.Value.NextCursor;
                _historyHasMore = result.Value.HasMore;
            }
            else
            {
                // Distinguish a failed fetch from a genuinely empty log (don't show "no records").
                _historyError = true;
            }
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private Task LoadMoreHistory() => LoadHistory(reset: false);

    // ── Transaction grouping (display only) ──────────────────────────────────────────────────────
    // One physical receipt (OR) can settle several months/days of THIS stall in a single transaction —
    // they all carry the SAME OR. Collapse consecutive rows that share a non-empty OR into one line so
    // the log reads as "one payment · Jun–Jul · ₱1,800" instead of a row per month. This is purely a
    // presentation transform over the paginated rows; the underlying per-month/day records are untouched
    // (reports, delinquency and per-period status still see each record). Blank/unique ORs stay separate.
    private sealed class HistoryGroup
    {
        public string? ORNumber;
        public List<StallCollectionHistoryRowDto> Rows { get; } = new();
        public int Count => Rows.Count;
        public StallCollectionHistoryRowDto Newest => Rows[0];   // list is newest-first
        public StallCollectionHistoryRowDto Oldest => Rows[^1];
        public decimal Total => Rows.Sum(r => r.Amount);
        public string Status => Rows.All(r => r.Status == Rows[0].Status) ? Rows[0].Status : "Paid";
    }

    private List<HistoryGroup> GroupedHistory
    {
        get
        {
            var groups = new List<HistoryGroup>();
            foreach (var row in _history)
            {
                var or = row.ORNumber?.Trim();
                var last = groups.Count > 0 ? groups[^1] : null;
                if (last is not null && !string.IsNullOrEmpty(or) && string.Equals(last.ORNumber, or, StringComparison.Ordinal))
                    last.Rows.Add(row);
                else
                    groups.Add(new HistoryGroup { ORNumber = string.IsNullOrEmpty(or) ? null : or, Rows = { row } });
            }
            return groups;
        }
    }

    private string HistoryDateLabel(HistoryGroup g)
    {
        if (g.Count == 1)
            return g.Newest.Date.ToString(IsNpm ? "MMM d, yyyy" : "MMM yyyy");

        var newest = g.Newest.Date;
        var oldest = g.Oldest.Date;
        if (IsNpm)
            return oldest.Year == newest.Year
                ? $"{oldest:MMM d} – {newest:MMM d, yyyy}"
                : $"{oldest:MMM d, yyyy} – {newest:MMM d, yyyy}";
        return oldest.Year == newest.Year
            ? $"{oldest:MMM} – {newest:MMM yyyy}"
            : $"{oldest:MMM yyyy} – {newest:MMM yyyy}";
    }

    class StallProfile
    {
        public string Facility { get; set; } = string.Empty;
        public string StallNo { get; set; } = string.Empty;
        public string Section { get; set; } = string.Empty;
        public double AreaSqm { get; set; }
        public string AreaNote { get; set; } = string.Empty;
        public string ActualOccupant { get; set; } = string.Empty;
        public string ContractName { get; set; } = string.Empty;
        public DateTime? ContractDate { get; set; }
        public string ContractDuration { get; set; } = string.Empty;
        public int ContractYears { get; set; }
        public DateTime? ContractExpiry { get; set; }
        public decimal MonthlyRate { get; set; }
        public decimal? DailyRate { get; set; }
        public bool HasElectricity { get; set; }
        public decimal ElecReading { get; set; }
        public decimal ElecAmount { get; set; }
        public bool HasWater { get; set; }
        public decimal WaterReading { get; set; }
        public decimal WaterAmount { get; set; }
        public decimal FishKilos { get; set; }
        /// <summary>True when this space sits in the section its office charges a per-kilo fee on.</summary>
        public bool CarriesSectionFee { get; set; }
        public decimal FishFee => CarriesSectionFee ? FishKilos : 0;
        public decimal TotalBill => MonthlyRate + ElecAmount + WaterAmount + FishFee;
        public bool IsPaid { get; set; }
        public bool IsPartial { get; set; }
        public decimal PartialAmount { get; set; }
        public decimal TotalPaid => IsPaid ? TotalBill : IsPartial ? PartialAmount : 0;
        public decimal BalanceDue => TotalBill - TotalPaid;
        public bool IsActive { get; set; } = true;
        public string ORNumber { get; set; } = string.Empty;
        public string Remarks { get; set; } = string.Empty;
        public Dictionary<string, string> PaymentHistory { get; set; } = new();
        // Authoritative daily-aware rolling 12-month ledger totals (from the server).
        public StallLedgerSummaryDto? LedgerSummary { get; set; }
    }

    StallProfile Stall = new();

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadStallData();
    }

    async Task LoadStallData()
    {
        IsLoading = true;
        
        // Parse facility code from URL parameter. Enum.TryParse resolves canonical codes
        // (NPM/TCC/…) AND custom slots (Custom1..Custom5) case-insensitively, so a custom
        // facility profile loads its OWN stalls instead of falling through to NPM.
        var facilityCode = Enum.TryParse<Domain.Enums.FacilityCode>(FacilityId, ignoreCase: true, out var _fc)
            ? _fc
            : Domain.Enums.FacilityCode.NPM;

        // NPM bills per day from the tenant's resolved daily rate; fetch it so the profile shows the
        // billed rate (₱30 ordinance fallback keeps Cantilan unchanged).
        if (facilityCode == Domain.Enums.FacilityCode.NPM)
        {
            var ratesResult = await StallsApi.GetNpmRatesAsync();
            if (ratesResult.IsSuccess && ratesResult.Value is not null)
            {
                _npmDailyRate = ratesResult.Value.DailyRate;
                _npmFishRate = ratesResult.Value.FishRate;
            }
        }

        // Load stalls from API
        var stallsResult = await StallsApi.GetStallsByFacilityPaginatedAsync(facilityCode, null, null, 100);
        
        if (stallsResult.IsSuccess && stallsResult.Value != null)
        {
            var stallDto = Guid.TryParse(StallKey, out var keyId)
                ? stallsResult.Value.Items.FirstOrDefault(s => s.Id == keyId)
                : stallsResult.Value.Items.FirstOrDefault(s => s.StallNo == StallKey);
            
            if (stallDto != null)
            {
                StallGuid = stallDto.Id;
                DisplayStallNo = stallDto.StallNo;

                // Fetch all per-stall data concurrently (each is keyed by the stall id and independent),
                // instead of awaiting them one after another. The NPM daily heatmap still runs after the
                // Stall object is built, because it reads the contract date from it.
                var historyTask = PaymentsApi.GetPaymentHistoryAsync(stallDto.Id);
                var currentPaymentTask = PaymentsApi.GetPaymentRecordAsync(stallDto.Id, PhilippineTime.Now.Year, PhilippineTime.Now.Month);
                var ledgerTask = PaymentsApi.GetStallLedgerSummaryAsync(stallDto.Id);
                var reportTask = FacilityId.ToUpper() == "NPM"
                    ? FacilitiesApi.GetFacilityReportsAsync(facilityCode, Domain.Enums.ReportPeriod.Monthly, PhilippineTime.Now.Year, PhilippineTime.Now.Month)
                    : null;
                var pending = new List<Task> { historyTask, currentPaymentTask, ledgerTask };
                if (reportTask is not null) pending.Add(reportTask);
                await Task.WhenAll(pending);

                // Load payment history
                var historyResult = await historyTask;
                var paymentHistory = new Dictionary<string, string>();
                
                if (historyResult.IsSuccess && historyResult.Value != null)
                {
                    foreach (var payment in historyResult.Value)
                    {
                        paymentHistory[payment.Period] = payment.IsExcused ? "Absent"
                            : payment.Status == Domain.Enums.PaymentStatus.Paid ? "Paid" 
                            : payment.Status == Domain.Enums.PaymentStatus.Partial ? "Partial" 
                            : "Unpaid";
                    }
                }

                // Seed the monthly grid's status map for the default (current) year from the rolling history.
                _monthlyStatus = new Dictionary<string, string>(paymentHistory);
                
                // Load current month payment record
                var currentPaymentResult = await currentPaymentTask;
                
                // Handle 404 - no payment record exists yet for current month
                bool isPaid = false;
                bool isPartial = false;
                decimal partialAmount = 0;
                decimal elecAmount = 0;
                decimal waterAmount = 0;
                string orNumber = string.Empty;
                
                if (currentPaymentResult.IsSuccess && currentPaymentResult.Value != null)
                {
                    isPaid = currentPaymentResult.Value.Status == Domain.Enums.PaymentStatus.Paid;
                    isPartial = currentPaymentResult.Value.Status == Domain.Enums.PaymentStatus.Partial;
                    partialAmount = isPartial ? currentPaymentResult.Value.TotalPaid : 0;
                    elecAmount = currentPaymentResult.Value.ElecAmount ?? 0;
                    waterAmount = currentPaymentResult.Value.WaterAmount ?? 0;
                    orNumber = currentPaymentResult.Value.ORNumber ?? string.Empty;
                }

                // NPM is collected daily, so the true status comes from the daily-aware report
                // compliance (a vendor who paid some days is Partial — the monthly PaymentRecord
                // alone would read Unpaid). Mirrors the NPM facility page / payment modal.
                if (FacilityId.ToUpper() == "NPM")
                {
                    var reportResult = await reportTask!;
                    var compliance = reportResult.IsSuccess
                        ? reportResult.Value?.StallCompliance?.FirstOrDefault(c => c.StallId == StallGuid)
                        : null;
                    if (compliance != null)
                    {
                        isPaid = compliance.Status == "Paid";
                        isPartial = compliance.Status == "Partial";
                        partialAmount = compliance.AmountPaid;
                        if (!string.IsNullOrWhiteSpace(compliance.ORNumber))
                            orNumber = compliance.ORNumber!;
                    }
                }
                
                var section = stallDto.Section switch
                {
                    // The office's own name for the area. The fee decision below reads the MarketSection value
                    // itself, so what this stall is charged never depends on the wording shown here.
                    Domain.Enums.MarketSection.VegetableArea => FacilityCatalog.SectionLabelOf(FacilityCode.NPM, Domain.Enums.MarketSection.VegetableArea),
                    Domain.Enums.MarketSection.FishSection => FacilityCatalog.SectionLabelOf(FacilityCode.NPM, Domain.Enums.MarketSection.FishSection),
                    Domain.Enums.MarketSection.MeatSection => FacilityCatalog.SectionLabelOf(FacilityCode.NPM, Domain.Enums.MarketSection.MeatSection),
                    _ => stallDto.AreaLocation switch
                    {
                        Domain.Enums.NccAreaLocation.Extension => "Extension",
                        Domain.Enums.NccAreaLocation.Corner => "Corner",
                        _ => "No Location"
                    }
                };
                
                // What this space is actually billed for, from its own record — not "it is a market stall, so
                // assume both". The assumption printed meters a vendor does not have, and (once the update
                // handler began writing the charges) would have put them on the stall on any profile save.
                var hasElec = stallDto.HasElectricity;
                var hasWater = stallDto.HasWater;
                
                Stall = new()
                {
                    Facility = GetFacilityName(FacilityId),
                    StallNo = stallDto.StallNo,
                    Section = section,
                    AreaSqm = stallDto.AreaSqm ?? 0,
                    AreaNote = stallDto.AreaNote ?? string.Empty,
                    ActualOccupant = stallDto.ActualOccupant ?? "N/A",
                    ContractName = stallDto.NameOnContract ?? "N/A",
                    ContractDate = stallDto.ContractDate,
                    ContractDuration = stallDto.ContractYears > 0 ? $"{stallDto.ContractYears} year{(stallDto.ContractYears > 1 ? "s" : "")}" : "—",
                    ContractYears = stallDto.ContractYears,
                    ContractExpiry = stallDto.ContractYears > 0 ? stallDto.ContractDate?.AddYears(stallDto.ContractYears) : null,
                    MonthlyRate = stallDto.MonthlyRate,
                    DailyRate = stallDto.DailyRate,
                    HasElectricity = hasElec,
                    ElecReading = 0,
                    ElecAmount = elecAmount,
                    HasWater = hasWater,
                    WaterReading = 0,
                    WaterAmount = waterAmount,
                    FishKilos = 0,
                    CarriesSectionFee = stallDto.Section == Domain.Enums.MarketSection.FishSection,
                    IsPaid = isPaid,
                    IsPartial = isPartial,
                    PartialAmount = partialAmount,
                    IsActive = stallDto.Status == Domain.Enums.StallStatus.Active,
                    ORNumber = orNumber,
                    Remarks = stallDto.Remarks ?? string.Empty,
                    PaymentHistory = paymentHistory,
                    LedgerSummary = (await ledgerTask).Value
                };

                // Earlier occupancy spans first, then the grid: the grid needs them to know whether a past day was
                // chargeable, and building it first left 2026's window showing the previous term's months as "no
                // obligation" until something happened to redraw it. Deterministic order rather than a redraw race.
                if (IsNpm)
                {
                    await LoadPriorTermsAsync();
                    await LoadNpmDailyHeatmap(StallGuid);
                }
            }
            else
            {
                // Stall not found, redirect back
                Navigation.NavigateTo("/facility/" + FacilitySlug);
            }
        }
        
        IsLoading = false;

        // Earlier terms on this stall load off the critical path, like the collection history below: the profile
        // paints on its current term and the prior-term card appears when the register answers.
        // Non-NPM profiles have no daily grid, so their earlier terms can load off the critical path.
        if (!IsNpm) _ = LoadPriorTermsAsync();

        // Collection history loads off the first-paint critical path: paint the profile now
        // (StateHasChanged), then fetch page 1 while the card shows its own loading state, so a
        // slow history query never delays the whole page.
        if (StallGuid != Guid.Empty)
        {
            StateHasChanged();
            await LoadHistory(reset: true);
        }
    }

    string GetFacilityName(string facilityId)
    {
        // Canonical + custom facilities use the tenant's own name; legacy slugs fall through to the map.
        if (System.Enum.TryParse<FacilityCode>(facilityId, true, out var _fc))
            return FacilityCatalog.NameOf(_fc);
        return facilityId.ToLower() switch
        {
            // From Report.razor (lowercase)
            "npm" => "New Public Market",
            "tcc" => "Tampak Commercial Center",
            "ncc" => "New Commercial Center",
            "bbq" => "Barbecue Stand",
            "ice" => "Iceplant",
            "slh" => "Slaughterhouse",

            // From facility pages (uppercase/mixed case)
            "npm-annex" => "New Public Market Annex",
            "public-market-1" => "Public Market 1",
            "public-market-2" => "Public Market 2",
            _ => "Unknown Facility"
        };
    }

    // ── GitHub-style daily collection heatmap (NPM) ──
    async Task LoadNpmDailyHeatmap(Guid stallId)
    {
        var today = EEMOCantilanSDS.Domain.Common.PhilippineTime.Today;
        var year = _heatYear;

        // Window END: today for the current (or a future-picked) year; Dec 31 for a past year. The grid
        // always shows the trailing ~52 weeks ending there — full width, no future cells, and it includes
        // the preceding months ("the passed") so the row spans the whole width instead of half.
        var end = year >= today.Year ? today : new DateOnly(year, 12, 31);
        var start = end.AddDays(-363);
        while (start.DayOfWeek != DayOfWeek.Sunday) start = start.AddDays(-1);

        // Fetch every calendar month the window touches, in parallel.
        var months = new List<(int y, int m)>();
        var mc = new DateOnly(start.Year, start.Month, 1);
        var endMonth = new DateOnly(end.Year, end.Month, 1);
        while (mc <= endMonth) { months.Add((mc.Year, mc.Month)); mc = mc.AddMonths(1); }

        var results = await Task.WhenAll(
            months.Select(mm => DailyCollectionApi.GetDailyCollectionMonthAsync(stallId, mm.y, mm.m)));

        var status = new Dictionary<DateOnly, string>();
        foreach (var r in results)
        {
            if (r.IsSuccess && r.Value is not null)
                foreach (var day in r.Value.Collections.Values)
                    status[day.Date] = day.IsMarketClosed || day.IsAbsent ? "excused" : day.IsPaid ? "collected" : "missed";
        }

        var contractStart = Stall.ContractDate.HasValue ? DateOnly.FromDateTime(Stall.ContractDate.Value) : (DateOnly?)null;

        var weeks = new List<List<HeatCell>>();
        var collected = 0;
        var missed = 0;
        var d = start;
        while (d <= end)
        {
            var week = new List<HeatCell>();
            for (var i = 0; i < 7; i++)
            {
                string kind;
                if (d > today) kind = "future";                                   // only the tail of the final week
                else if (!WasUnderContract(d, contractStart)) kind = "none";
                else if (status.TryGetValue(d, out var st)) kind = st;
                else kind = "missed";
                if (kind == "collected") collected++;
                else if (kind == "missed") missed++;
                week.Add(new HeatCell(d, kind));
                d = d.AddDays(1);
            }
            weeks.Add(week);
        }
        _heatWeeks = weeks;
        _heatCollected = collected;
        _heatMissed = missed;
    }

    // Year navigation for the daily heatmap.
    private bool _heatYearMenuOpen;
    private IEnumerable<int> HeatYearOptions =>
        Enumerable.Range(0, 12).Select(i => EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year - i);

    private void ToggleHeatYearMenu() => _heatYearMenuOpen = !_heatYearMenuOpen;

    private async Task PrevHeatYear()
    {
        _heatYearMenuOpen = false;
        _heatYear--;
        await LoadNpmDailyHeatmap(StallGuid);
    }

    private async Task NextHeatYear()
    {
        if (_heatYear >= EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year) return;
        _heatYearMenuOpen = false;
        _heatYear++;
        await LoadNpmDailyHeatmap(StallGuid);
    }

    private async Task PickHeatYear(int y)
    {
        _heatYearMenuOpen = false;
        if (y == _heatYear) return;
        _heatYear = y;
        await LoadNpmDailyHeatmap(StallGuid);
    }

    private async Task GoToCurrentHeatYear()
    {
        _heatYearMenuOpen = false;
        var cy = EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year;
        if (_heatYear == cy) return;
        _heatYear = cy;
        await LoadNpmDailyHeatmap(StallGuid);
    }

    // Year navigation for the monthly (non-NPM) 12-month payment grid.
    private int _monthlyYear = EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year;
    private bool _monthlyYearMenuOpen;
    private Dictionary<string, string> _monthlyStatus = new();   // "yyyy-MM" → Paid/Partial/Unpaid/Absent

    private void ToggleMonthlyYearMenu() => _monthlyYearMenuOpen = !_monthlyYearMenuOpen;

    private async Task PrevMonthlyYear()
    {
        _monthlyYearMenuOpen = false;
        _monthlyYear--;
        await LoadMonthlyYear(_monthlyYear);
    }

    private async Task NextMonthlyYear()
    {
        if (_monthlyYear >= EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year) return;
        _monthlyYearMenuOpen = false;
        _monthlyYear++;
        await LoadMonthlyYear(_monthlyYear);
    }

    private async Task PickMonthlyYear(int y)
    {
        _monthlyYearMenuOpen = false;
        if (y == _monthlyYear) return;
        _monthlyYear = y;
        await LoadMonthlyYear(y);
    }

    private async Task GoToCurrentMonthlyYear()
    {
        _monthlyYearMenuOpen = false;
        var cy = EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year;
        if (_monthlyYear == cy) return;
