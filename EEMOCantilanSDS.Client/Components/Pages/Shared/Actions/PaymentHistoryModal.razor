@using EEMOCantilanSDS.Client.Components.Shared
@inject IPaymentsApiClient PaymentsApi

@typeparam TStall

@* A stall's 12-month payment record. The figures and rows are this component's own (they come from the stall's legacy payment records
   and the server's ledger); how they are presented is the shared RentalHistoryLedger, the same design a space-rental account uses. *@
@if (Show && Stall is not null)
{
    var history = GetPaymentHistory(Stall);
    var rate = GetMonthlyRate(Stall);
    var stallNo = GetStallNo(Stall);
    var occupant = GetActualOccupant(Stall);
    var contractName = GetContractName(Stall);
    var transactions = GetTransactions(Stall);
    var contractDate = GetContractDate(Stall);
    var now = EEMOCantilanSDS.Domain.Common.PhilippineTime.Now;

    // Calculate experienced months only (from contract start to now)
    var experiencedMonths = new List<DateTime>();
    for (int i = 11; i >= 0; i--)
    {
        var month = now.AddMonths(-i);
        var key = month.ToString("yyyy-MM");
        var hasRecord = PaymentHistory.Any(p => p.Period == key);
        var contractStarts = contractDate.HasValue ? new DateTime(contractDate.Value.Year, contractDate.Value.Month, 1) : (DateTime?)null;
        var beforeContract = !hasRecord && contractStarts.HasValue && month < contractStarts.Value;
        if (!beforeContract)
            experiencedMonths.Add(month);
    }

    int monthsExcused = PaymentHistory.Count(p => p.IsExcused);
    int monthsPaid = PaymentHistory.Count(p => p.Status == Domain.Enums.PaymentStatus.Paid && !p.IsExcused);
    int monthsPartial = PaymentHistory.Count(p => p.Status == Domain.Enums.PaymentStatus.Partial);
    decimal collected = PaymentHistory
        .Where(p => !p.IsExcused && (p.Status == Domain.Enums.PaymentStatus.Paid || p.Status == Domain.Enums.PaymentStatus.Partial))
        .Sum(p => p.AmountPaid);

    // Prefer the server's ledger for the two headline figures. Its rules are the ones every other money screen
    // uses; the fallback below is only for a caller that supplies no ledger.
    var ledger = Ledger(Stall);

    int monthsUnpaid = ledger?.MonthsUnpaid
        // A part-paid month is still outstanding: ₱120 against a ₱900 month leaves the month owed. Counting only
        // the months with no record at all reported a part payor as fully up to date.
        ?? (experiencedMonths.Count - monthsPaid - monthsExcused);
    decimal balance = ledger?.TotalOutstanding ?? experiencedMonths.Sum(m =>
    {
        var rec = PaymentHistory.FirstOrDefault(p => p.Period == m.ToString("yyyy-MM"));
        return rec is null ? rate
             : rec.IsExcused ? 0m
             : rec.Status == Domain.Enums.PaymentStatus.Paid ? 0m
             : rec.Status == Domain.Enums.PaymentStatus.Partial ? rec.BalanceDue
             : rate;
    });
    int compliancePct = experiencedMonths.Count > 0 ? (int)((double)monthsPaid / experiencedMonths.Count * 100) : 0;

    var currentMonthKey = now.ToString("yyyy-MM");
    var currentRecord = PaymentHistory.FirstOrDefault(p => p.Period == currentMonthKey);
    decimal currentPartial = currentRecord?.Status == Domain.Enums.PaymentStatus.Partial ? currentRecord.AmountPaid : 0;

    // This rolling total includes the month in progress, so it cannot by itself prove that a fully elapsed month is unpaid.
    // Keep this modal's aggregate badge descriptive rather than assigning either delinquency or unresolved Arrears status.
    string statusLabel = monthsUnpaid == 0 ? "Consistent Payer" : "Unpaid Balance";

    var rows = new List<RentalHistoryLedger.LedgerRow>();
    for (int i = 11; i >= 0; i--)
    {
        var month = now.AddMonths(-i);
        var key = month.ToString("yyyy-MM");
        var contractStart = contractDate.HasValue ? new DateTime(contractDate.Value.Year, contractDate.Value.Month, 1) : (DateTime?)null;
        var apiRecord = PaymentHistory.FirstOrDefault(p => p.Period == key);
        var hasRecord = apiRecord != null;
        var isBeforeContract = !hasRecord && contractStart.HasValue && month < contractStart.Value;
        var payStatus = hasRecord ? apiRecord!.Status : Domain.Enums.PaymentStatus.Unpaid;
        var isExcused = hasRecord && apiRecord!.IsExcused;
        var isPaid = !isExcused && payStatus == Domain.Enums.PaymentStatus.Paid;
        var isPartial = payStatus == Domain.Enums.PaymentStatus.Partial;
        var isCurr = month.Month == now.Month && month.Year == now.Year;

        decimal rowBalance = 0;
        if (!isBeforeContract && !isExcused)
        {
            if (isPaid) rowBalance = 0;                                       // Fully paid
            else if (isPartial && apiRecord != null) rowBalance = apiRecord.BalanceDue;   // Remaining balance after partial
            else rowBalance = rate;                                           // Unpaid full amount
        }
        var paidRow = (isPaid || isPartial) && apiRecord is not null;

        rows.Add(new RentalHistoryLedger.LedgerRow(
            month.ToString("MMMM"), month.Year.ToString(), isCurr,
            isBeforeContract ? RentalHistoryLedger.LedgerKind.BeforeContract : isExcused ? RentalHistoryLedger.LedgerKind.Absent
                : isPaid ? RentalHistoryLedger.LedgerKind.Paid : isPartial ? RentalHistoryLedger.LedgerKind.Partial : RentalHistoryLedger.LedgerKind.Unpaid,
            isBeforeContract ? "N/A" : isExcused ? "Absent" : isPaid ? "Paid" : isPartial ? "Partial" : "Unpaid",
            paidRow && !string.IsNullOrEmpty(apiRecord!.ORNumber) ? apiRecord.ORNumber : null,
            paidRow && apiRecord!.PaidAt.HasValue ? apiRecord.PaidAt.Value.ToString("MMM d, yyyy") : null,
            paidRow && !string.IsNullOrEmpty(apiRecord!.CollectorName) ? apiRecord.CollectorName : null,
            isBeforeContract || isExcused ? null : paidRow ? $"₱{apiRecord!.AmountPaid:N0}" : $"₱{rate:N0}",
            paidRow,
            isBeforeContract ? null : $"₱{rowBalance:N0}",
            rowBalance > 0));
    }

    var stats = new List<RentalHistoryLedger.LedgerStat>
    {
        new($"₱{rate:N0}", null, "Monthly Rate"),
        new(monthsPaid.ToString(), $"/{experiencedMonths.Count}", "Months Paid"),
        new(monthsPartial.ToString(), $"/{experiencedMonths.Count}", "Partial", monthsPartial > 0 ? "partial" : ""),
        new(monthsUnpaid.ToString(), $"/{experiencedMonths.Count}", "Unpaid", monthsUnpaid > 0 ? "red" : ""),
        new($"₱{collected:N0}", null, "Collected"),
        new($"₱{balance:N0}", null, "Balance Due", balance > 0 ? "red" : ""),
        new($"₱{currentPartial:N0}", null, "Current Partial")
    };

    // "unpaid" clashed with the arrears list, which counts only months that have CLOSED. This dialog shows the month in progress as a
    // row and includes its earned days in the balance, so it counts months carrying a balance.
    <RentalHistoryLedger EyebrowParts="@(new[] { FacilityCode, $"Stall {stallNo}", "12-Month Payment Record" })"
                         Name="@occupant"
                         ContractLine="@(!string.IsNullOrEmpty(contractName) && contractName != occupant ? $"Contract: {contractName}" : null)"
                         BadgeLabel="@statusLabel" BadgeConsistent="@(monthsUnpaid == 0)"
                         Stats="stats" CompliancePercent="compliancePct" Rows="rows"
                         FooterMeta="@($"Records cover the last 12 rolling months  ·  {now.AddMonths(-11):MMM yyyy} – {now:MMM yyyy}")"
                         BalanceAlert="@(balance > 0 ? $"Outstanding: ₱{balance:N0} · {monthsUnpaid} month{(monthsUnpaid != 1 ? "s" : "")} with a balance" : null)"
                         OnClose="OnClose" />
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public TStall? Stall { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string FacilityCode { get; set; } = string.Empty;
    [Parameter] public string FacilityName { get; set; } = string.Empty;

    private List<Application.Dtos.Payments.PaymentHistoryDto> PaymentHistory { get; set; } = new();
    private bool IsLoading { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && Stall is not null)
        {
            await LoadPaymentHistory();
        }
    }

    private async Task LoadPaymentHistory()
    {
        var stallGuid = GetStallGuid(Stall!);
        if (stallGuid == Guid.Empty)
            return;

        IsLoading = true;
        var result = await PaymentsApi.GetPaymentHistoryAsync(stallGuid);
        if (result.IsSuccess && result.Value != null)
        {
            PaymentHistory = result.Value.ToList();
        }
        IsLoading = false;
    }

    public class PaymentTransaction
    {
        public string PeriodKey { get; set; } = string.Empty;
        public string ORNumber { get; set; } = string.Empty;
        public DateTime? PaidDate { get; set; }
        public string Collector { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    private Guid GetStallGuid(TStall s) => GetProp<Guid>(s, "StallGuid");
    private string GetStallNo(TStall s) => GetProp<string>(s, "StallNo") ?? "—";
    private string GetActualOccupant(TStall s) => GetProp<string>(s, "ActualOccupant") ?? "—";
    private string GetContractName(TStall s) => GetProp<string>(s, "ContractName") ?? string.Empty;
    private decimal GetMonthlyRate(TStall s) => GetProp<decimal?>(s, "MonthlyRate") ?? 0m;
    private decimal GetPartialAmount(TStall s) => GetProp<decimal?>(s, "PartialAmount") ?? 0m;
    private bool GetIsPartial(TStall s) => GetProp<bool?>(s, "IsPartial") ?? false;
    private DateTime? GetContractDate(TStall s) => GetProp<DateTime?>(s, "ContractDate");

    /// <summary>
    /// The server's own ledger for this stall, when the caller supplies it. Its figures are the ones the arrears
    /// lists, the profile card and the register all use: a month is outstanding until its obligation is met, and a
    /// daily-collected month in progress is billed for the days it has earned, not the whole month. Recomputing
    /// that here from monthly rows made this dialog say ₱1,800 and "1 month unpaid" beside a card reading ₱1,050
    /// and an arrears list reading 2 months, for the same stall on the same screen.
    /// </summary>
    private EEMOCantilanSDS.Application.Dtos.Payments.StallLedgerSummaryDto? Ledger(TStall? s)
        => s is null ? null : GetProp<EEMOCantilanSDS.Application.Dtos.Payments.StallLedgerSummaryDto?>(s, "LedgerSummary");

    private Dictionary<string, bool> GetPaymentHistory(TStall s)
    {
        // Convert API PaymentHistory to Dictionary for backward compatibility
        var dict = new Dictionary<string, bool>();
        foreach (var payment in PaymentHistory)
        {
            dict[payment.Period] = payment.Status == Domain.Enums.PaymentStatus.Paid;
        }
        return dict;
    }

    private List<PaymentTransaction> GetTransactions(TStall s)
    {
        // Convert API PaymentHistory to PaymentTransaction list
        return PaymentHistory.Select(p => new PaymentTransaction
        {
            PeriodKey = p.Period,
            ORNumber = p.ORNumber ?? string.Empty,
            PaidDate = p.PaidAt,
            Collector = p.CollectorName ?? string.Empty,
            Amount = p.AmountPaid
        }).ToList();
    }

    private T? GetProp<T>(TStall s, string name)
    {
        var prop = s?.GetType().GetProperty(name);
        return prop is not null ? (T?)prop.GetValue(s) : default;
    }
}
