@using System.Security.Claims
@using EEMOCantilanSDS.Application.Dtos.Tenancy
@inject IOnlinePaymentsApiClient OnlinePaymentsApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<button class="sidebar-hamburger" type="button" @onclick="ToggleMobileDrawer" aria-label="Toggle navigation">
    <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
</button>

@if (_mobileOpen)
{
    <div class="sidebar-backdrop" @onclick="CloseMobileDrawer"></div>
}

<aside class="sidebar @(SidebarCollapsed ? "collapsed" : "") @(_mobileOpen ? "mobile-open" : "")">
    <div class="sidebar-brand">
        <div class="sidebar-seal">
            <img src="@Branding.SealPath" alt="@Branding.Municipality" />
        </div>
        <div class="sidebar-brand-text">
            <div class="sidebar-brand-name">STALLTRACK</div>
            <div class="sidebar-brand-sub">@_portalLabel</div>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <nav class="sidebar-nav">
        <div class="nav-group-label">Main</div>

        <NavLink href="/overview" class="@NavItemClass("/overview")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/overview")'>
            @* Exactly the Dashboard page's own mark: four 7x7 panels at 3/14 with square corners. An earlier
               attempt rounded them and widened them to 7.5, which is why it never matched. The stroke is
               thinned in CSS so the four panels stay separate at 16px. *@
            <svg viewBox="0 0 24 24" class="nav-icon-dashboard"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
            <span>Overview</span>
        </NavLink>

        <NavLink href="/operations" class="@NavItemClass("/operations")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/operations")'>
            <svg viewBox="0 0 24 24"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-5h6v5" /><path d="M9 9h.01M15 9h.01M9 12h.01M15 12h.01" /></svg>
            <span>Operations</span>
        </NavLink>

        <NavLink href="/collections/activity" class="@NavItemClass("/collections/activity")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/collections/activity")'>
            <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z" /><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" /></svg>
            <span>Collection Activity</span>
        </NavLink>
        <NavLink href="/online-payments" class="@NavItemClass("/online-payments")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/online-payments")'>
            <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
            <span>Online Payments</span>
            @if (_onlinePaymentsAwaitingOr > 0)
            {
                <span class="nav-badge">@_onlinePaymentsAwaitingOr</span>
            }
        </NavLink>

        <NavLink href="/vendors" class="@NavItemClass("/vendors")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/vendors")'>
            <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
            <span>Payors &amp; Accounts</span>
        </NavLink>

        <NavLink href="/monitoring/follow-up" class="@NavItemClass("/monitoring/follow-up")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/monitoring/follow-up")'>
            <svg viewBox="0 0 24 24"><path d="M4 19V5" /><path d="M4 19h17" /><path d="M7 15l4-4 3 2 5-7" /><path d="M16 6h3v3" /></svg>
            <span>Monitoring</span>
        </NavLink>

        <NavLink href="/reports" class="@NavItemClass("/reports")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/reports")'>
            <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            <span>Reports</span>
        </NavLink>

        <div class="sidebar-divider"></div>

        @if (_isHead)
        {
            <NavLink href="/collectors" class="@NavItemClass("/collectors")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/collectors")'>
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" /></svg>
                <span>Collectors</span>
            </NavLink>
        }
        else
        {
            <div class="nav-item nav-item-locked" title="Only the Head can manage collectors">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" /></svg>
                <span>Collectors</span>
                <svg class="nav-lock" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
            </div>
        }

        @if (_isHead)
        {
            <NavLink href="/audit-trail" class="@NavItemClass("/audit-trail")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/audit-trail")'>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                <span>Audit Trail</span>
            </NavLink>
        }
        else
        {
            <div class="nav-item nav-item-locked" title="Only the Head can view the audit trail">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                <span>Audit Trail</span>
                <svg class="nav-lock" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
            </div>
        }
        <NavLink href="/settings" class="@NavItemClass("/settings")" Match="NavLinkMatch.All" @onclick='() => SetPendingPath("/settings")'>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93l-1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M4.93 4.93l1.41 1.41M21 12h-2M5 12H3M12 21v-2M12 5V3" /></svg>
            <span>Settings</span>
        </NavLink>
    </nav>

    <button class="sidebar-toggle" @onclick="() => SidebarCollapsed = !SidebarCollapsed">
        <svg viewBox="0 0 24 24"><polyline points="@(SidebarCollapsed ? "9 6 15 12 9 18" : "15 18 9 12 15 6")" /></svg>
    </button>
</aside>

@* Cross-page "restore complete" popup — event-driven (subscribes to the scoped RestoreNotifier); no timer here. *@

@code {
    private bool SidebarCollapsed;
    private bool _mobileOpen;   // off-canvas drawer open state (mobile only; desktop ignores it)
    private string _portalLabel = "Admin Portal";
    private bool _isHead;   // Head (SuperAdmin) sees Collectors + Audit; a plain Admin gets them locked.
    private string? _pendingPath;
    private int _onlinePaymentsAwaitingOr;

    [PersistentState(AllowUpdates = true)]
    public int? OnlinePaymentsAwaitingOr { get; set; }

    /// <summary>
    /// The office's own branding, carried from the prerendered pass into the interactive one.
    ///
    /// <para>
    /// Reported from use as a flash of the wrong seal on every refresh, and it was exactly that. The signed-in shell is
    /// the one place that never carried branding across the boundary, so the interactive pass began with an empty
    /// <c>BrandingState</c>: awaiting the API yields, the sidebar paints once with the fallback seal and acronym, and
    /// re-paints a second later with the office's own. The prerendered markup and the interactive first paint therefore
    /// differed, which is the "displaying twice" as well — the swap is only visible when the two disagree.
    /// </para>
    ///
    /// <para>
    /// The same mechanism the login and change-password pages already use. It also means the API is asked once per
    /// refresh instead of twice.
    /// </para>
    /// </summary>
    [PersistentState]
    public MunicipalityBrandingDto? PersistedBranding { get; set; }

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            _pendingPath = null;
            SetMobileOpen(false);   // navigating closes the mobile drawer
            StateHasChanged();
        });

    private void SetPendingPath(string href)
    {
        var targetPath = NormalizePath(href);
        _pendingPath = targetPath;
        SetMobileOpen(false);   // tapping a nav item closes the drawer (incl. same-page taps)
    }

    // Toggling the mobile drawer also locks/unlocks page scroll (JS interop) — otherwise the dimmed
    // backdrop can still be scrolled, dragging the page underneath and making the open drawer look
    // "broken" mid-scroll. Best-effort: a JS failure just means scroll isn't locked; the drawer still works.
    private void ToggleMobileDrawer() => SetMobileOpen(!_mobileOpen);

    private void CloseMobileDrawer() => SetMobileOpen(false);

    private void SetMobileOpen(bool open)
    {
        _mobileOpen = open;
        _ = SetBodyScrollLockedAsync(open);
    }

    private async Task SetBodyScrollLockedAsync(bool locked)
    {
        try { await JS.InvokeVoidAsync("stallTrackSetBodyScrollLocked", locked); }
        catch { /* JS unavailable (prerender/circuit not ready) — non-critical */ }
    }

    private string NavItemClass(string href)
    {
        var active = Active(href);
        return string.IsNullOrWhiteSpace(active) ? "nav-item" : $"nav-item {active}";
    }

    // The curated destinations own their current aliases and contextual route families. Exact route-boundary
    // matching keeps similarly named routes from activating an unrelated destination.
    private string Active(string href)
    {
        var path = NormalizePath(_pendingPath ?? new Uri(Nav.Uri).AbsolutePath);
        href = NormalizePath(href);
        var active = href switch
        {
            "/overview" => path == "/" || IsRouteOrDescendant(path, "/overview") || IsRouteOrDescendant(path, "/menu"),
            "/operations" => IsRouteOrDescendant(path, "/operations") || IsRouteOrDescendant(path, "/facility"),
            "/collections/activity" => IsRouteOrDescendant(path, "/collections/activity") || IsRouteOrDescendant(path, "/transactions"),
            "/online-payments" => IsRouteOrDescendant(path, "/online-payments"),
            "/vendors" => IsRouteOrDescendant(path, "/vendors")
                || IsRouteOrDescendant(path, "/profile")
                || IsRouteOrDescendant(path, "/payor/profile"),
            "/monitoring/follow-up" => IsRouteOrDescendant(path, "/monitoring/follow-up")
                || IsRouteOrDescendant(path, "/reports/follow-up"),
            "/reports" => IsRouteOrDescendant(path, "/reports")
                && !IsRouteOrDescendant(path, "/reports/follow-up"),
            "/collectors" => IsRouteOrDescendant(path, "/collectors"),
            "/audit-trail" => IsRouteOrDescendant(path, "/audit-trail"),
            "/settings" => IsRouteOrDescendant(path, "/settings") || IsRouteOrDescendant(path, "/admin"),
            _ => IsRouteOrDescendant(path, href)
        };

        return active ? "active" : string.Empty;
    }

    private static bool IsRouteOrDescendant(string path, string route)
        => string.Equals(path, route, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);

    private static string NormalizePath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "/";

        path = path.Trim();
        if (!path.StartsWith('/'))
            path = "/" + path;

        return path.TrimEnd('/') is { Length: > 0 } trimmed ? trimmed : "/";
    }

    protected override async Task OnInitializedAsync()
    {
        // Paint with the office's own name and seal on the FIRST render, from what the prerender pass already fetched.
        // Only ask the API when nothing was carried over. Never throws: BrandingState keeps its fallbacks on a failed
        // load, so the shell is reachable even when branding is not.
        if (PersistedBranding is not null)
        {
            Branding.Apply(PersistedBranding);
        }
        else
        {
            await Branding.EnsureLoadedAsync();
            PersistedBranding = Branding.Current;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        _isHead = state.User.IsInRole("SuperAdmin")
            || state.User.Claims.Any(c =>
                string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
                && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));
        _portalLabel = _isHead ? "Head Portal" : "Admin Portal";

        if (OnlinePaymentsAwaitingOr is not null)
        {
            _onlinePaymentsAwaitingOr = OnlinePaymentsAwaitingOr.Value;
        }
        else
        {
            var awaitingOr = await OnlinePaymentsApi.GetAwaitingOrAsync();
            if (awaitingOr.IsSuccess && awaitingOr.Value is not null)
            {
                _onlinePaymentsAwaitingOr = awaitingOr.Value.Count;
                OnlinePaymentsAwaitingOr = _onlinePaymentsAwaitingOr;
            }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
