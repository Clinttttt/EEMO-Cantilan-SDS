@page "/list-stall-holders"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]

@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — @HolderTitle</PageTitle>

<OfficialRegisterPage Title="@HolderTitle" OperationName="@FacilityName" Eyebrow="@($"{FacilityCode} · {FacilityName}")"
                      DocSubtitle="@(IsSectionFiltered ? ActiveSection : null)" BackHref="@BackLink" BackName="@FacilityName" Stats="HeroStats"
                      SearchPlaceholder="@($"Search name or {HolderUnit.ToLowerInvariant()} no…")" @bind-SearchQuery="SearchQuery"
                      CsvFileName="@CsvFileName" CsvText="@CsvText">
    <Filters>
        @if (IsFacility("npm"))
        {
            @* Segmented rail, matching the reports strip and the slaughterhouse report. *@
            <div class="lsh-seg" role="group" aria-label="Market section">
                @foreach (var sec in SectionKeys)
                {
                    <button type="button" class="lsh-seg-item @(ActiveSection == sec ? "active" : "")"
                            aria-pressed="@(ActiveSection == sec ? "true" : "false")"
                            @onclick="() => ActiveSection = sec">
                        @sec
                    </button>
                }
            </div>
        }
    </Filters>
    <ChildContent>
                @if (IsFacility("npm"))
                {
                    @foreach (var sections in VisibleSections)
                    {
                        var sectionStalls = GetSectionStalls(sections).Where(MatchSearch).ToList();
                        if (!sectionStalls.Any()) continue;

                        <div class="lsh-section-block">
                            @if (!IsSectionFiltered)
                            {
                                <div class="lsh-section-label-row">
                                    <span class="lsh-section-label">@sections.ToUpper()</span>
                                    <span class="lsh-section-count">@sectionStalls.Count stall@(sectionStalls.Count != 1 ? "s" : "")</span>
                                </div>
                            }

                            <div class="lsh-table-wrap"><table class="lsh-table">
                                <thead>
                                    <tr>
                                        <th class="col-no">#</th>
                                        <th class="col-name">Name of Lessee<br /><span class="th-sub">(Actual Occupants)</span></th>
                                        <th class="col-contract">Name of Lessee per<br />Signed Contract</th>
                                        <th class="col-stall">@HolderUnit No.</th>
                                        <th class="col-date">Effectivity of<br />Lessee Contract</th>
                                        <th class="col-years">No. of<br />Years</th>
                                        <th class="col-area">Area</th>
                                        @if (IsPureDays)
                                        {
                                            <th class="col-rate">Billing<br />Basis</th>
                                            <th class="col-actual">Daily<br />Rate</th>
                                            <th class="col-whole">Fixed Annual<br />Rental</th>
                                        }
                                        else
                                        {
                                            <th class="col-rate">Monthly Rentals<br />per Contract</th>
                                            <th class="col-actual">Actual Mo.<br />Rentals</th>
                                            <th class="col-whole">Whole Year<br />Rental</th>
                                        }

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rowNum = 1;
                                    }
                                    @foreach (var s in sectionStalls)
                                    {
                                        @* A space held without a signed contract has no leasee name, effectivity,
                                           term, area or contract rate to state, so the sheet says so once across
                                           those columns and only the rent actually charged appears. Written the same
                                           way as the Stall Holder List menu sheet: the two print the same register,
                                           and this one used to state an effectivity date, "No contract" under No. of
                                           Years, and a peso figure under Monthly Rentals per Contract for a space
                                           that has no contract to carry any of them. *@
                                        var noContract = !s.HasSignedContract;
                                        <tr class="@(!s.IsActive ? "row-closed" : "")">
                                            <td class="c">@rowNum</td>
                                            <td class="tl fw @(!s.IsActive ? "txt-closed" : "")">@s.ActualOccupant</td>
                                            @if (noContract)
                                            {
                                                <td class="lsh-nc" colspan="5">@NoContractLabel(s)</td>
                                            }
                                            else
                                            {
                                                <td class="tl txt-muted">@(string.IsNullOrEmpty(s.ContractName) ? "—" : s.ContractName)</td>
                                                <td class="c">@SpaceNumber.Display(s.StallNo)</td>
                                                <td class="c">@(s.ContractDate.HasValue? s.ContractDate.Value.ToString("M/d/yyyy") : "—")</td>
                                                <td class="c">@TermLabel(s)</td>
                                                <td class="c">@(s.AreaSqm > 0 ? $"{s.AreaSqm} sq.m." : "—")</td>
                                            }
                                            @if (IsPureDays)
                                            {
                                                <td class="c">@(s.IsActive ? "Calendar-day" : "—")</td>
                                                <td class="r">@(s.IsActive ? $"₱{s.DailyRate:N2}/day" : "—")</td>
                                                <td class="r">—</td>
                                            }
                                            else
                                            {
                                                <td class="r">@(s.IsActive && !noContract ? $"₱{s.MonthlyRate:N2}" : "—")</td>
                                                <td class="r">@(s.IsActive ? $"₱{s.ActualMonthlyRental:N2}" : "—")</td>
                                                <td class="r">@(s.IsActive ? $"₱{s.WholeYearRental:N2}" : "—")</td>
                                            }

                                        </tr>
                                        rowNum++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="tfoot-row">
                                        <td colspan="7" class="tfoot-label">
                                            @* The band above already names the section and counts its stalls. *@
                                            Total
                                        </td>
                                        @if (IsPureDays)
                                        {
                                            <td class="c tfoot-val">Calendar-day</td><td class="c tfoot-val">Per stall</td><td class="r tfoot-val">—</td>
                                        }
                                        else
                                        {
                                            <td class="r tfoot-val">₱@sectionStalls.Where(s => s.IsActive).Sum(s => s.MonthlyRate).ToString("N2")</td>
                                            <td class="r tfoot-val">₱@sectionStalls.Where(s => s.IsActive).Sum(s => s.ActualMonthlyRental).ToString("N2")</td>
                                            <td class="r tfoot-val">₱@sectionStalls.Where(s => s.IsActive).Sum(s => s.WholeYearRental).ToString("N2")</td>
                                        }
                                    </tr>
                                </tfoot>
                            </table></div>
                        </div>
                    }
                }
                else
                {
                    <!-- For non-NPM facilities: Simple flat list without sections -->
                    <div class="lsh-section-block">
                        <div class="lsh-section-label-row">
                            <span class="lsh-section-label">ALL @HolderUnitPlural.ToUpperInvariant()</span>
                            <span class="lsh-section-count">@FilteredNonNpmStalls.Count() @HolderUnit.ToLowerInvariant()@(FilteredNonNpmStalls.Count() != 1 ? "s" : "")</span>
                        </div>

                        <div class="lsh-table-wrap"><table class="lsh-table">
                            <thead>
                                <tr>
                                    <th class="col-no">#</th>
                                    <th class="col-name">Name of Lessee<br /><span class="th-sub">(Actual Occupants)</span></th>
                                    <th class="col-contract">Name of Lessee per<br />Signed Contract</th>
                                    <th class="col-stall">@HolderUnit No.</th>
                                    <th class="col-date">Effectivity of<br />Lessee Contract</th>
                                    <th class="col-years">No. of<br />Years</th>
                                    <th class="col-area">Area</th>
                                    <th class="col-rate">Monthly Rentals<br />per Contract</th>
                                    <th class="col-actual">Actual Mo.<br />Rentals</th>
                                    <th class="col-whole">Whole Year<br />Rental</th>
                                    @if (IsFacility("ncc"))
                                    {
                                        <th class="col-arealoc">Area Loc.</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNum = 1;
                                }
                                @foreach (var s in FilteredNonNpmStalls)
                                {
                                    <tr class="@(!s.IsActive ? "row-closed" : "")">
                                        <td class="c">@rowNum</td>
                                        <td class="tl fw @(!s.IsActive ? "txt-closed" : "")">@s.ActualOccupant</td>
                                        <td class="tl txt-muted">@(string.IsNullOrEmpty(s.ContractName) ? "—" : s.ContractName)</td>
                                        <td class="c">@SpaceNumber.Display(s.StallNo)</td>
                                        <td class="c">@(s.ContractDate.HasValue? s.ContractDate.Value.ToString("M/d/yyyy") : "—")</td>
                                        <td class="c">@TermLabel(s)</td>
                                        <td class="c">@(s.AreaSqm > 0 ? $"{s.AreaSqm} sq.m." : "—")</td>
                                        <td class="r">@(s.IsActive ? $"₱{s.MonthlyRate:N2}" : "—")</td>
                                        <td class="r">@(s.IsActive ? $"₱{s.ActualMonthlyRental:N2}" : "—")</td>
                                        <td class="r">@(s.IsActive ? $"₱{s.WholeYearRental:N2}" : "—")</td>
                                        @if (IsFacility("ncc"))
                                        {
                                            <td class="c">@(string.IsNullOrEmpty(s.AreaLocation) ? "—" : s.AreaLocation)</td>
                                        }
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                            <tfoot>
                                <tr class="tfoot-row">
                                    <td colspan="7" class="tfoot-label">
                                        Total
                                    </td>
                                    <td class="r tfoot-val">₱@FilteredNonNpmStalls.Where(s => s.IsActive).Sum(s => s.MonthlyRate).ToString("N2")</td>
                                    <td class="r tfoot-val">₱@FilteredNonNpmStalls.Where(s => s.IsActive).Sum(s => s.ActualMonthlyRental).ToString("N2")</td>
                                    <td class="r tfoot-val">₱@FilteredNonNpmStalls.Where(s => s.IsActive).Sum(s => s.WholeYearRental).ToString("N2")</td>
                                    @if (IsFacility("ncc"))
                                    {
                                        <td></td>
                                    }
                                </tr>
                            </tfoot>
                        </table></div>
                    </div>
                }

                @if (ActiveSection == "All" || !IsFacility("npm"))
                {
                    <div class="lsh-grand-total">
                        <div class="lsh-grand-label">Grand Total — @FacilityName</div>
                        <div class="lsh-grand-stats">
                            <div class="lsh-grand-stat">
                                <div class="lsh-grand-val">@AllActiveStalls.Count()</div>
                                <div class="lsh-grand-key">Active @HolderUnitPlural</div>
                            </div>
                            @if (IsPureDays)
                            {
                                <div class="lsh-grand-stat"><div class="lsh-grand-val">Calendar-day</div><div class="lsh-grand-key">Billing Basis</div></div>
                            }
                            else
                            {
                                <div class="lsh-grand-stat">
                                    <div class="lsh-grand-val">₱@AllActiveStalls.Sum(s => s.MonthlyRate).ToString("N2")</div>
                                    <div class="lsh-grand-key">Total Monthly Rate</div>
                                </div>
                                <div class="lsh-grand-stat">
                                    <div class="lsh-grand-val">₱@AllActiveStalls.Sum(s => s.WholeYearRental).ToString("N2")</div>
                                    <div class="lsh-grand-key">Total Whole Year Rental</div>
                                </div>
                            }
                        </div>
                    </div>
                }

    </ChildContent>
</OfficialRegisterPage>

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Facility { get; set; }
    private string HolderUnit => FacilityCatalog.HolderUnitFor(Facility);
    private string HolderUnitPlural => HolderUnit + "s";
    private string HolderTitle => $"{HolderUnit} Holder List";

    string SearchQuery = string.Empty;
    string ActiveSection = "All";
    bool IsLoading = true;

    // Canonical section chips plus any per-LGU custom sections present in the loaded roster.
    string[] SectionKeys => new[] { "All" }.Concat(PresentSections).ToArray();

    // Section names present in this facility's roster, in the order the API returns them (canonical first,
    // then any per-LGU custom sections). Fully data-driven: the API already resolves each section's display
    // label (the tenant's own name, e.g. "Gulayan", or the canonical "Vegetable Area"), so nothing here is
    // hardcoded. Distinct() over the in-order list preserves first-appearance (server) order.
    IEnumerable<string> PresentSections => Stalls
        .Where(s => s.Facility == (Facility?.ToLower() ?? "npm") && !string.IsNullOrWhiteSpace(s.Section))
        .Select(s => s.Section)
        .Distinct();

    // Facility detection
    string FacilityCode => Facility?.ToUpper() ?? "NPM";
    string BackLink => $"/facility/{FacilityCatalog.SlugOf(ParsedCode)}";

    // Parse the ?facility= slug to a code (handles the 8 canonical AND custom1..5); falls back to NPM.
    private Domain.Enums.FacilityCode ParsedCode =>
        System.Enum.TryParse<Domain.Enums.FacilityCode>(Facility ?? "NPM", true, out var c) ? c : Domain.Enums.FacilityCode.NPM;

    string FacilityName => FacilityCatalog.NameOf(ParsedCode);

    bool IsFacility(string code) => Facility?.ToLower() == code || (string.IsNullOrEmpty(Facility) && code == "npm");

    /// <summary>True when the roster is narrowed to one market section (NPM only).</summary>
    bool IsSectionFiltered => IsFacility("npm") && ActiveSection != "All";

    IReadOnlyList<OfficialRegisterPage.Stat> HeroStats
    {
        get
        {
            var stats = new List<OfficialRegisterPage.Stat> { new(AllActiveStalls.Count().ToString(), $"Total {HolderUnitPlural}") };
            if (IsFacility("npm"))
                foreach (var sec in PresentSections) stats.Add(new(GetSectionStalls(sec).Count().ToString(), sec));
            return stats;
        }
    }

    string CsvFileName =>
        $"stallholders_{(Facility?.ToLower() ?? "npm")}{(IsSectionFiltered ? "_" + ActiveSection.Replace(' ', '-').ToLower() : "")}_{PhilippineTime.Now:yyyy-MM-dd}.csv";

    /// <summary>
    /// The roster as CSV, in the same column order as the printed form and honouring the current section
    /// filter and search. Closed rows carry no figures on the sheet, so they carry none here either.
    /// </summary>
    string CsvText
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(IsPureDays
                ? $"Section,Name of Lessee (Actual Occupant),Name on Signed Contract,{HolderUnit} No.,Effectivity,No. of Years,Area (sq.m),Billing Basis,Daily Rate,Fixed Annual Rental"
                : $"Section,Name of Lessee (Actual Occupant),Name on Signed Contract,{HolderUnit} No.,Effectivity,No. of Years,Area (sq.m),Monthly Rental,Actual Monthly Rental,Whole Year Rental");

            void AppendRows(string sectionName, IEnumerable<NpmStall> rows)
            {
                foreach (var s in rows)
                {
                    sb.AppendLine(string.Join(',', new[]
                    {
                        Csv(sectionName),
                        Csv(s.ActualOccupant),
                        // The contract columns are left empty where there is no contract, matching the sheet, so the
                        // exported file cannot state a contract rate the printed register says does not exist.
                        Csv(s.HasSignedContract ? s.ContractName : NoContractLabel(s)),
                        Csv(s.StallNo),
                        Csv(s.HasSignedContract ? s.ContractDate?.ToString("M/d/yyyy") ?? "" : ""),
                        Csv(s.HasSignedContract && s.DurationYears > 0 ? s.DurationYears.ToString() : ""),
                        Csv(s.HasSignedContract && s.AreaSqm > 0 ? s.AreaSqm.ToString("0.##") : ""),
                        Csv(IsPureDays && s.IsActive ? "Calendar-day" : s.IsActive && s.HasSignedContract ? s.MonthlyRate.ToString("0.00") : ""),
                        Csv(IsPureDays && s.IsActive ? s.DailyRate.ToString("0.00") : s.IsActive ? s.ActualMonthlyRental.ToString("0.00") : ""),
                        Csv(IsPureDays ? "" : s.IsActive ? s.WholeYearRental.ToString("0.00") : "")
                    }));
                }
            }

            if (IsFacility("npm"))
                foreach (var section in VisibleSections)
                    AppendRows(section, GetSectionStalls(section).Where(MatchSearch));
            else
                AppendRows(FacilityName, FilteredNonNpmStalls);

            return sb.ToString();
        }
    }

    /// <summary>
    /// The term column. A space let without a signed contract has no term to print — the office's sheet says so
    /// instead — and a recorded term is stated as it stands rather than as a fixed three years.
    /// </summary>
    static string TermLabel(NpmStall s) =>
        !s.HasSignedContract ? "No contract"
        : s.DurationYears > 0 ? $"{s.DurationYears} yr{(s.DurationYears == 1 ? "" : "s")}"
        : "—";

    /// <summary>
    /// What the office writes where a signed contract would be named. Kept word-for-word the same as the Stall Holder
    /// List menu sheet: the two print the same register, and reading "No contract" in one column here beside
    /// "No contract (extension)" spanning the contract columns there made the same space look like two arrangements.
    /// An extension names the facility it extends, in that LGU's own short name.
    /// </summary>
    private string NoContractLabel(NpmStall s)
    {
        var facility = ResolvedFacilityCode;
        return s.Arrangement switch
        {
            OccupancyArrangement.Extension when facility is { } code
                => $"No contract (Extension {FacilityCatalog.ShortNameOf(code)})",
            OccupancyArrangement.Extension => "No contract (extension)",
            _ => "No contract (space only)",
        };
    }

    /// <summary>This sheet's facility, where the query string names one the tenant actually has.</summary>
    private FacilityCode? ResolvedFacilityCode =>
        Enum.TryParse<FacilityCode>(Facility, ignoreCase: true, out var code) ? code : null;

    // The shared rule: quotes per RFC 4180 AND neutralises a cell Excel would run as a formula.
    static string Csv(string value) => CsvCell.Escape(value);

    IEnumerable<string> VisibleSections => ActiveSection == "All"
        ? PresentSections
        : new[] { ActiveSection };

    IEnumerable<NpmStall> GetSectionStalls(string sec) =>
        Stalls.Where(s => s.Facility == (Facility?.ToLower() ?? "npm") && s.Section == sec).OrderBy(s => s.StallNo);

    IEnumerable<NpmStall> AllActiveStalls => Stalls.Where(s => s.Facility == (Facility?.ToLower() ?? "npm") && s.IsActive);

    IEnumerable<NpmStall> FilteredNonNpmStalls => Stalls.Where(s => s.Facility == (Facility?.ToLower() ?? "npm") && MatchSearch(s)).OrderBy(s => s.StallNo);

    bool MatchSearch(NpmStall s) =>
        string.IsNullOrWhiteSpace(SearchQuery) ||
        s.ActualOccupant.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
        s.ContractName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
        s.StallNo.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase);

    public sealed class NpmStall
    {
        public int Id { get; set; }
        public string Facility { get; set; } = "npm";
        public string StallNo { get; set; } = string.Empty;
        public string Section { get; set; } = string.Empty;
        public string ActualOccupant { get; set; } = string.Empty;
        public string ContractName { get; set; } = string.Empty;
        public double AreaSqm { get; set; }
        public DateTime? ContractDate { get; set; }
        // The term as recorded, and whether there is a signed contract at all. The sheet used to print "3 yrs"
        // against every row, which was one facility's usual term stated as fact for all of them — and printed a
        // term for spaces let without a contract, which have none.
        public int DurationYears { get; set; }
        public bool HasSignedContract { get; set; } = true;
        /// <summary>How the space is held where there is no signed contract — an extension of another facility, or
        /// the space alone. Decides the wording the office's own sheet prints across the contract columns.</summary>
        public OccupancyArrangement Arrangement { get; set; }
        // Always assigned from the API row below. No hardcoded default: a fallback figure here would be
        // one municipality's rate shown to every other one.
        public decimal MonthlyRate { get; set; }
        // Fixed-rent values as the API derives them. RentGoal NPM uses the configured monthly obligation; PureDays
        // returns zero because no month-independent rent or annual monthly-times-twelve amount exists.
        public decimal ActualMonthlyRental { get; set; }
        public decimal WholeYearRental { get; set; }
        public decimal DailyRate { get; set; }
        public bool IsPaid { get; set; }
        public bool IsPartial { get; set; }
        public decimal PartialAmount { get; set; }
        public bool IsActive { get; set; } = true;
        public string ORNumber { get; set; } = string.Empty;
        public decimal FishKilos { get; set; }
        public string? AreaLocation { get; set; }
    }

    List<NpmStall> Stalls = new();
    private NpmMonthBasis MonthBasis = NpmMonthBasis.RentGoal;
    private bool IsPureDays => IsFacility("npm") && MonthBasis == NpmMonthBasis.PureDays;

    [PersistentState(AllowUpdates = true)]
    public StallHoldersListPageState? CachedStalls { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        var facility = Facility?.ToLower() ?? "npm";
        if (CachedStalls is { } state && state.Facility == facility)
        {
            Stalls = state.Stalls.ToList();
            MonthBasis = state.MonthBasis;
            IsLoading = false;
            return;
        }

        await LoadStallsFromApi();
    }

    private async Task LoadStallsFromApi()
    {
        IsLoading = true;

        var result = await StallsApi.GetStallHoldersListAsync(ParsedCode, null, null);
        
        if (result.IsSuccess && result.Value != null)
        {
            MonthBasis = result.Value.MonthBasis;
            Stalls.Clear();
            int id = 1;
            
            foreach (var section in result.Value.Sections)
            {
                foreach (var row in section.Rows)
                {
                    // The API already resolves each section's display label (tenant's own name or the
                    // canonical "Vegetable Area"/…), so use it as-is — no client-side enum mapping.
                    var sectionName = section.SectionName;

                    Stalls.Add(new NpmStall
                    {
                        Id = id++,
                        Facility = Facility?.ToLower() ?? "npm",
                        StallNo = row.StallNo,
                        Section = sectionName,
                        ActualOccupant = row.ActualOccupant,
                        ContractName = row.NameOnContract,
                        AreaSqm = row.AreaSqm ?? 0,
                        ContractDate = row.EffectivityDate == default ? null : row.EffectivityDate.ToDateTime(TimeOnly.MinValue),
                        DurationYears = row.DurationYears,
                        HasSignedContract = row.HasSignedContract,
                        Arrangement = row.Arrangement,
                        MonthlyRate = row.MonthlyRentalRate,
                        ActualMonthlyRental = row.ActualMonthlyRental,
                        WholeYearRental = row.WholeYearRental,
                        DailyRate = row.DailyRate,
                        IsActive = !row.IsClosed,
                        FishKilos = row.FishFeeTotal ?? 0,
                        AreaLocation = row.AreaLocation
                    });
                }
            }
        }

        CachedStalls = new StallHoldersListPageState(Facility?.ToLower() ?? "npm", Stalls.ToList(), MonthBasis);
        IsLoading = false;
    }

    public sealed record StallHoldersListPageState(
        string Facility,
        List<NpmStall> Stalls,
        NpmMonthBasis MonthBasis = NpmMonthBasis.RentGoal);
}
