@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Common.Slaughterhouse
@using EEMOCantilanSDS.Application.Dtos.Slaughterhouse
@inject ISlaughterApiClient SlaughterApi

@* Head/Admin approval of the custom animals a collector may record (IA-050). While Slaughterhouse is collected by approved charges the
   charges set the fee and this list is only which animals may be recorded; otherwise each animal carries its per-head rate. A change
   applies to new transactions only; recorded transactions keep the rate they were charged. *@
<section class="v3-panel saa" aria-labelledby="saa-title" aria-busy="@(_loading ? "true" : "false")">
    <header class="v3-panel-header">
        <h2 id="saa-title">@(_itemized ? "Approved animals" : "Approved animals and rates")</h2>
        <span class="saa-count">@_animals.Count(a => a.IsActive)</span>
    </header>
    @if (_error is not null)
    {
        <p class="v3-notice v3-notice-error saa-error" role="alert">@_error</p>
    }
    <ul class="saa-list" aria-label="Approved animals">
        @foreach (var animal in _animals)
        {
            <li @key="animal.Id" class="@(animal.IsActive ? null : "is-retired")">
                <span class="saa-name">@animal.AnimalName</span>
                @if (!_itemized)
                {
                    <span class="saa-rate">@(animal.RatePerHead > 0m ? "₱" + animal.RatePerHead.ToString("N2") + " / head" : "—")</span>
                }
                <span class="saa-status @(animal.IsActive ? "is-on" : null)">@(animal.IsActive ? "Approved" : "Retired")</span>
                <button class="v3-btn v3-btn-sm" type="button" @onclick="() => ToggleAsync(animal)">@(animal.IsActive ? "Retire" : "Re-approve")</button>
            </li>
        }
        @if (_animals.Count == 0)
        {
            <li class="saa-empty">@(_loading ? "Loading…" : "No other animal has been approved yet.")</li>
        }
    </ul>
    <form class="saa-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-label="Approve an animal">
        <label class="v3-field"><span class="v3-sr-only">Animal</span>
            <input class="v3-input" type="text" maxlength="60" required placeholder="Animal, e.g. Goat" @bind="_name" /></label>
        @if (!_itemized)
        {
            <label class="v3-field"><span class="v3-sr-only">Rate per head (₱)</span>
                <input class="v3-input" type="number" min="0.01" step="0.01" required placeholder="Rate per head (₱)" @bind="_rate" /></label>
        }
        <button class="v3-btn v3-btn-primary" type="submit" disabled="@_saving">@(_itemized ? "Approve" : "Approve or update")</button>
    </form>
</section>


@code {
    private List<SlaughterAnimalRateDto> _animals = [];
    private bool _loading;
    private bool _saving;
    private bool _loaded;
    private string? _error;
    private string _name = string.Empty;
    private decimal? _rate;
    private bool _itemized;

    /// <summary>Raised after an approval changes so the parent can refresh what a collector is offered.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    // The panel is always open now, so it loads with the page (two reads: the collection basis and the animals).
    protected override Task OnInitializedAsync() => OnToggleAsync();

    private async Task OnToggleAsync()
    {
        if (_loaded) return;
        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var terms = await SlaughterApi.GetOfficeTermsAsync(DateOnly.FromDateTime(PhilippineTime.Now));
            _itemized = terms is { IsSuccess: true, Value: { Itemized: true } };
            var result = await SlaughterApi.GetAnimalRatesAsync(activeOnly: false);
            if (result.IsSuccess) _animals = result.Value?.OrderBy(x => x.AnimalName, StringComparer.OrdinalIgnoreCase).ToList() ?? [];
            else _error = "The approved animals couldn't be loaded.";
        }
        catch { _error = "The approved animals couldn't be loaded."; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_saving || (!_itemized && _rate is not > 0m)) return;
        _saving = true;
        _error = null;
        try
        {
            var result = await SlaughterApi.SaveApprovedAnimalAsync(new SaveApprovedSlaughterAnimalRequest(_name, _itemized ? null : _rate));
            if (!result.IsSuccess) { _error = result.Error ?? "The animal could not be saved."; return; }
            _name = string.Empty;
            _rate = null;
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ToggleAsync(SlaughterAnimalRateDto animal)
    {
        _error = null;
        var result = await SlaughterApi.SetApprovedAnimalActiveAsync(animal.Id, !animal.IsActive);
        if (!result.IsSuccess) { _error = result.Error ?? "The change could not be saved."; return; }
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }
}
