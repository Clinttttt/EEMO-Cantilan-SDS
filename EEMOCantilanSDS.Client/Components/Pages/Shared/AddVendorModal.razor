@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@using EEMOCantilanSDS.Client.Services

@* ══════════════════════════════════════════════════════════════════════
   AddVendorModal.razor  —  Shared reusable Add / Edit Vendor Modal

   USAGE — Vendors page (facility dropdown is open):
       <AddVendorModal Show="ShowModal"
                       IsEditing="IsEditing"
                       Form="Form"
                       FormError="FormError"
                       FacilityOptions="FacilityTabsAsOptions()"
                       FacilityLocked="false"
                       OnSave="SaveVendor"
                       OnCancel="CloseModal"
                       OnFacilityChanged="OnFacilityChanged"
                       OnSectionChanged="OnSectionChanged"
                       OnToggleFee="ToggleFee" />

   USAGE — Facility page e.g. NPM (facility is fixed / locked):
       <AddVendorModal Show="ShowAddModal"
                       IsEditing="false"
                       Form="AddForm"
                       FormError="AddFormError"
                       FacilityOptions='new(){ new(){ Code="NPM", Name="New Public Market" } }'
                       FacilityLocked="true"
                       OnSave="SaveNewVendor"
                       OnCancel="CloseAddModal"
                       OnFacilityChanged="OnFacilityChanged"
                       OnSectionChanged="OnSectionChanged"
                       OnToggleFee="ToggleFee" />

   PARAMETERS:
     Show              – bool        – controls visibility
     IsEditing         – bool        – true = edit mode, false = add mode
     Form              – VendorModalForm  – two-way bound form data
     FormError         – string      – validation message shown in red
     FacilityOptions   – List<VendorFacilityOption> – dropdown items
     FacilityLocked    – bool        – true = read-only facility label (facility page)
                                       false = full dropdown (vendors page)
     OnSave            – EventCallback      – Save / Add Vendor clicked
     OnCancel          – EventCallback      – Cancel or ✕ clicked
     OnFacilityChanged – EventCallback      – facility select changed
     OnSectionChanged  – EventCallback      – section select changed
     OnToggleFee       – EventCallback<string> – fee toggle clicked (fee name passed)
══════════════════════════════════════════════════════════════════════ *@

<div class="eemo-drawer-overlay @(Show ? "show" : "")" @onclick="HandleCancel"></div>

<div class="eemo-drawer eemo-drawer-right @(Show ? "show" : "")" @onclick:stopPropagation="true">

            <!-- ── Header ──────────────────────────────────────────────── -->
            <div class="eemo-drawer-header">
                <div class="eemo-drawer-header-left">
                    <div class="eemo-drawer-header-icon">
                        <svg viewBox="0 0 24 24">
                            @if (IsEditing)
                            {
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                            }
                            else
                            {
                                <path d="M9 11l3 3L22 4"/>
                                <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                            }
                        </svg>
                    </div>
                    <div>
                        <div class="eemo-drawer-header-title">@(IsEditing ? "Edit Vendor / Stall" : "Add New Vendor")</div>
                        <div class="eemo-drawer-header-sub">@(IsEditing ? "Update vendor and stall information." : "Register a new stall vendor in the system.")</div>
                    </div>
                </div>
                <button class="eemo-drawer-header-close" @onclick="HandleCancel" aria-label="Close">
                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>

            <!-- ── Body ───────────────────────────────────────────────── -->
            <div class="eemo-modal-body">

                <!-- §1 Leasee Information -->
                <div class="avm-section">
                    <div class="avm-section-label">Leasee Information</div>

                    @* How the space is held. The office's registers record three kinds, and the two without a signed
                       contract have no leasee name, term or contract rate to state — asking for them would invite a
                       clerk to invent particulars the office does not hold. *@
                    <div class="avm-group">
                        <label class="avm-label">Basis of Occupancy <span class="avm-req">*</span></label>
                        <div class="avm-choice" role="radiogroup" aria-label="Basis of occupancy">
                            @foreach (var option in ArrangementOptions)
                            {
                                <button type="button"
                                        class="avm-choice-item @(Form.Arrangement == option.Value ? "is-selected" : "")"
                                        role="radio"
                                        aria-checked="@(Form.Arrangement == option.Value)"
                                        @onclick="() => SelectArrangement(option.Value)">
                                    <span class="avm-choice-title">@option.Title</span>
                                    <span class="avm-choice-note">@option.Note</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="avm-row-2">
                        <div class="avm-group">
                            <label class="avm-label">Actual Occupant (Leasee) <span class="avm-req">*</span></label>
                            <input class="avm-input @(GetFieldError("ActualOccupant") != string.Empty ? "form-input-error" : "")" type="text" placeholder="Current stall occupant"
                                   @bind="Form.ActualOccupant" @bind:event="oninput" />
                            @if (GetFieldError("ActualOccupant") != string.Empty)
                            {
                                <span class="form-error">@GetFieldError("ActualOccupant")</span>
                            }
                        </div>
                        @if (Form.HasSignedContract)
                        {
                            <div class="avm-group">
                                <label class="avm-label">Name on Contract (Per Signed Contract)</label>
                                <input class="avm-input @(GetFieldError("NameOnContract") != string.Empty ? "form-input-error" : "")" type="text" placeholder="As written on the signed contract"
                                       @bind="Form.ContractName" @bind:event="oninput" />
                                @if (GetFieldError("NameOnContract") != string.Empty)
                                {
                                    <span class="form-error">@GetFieldError("NameOnContract")</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label">Name on Contract (Per Signed Contract)</label>
                                <div class="avm-input avm-input-locked">@NoContractText</div>
                                <span class="avm-hint">Printed in this column on the official list.</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- §2 Space & Contract Details -->
                <div class="avm-section">
                    <div class="avm-section-label">Space &amp; Contract Details</div>

                    <div class="avm-row-2">
                        <!-- Facility: locked read-only OR full dropdown -->
                        <div class="avm-group">
                            <label class="avm-label">Facility <span class="avm-req">*</span></label>
                            @if (FacilityLocked)
                            {
                                <div class="avm-input avm-input-locked">
                                    @(FacilityOptions.FirstOrDefault()?.Name ?? Form.FacilityCode)
                                </div>
                            }
                            else
                            {
                                <select class="avm-input"
                                        @bind="Form.FacilityCode"
                                        @bind:after="HandleFacilityChanged">
                                    <option value="">-- Select Facility --</option>
                                    @foreach (var f in FacilityOptions)
                                    {
                                        <option value="@f.Code">@f.Name</option>
                                    }
                                </select>
                            }
                        </div>

                        <div class="avm-group">
                            @if (Form.HasSignedContract)
                            {
                                <label class="avm-label">Stall / Space No. <span class="avm-req">*</span></label>
                                <input class="avm-input @(GetFieldError("StallNo") != string.Empty ? "form-input-error" : "")" type="text" placeholder="e.g. 01, T4, B-02"
                                       @bind="Form.StallNo" @bind:event="oninput" />
                                @if (GetFieldError("StallNo") != string.Empty)
                                {
                                    <span class="form-error">@GetFieldError("StallNo")</span>
                                }
                                else if (!IsEditing && !string.IsNullOrEmpty(_lastSuggested) && Form.StallNo == _lastSuggested)
                                {
                                    <span class="avm-hint-muted">Auto-suggested next number — you can edit it.</span>
                                }
                            }
                            else
                            {
                                @* The office does not number a space held without a signed contract: its own list
                                   leaves the column blank and identifies the occupancy by the lessee. So the clerk is
                                   not asked for a number, and none is taken from the facility's numbering — recording
                                   such a space as stall 4 left the actual stall 4 unregisterable. It carries an
                                   identifier of its own instead, shown here so the record is not silent about it. *@
                                <label class="avm-label">Space No.</label>
                                @* A dash, not the identifier: the office does not number these, and the note below
                                   says so. The identifier is still assigned behind this and still keys the record. *@
                                <div class="avm-readonly">—</div>
                                <span class="avm-hint-muted">No stall number is issued for these.</span>
                            }
                        </div>
                    </div>

                    <!-- Section dropdown — NPM only -->
                    @if (Form.FacilityCode == "NPM")
                    {
                        <div class="avm-row-2">
                            <div class="avm-group">
                                <label class="avm-label">Section / Category <span class="avm-req">*</span></label>
                                <FhSelect Block="true" Caption="" Value="@Form.SelectedSection"
                                          Options="SectionOptions" ValueChanged="OnSectionSelected" />
                                @if (GetFieldError("Section") != string.Empty)
                                {
                                    <span class="form-error">@GetFieldError("Section")</span>
                                }
                            </div>
                            <div class="avm-group">
                                @if (Form.SelectedSection == "__custom__")
                                {
                                    <label class="avm-label">Custom section name <span class="avm-req">*</span></label>
                                    <input class="avm-input" maxlength="60" placeholder="e.g. Sari-sari Area"
                                           @bind="Form.CustomSectionName" @bind:event="oninput" />
                                    @if (GetFieldError("CustomSectionName") != string.Empty)
                                    {
                                        <span class="form-error">@GetFieldError("CustomSectionName")</span>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <div class="avm-row-2">
                        <div class="avm-group">
                            @* Billing needs a start date whether or not a contract exists — it is the first month the
                               office may charge for. Only the wording differs: a space-only occupancy has no contract
                               to take effect, so the sheet leaves that column blank and this asks when they moved in. *@
                            <label class="avm-label">
                                @(Form.HasSignedContract ? "Contract Effectivity Date" : "Occupying Since")
                                <span class="avm-req">*</span>
                            </label>
                            @if (IsEditing)
                            {
                                <div class="avm-input avm-input-locked">@(Form.ContractDate?.ToString("MMMM d, yyyy") ?? "—")</div>
                            }
                            else
                            {
                                <input class="avm-input" type="date" @bind="Form.ContractDate" />
                            }
                            @if (!Form.HasSignedContract)
                            {
                                <span class="avm-hint">From this date rent is assessed. It is not printed as a contract effectivity.</span>
                            }
                        </div>
                        @if (Form.HasSignedContract)
                        {
                            <div class="avm-group">
                                <label class="avm-label">Contract Duration (No. of Years)</label>
                                @if (IsEditing)
                                {
                                    <div class="avm-input avm-input-locked">@(Form.ContractYears > 0 ? $"{Form.ContractYears} year{(Form.ContractYears > 1 ? "s" : "")}" : "No contract")</div>
                                }
                                else
                                {
                                    <FhSelect Block="true" Caption="" Value="@(_customYears ? "custom" : Form.ContractYears.ToString())"
                                              Options="ContractYearOptions" ValueChanged="OnContractYearsSelected" />
                                    @if (_customYears)
                                    {
                                        <input class="avm-input" style="margin-top:8px;" type="number" min="1" max="10" step="1"
                                               placeholder="Enter years (1–10)" @bind="Form.ContractYears" @bind:event="oninput" />
                                        <span class="avm-hint-muted">Custom contract term — 1 to 10 years.</span>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label">Contract Duration (No. of Years)</label>
                                <div class="avm-input avm-input-locked">Open-ended</div>
                                <span class="avm-hint">No term to expire, so this occupancy never falls due for renewal.</span>
                            </div>
                        }
                    </div>
                    @if (IsEditing)
                    {
                        <div class="avm-section-note">Contract effectivity and duration are set at registration — they define the billing history and aren't editable here.</div>
                    }
                </div>

                <!-- §3 Space Information -->
                <div class="avm-section">
                    <div class="avm-section-label">Space Information</div>
                    <div class="avm-row-2">
                        <div class="avm-group">
                            <label class="avm-label">Area (sq.m)</label>
                            <input class="avm-input" type="number" min="0" placeholder="e.g. 4.8"
                                   @bind="Form.AreaSqm" @bind:event="oninput" />
                        </div>
                        <div class="avm-group" style="visibility:hidden;"></div>
                    </div>
                </div>

                <!-- §4 Rental Rates -->
                <div class="avm-section">
                    <div class="avm-section-label">
                        @if (Form.FacilityCode == "SLH")
                        {
                            <text>Fixed Charges</text>
                        }
                        else
                        {

                            <text>Rental Rates</text>
                        }
                    </div>

                    @if (Form.FacilityCode == "SLH")
                    {
                        <div class="avm-info-box">
                            <div class="avm-info-box-title"><strong>Per Head Charges:</strong></div>
                            <div class="avm-info-box-grid">
                                <div>• Slaughter Fee</div><div>• Ante Mortem</div>
                                <div>• Post Mortem</div><div>• Table Charge</div>
                                <div>• Entrance Fee</div><div>• Livestock Fee</div>
                            </div>
                            <div class="avm-info-box-hint">These are fixed per-head charges for slaughterhouse</div>
                        </div>
                    }
                    else
                    {
                        <div class="avm-row-2">
                            <div class="avm-group">
                                <label class="avm-label">Monthly Rental / Rate (₱) <span class="avm-req">*</span></label>
                                <input class="avm-input" type="number" min="0" placeholder="e.g. 900"
                                       @bind="Form.MonthlyRate" @bind:event="oninput" @bind:after="MonthlyRentEntered" />
                                <div class="avm-hint-muted">Whole Year: ₱@Form.WholeYearRental.ToString("N0")</div>
                            </div>
                            <div class="avm-group" style="visibility:hidden;"></div>
                        </div>
                    }

                    @* The applicable-charges block below already states every fee this stall carries, with the
                       tenant's own rates, so these standalone reminders only repeated it. *@
                    @if (Form.FacilityCode == "NPM"
                        && (Form.SelectedSection == "__custom__"
                            || (Form.SelectedSection != null && Form.SelectedSection.StartsWith("existing:", StringComparison.Ordinal))))
                    {
                        <div class="avm-row-2">
                            <div class="avm-group">
                                <label class="avm-label">Daily fee rate (₱/day) <span class="avm-req">*</span></label>
                                <input class="avm-input" type="number" min="1" step="0.01" placeholder="e.g. 30"
                                       @bind="Form.CustomDailyRate" @bind:event="oninput" />
                                @if (_dailyFromMonthlyRent is { } fromRent && Form.CustomDailyRate == fromRent)
                                {
                                    <div class="avm-hint-muted">From ₱@Form.MonthlyRate.ToString("N0") a month, to the nearest peso.</div>
                                }
                                <div class="avm-hint-muted">This custom section bills this flat daily fee — no fish/weight. Enable Electricity &amp; Water below if the section is metered.</div>
                                @if (GetFieldError("CustomDailyRate") != string.Empty)
                                {
                                    <span class="form-error">@GetFieldError("CustomDailyRate")</span>
                                }
                            </div>
                            <div class="avm-group" style="visibility:hidden;"></div>
                        </div>
                    }
                </div>

                <!-- §5 Additional Information -->
                <div class="avm-section">
                    <div class="avm-section-label">Additional Information</div>
                    <div class="avm-row-2">
                        @if (Form.FacilityCode == "NCC")
                        {
                            <div class="avm-group">
                                <label class="avm-label">Area Location</label>
                                <input class="avm-input @(GetFieldError("AreaLocation") != string.Empty ? "form-input-error" : "")"
                                       type="text" list="avm-ncc-areas" maxlength="60" autocomplete="off"
                                       placeholder="e.g. Extension, Corner, or your area name"
                                       @bind="Form.AreaLocation" @bind:event="oninput" />
                                <datalist id="avm-ncc-areas">
                                    <option value="Extension" />
                                    <option value="Corner" />
                                    <option value="Standard" />
                                </datalist>
                                @if (GetFieldError("AreaLocation") != string.Empty)
                                {
                                    <span class="form-error">@GetFieldError("AreaLocation")</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label">Area Location / Note</label>
                                <input class="avm-input" type="text" placeholder="e.g. Extension, Corner"
                                       @bind="Form.AreaLocation" @bind:event="oninput" />
                            </div>
                        }
                    </div>
                </div>

                <!-- §6 Applicable Charges — hidden for SLH -->
                @if (!string.IsNullOrEmpty(Form.FacilityCode) && Form.FacilityCode != "SLH")
                {
                    <div class="avm-section">

                        <div class="avm-divider-header">
                            <div class="avm-divider-line"></div>
                            <span class="avm-divider-text">Applicable Charges</span>
                            <div class="avm-divider-line"></div>
                        </div>

                        <!-- Base Rental card -->
                        <div class="avm-sublabel">Base Rental</div>
                        <div class="avm-rental-card">
                            <div class="avm-rental-info">
                                <div class="avm-rental-icon">
                                    @* The facility's own mark, so the charge is visibly attributed to the
                                       facility being billed. An LGU-defined facility has no artwork of its own
                                       and keeps the neutral building glyph — written here as markup, so this
                                       component's own styles reach it. *@
                                    @if (RentalFacilityMark is { } markCode && FacilityMarkArt.Has(markCode))
                                    {
                                        <FacilityMark Code="@markCode" Size="17" />
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24">
                                            <rect x="3" y="9" width="18" height="12" rx="2" />
                                            <path d="M3 9l9-6 9 6" />
                                            <line x1="9" y1="21" x2="9" y2="13" />
                                            <line x1="15" y1="21" x2="15" y2="13" />
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <div class="avm-rental-title">Monthly Rental</div>
                                    <div class="avm-rental-sub">
                                        @if (Form.FacilityCode == "NPM")
                                        {
                                            <text>New Public Market · ₱@NpmDailyRate.ToString("0")/day base</text>
                                        }
                                        else
                                        {
                                            @(FacilityOptions.FirstOrDefault(f => f.Code == Form.FacilityCode)?.Name ?? Form.FacilityCode)
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- ± Spinner -->
                            <div class="avm-spinner">
                                <button type="button" class="avm-spin-btn avm-spin-left"
                                        @onclick="() => { if (Form.MonthlyRate >= 100) Form.MonthlyRate -= 100; }">
                                    −
                                </button>
                                <div class="avm-spin-inner">
                                    <span class="avm-spin-currency">₱</span>
                                    <input type="number" min="0" class="avm-spin-input"
                                           @bind="Form.MonthlyRate" @bind:event="oninput" @bind:after="MonthlyRentEntered" />
                                    <span class="avm-spin-freq">/mo</span>
                                </div>
                                <button type="button" class="avm-spin-btn avm-spin-right"
                                        @onclick="() => Form.MonthlyRate += 100">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Whole-year hint -->
                        <div class="avm-yearly-hint">
                            <span class="avm-yearly-label">Whole-year equivalent</span>
                            <strong class="avm-yearly-value">₱@Form.WholeYearRental.ToString("N2")</strong>
                        </div>

                        <!-- Utility charges — NPM only -->
                        @if (Form.FacilityCode == "NPM")
                        {
                            @if (!string.IsNullOrEmpty(Form.SelectedSection))
                            {
                                <div class="avm-util-divider"></div>
                                <div class="avm-sublabel">Utility Charges</div>

                                @* A space with no meters has no utility charges to show. Stating that — rather than
                                   presenting two empty boxes — keeps the form an account of what this payor is billed
                                   for, while still allowing the office to add a charge when a meter is installed.
                                   Choosing to add one opens the two controls; ticking one and saving is what puts the
                                   charge on the stall, which is then what the meter-reading dialog offers. *@
                                @if (IsEditing && !_showUtilityCharges && !Form.FeeTypes.Contains("Electricity") && !Form.FeeTypes.Contains("Water"))
                                {
                                    <div class="avm-util-none">
                                        <span>No utility charges on this space.</span>
                                        <button type="button" class="avm-util-add" @onclick="() => _showUtilityCharges = true">Add a utility charge</button>
                                    </div>
                                }
                                else
                                {
                                @if (IsEditing && _showUtilityCharges && !Form.FeeTypes.Contains("Electricity") && !Form.FeeTypes.Contains("Water"))
                                {
                                    <div class="avm-section-note">Tick the service this space is metered for, then save. Nothing is charged until you do.</div>
                                }
                                @* Each service is one control, and a control must answer to the keyboard: a button
                                   with aria-pressed, so Tab reaches it and Space/Enter toggles it. It was a div
                                   with a click handler and a checkbox held out of the tab order, which left the
                                   whole "add a utility charge" flow impossible without a mouse. *@
                                <!-- Electricity -->
                                <button type="button" class="avm-fee-toggle @(Form.FeeTypes.Contains("Electricity") ? "active" : "")"
                                        aria-pressed="@(Form.FeeTypes.Contains("Electricity") ? "true" : "false")"
                                        @onclick='() => HandleToggleFee("Electricity")' @onclick:stopPropagation="true">
                                    <span class="avm-fee-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                                        </svg>
                                    </span>
                                    <span class="avm-fee-text">
                                        <span class="avm-fee-title">Electricity</span>
                                        <span class="avm-fee-sub">Monthly billing — amount varies per reading</span>
                                    </span>
                                    <span class="avm-fee-mark" aria-hidden="true">
                                        @if (Form.FeeTypes.Contains("Electricity"))
                                        {
                                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                                        }
                                    </span>
                                </button>

                                <!-- Water -->
                                <button type="button" class="avm-fee-toggle avm-fee-toggle-water @(Form.FeeTypes.Contains("Water") ? "active" : "")"
                                        aria-pressed="@(Form.FeeTypes.Contains("Water") ? "true" : "false")"
                                        @onclick='() => HandleToggleFee("Water")' @onclick:stopPropagation="true">
                                    <span class="avm-fee-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                                        </svg>
                                    </span>
                                    <span class="avm-fee-text">
                                        <span class="avm-fee-title">Water</span>
                                        <span class="avm-fee-sub">Monthly billing — amount varies per reading</span>
                                    </span>
                                    <span class="avm-fee-mark" aria-hidden="true">
                                        @if (Form.FeeTypes.Contains("Water"))
                                        {
                                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                                        }
                                    </span>
                                </button>
                                }

                                <!-- Section fee — only when this LGU actually charges one for the section.
                                     An office that set no per-kilo fish fee at onboarding sees nothing here. -->
                                @if (Form.SelectedSection == "Fish" && NpmFishRate > 0m)
                                {
                                    <div class="avm-util-divider"></div>
                                    <div class="avm-sublabel">Section Fee</div>
                                    <div class="avm-fish-fee">
                                        <div class="avm-fish-text">
                                            <div class="avm-fish-title">@SectionFeeLabel</div>
                                            <div class="avm-fish-sub">₱@NpmFishRate.ToString("0.00") per kilo sold, billed with the daily collection</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="avm-section-note">Select a section above to configure utility charges.</div>
                            }
                        }

                    </div>
                }

                <!-- Validation error -->
                @if (!string.IsNullOrEmpty(FormError))
                {
                    <div class="avm-error">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        @FormError
                    </div>
                }

                @* The offer to take over a vacated stall is raised as a dialog above this form
                   (see the end of this file), so the clerk answers it where they are. *@

            </div><!-- /eemo-modal-body -->
            <!-- ── Footer ──────────────────────────────────────────────── -->
            <div class="eemo-drawer-footer">
                @if (!IsEditing && (IsImportSupported || IsHistoryImportSupported))
                {
                    @* Both imports sit together, pushed to the left of Cancel and Add Vendor: they are the same kind
                       of act - bringing the office's existing paper in - so they read as one pair rather than two
                       unrelated buttons. *@
                    <div class="avm-import-group">
                        @if (IsImportSupported)
                        {
                            <button type="button" class="btn-ghost avm-import-btn" @onclick="HandleImport"
                                    title="Bulk import stallholders from a file">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                                Import list
                            </button>
                        }
                        @if (IsHistoryImportSupported)
                        {
                            <button type="button" class="btn-ghost avm-import-btn" @onclick="HandleImportHistory"
                                    title="Record payments already collected, from the office's own books">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="M7 14l4-4 3 3 5-6" /></svg>
                                Import history
                            </button>
                        }
                    </div>
                }
                <button type="button" class="btn-ghost" @onclick="HandleCancel">Cancel</button>
                <button type="button" class="btn-primary" @onclick="HandleSave" @onclick:preventDefault="true">
                    @(IsEditing ? "Save Changes" : "Add Vendor")
                </button>
            </div>

</div>

@* ── Take over a vacated stall ─────────────────────────────────────────────────────────────────────────
   A stall number already in use is not necessarily a dead end: if that stall was closed, or its contract has
   lapsed, the office can hand the same physical space to the new lessee instead of inventing a second number
   for it. The server is the authority — a stall that is still occupied is refused — so this only ever offers
   what is actually allowed.

   Asked as a dialog above the form (a sibling of the drawer, so it covers the screen rather than one panel):
   the clerk is answering a question about the number they just typed and should not have to scroll to the
   foot of the form to find the offer. *@
@if (ShowReuseOffer)
{
    <div class="avm-nested-overlay" @onclick="DismissReuseOffer">
        <div class="avm-nested-dialog" role="dialog" aria-modal="true"
             aria-labelledby="avm-reuse-title" tabindex="-1" @ref="_reuseDialog"
             @onkeydown="OnReuseKeyDown" @onclick:stopPropagation="true">
            @* The reuse offer only ever fires on a number the clerk typed, so a space identifier cannot reach it —
               guarded all the same, since a dangling "Stall  is already registered" would be worse than a rewording. *@
            <div class="avm-nested-head" id="avm-reuse-title">@(SpaceNumber.IsSpace(Form.StallNo)
                ? "This space is already registered"
                : $"Stall {Form.StallNo} is already registered")</div>
            <div class="avm-nested-body">
                <p>@ReuseOfferMessage</p>
            </div>
            <div class="avm-nested-foot">
                <button type="button" class="btn-ghost" @onclick="DismissReuseOffer">Use another number</button>
                <button type="button" class="btn-primary" @onclick="ConfirmReuse">Assign to this stall</button>
            </div>
        </div>
    </div>
}

@code {

    // ── Parameters ────────────────────────────────────────────────────────────

    /// Controls modal visibility
    [Parameter] public bool Show { get; set; }
    /// true = Edit mode   false = Add mode
    [Parameter] public bool IsEditing { get; set; }

    /// <summary>
    /// The form's token for the per-kilo section fee. A token is a key, not a price: the rate lives in the
    /// tenant's own configuration, so nothing here may quote a figure.
    /// </summary>
    public const string SectionFeeType = "Section fee";

    /// Bound form data — mutated directly (class = reference type, no need for two-way EventCallback)
    [Parameter] public VendorModalForm Form { get; set; } = new();

    /// The tenant's resolved NPM daily-stall rate (defaults to the ₱30 ordinance so Cantilan/unset is
    /// unchanged). Drives the NPM daily-collection labels and the daily-equivalent monthly hint, so a
    /// ₱40 LGU never shows ₱30. Display only — nothing here is stored.
    [Parameter] public decimal NpmDailyRate { get; set; } = 30m;

    /// <summary>
    /// The tenant's resolved per-kilo fee for the fish section. Zero (the default) means this office does not
    /// charge one, and the fee is then not shown at all — a municipality that set no such fee at onboarding must
    /// not see another's rate. Display only; the amount is charged from the tenant's configured rate.
    /// </summary>
    [Parameter] public decimal NpmFishRate { get; set; }

    /// <summary>
    /// What this office calls the fee, built from its own section label (e.g. "Gulayan fee"). Falls back to a
    /// neutral wording rather than assuming any LGU's vocabulary.
    /// </summary>
    [Parameter] public string SectionFeeLabel { get; set; } = "Per-kilo fee";

    /// <summary>
    /// Shown when the entered stall number already belongs to a stall that may be handed over (closed, or its
    /// contract lapsed). Empty = no offer.
    /// </summary>
    [Parameter] public string? ReuseOfferMessage { get; set; }

    /// <summary>Raised when the office confirms the handover; the host resubmits with the reuse flag set.</summary>
    [Parameter] public EventCallback OnReuseConfirm { get; set; }

    /// Validation error shown at the bottom of the form
    [Parameter] public string FormError { get; set; } = string.Empty;

    /// EventCallback for two-way binding of FormError — enables @bind-FormError in parent
    [Parameter] public EventCallback<string> FormErrorChanged { get; set; }

    /// Field-level validation errors from backend
    [Parameter] public Dictionary<string, string> FieldErrors { get; set; } = new();

    /// Existing stall/space numbers for the CURRENT context (facility, and section for NPM), supplied by
    /// the host from its loaded list. Used only to auto-SUGGEST the next number in add mode — never a
    /// constant; the value stays fully editable.
    [Parameter] public IReadOnlyCollection<string>? ExistingStallNos { get; set; }

    // The last value we auto-suggested; lets us refresh the suggestion when the context (e.g. NPM
    // section) changes — but only while the admin hasn't typed their own number.
    private string _lastSuggested = string.Empty;

    // True when the admin chose "Custom…" for the contract term (or opened an already-custom value),
    // revealing a free numeric input (1–10, the range the backend accepts).
    private bool _customYears;

    // ── Facility mark on the Base Rental card ─────────────────────────────────
    // The form works in facility codes (strings, because an LGU-defined facility has one that no enum knows).
    // Only a code the platform draws artwork for resolves to a mark; anything else keeps the neutral glyph.
    private FacilityCode? RentalFacilityMark =>
        Enum.TryParse<FacilityCode>(Form.FacilityCode, ignoreCase: true, out var code) ? code : null;

    // ── Handover offer ────────────────────────────────────────────────────────
    // The offer is a dialog, so it needs a dismissed state of its own; a new offer (the clerk typed a
    // different number, or reopened the form) must ask again rather than stay silently dismissed.
    private string? _answeredReuseOffer;

    private bool ShowReuseOffer =>
        Show &&
        !string.IsNullOrWhiteSpace(ReuseOfferMessage) &&
        !string.Equals(ReuseOfferMessage, _answeredReuseOffer, StringComparison.Ordinal);

    private void DismissReuseOffer() => _answeredReuseOffer = ReuseOfferMessage;

    /// <summary>Escape declines the offer, as a dialog must for anyone working from the keyboard.</summary>
    private void OnReuseKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") DismissReuseOffer();
    }

    private ElementReference _reuseDialog;
    private string? _focusedReuseOffer;

    private async Task ConfirmReuse()
    {
        _answeredReuseOffer = ReuseOfferMessage;
        await OnReuseConfirm.InvokeAsync();
    }

    /// <summary>The daily fee this modal last worked out from the monthly rent, so its own answer is not mistaken for the clerk's.</summary>
    private decimal? _dailyFromMonthlyRent;

    /// <summary>
    /// A monthly rent implies a daily fee: ₱900 a month is ₱30 a day, thirty installments to a month, which is the
    /// office's own arithmetic and already the constant the rest of the platform bills by.
    /// </summary>
    /// <remarks>
    /// Deliberately narrow. It never fires while EDITING, because an existing stall's own rate must not move merely
    /// because somebody corrected a contract figure. And it never fills a BLANK daily field: a blank field means this
    /// stall follows its section's stated fee, and a figure there would outrank that fee for ever. The rule itself lives
    /// in <see cref="DailyFeeFromMonthlyRent"/> with its own tests, because that is the direction that costs money.
    /// </remarks>
    private void MonthlyRentEntered()
    {
        if (IsEditing) return;

        var derived = DailyFeeFromMonthlyRent.DerivedOrNull(
            Form.MonthlyRate, Form.CustomDailyRate, dailyOnOpen: NpmDailyRate, lastDerived: _dailyFromMonthlyRent);

        if (derived is not { } daily) return;

        Form.CustomDailyRate = daily;
        _dailyFromMonthlyRent = daily;
    }

    protected override void OnParametersSet()    {
        if (Show && !IsEditing)
        {
            // Suggest on open, and re-suggest when the context list changes — but preserve a value the
            // admin has typed themselves (i.e. only replace an empty field or our own prior suggestion).
            if (string.IsNullOrWhiteSpace(Form.StallNo) || Form.StallNo == _lastSuggested)
            {
                // Each basis of occupancy draws from its own series: a signed contract from the facility's stall
                // numbers, a space held without one from the space series, which cannot collide with them.
                var suggestion = Form.HasSignedContract
                    ? SuggestNextStallNo(ExistingStallNos)
                    : NextSpaceNo();
                if (!string.IsNullOrEmpty(suggestion))
                {
                    Form.StallNo = suggestion;
                    _lastSuggested = suggestion;
                }
            }

            // Reflect a non-preset contract term (4, 6–10) as "Custom…" so the input shows and the value
            // is preserved; the standard presets (1/2/3/5) use the dropdown directly. Minimum term is 1 year.
            _customYears = Form.ContractYears is not (1 or 2 or 3 or 5);
        }
        else if (!Show)
        {
            _lastSuggested = string.Empty;
            _customYears = false;
            // The next stall opened works its own daily fee out from its own rent, or is left to follow its section.
            _dailyFromMonthlyRent = null;
            // "Add a utility charge" applies to the space that was open. Left set, the next stall opened would
            // show two empty toggles instead of the plain statement that it carries no utility charges.
            _showUtilityCharges = false;
            // Closing answers whatever was on the table. A host that forgets to clear its offer therefore
            // cannot put a stale dialog over the next blank form; a NEW offer still asks.
            _answeredReuseOffer = ReuseOfferMessage;
        }
    }

    /// <summary>
    /// Suggests the next stall/space number from the existing ones — dynamically, never a fixed constant.
    /// Takes the numeric part of each existing number, uses (max + 1), preserves a shared non-numeric
    /// prefix (e.g. "F-12" → "F-13") and zero-padding (e.g. "01"…"40" → "41"). Returns empty when there's
    /// no numeric pattern to continue (the admin then types it), so nothing is ever fabricated.
    /// </summary>
    public static string SuggestNextStallNo(IEnumerable<string>? existing)
    {
        if (existing is null) return string.Empty;

        var nums = new List<int>();
        string? sharedPrefix = null;
        var prefixConsistent = true;
        var width = 0;
        var anyEntries = false;

        foreach (var raw in existing)
        {
            if (string.IsNullOrWhiteSpace(raw)) continue;
            // A space the office does not number is not part of this numbering, so it must not be read as a stall
            // number: "SP-4" would otherwise be taken as 4 and push the next stall to 5 with stalls 1 to 4 empty,
            // or - where a facility holds nothing but un-numbered spaces - make "SP-" look like the house prefix
            // and suggest SP-5 for a stall held under a signed contract.
            if (SpaceNumber.IsSpace(raw)) continue;
            anyEntries = true;
            var m = System.Text.RegularExpressions.Regex.Match(raw.Trim(), @"^(.*?)(\d+)\s*$");
            if (!m.Success) continue;

            var prefix = m.Groups[1].Value;
            var digits = m.Groups[2].Value;
            nums.Add(int.Parse(digits));
            width = Math.Max(width, digits.Length);

            if (sharedPrefix is null) sharedPrefix = prefix;
            else if (!string.Equals(sharedPrefix, prefix, StringComparison.OrdinalIgnoreCase)) prefixConsistent = false;
        }

        // No numeric stalls to continue: for a brand-new facility/section (no stalls at all) suggest the
        // first number "1"; for an all-non-numeric scheme (e.g. only "A","B") don't guess — the admin types it.
        if (nums.Count == 0) return anyEntries ? string.Empty : "1";

        var next = (nums.Max() + 1).ToString().PadLeft(Math.Max(width, 1), '0');
        return prefixConsistent && !string.IsNullOrEmpty(sharedPrefix) ? $"{sharedPrefix}{next}" : next;
    }

    private ElementReference modalBodyRef;

    /// Helper to get field error
    private string GetFieldError(string fieldName) => FieldErrors.ContainsKey(fieldName) ? FieldErrors[fieldName] : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FieldErrors.Any())
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.eemo-modal-body').scrollTo({ top: 0, behavior: 'smooth' })");
        }

        // Move the keyboard into the handover dialog once per offer, so what covers the form is also what
        // answers to Escape and Tab. Focus is a courtesy: a failure here must never break the form.
        if (ShowReuseOffer && _focusedReuseOffer != ReuseOfferMessage)
        {
            _focusedReuseOffer = ReuseOfferMessage;
            try { await _reuseDialog.FocusAsync(); } catch { }
        }
        else if (!ShowReuseOffer)
        {
            _focusedReuseOffer = null;
        }
    }

    /// Facility options for the dropdown.
    /// Vendors page  → pass all facilities.
    /// Facility page → pass a single-item list  +  FacilityLocked="true"
    [Parameter] public List<VendorFacilityOption> FacilityOptions { get; set; } = new();

    /// true  → show a read-only facility label   (called from a facility page e.g. NPM)
    /// false → show the full facility dropdown   (called from Vendor.razor)
    [Parameter] public bool FacilityLocked { get; set; } = false;

    /// Fires when Save / Add Vendor is clicked — host runs its own validation + save logic
    [Parameter] public EventCallback OnSave { get; set; }

    /// Fires when Cancel or the ✕ button is clicked
    [Parameter] public EventCallback OnCancel { get; set; }

    /// Fires after the facility dropdown changes — host should call its OnFacilityChanged / AutoPopulateFees
    [Parameter] public EventCallback OnFacilityChanged { get; set; }

    /// Fires after the section dropdown changes — host should call its OnSectionChanged / AutoPopulateFees
    [Parameter] public EventCallback OnSectionChanged { get; set; }

    /// Fires when a fee toggle (Electricity / Water) is clicked — host calls ToggleFee(feeName)
    [Parameter] public EventCallback<string> OnToggleFee { get; set; }

    /// NPM per-LGU custom section names (host-supplied) — shown as selectable options in the Section dropdown.
    [Parameter] public IReadOnlyList<string> CustomSectionNames { get; set; } = Array.Empty<string>();

    // ── Private relay handlers ────────────────────────────────────────────────

    private async Task HandleCancel() => await OnCancel.InvokeAsync();
    private async Task HandleSave() => await OnSave.InvokeAsync();
    private async Task HandleFacilityChanged() => await OnFacilityChanged.InvokeAsync();
    private async Task HandleSectionChanged() => await OnSectionChanged.InvokeAsync();

    // Fee state lives on the shared Form. Toggle it HERE (the modal owns the click) so the checkbox
    // updates immediately and identically on every host — facility pages (NPM/TCC/NCC/BBQ/ICE) and the
    // Vendors registry — without depending on a host round-trip re-render. All hosts' toggles were the
    // same add/remove, so this is authoritative.
    private void HandleToggleFee(string fee)
    {
        if (Form.FeeTypes.Contains(fee))
            Form.FeeTypes.Remove(fee);
        else
            Form.FeeTypes.Add(fee);
        StateHasChanged();
    }

    // Options for the custom Section / Contract-duration dropdowns. The three collection areas of the daily
    // market carry the office's own names for them (an LGU that calls its vegetable area "Gulayan" sees
    // "Gulayan"); the option VALUES stay the canonical keys the form and server are written against. NPM
    // custom sections (passed by the host) appear as selectable "existing:{name}" options, followed by the
    // "＋ Custom section…" add-new sentinel.
    private IReadOnlyList<(string Value, string Label)> SectionOptions
    {
        get
        {
            var opts = new List<(string, string)>
            {
                ("Vegetable", FacilityCatalog.SectionLabelOf(FacilityCode.NPM, MarketSection.VegetableArea)),
                ("Fish", FacilityCatalog.SectionLabelOf(FacilityCode.NPM, MarketSection.FishSection)),
                ("Meat", FacilityCatalog.SectionLabelOf(FacilityCode.NPM, MarketSection.MeatSection)),
            };
            foreach (var name in CustomSectionNames)
                opts.Add(($"existing:{name}", name));
            opts.Add(("__custom__", "＋ Custom section…"));
            return opts;
        }
    }
    /// <summary>
    /// Reveals the utility toggles on a space that currently has none, so a meter installed later can be recorded
    /// without the form implying every space has one.
    /// </summary>
    private bool _showUtilityCharges;

    private static readonly IReadOnlyList<(string Value, string Label)> ContractYearOptions = new List<(string, string)>
    {
        ("1", "1 year"), ("2", "2 years"), ("3", "3 years"), ("5", "5 years"), ("custom", "Custom…"),
    };

    /// <summary>
    /// The three bases of occupancy the office's registers record. The wording is the office's own, so a clerk
    /// choosing here is choosing exactly what will be printed on the official list.
    /// </summary>
    private static readonly IReadOnlyList<(OccupancyArrangement Value, string Title, string Note)> ArrangementOptions =
        new List<(OccupancyArrangement, string, string)>
        {
            (OccupancyArrangement.SignedContract, "Signed lease contract", "With effectivity date, term and area"),
            (OccupancyArrangement.SpaceOnly, "No contract (space only)", "Rent charged, no contract on file"),
            (OccupancyArrangement.Extension, "No contract (extension)", "Occupying past a lapsed contract"),
        };

    /// <summary>What the official list prints where a signed contract would be named.</summary>
    private string NoContractText => Form.Arrangement == OccupancyArrangement.Extension
        ? $"No contract (Extension {(string.IsNullOrWhiteSpace(Form.FacilityCode) ? "TCC" : Form.FacilityCode)})"
        : "No contract (space only)";

    private void SelectArrangement(OccupancyArrangement arrangement)
    {
        Form.Arrangement = arrangement;

        if (arrangement == OccupancyArrangement.SignedContract)
        {
            // Back to a numbered stall: drop the space identifier and offer the facility's next stall number, so the
            // form does not save a space identifier against a signed contract.
            if (SpaceNumber.IsSpace(Form.StallNo))
            {
                var stallSuggestion = SuggestNextStallNo(ExistingStallNos);
                Form.StallNo = stallSuggestion;
                _lastSuggested = stallSuggestion;
            }
            return;
        }

        // Nothing on a signed contract applies: no name on one, and no term. Clearing them here means the record
        // cannot carry particulars the office does not hold, whatever was typed before the basis was changed.
        Form.ContractName = string.Empty;
        Form.ContractYears = 0;
        _customYears = false;

        // Nor does a stall number. The office does not number these spaces at all, so the clerk is not asked for one
        // and none is taken from the facility's numbering - recording such a space as stall 4 made the actual stall 4
        // unregisterable. It takes the next identifier in the space series instead.
        var spaceSuggestion = NextSpaceNo();
        Form.StallNo = spaceSuggestion;
        _lastSuggested = spaceSuggestion;
    }

    /// <summary>The next identifier in this facility's series for spaces it does not number.</summary>
    private string NextSpaceNo() =>
        SpaceNumber.Format(SpaceNumber.HighestOrdinal(ExistingStallNos ?? Array.Empty<string>()) + 1);

    private async Task OnSectionSelected(string value)
    {
        Form.SelectedSection = value;
        await HandleSectionChanged();
    }

    private void OnContractYearsSelected(string value)
    {
        if (value == "custom")
        {
            _customYears = true;
            // Seed a sensible in-range term if the current value is a standard preset or below the minimum.
            if (Form.ContractYears is < 1 or 1 or 2 or 3 or 5) Form.ContractYears = 4;
        }
        else
        {
            _customYears = false;
            Form.ContractYears = int.TryParse(value, out var years) ? years : 0;
        }
    }

    // Bulk import is offered (Add mode only) for the facilities that have an import page.
    private static readonly HashSet<string> ImportFacilities = new(StringComparer.OrdinalIgnoreCase)
        { "NPM", "TCC", "NCC", "BBQ", "ICE" };
    private bool IsImportSupported => ImportFacilities.Contains(Form.FacilityCode);

    private void HandleImport()
    {
        if (IsImportSupported)
            Navigation.NavigateTo($"/import/{Form.FacilityCode.ToLowerInvariant()}");
    }

    /// <summary>
    /// The facilities whose history can be imported: the ones billed by the month, where one row is one month, and
    /// the market, where one row is a month's worth of market days.
    ///
    /// <para>The facilities charged per unit collected — per head, per trip, per vendor per market day — have no
    /// period to key a history to, so the option is not offered for them. The same rule the page and the server
    /// enforce, stated here so the button never leads to a refusal.</para>
    /// </summary>
    private static readonly HashSet<string> HistoryImportFacilities = new(StringComparer.OrdinalIgnoreCase)
        { "NPM", "TCC", "NCC", "BBQ", "ICE", "CUSTOM1", "CUSTOM2", "CUSTOM3", "CUSTOM4", "CUSTOM5" };

    private bool IsHistoryImportSupported => HistoryImportFacilities.Contains(Form.FacilityCode);

    private void HandleImportHistory()
    {
        if (IsHistoryImportSupported)
            Navigation.NavigateTo($"/import-history/{Form.FacilityCode.ToLowerInvariant()}");
    }

    // ── Shared models ─────────────────────────────────────────────────────────
    // Defined inside this component so host pages reference them as:
    //   AddVendorModal.VendorModalForm
    //   AddVendorModal.VendorFacilityOption

    /// One entry in the Facility dropdown
    public class VendorFacilityOption
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    /// All form fields bound to the modal — pass a new instance from the host page
    public class VendorModalForm
    {
        public string FacilityCode { get; set; } = string.Empty;
        public string StallNo { get; set; } = string.Empty;
        public string ActualOccupant { get; set; } = string.Empty;
        public string ContractName { get; set; } = string.Empty;

        /// <summary>
        /// How the space is held. Barbecue and ice-plant spaces are let without a signed contract at all, and some
        /// commercial-centre spaces are occupied on an extension of a lapsed one. Rent is recorded exactly the same
        /// way; what is absent is the name on a contract, the term and the contract rate.
        /// </summary>
        public OccupancyArrangement Arrangement { get; set; } = OccupancyArrangement.SignedContract;

        /// <summary>True when a signed contract stands behind the occupancy, so its particulars are asked for.</summary>
        public bool HasSignedContract => Arrangement == OccupancyArrangement.SignedContract;
        public string SelectedSection { get; set; } = string.Empty;
        // NPM only: the free-text name when SelectedSection is the "＋ Custom section…" sentinel.
        public string CustomSectionName { get; set; } = string.Empty;
        // NPM custom sections only: the flat daily stall fee for this section (canonical sections use the
        // tenant ordinance rate). Stamped onto the stall's DailyRate and used by billing.
        public decimal CustomDailyRate { get; set; }
        public double AreaSqm { get; set; }
        public DateTime? ContractDate { get; set; }
        public int ContractYears { get; set; }
        public decimal MonthlyRate { get; set; }
        public decimal ActualMonthlyRental { get; set; }
        public string AreaLocation { get; set; } = string.Empty;
        public List<string> FeeTypes { get; set; } = new();

        public decimal WholeYearRental
            => MonthlyRate * 12;

        public decimal WholeYearActualRental
            => ActualMonthlyRental > 0 ? ActualMonthlyRental * 12 : WholeYearRental;
    }
}
