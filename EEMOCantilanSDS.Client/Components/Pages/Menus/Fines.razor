@page "/operations/fines"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IPenaltiesApiClient PenaltiesApi

<PageTitle>StallTrack — Fines &amp; Penalties</PageTitle>

@* Assessments and cash are separate; existing definition and eligibility workflows retain their own identities. *@
<div class="v3-page fn-page">
    <V3Hero Compact="true" Eyebrow="Operations · Fines" Title="Fines &amp; Penalties">
        <Icon><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16l3-2 3 2 3-2 3 2V8z" /><path d="M14 2v6h6" /><path d="M9 13h6" /><path d="M9 9h2" /></svg></Icon>
        <Meta><span class="fn-hero-meta">@PeriodLabel · <InstrumentChip Instrument="OR" ShowName="true" /></span></Meta>
        <Figures>
            <V3HeroFigure Label="@($"Collected · {PeriodLabel}")" Value="@HeroMoney(_summary?.Collected)" Note="@(_summaryError ? "Unavailable right now" : null)" />
            <V3HeroFigure Label="Direct fine collections" Value="@HeroMoney(_summary?.DirectCollected)" Note="@(_summaryError ? "Unavailable right now" : null)" />
            <V3HeroFigure Label="Outstanding assessments" Value="@HeroMoney(_summary?.OutstandingAssessed)" Note="@(_summary is null ? (_summaryError ? "Unavailable right now" : "Loading…") : $"{_summary.OutstandingAssessments} unpaid · not yet collected")" />
        </Figures>
    </V3Hero>

    @* Stays pinned while a long register scrolls so sections can be switched without returning to the top. *@
    <div class="fn-nav">
        <div class="fn-tabs" role="group" aria-label="Fines workspace views">
            <button type="button" class="fn-tab @(_view == "collected" ? "active" : "")" aria-pressed="@(_view == "collected" ? "true" : "false")" @onclick='() => SelectView("collected")'>Collections</button>
            <button type="button" class="fn-tab @(_view == "assessments" ? "active" : "")" aria-pressed="@(_view == "assessments" ? "true" : "false")" @onclick='() => SelectView("assessments")'>Assessments</button>
            <button type="button" class="fn-tab @(_view == "settings" ? "active" : "")" aria-pressed="@(_view == "settings" ? "true" : "false")" @onclick='() => SelectView("settings")'>Penalty settings</button>
        </div>
    </div>
    @if (_view == "assessments") {
        <FineAssessmentsRegister InitialAccount="RequestedAccount" PaymentAssessmentId="PaymentAssessmentId" StartAssessing="_openAssess" OnChanged="LoadSummaryAsync" />
    }

    @if (_view == "settings") {
    <section class="v3-panel" aria-labelledby="fn-defs-title" aria-busy="@(_loadingDefinitions ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="fn-defs-title">Penalty categories</h2>
            <span class="v3-panel-meta fn-meta">@_definitions.Count approved</span>
            <AuthorizeView Roles="SuperAdmin">
                <Authorized>
                    @if (!_editing)
                    {
                        <button class="v3-btn v3-btn-sm" type="button" @onclick="OpenEditor">Define penalty</button>
                    }
                </Authorized>
            </AuthorizeView>
        </header>

        @if (_definitionsError is not null)
        {
            <div class="v3-notice v3-notice-error fn-notice" role="alert">
                <span>@_definitionsError</span>
                <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadDefinitionsAsync">Try again</button>
            </div>
        }

        <div class="v3-table-wrap" role="region" aria-label="Approved penalties" tabindex="0">
            <table class="v3-table fn-table">
                <caption class="v3-sr-only">Approved penalty definitions in force today</caption>
                <thead>
                    <tr>
                        <th scope="col">Penalty</th>
                        <th scope="col">Applies to</th>
                        <th scope="col">Amount rule</th>
                        <th scope="col">Status</th>
                        <th scope="col">Effective</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _definitions)
                    {
                        <tr>
                            <td><span class="v3-strong">@d.DisplayName</span><span class="v3-block">@d.Code</span></td>
                            <td class="fn-secondary">@(d.AppliesTo ?? "—")</td>
                            <td class="fn-rule">@Rule(d)</td>
                            <td><span class="status-pill @(d.IsActive ? "pill-active" : "pill-inactive")">@(d.IsActive ? "Active" : "Retired")</span></td>
                            <td class="fn-nowrap">@d.EffectiveDate.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                    @if (_definitions.Count == 0)
                    {
                        <tr>
                            <td class="v3-empty" colspan="5">
                                @if (_loadingDefinitions) { <span role="status">Loading penalties…</span> }
                                else if (_definitionsError is not null) { <span>Penalties are unavailable.</span> }
                                else { <span class="v3-empty-block">@EmptyIcon<span>No penalty has been approved yet. Fines cannot be collected until the Head defines one.</span></span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <AuthorizeView Roles="SuperAdmin">
            <Authorized>
                @* The definition editor is a drawer, like every other add form. *@

            </Authorized>
        </AuthorizeView>
        @if (!string.IsNullOrWhiteSpace(_saved))
        {
            <p class="v3-notice fn-notice" role="status">@_saved</p>
        }
        <FinePolicySetup Definitions="_definitions" />
        <AuthorizeView Roles="SuperAdmin">
            <Authorized>
                <AddNewDrawer Show="_editing" Title="Define penalty" Subtitle="Adds a new version from its effective date." FormId="fn-define" FormLabel="Define a penalty" SubmitText="Save penalty"
                              Saving="_saving" Error="@_saveError" OnSubmit="SaveAsync" OnCancel="CloseEditor">
                    <AddNewSection Title="Penalty">
                        <label class="v3-field"><span>Code</span><input class="v3-input" required maxlength="40" placeholder="LATE_PAYMENT" @bind="_code" /></label>
                        <label class="v3-field"><span>Name</span><input class="v3-input" required maxlength="120" @bind="_name" /></label>
                        <label class="v3-field fn-span"><span>Applies to (optional)</span><input class="v3-input" maxlength="80" @bind="_appliesTo" /></label>
                    </AddNewSection>
                    <AddNewSection Title="Amount rule">
                        <div class="fn-seg fn-span" role="radiogroup" aria-label="Amount rule">
                            <label class="@(_basis == GovernedServiceBasis.FixedAmount ? "is-on" : null)"><input type="radio" name="fn-basis" checked="@(_basis == GovernedServiceBasis.FixedAmount)" @onchange="() => _basis = GovernedServiceBasis.FixedAmount" />Fixed amount</label>
                            <label class="@(_basis == GovernedServiceBasis.DirectApprovedAmount ? "is-on" : null)"><input type="radio" name="fn-basis" checked="@(_basis == GovernedServiceBasis.DirectApprovedAmount)" @onchange="() => _basis = GovernedServiceBasis.DirectApprovedAmount" />Manually approved</label>
                        </div>
                        @if (_basis == GovernedServiceBasis.FixedAmount)
                        {
                            <label class="v3-field"><span>Amount (₱)</span><input class="v3-input" type="number" min="0.01" step="0.01" required @bind="_fixedAmount" /></label>
                        }
                        else
                        {
                            <label class="v3-field"><span>Maximum (₱, optional)</span><input class="v3-input" type="number" min="0.01" step="0.01" @bind="_ceiling" /></label>
                        }
                        <label class="v3-field"><span>Effective from</span><input class="v3-input" type="date" required @bind="_effective" /></label>
                    </AddNewSection>
                    <AddNewSection Plain="true" Title="Status">
                        <label class="fn-check"><input type="checkbox" @bind="_active" /> Active for new fines</label>
                    </AddNewSection>
                </AddNewDrawer>
            </Authorized>
        </AuthorizeView>
    </section>
    }

    @if (_view == "collected") {
    <section class="v3-panel" aria-labelledby="fn-register-title" aria-busy="@(_loadingRegister ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="fn-register-title">Collections</h2>
            <span class="v3-panel-meta fn-meta">@PeriodLabel · @VisibleCollections.Count() of @_register.Count shown</span>
            <label class="fn-period">
                <span>Month</span>
                <input class="v3-input" type="month" aria-label="Collection month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            </label>
            <AuthorizeView Roles="SuperAdmin"><Authorized>
                <span class="fn-header-actions">
                    <button class="v3-btn" type="button" @onclick="BeginAssessment">Assess fine</button>
                    <button class="v3-btn v3-btn-primary" type="button" @onclick="() => _direct=true">Record direct fine</button>
                </span>
            </Authorized></AuthorizeView>
        </header>

        <div class="v3-toolbar fn-search"><label class="v3-field"><span class="v3-sr-only">Search collections</span><input @bind="_collectionSearch" @bind:event="oninput" placeholder="Search payer, account, fine or SRC" /></label>
            <label class="v3-field"><span class="v3-sr-only">Fine type</span><select @bind="_collectionKind"><option value="All">All fine types</option><option value="@PenaltyRegisterKinds.Direct">Direct fine</option><option value="@PenaltyRegisterKinds.Assessed">Assessed fine payment</option><option value="@PenaltyRegisterKinds.Definition">Fine on receipt</option></select></label>
            <label class="v3-field"><span class="v3-sr-only">Collection status</span><select @bind="_collectionStatus"><option value="All">All statuses</option><option>Posted</option><option>Corrected</option><option>Reversed</option></select></label>
        </div>
        @if (_registerError is not null)
        {
            <p class="v3-notice v3-notice-error fn-notice" role="alert">@_registerError</p>
        }

        <div class="v3-table-wrap" role="region" aria-label="Fines collected" tabindex="0">
            <table class="v3-table fn-table fn-collections">
                <caption class="v3-sr-only">Fines collected in @PeriodLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Date / SRC</th>
                        <th scope="col">Fine</th>
                        <th scope="col">Payer / source</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="v3-num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in VisibleCollections)
                    {
                        <tr class="fn-row" tabindex="0" aria-label="@($"Open {row.ReferenceCode}")" @onclick="() => _detail = row" @onkeydown="args => OnRowKey(args, row)">
                            <td class="fn-nowrap"><span class="fn-date">@row.BusinessDate.ToString("MMM d, yyyy")</span><span class="v3-block fn-src">@row.ReferenceCode</span></td>
                            <td><strong>@row.PenaltyName</strong><span class="fn-kind fn-kind-@row.Kind.ToLowerInvariant()">@KindLabel(row.Kind)</span></td>
                            <td>
                                @if (row.Kind == PenaltyRegisterKinds.Assessed)
                                {
                                    <strong>@(row.Account ?? row.PayerName ?? "Assessed account")</strong>
                                    @if (!string.IsNullOrWhiteSpace(row.Facility)) { <span class="v3-block">@row.Facility</span> }
                                }
                                else if (row.Kind == PenaltyRegisterKinds.Direct)
                                {
                                    @if (!string.IsNullOrWhiteSpace(row.PayerName)) { <strong>@row.PayerName</strong> }
                                }
                                else
                                {
                                    <strong>@(row.PayerName ?? "—")</strong>
                                    @if (!string.IsNullOrWhiteSpace(row.Origin)) { <span class="v3-block">@row.Origin</span> }
                                }
                            </td>
                            <td><span class="status-pill @CollectionPill(row.Status)">@row.Status</span></td>
                            <td class="v3-num fn-amount @(row.Status == "Reversed" ? "fn-amount-void" : "")">@Money(row.EffectiveAmount ?? (row.Status == "Posted" ? row.Amount : 0m))@if (row.Status != "Posted" && row.Amount != (row.EffectiveAmount ?? 0m)) { <span class="v3-block">of @Money(row.Amount) posted</span> }</td>
                        </tr>
                    }
                    @if (!VisibleCollections.Any())
                    {
                        <tr>
                            <td class="v3-empty" colspan="5">
                                @if (_loadingRegister) { <span role="status">Loading fines…</span> }
                                else if (_registerError is not null) { <span>Fines are unavailable.</span> }
                                else { <span class="v3-empty-block">@EmptyIcon<span>No collections match this view.</span></span> }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_register.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="4"><strong>Shown collections</strong></td>
                            <td class="v3-num v3-strong">@Money(VisibleCollections.Sum(x => x.EffectiveAmount ?? (x.Status == "Posted" ? x.Amount : 0m)))</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>
    }
</div>
@if(_direct) { <DirectFineCollectionDrawer OnClose="() => _direct=false" OnCollected="RefreshCollectionsAsync" /> }

@* One collection's details, from the register row already loaded: nothing is fetched or invented, and the original amount stays beside the
   corrected one when a correction applies. *@
@if (_detail is { } fine)
{
    var recorded = PhilippineTime.ToPhilippineTime(fine.RecordedAtUtc);
    var effective = fine.EffectiveAmount ?? (fine.Status == "Posted" ? fine.Amount : 0m);
    <div class="v3-modal-backdrop" role="presentation" @onclick="CloseDetail">
        <section class="v3-modal fn-modal" role="dialog" aria-modal="true" aria-labelledby="fn-detail-title" @onclick:stopPropagation="true" @onkeydown="OnDetailKey">
            <header class="fn-modal-head">
                <div class="fn-modal-text">
                    <h2 id="fn-detail-title">@fine.PenaltyName</h2>
                    <p>@fine.ReferenceCode · @fine.BusinessDate.ToString("MMM d, yyyy")</p>
                </div>
                <button class="fn-modal-close" type="button" aria-label="Close" @onclick="CloseDetail"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></button>
            </header>
            <div class="v3-modal-body fn-modal-body">
                <dl class="fn-facts">
                    <div><dt>Status</dt><dd><span class="status-pill @CollectionPill(fine.Status)">@fine.Status</span></dd></div>
                    <div><dt>Source</dt><dd>@KindLabel(fine.Kind)@(string.IsNullOrWhiteSpace(fine.Origin) ? "" : " · " + fine.Origin)</dd></div>
                    <div><dt>Fine category</dt><dd>@fine.PenaltyName</dd></div>
                    <div><dt>Payer</dt><dd>@(string.IsNullOrWhiteSpace(fine.PayerName) ? "Not recorded" : fine.PayerName)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(fine.Account) || !string.IsNullOrWhiteSpace(fine.Facility))
                    {
                        <div class="fn-wide"><dt>Account</dt><dd>@string.Join(" · ", new[] { fine.Account, fine.Facility }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd></div>
                    }
                    <div><dt>Business date</dt><dd>@fine.BusinessDate.ToString("MMM d, yyyy")</dd></div>
                    <div><dt>Recorded</dt><dd>@recorded.ToString("MMM d, yyyy h:mm tt")</dd></div>
                    <div><dt>SRC</dt><dd>@fine.ReferenceCode</dd></div>
                    @if (!string.IsNullOrWhiteSpace(fine.Reason))
                    {
                        <div class="fn-wide"><dt>Reason</dt><dd>@fine.Reason</dd></div>
                    }
                </dl>
                <dl class="fn-amounts">
                    <div><dt>@(fine.Status == "Posted" ? "Amount collected" : "Original amount")</dt><dd>@Money(fine.Amount)</dd></div>
                    @if (fine.Status != "Posted" || effective != fine.Amount)
                    {
                        <div><dt>Correction</dt><dd>@Money(effective - fine.Amount)</dd></div>
                        <div class="fn-net"><dt>Net after correction</dt><dd>@Money(effective)</dd></div>
                    }
                </dl>
            </div>
            <footer class="fn-modal-foot"><button class="v3-btn v3-btn-primary" type="button" @onclick="CloseDetail">Close</button></footer>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    private string _view = "collected";
    private bool _direct;
    private PenaltyRegisterRowDto? _detail;
    private void CloseDetail() => _detail = null;
    private void OnDetailKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseDetail(); }
    private void OnRowKey(KeyboardEventArgs e, PenaltyRegisterRowDto row) { if (e.Key is "Enter" or " ") _detail = row; }
    protected override void OnParametersSet() { _view = RequestedAccount is not null || PaymentAssessmentId is not null ? "assessments" : ViewQuery is "assessments" or "settings" ? ViewQuery : "collected"; }
    [SupplyParameterFromQuery(Name = "accountKind")] public string? AccountKindQuery { get; set; }
    [SupplyParameterFromQuery(Name = "accountId")] public Guid? AccountIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "fineAssessmentId")] public Guid? PaymentAssessmentId { get; set; }
    private FineAccountRef? RequestedAccount => AccountIdQuery is { } id &&
        Enum.TryParse<EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind>(AccountKindQuery, out var kind) && Enum.IsDefined(kind) ? new(kind,id) : null;
    private List<PenaltyDefinitionDto> _definitions = [];
    private string? _definitionsError;
    private bool _loadingDefinitions = true;

    private List<PenaltyRegisterRowDto> _register = [];
    private string _collectionSearch="", _collectionStatus="All", _collectionKind="All";
    private IEnumerable<PenaltyRegisterRowDto> VisibleCollections => _register.Where(r => (_collectionStatus=="All" || r.Status==_collectionStatus)
        && (_collectionKind=="All" || r.Kind==_collectionKind)
        && string.Join(" ",r.PenaltyName,r.PayerName,r.Origin,r.ReferenceCode,r.Account,r.Facility,r.Reason).Contains(_collectionSearch.Trim(),StringComparison.OrdinalIgnoreCase));
    private PenaltyWorkspaceSummaryDto? _summary;
    private bool _summaryError;
    private bool _openAssess;
    private static string Money(decimal amount) => $"₱{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";
    private static string HeroMoney(decimal? amount) => amount is { } value ? Money(value) : "—";
    private static string KindLabel(string kind) => kind switch
    {
        PenaltyRegisterKinds.Direct => "Direct fine",
        PenaltyRegisterKinds.Assessed => "Assessed fine payment",
        _ => "Fine on receipt"
    };
    private static string CollectionPill(string status) => status switch { "Posted" => "pill-active", "Corrected" => "pill-partial", _ => "pill-danger" };
    private static RenderFragment EmptyIcon => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>;
    private static RenderFragment ListIcon => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13" /><path d="M8 12h13" /><path d="M8 18h13" /><path d="M3 6h.01" /><path d="M3 12h.01" /><path d="M3 18h.01" /></svg>;
    private void SelectView(string view) { _openAssess = false; _view = view; }
    private void BeginAssessment() { _openAssess = true; _view = "assessments"; }
    private string? _registerError;
    private bool _loadingRegister = true;
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private string PeriodLabel => _month.ToString("MMMM yyyy");

    private bool _editing;
    private bool _saving;
    private string? _saveError;
    private string? _saved;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string? _appliesTo;
    private DateOnly _effective = PhilippineTime.Today;
    private GovernedServiceBasis _basis = GovernedServiceBasis.FixedAmount;
    private decimal? _fixedAmount;
    private decimal? _ceiling;
    private bool _active = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();
        await LoadRegisterAsync();
        await LoadSummaryAsync();
    }

    private async Task RefreshCollectionsAsync()
    {
        await LoadRegisterAsync();
        await LoadSummaryAsync();
    }

    // Headline figures are server-authoritative; a failed read says so rather than showing a fabricated zero.
    private async Task LoadSummaryAsync()
    {
        _summaryError = false;
        try
        {
            var result = await PenaltiesApi.GetSummaryAsync(_month, _month.AddMonths(1).AddDays(-1));
            if (result is { IsSuccess: true, Value: not null }) _summary = result.Value;
            else { _summary = null; _summaryError = true; }
        }
        catch { _summary = null; _summaryError = true; }
        StateHasChanged();
    }

    private async Task LoadDefinitionsAsync()
    {
        _loadingDefinitions = true;
        _definitionsError = null;
        try
        {
            var result = await PenaltiesApi.GetDefinitionsAsync();
            if (result.IsSuccess) _definitions = result.Value?.ToList() ?? [];
            else { _definitions = []; _definitionsError = "Approved penalties couldn't be loaded."; }
        }
        catch { _definitions = []; _definitionsError = "Approved penalties couldn't be loaded."; }
        finally { _loadingDefinitions = false; }
    }

    private async Task LoadRegisterAsync()
    {
        _loadingRegister = true;
        _registerError = null;
        try
        {
            var result = await PenaltiesApi.GetRegisterAsync(_month, _month.AddMonths(1).AddDays(-1));
            if (result.IsSuccess) _register = result.Value?.ToList() ?? [];
            else { _register = []; _registerError = "Fines couldn't be loaded."; }
        }
        catch { _register = []; _registerError = "Fines couldn't be loaded."; }
        finally { _loadingRegister = false; }
    }

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _month = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadRegisterAsync();
            await LoadSummaryAsync();
        }
    }

    private void OpenEditor()
    {
        _saveError = null;
        _saved = null;
        _code = string.Empty;
        _name = string.Empty;
        _appliesTo = null;
        _effective = PhilippineTime.Today;
        _basis = GovernedServiceBasis.FixedAmount;
        _fixedAmount = null;
        _ceiling = null;
        _active = true;
        _editing = true;
    }

    private void CloseEditor() => _editing = false;

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _saveError = null;
        try
        {
            var result = await PenaltiesApi.DefineAsync(new DefinePenaltyRequest(
                _code.Trim(), _name.Trim(), _appliesTo, _effective, _basis,
                _basis == GovernedServiceBasis.FixedAmount ? _fixedAmount : null,
                _basis == GovernedServiceBasis.DirectApprovedAmount ? _ceiling : null, _active));
            if (!result.IsSuccess)
            {
                _saveError = result.Error ?? "The penalty could not be saved.";
                return;
            }
            _editing = false;
            _saved = "Penalty saved. It applies from its effective date.";
            await LoadDefinitionsAsync();
        }
        catch (Exception ex) { _saveError = ex.Message; }
        finally { _saving = false; }
    }

    private static string Rule(PenaltyDefinitionDto d) => d.Basis switch
    {
        GovernedServiceBasis.FixedAmount => $"Fixed · ₱{d.FixedAmount:N2}",
        _ => d.MaximumAmount is { } ceiling ? $"Manually approved · up to ₱{ceiling:N2}" : "Manually approved · no ceiling set"
    };
}
