@page "/operations/market-fees"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Constants

<PageTitle>StallTrack — Market Fees</PageTitle>

@* Market Fees is one official sibling Income from Market line (Cash Ticket). It is a governed configurable service
   (IA-044): the Head records the approved amount rule here, assigned collectors record collections on Collector Mobile,
   and this page shows what was actually collected. Nothing on this page records money. The layout owns the <main>
   landmark. *@
<div class="v3-page">
    <V3Hero Eyebrow="Operation · Market" Title="Market Fees" Subtitle="Cash Ticket collection workspace" Compact="true">
        <Icon>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18M5 10v10h14V10M3 10l2-6h14l2 6M9 20v-6h6v6" /></svg>
        </Icon>
        <Actions>
            <a class="v3-btn" href="/operations/market-fees/report">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                Report
            </a>
        </Actions>
    </V3Hero>

    <GovernedServiceWorkspace OperationCode="@CollectorOperationCodes.MarketFees" Name="Market Fees" FeeOptionsTitle="Market Fee definitions" VisibleCollectionRows="5" />
</div>
