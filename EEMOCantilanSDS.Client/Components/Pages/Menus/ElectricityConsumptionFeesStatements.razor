@page "/operations/ecf/statements"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@inject IEcfCollectionsApiClient Api

<PageTitle>StallTrack — Electricity Consumption Fees Statements</PageTitle>

@* Statements of account for ECF, owned by the ECF workspace (no dependency on the NPM utility view). Read from the
   same server obligation read as the ECF workspace; nothing here is calculated, recorded or collected. The layout
   owns the <main> landmark. *@
<div class="v3-page">
    @* The hero is screen-only (no-print): the printed statements carry the government letterhead, never this band. *@
    <div class="no-print">
        <V3Hero Compact="true" Eyebrow="Operations · ECF" Title="Electricity Consumption Fees Statements" FiguresLabel="ECF statement totals">
            <Meta><span>@PeriodLabel ·</span> <InstrumentChip Instrument="OR" /> <span>Official Receipt</span></Meta>
            <Figures>
                <V3HeroFigure Label="Statements" Value="@(Ready ? _lines.Select(l => (l.StallId, l.Payor)).Distinct().Count().ToString() : "—")" />
                <V3HeroFigure Label="Assessed" Value="@(Ready ? Money(_lines.Sum(l => l.Assessed)) : "—")" />
                <V3HeroFigure Label="Net settled" Value="@(Ready ? Money(_lines.Sum(l => l.Settled)) : "—")" />
                <V3HeroFigure Label="Balance" Value="@(Ready ? Money(_lines.Sum(l => l.Outstanding)) : "—")" />
            </Figures>
            <Actions><a href="/operations/ecf">ECF workspace</a></Actions>
        </V3Hero>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="no-print" role="alert">
            <p class="v3-notice v3-notice-error v3-notice-row"><span>@_error</span> <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button></p>
            <div class="v3-toolbar">@MonthPicker</div>
        </div>
    }
    else if (_loading)
    {
        <div class="no-print">
            <div class="v3-toolbar">@MonthPicker</div>
            <p role="status">Loading statements…</p>
        </div>
    }
    else
    {
        <UtilityStatements UtilityCode="ECF" UtilityName="Electricity Consumption Fees" InstrumentName="Official Receipt"
                           PeriodLabel="@PeriodLabel" Lines="@_lines" ShowSummary="false" Toolbar="MonthPicker" />
    }
</div>

@code {
    private DateOnly _period = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private List<UtilityStatements.StatementLine> _lines = [];
    private bool _loading = true;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private bool Ready => !_loading && _error is null;
    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";

    private RenderFragment MonthPicker => __builder =>
    {
        <input class="v3-input" type="month" aria-label="Billing month" title="Billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetObligationsAsync(_period.Year, _period.Month);
            if (!result.IsSuccess) { _lines = []; _error = "The statements couldn't be loaded."; return; }
            _lines = (result.Value ?? []).Select(q => new UtilityStatements.StatementLine(
                q.StallId, q.StallNo, q.Section, q.PayerNameSnapshot ?? "Payer snapshot unavailable",
                q.BillingYear, q.BillingMonth, q.AssessedAmount, q.CumulativeSettledEvidence, q.OutstandingAmount, q.FacilityName)).ToList();
        }
        catch { _lines = []; _error = "The statements couldn't be loaded."; }
        finally { _loading = false; }
    }
}
