@page "/operations/weight-and-measure/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Facilities
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject IFacilitiesApiClient FacilitiesApi
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Weight & Measure Report</PageTitle>

@* Weight & Measure report in the standard operation-report shell: the official Monthly Income row, then the weighing evidence NPM
   reports for the month (the amounts frozen on each collection; nothing is re-priced here). The layout owns the main landmark. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader OperationCode="WEIGHT_AND_MEASURE" Parent="Weight & Measure" ParentHref="/operations/weight-and-measure" Title="Weight & Measure Report">
            <Meta><InstrumentChip Instrument="OR" ShowName="true" /></Meta>
            <Actions>
                <label class="v3-period">
                    <span>Month</span>
                    <input class="v3-input" type="month" aria-label="Reporting month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                </label>
                <div class="v3-btn-group" role="group" aria-label="Report actions">
                    <button class="v3-btn" type="button" @onclick="PrintAsync" disabled="@(!Ready)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                        Print
                    </button>
                    @if (Ready)
                    {
                        <a class="v3-btn" href="@ExportHref" download="@($"weight-and-measure-report-{_period:yyyy-MM}.csv")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                            Export CSV
                        </a>
                    }
                    else
                    {
                        <button class="v3-btn" type="button" disabled>Export CSV</button>
                    }
                </div>
            </Actions>
        </WorkspaceHeader>
    </div>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row no-print" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="wmr-title" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="Weight & Measure Report" Period="@($"Reporting month {PeriodLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>Weight & Measure</dd></div>
                <div><dt>Instrument</dt><dd>Official Receipt</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="wmr-title" class="v3-sr-only">Weight & Measure report for @PeriodLabel</h2>

        <OperationMonthlyIncome Classification="Weight & Measure" RowKey="WEIGHT_AND_MEASURE" Year="_period.Year" HeadingId="wmr-official" />

        <section class="v3-report-section" aria-labelledby="wmr-fish">
            <h3 id="wmr-fish">Fish weighing</h3>
            @RegisteredRows(FishMeatVendorType.Fish)
            @if (FacilityCatalog.HasDeclaredFacility(FacilityCode.NPM))
            {
            <h4>Historical NPM evidence</h4>
            <dl class="v3-report-summary">
                <div><dt>Fish weighing (frozen)</dt><dd>@(_report?.FeeTypeBreakdown is { } fish ? Money(fish.FishWeightMeasureFrozenAmount) : "—")</dd></div>
                <div><dt>Fish kilos</dt><dd>@(_report is null ? "—" : Kilos(FishRows.Sum(x => x.FishKilos)))</dd></div>
                <div><dt>Fish kilos without rate evidence</dt><dd>@(_report?.FeeTypeBreakdown is { } unresolved ? Kilos(unresolved.FishKilosWithoutFrozenRate) : "—")</dd></div>
            </dl>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Occupant</th>
                            <th scope="col">Stall</th>
                            <th scope="col" class="v3-num">Kilos weighed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FishRows)
                        {
                            <tr>
                                <td>@Occupant(row)</td>
                                <td>@row.StallNo@(string.IsNullOrWhiteSpace(row.Section) ? "" : $" · {row.Section}")</td>
                                <td class="v3-num">@Kilos(row.FishKilos)</td>
                            </tr>
                        }
                        @if (!FishRows.Any())
                        {
                            <tr><td colspan="3" class="v3-report-note">@(_loading ? "Loading weighing records…" : _report is null ? "Weighing records are unavailable." : $"No fish weighing was recorded in {PeriodLabel}.")</td></tr>
                        }
                    </tbody>
                    @if (FishRows.Any())
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="2">Total · @FishRows.Count() stall@(FishRows.Count() == 1 ? "" : "s")</th>
                                <td class="v3-num">@Kilos(FishRows.Sum(x => x.FishKilos))</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            }
        </section>
        <section class="v3-report-section" aria-labelledby="wmr-meat">
            <h3 id="wmr-meat">Meat weighing</h3>
            @RegisteredRows(FishMeatVendorType.Meat)
            @if (FacilityCatalog.HasDeclaredFacility(FacilityCode.NPM))
            {
                <h4>Historical NPM evidence</h4>
                <dl class="v3-report-summary">
                    <div><dt>Meat weighing (frozen)</dt><dd>@(_report?.FeeTypeBreakdown is { } meat ? Money(meat.MeatWeightMeasureAmount) : "—")</dd></div>
                    <div><dt>Meat kilos</dt><dd>@(_report?.FeeTypeBreakdown is { } kilos ? Kilos(kilos.MeatKilos) : "—")</dd></div>
                </dl>
            }
        </section>
    </article>
</div>

@code {
    private RenderFragment RegisteredRows(FishMeatVendorType type) => @<div class="v3-table-wrap">
        <table class="v3-report-table" aria-label="Registered @type weighing">
            <caption class="v3-panel-meta">Registered @type collections · @PeriodLabel</caption>
            <thead><tr><th scope="col">Date</th><th scope="col">SRC</th><th scope="col">Vendor</th><th scope="col" class="v3-num">Kilos</th><th scope="col" class="v3-num">Rate/kg</th><th scope="col" class="v3-num">Net amount</th><th scope="col">Status</th></tr></thead>
            <tbody>
                @foreach (var row in (_sourceReport?.Rows ?? []).Where(x => x.VendorType == type))
                {
                    <tr><td>@row.BusinessDate.ToString("MMM d")</td><td><a href="@($"/collections/activity?src={Uri.EscapeDataString(row.ReferenceCode)}")">@row.ReferenceCode</a></td><td>@row.Vendor</td><td class="v3-num">@Kilos(row.Kilograms)</td><td class="v3-num">@Money(row.RatePerKilo)</td><td class="v3-num">@Money(row.NetAmount)</td><td>@row.Status</td></tr>
                }
                @if (_sourceReport is null || !_sourceReport.Rows.Any(x => x.VendorType == type))
                {
                    <tr><td colspan="7" class="v3-report-note">@(_loading ? "Loading weighing records…" : _sourceReport is null ? "Registered-vendor weighing unavailable." : "No registered-vendor weighing was recorded for this month.")</td></tr>
                }
            </tbody>
        </table>
    </div>;

    private DateOnly _period = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private FacilityReportsDto? _report;
    private WeighingCollectionReportDto? _sourceReport;
    private bool _loading = true;
    private int _loadVersion;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private bool Ready => !_loading && _error is null && _sourceReport is not null;

    /// <summary>NPM stalls that carry fish weighing evidence for the month, as the server reports them.</summary>
    private IEnumerable<StallComplianceDto> FishRows =>
        (_report?.StallCompliance ?? []).Where(x => x.FishKilos > 0m).OrderBy(x => x.StallNo, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var period = _period;
        _loading = true;
        _error = null;
        _sourceReport = null;
        _report = null;
        try
        {
            var source = await FacilitiesApi.GetWeighingSourceNativeReportAsync(period.Year, period.Month);
            if (version != _loadVersion) return;
            _sourceReport = source.IsSuccess ? source.Value : null;
            if (!source.IsSuccess) _error = source.Error ?? "Registered-vendor weighing records couldn't be loaded.";
            if (!FacilityCatalog.HasDeclaredFacility(FacilityCode.NPM)) return;
            var report = await FacilitiesApi.GetFacilityReportsAsync(FacilityCode.NPM, ReportPeriod.Monthly, period.Year, period.Month);
            if (version != _loadVersion) return;
            if (report.IsSuccess) _report = report.Value;
            else { _report = null; _error ??= "NPM weighing records couldn't be loaded."; }
        }
        catch
        {
            if (version != _loadVersion) return;
            _report = null;
            _error = "Weighing records couldn't be loaded.";
        }
        finally { if (version == _loadVersion) _loading = false; }
    }

    private async Task PrintAsync()
    {
        if (Ready) await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");
    }

    private string ExportHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    private string BuildCsv()
    {
        var rows = new List<string>
        {
            Csv("Report", "Weight & Measure Report"),
            Csv("Office", Branding.OfficeName),
            Csv("Municipality", $"{Branding.Municipality}, {Branding.Province}"),
            Csv("Reporting month", PeriodLabel),
            Csv("Classification", "Weight & Measure"),
            Csv("Instrument", "Official Receipt"),
            Csv("Date prepared", PhilippineTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
            string.Empty,
            Csv("Registered vendor date", "Reference", "Vendor", "Type", "Kilograms", "Frozen rate/kg", "Net amount", "Status"),
        };
        rows.AddRange((_sourceReport?.Rows ?? []).Select(x => Csv(x.BusinessDate.ToString("yyyy-MM-dd"), x.ReferenceCode,
            x.Vendor, x.VendorType.ToString(), x.Kilograms.ToString("0.00", CultureInfo.InvariantCulture),
            x.RatePerKilo.ToString("0.00", CultureInfo.InvariantCulture), x.NetAmount.ToString("0.00", CultureInfo.InvariantCulture), x.Status)));
        rows.Add(string.Empty);
        if (_report?.FeeTypeBreakdown is { } historical)
        {
            rows.Add(Csv("Historical NPM frozen Fish amount", historical.FishWeightMeasureFrozenAmount.ToString("0.00", CultureInfo.InvariantCulture)));
            rows.Add(Csv("Historical NPM Fish kilos without rate evidence", historical.FishKilosWithoutFrozenRate.ToString("0.00", CultureInfo.InvariantCulture)));
            rows.Add(Csv("Historical NPM frozen Meat amount", historical.MeatWeightMeasureAmount.ToString("0.00", CultureInfo.InvariantCulture)));
            rows.Add(Csv("Historical NPM Meat kilos", historical.MeatKilos.ToString("0.00", CultureInfo.InvariantCulture)));
        }
        rows.Add(Csv("Historical NPM occupant", "Stall", "Section", "Fish kilos weighed"));
        rows.AddRange(FishRows.Select(x => Csv(Occupant(x), x.StallNo, x.Section, x.FishKilos.ToString("0.00", CultureInfo.InvariantCulture))));
        return string.Join("\r\n", rows);
    }

    private static string Csv(params string?[] values) =>
        string.Join(",", values.Select(v => $"\"{(v ?? string.Empty).Replace("\"", "\"\"")}\""));

    private static string Occupant(StallComplianceDto row) =>
        string.IsNullOrWhiteSpace(row.Occupant) ? row.ContractName : row.Occupant;

    private static string Kilos(decimal kilos) => $"{kilos:N2} kg";
    private static string Money(decimal amount) => $"₱{amount:N2}";
}
