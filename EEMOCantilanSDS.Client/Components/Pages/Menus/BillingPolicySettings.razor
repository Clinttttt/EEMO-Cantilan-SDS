@page "/settings/billing-policy"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject IBillingPolicyApiClient BillingPolicyApi
@inject ISettingsApiClient SettingsApi

<PageTitle>StallTrack — Billing Policy</PageTitle>

@* The rules this office bills monthly rent by. StallTrack Rules (IA-071, IA-072) the Head can change, not rulings of any one office. The server validates and applies them; nothing is calculated here. *@
<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-title">Billing Policy</div>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <a class="breadcrumb-link" href="/settings">Settings</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Billing Policy</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @PhilippineTime.Now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">
    <div class="v3-page bp-page">
        @if (_loading)
        {
            <p class="v3-notice" role="status">Loading billing policy…</p>
        }
        else if (_page is null)
        {
            <div class="v3-notice v3-notice-error" role="alert">
                <p>The billing policy couldn't be loaded.</p>
                <button type="button" class="v3-btn" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else
        {
            <section class="v3-panel" aria-labelledby="bp-now">
                <header class="v3-panel-header">
                    <h2 id="bp-now">Current policy</h2>
                    <span class="v3-panel-meta">@(_page.InForce is { } version ? $"Effective {version.EffectiveFrom:MMMM d, yyyy}" : "StallTrack defaults")</span>
                    @* The policy reads as a statement; the Head opens the amendment form only to change it. *@
                    <AuthorizeView Roles="SuperAdmin"><Authorized>
                        @if (!_editing) {
                            <button type="button" class="v3-btn v3-btn-sm bp-edit" @onclick="StartEdit">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                Edit
                            </button>
                        }
                    </Authorized></AuthorizeView>
                </header>
                @* The policy in three groups side by side, the standing definitions in a quiet band beneath. Edit turns the groups into the same three columns of fields. *@
                @if (!_editing)
                {
                    <div class="bp-groups bp-terms">
                        <div class="bp-group">
                            <h3>Payment terms</h3>
                            <dl class="bp-list">
                                <div><dt>Due date</dt><dd>@DueLabel(_page.Current)</dd></div>
                                <div><dt>Grace period</dt><dd>@Days(_page.Current.GraceDays)</dd></div>
                                <div><dt>Payment order</dt><dd>@(_page.Current.OldestMonthFirst ? "Oldest month first" : "Any open month")</dd></div>
                                <div><dt>Counted from</dt><dd>@_page.Current.CountsMonthsFrom.ToString("MMMM yyyy")</dd></div>
                            </dl>
                        </div>
                        <div class="bp-group">
                            <h3>Advance payment</h3>
                            <dl class="bp-list">
                                <div><dt>Pay ahead</dt><dd>@(_page.Current.MaxAdvanceMonths == 0 ? "Not taken" : $"Up to {Months(_page.Current.MaxAdvanceMonths)}")</dd></div>
                                <div><dt>Whole-year payment</dt><dd>@(_page.Current.AnnualPaymentAllowed ? "Allowed" : "Not allowed")</dd></div>
                            </dl>
                        </div>
                        <div class="bp-group">
                            <h3>Late charges</h3>
                            @if (!_page.Current.ChargesPenalty)
                            {
                                <p class="bp-group-note">Not configured. Nothing is charged.</p>
                            }
                            else
                            {
                                <dl class="bp-list">
                                    <div><dt>Surcharge</dt><dd>@SurchargeLabel(_page.Current)</dd></div>
                                    <div><dt>Interest</dt><dd>@(_page.Current.ChargesInterest ? $"{_page.Current.InterestPercent:0.##}% a month" : "None")</dd></div>
                                    @if (_page.Current is { ChargesInterest: true, InterestMaxMonths: { } most })
                                    {
                                        <div><dt>Interest stops after</dt><dd>@Months(most)</dd></div>
                                    }
                                    @if (_page.InForce?.GoverningReference is { } authority)
                                    {
                                        <div><dt>Authority</dt><dd>@authority</dd></div>
                                    }
                                </dl>
                            }
                        </div>
                    </div>
                    @if (_definitions is { } definitions)
                    {
                        <dl class="bp-defs">
                            <div><dt>Delinquent</dt><dd>@definitions.DelinquentThresholdMonths+ overdue month@(definitions.DelinquentThresholdMonths == 1 ? "" : "s") this year</dd></div>
                            <div><dt>Arrears</dt><dd>Earlier years, expired or ended contracts, per obligation</dd></div>
                        </dl>
                    }
                    else
                    {
                        <p class="bp-defs" role="status">The Delinquent and Arrears definitions could not be loaded.</p>
                    }
                }
                @* Edit: the same three columns, each value now its field. One amendment covers all three, recorded whole from one effective date. *@
                <AuthorizeView Roles="SuperAdmin">
                    <Authorized>
                        @if (_editing) {
                        <form class="bp-form" aria-label="Amend policy" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                            <div class="bp-groups">
                                <div class="bp-group" role="group" aria-labelledby="bp-terms-h">
                                    <h3 id="bp-terms-h">Payment terms</h3>
                                    <label class="v3-field"><span>Due day</span>
                                        <select @bind="_dueDay">
                                            <option value="">Last day of the month</option>
                                            @for (var d = 1; d <= 31; d++)
                                            {
                                                <option value="@d">Day @d</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="v3-field"><span>Grace period</span>
                                        <span class="bp-affix"><input type="number" min="0" max="90" @bind="_graceDays" /><span class="bp-unit">days</span></span>
                                    </label>
                                    <label class="v3-field"><span>Count unpaid months from</span><input type="month" required @bind="_countsFrom" /></label>
                                    <label class="bp-switch"><span>Oldest month first</span><input type="checkbox" role="switch" @bind="_oldestFirst" /><span class="bp-track" aria-hidden="true"></span></label>
                                </div>

                                <div class="bp-group" role="group" aria-labelledby="bp-advance-h">
                                    <h3 id="bp-advance-h">Advance payment</h3>
                                    <label class="v3-field"><span>Pay ahead up to</span>
                                        <span class="bp-affix"><input type="number" min="0" max="12" @bind="_maxAdvance" /><span class="bp-unit">months</span></span>
                                    </label>
                                    <label class="bp-switch"><span>Allow whole-year payment</span><input type="checkbox" role="switch" @bind="_annual" /><span class="bp-track" aria-hidden="true"></span></label>
                                </div>

                                <div class="bp-group" role="group" aria-labelledby="bp-penalty-h">
                                    <h3 id="bp-penalty-h">Late charges</h3>
                                    <label class="v3-field"><span>Surcharge</span>
                                        <span class="bp-affix"><input type="number" min="0.01" max="100" step="0.01" placeholder="None" @bind="_surcharge" /><span class="bp-unit">% once</span></span>
                                    </label>
                                    <label class="v3-field"><span>Interest</span>
                                        <span class="bp-affix"><input type="number" min="0.01" max="100" step="0.01" placeholder="None" @bind="_interest" /><span class="bp-unit">% a month</span></span>
                                    </label>
                                    @if (_interest > 0m)
                                    {
                                        <label class="v3-field"><span>Interest stops after</span>
                                            <span class="bp-affix"><input type="number" min="1" max="360" step="1" @bind="_interestMonths" /><span class="bp-unit">months</span></span>
                                        </label>
                                    }
                                    @if (Charges)
                                    {
                                        <label class="v3-field bp-grow"><span>Authority</span><input type="text" maxlength="200" placeholder="Ordinance or resolution" @bind="_reference" /></label>
                                    }
                                </div>
                            </div>

                            @if (_error is not null) { <p class="v3-notice v3-notice-error" role="alert">@_error</p> }
                            <div class="bp-form-foot">
                                <label class="v3-field"><span>Effective from</span><input type="date" min="@_page.Today.ToString("yyyy-MM-dd")" @bind="_effectiveFrom" /></label>
                                <button type="button" class="v3-btn" disabled="@_saving" @onclick="CancelEdit">Cancel</button>
                                <button type="submit" class="v3-btn v3-btn-primary" disabled="@_saving">Record amendment</button>
                            </div>
                        </form>
                        }
                    </Authorized>
                </AuthorizeView>
            </section>

            @if (_saved) { <p class="v3-notice" role="status">The billing policy was recorded.</p> }

            <section class="v3-panel" aria-labelledby="bp-history">
                <header class="v3-panel-header"><h2 id="bp-history">Amendment history</h2></header>
                @if (_page.Versions.Count == 0)
                {
                    <p class="bp-empty">No amendments recorded. The StallTrack defaults apply.</p>
                }
                else
                {
                    <div class="v3-table-wrap" tabindex="0">
                        @* One row per amendment, in the same three groups as the policy above: each group's headline, its detail beneath. *@
                        <table class="v3-table bp-history">
                            <thead><tr><th scope="col">Effective</th><th scope="col">Payment terms</th><th scope="col">Advance payment</th><th scope="col">Late charges</th></tr></thead>
                            <tbody>
                                @foreach (var v in _page.Versions)
                                {
                                    <tr>
                                        <td>
                                            <span class="bp-cell-main">@v.EffectiveFrom.ToString("MMM d, yyyy")</span>
                                            @if (v.Id == _page.InForce?.Id)
                                            {
                                                <span class="bp-cell-sub bp-in-force">In force</span>
                                            }
                                            else if (v.EffectiveFrom > _page.Today)
                                            {
                                                <span class="bp-cell-sub">Scheduled</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="bp-cell-main">@DueLabel(v.Rules) · @(v.Rules.GraceDays == 0 ? "no grace" : $"{Days(v.Rules.GraceDays)} grace")</span>
                                            <span class="bp-cell-sub">@(v.Rules.OldestMonthFirst ? "Oldest month first" : "Any open month") · from @v.Rules.CountsMonthsFrom.ToString("MMM yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="bp-cell-main">@(v.Rules.MaxAdvanceMonths == 0 ? "Not taken" : $"Up to {Months(v.Rules.MaxAdvanceMonths)}")</span>
                                            <span class="bp-cell-sub">@(v.Rules.AnnualPaymentAllowed ? "Whole year allowed" : "No whole-year payment")</span>
                                        </td>
                                        <td>
                                            <span class="bp-cell-main">@PenaltyLabel(v.Rules)</span>
                                            @if (LateDetail(v) is { Length: > 0 } detail)
                                            {
                                                <span class="bp-cell-sub">@detail</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private BillingPolicyPageDto? _page;
    private EEMOCantilanSDS.Application.Dtos.Settings.CollectionRulesDto? _definitions;
    private bool _loading = true, _saving, _saved;
    private string? _error;
    private int? _dueDay;
    private int _graceDays, _maxAdvance;
    private bool _oldestFirst, _annual;
    // Late charges (ruled 2026-11-24, RA 7160 Sec. 168): a one-time surcharge on the unpaid rent, then interest each month on the rent and surcharge.
    private decimal? _surcharge, _interest;
    private int? _interestMonths;
    private bool Charges => _surcharge > 0m || _interest > 0m;
    private string? _reference;
    private DateOnly _effectiveFrom, _countsFrom;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await BillingPolicyApi.GetAsync();
            Show(result.IsSuccess ? result.Value : null);
            await LoadDefinitionsAsync();
        }
        catch
        {
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // Best-effort: the rules above stay usable if these cannot be read, and the panel says so.
    private async Task LoadDefinitionsAsync()
    {
        try
        {
            var settings = await SettingsApi.GetSystemSettingsAsync();
            _definitions = settings?.IsSuccess == true ? settings.Value?.Collection : null;
        }
        catch { _definitions = null; }
    }

    private void Show(BillingPolicyPageDto? page)
    {
        _page = page;
        if (page is null) return;
        var rules = page.Current;
        (_dueDay, _graceDays, _maxAdvance, _oldestFirst, _annual) = (rules.DueDay, rules.GraceDays, rules.MaxAdvanceMonths, rules.OldestMonthFirst, rules.AnnualPaymentAllowed);
        _surcharge = rules.PenaltyBasis == LatePenaltyBasis.PercentOfUnpaid ? Plain(rules.PenaltyValue) : null;
        (_interest, _interestMonths) = (Plain(rules.InterestPercent), rules.InterestMaxMonths ?? 36);
        _reference = page.InForce?.GoverningReference;
        _effectiveFrom = page.Today;
        _countsFrom = rules.CountsMonthsFrom;
    }

    private bool _editing;
    private void StartEdit() { _editing = true; _saved = false; _error = null; }
    // Cancel puts the fields back to the policy in force, so a reopened form never carries an abandoned edit.
    private void CancelEdit() { _editing = false; _error = null; Show(_page); }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;
        try
        {
            var surcharge = _surcharge > 0m ? _surcharge : null;
            var interest = _interest > 0m ? _interest : null;
            var rules = new BillingPolicy(_dueDay, _graceDays, _oldestFirst, _maxAdvance, _annual,
                surcharge is null ? LatePenaltyBasis.None : LatePenaltyBasis.PercentOfUnpaid, surcharge, false, null, _countsFrom,
                interest, interest is null ? null : _interestMonths);
            var result = await BillingPolicyApi.RecordAsync(new(_effectiveFrom, rules, Charges ? _reference : null));
            if (result.IsSuccess && result.Value is not null)
            {
                Show(result.Value);
                _saved = true;
                _editing = false;
            }
            else
            {
                _error = result.Error ?? "The billing policy could not be recorded.";
            }
        }
        catch
        {
            _error = "The billing policy could not be recorded. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string DueLabel(BillingPolicy rules) => rules.DueDay is { } day ? $"Day {day}" : "Last day of the month";

    private static string Days(int days) => days == 0 ? "None" : days == 1 ? "1 day" : $"{days} days";

    // Drops trailing zeros, so a stored 25.00 reads 25 in its field.
    private static decimal? Plain(decimal? value) => value / 1.000000000000000000000000000000000m;

    private static string Months(int months) => months == 1 ? "1 month" : $"{months} months";

    // Under an amendment's late charges: how long interest runs, and the authority it rests on.
    private static string LateDetail(BillingPolicyVersionDto version) => string.Join(" · ", new[]
    {
        version.Rules is { ChargesInterest: true, InterestMaxMonths: { } most } ? $"Interest up to {Months(most)}" : null,
        version.GoverningReference,
    }.OfType<string>());

    // The surcharge alone, for its own row; an older policy's repeating or fixed penalty reads in the same row.
    private static string SurchargeLabel(BillingPolicy rules)
    {
        if (!rules.ChargesSurcharge) return "None";
        var rate = rules.PenaltyBasis == LatePenaltyBasis.PercentOfUnpaid ? $"{rules.PenaltyValue:0.##}%" : $"₱{rules.PenaltyValue:N2}";
        var when = rules.PenaltyRepeatsMonthly ? " each month unpaid" : " once";
        return rules.PenaltyMonthCap is { } cap ? $"{rate}{when}, at most ₱{cap:N2} a month" : rate + when;
    }

    private static string PenaltyLabel(BillingPolicy rules)
    {
        if (!rules.ChargesPenalty) return "Not configured";
        if (rules.ChargesInterest)
        {
            var surcharge = !rules.ChargesSurcharge ? null
                : rules.PenaltyBasis == LatePenaltyBasis.PercentOfUnpaid ? $"{rules.PenaltyValue:0.##}% surcharge once" : $"₱{rules.PenaltyValue:N2} surcharge once";
            var interest = $"{rules.InterestPercent:0.##}% a month";
            return surcharge is null ? $"{interest} interest" : $"{surcharge} + {interest}";
        }
        var rate = rules.PenaltyBasis == LatePenaltyBasis.PercentOfUnpaid ? $"{rules.PenaltyValue:0.##}% of the unpaid rent" : $"₱{rules.PenaltyValue:N2}";
        var repeats = rules.PenaltyRepeatsMonthly ? ", each month unpaid" : ", once";
        return rules.PenaltyMonthCap is { } cap ? $"{rate}{repeats}, at most ₱{cap:N2} a month" : rate + repeats;
    }
}
