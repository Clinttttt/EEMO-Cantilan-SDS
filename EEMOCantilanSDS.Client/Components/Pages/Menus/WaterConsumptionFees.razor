@page "/operations/water-consumption-fees"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IWcfCollectionsApiClient WcfApi
@inject ICollectorsApiClient CollectorsApi
@inject IJSRuntime JS

<PageTitle>StallTrack — Water Consumption Fees</PageTitle>

<main class="wcf-page">
    <nav class="wcf-breadcrumb" aria-label="Breadcrumb">
        <a href="/operations">Operations</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Water Consumption Fees</span>
    </nav>

    <FacilityHero Eyebrow="@($"{Branding.OfficeAcronym} Admin · Operations · WCF")"
                  Title="Water Consumption Fees"
                  Subtitle="Water obligations and Cash Ticket collection readiness from the utility register."
                  Icon="@WaterIcon"
                  Stats="HeroStats" />

    <section class="wcf-desk" aria-labelledby="wcf-desk-title">
        <div class="wcf-desk-copy">
            <p class="wcf-eyebrow">COLLECTIBLE WATER OBLIGATIONS THROUGH</p>
            <h2 id="wcf-desk-title">@ThroughPeriodLabel</h2>
            <p>Older unpaid WCF periods remain visible. Billing period is separate from the collection business date.</p>
        </div>
        <div class="wcf-desk-actions">
            <label class="wcf-filter-control">
                <span class="wcf-sr-only">Show obligations through billing month</span>
                <input type="month" aria-label="Show obligations through billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            </label>
            <div class="wcf-instrument" aria-label="WCF policy resolves to Cash Ticket">
                <span class="wcf-ct-chip">CT</span>
                <strong>Cash Ticket</strong>
            </div>
            <button class="wcf-button wcf-button-secondary" type="button" @onclick="LoadAsync" disabled="@_busy">Refresh sources</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="wcf-notice" role="status">@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="wcf-notice wcf-notice-error" role="alert">@_error</div>
    }
    @if (_busy && _quotes.Count == 0)
    {
        <div class="wcf-notice" role="status">Loading authoritative UtilityBill Water sources…</div>
    }

    <div class="wcf-main-grid">
        <section class="wcf-panel wcf-assessments-panel" aria-labelledby="wcf-assessments-title">
            <header class="wcf-panel-header">
                <div>
                    <p class="wcf-eyebrow">UTILITYBILL / WATER</p>
                    <h2 id="wcf-assessments-title">WCF Obligations</h2>
                    <p>Assessment, readings, rate, prior settlement evidence, and outstanding balance are server-derived.</p>
                </div>
                <div class="wcf-assessment-header-actions">
                    <span class="wcf-period-tag">@_quotes.Count source@(_quotes.Count == 1 ? "" : "s")</span>
                </div>
            </header>

            <div class="wcf-toolbar" aria-label="WCF source filters">
                <label class="wcf-search-control">
                    <span class="wcf-sr-only">Search payer, stall, or facility</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                    <input type="search" placeholder="Search payer, stall, or facility…" aria-label="Search WCF sources" @bind="_searchText" @bind:event="oninput" />
                </label>
            </div>

            <div class="wcf-table-wrap wcf-assessment-scroll" role="region" aria-label="WCF obligation sources" tabindex="0">
                <table class="wcf-table wcf-assessment-table">
                    <caption class="wcf-sr-only">Water obligations through @ThroughPeriodLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col">Payer / Source</th>
                            <th scope="col">Period · meter</th>
                            <th scope="col" class="wcf-number">Assessed</th>
                            <th scope="col" class="wcf-number">Previously settled</th>
                            <th scope="col" class="wcf-number">Outstanding</th>
                            <th scope="col">Authority</th>
                            <th scope="col">Collection</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quote in FilteredQuotes)
                        {
                            <tr>
                                <td class="wcf-occupant-cell">
                                    <strong class="wcf-account-name">@(quote.PayerNameSnapshot ?? "Payer snapshot unavailable")</strong>
                                    <span class="wcf-account-area">@quote.FacilityName · Stall @quote.StallNo@(string.IsNullOrWhiteSpace(quote.Section) ? "" : $" · {quote.Section}")</span>
                                </td>
                                <td>@Period(quote.BillingYear, quote.BillingMonth)<span class="wcf-account-area">@quote.Consumption.ToString("N2") m³ × PHP @quote.RatePerCubicMeter.ToString("N2")</span></td>
                                <td class="wcf-number">@Money(quote.AssessedAmount)</td>
                                <td class="wcf-number">@Money(quote.CumulativeSettledEvidence)</td>
                                <td class="wcf-number wcf-balance">@Money(quote.OutstandingAmount)</td>
                                <td><span class="wcf-period-tag">@quote.SettlementAuthority</span></td>
                                <td>
                                    @if (quote.CanCollectCanonical && quote.OutstandingAmount > 0m && _tickets.Count > 0)
                                    {
                                        <button class="wcf-button wcf-button-primary" type="button" @onclick="() => OpenCollection(quote)">Collect with CT</button>
                                    }
                                    else if (quote.SettlementAuthority == SettlementAuthority.Legacy)
                                    {
                                        <span>Awaiting controlled cutover</span>
                                    }
                                    else if (quote.SettlementAuthority == SettlementAuthority.PendingCutover)
                                    {
                                        <span>Reconciliation in progress</span>
                                    }
                                    else if (quote.OutstandingAmount <= 0m)
                                    {
                                        <span>Settled</span>
                                    }
                                    else
                                    {
                                        <span>No available CT</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!FilteredQuotes.Any())
                        {
                            <tr><td class="wcf-empty-cell" colspan="7">No collectible UtilityBill Water obligations were found through @ThroughPeriodLabel.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="wcf-table-footer">
                <span>@FilteredQuotes.Count() WCF source@(@FilteredQuotes.Count() == 1 ? "" : "s")</span>
                <span>Assessment authority remains UtilityBill / Water</span>
            </footer>
        </section>

        <aside class="wcf-panel wcf-summary-panel" aria-labelledby="wcf-summary-title">
            <header class="wcf-panel-header">
                <div>
                    <p class="wcf-eyebrow">SERVER-DERIVED POSITION</p>
                    <h2 id="wcf-summary-title">WCF balances</h2>
                    <p>Obligations through @ThroughPeriodLabel</p>
                </div>
            </header>
            <dl class="wcf-summary-list">
                <div class="wcf-summary-emphasis"><dt>Assessed</dt><dd>@Money(_quotes.Sum(x => x.AssessedAmount))</dd></div>
                <div><dt>Previously settled evidence</dt><dd>@Money(_quotes.Sum(x => x.CumulativeSettledEvidence))</dd></div>
                <div class="wcf-summary-outstanding"><dt>Outstanding</dt><dd>@Money(_quotes.Sum(x => x.OutstandingAmount))</dd></div>
                <div><dt>Obligations with balance</dt><dd>@_quotes.Count(x => x.OutstandingAmount > 0m)</dd></div>
                <div><dt>Assigned / in-office CTs available</dt><dd>@_tickets.Count</dd></div>
                <div><dt>Settlement activation</dt><dd>Not activated</dd></div>
                <div><dt>Instrument</dt><dd><span class="wcf-inline-ct">CT</span> Cash Ticket</dd></div>
            </dl>
            <p class="wcf-account-area">Previously settled evidence is a source balance fact; it is not counted as new Collection Activity.</p>
        </aside>
    </div>

    <section class="wcf-panel wcf-custody-panel" aria-labelledby="wcf-custody-title">
        <header class="wcf-panel-header">
            <div>
                <p class="wcf-eyebrow">HEAD / ADMIN CUSTODY</p>
                <h2 id="wcf-custody-title">Cash Ticket books and assignments</h2>
                <p>Register received physical ranges, assign unused tickets to an active collector, and inspect unit custody.</p>
            </div>
        </header>
        <div class="wcf-custody-grid">
            <form class="wcf-custody-form" @onsubmit="ReceiveBookAsync" @onsubmit:preventDefault="true">
                <h3>Receive Cash Ticket range</h3>
                <label class="wcf-field">Series name<input required maxlength="80" @bind="_seriesName" /></label>
                <label class="wcf-field">Number prefix<input required maxlength="20" @bind="_numberPrefix" /></label>
                <div class="wcf-form-grid">
                    <label class="wcf-field">First serial<input type="number" min="0" @bind="_firstSerial" /></label>
                    <label class="wcf-field">Last serial<input type="number" min="0" @bind="_lastSerial" /></label>
                    <label class="wcf-field">Serial width<input type="number" min="1" max="12" @bind="_serialWidth" /></label>
                </div>
                <button class="wcf-button wcf-button-primary" type="submit" disabled="@_busy">Receive book</button>
            </form>
            <form class="wcf-custody-form" @onsubmit="AssignRangeAsync" @onsubmit:preventDefault="true">
                <h3>Assign unused range</h3>
                <label class="wcf-field">Cash Ticket book
                    <select @bind="_assignmentBookId">
                        <option value="">Select book</option>
                        @foreach (var book in CashTicketBooks)
                        {
                            <option value="@book.BookId">@book.SeriesName · @book.NumberPrefix@book.FirstSerialNumber–@book.LastSerialNumber</option>
                        }
                    </select>
                </label>
                <label class="wcf-field">Collector
                    <select @bind="_assignmentCollectorId">
                        <option value="">Select active collector</option>
                        @foreach (var collector in _collectors.Where(x => x.IsActive))
                        {
                            <option value="@collector.Id">@collector.FullName · @collector.EmployeeId</option>
                        }
                    </select>
                </label>
                <div class="wcf-form-grid">
                    <label class="wcf-field">First serial<input type="number" min="0" @bind="_assignmentFirstSerial" /></label>
                    <label class="wcf-field">Last serial<input type="number" min="0" @bind="_assignmentLastSerial" /></label>
                </div>
                <button class="wcf-button wcf-button-secondary" type="submit" disabled="@_busy">Assign range</button>
            </form>
        </div>
        <div class="wcf-table-wrap" role="region" aria-label="Cash Ticket book custody" tabindex="0">
            <table class="wcf-table wcf-activity-table">
                <thead><tr><th scope="col">Book</th><th scope="col">Ticket</th><th scope="col">Custody state</th><th scope="col">Assigned collector</th></tr></thead>
                <tbody>
                    @foreach (var book in CashTicketBooks)
                    {
                        @foreach (var ticket in book.Documents)
                        {
                            <tr>
                                <td>@book.SeriesName</td>
                                <td>@ticket.DocumentNumber</td>
                                <td>@ticket.State</td>
                                <td>@(ticket.AssignedUserId is { } userId ? _collectors.FirstOrDefault(x => x.Id == userId)?.FullName ?? "Assigned user" : "Office custody")</td>
                            </tr>
                        }
                    }
                    @if (!CashTicketBooks.SelectMany(x => x.Documents).Any())
                    {
                        <tr><td class="wcf-empty-cell" colspan="4">No Cash Ticket books are registered for this tenant.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="wcf-panel wcf-activity-panel" aria-labelledby="wcf-activity-title">
        <header class="wcf-panel-header wcf-activity-header">
            <div>
                <p class="wcf-eyebrow">CANONICAL COLLECTION EVENTS</p>
                <h2 id="wcf-activity-title">WCF Collection Activity</h2>
                <p>Each row is one posted Collection. Expand it to inspect the WCF line and source snapshot.</p>
            </div>
        </header>
        <div class="wcf-table-wrap" role="region" aria-label="Canonical WCF collection activity" tabindex="0">
            <table class="wcf-table wcf-activity-table">
                <caption class="wcf-sr-only">WCF Collections for @ThroughPeriodLabel</caption>
                <thead><tr><th scope="col">Business date</th><th scope="col">Cash Ticket / payer</th><th scope="col">Disposition</th><th scope="col" class="wcf-number">Total</th><th scope="col">Details</th></tr></thead>
                <tbody>
                    @foreach (var item in _activity)
                    {
                        <tr>
                            <td>@item.BusinessDate.ToString("dd MMM yyyy")<span class="wcf-account-area">Recorded @PhilippineTime.ToPhilippineTime(item.RecordedAtUtc).ToString("HH:mm") PHT</span></td>
                            <td><strong>@item.DocumentNumber</strong><span class="wcf-account-area">@(item.PayerName ?? "No payer snapshot")</span></td>
                            <td><span class="wcf-activity-kind">@item.Disposition</span></td>
                            <td class="wcf-number">@Money(item.TotalAmount)</td>
                            <td>
                                <details>
                                    <summary>@item.ItemCount item@(item.ItemCount == 1 ? "" : "s")</summary>
                                    <ul class="wcf-detail-list">
                                        @foreach (var line in item.Lines)
                                        {
                                            <li>
                                                <strong>@line.ClassificationName</strong> — @Money(line.Amount)
                                                <span>@(line.BillingYear is { } year && line.BillingMonth is { } month ? Period(year, month) + " obligation" : "WCF obligation") · @(line.SourceLabel ?? "UtilityBill / Water")</span>
                                                <span>@(string.IsNullOrWhiteSpace(line.CalculationSnapshot) ? "Frozen Water source and meter calculation snapshot" : line.CalculationSnapshot)</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </td>
                        </tr>
                    }
                    @if (_activity.Count == 0)
                    {
                        <tr><td class="wcf-empty-cell" colspan="5">No canonical WCF Collections were posted in this business-date period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="wcf-panel wcf-activity-panel" aria-labelledby="wcf-reconciliation-title">
        <header class="wcf-panel-header wcf-activity-header">
            <div>
                <p class="wcf-eyebrow">PHYSICAL DOCUMENT EXCEPTIONS</p>
                <h2 id="wcf-reconciliation-title">Cash Ticket reconciliation</h2>
                <p>Issued tickets that could not be accepted as canonical collections remain unavailable and require office review.</p>
            </div>
        </header>
        <div class="wcf-table-wrap" role="region" aria-label="WCF reconciliation exceptions" tabindex="0">
            <table class="wcf-table wcf-activity-table">
                <thead><tr><th scope="col">Recorded</th><th scope="col">Ticket</th><th scope="col">Operation</th><th scope="col">Reason</th><th scope="col">Evidence</th></tr></thead>
                <tbody>
                    @foreach (var exception in _exceptions)
                    {
                        <tr>
                            <td>@PhilippineTime.ToPhilippineTime(exception.RecordedAtUtc).ToString("dd MMM yyyy HH:mm") PHT</td>
                            <td>@(exception.DocumentNumber ?? "Document identity unresolved")</td>
                            <td>@ShortId(exception.ClientOperationId)</td>
                            <td>@exception.OutcomeCode</td>
                            <td>@exception.OutcomeDetails</td>
                        </tr>
                    }
                    @if (_exceptions.Count == 0)
                    {
                        <tr><td class="wcf-empty-cell" colspan="5">No WCF reconciliation exceptions are currently recorded.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>

@if (_collectionQuote is not null)
{
    <div class="wcf-modal-backdrop" role="presentation" @onclick="CloseCollection">
        <section class="wcf-modal wcf-payment-modal" role="dialog" aria-modal="true" aria-labelledby="wcf-collect-title" @onclick:stopPropagation="true">
            <header class="wcf-modal-header">
                <span class="wcf-inline-ct">CT</span>
                <h2 id="wcf-collect-title">Review WCF Cash Ticket collection</h2>
                <p>This focused collection posts one WCF line against one Water obligation.</p>
            </header>
            <dl class="wcf-summary-list">
                <div><dt>Payer snapshot</dt><dd>@(_collectionQuote.PayerNameSnapshot ?? "Unavailable")</dd></div>
                <div><dt>Obligation period</dt><dd>@Period(_collectionQuote.BillingYear, _collectionQuote.BillingMonth)</dd></div>
                <div><dt>Collection business date</dt><dd>@PhilippineTime.Today.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Water outstanding</dt><dd>@Money(_collectionQuote.OutstandingAmount)</dd></div>
                <div><dt>Cash Ticket</dt><dd>
                    <select aria-label="Assigned or in-office Cash Ticket" value="@_selectedDocumentId" @onchange="ChangeDocument">
                        @foreach (var ticket in _tickets)
                        {
                            <option value="@ticket.DocumentId">@ticket.DocumentNumber</option>
                        }
                    </select>
                </dd></div>
                <div><dt>Received amount (PHP)</dt><dd><input type="number" min="0.01" max="@_collectionQuote.OutstandingAmount" step="0.01" value="@_amount" @onchange="ChangeAmount" /></dd></div>
            </dl>
            <p class="wcf-account-area">Source authority, outstanding balance, and document custody are revalidated when this Collection is posted.</p>
            <footer class="wcf-modal-footer">
                <button class="wcf-button wcf-button-secondary" type="button" @onclick="CloseCollection">Cancel</button>
                <button class="wcf-button wcf-button-primary" type="button" @onclick="PostAsync" disabled="@(!CanPost || _busy)">Post Collection</button>
            </footer>
        </section>
    </div>
}

@code {
    private DateOnly _through = PhilippineTime.Today;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private string _searchText = string.Empty;
    private List<WcfObligationQuoteDto> _quotes = [];
    private List<CashTicketDocumentDto> _tickets = [];
    private List<WcfCollectionActivityDto> _activity = [];
    private List<WcfReconciliationExceptionDto> _exceptions = [];
    private List<AccountableFormBookDto> _books = [];
    private List<CollectorListDto> _collectors = [];
    private string _seriesName = string.Empty;
    private string _numberPrefix = "CT";
    private long _firstSerial;
    private long _lastSerial;
    private int _serialWidth = 6;
    private Guid? _assignmentBookId;
    private Guid? _assignmentCollectorId;
    private long _assignmentFirstSerial;
    private long _assignmentLastSerial;
    private WcfObligationQuoteDto? _collectionQuote;
    private Guid? _selectedDocumentId;
    private decimal _amount;
    private Guid? _operationId;
    private bool _busy;
    private string? _message;
    private string? _error;

    private string ThroughPeriodLabel => _through.ToString("MMMM yyyy");
    private IEnumerable<AccountableFormBookDto> CashTicketBooks => _books.Where(x => x.InstrumentType == RevenueInstrumentType.CashTicket);
    private bool CanPost => _collectionQuote?.CanCollectCanonical == true && _selectedDocumentId.HasValue
        && _amount > 0m && _amount <= (_collectionQuote?.OutstandingAmount ?? 0m);
    private List<FacilityHero.HeroStat> HeroStats =>
    [
        new() { Value = _quotes.Count(x => x.OutstandingAmount > 0m).ToString(), Label = "Open WCF periods" },
        new() { Value = Money(_quotes.Sum(x => x.OutstandingAmount)), Label = "WCF outstanding" },
        new() { Value = _tickets.Count.ToString(), Label = "Available CTs" }
    ];
    private IEnumerable<WcfObligationQuoteDto> FilteredQuotes => _quotes.Where(x =>
        string.IsNullOrWhiteSpace(_searchText)
        || (x.PayerNameSnapshot?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        || x.StallNo.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
        || x.FacilityName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
        || x.Section.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", out var parsed))
        {
            _through = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var obligations = await WcfApi.GetObligationsAsync(_through.Year, _through.Month);
            if (!obligations.IsSuccess) _error = obligations.Error ?? "Unable to load WCF source facts.";
            else _quotes = obligations.Value?.ToList() ?? [];
            var tickets = await WcfApi.GetAvailableCashTicketsAsync();
            if (!tickets.IsSuccess) _error ??= tickets.Error ?? "Unable to load Cash Ticket custody state.";
            else _tickets = tickets.Value?.ToList() ?? [];
            var from = new DateOnly(_through.Year, _through.Month, 1);
            var activity = await WcfApi.GetActivityAsync(from, from.AddMonths(1).AddDays(-1));
            if (!activity.IsSuccess) _error ??= activity.Error ?? "Unable to load WCF Collection Activity.";
            else _activity = activity.Value?.ToList() ?? [];
            var exceptions = await WcfApi.GetReconciliationExceptionsAsync();
            if (!exceptions.IsSuccess) _error ??= exceptions.Error ?? "Unable to load WCF reconciliation exceptions.";
            else _exceptions = exceptions.Value?.ToList() ?? [];
            var books = await WcfApi.GetBooksAsync();
            if (!books.IsSuccess) _error ??= books.Error ?? "Unable to load accountable-form custody.";
            else _books = books.Value?.ToList() ?? [];
            var collectors = await CollectorsApi.GetAllCollectorsAsync();
            if (!collectors.IsSuccess) _error ??= collectors.Error ?? "Unable to load active collector assignments.";
            else _collectors = collectors.Value?.ToList() ?? [];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReceiveBookAsync()
    {
        if (_firstSerial < 0 || _lastSerial < _firstSerial || string.IsNullOrWhiteSpace(_seriesName) || string.IsNullOrWhiteSpace(_numberPrefix)) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await WcfApi.ReceiveBookAsync(new ReceiveAccountableFormBookRequest(
                RevenueInstrumentType.CashTicket, _seriesName.Trim(), _numberPrefix.Trim(),
                _firstSerial, _lastSerial, _serialWidth));
            if (!result.IsSuccess) { _error = result.Error ?? "The Cash Ticket book could not be received."; return; }
            _message = $"Cash Ticket book received with {result.Value!.Documents.Count} units.";
            _seriesName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task AssignRangeAsync()
    {
        if (_assignmentBookId is not { } bookId || _assignmentCollectorId is not { } collectorId
            || _assignmentFirstSerial < 0 || _assignmentLastSerial < _assignmentFirstSerial) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await WcfApi.AssignCashTicketsAsync(new AssignAccountableFormRangeRequest(
                bookId, collectorId, _assignmentFirstSerial, _assignmentLastSerial));
            if (!result.IsSuccess) { _error = result.Error ?? "The Cash Ticket range could not be assigned."; return; }
            _message = $"Assigned {result.Value} Cash Ticket unit(s).";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void OpenCollection(WcfObligationQuoteDto quote)
    {
        _collectionQuote = quote;
        _amount = quote.OutstandingAmount;
        _selectedDocumentId = _tickets.FirstOrDefault()?.DocumentId;
        _operationId = null;
    }

    private void ChangeAmount(ChangeEventArgs args)
    {
        if (decimal.TryParse(args.Value?.ToString(), out var amount) && amount != _amount)
        {
            _amount = amount;
            _operationId = null;
        }
    }

    private void ChangeDocument(ChangeEventArgs args)
    {
        _selectedDocumentId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        _operationId = null;
    }

    private async Task PostAsync()
    {
        if (!CanPost || _collectionQuote is null || _selectedDocumentId is not { } documentId) return;
        var document = _tickets.FirstOrDefault(x => x.DocumentId == documentId);
        if (document is null) return;
        _operationId ??= Guid.NewGuid();
        _busy = true;
        _error = null;
        try
        {
            var result = await WcfApi.PostAsync(new WcfCollectionPostRequest(
                1, _operationId.Value, PhilippineTime.Today, _collectionQuote.UtilityBillId,
                _amount, _collectionQuote.WaterSourceVersion, document.DocumentId,
                document.DocumentNumber, IssuedAtUtc: null));
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "The WCF Collection could not be posted.";
                return;
            }
            _message = $"Collection {ShortId(result.Value!.CollectionId)} · {result.Value.DocumentNumber} · {Money(result.Value.Amount)}.";
            _collectionQuote = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void CloseCollection()
    {
        _collectionQuote = null;
        _operationId = null;
    }

    private static string Period(int year, int month) => new DateTime(year, month, 1).ToString("MMM yyyy");
    private static string Money(decimal amount) => $"₱{amount:N2}";
    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();

    private RenderFragment WaterIcon => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5S6 10 6 14.5a6 6 0 0 0 12 0C18 10 12 3.5 12 3.5Z" /><path d="M9.5 15.5a2.5 2.5 0 0 0 2.5 2.5" /></svg>;
