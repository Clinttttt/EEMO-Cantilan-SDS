@page "/operations/weight-and-measure"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Dtos.Facilities
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IFacilitiesApiClient FacilitiesApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Weight & Measure</PageTitle>

@* ONE SOURCE OWNER: NPM owns the Fish / Meat stalls, occupants and weighing records. This page only reads NPM's
   weighing evidence for the Weight & Measure revenue line — it manages no stall or vendor, enters no kilos and records
   no collection. Weight & Measure is a separate charge from stall rent and from the Fish / Meat Vendor Fee. *@
<div class="v3-page wm-page">
    <V3Hero OperationCode="WEIGHT_AND_MEASURE" Eyebrow="Operations" Title="Weight & Measure / Registration" Compact="true" FiguresLabel="Weighing position">
        <Icon>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M7 21h10M5 7h14M5 7l-3 7a3 3 0 0 0 6 0L5 7zM19 7l-3 7a3 3 0 0 0 6 0l-3-7z" /></svg>
        </Icon>
        <Meta><span class="wm-meta">@PeriodLabel · <InstrumentChip Instrument="OR" /> Official Receipt</span></Meta>
        <Figures>
            <V3HeroFigure Label="Meat weighing (frozen)" Value="@(_report?.FeeTypeBreakdown is { } breakdown ? Money(breakdown.MeatWeightMeasureAmount) : "—")" />
            <V3HeroFigure Label="Fish weighing (frozen)" Value="@(_report?.FeeTypeBreakdown is { } fish ? Money(fish.FishWeightMeasureFrozenAmount) : "—")" />
            <V3HeroFigure Label="Fish kilos without rate evidence" Value="@(_report?.FeeTypeBreakdown is { } unresolved ? Kilos(unresolved.FishKilosWithoutFrozenRate) : "—")" />
        </Figures>
        <Actions>
            <a class="v3-btn" href="/facility/npm">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-5h6v5" /></svg>
                Open NPM
            </a>
            <a class="v3-btn" href="/operations/weight-and-measure/report">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                Report
            </a>
        </Actions>
    </V3Hero>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="v3-notice v3-notice-error wm-error" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <div class="wm-layout">
        <section class="v3-panel" aria-labelledby="wm-fish-title" aria-busy="@(_loading ? "true" : "false")">
            <header class="v3-panel-header">
                <h2 id="wm-fish-title">Fish weighing</h2>
                @if (FishRows.Any())
                {
                    <span class="v3-panel-meta">@Kilos(FishRows.Sum(x => x.FishKilos))</span>
                }
            </header>

            <div class="v3-toolbar wm-toolbar" aria-label="Fish weighing filters">
                <input class="v3-input wm-month" type="month" aria-label="Weighing month" title="Weighing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                <label class="v3-search">
                    <span class="v3-sr-only">Search occupant or stall</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                    <input type="search" placeholder="Search occupant or stall" aria-label="Search occupant or stall" @bind="_search" @bind:event="oninput" />
                </label>
                <button class="v3-btn wm-icon-btn" type="button" @onclick="LoadAsync" disabled="@_loading" aria-label="Refresh weighing records" title="Refresh weighing records">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5" /></svg>
                </button>
            </div>

            <div class="v3-table-wrap wm-scroll" role="region" aria-label="Fish weighing by stall" tabindex="0">
                <table class="v3-table">
                    <caption class="v3-sr-only">Fish kilos weighed by NPM stall for @PeriodLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col">Occupant</th>
                            <th scope="col" class="v3-num">Kilos weighed</th>
                            <th scope="col"><span class="v3-sr-only">Source</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredFishRows)
                        {
                            <tr>
                                <td>
                                    <span class="v3-strong">@Occupant(row)</span>
                                    <span class="v3-block">@NpmName · Stall @row.StallNo@(string.IsNullOrWhiteSpace(row.Section) ? "" : $" · {row.Section}")</span>
                                </td>
                                <td class="v3-num v3-strong">@Kilos(row.FishKilos)</td>
                                <td class="wm-source">
                                    <a class="wm-source-link" href="/profile/npm/@row.StallId">Open NPM source</a>
                                </td>
                            </tr>
                        }
                        @if (!FilteredFishRows.Any())
                        {
                            <tr>
                                <td class="v3-empty" colspan="3">
                                    @if (_loading)
                                    {
                                        <span role="status">Loading weighing records…</span>
                                    }
                                    else if (FishRows.Any())
                                    {
                                        <span>No stalls match this search.</span>
                                    }
                                    else if (_error is null)
                                    {
                                        <span>No fish weighing was recorded in @PeriodLabel.</span>
                                    }
                                    else
                                    {
                                        <span>Weighing records are unavailable.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="v3-panel" aria-labelledby="wm-meat-title" aria-busy="@(_loading ? "true" : "false")">
            <header class="v3-panel-header">
                <h2 id="wm-meat-title">Meat weighing</h2>
            </header>
            @if (_report?.FeeTypeBreakdown is { } meat && (meat.MeatKilos > 0m || meat.MeatWeightMeasureAmount > 0m))
            {
                <dl class="v3-facts wm-meat-facts" aria-label="Meat weighing for @PeriodLabel">
                    <div><dt>Kilos weighed</dt><dd>@Kilos(meat.MeatKilos)</dd></div>
                    <div><dt>Weighing amount</dt><dd class="v3-strong">@Money(meat.MeatWeightMeasureAmount)</dd></div>
                </dl>
            }
            else
            {
                <div class="v3-panel-body wm-empty">
                    <p class="v3-empty">
                        @if (_loading)
                        {
                            <span role="status">Loading weighing records…</span>
                        }
                        else if (_report is null)
                        {
                            <span>Weighing records are unavailable.</span>
                        }
                        else
                        {
                            <span>No Meat weighing was recorded in @PeriodLabel.</span>
                        }
                    </p>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private DateOnly _period = PhilippineTime.Today;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private string _search = string.Empty;
    private FacilityReportsDto? _report;
    private bool _loading = true;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy");
    private string NpmName => FacilityCatalog.NameOf(FacilityCode.NPM);

    /// <summary>NPM stalls that carry fish weighing evidence for the month, as the server reports them.</summary>
    private IEnumerable<StallComplianceDto> FishRows =>
        (_report?.StallCompliance ?? []).Where(x => x.FishKilos > 0m).OrderBy(x => x.StallNo, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<StallComplianceDto> FilteredFishRows => FishRows.Where(x =>
        string.IsNullOrWhiteSpace(_search)
        || Occupant(x).Contains(_search, StringComparison.OrdinalIgnoreCase)
        || x.StallNo.Contains(_search, StringComparison.OrdinalIgnoreCase));


    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var report = await FacilitiesApi.GetFacilityReportsAsync(FacilityCode.NPM, ReportPeriod.Monthly, _period.Year, _period.Month);
            if (report.IsSuccess) _report = report.Value;
            else
            {
                _report = null;
                _error = "NPM weighing records couldn't be loaded.";
            }
        }
        catch
        {
            _report = null;
            _error = "NPM weighing records couldn't be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Occupant(StallComplianceDto row) =>
        string.IsNullOrWhiteSpace(row.Occupant) ? row.ContractName : row.Occupant;

    private static string Kilos(decimal kilos) => $"{kilos:N2} kg";
    private static string Money(decimal amount) => $"₱{amount:N2}";
}
