@page "/operations/ecf/accounts"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject NavigationManager Navigation

@* ECF Accounts moved into the ECF workspace (register, source panel and amount preparation). The route stays so saved links and
   bookmarks land on the workspace instead of a 404. *@

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/operations/ecf", replace: true);
}
