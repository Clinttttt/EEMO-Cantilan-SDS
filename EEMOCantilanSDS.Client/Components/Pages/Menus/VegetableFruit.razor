@page "/operations/vegetable-fruit"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Application.Dtos.Revenue

<PageTitle>StallTrack — Vegetable / Fruits</PageTitle>

<OperationTopbar OperationCode="VEGETABLE_FRUIT_SPACE_RENTAL" Title="Vegetable / Fruits" Crumb="Space rental" />
<div class="content-area">
    @* Keep both views mounted so register filters and the daily period survive mode switches. The daily view is the governed-service
       workspace (collections beside setup) limited to Daily transactions, so walk-in vendors are collected and set up in one place. *@
    <div hidden="@_daily" role="region" id="vf-monthly" aria-label="Monthly space register">
        <ObligationWorkspace Kind="ObligationKind.VegetableFruitSpaceRental" Name="Vegetable / Fruits" SubjectNoun="Space"
                             SpaceExperience="true" Overview="true" Presentation="EEMOCantilanSDS.Client.Services.SpaceAccountPresentation.VegetableFruit" ServerAssignedNumber="true" EffectiveMonthLabel="Effective month"
                             AccountCountLabel="Registered spaces" ReportsHref="/operations/vegetable-fruit/report"
                             ImportHref="/operations/vegetable-fruit/import">
            <ToolbarMode>@ModeSwitch</ToolbarMode>
        </ObligationWorkspace>
    </div>
    <div hidden="@(!_daily)" role="region" id="vf-daily" aria-label="Daily collections">
        <GovernedServiceWorkspace OperationCode="@CollectorOperationCodes.VegetableFruitSpaceRental" Name="Vegetable / Fruits" FeeOptionsTitle="Vegetable / Fruits fees"
                                  ActivityMode="GovernedServiceMode.DailyTransaction" VisibleCollectionRows="5" HeroEyebrow="Operations · Walk-in vendors">
            <HeroIcon>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
            </HeroIcon>
            <HeroActions>
                @ModeSwitch
                <a class="v3-btn" href="/operations/vegetable-fruit/daily-report">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                    Report
                </a>
            </HeroActions>
        </GovernedServiceWorkspace>
    </div>
</div>

@code {
    private bool _daily;

    private RenderFragment ModeSwitch => @<div class="vf-mode" role="group" aria-label="Collection mode">
        <button type="button" aria-controls="vf-monthly" aria-pressed="@(!_daily ? "true" : "false")" class="@(!_daily ? "selected" : "")" @onclick="() => _daily = false">Monthly</button>
        <button type="button" aria-controls="vf-daily" aria-pressed="@(_daily ? "true" : "false")" class="@(_daily ? "selected" : "")" @onclick="() => _daily = true">Daily</button>
    </div>;
}
