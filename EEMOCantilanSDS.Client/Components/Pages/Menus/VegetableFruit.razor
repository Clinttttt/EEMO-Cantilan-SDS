@page "/operations/vegetable-fruit"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Constants

<PageTitle>StallTrack — Vegetable / Fruits</PageTitle>

@* Vegetable / Fruit space rental is temporary open-space rental, not permanent NPM tenancy. The collector states the
   transaction mode; the approved policy resolves the instrument (IA-046): whole payment = Official Receipt, daily
   transaction = Cash Ticket. It is a governed configurable service (IA-044). Nothing on this page records money. The
   layout owns the <main> landmark. *@
<div class="v3-page">
    <WorkspaceHeader Parent="Operations" Title="Vegetable / Fruits" Subtitle="Space rental">
        <Meta>
            <InstrumentChip Instrument="OR" ShowName="true" Context="Whole payment" />
            <InstrumentChip Instrument="CT" ShowName="true" Context="Daily transaction" />
        </Meta>
    </WorkspaceHeader>

    <GovernedServiceWorkspace OperationCode="@CollectorOperationCodes.VegetableFruitSpaceRental" Name="Vegetable / Fruit" />
</div>
