@using EEMOCantilanSDS.Application.Common
@page "/settings"
@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Settings
@using EEMOCantilanSDS.Domain.Common
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject ISettingsApiClient SettingsApi
@inject IMfaApiClient MfaApi
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthState
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

@*
    Everything the office configures, in one list grouped by what it is about. Each row says what it is and leads to the
    one page that manages it; values live on those pages rather than being repeated here.
*@

<PageTitle>StallTrack — Settings</PageTitle>

<header class="topbar">
    <div class="topbar-left">
        <h1 class="topbar-title">Settings</h1>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Settings</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @_now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">
    <div class="set-page">
        @if (_error is not null)
        {
            <div class="set-state" role="alert">
                <div class="set-state-title">Couldn't load settings</div>
                <div class="set-state-text">@_error</div>
                <button class="set-retry" @onclick="LoadAsync">Try again</button>
            </div>
        }

        <div class="set-cols">
            <div class="set-col">
                @Group("office", "Office", OfficeRows)
                @Group("revenue", "Revenue", RevenueRows)
            </div>
            <div class="set-col">
                @Group("people", "People", PeopleRows)
                @Group("data", "Data", DataRows)

                <section class="v3-panel" aria-labelledby="set-group-account">
                    <header class="v3-panel-header"><h2 id="set-group-account">Your account</h2></header>
                    <ul class="set-list">
                        <li>
                            <button class="set-item" type="button" @onclick="() => _show2fa = true">
                                <div class="set-item-text">
                                    <div class="set-item-name">Two-factor authentication</div>
                                    <div class="set-item-desc">A second check when you sign in</div>
                                </div>
                                <span class="set-2fa-state @(_mfa?.Enabled == true ? "is-on" : "is-off")">
                                    @(_mfa is null ? "…" : _mfa.Enabled ? "On" : _mfa.PendingEnrollment ? "Unfinished" : "Off")
                                </span>
                            </button>
                        </li>
                        <li class="set-session">
                            <div class="set-item-text">
                                <div class="set-item-name">Sign out</div>
                                <div class="set-item-desc">End your session on this device</div>
                            </div>
                            <div class="set-session-right">
                                @if (_confirmLogout)
                                {
                                    <span class="set-session-ask">Sign out now?</span>
                                    <button class="set-signout-yes" @onclick="SignOutAsync" disabled="@_loggingOut">@(_loggingOut ? "Signing out…" : "Yes, sign out")</button>
                                    <button class="set-signout-no" @onclick="() => _confirmLogout = false" disabled="@_loggingOut">Cancel</button>
                                }
                                else
                                {
                                    <button class="set-signout" @onclick="() => _confirmLogout = true">Sign out</button>
                                }
                            </div>
                        </li>
                    </ul>
                </section>
            </div>
        </div>

        @if (_model is not null)
        {
            <p class="set-foot">@_model.System.ApplicationName v@(_model.System.Version) · @_model.System.TimeZone</p>
        }
    </div>
</div>

@* ── Two-factor authentication dialog ──
   Opened from the Your account group. The panel renders "flat" because the modal already provides the surface, and
   reports state changes back so the row's badge stays accurate. *@
@if (_show2fa)
{
    <div class="eemo-modal-overlay" @onclick="Close2fa">
        <div class="eemo-modal eemo-modal-wide" @onclick:stopPropagation="true">
            <div class="eemo-modal-header set-2fa-modal-head">
                <div class="set-2fa-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                        <rect x="9.5" y="10.5" width="5" height="4.5" rx="1" />
                        <path d="M10.75 10.5V9.25a1.25 1.25 0 0 1 2.5 0v1.25" />
                    </svg>
                </div>
                <div class="set-2fa-modal-titles">
                    <div class="eemo-modal-title">Two-Factor Authentication</div>
                    <div class="eemo-modal-sub">An additional layer of security for your @Branding.OfficeAcronym account</div>
                </div>
                <button class="eemo-modal-close" type="button" @onclick="Close2fa" aria-label="Close">&times;</button>
            </div>
            <div class="eemo-modal-body">
                @* Same explanatory rows as the required-setup dialog, so the two never drift apart. Shown
                   only while two-factor is off: once it is on, the panel reports state and actions instead,
                   and a "here is what setup involves" block would be stale advice. The default neutral
                   wording is used here because Settings is open to Admins as well as Heads. *@
                @if (_mfa is not null && !_mfa.Enabled)
                {
                    <TwoFactorIntro />
                }

                @* The operator recovery tool is folded into this same dialog rather than sitting in its own
                   card, so two-factor has one authoritative place in Settings. *@
                <div class="set-2fa-modal-panel">
                    <TwoFactorPanel Flat="true"
                                    ShowIntro="false"
                                    OnStatusChanged="OnMfaStatusChanged"
                                    ShowRecoveryTool="_isHead" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly DateTime _now = PhilippineTime.Now;
    private SystemSettingsDto? _model;

    // ── Two-factor (own account) ──
    // The badge on the row reflects current state; the dialog hosts the actual enrolment flow.
    private bool _show2fa;
    private EEMOCantilanSDS.Application.Dtos.Auth.MfaStatusDto? _mfa;

    private void Close2fa() => _show2fa = false;

    private void OnMfaStatusChanged(EEMOCantilanSDS.Application.Dtos.Auth.MfaStatusDto status)
    {
        _mfa = status;
        StateHasChanged();
    }

    /// <summary>
    /// Reads the two-factor state for the row's badge. Best-effort: a failure just leaves the badge
    /// unresolved rather than breaking the Settings page.
    /// </summary>
    private async Task LoadMfaStatusAsync()
    {
        try
        {
            var result = await MfaApi.GetMfaStatusAsync();
            if (result.IsSuccess && result.Value is not null)
                _mfa = result.Value;
        }
        catch { /* leave the badge unresolved */ }
    }

    private sealed record SettingRow(string Href, string Label, string? Description, bool OpenToAdmin = false);

    // The office's own name and place come from its profile; a dash of shimmer until they are read, never a stand-in.
    private SettingRow[] OfficeRows =>
    [
        new("/office-profile", "Office Profile",
            _model is { } m ? $"{m.Office.Office} · {m.Office.Municipality}, {m.Office.Province}" : _error is null ? null : "Details could not be loaded"),
        new("/settings/report-signatories", "Report Signatories", "Names printed on official reports"),
    ];

    private static readonly SettingRow[] RevenueRows =
    [
        new("/settings/facilities", "Facility Configuration", "Facilities, market sections and rates"),
        new("/settings/operations", "Operation Settings", "Which operations are listed and what they are called"),
        new("/settings/revenue", "Revenue Sources", "Revenue sources and the receipt each one uses"),
        new("/settings/billing-policy", "Billing Policy", "Due dates, payment order and late penalties", OpenToAdmin: true),
        // The page and its API admit Head and Admin alike (RentActivationsController).
        new("/settings/monthly-rent-src", "Monthly Rent SRC Activation", "Record a facility's new monthly rent with StallTrack Reference Codes", OpenToAdmin: true),
    ];

    private static readonly SettingRow[] PeopleRows =
    [
        new("/accounts", "Accounts", "Who can sign in to this office"),
        new("/collectors", "Collectors", "Collectors and what they are assigned to collect"),
    ];

    private static readonly SettingRow[] DataRows =
    [
        new("/settings/backups", "Backups", "Save a copy of this office's data, or restore one"),
        new("/settings/storage", "Storage", "How much data this office holds"),
    ];

    // A row the Administrator cannot use is stated but not offered: a link that leads to a refusal is worse than no link.
    private RenderFragment Group(string key, string title, IReadOnlyList<SettingRow> rows) => @<section class="v3-panel" aria-labelledby="set-group-@key">
        <header class="v3-panel-header"><h2 id="set-group-@key">@title</h2></header>
        <ul class="set-list">
            @foreach (var row in rows)
            {
                <li>
                    @if (_isHead || row.OpenToAdmin)
                    {
                        <a class="set-item" href="@row.Href">
                            @RowText(row)
                            <span class="set-item-arrow" aria-hidden="true">→</span>
                        </a>
                    }
                    else
                    {
                        <div class="set-item is-locked" aria-disabled="true" title="Managed by the @Branding.OfficeAcronym Head">
                            @RowText(row)
                            <span class="set-item-lock">Head only</span>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>;

    private RenderFragment RowText(SettingRow row) => @<div class="set-item-text">
        <div class="set-item-name">@row.Label</div>
        @if (row.Description is null)
        {
            <div class="set-item-desc"><Skeleton Width="60%" Height="12px" Radius="6px" /></div>
        }
        else
        {
            <div class="set-item-desc">@row.Description</div>
        }
    </div>;

    private string? _error;
    private bool _confirmLogout;
    private bool _loggingOut;
    private bool _isHead;

    private async Task SignOutAsync()
    {
        _loggingOut = true;
        // Existing pipeline: revokes the refresh token server-side, clears local tokens,
        // marks the state logged-out, and force-navigates to /login.
        await AuthService.LogoutAsync();
    }

    [PersistentState(AllowUpdates = true)]
    public SystemSettingsDto? CachedSettings { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Branding.EnsureLoadedAsync();
        await FacilityCatalog.EnsureLoadedAsync();
        var authState = await AuthState.GetAuthenticationStateAsync();
        var isSuperAdmin = authState.User.IsInRole("SuperAdmin")
            || authState.User.Claims.Any(c =>
                string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
                && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));
        // The LGU Head (SuperAdmin of ANY tenant) manages their own office's configuration.
        _isHead = isSuperAdmin;

        // Two-factor state for the row's badge (independent of the cached settings payload).
        await LoadMfaStatusAsync();

        if (CachedSettings is not null)
        {
            _model = CachedSettings;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        await PaintLoadingStateAsync();

        // Cold-start resilience. On a hard refresh the page can ask for the configuration before the circuit
        // has attached the JWT; the API then answers 401 and the page painted "Couldn't load settings" on a
        // perfectly healthy system. Retry that one case briefly — the same pattern the report pages use — and
        // only report a failure once the window has passed or the API answered something else.
        string? lastError = null;

        for (var attempt = 0; attempt < 5; attempt++)
        {
            var result = await SettingsApi.GetSystemSettingsAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                _model = result.Value;
                CachedSettings = _model;
                _error = null;
                return;
            }

            lastError = string.IsNullOrWhiteSpace(result.Error)
                ? "The system configuration could not be retrieved."
                : result.Error;

            // 401 alone means "not authenticated yet"; a 403 is a real permission answer and must not be retried.
            if (result.Status != ResultStatus.Unauthorized) break;

            await Task.Delay(400);
        }

        _error = lastError ?? "The system configuration could not be retrieved.";
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }
}
