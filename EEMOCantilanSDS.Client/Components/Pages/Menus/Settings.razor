@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Common.Authorization
@page "/settings"
@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Settings
@using EEMOCantilanSDS.Domain.Common
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject ISettingsApiClient SettingsApi
@inject IMfaApiClient MfaApi
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthState
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

@*
    Tenant configuration overview and authorized management links.
    Counts, identity, policy values and reference rates come from the settings API.
*@

<PageTitle>StallTrack — Settings</PageTitle>

<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-title">Settings</div>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Settings</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @_now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    @{
        var loaded = _model is not null;
    }

    <!-- ── Hero (shell is always visible; only the stat values skeletonize) ── -->
    <V3Hero Compact="true" Eyebrow="@($"{Branding.OfficeAcronym} Admin · System")" Title="Settings" Subtitle="Office configuration and system overview">
        <Icon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg></Icon>
        <Figures>
            <V3HeroFigure Label="Facilities" Value="@(_model?.Facilities.Count.ToString() ?? "—")" Note="Tenant facility records" />
            <V3HeroFigure Label="Role types" Value="@(_model?.Security.Roles.Count.ToString() ?? "—")" Note="Access policy" />
            <V3HeroFigure Label="Server month" Value="@(_model?.System.ServerDate.ToString("MMM yyyy") ?? "—")" Note="@_model?.System.TimeZone" />
            <V3HeroFigure Label="Application version" Value="@(loaded ? $"v{_model!.System.Version}" : "—")" Note="@_model?.System.ApplicationName" />
        </Figures>
    </V3Hero>

    @if (_error is not null)
    {
        <div class="set-state">
            <div class="set-state-title">Couldn't load settings</div>
            <div class="set-state-text">@_error</div>
            <button class="set-retry" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else
    {
        <div class="set-grid">

            <!-- ── Office / LGU Profile ── -->
            <section class="set-card">
                <div class="set-card-head">
                    <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" /></svg></div>
                    <div class="set-card-titles">
                        <div class="set-card-title">Office &amp; LGU Profile</div>
                        <div class="set-card-sub">Identity used on the portal, reports &amp; receipts</div>
                    </div>
                </div>
                <div class="set-rows">
                    @if (loaded)
                    {
                        <div class="set-row"><span class="set-key">Office</span><span class="set-val">@_model!.Office.Office</span></div>
                        <div class="set-row"><span class="set-key">Municipality</span><span class="set-val">@_model.Office.Municipality</span></div>
                        <div class="set-row"><span class="set-key">Province</span><span class="set-val">@_model.Office.Province</span></div>
                        <div class="set-row"><span class="set-key">System name</span><span class="set-val">@_model.Office.SystemName</span></div>
                        <div class="set-row"><span class="set-key">Receipts issued by</span><span class="set-val">@_model.Office.ReceiptsIssuedBy</span></div>
                    }
                    else
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="set-row"><Skeleton Width="35%" Height="12px" Radius="6px" /><Skeleton Width="42%" Height="12px" Radius="6px" /></div>
                        }
                    }
                </div>
                @if (!loaded)
                {
                    <div class="set-note"><Skeleton Width="82%" Height="12px" Radius="6px" /></div>
                }
                else if (_isHead)
                {
                    <div class="set-links">
                        <a class="set-link" href="/office-profile">Edit office profile<span class="set-link-arrow">→</span></a>
                        <a class="set-link" href="/settings/report-signatories">Official report signatories<span class="set-link-arrow">→</span></a>
                    </div>
                }
                else
                {
                    <div class="set-note">Managed by the @Branding.OfficeAcronym Head.</div>
                }
            </section>

            <!-- ── Security & Access Policy ── -->
            <section class="set-card">
                <div class="set-card-head">
                    <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg></div>
                    <div class="set-card-titles">
                        <div class="set-card-title">Security &amp; Access Policy</div>
                        <div class="set-card-sub">Sign-in policy and account security</div>
                    </div>
                </div>
                <div class="set-rows">
                    @if (loaded)
                    {
                        <div class="set-row"><span class="set-key">Access token</span><span class="set-val">@_model!.Security.AccessTokenMinutes minutes</span></div>
                        <div class="set-row"><span class="set-key">Refresh token</span><span class="set-val">@_model.Security.RefreshTokenDays days</span></div>
                        <div class="set-row"><span class="set-key">Account lockout</span><span class="set-val">@_model.Security.MaxFailedLoginAttempts failed attempts · @_model.Security.LockoutMinutes minutes</span></div>
                        <div class="set-row"><span class="set-key">Password reset</span><span class="set-val">Verified-email recovery or Head-managed reset</span></div>
                        <div class="set-row"><span class="set-key">Roles</span><span class="set-val">@string.Join(" · ", _model.Security.Roles)</span></div>
                    }
                    else
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="set-row"><Skeleton Width="35%" Height="12px" Radius="6px" /><Skeleton Width="42%" Height="12px" Radius="6px" /></div>
                        }
                    }
                </div>
                <div class="set-links set-links-split">
                    <div class="set-links-group">
                        @* Account and collector management belongs to the Head. For an Administrator these are
                           stated but not offered — a link that leads to a refusal is worse than no link. *@
                        @if (_isHead)
                        {
                            <a class="set-link" href="/accounts">Accounts<span class="set-link-arrow">→</span></a>
                            <a class="set-link" href="/collectors">Collectors<span class="set-link-arrow">→</span></a>
                        }
                        else
                        {
                            <span class="set-link set-link-disabled" aria-disabled="true" title="Managed by the @Branding.OfficeAcronym Head">Accounts</span>
                            <span class="set-link set-link-disabled" aria-disabled="true" title="Managed by the @Branding.OfficeAcronym Head">Collectors</span>
                        }
                    </div>
                    @* Two-factor lives behind this button (bottom-right of the security card) rather than as
                       its own card: it is an action the signed-in user takes on their own account, not a
                       policy row. The badge mirrors the current state without opening the dialog. *@
                    <button class="set-2fa-btn" type="button" @onclick="() => _show2fa = true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><path d="M12 15v3" />
                        </svg>
                        <span>Two-factor authentication</span>
                        <span class="set-2fa-state @(_mfa?.Enabled == true ? "is-on" : "is-off")">
                            @(_mfa is null ? "…" : _mfa.Enabled ? "On" : _mfa.PendingEnrollment ? "Unfinished" : "Off")
                        </span>
                    </button>
                </div>
            </section>

            <!-- ── Collection & Billing Rules ── -->
            <section class="set-card">
                <div class="set-card-head">
                    <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" /></svg></div>
                    <div class="set-card-titles">
                        <div class="set-card-title">Collection &amp; Billing Rules</div>
                        <div class="set-card-sub">Policies the system enforces</div>
                    </div>
                </div>
                <div class="set-rows">
                    @if (loaded)
                    {
                        <div class="set-row"><span class="set-key">Server month</span><span class="set-val">@_model!.System.ServerDate.ToString("MMMM yyyy")</span></div>
                        <div class="set-row"><span class="set-key">Delinquent</span><span class="set-val">At least @_model.Collection.DelinquentThresholdMonths fully elapsed unpaid month(s)</span></div>
                        <div class="set-row"><span class="set-key">Arrears qualification</span><span class="set-val">Previous-year rent, expired contracts and ended occupancies (per obligation)</span></div>
                        <div class="set-row"><span class="set-key">Delinquency window</span><span class="set-val">Rolling @_model.Collection.DelinquencyWindowMonths months</span></div>
                        <div class="set-row"><span class="set-key">Contract expiry warning</span><span class="set-val">Within @_model.Collection.ContractExpiryWarningMonths months</span></div>
                        <div class="set-row"><span class="set-key">Excused / closure days</span><span class="set-val">Reviewed under the source's billing and credit rules</span></div>
                        <div class="set-row"><span class="set-key">Business clock</span><span class="set-val">@_model.Collection.TimeZone</span></div>
                    }
                    else
                    {
                        @for (var i = 0; i < 7; i++)
                        {
                            <div class="set-row"><Skeleton Width="35%" Height="12px" Radius="6px" /><Skeleton Width="42%" Height="12px" Radius="6px" /></div>
                        }
                    }
                </div>
            </section>
 <!-- ── Facility Configuration — the LGU Head manages their own facilities (any tenant) ── -->
            @if (_isHead)
            {
                <section class="set-card">
                    <div class="set-card-head">
                        <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V7l8-4v18" /><path d="M19 21V11l-6-4" /><path d="M9 9v.01M9 12v.01M9 15v.01" /></svg></div>
                        <div class="set-card-titles">
                            <div class="set-card-title">Facility Configuration</div>
                        <div class="set-card-sub">Tenant facilities, billing models &amp; effective rates</div>
                        </div>
                    </div>
                    <div class="set-rows">
                        <div class="set-row"><span class="set-key">Facility records</span><span class="set-val">@(_model?.Facilities.Count.ToString() ?? "—")</span></div>
                        <div class="set-row"><span class="set-key">Billing models</span><span class="set-val">@(_model?.Facilities.Select(f => f.Model).Distinct().Count().ToString() ?? "—")</span></div>
                        <div class="set-row"><span class="set-key">Facilities</span><span class="set-val set-val-wrap">@FacilityCodes()</span></div>
                        <div class="set-row"><span class="set-key">Rate authority</span><span class="set-val">Municipal revenue ordinance</span></div>
                        <div class="set-row"><span class="set-key">Managed by</span><span class="set-val">The @Branding.OfficeAcronym Head</span></div>
                    </div>
                    <div class="set-links">
                        <a class="set-link" href="/settings/facilities">Manage facilities<span class="set-link-arrow">→</span></a>
                    </div>
                    <div class="set-note">Facility records are separate from revenue sources and collection eligibility. Manage effective-dated rates in the relevant operation.</div>
                </section>
            }
            @if (_isHead)
            {
                <!-- ── Operation directory — Head only. Presentation (listing and local names); never authority to collect. ── -->
                <section class="set-card">
                    <div class="set-card-head">
                        <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg></div>
                        <div class="set-card-titles">
                            <div class="set-card-title">Operation settings</div>
                            <div class="set-card-sub">Tenant operation visibility and local names</div>
                        </div>
                    </div>
                    <div class="set-links">
                        <a class="set-link" href="/settings/operations">Manage operations<span class="set-link-arrow">→</span></a>
                    </div>
                    <div class="set-note">Listing and naming change presentation only, never who may collect or how an operation is classified.</div>
                </section>
            }
            <!-- ── Revenue source configuration — Head only ── -->
            <section class="set-card">
                <div class="set-card-head">
                    <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z" /><path d="M8 9h8M8 13h5" /><circle cx="17" cy="16" r="2" /></svg></div>
                    <div class="set-card-titles">
                        <div class="set-card-title">Revenue Setup</div>
                        <div class="set-card-sub">Revenue source identity, presentation &amp; accountable instrument</div>
                    </div>
                </div>
                <div class="set-rows">
                    <div class="set-row"><span class="set-key">Managed by</span><span class="set-val">The @Branding.OfficeAcronym Head</span></div>
                    <div class="set-row"><span class="set-key">Configuration</span><span class="set-val">Effective-dated and retained as history</span></div>
                </div>
                @if (_isHead)
                {
                    <div class="set-links">
                        <a class="set-link" href="/settings/revenue">Manage revenue sources<span class="set-link-arrow">→</span></a>
                    </div>
                }
                else
                {
                    <div class="set-links">
                        <span class="set-link set-link-disabled" aria-disabled="true" title="Managed by the @Branding.OfficeAcronym Head">Revenue Setup</span>
                        <span class="set-note">Managed by the @Branding.OfficeAcronym Head.</span>
                    </div>
                }
            </section>
            <!-- ── Backups & Restore — per-municipality for every Head; whole-DB tools operator-only ── -->
            @if (_isHead)
            {
                <section class="set-card">
                    <div class="set-card-head">
                        <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" /></svg></div>
                        <div class="set-card-titles">
                            <div class="set-card-title">Backups &amp; Restore</div>
                            <div class="set-card-sub">Tenant archives and compatible restore points</div>
                        </div>
                    </div>
                    <div class="set-rows">
                        @* Backup availability and restore compatibility are checked in the backup workflow. *@
                        <div class="set-row"><span class="set-key">Your municipality</span><span class="set-val">Data archive · restore point</span></div>
                        <div class="set-row"><span class="set-key">Restore eligibility</span><span class="set-val">Validated against tenant, schema and retained records</span></div>
                        <div class="set-row"><span class="set-key">Scope</span><span class="set-val">Your records only</span></div>
                        @* Whole-database tools remain restricted to the dedicated platform operator. *@
                        @if (_isPlatformOperator)
                        {
                            <div class="set-row"><span class="set-key">Whole database</span><span class="set-val">Run &amp; download · restore</span></div>
                        }
                    </div>
                    <div class="set-links">
                        <a class="set-link" href="/settings/backups">Open backups &amp; restore<span class="set-link-arrow">→</span></a>
                    </div>
                </section>
            }
    <!-- ── System Information ── -->
            <section class="set-card">
                <div class="set-card-head">
                    <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg></div>
                    <div class="set-card-titles">
                        <div class="set-card-title">System Information</div>
                        <div class="set-card-sub">About this installation</div>
                    </div>
                </div>
                <div class="set-rows">
                    @if (loaded)
                    {
                        <div class="set-row"><span class="set-key">Application</span><span class="set-val">@_model!.System.ApplicationName</span></div>
                        <div class="set-row"><span class="set-key">Version</span><span class="set-val mono">v@(_model.System.Version)</span></div>
                        <div class="set-row"><span class="set-key">Environment</span><span class="set-val">@_model.System.Environment</span></div>
                        <div class="set-row"><span class="set-key">Time zone</span><span class="set-val">@_model.System.TimeZone</span></div>
                        <div class="set-row"><span class="set-key">Server date</span><span class="set-val">@_model.System.ServerDate.ToString("MMMM d, yyyy")</span></div>
                    }
                    else
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="set-row"><Skeleton Width="35%" Height="12px" Radius="6px" /><Skeleton Width="42%" Height="12px" Radius="6px" /></div>
                        }
                    }
                </div>
            </section>
            <!-- ── Storage usage (this municipality only) — every Head ── -->
            @if (_isHead)
            {
                <TenantUsagePanel />
            }
 <!-- ── Database health (shared server metrics; storage is scoped to the caller's LGU) — every Head ── -->
            @if (_isHead)
            {
                <DatabaseHealthPanel />
            }
           

        </div>

        <!-- ── Facility Collection Rules (table) ── -->
        <section class="set-card">
            <div class="set-card-head">
                <div class="set-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg></div>
                <div class="set-card-titles">
                    <div class="set-card-title">Facility Billing Reference</div>
                    <div class="set-card-sub">Facility reference rates · current collection eligibility and quotes come from each operation</div>
                </div>
                <a class="set-link" href="/reports/collections">Closures &amp; exceptions<span class="set-link-arrow">→</span></a>
            </div>
            <table class="set-table">
                <thead>
                    <tr><th>Facility</th><th>Collection model</th><th>Rate</th><th class="set-th-r">Cadence</th></tr>
                </thead>
                <tbody>
                    @if (loaded)
                    {
                        @foreach (var f in _model!.Facilities)
                        {
                            <tr>
                                <td><span class="set-fac">@f.Name</span><span class="set-code">@(System.Enum.TryParse<FacilityCode>(f.Code, out var _sc) ? FacilityCatalog.ShortNameOf(_sc) : f.Code)</span></td>
                                <td>@f.Model</td>
                                <td>@f.Rate</td>
                                <td class="set-td-r">@f.Cadence</td>
                            </tr>
                        }
                    }
                    else
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr>
                                <td><Skeleton Width="160px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="110px" Height="12px" Radius="6px" /></td>
                                <td><Skeleton Width="110px" Height="12px" Radius="6px" /></td>
                                <td class="set-td-r"><Skeleton Width="86px" Height="12px" Radius="6px" Class="set-sk-right" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

       
    }

    <!-- Session / sign out (always available while authenticated) -->
    <div class="set-session">
        <div class="set-session-left">
            <div class="set-session-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            </div>
            <div>
                <div class="set-session-title">Session</div>
                <div class="set-session-sub">Sign out of @Branding.OfficeAcronym Admin on this device.</div>
            </div>
        </div>
        <div class="set-session-right">
            @if (_confirmLogout)
            {
                <span class="set-session-ask">Sign out now?</span>
                <button class="set-signout-yes" @onclick="SignOutAsync" disabled="@_loggingOut">@(_loggingOut ? "Signing out…" : "Yes, sign out")</button>
                <button class="set-signout-no" @onclick="() => _confirmLogout = false" disabled="@_loggingOut">Cancel</button>
            }
            else
            {
                <button class="set-signout" @onclick="() => _confirmLogout = true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    Sign out
                </button>
            }
        </div>
    </div>
</div>

@* ── Two-factor authentication dialog ──
   Opened from the Security & Access Policy card. The panel renders "flat" because the modal already
   provides the surface, and reports state changes back so the button's badge stays accurate. *@
@if (_show2fa)
{
    <div class="eemo-modal-overlay" @onclick="Close2fa">
        <div class="eemo-modal eemo-modal-wide" @onclick:stopPropagation="true">
            <div class="eemo-modal-header set-2fa-modal-head">
                <div class="set-2fa-modal-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                        <rect x="9.5" y="10.5" width="5" height="4.5" rx="1" />
                        <path d="M10.75 10.5V9.25a1.25 1.25 0 0 1 2.5 0v1.25" />
                    </svg>
                </div>
                <div class="set-2fa-modal-titles">
                    <div class="eemo-modal-title">Two-Factor Authentication</div>
                    <div class="eemo-modal-sub">An additional layer of security for your @Branding.OfficeAcronym account</div>
                </div>
                <button class="eemo-modal-close" type="button" @onclick="Close2fa" aria-label="Close">&times;</button>
            </div>
            <div class="eemo-modal-body">
                @* Same explanatory rows as the required-setup dialog, so the two never drift apart. Shown
                   only while two-factor is off: once it is on, the panel reports state and actions instead,
                   and a "here is what setup involves" block would be stale advice. The default neutral
                   wording is used here because Settings is open to Admins as well as Heads. *@
                @if (_mfa is not null && !_mfa.Enabled)
                {
                    <TwoFactorIntro />
                }

                @* The operator recovery tool is folded into this same dialog rather than sitting in its own
                   card, so two-factor has one authoritative place in Settings. *@
                <div class="set-2fa-modal-panel">
                    <TwoFactorPanel Flat="true"
                                    ShowIntro="false"
                                    OnStatusChanged="OnMfaStatusChanged"
                                    ShowRecoveryTool="_isHead" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly DateTime _now = PhilippineTime.Now;
    private SystemSettingsDto? _model;

    // ── Two-factor (own account) ──
    // The badge on the security card reflects current state; the dialog hosts the actual enrolment flow.
    private bool _show2fa;
    private EEMOCantilanSDS.Application.Dtos.Auth.MfaStatusDto? _mfa;

    private void Close2fa() => _show2fa = false;

    private void OnMfaStatusChanged(EEMOCantilanSDS.Application.Dtos.Auth.MfaStatusDto status)
    {
        _mfa = status;
        StateHasChanged();
    }

    /// <summary>
    /// Reads the two-factor state for the button badge. Best-effort: a failure just leaves the badge
    /// unresolved rather than breaking the Settings page.
    /// </summary>
    private async Task LoadMfaStatusAsync()
    {
        try
        {
            var result = await MfaApi.GetMfaStatusAsync();
            if (result.IsSuccess && result.Value is not null)
                _mfa = result.Value;
        }
        catch { /* leave the badge unresolved */ }
    }

    // Compact list of the tenant's facility acronyms for the Facility Configuration card.
    private string FacilityCodes() =>
        _model is null
            ? ""
            : string.Join(" · ", _model.Facilities.Select(f =>
                System.Enum.TryParse<FacilityCode>(f.Code, out var c) ? FacilityCatalog.ShortNameOf(c) : f.Code));

    private string? _error;
    private bool _confirmLogout;
    private bool _loggingOut;
    private bool _isPlatformOperator;
    private bool _isHead;

    private async Task SignOutAsync()
    {
        _loggingOut = true;
        // Existing pipeline: revokes the refresh token server-side, clears local tokens,
        // marks the state logged-out, and force-navigates to /login.
        await AuthService.LogoutAsync();
    }

    [PersistentState(AllowUpdates = true)]
    public SystemSettingsDto? CachedSettings { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Platform operator = a dedicated operator account. Database-health and the whole-database backup tools
        // run across every LGU, so the API restricts them to that account and this screen offers them only to it
        // (avoids the 403 "couldn't load" state and hides destructive platform-wide controls).
        //
        // Decided by PlatformOperatorPolicy, the same function the API's policy calls. This screen used to decide
        // for itself — SuperAdmin of the default tenant — which is the clause the platform has since retired, so
        // it would have gone on offering one municipality's Head controls the API now refuses, and offering the
        // real operator none of the ones it allows.
        await Branding.EnsureLoadedAsync();
        await FacilityCatalog.EnsureLoadedAsync();
        var authState = await AuthState.GetAuthenticationStateAsync();
        var isSuperAdmin = authState.User.IsInRole("SuperAdmin")
            || authState.User.Claims.Any(c =>
                string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
                && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));
        _isPlatformOperator = PlatformOperatorPolicy.IsOperator(
            isDedicatedOperator: string.Equals(
                authState.User.FindFirst(AppClaimTypes.PlatformOperator)?.Value, "true",
                StringComparison.OrdinalIgnoreCase));
        // The LGU Head (SuperAdmin of ANY tenant) manages their own facilities — unlike the platform-only
        // database/backup tools, this is available to every LGU's Head.
        _isHead = isSuperAdmin;

        // Two-factor state for the security card's badge (independent of the cached settings payload).
        await LoadMfaStatusAsync();

        if (CachedSettings is not null)
        {
            _model = CachedSettings;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        await PaintLoadingStateAsync();

        // Cold-start resilience. On a hard refresh the page can ask for the configuration before the circuit
        // has attached the JWT; the API then answers 401 and the page painted "Couldn't load settings" on a
        // perfectly healthy system. Retry that one case briefly — the same pattern the report pages use — and
        // only report a failure once the window has passed or the API answered something else.
        string? lastError = null;

        for (var attempt = 0; attempt < 5; attempt++)
        {
            var result = await SettingsApi.GetSystemSettingsAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                _model = result.Value;
                CachedSettings = _model;
                _error = null;
                return;
            }

            lastError = string.IsNullOrWhiteSpace(result.Error)
                ? "The system configuration could not be retrieved."
                : result.Error;

            // 401 alone means "not authenticated yet"; a 403 is a real permission answer and must not be retried.
            if (result.Status != ResultStatus.Unauthorized) break;

            await Task.Delay(400);
        }

        _error = lastError ?? "The system configuration could not be retrieved.";
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }
}
