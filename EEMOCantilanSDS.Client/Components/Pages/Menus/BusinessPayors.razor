@page "/business-payors"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@inject IBusinessPayorsApiClient PayorsApi

<PageTitle>StallTrack — Business Payors</PageTitle>

@* A Business Payor is the stable identity a collection is found by. An occupancy that exists only as occupant text has none, so the
   office links one here, explicitly. Names are never matched automatically. The layout owns the <main> landmark. *@
<div class="v3-page bp-page">
    <V3Hero Eyebrow="Spaces &amp; Occupants" Title="Business Payors" Subtitle="Who pays for each space" Compact="true">
        <Figures>
            <V3HeroFigure Label="Showing" Value="@_rows.Count.ToString("N0")" Note="@(Filters.First(x => x.Item1 == _filter).Item2)" />
        </Figures>
        <Actions><a class="v3-btn" href="/vendors">Occupancy registry</a></Actions>
    </V3Hero>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="v3-notice" role="status">@_message</p>
    }

    <form class="bp-toolbar" aria-label="Filters" @onsubmit="LoadAsync" @onsubmit:preventDefault="true">
        <label class="v3-search">
            <span class="v3-sr-only">Search occupancies</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
            <input type="search" placeholder="Search space or occupant" @bind="_search" @bind:event="oninput" />
        </label>
        <div class="v3-btn-group" role="group" aria-label="Show">
            @foreach (var (filter, label) in Filters)
            {
                var f = filter;
                <button class="v3-btn @(_filter == f ? "v3-btn-primary" : "")" type="button" aria-pressed="@(_filter == f ? "true" : "false")" @onclick="() => ShowAsync(f)">@label</button>
            }
        </div>
        <button class="v3-btn" type="submit">Search</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="v3-notice v3-notice-error" role="alert">@_error</p>
    }

    <section class="v3-panel" aria-labelledby="bp-title" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="bp-title">Occupancies</h2>
            <span class="v3-panel-meta">@_rows.Count @(_rows.Count == 1 ? "occupancy" : "occupancies")</span>
        </header>
        <div class="v3-table-wrap" role="region" aria-label="Occupancies" tabindex="0">
            <table class="v3-table">
                <thead>
                    <tr>
                        <th scope="col">Space</th>
                        <th scope="col">Recorded occupant</th>
                        <th scope="col">Business Payor</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="v3-sr-only">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td><span class="v3-strong">@row.FacilityShortName · @row.StallNo</span></td>
                            <td>@row.ActualOccupant</td>
                            <td>@(row.PayorId is null ? "—" : row.PayorName)</td>
                            <td>
                                @if (row.PayorId is null) { <span class="bp-badge bp-needs">Needs Payor</span> }
                                else { <span class="bp-badge bp-linked">Linked</span> }
                            </td>
                            <td class="bp-action">
                                @if (row.PayorId is null)
                                {
                                    <button class="v3-btn v3-btn-sm" type="button" @onclick="() => _linking = row"
                                            aria-label="@($"Link Business Payor for {row.FacilityShortName} {row.StallNo}")">Link Payor</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_rows.Count == 0)
                    {
                        <tr><td class="v3-empty" colspan="5">@(_loading ? "Loading occupancies…" : _filter == PayorLinkFilter.NeedsPayor ? "Every occupancy has a Business Payor." : "No occupancies found.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (_linking is { } occupancy)
{
    <LinkPayorDialog Occupancy="occupancy" OnClose="() => _linking = null" OnLinked="LinkedAsync" />
}

@code {
    private static readonly (PayorLinkFilter, string)[] Filters =
    [
        (PayorLinkFilter.NeedsPayor, "Needs Payor"), (PayorLinkFilter.Linked, "Linked"), (PayorLinkFilter.All, "All")
    ];

    private string _search = string.Empty;
    private PayorLinkFilter _filter = PayorLinkFilter.NeedsPayor;
    private bool _loading = true;
    private string? _error, _message;
    private List<PayorOccupancyDto> _rows = [];
    private PayorOccupancyDto? _linking;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ShowAsync(PayorLinkFilter filter)
    {
        _filter = filter;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await PayorsApi.GetOccupanciesAsync(_search.Trim(), _filter);
            if (result.IsSuccess) _rows = result.Value?.ToList() ?? [];
            else { _rows = []; _error = "The occupancies couldn't be loaded."; }
        }
        catch { _rows = []; _error = "The occupancies couldn't be loaded."; }
        finally { _loading = false; }
    }

    private async Task LinkedAsync(PayorLinkOutcomeDto outcome)
    {
        _message = $"{outcome.PayorName} is now the Business Payor of {_linking?.FacilityShortName} {_linking?.StallNo}.";
        _linking = null;
        await LoadAsync();
    }
}
