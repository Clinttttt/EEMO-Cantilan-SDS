@page "/operations/fish-meat-vendor-fees"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Enums
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Fish / Meat Vendor Fees</PageTitle>

@* ONE SOURCE OWNER: NPM owns the Fish / Meat stalls, occupants and vendor relationships. This page is the focused
   financial view of the separate Fish / Meat Vendor Fee obligation. Stall rent, Fish / Meat Vendor Fee and Weight &
   Measure are three different charges even when one person owes all three.

   The server does not yet expose a Fish / Meat Vendor Fee obligation, so the register states that plainly. Nothing
   is derived from stall rent or any other figure. It adds no vendor, stall, collector, payment or weighing action. *@
<div class="v3-page fm-page">
    <WorkspaceHeader Parent="Operations" Title="Fish / Meat Vendor Fees" Subtitle="Vendor fee obligations for NPM Fish and Meat vendors">
        <Meta><InstrumentChip Instrument="OR" ShowName="true" /></Meta>
        <Actions>
            <a class="v3-btn" href="/facility/npm">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-5h6v5" /></svg>
                Open @NpmName
            </a>
        </Actions>
    </WorkspaceHeader>

    <section class="v3-panel" aria-labelledby="fm-register-title">
        <header class="v3-panel-header">
            <h2 id="fm-register-title">Vendor fee obligations</h2>
            <span class="v3-panel-meta">Not yet available</span>
        </header>
        <div class="v3-table-wrap" role="region" aria-label="Fish / Meat Vendor Fee obligations" tabindex="0">
            <table class="v3-table">
                <thead>
                    <tr>
                        <th scope="col">Vendor / Payor</th>
                        <th scope="col">NPM source</th>
                        <th scope="col">Period</th>
                        <th scope="col" class="v3-num">Assessed</th>
                        <th scope="col" class="v3-num">Collected</th>
                        <th scope="col" class="v3-num">Balance</th>
                        <th scope="col">OR</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="v3-empty fm-unavailable" colspan="8">
                            <div class="v3-empty-block" role="status">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                <strong>Fish / Meat Vendor Fee obligations aren't available yet</strong>
                                <p>The vendors are managed in @NpmName. Their separate vendor fee will be listed here once StallTrack records it — it is not taken from stall rent.</p>
                                <a class="v3-btn v3-btn-sm" href="/facility/npm">Open @NpmName</a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <aside class="fm-related" aria-label="Related charges">
        <p><strong>Separate charges.</strong> Stall rent, the Fish / Meat Vendor Fee and Weight &amp; Measure are billed and reported separately, even for the same vendor.</p>
        <a class="fm-related-link" href="/operations/weight-and-measure">Weight &amp; Measure</a>
    </aside>
</div>

@code {
    private string NpmName => FacilityCatalog.NameOf(FacilityCode.NPM);

    protected override Task OnInitializedAsync() => FacilityCatalog.EnsureLoadedAsync();
}
