@page "/operations/fish-meat-vendor-fees"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Fish / Meat Vendor Fees</PageTitle>

@* NPM owns vendor identity. IA-064 direct Vendor Fee collections remain separate from rent and weighing.
   The superseded IA-050 accounts are preserved as read-only historical evidence after cutover. *@
<div class="v3-page fm-page">
    <WorkspaceHeader Parent="Operations" Title="Fish / Meat Vendor Fees" Subtitle="Vendor fee collections">
        <Meta><InstrumentChip Instrument="OR" ShowName="true" /></Meta>
        <Actions>
            <a class="v3-btn" href="/collections/activity">Collection activity</a>
            <a class="v3-btn" href="/facility/npm">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-5h6v5" /></svg>
                Open @NpmName
            </a>
        </Actions>
    </WorkspaceHeader>

    <ObligationWorkspace Kind="ObligationKind.FishMeatVendorFee" Name="Fish / Meat Vendor Fee" SubjectNoun="Stall" ReadOnlyHistory="@DirectRuleApplies" />

    <aside class="fm-related" aria-label="Related charges">
        <p><strong>Separate charges.</strong> Stall rent, Vendor Fee and Weight &amp; Measure are reported separately.</p>
        <a class="fm-related-link" href="/operations/weight-and-measure">Weight &amp; Measure</a>
    </aside>
</div>

@code {
    private string NpmName => FacilityCatalog.NameOf(FacilityCode.NPM);
    private static bool DirectRuleApplies => PhilippineTime.Today >= FishMeatVendorFeeRules.DirectEffectiveDate;

    protected override Task OnInitializedAsync() => FacilityCatalog.EnsureLoadedAsync();
}
