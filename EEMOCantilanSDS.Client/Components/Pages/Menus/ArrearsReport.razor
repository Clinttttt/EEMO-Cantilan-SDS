@page "/operations/arrears/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Reports
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@inject IReportsApiClient Reports
@inject IOfficialReportsApiClient OfficialReports
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject IJSRuntime JS

<PageTitle>StallTrack — Arrears &amp; Delinquency Report</PageTitle>

@* Arrears & Delinquency report: the standard operation-report shell over the same existing receivables the workspace reads (ArrearsReads).
   Every figure is the server's; the register lists each account under the kind it is (Delinquent or Arrears). The layout owns the <main> landmark. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader Parent="Arrears &amp; Delinquency" ParentHref="/operations/arrears" Title="Arrears &amp; Delinquency Report">
            <Actions>
                <label class="v3-period">
                    <span>As of month</span>
                    <input class="v3-input" type="month" aria-label="As of month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                </label>
                <button class="v3-btn" type="button" @onclick="PrintAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                    Print
                </button>
            </Actions>
        </WorkspaceHeader>
    </div>

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="arrr-title" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="Arrears &amp; Delinquency Report" Period="@($"As of {MonthLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>Arrears &amp; Delinquency</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="arrr-title" class="v3-sr-only">Arrears and delinquency report as of @MonthLabel</h2>

        <section class="v3-report-section" aria-labelledby="arrr-position">
            <h3 id="arrr-position">Position</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col" class="v3-num">Delinquent accounts</th>
                            <th scope="col" class="v3-num">Delinquent outstanding</th>
                            <th scope="col" class="v3-num">Arrears accounts</th>
                            <th scope="col" class="v3-num">Arrears outstanding</th>
                            <th scope="col" class="v3-num">Total outstanding</th>
                            <th scope="col" class="v3-num">Recovered this month</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="v3-num">@Count(_data?.AccountsTotal)</td>
                            <td class="v3-num">@Amount(_data?.OutstandingTotal)</td>
                            <td class="v3-num">@Count(_data?.ArrearsQualifiedAccounts)</td>
                            <td class="v3-num">@Amount(_data?.ArrearsOutstanding)</td>
                            <td class="v3-num v3-strong">@Amount(_data?.OutstandingTotal is { } d && _data.ArrearsOutstanding is { } a ? d + a : null)</td>
                            <td class="v3-num">@Amount(_data?.RecoveredThisMonth)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <OperationMonthlyIncome Classification="Arrears (recovered)" RowKey="ARREARS" Year="_month.Year" HeadingId="arrr-official" />

        <section class="v3-report-section" aria-labelledby="arrr-by-source">
            <h3 id="arrr-by-source">By facility</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Facility</th>
                            <th scope="col" class="v3-num">Delinquent</th>
                            <th scope="col" class="v3-num">Arrears</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Register.Count == 0)
                        {
                            <tr><td colspan="4" class="v3-report-note">@(_loading ? "Loading…" : _data is null ? "Accounts are unavailable." : "No delinquent or arrears account.")</td></tr>
                        }
                        else
                        {
                            @foreach (var group in Register.GroupBy(r => r.Item.Facility).OrderBy(g => g.Key))
                            {
                                <tr>
                                    <th scope="row">@FacilityCatalog.NameOf(group.Key)</th>
                                    <td class="v3-num">@group.Count(r => r.Kind == "Delinquent")</td>
                                    <td class="v3-num">@group.Count(r => r.Kind == "Arrears")</td>
                                    <td class="v3-num">@Money(group.Sum(r => r.Item.Amount ?? 0m))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="v3-report-section" aria-labelledby="arrr-register">
            <h3 id="arrr-register">Account register</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Payor</th>
                            <th scope="col">Facility / account</th>
                            <th scope="col">Unpaid periods</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                            <th scope="col">Status</th>
                            <th scope="col">Classification</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Register.Count == 0)
                        {
                            <tr><td colspan="6" class="v3-report-note">No accounts to list.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Register)
                            {
                                <tr>
                                    <td>@row.Item.Person</td>
                                    <td>@FacilityCatalog.NameOf(row.Item.Facility)</td>
                                    <td>@row.Item.Period</td>
                                    <td class="v3-num">@Amount(row.Item.Amount)</td>
                                    <td>@ArrearsReads.StatusLabel(row.Item)</td>
                                    <td>@row.Kind</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </article>
</div>

@code {
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private ArrearsReads.Snapshot? _data;
    private bool _loading;

    private string MonthLabel => _month.ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    // Delinquent accounts first, then Arrears, each by facility and payor; one account can appear under both, each with its own money.
    private sealed record RegisterRow(FollowUpItemDto Item, string Kind);

    private List<RegisterRow> Register => (_data?.Accounts ?? []).Select(a => new RegisterRow(a, "Delinquent"))
        .Concat((_data?.ArrearsAccounts ?? []).Select(a => new RegisterRow(a, "Arrears")))
        .OrderBy(r => r.Kind == "Delinquent" ? 0 : 1).ThenBy(r => r.Item.Facility).ThenBy(r => r.Item.Person, StringComparer.OrdinalIgnoreCase).ToList();

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            _month = month;
            _monthInput = month.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _data = await ArrearsReads.LoadAsync(Reports, OfficialReports, _month); }
        finally { _loading = false; }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");

    private static string Count(int? value) => value is { } n ? n.ToString("N0", CultureInfo.InvariantCulture) : "—";
    private static string Amount(decimal? value) => value is { } a ? Money(a) : "—";
    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
