@page "/operations/arrears/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@inject IReportsApiClient Reports
@inject IOfficialReportsApiClient OfficialReports
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject IJSRuntime JS

<PageTitle>StallTrack — Arrears Report</PageTitle>

@* Arrears report: the standard operation-report shell over the same existing receivables the Arrears workspace reads
   (ArrearsReads). No fixed instrument is stated — recovery takes the instrument of the source it settles — and no target,
   Arrears-qualified count or write-off is invented. The layout owns the <main> landmark. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader Parent="Arrears" ParentHref="/operations/arrears" Title="Arrears Report">
            <Actions>
                <label class="v3-period">
                    <span>As of month</span>
                    <input class="v3-input" type="month" aria-label="As of month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                </label>
                <button class="v3-btn" type="button" @onclick="PrintAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                    Print
                </button>
            </Actions>
        </WorkspaceHeader>
    </div>

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="arrr-title" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="Arrears Report" Period="@($"As of {MonthLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>Arrears</dd></div>
                <div><dt>Basis</dt><dd>One or more fully elapsed unpaid months</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="arrr-title" class="v3-sr-only">Arrears report as of @MonthLabel</h2>

        <section class="v3-report-section" aria-labelledby="arrr-position">
            <h3 id="arrr-position">Arrears position — @MonthLabel</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col" class="v3-num">Accounts</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                            <th scope="col" class="v3-num">Critical (3+ months)</th>
                            <th scope="col" class="v3-num">Recovered this month</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="v3-num">@(_data?.AccountsTotal is { } n ? n.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="v3-num v3-strong">@(_data?.OutstandingTotal is { } o ? Money(o) : "—")</td>
                            <td class="v3-num">@(_data?.Accounts is { } rows ? rows.Count(r => r.Priority == "Critical").ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="v3-num">@(_data?.RecoveredThisMonth is { } r ? Money(r) : "—")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="v3-report-note">Accounts and outstanding are counted by the server over every delinquent account. Recovered is the official Monthly Income “Arrears” line for the month. The age-based Arrears qualification is not yet decided, so no Arrears-qualified count is stated.</p>
        </section>

        <OperationMonthlyIncome Classification="Arrears (recovered)" RowKey="ARREARS" Year="_month.Year" HeadingId="arrr-official" />

        <section class="v3-report-section" aria-labelledby="arrr-by-source">
            <h3 id="arrr-by-source">By facility / source</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Facility / source</th>
                            <th scope="col" class="v3-num">Accounts</th>
                            <th scope="col" class="v3-num">Listed outstanding</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_data?.Accounts is not { Count: > 0 } accounts)
                        {
                            <tr><td colspan="3" class="v3-report-note">@(_loading ? "Loading…" : _data?.Accounts is null ? "Accounts are unavailable." : "No account has a fully elapsed unpaid month.")</td></tr>
                        }
                        else
                        {
                            @foreach (var group in accounts.GroupBy(a => a.Facility).OrderBy(g => g.Key))
                            {
                                <tr>
                                    <th scope="row">@FacilityCatalog.NameOf(group.Key)</th>
                                    <td class="v3-num">@group.Count()</td>
                                    <td class="v3-num">@Money(group.Sum(a => a.Amount ?? 0m))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="v3-report-section" aria-labelledby="arrr-register">
            <h3 id="arrr-register">Account register</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Payor</th>
                            <th scope="col">Facility / account</th>
                            <th scope="col">Unpaid periods</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_data?.Accounts is not { Count: > 0 } list)
                        {
                            <tr><td colspan="5" class="v3-report-note">No accounts to list.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td>@item.Person</td>
                                    <td>@FacilityCatalog.NameOf(item.Facility) · @item.Identifier</td>
                                    <td>@item.Period</td>
                                    <td class="v3-num">@(item.Amount is { } a ? Money(a) : "—")</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="v3-report-note">A recovery register (document, collector and amount per recovered payment) is not yet available: recovered arrears are posted under their source's own collection and are stated above only as the Monthly Income total.</p>
        </section>
    </article>
</div>

@code {
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private ArrearsReads.Snapshot? _data;
    private bool _loading;

    private string MonthLabel => _month.ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            _month = month;
            _monthInput = month.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _data = await ArrearsReads.LoadAsync(Reports, OfficialReports, _month); }
        finally { _loading = false; }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
