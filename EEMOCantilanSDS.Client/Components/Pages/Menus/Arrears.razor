@page "/operations/arrears"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Reports
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IReportsApiClient Reports
@inject IPaymentsApiClient Payments
@inject IOfficialReportsApiClient OfficialReports
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Arrears &amp; Delinquency</PageTitle>

@* Arrears: a management view over existing receivables (see ArrearsReads). Who owes, how much, since when, and where to
   open the account. It creates no obligation, recalculates no balance and offers no write-off or adjustment. The layout
   owns the <main> landmark. *@
<div class="v3-page arr-page">
    <V3Hero Compact="true" Eyebrow="Operations · Receivables" Title="Arrears & Delinquency" FiguresLabel="Delinquency position">
        <Meta><span>Follow-up · as of @_month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span></Meta>
        <Figures>
            <V3HeroFigure Label="Accounts" Value="@(_data?.AccountsTotal is { } n ? n.ToString(CultureInfo.InvariantCulture) : "—")" Note="delinquent rentals" />
            <V3HeroFigure Label="Total outstanding" Value="@(TotalOutstanding is { } o ? Money(o) : "—")" Note="all periods" />
            <V3HeroFigure Label="Arrears" Value="@(_data?.ArrearsQualifiedAccounts is { } q ? q.ToString(CultureInfo.InvariantCulture) : "—")" Note="@(_data?.ArrearsOutstanding is { } ao ? Money(ao) + " owed" : "previous years and ended terms")" />
            <V3HeroFigure Label="@($"Recovered · {_month:MMM yyyy}")" Value="@(_data?.RecoveredThisMonth is { } r ? Money(r) : "—")" Note="cash received" />
        </Figures>
        <Actions><a href="/operations/arrears/report">Report</a></Actions>
    </V3Hero>

    @if (_data is { Failed: true })
    {
        <div class="v3-notice v3-notice-error v3-notice-row" role="alert">
            <span>Some receivables could not be loaded; figures that did not load show “—”.</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <section class="v3-panel" aria-labelledby="arr-register-title" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="arr-register-title">@(_condition == "arrears" ? "Qualifying Arrears" : "Delinquent accounts")</h2>
            <span class="v3-panel-meta">@(Filtered.Count) of @(Rows?.Count ?? 0) @(_condition == "arrears" ? "Arrears" : "Delinquent") accounts shown</span>
        </header>
        <div class="v3-toolbar arr-filters" aria-label="Arrears and delinquency filters">
            <label class="v3-period">
                <span>As of month</span>
                <input class="v3-input" type="month" aria-label="As of month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            </label>
            <label class="v3-field arr-search">
                <span class="v3-sr-only">Search</span>
                <input type="search" placeholder="Search payor, stall or facility" @bind="_search" @bind:event="oninput" />
            </label>
            <label class="v3-field">
                <span class="v3-sr-only">Follow-up condition</span>
                <select @bind="_condition"><option value="delinquent">Delinquent</option><option value="arrears">Qualifying Arrears</option></select>
            </label>
            <label class="v3-field">
                <span class="v3-sr-only">Facility / source</span>
                <select @bind="_facility">
                    <option value="">All facilities</option>
                    @foreach (var facilityCode in Facilities)
                    {
                        <option value="@facilityCode">@FacilityCatalog.NameOf(facilityCode)</option>
                    }
                </select>
            </label>
        </div>
        @if (_condition is "delinquent" or "arrears")
        {
@if (PositionTotal is { } position && Rows is { } queue && position != queue.Count)        {            @* Two server reads, two scopes: the position counts delinquent rental accounts in the financial report; this register lists               every delinquent account the follow-up queue carries. They are shown as the server states them, never forced to agree. *@            <p class="v3-notice arr-scope-note" role="note">Position: @position @PositionLabel (financial report) · Register: @queue.Count accounts in the whole-account follow-up.</p>        }
        <div class="v3-table-wrap" role="region" aria-label="Rental follow-up accounts" tabindex="0">
            <table class="v3-table">
                <thead>
                    <tr>
                        <th scope="col">Payor</th>
                        <th scope="col">Facility / account</th>
                        <th scope="col">Outstanding periods</th>
                        <th scope="col" class="v3-num">Outstanding</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="v3-sr-only">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Rows is null)
                    {
                        <tr><td class="v3-empty" colspan="6">@(_loading ? "Loading accounts…" : "Accounts could not be loaded.")</td></tr>
                    }
                    else if (Filtered.Count == 0)
                    {
                        <tr><td class="v3-empty" colspan="6">@(Rows.Count == 0 ? (_condition == "arrears" ? "No account carries qualifying Arrears." : "No account has a fully elapsed unpaid month this year.") : "No account matches these filters.")</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Filtered)
                        {
                            <tr>
                                <td class="v3-strong">@item.Person</td>
                                <td><strong>@FacilityCatalog.NameOf(item.Facility)</strong><span class="v3-block">@item.Model</span></td>
                                <td>@item.Period</td>
                                <td class="v3-num v3-strong">@AllPeriodsText(item)</td>
                                <td>@ArrearsReads.StatusLabel(item)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Link))
                                    {
                                        <button type="button" class="v3-btn v3-btn-sm" @onclick="() => Review(item)">Review account →</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        }
    </section>

    <details class="arr-note-disclosure">
        <summary>How these accounts are counted</summary>
        <p class="arr-note">Each unpaid obligation is classified on its own. Delinquent is a fully elapsed unpaid month of the current year on an account still billed; three months indicates severity only. Arrears is unpaid rent of a previous calendar year, or of an ended occupancy or expired contract. One account can carry both, each with its own amount, and the current month is neither. Recovered Arrears reports under its approved revenue line; nothing here reclassifies a posted collection. Other source-owned account positions remain in Follow-up Queue.</p>
    </details>
</div>

@if (_review is not null)
{ <FollowUpAccountReview @key="_review" Context="_review" OnClose="() => _review = null" OnAction="OpenPayment" OnPeriodSelected="date => _reviewPeriod = date" ActionLabel="@(_review.CanRecordPayment ? "Record payment" : null)" /> }
@if (_payment is not null)
{
<EEMOCantilanSDS.Client.Components.Pages.Shared.Actions.PayBillModal Show="@(_payment is not null)"
    StallId="@(_payment?.FacilityItem?.StallId ?? Guid.Empty)" ContractId="@_payment?.FacilityItem?.ContractId"
    Facility="@(_payment?.FacilityItem?.Facility ?? FacilityCode.NPM)" StallNo="@(_payment?.Reference ?? "")"
    Occupant="@(_payment?.Name ?? "")" PeriodYear="@_reviewPeriod?.Year" PeriodMonth="@_reviewPeriod?.Month" OnClose="() => _payment = null" OnChanged="PaymentChanged" />
}

@code {
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private ArrearsReads.Snapshot? _data;
    private bool _loading;
    private string _search = string.Empty;
    private string _facility = string.Empty;
    private string _condition = "delinquent";
    private EEMOCantilanSDS.Client.Services.FollowUpReviewContext? _review;
    private EEMOCantilanSDS.Client.Services.FollowUpReviewContext? _payment;
    private DateOnly? _reviewPeriod;
    private void Review(FollowUpItemDto item)
    {
        _reviewPeriod = null;
        _review = new(item, null, _month, item.StallId.HasValue && item.Facility != FacilityCode.NPM && item.Amount > 0m);
    }
    private void OpenPayment() { _payment = _review; _review = null; }
    private async Task PaymentChanged() { var context = _payment; _payment = null; await LoadAsync(); _review = context; }

    private IEnumerable<FacilityCode> Facilities =>
        (Rows ?? []).Select(a => a.Facility).Distinct().OrderBy(c => c);

    private IReadOnlyList<FollowUpItemDto>? Rows => _condition == "arrears" ? _data?.ArrearsAccounts : _data?.Accounts;
    // Every unpaid period the register carries: the delinquent months of this year plus Arrears, one figure.
    private decimal? TotalOutstanding => _data?.OutstandingTotal is { } delinquent && _data.ArrearsOutstanding is { } arrears ? delinquent + arrears : null;
    private int? PositionTotal => _condition == "arrears" ? _data?.ArrearsQualifiedAccounts : _data?.AccountsTotal;
    private string PositionLabel => _condition == "arrears" ? "accounts carrying Arrears" : "delinquent rental accounts";

    private List<FollowUpItemDto> Filtered => (Rows ?? [])
        .Where(a => string.IsNullOrWhiteSpace(_search)
            || a.Person.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || a.Identifier.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || FacilityCatalog.NameOf(a.Facility).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(a => _facility == "" || a.Facility.ToString() == _facility)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            _month = month;
            _monthInput = month.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _data = await ArrearsReads.LoadAsync(Reports, OfficialReports, _month); }
        finally { _loading = false; }
        _ = LoadAllPeriodsAsync(_data);
    }

    // The register's Outstanding is the account's total balance across all periods (what the account review states), so the two never disagree.
    private IReadOnlyDictionary<(Guid Stall, Guid? Contract), decimal> _allPeriods = new Dictionary<(Guid, Guid?), decimal>();
    private bool _allPeriodsLoading;

    private async Task LoadAllPeriodsAsync(ArrearsReads.Snapshot? data)
    {
        if (data is null) return;
        _allPeriodsLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var totals = await ArrearsReads.AllPeriodsAsync(Payments, (data.Accounts ?? []).Concat(data.ArrearsAccounts ?? []));
            if (ReferenceEquals(data, _data)) _allPeriods = totals;
        }
        finally
        {
            _allPeriodsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string AllPeriodsText(FollowUpItemDto item) =>
        item.StallId is not { } stall ? (item.Amount is { } a ? Money(a) : "—")
        : _allPeriods.TryGetValue((stall, item.ContractId), out var total) ? Money(total)
        : _allPeriodsLoading ? "…" : "—";

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
