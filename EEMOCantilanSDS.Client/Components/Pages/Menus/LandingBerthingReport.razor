@page "/operations/landing-berthing/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@inject IJSRuntime JS

<PageTitle>StallTrack — Landing / Berthing Report</PageTitle>

@* Printable Landing / Berthing report. StallTrack does not yet hold these collections, an approved annual target or
   classified monthly income, so every figure is shown as unavailable ("—"). Earlier versions carried hard-coded
   office-sheet figures and sample collection rows (with a CSV export of them); those are not system data and would
   print for every municipality. The layout owns the <main> landmark. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader Parent="Landing / Berthing" ParentHref="/operations/landing-berthing" Title="Landing / Berthing Report">
            <Meta><InstrumentChip Instrument="CT" ShowName="true" /></Meta>
            <Actions>
                <label class="v3-period">
                    <span>Fiscal year</span>
                    <select class="v3-select lbr-year" aria-label="Fiscal year" @bind="_year">
                        @for (var year = PhilippineTime.Today.Year; year >= PhilippineTime.Today.Year - 2; year--)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </label>
                <button class="v3-btn" type="button" @onclick="PrintAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                    Print
                </button>
            </Actions>
        </WorkspaceHeader>
    </div>

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="lbr-title">
        <ReportLetterhead Title="Landing / Berthing Report" Period="@($"Fiscal year {_year}")">
            <Facts>
                <div><dt>Classification</dt><dd>Landing / Berthing</dd></div>
                <div><dt>Instrument</dt><dd>Cash Ticket</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="lbr-title" class="v3-sr-only">Landing / Berthing report for fiscal year @_year</h2>

        <MonthlyIncomeUnavailable Classification="Landing / Berthing" Year="_year" HeadingId="lbr-official" />
    </article>
</div>

@code {
    private int _year = PhilippineTime.Today.Year;

    private async Task PrintAsync() => await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");
}
