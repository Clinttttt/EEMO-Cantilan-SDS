@page "/remittances"
@page "/accountable-forms/remittances"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Entities.Revenue
@using EEMOCantilanSDS.Domain.Enums
@inject IRemittancesApiClient Api
@inject ICollectorsApiClient CollectorsApi
@inject IJSRuntime JS

<PageTitle>StallTrack — @(Preparation ? "New Remittance" : "Remittance & Liquidation")</PageTitle>

@* Money accountability over canonical Collections (IA-052 / IA-062). A remittance records money already collected and turned
   over: it never creates a Collection, a line, revenue or an SRC. Physical OR/CT books play no part here; the instrument is
   only policy metadata on a collection. The layout owns the <main> landmark. *@
<div class="v3-page rm-page">
    <header class="rm-header no-print">
        <div>
            @if (Preparation) { <a class="rm-back" href="/remittances">Remittance &amp; Liquidation</a> }
            <h1>@(Preparation ? "New Remittance" : "Remittance & Liquidation")</h1>
            <p>@(Preparation ? "Select collected amounts to remit." : "Review collected amounts and prepare remittances.")</p>
        </div>
        <div class="rm-header-actions">
        @if (!Preparation)
        {
            <button class="v3-btn" type="button" @onclick="PrintAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Print summary
            </button>
            <a class="v3-btn v3-btn-primary" href="/remittances/new">New Remittance</a>
        }
        </div>
    </header>

    <div class="rm-print-head" aria-hidden="true">
        <ReportLetterhead Title="Remittance / Liquidation Summary" Period="@PeriodLabel" />
    </div>

    <form class="rm-filters" aria-label="Filters" @onsubmit="ReloadAsync" @onsubmit:preventDefault="true">
        <label class="v3-field"><span>From</span><input type="date" @bind="_from" /></label>
        <label class="v3-field"><span>To</span><input type="date" @bind="_to" /></label>
        <label class="v3-field">
            <span>Collector</span>
            <select @bind="_collectorFilter">
                <option value="">All collectors</option>
                @foreach (var collector in _collectors)
                {
                    <option value="@collector.Id">@collector.FullName</option>
                }
            </select>
        </label>
        <label class="v3-field">
            <span>Instrument</span>
            <select @bind="_instrumentFilter">
                <option value="">OR and CT</option>
                <option value="@((int)RevenueInstrumentType.CashTicket)">Cash Ticket</option>
                <option value="@((int)RevenueInstrumentType.OfficialReceipt)">Official Receipt</option>
            </select>
        </label>
        @if (Preparation)
        {
            <label class="v3-field"><span>Source</span><select @bind="_sourceFilter" @bind:after="ClearSelection">
                <option value="">All sources</option>
                @foreach (var source in AllEligible.Select(c => SourceLabel(c.Collection)).Distinct().OrderBy(x => x))
                { <option value="@source">@source</option> }
            </select></label>
        }
        <button class="v3-btn" type="submit">Apply</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="v3-notice rm-result" role="status">
            <p>@_message</p>
            @if (_result.Count > 0)
            {
                <table class="rm-result-table" aria-label="Recorded remittances">
                    <tbody>
                        @foreach (var item in _result)
                        {
                            <tr><th scope="row">@item.Row.CollectorName</th><td class="v3-num">@Money(item.Row.RemittedAmount)</td>
                                <td><a href="@($"/remittances/{item.Row.Id}")">View</a></td></tr>
                        }
                    </tbody>
                    <tfoot><tr><th scope="row">Total</th><td class="v3-num">@Money(_result.Sum(x => x.Row.RemittedAmount))</td><td></td></tr></tfoot>
                </table>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="v3-notice v3-notice-error" role="alert">@_error</p>
    }

    @if (_position is { } position)
    {
        <SummaryStrip Label="Cash position" Items="SummaryItems(position)" />

        <section class="v3-panel" aria-labelledby="rm-due-title" aria-busy="@(_loading ? "true" : "false")">
            <header class="v3-panel-header">
                <h2 id="rm-due-title">@(Preparation ? "Ready for remittance" : "For remittance")</h2>
                <div class="rm-section-actions">
                    <span class="v3-panel-meta">@Eligible.Count() ready</span>
                    @if (!Preparation) { <a class="v3-btn v3-btn-sm" href="@PrepareHref">View all</a> }
                </div>
            </header>
            <div class="v3-table-wrap @(Preparation ? "rm-ready-list" : "rm-preview")" role="region" aria-label="Collections for remittance" tabindex="0">
                <table class="v3-table rm-collections">
                    <thead>
                        <tr>
                            @if (Preparation)
                            {
                            <th scope="col" class="rm-check">
                                <input type="checkbox" aria-label="Select all collections" checked="@(Eligible.Any() && SelectedCount == Eligible.Count())"
                                       disabled="@(!Eligible.Any())" @onchange="e => SelectEverything(e.Value is true)" />
                            </th>
                            }
                            <th scope="col">Date</th>
                            <th scope="col">SRC</th>
                            <th scope="col">Collector</th>
                            <th scope="col">Source / payer</th>
                            <th scope="col">Instrument</th>
                            <th scope="col" class="v3-num">Amount</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Eligible)
                        {
                            var draft = item.Draft;
                            var collection = item.Collection;
                            <tr @key="collection.CollectionId">
                                @if (Preparation)
                                {
                                <td class="rm-check"><input type="checkbox" aria-label="@($"Include {collection.ReferenceCode}")" checked="@draft.Selected.Contains(collection.CollectionId)"
                                           @onchange="e => Toggle(draft, collection.CollectionId, e.Value is true)" /></td>
                                }
                                <td>@collection.BusinessDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                                <td class="v3-strong">@collection.ReferenceCode</td>
                                <td>@draft.Name</td>
                                <td>@SourceLabel(collection)@if (!string.IsNullOrWhiteSpace(collection.PayerName)) {<span class="v3-block">@collection.PayerName</span>}</td>
                                <td>@if (collection.Instrument is { } instrument) {<InstrumentChip Instrument="@InstrumentCode(instrument)" />} else {<span>—</span>}</td>
                                <td class="v3-num">@Money(collection.NetAmount)</td>
                                <td><span class="rm-pill">Unremitted</span></td>
                            </tr>
                        }
                        @if (!Eligible.Any())
                        {
                            <tr><td class="v3-empty" colspan="@(Preparation ? 8 : 7)">@(_loading ? "Loading collections…" : "Nothing is waiting to be remitted in this period.")</td></tr>
                        }
                    </tbody>
                    @if (Preparation && SelectedCount > 0)
                    {
                        <tfoot>
                            <tr>
                                <td colspan="6"><strong>Selected · @SelectedCount of @Eligible.Count()</strong></td>
                                <td class="v3-num v3-strong">@Money(SelectedTotal)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </section>

        @if (Preparation)
        {
            <div class="rm-selection no-print" aria-label="Selection summary">
                <dl><div><dt>Collections selected</dt><dd>@SelectedCount</dd></div>
                    <div><dt>Collectors</dt><dd>@Recordable.Count()</dd></div>
                    <div><dt>Total</dt><dd>@Money(SelectedTotal)</dd></div></dl>
                <button class="v3-btn v3-btn-primary" type="button" @onclick="OpenConfirm" disabled="@(!Recordable.Any())">Review Remittance</button>
            </div>
        }

        @if (Preparation && _confirming)
        {
            @* Each collector becomes their own remittance record (their own amount, reference and operation identity); several are
               saved together or not at all. *@
            <section class="v3-panel" aria-labelledby="rm-new-title">
                <header class="v3-panel-header"><h2 id="rm-new-title">Confirm remittance</h2></header>
                <form class="rm-form" aria-label="Confirm remittance" @onsubmit="RecordAsync" @onsubmit:preventDefault="true">
                    <dl class="rm-batch-total" aria-label="Remittance total">
                        <div><dt>Collectors</dt><dd>@Recordable.Count()</dd></div>
                        <div><dt>Collections</dt><dd>@SelectedCount</dd></div>
                        <div><dt>Total</dt><dd>@Money(SelectedTotal)</dd></div>
                        <div><dt>Remitted</dt><dd>@Money(Recordable.Sum(d => d.Amount ?? 0m))</dd></div>
                    </dl>
                    <dl class="rm-review-facts"><div><dt>Coverage period</dt><dd>@PeriodLabel</dd></div>
                        <div><dt>Instrument mix</dt><dd>@SelectedInstruments</dd></div></dl>
                    <div class="rm-form-row">
                        <label class="v3-field"><span>Remittance date</span><input type="date" @bind="_newDate" /></label>
                    </div>
                    @foreach (var draft in Recordable)
                    {
                        <section class="rm-draft" aria-label="@($"Remittance for {draft.Name}")" @key="draft.CollectorId">
                            <header class="rm-draft-head">
                                <h3>@draft.Name</h3>
                                <dl class="rm-draft-figures">
                                    <div><dt>Collections</dt><dd>@draft.Selected.Count</dd></div>
                                    <div><dt>Collected</dt><dd>@Money(draft.Expected)</dd></div>
                                </dl>
                            </header>
                            <div class="rm-form-row">
                                <label class="v3-field"><span>Amount remitted (₱)</span><input type="number" min="0.01" step="0.01" required @bind="draft.Amount" /></label>
                                <label class="v3-field"><span>Reference (optional)</span><input maxlength="100" @bind="draft.Reference" /></label>
                                <label class="v3-field rm-wide"><span>Remarks (optional)</span><input maxlength="500" @bind="draft.Remarks" /></label>
                            </div>
                            @if (draft.Amount is { } typed && typed > 0m && typed != draft.Expected)
                            {
                                <dl class="rm-reconcile rm-reconcile-flag" role="status" aria-label="@($"Reconciliation for {draft.Name}")">
                                    <div><dt>Expected</dt><dd>@Money(draft.Expected)</dd></div>
                                    <div><dt>Remitted</dt><dd>@Money(typed)</dd></div>
                                    <div><dt>Difference</dt><dd>@Money(draft.Expected - typed)</dd></div>
                                    <div class="rm-reconcile-status"><dt>Status</dt><dd>@ReconcileStatus(draft.Expected, typed)</dd></div>
                                </dl>
                            }
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <p class="v3-notice v3-notice-error" role="alert">@_formError</p>
                    }
                    <div class="rm-actions">
                        <button class="v3-btn" type="button" @onclick="CloseConfirm">Cancel</button>
                        <button class="v3-btn v3-btn-primary" type="submit" disabled="@(_saving || !CanRecord)">
                            Confirm Remittance
                        </button>
                    </div>
                </form>
            </section>
        }

        @if (!Preparation)
        {
        <section class="v3-panel" aria-labelledby="rm-pos-title">
            <header class="v3-panel-header"><h2 id="rm-pos-title">Collector position</h2></header>
            <div class="v3-table-wrap" role="region" aria-label="Collector position" tabindex="0">
                <table class="v3-table rm-position">
                    <thead>
                        <tr>
                            <th scope="col">Collector</th>
                            <th scope="col" class="v3-num">Collected</th>
                            <th scope="col" class="v3-num">Remitted</th>
                            <th scope="col" class="v3-num">Unremitted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in VisibleCollectors(position))
                        {
                            <tr @key="row.CollectorId">
                                <td class="v3-strong">@row.CollectorName</td>
                                <td class="v3-num">@Money(row.Collected)</td>
                                <td class="v3-num">@Money(row.Remitted)</td>
                                <td class="v3-num v3-strong">@Money(row.Unremitted)</td>
                            </tr>
                        }
                        @if (!VisibleCollectors(position).Any())
                        {
                            <tr><td class="v3-empty" colspan="4">No collector has collections in this period.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        }
    }

    @if (!Preparation)
    {
    <section class="v3-panel" aria-labelledby="rm-hist-title">
        <header class="v3-panel-header">
            <h2 id="rm-hist-title">Remittance history</h2>
            <div class="rm-section-actions"><span class="v3-panel-meta">@_register.Count in this period</span>
                @if (History != "all") { <a class="v3-btn v3-btn-sm" href="@HistoryHref">View all</a> }</div>
        </header>
        <div class="v3-table-wrap @(History == "all" ? "" : "rm-history-preview")" role="region" aria-label="Remittance history" tabindex="0">
            <table class="v3-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Collectors</th>
                        <th scope="col" class="v3-num">Collections</th>
                        <th scope="col" class="v3-num">Amount</th>
                        <th scope="col">Status</th>
                        <th scope="col">Reference</th>
                        <th scope="col"><span class="v3-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _register)
                    {
                        var viewHref = ViewHref(row);
                        <tr @key="row.PrimaryRemittanceId">
                            <td><a href="@viewHref">@row.RemittanceDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</a></td>
                            <td class="rm-collector-cell">
                                @row.Members[0].CollectorName
                                @if (row.Members.Count > 1)
                                {
                                    <button class="rm-more" type="button" aria-expanded="@(_openMembers == row.PrimaryRemittanceId ? "true" : "false")"
                                            aria-label="@($"Show all {row.Members.Count} collectors")"
                                            @onclick="() => _openMembers = _openMembers == row.PrimaryRemittanceId ? null : row.PrimaryRemittanceId">+@(row.Members.Count - 1)</button>
                                    @if (_openMembers == row.PrimaryRemittanceId)
                                    {
                                        <ul class="rm-members" aria-label="Collectors in this remittance">
                                            @foreach (var member in row.Members)
                                            {
                                                <li><span>@member.CollectorName</span><span class="v3-num">@Money(member.RemittedAmount)</span></li>
                                            }
                                        </ul>
                                    }
                                }
                            </td>
                            <td class="v3-num">@row.CollectionCount</td>
                            <td class="v3-num">@Money(row.RemittedAmount)</td>
                            <td><span class="rm-pill @(row.StatusLabel == "Voided" ? "rm-pill-void" : "")">@row.StatusLabel</span>@if (row.DifferenceAmount != 0m) {<span class="v3-block rm-diff-flag">Difference @Money(row.DifferenceAmount)</span>}</td>
                            <td>@(row.Reference ?? "—")</td>
                            <td class="rm-row-action">
                                <a class="v3-btn v3-btn-sm" href="@viewHref" aria-label="@($"View remittance of {CollectorSummary(row)}, {row.RemittanceDate.ToString("MMM d", CultureInfo.InvariantCulture)}")">View</a>
                                <a class="v3-btn v3-btn-sm" href="@($"{viewHref}?print=1")" aria-label="@($"Print remittance of {CollectorSummary(row)}, {row.RemittanceDate.ToString("MMM d", CultureInfo.InvariantCulture)}")">Print</a>
                            </td>
                        </tr>
                    }
                    @if (_register.Count == 0)
                    {
                        <tr><td class="v3-empty" colspan="7">@(_loading ? "Loading remittances…" : "No remittance was recorded in this period.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    }
</div>

@code {
    [Parameter] public bool Preparation { get; set; }
    [Parameter] public DateOnly? From { get; set; }
    [Parameter] public DateOnly? To { get; set; }
    [Parameter] public string? Collector { get; set; }
    [Parameter] public string? Instrument { get; set; }
    [SupplyParameterFromQuery(Name = "history")] public string? History { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "collector")] public string? QueryCollector { get; set; }
    [SupplyParameterFromQuery(Name = "instrument")] public string? QueryInstrument { get; set; }
    private AccountabilityPositionDto? _position;
    private List<RemittanceHistoryRowDto> _register = [];
    private Guid? _openMembers;
    private List<CollectorListDto> _collectors = [];
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private string? _error;
    private string? _formError;
    private List<RemittanceDetailDto> _result = [];

    private DateOnly _from = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private DateOnly _to = PhilippineTime.Today;
    private string _collectorFilter = string.Empty;
    private string _instrumentFilter = string.Empty;
    private string _sourceFilter = string.Empty;

    private bool _confirming;
    private DateOnly _newDate = PhilippineTime.Today;
    // The scope the eligible collections were loaded for; the server re-derives eligibility from the same scope when recording.
    private DateOnly _scopeFrom;
    private DateOnly _scopeTo;
    private RevenueInstrumentType? _scopeInstrument;
    private List<Draft> _drafts = [];

    /// <summary>One collector's remittance being prepared: their own eligible collections, selection, amount and operation identity.</summary>
    private sealed class Draft(Guid collectorId, string name, RemittanceScopeDto scope)
    {
        public Guid CollectorId { get; } = collectorId;
        public string Name { get; } = name;
        public RemittanceScopeDto Scope { get; } = scope;
        public HashSet<Guid> Selected { get; } = [];
        public decimal? Amount { get; set; }
        public string Reference { get; set; } = string.Empty;
        public string Remarks { get; set; } = string.Empty;
        // Kept for the life of the draft so a retry after a failure is idempotent on the server.
        public Guid OperationId { get; } = Guid.NewGuid();
        public decimal Expected => Scope.Collections.Where(x => Selected.Contains(x.CollectionId)).Sum(x => x.NetAmount);
    }

    /// <summary>Every unremitted canonical collection in the period, with the collector's draft it belongs to.</summary>
    private IEnumerable<(Draft Draft, RemittanceCollectionDto Collection)> AllEligible =>
        _drafts.SelectMany(d => d.Scope.Collections.Select(c => (d, c)))
            .OrderBy(x => x.c.BusinessDate).ThenBy(x => x.c.ReferenceCode, StringComparer.Ordinal);
    private IEnumerable<(Draft Draft, RemittanceCollectionDto Collection)> Eligible => AllEligible
        .Where(c => string.IsNullOrEmpty(_sourceFilter) || SourceLabel(c.Collection) == _sourceFilter);

    /// <summary>Drafts that will become records: a collector with nothing selected is left out, never recorded as zero.</summary>
    private IEnumerable<Draft> Recordable => _drafts.Where(d => d.Selected.Count > 0);

    private int SelectedCount => _drafts.Sum(d => d.Selected.Count);
    private decimal SelectedTotal => _drafts.Sum(d => d.Expected);

    private bool CanRecord => Recordable.Any() && Recordable.All(d =>
        d.Amount is { } amount && amount > 0m && amount <= d.Expected && decimal.Round(amount, 2) == amount);

    private string PeriodLabel => $"{_from.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)} – {_to.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    protected override async Task OnInitializedAsync()
    {
        _from = From ?? ParseDate(QueryFrom) ?? _from;
        _to = To ?? ParseDate(QueryTo) ?? _to;
        _collectorFilter = Collector ?? QueryCollector ?? string.Empty;
        _instrumentFilter = Instrument ?? QueryInstrument ?? string.Empty;
        var collectors = await CollectorsApi.GetAllCollectorsAsync();
        _collectors = collectors.IsSuccess ? collectors.Value?.ToList() ?? [] : [];
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _confirming = false;
        try
        {
            var position = await Api.GetPositionAsync(_from, _to);
            if (position.IsSuccess) _position = position.Value;
            else { _position = null; _error = "The collector position couldn't be loaded."; }

            var register = await Api.GetHistoryAsync(_from, _to,
                Guid.TryParse(_collectorFilter, out var collector) ? collector : null,
                int.TryParse(_instrumentFilter, out var instrument) ? (RevenueInstrumentType)instrument : null,
                null);
            if (register.IsSuccess) _register = register.Value?.ToList() ?? [];
            else { _register = []; _error ??= "The remittance history couldn't be loaded."; }

            await LoadEligibleAsync();
        }
        catch { _error = "Remittance and liquidation couldn't be loaded."; }
        finally { _loading = false; }
    }

    /// <summary>
    /// The unremitted canonical collections of every collector who still holds money in the period. Read from the same scope
    /// endpoint a remittance is recorded against, so what is offered here is exactly what the server will accept.
    /// </summary>
    private async Task LoadEligibleAsync()
    {
        _drafts = [];
        if (_position is null) return;
        _scopeFrom = _from;
        _scopeTo = _to;
        _scopeInstrument = int.TryParse(_instrumentFilter, out var i) ? (RevenueInstrumentType)i : null;
        var drafts = new List<Draft>();
        foreach (var row in VisibleCollectors(_position).Where(x => x.Unremitted > 0m))
        {
            var result = await Api.GetScopeAsync(row.CollectorId, _scopeFrom, _scopeTo, _scopeInstrument);
            if (result is not { IsSuccess: true, Value: { } scope })
            {
                _error ??= $"{row.CollectorName}: the collections couldn't be loaded.";
                continue;
            }
            if (scope.Collections.Count > 0) drafts.Add(new Draft(row.CollectorId, row.CollectorName, scope));
        }
        _drafts = drafts;
    }

    private IEnumerable<CollectorPositionDto> VisibleCollectors(AccountabilityPositionDto position) =>
        position.Collectors.Where(x => !Guid.TryParse(_collectorFilter, out var id) || x.CollectorId == id);

    private IReadOnlyList<SummaryStrip.SummaryItem> SummaryItems(AccountabilityPositionDto p) => Preparation
        ? [new("Unremitted", Money(p.Unremitted)), new("Selected", Money(SelectedTotal), Emphasis: SelectedCount > 0)]
        : [new("Unremitted", Money(p.Unremitted), Emphasis: p.Unremitted != 0m), new("Remitted", Money(p.Remitted)), new("Collected", Money(p.Collected))];

    private string PrepareHref => $"/remittances/new?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&collector={_collectorFilter}&instrument={_instrumentFilter}";
    private string HistoryHref => $"/remittances?history=all&from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&collector={_collectorFilter}&instrument={_instrumentFilter}#rm-hist-title";
    private static DateOnly? ParseDate(string? value) => DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
    private string SelectedInstruments => string.Join(" and ", Recordable.SelectMany(d => d.Scope.Collections
        .Where(c => d.Selected.Contains(c.CollectionId))).Select(c => c.Instrument is { } i ? InstrumentCode(i) : "—").Distinct());

    private void OpenConfirm()
    {
        if (!Recordable.Any()) return;
        _formError = null;
        _message = null;
        _result = [];
        _confirming = true;
    }

    private void CloseConfirm() => _confirming = false;

    private void SelectEverything(bool include)
    {
        var visible = Eligible.Select(c => c.Collection.CollectionId).ToHashSet();
        foreach (var draft in _drafts)
        {
            draft.Selected.Clear();
            if (include) foreach (var collection in draft.Scope.Collections.Where(c => visible.Contains(c.CollectionId))) draft.Selected.Add(collection.CollectionId);
            draft.Amount = draft.Selected.Count == 0 ? null : draft.Expected;
        }
    }
    private void ClearSelection() { SelectEverything(false); _confirming = false; }

    private static void Toggle(Draft draft, Guid id, bool include)
    {
        if (include) draft.Selected.Add(id); else draft.Selected.Remove(id);
        draft.Amount = draft.Selected.Count == 0 ? null : draft.Expected;
    }

    private static string SourceLabel(RemittanceCollectionDto collection) => collection.Lines.Count == 0 ? "—"
        : string.Join(" · ", collection.Lines.Select(l => EEMOCantilanSDS.Client.Services.SourceNames.For(l.Name)));

    private static string ReconcileStatus(decimal expected, decimal remitted) =>
        remitted > expected ? "Over expected" : expected - remitted == 0m ? "Balanced" : "Short · for review";

    private RecordRemittanceRequest Request(Draft draft) => new(draft.OperationId, draft.CollectorId, _newDate, _scopeFrom, _scopeTo,
        _scopeInstrument, draft.Selected.ToList(), draft.Amount!.Value,
        string.IsNullOrWhiteSpace(draft.Reference) ? null : draft.Reference.Trim(),
        string.IsNullOrWhiteSpace(draft.Remarks) ? null : draft.Remarks.Trim());

    private async Task RecordAsync()
    {
        if (_saving || !CanRecord) return;
        _saving = true;
        _formError = null;
        try
        {
            var drafts = Recordable.ToList();
            IReadOnlyList<RemittanceDetailDto> recorded;
            if (drafts.Count == 1)
            {
                var single = await Api.RecordAsync(Request(drafts[0]));
                if (!single.IsSuccess) { _formError = single.Error ?? "The remittance could not be recorded."; return; }
                recorded = [single.Value!];
            }
            else
            {
                // Several collectors are saved together: each is its own record, and either all are saved or none is.
                var batch = await Api.RecordBatchAsync(new RecordRemittanceBatchRequest(drafts.Select(Request).ToList()));
                if (!batch.IsSuccess) { _formError = batch.Error ?? "The remittances could not be recorded. Nothing was recorded."; return; }
                recorded = batch.Value!;
            }
            var review = recorded.Where(x => x.NeedsReview).ToList();
            var message = recorded.Count == 1
                ? review.Count == 1
                    ? $"Remittance recorded with a difference of {Money(review[0].Row.DifferenceAmount)} for review."
                    : "Remittance recorded."
                : $"{recorded.Count} remittances recorded, one per collector{(review.Count > 0 ? $"; {review.Count} with a difference for review" : "")}.";
            await ReloadAsync();
            _result = recorded.ToList();
            _message = message;
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";

    private static string InstrumentCode(RevenueInstrumentType instrument) =>
        instrument == RevenueInstrumentType.OfficialReceipt ? "OR" : "CT";

    private static string ViewHref(RemittanceHistoryRowDto row) => row.SubmissionId is { } submission
        ? $"/remittances/group/{submission}"
        : $"/remittances/{row.PrimaryRemittanceId}";

    private static string CollectorSummary(RemittanceHistoryRowDto row) => row.Members.Count == 1
        ? row.Members[0].CollectorName : $"{row.Members[0].CollectorName} and {row.Members.Count - 1} more";
}
