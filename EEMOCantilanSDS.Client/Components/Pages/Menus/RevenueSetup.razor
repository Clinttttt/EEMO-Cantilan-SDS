@page "/settings/revenue"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Command.Revenue.CreateRevenueClassification
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IRevenueClassificationsApiClient RevenueApi

<PageTitle>@Branding.OfficeAcronym — Revenue Setup</PageTitle>

@* A revenue source is a stable identity (its internal reference) plus an append-only series of effective-dated
   policies (display name, instrument, description). The register is the working surface; a source's details,
   history and changes open in a right-side drawer so the register never shifts. The layout owns <main>. *@
<div class="v3-page rev-page">
    <WorkspaceHeader Title="Revenue Setup" Parent="Settings" ParentHref="/settings"
                     Subtitle="Revenue source identities and their effective-dated policies">
        <Actions>
            <button class="v3-btn v3-btn-primary" type="button" @onclick="OpenCreate">
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Add revenue source
            </button>
        </Actions>
    </WorkspaceHeader>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="v3-notice rev-feedback @(_feedbackIsError ? "v3-notice-error" : "is-success")" role="status" aria-live="polite">
            <span>@_feedback</span>
            <button type="button" aria-label="Dismiss message" @onclick="DismissFeedback">×</button>
        </div>
    }

    <section class="v3-panel rev-register" aria-labelledby="rev-register-title">
        <header class="v3-panel-header">
            <h2 id="rev-register-title">Revenue sources</h2>
            @if (!_loading && _loadError is null)
            {
                <span class="v3-panel-meta">@SourceCountText · policies as of @DateText(_asOf)</span>
            }
        </header>

        <div class="v3-toolbar rev-toolbar">
            <label class="v3-search rev-search">
                <span class="v3-sr-only">Search revenue sources</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" @bind="_search" placeholder="Search name or internal reference" />
            </label>
            <select class="v3-select rev-filter" @bind="_statusFilter" aria-label="Filter by status">
                <option value="All">All statuses</option>
                <option value="Active">Active</option>
                <option value="Retired">Retired</option>
            </select>
            <div class="rev-asof">
                <label class="v3-period">
                    <span>View as of</span>
                    <input class="v3-input" type="date" value="@DateText(_asOf)" @onchange="OnAsOfChanged" aria-label="View revenue policies as of date" />
                </label>
                <button class="v3-btn" type="button" @onclick="ResetAsOf" disabled="@(_asOf == PhilippineTime.Today)">Today</button>
            </div>
        </div>

        @if (_loading)
        {
            <div class="v3-table-wrap" aria-label="Loading revenue sources" aria-busy="true">
                <table class="v3-table rev-table">
                    <caption class="v3-sr-only">Revenue source configuration as of @DateText(_asOf)</caption>
                    <thead><tr><th>Revenue source</th><th>Instrument</th><th>Policy effective</th><th>Status</th><th><span class="v3-sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @for (var row = 0; row < 5; row++)
                        {
                            <tr class="rev-skeleton-row"><td><span></span><i></i></td><td><span></span></td><td><span></span></td><td><span></span></td><td><span></span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="rev-state" role="alert">
                <h3>Couldn’t load revenue setup</h3>
                <p>@_loadError</p>
                <button class="v3-btn v3-btn-primary" type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else if (_classifications.Count == 0)
        {
            <div class="rev-state">
                <h3>No revenue sources configured yet.</h3>
                <p>Add a source when its stable internal identity and initial policy are approved.</p>
                <button class="v3-btn v3-btn-primary" type="button" @onclick="OpenCreate">Add revenue source</button>
            </div>
        }
        else if (!VisibleClassifications.Any())
        {
            <div class="rev-state rev-state-compact">
                <h3>No revenue sources match these filters.</h3>
                <p>Try another search or status.</p>
            </div>
        }
        else
        {
            <div class="v3-table-wrap" role="region" aria-label="Revenue sources" tabindex="0">
                <table class="v3-table rev-table">
                    <caption class="v3-sr-only">Revenue source configuration as of @DateText(_asOf)</caption>
                    <thead>
                        <tr>
                            <th scope="col">Revenue source</th>
                            <th scope="col">Instrument</th>
                            <th scope="col">Policy effective</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="v3-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in VisibleClassifications)
                        {
                            <tr class="@(item.Id == _selected?.Id ? "is-selected" : null)">
                                <td>
                                    <div class="rev-source-name">@(item.EffectivePolicy?.DisplayName ?? NoCurrentPolicyLabel(item))</div>
                                    <div class="rev-source-code"><span>Internal reference</span> <code>@item.SemanticCode</code></div>
                                </td>
                                <td>
                                    @if (item.EffectivePolicy is null)
                                    {
                                        <span class="v3-muted">@NoCurrentPolicyLabel(item)</span>
                                    }
                                    else if (InstrumentCode(item.EffectivePolicy.PermittedInstrumentType) is { } instrumentCode)
                                    {
                                        <InstrumentChip Instrument="@instrumentCode" ShowName="true" />
                                    }
                                    else
                                    {
                                        <span class="v3-muted">@InstrumentLabel(item.EffectivePolicy.PermittedInstrumentType)</span>
                                    }
                                </td>
                                <td class="rev-date">@(item.EffectivePolicy is null ? "—" : DateText(item.EffectivePolicy.EffectiveDate))</td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="rev-status is-retired">Retired</span>
                                    }
                                    else if (item.EffectivePolicy is not null)
                                    {
                                        <span class="rev-status is-active">Active</span>
                                    }
                                    else if (item.HasPolicyVersions)
                                    {
                                        <span class="rev-status is-pending">Active · No policy effective yet</span>
                                    }
                                    else
                                    {
                                        <span class="rev-status is-pending">Active · No policy configured</span>
                                    }
                                </td>
                                <td class="rev-actions-cell">
                                    <button class="v3-btn v3-btn-sm rev-manage" type="button" @onclick="() => ManageAsync(item)"
                                            aria-label="@($"Manage {item.EffectivePolicy?.DisplayName ?? item.SemanticCode}")">Manage</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (_modal == RevenueModal.Create)
{
    @* Create: identity first (permanent), then the initial policy (the first appended version). *@
    <div class="v3-modal-backdrop v3-drawer-backdrop" role="presentation" @onclick="CloseModal">
        <section class="v3-modal v3-drawer rev-modal" role="dialog" aria-modal="true" aria-labelledby="rev-modal-title"
                 @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
            <header class="v3-modal-header">
                <h2 id="rev-modal-title">Add revenue source</h2>
                <button class="rev-modal-close" type="button" aria-label="Close" @onclick="CloseModal" disabled="@_mutating">×</button>
            </header>
            <form class="rev-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <div class="v3-modal-body">
                    <div class="v3-drawer-section">
                        <h3>Source identity</h3>
                        <label class="v3-field rev-field">
                            <span>Internal reference <b aria-hidden="true">*</b></span>
                            <input id="rev-create-code" @ref="_dialogFocus" @bind="_createCode" maxlength="80" minlength="2" pattern="[A-Z][A-Z0-9_]{1,79}" required autocomplete="off" aria-describedby="rev-create-code-hint" />
                            <small id="rev-create-code-hint">Permanent StallTrack reference, not an official accounting code. 2–80 uppercase letters, digits or underscores, starting with a letter.</small>
                        </label>
                    </div>
                    <div class="v3-drawer-section">
                        <h3>Initial policy</h3>
                        <div class="rev-field-pair">
                            <label class="v3-field rev-field">
                                <span>Revenue source name <b aria-hidden="true">*</b></span>
                                <input id="rev-create-name" @bind="_createName" maxlength="160" required autocomplete="off" />
                            </label>
                            <label class="v3-field rev-field">
                                <span>Effective date <b aria-hidden="true">*</b></span>
                                <input id="rev-create-date" type="date" value="@_createDate" @onchange="OnCreateDateChanged" min="@DateText(PhilippineTime.Today)" required />
                            </label>
                        </div>
                        <label class="v3-field rev-field">
                            <span>Accountable instrument</span>
                            <select @bind="_createInstrument">
                                <option value="">Not configured</option>
                                <option value="OfficialReceipt">Official Receipt</option>
                                <option value="CashTicket">Cash Ticket</option>
                            </select>
                        </label>
                        <label class="v3-field rev-field">
                            <span>Description <small>(optional)</small></span>
                            <textarea @bind="_createDescription" maxlength="500" rows="3"></textarea>
                        </label>
                    </div>
                    @if (_modalError is not null) { <div class="v3-notice v3-notice-error rev-inline-error" role="alert">@_modalError</div> }
                </div>
                <div class="v3-modal-footer rev-modal-actions">
                    <button class="v3-btn" type="button" @onclick="CloseModal" disabled="@_mutating">Cancel</button>
                    <button class="v3-btn v3-btn-primary" type="submit" disabled="@_mutating">@(_mutating ? "Saving…" : "Create revenue source")</button>
                </div>
            </form>
        </section>
    </div>
}
else if (_selected is { } source)
{
    <div class="v3-modal-backdrop v3-drawer-backdrop" role="presentation" @onclick="OnDrawerBackdrop">
        @if (_modal == RevenueModal.Policy)
        {
            @* A policy change appends a version; the identity above it and every earlier version stay unchanged. *@
            <section class="v3-modal v3-drawer v3-drawer-wide rev-modal" role="dialog" aria-modal="true" aria-labelledby="rev-modal-title"
                     @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
                <header class="v3-modal-header">
                    <h2 id="rev-modal-title">Schedule policy change</h2>
                    <button class="rev-modal-close" type="button" aria-label="Back to source details" @onclick="CloseModal" disabled="@_mutating">×</button>
                </header>
                <form class="rev-form" @onsubmit="AppendPolicyAsync" @onsubmit:preventDefault>
                    <div class="v3-modal-body">
                        <div class="v3-drawer-section">
                            <h3>Source identity</h3>
                            <dl class="v3-facts rev-facts">
                                <div><dt>Revenue source</dt><dd>@(source.EffectivePolicy?.DisplayName ?? NoCurrentPolicyLabel(source))</dd></div>
                                <div><dt>Internal reference</dt><dd><code class="rev-code">@source.SemanticCode</code></dd></div>
                            </dl>
                        </div>
                        <div class="v3-drawer-section">
                            <h3>New policy version</h3>
                            <p class="rev-hint">Adds a version from the effective date. Existing policy history remains unchanged.</p>
                            <div class="rev-field-pair">
                                <label class="v3-field rev-field">
                                    <span>Display name <b aria-hidden="true">*</b></span>
                                    <input id="rev-policy-name" @ref="_dialogFocus" @bind="_policyName" maxlength="160" required autocomplete="off" />
                                </label>
                                <label class="v3-field rev-field">
                                    <span>Effective date <b aria-hidden="true">*</b></span>
                                    <input id="rev-policy-date" type="date" value="@_policyDate" @onchange="OnPolicyDateChanged" min="@DateText(PhilippineTime.Today)" required />
                                </label>
                            </div>
                            <label class="v3-field rev-field">
                                <span>Accountable instrument</span>
                                <select @bind="_policyInstrument">
                                    <option value="">Not configured</option>
                                    <option value="OfficialReceipt">Official Receipt</option>
                                    <option value="CashTicket">Cash Ticket</option>
                                </select>
                            </label>
                            <label class="v3-field rev-field">
                                <span>Description <small>(optional)</small></span>
                                <textarea @bind="_policyDescription" maxlength="500" rows="3"></textarea>
                            </label>
                        </div>
                        @if (_modalError is not null) { <div class="v3-notice v3-notice-error rev-inline-error" role="alert">@_modalError</div> }
                    </div>
                    <div class="v3-modal-footer rev-modal-actions">
                        <button class="v3-btn" type="button" @onclick="CloseModal" disabled="@_mutating">Cancel</button>
                        <button class="v3-btn v3-btn-primary" type="submit" disabled="@_mutating">@(_mutating ? "Saving…" : "Add policy version")</button>
                    </div>
                </form>
            </section>
        }
        else
        {
            <section class="v3-modal v3-drawer v3-drawer-wide rev-drawer" role="dialog" aria-modal="true" aria-labelledby="rev-detail-title"
                     @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
                <header class="v3-modal-header rev-drawer-header">
                    <div class="rev-drawer-identity">
                        <h2 id="rev-detail-title">@(source.EffectivePolicy?.DisplayName ?? NoCurrentPolicyLabel(source))</h2>
                        <p class="rev-detail-reference">Internal reference <code>@source.SemanticCode</code></p>
                    </div>
                    <button class="rev-modal-close" type="button" aria-label="Close details" @onclick="CloseDetails" @ref="_drawerFocus">×</button>
                </header>
                <div class="v3-modal-body">
                    <div class="v3-drawer-section">
                        <h3>Policy in effect on @DateText(_asOf)</h3>
                        <dl class="v3-facts rev-facts">
                            <div><dt>Status</dt><dd>@(source.IsActive ? "Active" : "Retired")</dd></div>
                            <div>
                                <dt>Instrument</dt>
                                <dd>@(source.EffectivePolicy is null ? NoCurrentPolicyLabel(source) : InstrumentLabel(source.EffectivePolicy.PermittedInstrumentType))</dd>
                            </div>
                            <div><dt>Effective from</dt><dd>@(source.EffectivePolicy is null ? "No policy effective yet" : DateText(source.EffectivePolicy.EffectiveDate))</dd></div>
                            <div class="rev-fact-description">
                                <dt>Description</dt>
                                <dd>@(string.IsNullOrWhiteSpace(source.EffectivePolicy?.Description) ? "No description" : source.EffectivePolicy!.Description)</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="v3-drawer-section">
                        <div class="rev-history-heading">
                            <h3>Policy history</h3>
                            <p>Versions are retained and cannot be edited.</p>
                        </div>
                        @if (_historyLoading)
                        {
                            <p class="rev-history-note" aria-busy="true">Loading policy history…</p>
                        }
                        else if (_historyError is not null)
                        {
                            <div class="v3-notice v3-notice-error v3-notice-row rev-inline-error" role="alert">
                                <span>@_historyError</span>
                                <button class="v3-btn v3-btn-sm" type="button" @onclick="() => LoadHistoryAsync(source.Id)">Try again</button>
                            </div>
                        }
                        else if (_history.Count == 0)
                        {
                            <p class="rev-history-note">No policy versions have been configured.</p>
                        }
                        else
                        {
                            <div class="v3-table-wrap rev-history-wrap" role="region" aria-label="Policy history" tabindex="0">
                                <table class="v3-table rev-history-table">
                                    <caption class="v3-sr-only">Immutable policy history, newest version first</caption>
                                    <thead>
                                        <tr><th scope="col">Effective</th><th scope="col">Policy</th><th scope="col">Instrument</th><th scope="col">Version</th><th scope="col">Added</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var policy in _history)
                                        {
                                            <tr>
                                                <td class="rev-date">@DateText(policy.EffectiveDate)</td>
                                                <td>
                                                    <span class="rev-history-name">@policy.DisplayName</span>
                                                    @if (!string.IsNullOrWhiteSpace(policy.Description))
                                                    {
                                                        <span class="v3-block">@policy.Description</span>
                                                    }
                                                </td>
                                                <td>@InstrumentLabel(policy.PermittedInstrumentType)</td>
                                                <td><span class="rev-status @HistoryStatusClass(policy)">@HistoryStatus(policy)</span></td>
                                                <td>
                                                    @(string.IsNullOrWhiteSpace(policy.CreatedBy) ? "Not recorded" : policy.CreatedBy)
                                                    <span class="v3-block">@CreatedAtText(policy.CreatedAt)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                @if (source.IsActive)
                {
                    <footer class="v3-modal-footer rev-drawer-footer">
                        <button class="v3-btn rev-button-quiet-danger" type="button" @onclick="OpenRetire">Retire source</button>
                        <button class="v3-btn v3-btn-primary" type="button" @onclick="OpenPolicy">Schedule policy change</button>
                    </footer>
                }
            </section>
        }
    </div>

    @if (_modal == RevenueModal.Retire)
    {
        <div class="v3-modal-backdrop rev-confirm-backdrop" role="presentation" @onclick="CloseModal">
            <section class="v3-modal rev-modal rev-confirm" role="alertdialog" aria-modal="true" aria-labelledby="rev-modal-title" aria-describedby="rev-retire-text"
                     @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
                <header class="v3-modal-header">
                    <h2 id="rev-modal-title">Retire revenue source?</h2>
                    <button class="rev-modal-close" type="button" aria-label="Close" @onclick="CloseModal" disabled="@_mutating">×</button>
                </header>
                <div class="v3-modal-body">
                    <p id="rev-retire-text" class="rev-confirm-text"><strong>@(source.EffectivePolicy?.DisplayName ?? NoCurrentPolicyLabel(source))</strong> will no longer be active configuration. Its identity and policy history will be retained.</p>
                    @if (_modalError is not null) { <div class="v3-notice v3-notice-error rev-inline-error" role="alert">@_modalError</div> }
                </div>
                <div class="v3-modal-footer rev-modal-actions">
                    <button class="v3-btn" type="button" @onclick="CloseModal" disabled="@_mutating" @ref="_dialogFocus">Cancel</button>
                    <button class="v3-btn rev-button-danger" type="button" @onclick="RetireAsync" disabled="@_mutating">@(_mutating ? "Retiring…" : "Retire source")</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private IReadOnlyList<RevenueClassificationDto> _classifications = [];
    private IReadOnlyList<RevenueClassificationPolicyDto> _history = [];
    private RevenueClassificationDto? _selected;
    private DateOnly _asOf = PhilippineTime.Today;
    private string _search = string.Empty;
    private string _statusFilter = "All";
    private bool _loading = true;
    private bool _historyLoading;
    private bool _mutating;
    private long _loadGeneration;
    private string? _loadError;
    private string? _historyError;
    private string? _feedback;
    private bool _feedbackIsError;
    private string? _modalError;
    private RevenueModal _modal;
    private string _createName = string.Empty;
    private string _createCode = string.Empty;
    private string _createDate = DateText(PhilippineTime.Today);
    private string? _createDescription;
    private RevenueInstrumentType? _createInstrument;
    private string _policyName = string.Empty;
    private string _policyDate = DateText(PhilippineTime.Today);
    private string? _policyDescription;
    private RevenueInstrumentType? _policyInstrument;
    private ElementReference _dialogFocus;
    private ElementReference _drawerFocus;
    private bool _focusPending;

    private IEnumerable<RevenueClassificationDto> VisibleClassifications =>
        _classifications
            .Where(item => _statusFilter == "All" || (_statusFilter == "Active") == item.IsActive)
            .Where(item => string.IsNullOrWhiteSpace(_search)
                || (item.EffectivePolicy?.DisplayName?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                || item.SemanticCode.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.EffectivePolicy?.DisplayName ?? item.SemanticCode, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.SemanticCode, StringComparer.OrdinalIgnoreCase);

    private string SourceCountText
    {
        get
        {
            var visible = VisibleClassifications.Count();
            var noun = _classifications.Count == 1 ? "source" : "sources";
            return visible == _classifications.Count ? $"{visible} {noun}" : $"{visible} of {_classifications.Count} {noun}";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Moves keyboard focus into a drawer or dialog when it opens, and back to the drawer when a dialog closes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try
        {
            if (_modal != RevenueModal.None) await _dialogFocus.FocusAsync();
            else if (_selected is not null) await _drawerFocus.FocusAsync();
        }
        catch { /* the surface closed before focus could move */ }
    }

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var requestedAsOf = _asOf;
        _loading = true;
        _loadError = null;
        try
        {
            var result = await RevenueApi.GetClassificationsAsync(requestedAsOf);
            if (generation != _loadGeneration) return;

            if (!result.IsSuccess || result.Value is null)
            {
                _loadError = ErrorMessage(result, "The revenue source register could not be retrieved.");
                return;
            }

            _classifications = result.Value;
            if (_selected is not null)
            {
                _selected = _classifications.FirstOrDefault(item => item.Id == _selected.Id);
                if (_selected is null)
                {
                    _history = [];
                    _historyError = null;
                }
            }
        }
        catch
        {
            if (generation != _loadGeneration) return;

            _loadError = "The revenue source register could not be retrieved. Check the connection and try again.";
        }
        finally
        {
            if (generation == _loadGeneration)
                _loading = false;
        }
    }

    private async Task OnAsOfChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _asOf = date;
            await LoadAsync();
        }
    }

    private void OnCreateDateChanged(ChangeEventArgs args) => _createDate = args.Value?.ToString() ?? string.Empty;

    private void OnPolicyDateChanged(ChangeEventArgs args) => _policyDate = args.Value?.ToString() ?? string.Empty;

    private async Task ResetAsOf()
    {
        _asOf = PhilippineTime.Today;
        await LoadAsync();
    }

    private async Task ManageAsync(RevenueClassificationDto item)
    {
        _selected = item;
        _focusPending = true;
        await LoadHistoryAsync(item.Id);
    }

    private async Task LoadHistoryAsync(Guid classificationId)
    {
        _historyLoading = true;
        _historyError = null;
        try
        {
            var result = await RevenueApi.GetPolicyHistoryAsync(classificationId);
            if (!result.IsSuccess || result.Value is null)
            {
                _history = [];
                _historyError = ErrorMessage(result, "Policy history could not be retrieved.");
                return;
            }

            // The API contract returns newest first. Preserve that order as the official history sequence.
            _history = result.Value;
        }
        catch
        {
            _history = [];
            _historyError = "Policy history could not be retrieved. Check the connection and try again.";
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void OpenCreate()
    {
        _createName = string.Empty;
        _createCode = string.Empty;
        _createDate = DateText(PhilippineTime.Today);
        _createDescription = null;
        _createInstrument = null;
        OpenModal(RevenueModal.Create);
    }

    private async Task CreateAsync()
    {
        if (_mutating) return;
        _modalError = ValidateCreate();
        if (_modalError is not null) return;

        _mutating = true;
        try
        {
            var command = new CreateRevenueClassificationCommand(
                _createCode.Trim(), _createName.Trim(), ParseDate(_createDate),
                string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription.Trim(), _createInstrument);
            var result = await RevenueApi.CreateClassificationAsync(command);
            if (!result.IsSuccess)
            {
                _modalError = ErrorMessage(result, "The revenue source could not be created.");
                return;
            }

            var createdId = result.Value?.Id;
            _modal = RevenueModal.None;
            SetFeedback("Revenue source created.");
            await LoadAsync();
            if (createdId is { } id)
            {
                _selected = _classifications.FirstOrDefault(item => item.Id == id);
                if (_selected is not null) await LoadHistoryAsync(id);
            }
        }
        catch
        {
            _modalError = "The revenue source could not be created. Check the connection and try again.";
        }
        finally
        {
            _mutating = false;
        }
    }

    private string? ValidateCreate()
    {
        if (string.IsNullOrWhiteSpace(_createName)) return "Enter a revenue source name.";
        if (_createName.Trim().Length > 160) return "The revenue source name must be 160 characters or fewer.";
        if (string.IsNullOrWhiteSpace(_createCode) || !IsValidSemanticCode(_createCode.Trim()))
            return "Use 2–80 uppercase letters, digits, or underscores, starting with a letter.";
        if (!DateOnly.TryParseExact(_createDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            return "Choose a valid effective date.";
        if (date < PhilippineTime.Today) return "A revenue policy cannot take effect in the past.";
        if (_createDescription?.Length > 500) return "Description must be 500 characters or fewer.";
        return null;
    }

    private void OpenPolicy()
    {
        if (_selected is null || !_selected.IsActive) return;
        var seed = _history.FirstOrDefault() ?? _selected.EffectivePolicy;
        _policyName = seed?.DisplayName ?? string.Empty;
        _policyDescription = seed?.Description;
        _policyInstrument = seed?.PermittedInstrumentType;
        _policyDate = DateText(PhilippineTime.Today);
        OpenModal(RevenueModal.Policy);
    }

    private async Task AppendPolicyAsync()
    {
        if (_mutating || _selected is null || !_selected.IsActive) return;
        _modalError = ValidatePolicy();
        if (_modalError is not null) return;

        _mutating = true;
        var classificationId = _selected.Id;
        try
        {
            var request = new AppendRevenueClassificationPolicyRequest(
                ParseDate(_policyDate), _policyName.Trim(),
                string.IsNullOrWhiteSpace(_policyDescription) ? null : _policyDescription.Trim(), _policyInstrument);
            var result = await RevenueApi.AppendPolicyAsync(classificationId, request);
            if (!result.IsSuccess)
            {
                _modalError = ErrorMessage(result, "The policy version could not be added.");
                return;
            }

            _modal = RevenueModal.None;
            SetFeedback("Policy version added. Existing policy history was retained.");
            await LoadAsync();
            if (_selected is not null) await LoadHistoryAsync(classificationId);
        }
        catch
        {
            _modalError = "The policy version could not be added. Check the connection and try again.";
        }
        finally
        {
            _mutating = false;
        }
    }

    private string? ValidatePolicy()
    {
        if (string.IsNullOrWhiteSpace(_policyName)) return "Enter a display name.";
        if (_policyName.Trim().Length > 160) return "The display name must be 160 characters or fewer.";
        if (!DateOnly.TryParseExact(_policyDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            return "Choose a valid effective date.";
        if (date < PhilippineTime.Today) return "A policy cannot take effect in the past.";
        if (_policyDescription?.Length > 500) return "Description must be 500 characters or fewer.";
        return null;
    }

    private void OpenRetire()
    {
        if (_selected is null || !_selected.IsActive) return;
        OpenModal(RevenueModal.Retire);
    }

    private async Task RetireAsync()
    {
        if (_mutating || _selected is null || !_selected.IsActive) return;
        _mutating = true;
        var classificationId = _selected.Id;
        try
        {
            var result = await RevenueApi.RetireAsync(classificationId);
            if (!result.IsSuccess)
            {
                _modalError = ErrorMessage(result, "The revenue source could not be retired.");
                return;
            }

            _modal = RevenueModal.None;
            SetFeedback("Revenue source retired. Its identity and policy history remain available.");
            await LoadAsync();
            if (_selected is not null) await LoadHistoryAsync(classificationId);
        }
        catch
        {
            _modalError = "The revenue source could not be retired. Check the connection and try again.";
        }
        finally
        {
            _mutating = false;
        }
    }

    private void OpenModal(RevenueModal modal)
    {
        _modalError = null;
        _modal = modal;
        _focusPending = true;
    }

    private void CloseModal()
    {
        if (_mutating) return;
        _modalError = null;
        _modal = RevenueModal.None;
        _focusPending = true;
    }

    private void CloseDetails() => _selected = null;

    // Outside a form the backdrop closes the details drawer; inside the policy form it returns to the details.
    private void OnDrawerBackdrop()
    {
        if (_modal == RevenueModal.None) CloseDetails();
        else CloseModal();
    }

    private void OnDialogKey(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || _mutating) return;
        OnDrawerBackdrop();
    }

    private void SetFeedback(string message)
    {
        _feedback = message;
        _feedbackIsError = false;
    }

    private void DismissFeedback() => _feedback = null;

    private string HistoryStatus(RevenueClassificationPolicyDto policy)
    {
        var today = PhilippineTime.Today;
        if (policy.EffectiveDate > today) return "Scheduled";
        var current = _history.FirstOrDefault(item => item.EffectiveDate <= today);
        return current?.PolicyId == policy.PolicyId ? "In effect" : "Previous";
    }

    private string HistoryStatusClass(RevenueClassificationPolicyDto policy) => HistoryStatus(policy) switch
    {
        "In effect" => "is-active",
        "Scheduled" => "is-pending",
        _ => "is-neutral"
    };

    private static string InstrumentLabel(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "Official Receipt",
        RevenueInstrumentType.CashTicket => "Cash Ticket",
        _ => "Not configured"
    };

    private static string? InstrumentCode(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "OR",
        RevenueInstrumentType.CashTicket => "CT",
        _ => null
    };

    private static string NoCurrentPolicyLabel(RevenueClassificationDto item) =>
        item.HasPolicyVersions ? "No policy effective yet" : "No policy configured";

    private static string ErrorMessage<T>(Result<T> result, string fallback)
    {
        if (result.ValidationErrors is { Count: > 0 } validation)
            return string.Join(" ", validation.Values.SelectMany(messages => messages));
        if (!string.IsNullOrWhiteSpace(result.Error)) return result.Error;
        return result.Status switch
        {
            ResultStatus.Forbidden => "You do not have permission to make this change.",
            ResultStatus.NotFound => "This revenue source is no longer available. Refresh and try again.",
            ResultStatus.Conflict => "This change conflicts with an existing policy version. Review the date and try again.",
            ResultStatus.Unauthorized => "Your session has expired. Sign in again and retry.",
            _ => fallback
        };
    }

    private static bool IsValidSemanticCode(string code) =>
        code.Length is >= 2 and <= 80
        && code[0] is >= 'A' and <= 'Z'
        && code.All(character => character is >= 'A' and <= 'Z' or >= '0' and <= '9' or '_');

    private static DateOnly ParseDate(string value) =>
        DateOnly.ParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string DateText(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string DateText(DateTime date) => date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);

    private static string CreatedAtText(DateTime createdAt) =>
        PhilippineTime.ToPhilippineTime(createdAt).ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture);

    private enum RevenueModal { None, Create, Policy, Retire }
}
