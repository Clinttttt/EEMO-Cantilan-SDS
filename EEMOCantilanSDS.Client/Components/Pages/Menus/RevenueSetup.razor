@page "/settings/revenue"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Services
@using System.Globalization
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Common.Revenue
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IRevenueClassificationsApiClient RevenueApi

<PageTitle>@Branding.OfficeAcronym — Revenue Sources</PageTitle>

@* A directory of the municipality's revenue sources, grouped as the official Monthly Income statement groups its income
   (OfficialMonthlyIncomeStructure), with Arrears and Fines under Others. Read-only: a source's identity, policy and history are
   in its details drawer; nothing here creates, changes, retires or switches a source, and a source's status does not control
   collection. Every source the tenant holds is listed, including one outside the official list. The layout owns <main>. *@
<div class="v3-page rev-page">
    <WorkspaceHeader Title="Revenue Sources" Parent="Settings" ParentHref="/settings" />

    @if (_loading)
    {
        <section class="v3-panel rev-group" aria-label="Loading revenue sources" aria-busy="true">
            <ul class="rev-list">
                @for (var row = 0; row < 6; row++)
                {
                    <li class="rev-row rev-skeleton-row"><span></span><span></span></li>
                }
            </ul>
        </section>
    }
    else if (_loadError is not null)
    {
        <div class="v3-panel rev-state" role="alert">
            <h3>Couldn’t load revenue sources</h3>
            <p>@_loadError</p>
            <button class="v3-btn v3-btn-primary" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (_classifications.Count == 0)
    {
        <div class="v3-panel rev-state">
            <h3>No revenue sources configured yet.</h3>
        </div>
    }
    else
    {
        @foreach (var group in Groups)
        {
            <section class="v3-panel rev-group" aria-labelledby="@($"rev-g-{group.Key}")">
                <header class="rev-group-head">
                    <h2 id="@($"rev-g-{group.Key}")">@group.Label</h2>
                    <span class="rev-group-count">@group.Sources.Count</span>
                </header>
                <ul class="rev-list">
                    @foreach (var item in group.Sources)
                    {
                        <li class="rev-row @(item.IsActive ? null : "is-retired") @(item.Id == _selected?.Id ? "is-selected" : null)">
                            <span class="rev-source-name">@SourceNames.For(item.SemanticCode, item.EffectivePolicy?.DisplayName)</span>
                            <span class="rev-row-instrument">
                                @if (item.SemanticCode == RevenueClassificationCodes.VegetableFruitSpaceRental)
                                {
                                    @* Vegetable / Fruits keeps two instruments: OR for its monthly space rental, CT for its daily transactions. *@
                                    <span class="rev-chip-pair"><InstrumentChip Instrument="OR" /> <small>Monthly</small></span>
                                    <span class="rev-chip-pair"><InstrumentChip Instrument="CT" /> <small>Daily</small></span>
                                }
                                else if (InstrumentCode(item.EffectivePolicy?.PermittedInstrumentType) is { } instrument)
                                {
                                    <InstrumentChip Instrument="@instrument" ShowName="true" />
                                }
                                else
                                {
                                    <span class="v3-muted">—</span>
                                }
                            </span>
                            <span class="rev-row-status">
                                @if (!item.IsActive)
                                {
                                    <span class="rev-status is-retired">Retired</span>
                                }
                                else if (item.EffectivePolicy is null)
                                {
                                    <span class="rev-status is-pending">@NoCurrentPolicyLabel(item)</span>
                                }
                            </span>
                            <button class="v3-btn v3-btn-sm rev-details" type="button" @onclick="() => ShowDetailsAsync(item)"
                                    aria-label="@($"Details for {SourceNames.For(item.SemanticCode, item.EffectivePolicy?.DisplayName)}")">Details</button>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@if (_selected is { } source)
{
    <div class="v3-modal-backdrop v3-drawer-backdrop" role="presentation" @onclick="CloseDetails">
        <section class="v3-modal v3-drawer v3-drawer-wide rev-drawer" role="dialog" aria-modal="true" aria-labelledby="rev-detail-title"
                 @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
            <header class="v3-modal-header rev-drawer-header">
                <div class="rev-drawer-identity">
                    <h2 id="rev-detail-title">@SourceNames.For(source.SemanticCode, source.EffectivePolicy?.DisplayName)</h2>
                    <p class="rev-detail-reference">Internal reference <code>@source.SemanticCode</code></p>
                </div>
                <button class="rev-modal-close" type="button" aria-label="Close details" @onclick="CloseDetails" @ref="_drawerFocus">×</button>
            </header>
            <div class="v3-modal-body">
                <div class="v3-drawer-section">
                    <dl class="v3-facts rev-facts">
                        <div><dt>Status</dt><dd>@(source.IsActive ? "Active" : "Retired")</dd></div>
                        <div>
                            <dt>Instrument</dt>
                            <dd>@(source.SemanticCode == RevenueClassificationCodes.VegetableFruitSpaceRental
                                    ? "Official Receipt for monthly space rental; Cash Ticket for daily transactions"
                                    : source.EffectivePolicy is null ? NoCurrentPolicyLabel(source) : InstrumentLabel(source.EffectivePolicy.PermittedInstrumentType))</dd>
                        </div>
                        <div><dt>Effective from</dt><dd>@(source.EffectivePolicy is null ? "No policy effective yet" : DateText(source.EffectivePolicy.EffectiveDate))</dd></div>
                        @if (!string.IsNullOrWhiteSpace(source.EffectivePolicy?.Description))
                        {
                            <div class="rev-fact-description"><dt>Description</dt><dd>@source.EffectivePolicy!.Description</dd></div>
                        }
                    </dl>
                </div>

                <div class="v3-drawer-section">
                    <div class="rev-history-heading"><h3>Policy history</h3></div>
                    @if (_historyLoading)
                    {
                        <p class="rev-history-note" aria-busy="true">Loading policy history…</p>
                    }
                    else if (_historyError is not null)
                    {
                        <div class="v3-notice v3-notice-error v3-notice-row rev-inline-error" role="alert">
                            <span>@_historyError</span>
                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => LoadHistoryAsync(source.Id)">Try again</button>
                        </div>
                    }
                    else if (_history.Count == 0)
                    {
                        <p class="rev-history-note">No policy versions have been configured.</p>
                    }
                    else
                    {
                        <div class="v3-table-wrap rev-history-wrap" role="region" aria-label="Policy history" tabindex="0">
                            <table class="v3-table rev-history-table">
                                <caption class="v3-sr-only">Policy history, newest version first</caption>
                                <thead>
                                    <tr><th scope="col">Effective</th><th scope="col">Policy</th><th scope="col">Instrument</th><th scope="col">Version</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var policy in _history)
                                    {
                                        <tr>
                                            <td class="rev-date">@DateText(policy.EffectiveDate)</td>
                                            <td>
                                                <span class="rev-history-name">@policy.DisplayName</span>
                                                @if (!string.IsNullOrWhiteSpace(policy.Description))
                                                {
                                                    <span class="v3-block">@policy.Description</span>
                                                }
                                            </td>
                                            <td>@InstrumentLabel(policy.PermittedInstrumentType)</td>
                                            <td><span class="rev-status @HistoryStatusClass(policy)">@HistoryStatus(policy)</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<RevenueClassificationDto> _classifications = [];
    private IReadOnlyList<RevenueClassificationPolicyDto> _history = [];
    private RevenueClassificationDto? _selected;
    private bool _loading = true;
    private bool _historyLoading;
    private long _loadGeneration;
    private string? _loadError;
    private string? _historyError;
    private ElementReference _drawerFocus;
    private bool _focusPending;

    private sealed record SourceGroup(string Key, string Label, List<RevenueClassificationDto> Sources);

    // The official Monthly Income groups, in their order, plus Others. Arrears and Fines read as Others on this page; any source
    // the official list does not place (a tenant's own) is listed there too, never hidden or merged.
    private const string OthersKey = "OTHERS";
    private static readonly (string Key, string Label)[] GroupOrder =
    [
        (OfficialMonthlyIncomeStructure.Market, "Income from Market"),
        (OfficialMonthlyIncomeStructure.Rent, "Rent Income — Stall Rental"),
        (OfficialMonthlyIncomeStructure.Space, "Space Rental"),
        (OfficialMonthlyIncomeStructure.Terminal, "Income from Terminal"),
        (OfficialMonthlyIncomeStructure.Slaughterhouse, "Income from Slaughterhouse"),
        (OthersKey, "Others"),
    ];

    private static string GroupOf(string semanticCode)
    {
        if (semanticCode is RevenueClassificationCodes.Arrears or RevenueClassificationCodes.PenaltiesAndFines) return OthersKey;
        var row = OfficialMonthlyIncomeStructure.Rows.FirstOrDefault(r => r.ClassificationCode == semanticCode && r.GroupKey != OfficialMonthlyIncomeStructure.Pending);
        return row?.GroupKey ?? OthersKey;
    }

    // Each source in the order its official row appears on the statement; sources off the statement follow by name.
    private static int OrderOf(string semanticCode)
    {
        for (var i = 0; i < OfficialMonthlyIncomeStructure.Rows.Count; i++)
            if (OfficialMonthlyIncomeStructure.Rows[i].ClassificationCode == semanticCode) return i;
        return int.MaxValue;
    }

    private IEnumerable<SourceGroup> Groups => GroupOrder
        .Select(g => new SourceGroup(g.Key, g.Label, _classifications
            .Where(c => GroupOf(c.SemanticCode) == g.Key)
            .OrderBy(c => OrderOf(c.SemanticCode))
            .ThenBy(c => SourceNames.For(c.SemanticCode, c.EffectivePolicy?.DisplayName), StringComparer.OrdinalIgnoreCase)
            .ToList()))
        .Where(g => g.Sources.Count > 0);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Moves keyboard focus into the details drawer when it opens.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { if (_selected is not null) await _drawerFocus.FocusAsync(); }
        catch { /* the drawer closed before focus could move */ }
    }

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        _loading = true;
        _loadError = null;
        try
        {
            var result = await RevenueApi.GetClassificationsAsync(PhilippineTime.Today);
            if (generation != _loadGeneration) return;

            if (!result.IsSuccess || result.Value is null)
            {
                _loadError = ErrorMessage(result, "The revenue sources could not be retrieved.");
                return;
            }

            _classifications = result.Value;
        }
        catch
        {
            if (generation != _loadGeneration) return;
            _loadError = "The revenue sources could not be retrieved. Check the connection and try again.";
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
        }
    }

    private async Task ShowDetailsAsync(RevenueClassificationDto item)
    {
        _selected = item;
        _focusPending = true;
        await LoadHistoryAsync(item.Id);
    }

    private async Task LoadHistoryAsync(Guid classificationId)
    {
        _historyLoading = true;
        _historyError = null;
        try
        {
            var result = await RevenueApi.GetPolicyHistoryAsync(classificationId);
            if (!result.IsSuccess || result.Value is null)
            {
                _history = [];
                _historyError = ErrorMessage(result, "Policy history could not be retrieved.");
                return;
            }

            // The API contract returns newest first. Preserve that order as the official history sequence.
            _history = result.Value;
        }
        catch
        {
            _history = [];
            _historyError = "Policy history could not be retrieved. Check the connection and try again.";
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void CloseDetails() => _selected = null;

    private void OnDialogKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseDetails();
    }

    private string HistoryStatus(RevenueClassificationPolicyDto policy)
    {
        var today = PhilippineTime.Today;
        if (policy.EffectiveDate > today) return "Scheduled";
        var current = _history.FirstOrDefault(item => item.EffectiveDate <= today);
        return current?.PolicyId == policy.PolicyId ? "In effect" : "Previous";
    }

    private string HistoryStatusClass(RevenueClassificationPolicyDto policy) => HistoryStatus(policy) switch
    {
        "In effect" => "is-active",
        "Scheduled" => "is-pending",
        _ => "is-neutral"
    };

    private static string InstrumentLabel(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "Official Receipt",
        RevenueInstrumentType.CashTicket => "Cash Ticket",
        _ => "Not configured"
    };

    private static string? InstrumentCode(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "OR",
        RevenueInstrumentType.CashTicket => "CT",
        _ => null
    };

    private static string NoCurrentPolicyLabel(RevenueClassificationDto item) =>
        item.HasPolicyVersions ? "No policy effective yet" : "No policy configured";

    private static string ErrorMessage<T>(Result<T> result, string fallback)
    {
        if (result.ValidationErrors is { Count: > 0 } validation)
            return string.Join(" ", validation.Values.SelectMany(messages => messages));
        if (!string.IsNullOrWhiteSpace(result.Error)) return result.Error;
        return result.Status switch
        {
            ResultStatus.Forbidden => "You do not have permission to view revenue sources.",
            ResultStatus.Unauthorized => "Your session has expired. Sign in again and retry.",
            _ => fallback
        };
    }

    private static string DateText(DateOnly date) => date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
}
