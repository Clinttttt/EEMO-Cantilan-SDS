@page "/import-history/{Facility}"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Command.Payments.BulkImportPaymentHistory
@using EEMOCantilanSDS.Application.Dtos.Payments
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IPaymentsApiClient PaymentsApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject IStallsApiClient StallsApi

@*
    Records an office's existing payment history, so it can adopt the system mid-contract.

    Importing the HISTORY rather than an opening balance keeps arrears derived: the system goes on working out
    what is owed from the term and the payments against it, so every peso traces to a receipt.

    Structured to match Import Stallholders step for step - upload, review and edit, save - because the office
    meets both screens in the same sitting and a second layout for the same task is a second thing to learn.
*@

<PageTitle>StallTrack — Import @FacilityName payment history</PageTitle>

<header class="topbar">
    <div class="topbar-left flex gap-2">
        <a href="@BackUrl" class="iph-back-btn" title="Back to @FacilityName" aria-label="Back to @FacilityName">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="topbar-title">Import Payment History</div>
            <div class="topbar-breadcrumb">
                <a href="/menu" class="breadcrumb-link">Dashboard</a>
                <span class="breadcrumb-sep">/</span>
                <a href="@BackUrl" class="breadcrumb-link">@FacilityShort</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-active">Import history</span>
            </div>
        </div>
    </div>
</header>

<div class="iph-page">
    <div class="iph-hero">
        <div class="iph-hero-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18" /><path d="M7 14l4-4 3 3 5-6" />
            </svg>
        </div>
        <div class="iph-hero-body">
            <div class="iph-hero-eyebrow">@FacilityShort · PAYMENT HISTORY</div>
            <h1 class="iph-hero-title">Import @FacilityName Payment History</h1>
            <p class="iph-hero-sub">Upload past payments, review &amp; edit, then save.</p>
        </div>
        <div class="iph-steps">
            <div class="iph-step @(StepClass(1))"><span class="iph-step-no">1</span> Upload</div>
            <div class="iph-step-line"></div>
            <div class="iph-step @(StepClass(2))"><span class="iph-step-no">2</span> Review &amp; edit</div>
            <div class="iph-step-line"></div>
            <div class="iph-step @(StepClass(3))"><span class="iph-step-no">3</span> Save</div>
        </div>
    </div>

    @if (!IsSupported)
    {
        <div class="iph-card">
            <div class="iph-note">
                Payment history is imported for the monthly-billed facilities, where one row is one month.
                <strong>@FacilityName</strong> is collected per market day, so its history is recorded separately.
            </div>
            <div class="iph-foot">
                <a class="iph-btn iph-btn-outline" href="@BackUrl">Back to @FacilityShort</a>
            </div>
        </div>
    }
    else if (_result is not null)
    {
        <!-- ── Step 3: Saved ── -->
        <div class="iph-card">
            <div class="iph-summary">
                <div class="iph-stat"><div class="iph-stat-val">@_result.RecordedCount</div><div class="iph-stat-key">Paid in full</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_result.PartialCount</div><div class="iph-stat-key">Part paid</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_result.AlreadyRecordedCount</div><div class="iph-stat-key">Already on record</div></div>
                <div class="iph-stat @(_result.RejectedCount > 0 ? "iph-stat-attention" : "")"><div class="iph-stat-val">@_result.RejectedCount</div><div class="iph-stat-key">Not recorded</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@Peso(_result.TotalRecorded)</div><div class="iph-stat-key">Total recorded</div></div>
            </div>

            @if (_result.RejectedCount > 0 || _result.AlreadyRecordedCount > 0)
            {
                <div class="iph-note">
                    Correct these rows on your sheet and upload again. Re-uploading the whole file is safe — a month
                    already recorded is reported, not written twice.
                </div>

                <div class="iph-table-wrap">
                    <table class="iph-table">
                        <thead>
                            <tr>
                                <th class="iph-th-num">#</th>
                                <th>Stall / Space</th>
                                <th>Period</th>
                                <th class="iph-r">Amount</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _result.Results.Where(r => r.Outcome is ImportPaymentOutcome.Rejected or ImportPaymentOutcome.AlreadyRecorded))
                            {
                                <tr>
                                    <td class="iph-th-num">@row.RowNumber</td>
                                    <td>@SpaceNumber.Display(row.StallNo)</td>
                                    <td class="iph-c">@row.Period</td>
                                    <td class="iph-r">@Peso(row.AmountPaid)</td>
                                    <td class="iph-reason">@row.Error</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="iph-foot">
                <button class="iph-btn iph-btn-outline" type="button" @onclick="Reset">Import another file</button>
                <a class="iph-btn iph-btn-primary" href="@BackUrl">Back to @FacilityShort</a>
            </div>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <!-- ── Step 1: Upload ── -->
        <div class="iph-card">
            <label class="iph-drop">
                <InputFile OnChange="OnFileChange" accept=".csv" />
                <div class="iph-drop-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
                    </svg>
                </div>
                <div class="iph-drop-title">Choose a file to upload</div>
                <div class="iph-drop-sub">CSV — @FacilityName payments already collected</div>
            </label>

            @if (_error is not null)
            {
                <div class="iph-drop-err">@_error</div>
            }

            <div class="iph-upload-foot">
                <a class="iph-link" href="@TemplateHref" download="@($"{FacilityShort}-payment-history-template.csv")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download CSV template
                </a>
                <span class="iph-foot-sep">·</span>
                <button class="iph-link iph-link-btn iph-use-sample" type="button" @onclick="LoadSample">Use sample data instead</button>
                <span class="iph-foot-sep">·</span>
                @* For an office with no file at all - a few months read straight off the ledger. The same review
                   table, starting empty, so there is one way to check rows rather than two. *@
                <button class="iph-link iph-link-btn iph-enter-manually" type="button" @onclick="StartManual">Enter manually</button>
            </div>

            <div class="iph-cols-preview">
                <div class="iph-cols-label">COLUMNS FOR @FacilityShort</div>
                <div class="iph-cols-chips">
                    @foreach (var column in ColumnNames)
                    {
                        <span class="iph-chip">@column</span>
                    }
                </div>
            </div>

            <div class="iph-hint">
                <strong>Period</strong> is the month the payment was <em>for</em> (<code>2025-03</code>), not the month it
                was received. <strong>Amount Paid</strong> is the figure received — where it is short of that month's
                rent, the month stays outstanding for the difference. <strong>OR No.</strong> is required, since a
                payment recorded without a receipt is reported as needing one.
            </div>
        </div>
    }
    else
    {
        <!-- ── Step 2: Review & edit ── -->
        <div class="iph-review-bar">
            <div class="iph-review-left">
                <div class="iph-review-count">@_rows.Count</div>
                <div>
                    <div class="iph-review-title">rows ready to review</div>
                    <div class="iph-review-sub">@($"{_fileName} · {FacilityName}")</div>
                </div>
            </div>
            <div class="iph-review-actions">
                <button class="iph-btn iph-btn-ghost" type="button" @onclick="AddRow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add row
                </button>
                <button class="iph-btn iph-btn-outline" type="button" @onclick="Reset" disabled="@_saving">Discard</button>
            </div>
        </div>

        @if (_saveError is not null)
        {
            <div class="iph-error">@_saveError</div>
        }

        <div class="iph-card iph-card-flush">
            <div class="iph-table-wrap">
                <table class="iph-table iph-table-edit">
                    <thead>
                        <tr>
                            <th class="iph-th-num">#</th>
                            <th>Stall / Space No.</th>
                            <th>Actual Occupant</th>
                            <th>Period (YYYY-MM)</th>
                            <th>Amount Paid</th>
                            <th>OR No.</th>
                            <th>Date Paid</th>
                            <th class="iph-th-act"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _rows.Count; i++)
                        {
                            var index = i;
                            var row = _rows[index];
                            <tr>
                                <td class="iph-th-num">@(index + 1)</td>
                                @* Searched and picked, or typed. A mistyped number is the one error this screen cannot
                                   catch for itself - 3 is as valid a stall as 8, and the money lands on the wrong
                                   vendor's month without complaint - and a vendor the office does not number has no
                                   number to type at all. Choosing writes the real occupant name onto the row. *@
                                <td class="iph-td-payor">
                                    <PayorPicker Payors="_payors"
                                                 StallNo="@row.StallNo"
                                                 StallNoChanged="v => row.StallNo = v"
                                                 OccupantChanged="v => row.Occupant = v" />
                                </td>
                                <td><input class="iph-input" @bind="row.Occupant" @bind:event="oninput" placeholder="Name on the sheet" aria-label="Actual occupant" /></td>
                                <td>
                                    <input class="iph-input iph-period @(IsFuturePeriod(row.Period) ? "iph-input-bad" : null)"
                                           @bind="row.Period" @bind:event="oninput" placeholder="2025-03"
                                           aria-label="Period, year and month" />
                                </td>
                                <td><input class="iph-input iph-input-num" @bind="row.AmountPaid" @bind:event="oninput" placeholder="0.00" /></td>
                                <td><input class="iph-input" @bind="row.OrNumber" @bind:event="oninput" placeholder="OR-100234" /></td>
                                <td><input class="iph-input" type="date" @bind="row.DatePaid" /></td>
                                <td class="iph-th-act">
                                    <button class="iph-row-del" type="button" @onclick="() => RemoveRow(index)"
                                            title="Remove this row" aria-label="Remove row @(index + 1)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="iph-foot">
            <a class="iph-btn iph-btn-outline" href="@BackUrl">Cancel</a>
            <button class="iph-btn iph-btn-primary" type="button" @onclick="Save" disabled="@_saving">
                @(_saving ? "Recording…" : $"Record {_rows.Count} {(_rows.Count == 1 ? "payment" : "payments")}")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Facility { get; set; }

    /// <summary>
    /// Fetched once, before any rows exist, so the pick-list is already there whichever of the three ways the office
    /// starts. Awaiting it here rather than per-row keeps one request per visit.
    /// </summary>
    protected override async Task OnParametersSetAsync() => await LoadPayorsAsync();

    private static readonly string[] ColumnNames =
        ["Stall / Space No.", "Actual Occupant", "Period (YYYY-MM)", "Amount Paid", "OR No.", "Date Paid"];

    /// <summary>
    /// An editable row. Held as text, like the stallholder import's rows, so a clerk can correct a cell in place and
    /// a malformed figure is reported by the server rather than silently becoming zero as they type.
    /// </summary>
    private sealed class EditableRow
    {
        public string StallNo { get; set; } = string.Empty;
        public string Occupant { get; set; } = string.Empty;
        public string Period { get; set; } = string.Empty;
        public string AmountPaid { get; set; } = string.Empty;
        public string OrNumber { get; set; } = string.Empty;
        public DateTime? DatePaid { get; set; }
    }

    private readonly List<EditableRow> _rows = new();

    /// <summary>
    /// The facility's own active stalls, offered as a pick-list on every number box. A mistyped stall number is the
    /// one mistake this screen cannot detect for itself - 3 is as valid a stall as 8 - and it would credit the wrong
    /// vendor's month without complaint, so the office is given the real list to choose from.
    /// </summary>
    private List<(string StallNo, string Occupant)> _payors = new();

    private BulkImportPaymentResultDto? _result;
    private string? _error;
    private string? _saveError;
    private string _fileName = "Sample data";
    private bool _saving;

    /// <summary>
    /// Monthly-billed only, matching the server's rule. Stated here as well so the office is told before it prepares
    /// a file rather than after it uploads one.
    /// </summary>
    private static readonly FacilityCode[] SupportedFacilities =
        [FacilityCode.TCC, FacilityCode.NCC, FacilityCode.BBQ, FacilityCode.ICE];

    private FacilityCode? Code =>
        Enum.TryParse<FacilityCode>(Facility, ignoreCase: true, out var code) ? code : null;

    private bool IsSupported => Code is { } code && SupportedFacilities.Contains(code);

    private string FacilityShort => Code is { } code ? FacilityCatalog.ShortNameOf(code) : (Facility ?? "Facility");

    private string FacilityName => Code is { } code ? FacilityCatalog.NameOf(code) : (Facility ?? "this facility");

    /// <summary>
    /// Whether a row names a month that has not started yet. The server refuses these outright - a history is money
    /// already received - but the office is told while it types rather than after pressing Save, because a period is
    /// typed once and read back many times.
    /// </summary>
    private static bool IsFuturePeriod(string? period)
    {
        var (year, month) = ParsePeriod(period ?? string.Empty);
        if (year == 0 || month == 0) return false;

        var today = PhilippineTime.Today;
        return year > today.Year || (year == today.Year && month > today.Month);
    }

    /// <summary>The rows naming a month that has not started, so Save can say how many and stop.</summary>
    private int FuturePeriodCount => _rows.Count(r => IsFuturePeriod(r.Period));

    /// <summary>
    /// Loads the facility's active stalls for the pick-list. A failure is deliberately silent: the list is an aid to
    /// accuracy, not a gate, and an office with no connection to it must still be able to type a number and save.
    /// </summary>
    private async Task LoadPayorsAsync()
    {
        if (Code is not { } code) return;

        try
        {
            var res = await StallsApi.GetStallHoldersListAsync(code, null);
            if (!res.IsSuccess || res.Value is null) return;

            _payors = res.Value.Sections
                .SelectMany(s => s.Rows)
                .Where(r => !r.IsClosed && !DomainRules.TermHasExpired(r.EffectivityDate, r.DurationYears, PhilippineTime.Today))
                .Select(r => ((r.StallNo ?? string.Empty).Trim(), (r.ActualOccupant ?? string.Empty).Trim()))
                .Where(p => p.Item1.Length > 0)
                .GroupBy(p => p.Item1, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(p => SpaceNumber.IsSpace(p.Item1))
                .ThenBy(p => ParseStallInt(p.Item1))
                .ThenBy(p => p.Item1, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            // Left empty on purpose - see the summary above.
        }
    }

    /// <summary>The leading digits of a stall number, for ordering the pick-list the way the office reads it.</summary>
    private static int ParseStallInt(string value)
    {
        if (SpaceNumber.IsSpace(value)) return SpaceNumber.HighestOrdinal(new[] { value });

        var digits = new string(value.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : int.MaxValue;
    }

    // The facility's own page, by its canonical route - the one the sidebar links to and the browser shows. Cancel
    // and the back arrow both land there rather than on whatever page happened to come before.
    private string BackUrl => $"/facility/{(Facility ?? string.Empty).ToLowerInvariant()}";

    private static string Peso(decimal amount) => "₱" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private string StepClass(int step)
    {
        var current = _result is not null ? 3 : _rows.Count > 0 ? 2 : 1;
        return step == current ? "is-active" : step < current ? "is-done" : "";
    }

    /// <summary>
    /// The template, as a data URI so it needs no endpoint. Written through CsvCell so the file the office opens
    /// cannot itself be read as a formula, and so it round-trips through the same escaping the exports use.
    /// </summary>
    private string TemplateHref
    {
        get
        {
            var csv = CsvCell.Row(ColumnNames) + "\n"
                      + CsvCell.Row("1", "Joseph Villamor", "2025-03", "2400.00", "OR-100234", "2025-03-05") + "\n";
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv);
        }
    }

    /// <summary>
    /// Sample rows, the same offer the stallholder import makes.
    ///
    /// <para>Dated from the CURRENT month backwards rather than written down, for the reason the stallholder sample
    /// had to be changed: a fixed date rots, and a sample of payments for months a contract no longer covers would
    /// be rejected row by row and read as the feature being broken. One month is short of the rent so the part-paid
    /// case is visible before the office meets it in its own history.</para>
    /// </summary>
    private void LoadSample()
    {
        Reset();
        _fileName = "Sample data";

        var today = PhilippineTime.Today;
        foreach (var back in new[] { 3, 2, 1 })
        {
            var period = today.AddMonths(-back);
            _rows.Add(new EditableRow
            {
                StallNo = "1",
                Occupant = "Joseph Villamor",
                Period = $"{period.Year:0000}-{period.Month:00}",
                AmountPaid = back == 2 ? "1200.00" : "2400.00",
                OrNumber = $"OR-{100_000 + (4 - back)}",
                DatePaid = new DateTime(period.Year, period.Month, 5)
            });
        }
    }

    private void AddRow() => _rows.Add(new EditableRow());

    /// <summary>
    /// Starts the review table empty, for an office typing a few months straight off its ledger. One blank row so
    /// there is somewhere to type immediately; Add row provides the rest.
    /// </summary>
    private void StartManual()
    {
        Reset();
        _fileName = "Entered by hand";
        _rows.Add(new EditableRow());
    }

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < _rows.Count) _rows.RemoveAt(index);
    }

    /// <summary>Rows a single upload will read.</summary>
    /// <remarks>
    /// Capped HERE, not only at the server. The server's limit is checked when Save is pressed, by which time this
    /// page has already parsed the file and rendered six inputs per row - so an oversized history would take the
    /// browser down before the validator was ever consulted. The office is told to split by year instead.
    /// </remarks>
    private const int MaxRows = 5000;

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        _rows.Clear();

        var file = e.File;
        if (file is null) return;
        _fileName = file.Name;

        try
        {
            // 5 MB is generous for a text history and bounds what one upload can cost the server.
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            ParseCsv(await reader.ReadToEndAsync());

            if (_rows.Count == 0)
                _error = "No rows were found in that file. Check it has a header row and at least one payment.";
        }
        catch (IOException)
        {
            _error = "That file is larger than 5 MB. Split the history by year and upload each part.";
        }
        catch
        {
            _error = "That file could not be read. Save it as CSV and try again.";
        }
    }

    /// <summary>
    /// Reads the office's sheet into editable rows. Cells are carried across as written: a bad one is corrected in
    /// the table or reported by the server, never quietly discarded here.
    /// </summary>
    private void ParseCsv(string text)
    {
        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.TrimEnd('\r'))
            .Where(l => l.Trim().Length > 0)
            .ToList();

        if (lines.Count == 0) return;

        var start = lines[0].Contains("stall", StringComparison.OrdinalIgnoreCase)
                    || lines[0].Contains("period", StringComparison.OrdinalIgnoreCase) ? 1 : 0;

        for (var i = start; i < lines.Count; i++)
        {
            if (_rows.Count >= MaxRows)
            {
                _error = $"That file has more than {MaxRows:N0} rows. The first {MaxRows:N0} were read — " +
                         "split the history by year and upload each part.";
                break;
            }

            var cells = SplitCsvLine(lines[i]);
            string Cell(int index) => index < cells.Length ? cells[index].Trim() : string.Empty;

            _rows.Add(new EditableRow
            {
                StallNo = Cell(0),
                Occupant = Cell(1),
                Period = Cell(2),
                AmountPaid = Cell(3),
                OrNumber = Cell(4),
                DatePaid = DateTime.TryParse(Cell(5), System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var paid) ? paid : null
            });
        }
    }

    /// <summary>Reads "2025-03", "2025/3" or "03/2025". Zero lets the server report the row rather than guessing.</summary>
    private static (int Year, int Month) ParsePeriod(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (0, 0);

        var parts = value.Split(['-', '/', ' '], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2) return (0, 0);
        if (!int.TryParse(parts[0], out var first) || !int.TryParse(parts[1], out var second)) return (0, 0);

        // A part larger than a day-of-month is the year, whichever side it is written on.
        return first > 31 ? (first, second) : (second, first);
    }

    // Honours double-quoted fields, which may contain commas and "" escapes (RFC 4180).
    private static string[] SplitCsvLine(string line)
    {
        var cells = new List<string>();
        var sb = new System.Text.StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') { sb.Append('"'); i++; }
                else inQuotes = !inQuotes;
            }
            else if (ch == ',' && !inQuotes) { cells.Add(sb.ToString()); sb.Clear(); }
            else sb.Append(ch);
        }

        cells.Add(sb.ToString());
        return cells.ToArray();
    }

    private async Task Save()
    {
        if (Code is not { } code || _rows.Count == 0) return;

        // Stopped here as well as at the server. A month that has not started cannot have been collected, and the
        // office is better told which rows before the request than shown a list of rejections after it.
        if (FuturePeriodCount is var future && future > 0)
        {
            var today = PhilippineTime.Today;
            _saveError = $"{future} {(future == 1 ? "row names a month" : "rows name months")} that " +
                         $"{(future == 1 ? "has" : "have")} not started yet. A payment history can only cover " +
                         $"months up to {today.Year:0000}-{today.Month:00}.";
            return;
        }

        _saving = true;
        _saveError = null;
        try
        {
            var rows = new List<ImportPaymentRow>(_rows.Count);
            for (var i = 0; i < _rows.Count; i++)
            {
                var row = _rows[i];
                var (year, month) = ParsePeriod(row.Period);

                rows.Add(new ImportPaymentRow(
                    RowNumber: i + 1,
                    StallNo: row.StallNo,
                    Occupant: row.Occupant,
                    BillingYear: year,
                    BillingMonth: month,
                    // Through the same reader the stallholder import uses, so "1.500,00" and "1,500.00" are both
                    // fifteen hundred rather than one of them being read as one peso fifty.
                    AmountPaid: SheetNumber.ToDecimal(row.AmountPaid) ?? 0m,
                    OrNumber: row.OrNumber,
                    DatePaid: row.DatePaid));
            }

            var result = await PaymentsApi.ImportPaymentHistoryAsync(
                new BulkImportPaymentHistoryCommand(code, null, rows));

            if (result.IsSuccess && result.Value is not null)
            {
                _result = result.Value;
                _rows.Clear();
            }
            else
            {
                // Nothing was written: the batch is one transaction, so the ledger is exactly as it was.
                _saveError = result.Error ?? "The history could not be recorded. Nothing was saved.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void Reset()
    {
        _rows.Clear();
        _result = null;
        _error = null;
        _saveError = null;
        _fileName = "Sample data";
    }
}
