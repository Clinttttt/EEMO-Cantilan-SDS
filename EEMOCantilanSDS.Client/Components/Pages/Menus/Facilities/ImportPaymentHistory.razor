    /// <summary>
    /// An editable row. Held as text, like the stallholder import's rows, so a clerk can correct a cell in place and
    /// a malformed figure is reported by the server rather than silently becoming zero as they type.
    /// </summary>
    private sealed class EditableRow
    {
        public string StallNo { get; set; } = string.Empty;
        public string Occupant { get; set; } = string.Empty;
        public string Period { get; set; } = string.Empty;
        public string AmountPaid { get; set; } = string.Empty;

        /// <summary>
        /// How many market days were paid for, on a daily-billed facility. Held as text like every other cell so a
        /// mistyped figure is reported rather than silently becoming zero as the clerk types.
        /// </summary>
        /// <summary>
        /// How many market days were paid for, on a daily-billed facility. Held as text like every other cell so a
        /// mistyped figure is reported rather than silently becoming zero as the clerk types.
        /// </summary>
        public string DaysPaid { get; set; } = string.Empty;

        /// <summary>
        /// One market day the office has stated: the date, and the receipt it was collected under if that day carries
        /// its own. Left blank, the row's receipt applies.
        /// </summary>
        public sealed class DayEntry
        {
            public DateTime? Date { get; set; }
            public string OrNumber { get; set; } = string.Empty;
        }

        /// <summary>
        /// The exact days, when the office chooses to state them. One entry per day claimed.
        ///
        /// <para>Kept per row rather than per screen because a sheet is rarely uniform: the office may know the days
        /// for one vendor's month and only the count for another's, and the import honours each row as it stands.</para>
        /// </summary>
        public List<DayEntry> Days { get; } = new();

        /// <summary>
        /// What the screen has to say about this row's days: that the month is settled, or that fewer days are
        /// uncollected than the row claims. Held per row because it is about that row's payor and month.
        /// </summary>
        public string? DaysNote { get; set; }

        /// <summary>
        /// Every day of this row's month the payor owes, collected or not, as the server states them.
        ///
        /// <para>Held so a line can be labelled by the payor's OWN market day: a space let on the 9th has the 9th as
        /// its first, so the 11th is its third. Numbering the lines 1, 2, 3 described this form rather than the vendor,
        /// and the office reconciles against the vendor.</para>
        /// </summary>
        public List<DateOnly> Chargeable { get; } = new();

        /// <summary>
        /// The payor's UNCOLLECTED days for this month, as the server last stated them.
        ///
        /// <para>Kept so that claiming another day dates it at once, from what the server has already said, instead of
        /// leaving a blank box until somebody presses a button. Growing the count is not new information about the
        /// month - it is the same month, one more line - so it needs no second question.</para>
        /// </summary>
        public List<DateOnly> Available { get; } = new();

        /// <summary>
        /// The payor and month these dates were fetched for, so a keystroke that changes neither does not clear them or
        /// ask the server again.
        ///
        /// <para>The PAYOR is part of the key, not just the month. Which days a vendor owes depends on the vendor, so
        /// dates fetched for one and left standing on a row that now names another are simply wrong - and the import
        /// would refuse them, one row at a time, for days that payor does not owe.</para>
        /// </summary>
        public (Guid? Stall, int Year, int Month) DatesFetchedFor { get; set; }

        /// <summary>How many of this month's days the payor has already been collected for, as last stated.</summary>
        public int AlreadyCollected { get; set; }

        /// <summary>True when the month's days could not be read, so the office is told to enter them by hand.</summary>
        public bool DaysUnreadable { get; set; }
        public string OrNumber { get; set; } = string.Empty;
        public DateTime? DatePaid { get; set; }
    }

