    private async Task LoadDailySetupAsync()
    {
        if (!IsDaily) return;

        try
        {
            var rates = await StallsApi.GetNpmRatesAsync();
            if (rates.IsSuccess && rates.Value is not null)
            {
                _dailyRate = rates.Value.DailyRate;
                _fishRate = rates.Value.FishRate;
