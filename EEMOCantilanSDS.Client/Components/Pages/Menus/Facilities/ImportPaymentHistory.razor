@page "/import-history/{Facility}"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Command.Payments.BulkImportPaymentHistory
@using EEMOCantilanSDS.Application.Command.Payments.BulkImportDailyHistory
@using EEMOCantilanSDS.Application.Dtos.Payments
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IPaymentsApiClient PaymentsApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject IStallsApiClient StallsApi
@inject IFacilitiesApiClient FacilitiesApi

@*
    Records an office's existing payment history, so it can adopt the system mid-contract.

    Importing the HISTORY rather than an opening balance keeps arrears derived: the system goes on working out
    what is owed from the term and the payments against it, so every peso traces to a receipt.

    Structured to match Import Stallholders step for step - upload, review and edit, save - because the office
    meets both screens in the same sitting and a second layout for the same task is a second thing to learn.
*@

<PageTitle>StallTrack — Import @FacilityName payment history</PageTitle>

<header class="topbar">
    <div class="topbar-left flex gap-2">
        <a href="@BackUrl" class="iph-back-btn" title="Back to @FacilityName" aria-label="Back to @FacilityName">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="topbar-title">Import Payment History</div>
            <div class="topbar-breadcrumb">
                <a href="/menu" class="breadcrumb-link">Dashboard</a>
                <span class="breadcrumb-sep">/</span>
                <a href="@BackUrl" class="breadcrumb-link">@FacilityShort</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-active">Import history</span>
            </div>
        </div>
    </div>
</header>

<div class="iph-page">
    <div class="iph-hero">
        <div class="iph-hero-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18" /><path d="M7 14l4-4 3 3 5-6" />
            </svg>
        </div>
        <div class="iph-hero-body">
            <div class="iph-hero-eyebrow">@FacilityShort · @(IsDaily ? "COLLECTION HISTORY" : "PAYMENT HISTORY")</div>
            <h1 class="iph-hero-title">Import @FacilityName @(IsDaily ? "Collection History" : "Payment History")</h1>
            <p class="iph-hero-sub">
                @(IsDaily
                    ? "Upload market days already collected, review & edit, then save."
                    : "Upload past payments, review & edit, then save.")
                @if (IsDaily && SectionChosen)
                {
                    <span class="iph-hero-section">@ChosenSectionLabel</span>
                }
            </p>
        </div>
        <div class="iph-steps">
            <div class="iph-step @(StepClass(1))"><span class="iph-step-no">1</span> Upload</div>
            <div class="iph-step-line"></div>
            <div class="iph-step @(StepClass(2))"><span class="iph-step-no">2</span> Review &amp; edit</div>
            <div class="iph-step-line"></div>
            <div class="iph-step @(StepClass(3))"><span class="iph-step-no">3</span> Save</div>
        </div>
    </div>

    @if (!IsSupported)
    {
        <div class="iph-card">
            <div class="iph-note">
                A history is imported for the facilities that bill by the month and for the market, which bills by the
                market day. <strong>@FacilityName</strong> is charged per unit collected — per head, per trip — so
                there is no period to import a history for.
            </div>
            <div class="iph-foot">
                <a class="iph-btn iph-btn-outline" href="@BackUrl">Back to @FacilityShort</a>
            </div>
        </div>
    }
    else if (IsDaily && !SectionChosen)
    {
        @* The same chooser the stallholder import uses, because it is the same question asked of the same office in
           the same sitting. The market numbers its spaces PER SECTION - three of them are called "1" - so a list
           without a section could be written against the wrong vendor's space, and it is asked before a file is read
           rather than after. *@
        <div class="iph-pick">
            <div class="iph-pick-head">
                <div class="iph-pick-title">Which section are you importing?</div>
                <div class="iph-pick-sub">
                    @FacilityName keeps a separate list per section. Pick one — every row you import will be recorded
                    into it.
                </div>
            </div>
            <div class="iph-pick-grid">
                @foreach (var option in DailySectionOptions)
                {
                    var chosen = option;
                    <button type="button" class="iph-pick-card" @onclick="() => ChooseSection(chosen.Section)">
                        <span class="iph-pick-icon @chosen.Css">@((MarkupString)chosen.Icon)</span>
                        <span class="iph-pick-name">@SectionLabel(chosen.Section)</span>
                        <span class="iph-pick-desc">@SectionDesc(chosen)</span>
                    </button>
                }
                @* Per-LGU custom sections, offered as import targets alongside the canonical three. Their rate is the
                   tenant's own resolved daily fee, never a figure written into this page. *@
                @foreach (var custom in _customSections)
                {
                    var name = custom;
                    <button type="button" class="iph-pick-card" @onclick="() => ChooseCustomSection(name)">
                        <span class="iph-pick-icon">@((MarkupString)CustomSectionIconSvg)</span>
                        <span class="iph-pick-name">@name</span>
                        <span class="iph-pick-desc">Custom section · ₱@(_dailyRate.ToString("0"))/day</span>
                    </button>
                }
            </div>
        </div>
    }
    else if (_dailyResult is not null)
    {
        <!-- ── Step 3: Saved (market) ── -->
        <div class="iph-card">
            <div class="iph-summary">
                <div class="iph-stat"><div class="iph-stat-val">@_dailyResult.RecordedCount</div><div class="iph-stat-key">Recorded in full</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_dailyResult.PartialCount</div><div class="iph-stat-key">Recorded in part</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_dailyResult.AlreadyRecordedCount</div><div class="iph-stat-key">Nothing left to settle</div></div>
                <div class="iph-stat @(_dailyResult.RejectedCount > 0 ? "iph-stat-attention" : "")"><div class="iph-stat-val">@_dailyResult.RejectedCount</div><div class="iph-stat-key">Not recorded</div></div>
            </div>

            <div class="iph-note">
                @_dailyResult.TotalDaysSettled market @(_dailyResult.TotalDaysSettled == 1 ? "day" : "days")
                recorded, ₱@_dailyResult.TotalRecorded.ToString("N2") in total. The amount is the facility's own daily
                fee for each day settled.
            </div>

            <div class="iph-result-wrap">
                <table class="iph-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@StallColumnLabel</th>
                            <th>Period</th>
                            <th class="iph-c">Days claimed</th>
                            <th class="iph-c">Days settled</th>
                            <th class="iph-c">Amount</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _dailyResult.Results)
                        {
                            <tr class="@(row.Outcome == ImportDailyOutcome.Rejected ? "iph-row-bad" : null)">
                                <td>@row.RowNumber</td>
                                <td>@SpaceNumber.Display(row.StallNo)</td>
                                <td>@row.Period</td>
                                <td class="iph-c">@row.DaysClaimed</td>
                                <td class="iph-c">@row.DaysSettled</td>
                                <td class="iph-c">@Peso(row.AmountRecorded)</td>
                                <td>@(row.Error ?? DailyOutcomeLabel(row.Outcome))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="iph-foot">
                <a class="iph-btn iph-btn-primary" href="@BackUrl">Back to @FacilityShort</a>
            </div>
        </div>
    }
    else if (_result is not null)
    {
        <!-- ── Step 3: Saved ── -->
        <div class="iph-card">
            <div class="iph-summary">
                <div class="iph-stat"><div class="iph-stat-val">@_result.RecordedCount</div><div class="iph-stat-key">Paid in full</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_result.PartialCount</div><div class="iph-stat-key">Part paid</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@_result.AlreadyRecordedCount</div><div class="iph-stat-key">Already on record</div></div>
                <div class="iph-stat @(_result.RejectedCount > 0 ? "iph-stat-attention" : "")"><div class="iph-stat-val">@_result.RejectedCount</div><div class="iph-stat-key">Not recorded</div></div>
                <div class="iph-stat"><div class="iph-stat-val">@Peso(_result.TotalRecorded)</div><div class="iph-stat-key">Total recorded</div></div>
            </div>

            @if (_result.RejectedCount > 0 || _result.AlreadyRecordedCount > 0)
            {
                <div class="iph-note">
                    Correct these rows on your sheet and upload again. Re-uploading the whole file is safe — a month
                    already recorded is reported, not written twice.
                </div>

                <div class="iph-table-wrap">
                    <table class="iph-table">
                        <thead>
                            <tr>
                                <th class="iph-th-num">#</th>
                                <th>@StallColumnLabel</th>
                                <th>Period</th>
                                <th class="iph-c">Amount</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _result.Results.Where(r => r.Outcome is ImportPaymentOutcome.Rejected or ImportPaymentOutcome.AlreadyRecorded))
                            {
                                <tr>
                                    <td class="iph-th-num">@row.RowNumber</td>
                                    <td>@SpaceNumber.Display(row.StallNo)</td>
                                    <td class="iph-c">@row.Period</td>
                                    <td class="iph-c">@Peso(row.AmountPaid)</td>
                                    <td class="iph-reason">@row.Error</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="iph-foot">
                <button class="iph-btn iph-btn-outline" type="button" @onclick="Reset">Import another file</button>
                <a class="iph-btn iph-btn-primary" href="@BackUrl">Back to @FacilityShort</a>
            </div>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <!-- ── Step 1: Upload ── -->
        <div class="iph-card">
            <label class="iph-drop">
                <InputFile OnChange="OnFileChange" accept=".csv" />
                <div class="iph-drop-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
                    </svg>
                </div>
                <div class="iph-drop-title">Choose a file to upload</div>
                <div class="iph-drop-sub">CSV — @FacilityName payments already collected</div>
            </label>

            @if (_error is not null)
            {
                <div class="iph-drop-err">@_error</div>
            }

            <div class="iph-upload-foot">
                <a class="iph-link" href="@TemplateHref" download="@($"{FacilityShort}-payment-history-template.csv")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download CSV template
                </a>
                <span class="iph-foot-sep">·</span>
                <button class="iph-link iph-link-btn iph-use-sample" type="button" @onclick="LoadSample">Use sample data instead</button>
                <span class="iph-foot-sep">·</span>
                @* For an office with no file at all - a few months read straight off the ledger. The same review
                   table, starting empty, so there is one way to check rows rather than two. *@
                <button class="iph-link iph-link-btn iph-enter-manually" type="button" @onclick="StartManual">Enter manually</button>
            </div>

            <div class="iph-cols-preview">
                <div class="iph-cols-label">COLUMNS FOR @FacilityShort</div>
                <div class="iph-cols-chips">
                    @foreach (var column in Columns)
                    {
                        <span class="iph-chip">@column</span>
                    }
                </div>
            </div>

            <div class="iph-hint">
                <strong>Period</strong> is the month the payment was <em>for</em> (<code>2025-03</code>), not the month it
                was received. <strong>Amount Paid</strong> is the figure received — where it is short of that month's
                rent, the month stays outstanding for the difference. <strong>OR No.</strong> is required, since a
                payment recorded without a receipt is reported as needing one.
            </div>
        </div>
    }
    else
    {
        <!-- ── Step 2: Review & edit ── -->
        <div class="iph-review-bar">
            <div class="iph-review-left">
                <div class="iph-review-count">@_rows.Count</div>
                <div>
                    <div class="iph-review-title">rows ready to review</div>
                    <div class="iph-review-sub">@($"{_fileName} · {FacilityName}")</div>
                </div>
            </div>
            <div class="iph-review-actions">
                @if (IsDaily)
                {
                    @* The office's sheet may name the actual days rather than only how many. Off by default, because
                       most sheets record a count, and a column of dates nobody fills in is a column of mistakes
                       waiting to happen. *@
                    <button class="iph-btn iph-btn-ghost iph-dates-toggle @(_showDates ? "iph-btn-on" : null)"
                            type="button" @onclick="ToggleDates">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        @(_showDates ? "Hide exact dates" : "Set exact dates")
                    </button>
                }
                <button class="iph-btn iph-btn-ghost" type="button" @onclick="AddRow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add row
                </button>
                <button class="iph-btn iph-btn-outline" type="button" @onclick="Reset" disabled="@_saving">Discard</button>
            </div>
        </div>

        @if (_saveError is not null)
        {
            <div class="iph-error">@_saveError</div>
        }

        <div class="iph-card iph-card-flush">
            <div class="iph-table-wrap">
                <table class="iph-table iph-table-edit">
                    <thead>
                        <tr>
                            <th class="iph-th-num">#</th>
                            <th>@StallColumnLabel</th>
                            <th>Actual Occupant</th>
                            <th>Period (YYYY-MM)</th>
                            @if (IsDaily)
                            {
                                <th>Days Paid</th>
                                <th>OR No.</th>
                            }
                            else
                            {
                                <th>Amount Paid</th>
                                <th>OR No.</th>
                                <th>Date Paid</th>
                            }
                            <th class="iph-th-act"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _rows.Count; i++)
                        {
                            var index = i;
                            var row = _rows[index];
                            <tr>
                                <td class="iph-th-num">@(index + 1)</td>
                                @* Searched and picked, or typed. A mistyped number is the one error this screen cannot
                                   catch for itself - 3 is as valid a stall as 8, and the money lands on the wrong
                                   vendor's month without complaint - and a vendor the office does not number has no
                                   number to type at all. Choosing writes the real occupant name onto the row. *@
                                <td class="iph-td-payor">
                                    <PayorPicker Payors="_payors"
                                                 StallNo="@row.StallNo"
                                                 SpaceOnly="IsSpaceOnly"
                                                 StallNoChanged="v => OnPayorChanged(row, v)"
                                                 OccupantChanged="v => row.Occupant = v" />
                                </td>
                                @* Capped in the markup as well as checked on save. A cell with no limit accepted a
                                   paste of a hundred characters of nonsense, which then stood in every day line
                                   beneath it and pushed the table sideways. *@
                                <td><input class="iph-input" @bind="row.Occupant" @bind:event="oninput" maxlength="@MaxOccupant" placeholder="Name on the sheet" aria-label="Actual occupant" /></td>
                                <td>
                                    @* The dash is put in as the office types, so a period is six keystrokes rather than
                                       seven and cannot be written in a shape the import will not read. inputmode
                                       numeric brings up the number pad on a phone. *@
                                    <input class="iph-input iph-period @(PeriodIsBad(row.Period) ? "iph-input-bad" : null)"
                                           @bind="row.Period" @bind:event="oninput" @bind:after="() => OnPeriodChanged(row)"
                                           @onblur="() => PadPeriodMonth(row)" maxlength="7" inputmode="numeric"
                                           placeholder="2025-03" aria-label="Period, year and month" />
                                </td>
                                @if (IsDaily)
                                {
                                    @* Days, not an amount. The market's books record a count of days against a
                                       receipt; the money follows from the facility's own daily fee for the days
                                       settled, which is why there is nothing here for the office to total. *@
                                    <td><input class="iph-input iph-input-num iph-days @(DaysIsBad(row.DaysPaid) ? "iph-input-bad" : null)" @bind="row.DaysPaid" @bind:event="oninput" @bind:after="() => OnDaysChanged(row)" maxlength="2" inputmode="numeric" placeholder="12" aria-label="Days paid" /></td>
                                    @* Optional once the days carry their own receipts, which is how the market is
                                       actually collected. The placeholder says so rather than implying a figure the
                                       office's sheet may not keep. *@
                                    <td><input class="iph-input" @bind="row.OrNumber" @bind:event="oninput" maxlength="@MaxOr" placeholder="@(_showDates ? "Per day below" : "OR-100234")" aria-label="OR number" /></td>
                                }
                                else
                                {
                                    <td><input class="iph-input iph-input-num" @bind="row.AmountPaid" @bind:event="oninput" placeholder="0.00" aria-label="Amount paid" /></td>
                                    <td><input class="iph-input" @bind="row.OrNumber" @bind:event="oninput" maxlength="@MaxOr" placeholder="OR-100234" aria-label="OR number" /></td>
                                    <td><input class="iph-input" type="date" @bind="row.DatePaid" aria-label="Date paid" /></td>
                                }
                                <td class="iph-th-act">
                                    <button class="iph-row-del" type="button" @onclick="() => RemoveRow(index)"
                                            title="Remove this row" aria-label="Remove row @(index + 1)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                    </button>
                                </td>
                            </tr>

                            @if (IsDaily && _showDates)
                            {
                                @* The days are ROWS OF THIS TABLE, not a table inside it.
                                   
                                   A nested table cannot line up with the one around it: its columns are measured
                                   against its own contents, so it ended up narrower than the row it belonged to with a
                                   band of empty space down the right. As rows here, each day sits under the very
                                   headings that describe it - the occupant under Actual Occupant, the receipt under
                                   OR No. - and the width matches because it is the same table.
                                   
                                   What is sent is what stands here: the import honours these days exactly and fills
                                   nothing in around them, so a day left undated is one day fewer recorded rather than
                                   a day of the system's choosing. *@
                                @if (row.Days.Count == 0)
                                {
                                    <tr class="iph-day-row">
                                        <td class="iph-th-num"></td>
                                        <td colspan="6" class="iph-dates-empty">
                                            Enter the number of days first, and a line will appear for each one.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="iph-day-row iph-day-caption">
                                        <td class="iph-th-num"></td>
                                        <td colspan="4">
                                            <span class="iph-dates-title">Days collected</span>
                                            <span class="iph-dates-sub">
                                                @row.Days.Count(d => d.Date.HasValue) of @row.Days.Count dated
                                            </span>
                                            @* What the payor's own record says about this month, stated where the days
                                               are rather than left as empty boxes to be puzzled over. *@
                                            @if (!string.IsNullOrWhiteSpace(row.DaysNote))
                                            {
                                                <span class="iph-days-note">@row.DaysNote</span>
                                            }
                                        </td>
                                        <td colspan="2" class="iph-day-caption-act">
                                            <button class="iph-link iph-link-btn iph-dates-fill" type="button"
                                                    @onclick="() => FillDaysAsync(row)">Fill the blanks</button>
                                        </td>
                                    </tr>

                                    @for (var d = 0; d < row.Days.Count; d++)
                                    {
                                        var slot = d;
                                        var day = row.Days[slot];
                                        <tr class="iph-day-row">
                                            <td class="iph-th-num"></td>
                                            @* The day's own identity, where the row above states the stall's. *@
                                            <td class="iph-days-read iph-day-label">@DayLabel(row, slot)</td>
                                            @* Stated, not offered for editing: these belong to the row above, and a
                                               second editable copy of a value is a second version of it. *@
                                            <td class="iph-days-read">
                                                @(string.IsNullOrWhiteSpace(row.Occupant) ? "—" : row.Occupant)
                                            </td>
                                            <td class="iph-days-read">
                                                @(string.IsNullOrWhiteSpace(row.Period) ? "—" : row.Period)
                                            </td>
                                            @* Under Days Paid, because that is what this cell says: WHICH day, where
                                               the row above says how many. *@
                                            <td>
                                                <input class="iph-input iph-date-slot" type="date"
                                                       value="@day.Date?.ToString("yyyy-MM-dd")"
                                                       @onchange="e => SetDayDate(row, slot, e.Value?.ToString())"
                                                       aria-label="Date of day @(slot + 1)" />
                                            </td>
                                            @* And its receipt, directly under the row's own. *@
                                            <td>
                                                <input class="iph-input iph-day-or" @bind="day.OrNumber"
                                                       @bind:event="oninput"
                                                       placeholder="@(string.IsNullOrWhiteSpace(row.OrNumber) ? "OR-100234" : row.OrNumber)"
                                                       aria-label="OR number for day @(slot + 1)" />
                                            </td>
                                            <td class="iph-th-act"></td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="iph-foot">
            <a class="iph-btn iph-btn-outline" href="@BackUrl">Cancel</a>
            <button class="iph-btn iph-btn-primary" type="button" @onclick="Save" disabled="@_saving">
                @(_saving ? "Recording…" : $"Record {_rows.Count} {(_rows.Count == 1 ? "payment" : "payments")}")
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Facility { get; set; }

    /// <summary>
    /// Fetched once, before any rows exist, so the pick-list is already there whichever of the three ways the office
    /// starts. Awaiting it here rather than per-row keeps one request per visit.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadDailySetupAsync();
        await LoadPayorsAsync();
    }

    private static readonly string[] ColumnNames =
        ["Stall / Space No.", "Actual Occupant", "Period (YYYY-MM)", "Amount Paid", "OR No.", "Date Paid"];

    /// <summary>
    /// The market's columns. Days rather than an amount, and no date paid: the days ARE the dates, and the amount is
    /// the facility's own daily fee for each of them rather than a figure the office types.
    /// </summary>
    private static readonly string[] DailyColumnNames =
        ["Stall / Space No.", "Actual Occupant", "Period (YYYY-MM)", "Days Paid", "OR No."];

    /// <summary>
    /// The facilities let ONLY as spaces the office does not number - a barbecue stand, an ice-plant space. Their sheets
