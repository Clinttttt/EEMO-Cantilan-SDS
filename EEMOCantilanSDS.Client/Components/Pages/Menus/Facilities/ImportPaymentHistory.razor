    /// <summary>
    /// Caps on what a cell will accept.
    ///
    /// <para>A cell with no limit took a paste of a hundred characters of nonsense, which then stood in every day line
    /// beneath it and pushed the table sideways. Long enough for any real name or receipt the office writes; short
    /// enough that a mis-paste is obvious rather than structural.</para>
    /// </summary>
    private const int MaxOccupant = 120;
    private const int MaxOr = 40;

    /// <summary>
    /// Whether a period cannot be read as a month, or names one that has not started.
    ///
    /// <para>Both are marked the same way because both mean the same thing to the office: this row cannot be recorded
    /// as it stands. A period being typed is not yet wrong — "2026-1" is on its way to "2026-10" — so a value shorter
    /// than a full month is left alone.</para>
    /// </summary>
    private static bool PeriodIsBad(string? period)
    {
        var text = (period ?? string.Empty).Trim();
        if (text.Length < 6) return false;

        var (year, month) = ParsePeriod(text);
        if (year == 0 || month == 0) return true;

        return IsFuturePeriod(text);
    }

    /// <summary>Whether a day count is present but could not be a month's worth of days.</summary>
    private static bool DaysIsBad(string? days)
    {
        var text = (days ?? string.Empty).Trim();
        if (text.Length == 0) return false;

        return !int.TryParse(text, out var n) || n < 1 || n > 31;
    }

    /// <summary>
    /// Puts the dash in as the office types, so a period is six keystrokes rather than seven and cannot be written in
    /// a shape the import will not read.
    ///
    /// <para>Digits only, year then month: "20264" becomes "2026-4", and a sixth digit completes it. The month is
    /// padded on the way out — "2026-4" is stored as 2026-04 — because a clerk types 4 and means April, and asking
    /// them to type the nought is asking them to do the computer's work.</para>
    /// </summary>
    private static void NormalisePeriod(EditableRow row)
    {
        var digits = new string((row.Period ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length > 6) digits = digits[..6];

        row.Period = digits.Length switch
        {
            <= 4 => digits,
            5 => $"{digits[..4]}-{digits[4]}",
            _ => $"{digits[..4]}-{digits[4..6]}"
        };
    }

    /// <summary>Pads a single-digit month once the office leaves the field: 2026-4 is April, and reads better as 04.</summary>
    private static void PadPeriodMonth(EditableRow row)
    {
        var (year, month) = ParsePeriod(row.Period ?? string.Empty);
        if (year == 0 || month == 0) return;

        row.Period = $"{year:0000}-{month:00}";
    }

    /// <summary>
    /// Re-dates a row's days when its period changes to a DIFFERENT month.
    ///
    /// <para>Guarded on the month actually changing. Bound to oninput, this ran on every keystroke: typing 2-0-2-6-0-8
    /// asked the server six times and cleared the dates six times, so a date the office had entered by hand was wiped
    /// while they typed the month beside it. Now the fetch happens once, when the month is readable and new.</para>
    /// </summary>
    private async Task OnPeriodChanged(EditableRow row)
    {
        NormalisePeriod(row);
        await EnsureDatesAsync(row);
    }

    /// <summary>
    /// Dates whatever is undated on a row, asking the server only when the answer could have changed.
    ///
    /// <para>This is the one way in. Every path that can alter what a row's days should be - its period, its payor, how
    /// many days it claims - comes through here, because each of them used to need the office to press something
    /// afterwards. Claiming another day left a blank box; choosing the payor after typing the days left the row saying
    /// "choose the payor first" with nothing filled in when they had just done so. The only cures were the "Fill the
    /// blanks" link or closing and reopening the exact-dates grid, which is a refresh dressed up as a choice.</para>
    ///
    /// <para>The guard is the same lesson the period box already carried: bound to oninput this runs on every keystroke,
    /// so typing 2-0-2-6-0-8 must not ask the server six times or clear a date the office entered by hand. The fetch
    /// happens when the PAYOR or the MONTH is new; anything else is dated from what the server has already said.</para>
    ///
    /// <para>A row with no payor or no readable period is left alone rather than guessed at: which days a vendor owes
    /// depends on the vendor, and offering the month's first days as though they were owed is how this went wrong
    /// before.</para>
    /// </summary>
    private async Task EnsureDatesAsync(EditableRow row)
    {
        if (!_showDates) return;

        var (year, month) = ParsePeriod(row.Period ?? string.Empty);
        if (year == 0 || month == 0) return;                    // half-typed: nothing to fetch for yet

        var stall = StallIdFor(row.StallNo);
        var key = (stall, year, month);

        if (row.DatesFetchedFor != key)
        {
            // A different payor or a different month, so the dates on screen belong to neither. They are cleared rather
            // than carried across - the import would refuse them by name, for days this payor does not owe or days that
            // do not fall in this month.
            foreach (var day in row.Days) day.Date = null;

            await FetchDaysAsync(row, stall, year, month);
            row.DatesFetchedFor = key;
        }

        FillFromAvailable(row);
        Explain(row);
    }

    /// <summary>
    /// Dates the undated lines from the days already fetched, earliest first, skipping any day the row already states.
    ///
    /// <para>No server call: claiming one more day is the same month asked about twice.</para>
    /// </summary>
    private static void FillFromAvailable(EditableRow row)
    {
        var taken = row.Days.Where(d => d.Date.HasValue)
                            .Select(d => DateOnly.FromDateTime(d.Date!.Value))
                            .ToHashSet();

        var queue = row.Available.Where(d => !taken.Contains(d)).ToList();

        var next = 0;
        foreach (var day in row.Days)
        {
            if (day.Date.HasValue) continue;
            if (next >= queue.Count) break;

            day.Date = queue[next].ToDateTime(TimeOnly.MinValue);
            next++;
        }
    }
    /// <summary>
    /// Whether a row names a month that has not started yet.
    /// </summary>
    private static bool IsFuturePeriod(string? period)
    {
        var (year, month) = ParsePeriod(period ?? string.Empty);
        if (year == 0 || month == 0) return false;

        var today = PhilippineTime.Today;
        return year > today.Year || (year == today.Year && month > today.Month);
    }

    /// <summary>The rows naming a month that has not started, so Save can say how many and stop.</summary>
    private int FuturePeriodCount => _rows.Count(r => IsFuturePeriod(r.Period));

    /// <summary>
    /// What is wrong with the batch, in the office's own terms, or empty when nothing is.
    ///
    /// <para>Counted rather than listed row by row: a sheet of fifty rows with the same fault in twelve of them is one
    /// correction to make, and twelve messages would bury it. Every check here is one the server applies too - this
    /// exists so the office hears it before the request rather than after.</para>
    /// </summary>
    private string RowsNeedingAttention()
    {
        var today = PhilippineTime.Today;

        var future = _rows.Count(r => IsFuturePeriod(r.Period));
        if (future > 0)
        {
            return $"{future} {(future == 1 ? "row names a month" : "rows name months")} that " +
                   $"{(future == 1 ? "has" : "have")} not started yet. A history can only cover months up to " +
                   $"{today.Year:0000}-{today.Month:00}.";
        }

        var unreadable = _rows.Count(r =>
        {
            var (y, m) = ParsePeriod(r.Period);
            return y == 0 || m == 0;
        });
        if (unreadable > 0)
        {
            return $"{unreadable} {(unreadable == 1 ? "row does" : "rows do")} not name a month that can be read. " +
                   "Write the period as a year and month, like 2025-03.";
        }

        var noPayor = _rows.Count(r => string.IsNullOrWhiteSpace(r.StallNo));
        if (noPayor > 0)
        {
            return $"{noPayor} {(noPayor == 1 ? "row has" : "rows have")} no payor. Choose the vendor each row is for, " +
                   "or remove the row.";
        }

        if (IsDaily)
        {
            var badDays = _rows.Count(r => DaysIsBad(r.DaysPaid) || string.IsNullOrWhiteSpace(r.DaysPaid));
            if (badDays > 0)
            {
                return $"{badDays} {(badDays == 1 ? "row does" : "rows do")} not state how many market days were " +
                       "paid for. A month holds between 1 and 31.";
            }

            // Checked BEFORE the receipt, because an undated day line is the fault the office actually has. It used to
            // fall through to the server, which saw a row with no dates at all, required a receipt for the month it
            // would have filled in, and reported "an OR number is required" at an office that had written a receipt
            // against every line. The complaint named the wrong field.
            if (_showDates)
            {
                var undated = _rows.Count(r => r.Days.Any(d => !d.Date.HasValue));
                if (undated > 0)
                {
                    return $"{undated} {(undated == 1 ? "row has a day" : "rows have days")} with no date. Give each " +
                           "day its date, or reduce the days paid to the ones you can date.";
                }
            }

            // A receipt is needed for every day recorded, and it may be written against the day OR against the month.
            // The market issues a receipt per collection, so a sheet often carries one per day and none for the month -
            // which the import used to reject outright, losing every receipt on the row.
            var noReceipt = _rows.Count(r =>
                string.IsNullOrWhiteSpace(r.OrNumber)
                && (!_showDates || r.Days.Any(d => d.Date.HasValue && string.IsNullOrWhiteSpace(d.OrNumber))));

            if (noReceipt > 0)
            {
                return $"{noReceipt} {(noReceipt == 1 ? "row has a day" : "rows have days")} with no OR number. Write " +
                       "the receipt against each day, or one for the whole month.";
            }
        }
        else
        {
            var noReceipt = _rows.Count(r => string.IsNullOrWhiteSpace(r.OrNumber));
            if (noReceipt > 0)
            {
                return $"{noReceipt} {(noReceipt == 1 ? "row has" : "rows have")} no OR number. A payment without one " +
                       "is reported as missing a receipt.";
            }
        }

        return string.Empty;
    }

    /// <summary>
    /// Loads the facility's active stalls for the pick-list. A failure is deliberately silent: the list is an aid to
    /// accuracy, not a gate, and an office with no connection to it must still be able to type a number and save.
    /// </summary>
    private async Task LoadPayorsAsync()
    {
        if (Code is not { } code) return;

        try
        {
            // Scoped to the chosen section for the market. Its spaces are numbered per section - three of them are
            // called "1" - so an unscoped list would offer three identical numbers and the office could not tell which
            // vendor it had picked.
            var res = await StallsApi.GetStallHoldersListAsync(code, _section);
            if (!res.IsSuccess || res.Value is null) return;

            _payors = res.Value.Sections
                .SelectMany(s => s.Rows)
                .Where(r => !r.IsClosed && !DomainRules.TermHasExpired(r.EffectivityDate, r.DurationYears, PhilippineTime.Today))
                .Select(r => ((r.StallNo ?? string.Empty).Trim(), (r.ActualOccupant ?? string.Empty).Trim(), r.StallId))
                .Where(p => p.Item1.Length > 0)
                .GroupBy(p => p.Item1, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(p => SpaceNumber.IsSpace(p.Item1))
                .ThenBy(p => ParseStallInt(p.Item1))
                .ThenBy(p => p.Item1, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            // Left empty on purpose - see the summary above.
        }
    }

    /// <summary>The leading digits of a stall number, for ordering the pick-list the way the office reads it.</summary>
    private static int ParseStallInt(string value)
    {
        if (SpaceNumber.IsSpace(value)) return SpaceNumber.HighestOrdinal(new[] { value });

        var digits = new string(value.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : int.MaxValue;
    }

