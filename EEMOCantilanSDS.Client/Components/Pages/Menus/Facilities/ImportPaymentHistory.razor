    // and the back arrow both land there rather than on whatever page happened to come before.
    private string BackUrl => $"/facility/{(Facility ?? string.Empty).ToLowerInvariant()}";

    private static string Peso(decimal amount) => "₱" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private string StepClass(int step)
    {
        var current = _result is not null ? 3 : _rows.Count > 0 ? 2 : 1;
        return step == current ? "is-active" : step < current ? "is-done" : "";
    }

    /// <summary>
    /// The template, as a data URI so it needs no endpoint. Written through CsvCell so the file the office opens
    /// cannot itself be read as a formula, and so it round-trips through the same escaping the exports use.
    /// </summary>
    private string TemplateHref
    {
        get
        {
            var csv = CsvCell.Row(Columns) + "\n"
                      + (IsDaily
                          ? CsvCell.Row("1", "Kim Chui", "2025-03", "12", "OR-100234") + "\n"
                          : CsvCell.Row("1", "Joseph Villamor", "2025-03", "2400.00", "OR-100234", "2025-03-05") + "\n");
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv);
        }
    }

    /// <summary>
    /// Sample rows, the same offer the stallholder import makes.
    ///
    /// <para>Dated from the CURRENT month backwards rather than written down, for the reason the stallholder sample
    /// had to be changed: a fixed date rots, and a sample of payments for months a contract no longer covers would
    /// be rejected row by row and read as the feature being broken. One month is short of the rent so the part-paid
    /// case is visible before the office meets it in its own history.</para>
    /// </summary>
    private void LoadSample()
    {
        Reset();
        _fileName = "Sample data";

        var today = PhilippineTime.Today;
        foreach (var back in new[] { 3, 2, 1 })
        {
            var period = today.AddMonths(-back);

            if (IsDaily)
            {
                // Days, not amounts. One month short of a full month's market days, so the part-recorded case is
                // visible before the office meets it in its own history.
                _rows.Add(new EditableRow
                {
                    StallNo = "1",
                    Occupant = "Kim Chui",
                    Period = $"{period.Year:0000}-{period.Month:00}",
                    DaysPaid = back == 2 ? "8" : "20",
                    OrNumber = $"OR-{100_000 + (4 - back)}"
                });
                continue;
            }

            _rows.Add(new EditableRow
            {
                StallNo = "1",
                Occupant = "Joseph Villamor",
                Period = $"{period.Year:0000}-{period.Month:00}",
                AmountPaid = back == 2 ? "1200.00" : "2400.00",
                OrNumber = $"OR-{100_000 + (4 - back)}",
                DatePaid = new DateTime(period.Year, period.Month, 5)
            });
        }
    }

    private void AddRow() => _rows.Add(new EditableRow());

    /// <summary>
    /// Whether the office is stating the actual days rather than only how many.
    ///
    /// <para>Off by default. Most collection sheets record a count, and a grid of dates nobody fills in is a grid of
    /// mistakes waiting to happen.</para>
    /// </summary>
    private bool _showDates;

    private async Task ToggleDates()
    {
        _showDates = !_showDates;
        if (!_showDates) return;

        // Opened: every row gets one line per day it claims, dated from the payor's OWN uncollected days.
        foreach (var row in _rows)
        {
            SyncDates(row);
            await EnsureDatesAsync(row);
        }
    }

    /// <summary>
    /// Keeps a row's day lines at one per day claimed. Lines already filled in are kept: reducing the count drops the
    /// last lines rather than clearing what the clerk has typed.
    /// </summary>
    private static void SyncDates(EditableRow row)
    {
        _ = int.TryParse((row.DaysPaid ?? string.Empty).Trim(), out var days);
        days = Math.Clamp(days, 0, 31);

        while (row.Days.Count > days) row.Days.RemoveAt(row.Days.Count - 1);
        while (row.Days.Count < days) row.Days.Add(new EditableRow.DayEntry());
    }

    /// <summary>
    /// Claiming a different number of days: resize the lines, then date whatever is now blank.
    ///
    /// <para>The dating is the part that was missing. A new line arrived empty and stayed empty until the office pressed
    /// "Fill the blanks" or closed and reopened the grid, even though the screen already knew which days that payor
    /// owed.</para>
    /// </summary>
    private async Task OnDaysChanged(EditableRow row)
    {
        SyncDates(row);
        await EnsureDatesAsync(row);
    }

    /// <summary>
    /// Choosing or changing the payor: their days are not the last payor's, so the row is re-dated for whoever it now
    /// names. This is the case the office met most often - typing the days first, then picking the payor, and being left
    /// looking at "choose the payor first" with empty boxes after doing exactly that.
    /// </summary>
    private async Task OnPayorChanged(EditableRow row, string stallNo)
    {
        row.StallNo = stallNo;
        await EnsureDatesAsync(row);
    }

    /// <summary>
    /// Dates the undated lines from the payor's OWN uncollected days in that month, earliest first.
    ///
    /// <para>It filled consecutive days from the first of the month before, which offered days the vendor did not owe:
    /// a space let on the 9th owes nothing for the 1st, and a day already collected cannot be collected again. The
    /// server decides, because the server holds the rules — the term windows, the closures, the days already collected
    /// or excused — and the same rules the import will apply when it accepts these days.</para>
    ///
    /// <para>A row with no payor or no readable period is left alone rather than guessed at.</para>
    /// </summary>
    /// <summary>
    /// Asks the server which of this month's days the payor still owes, and remembers them on the row.
    ///
    /// <para>It once filled consecutive days from the first of the month, which offered days the vendor did not owe: a
    /// space let on the 9th owes nothing for the 1st, and a day already collected cannot be collected again. The server
    /// decides, because the server holds the rules - the term windows, the closures, the days already collected or
    /// excused - the same rules the import will apply when it accepts these days.</para>
    /// </summary>
    private async Task FetchDaysAsync(EditableRow row, Guid? stall, int year, int month)
    {
        row.Available.Clear();
        row.Chargeable.Clear();
        row.AlreadyCollected = 0;
        row.DaysUnreadable = false;

        if (stall is null) return;

        var res = await PaymentsApi.GetCollectableDaysAsync(stall.Value, year, month);
        if (!res.IsSuccess || res.Value is null)
        {
            row.DaysUnreadable = true;
            return;
        }

        row.Available.AddRange(res.Value.Uncollected.OrderBy(d => d));
        row.AlreadyCollected = res.Value.AlreadyCollected;

        // The payor's own market days for this month, so a line can be labelled by which of THEIR days it is.
        row.Chargeable.AddRange((res.Value.Chargeable ?? res.Value.Uncollected).OrderBy(d => d));
    }

    /// <summary>
    /// Says what the payor's own record shows, in the office's terms, rather than leaving empty boxes to be puzzled over.
    /// </summary>
    private void Explain(EditableRow row)
    {
        row.DaysNote = null;

        if (row.Days.Count == 0) return;

        if (StallIdFor(row.StallNo) is null)
        {
            row.DaysNote = "Choose the payor first, and their uncollected days will be filled in.";
            return;
        }

        if (row.DaysUnreadable)
        {
            row.DaysNote = "That month's days could not be read. Enter the dates by hand.";
            return;
        }

        var dated = row.Days.Count(d => d.Date.HasValue);

        if (row.Available.Count == 0)
        {
            row.DaysNote = row.AlreadyCollected > 0
                ? $"Paid up to date — all {row.AlreadyCollected} market {(row.AlreadyCollected == 1 ? "day" : "days")} this month are already collected."
                : "No day of this month is owed by this payor: the space was not let, or the market did not open.";
        }
        else if (dated < row.Days.Count)
        {
            row.DaysNote = $"Only {row.Available.Count} " +
                           $"{(row.Available.Count == 1 ? "day is" : "days are")} uncollected this month, " +
                           $"so {row.Days.Count - dated} of the {row.Days.Count} claimed could not be dated.";
        }
    }

    /// <summary>
    /// The "Fill the blanks" link. Everything fills itself now, so this remains only for the row the office has emptied
    /// by hand and wants filled again - it asks the same question through the same one way in.
    /// </summary>
    private async Task FillDaysAsync(EditableRow row)
    {
        row.DatesFetchedFor = default;      // ask again, whatever was asked before
        await EnsureDatesAsync(row);
    }

    /// <summary>The stall a row names, matched within the section already chosen. Null when nothing matches.</summary>
    private Guid? StallIdFor(string? stallNo)
    {
        var key = (stallNo ?? string.Empty).Trim();
        if (key.Length == 0) return null;

        var match = _payors.FirstOrDefault(p => string.Equals(p.StallNo, key, StringComparison.OrdinalIgnoreCase));
        return match.StallId == Guid.Empty ? null : match.StallId;
    }

    /// <summary>
    /// Which of the PAYOR'S market days a line is, not which line of this form it is.
    ///
    /// <para>A space let on the 9th has the 9th as its first market day, so the 11th is its third — and that is the
    /// number the office's own reckoning uses. Where the date is not one of the payor's owed days, or is not yet
    /// entered, there is no such number to give and the cell says so rather than inventing one.</para>
    /// </summary>
    private static string DayLabel(EditableRow row, int slot)
    {
        if (slot < 0 || slot >= row.Days.Count) return "—";

        var date = row.Days[slot].Date;
        if (date is null) return "—";

        var ordinal = row.Chargeable.IndexOf(DateOnly.FromDateTime(date.Value));
        return ordinal >= 0 ? $"Day {ordinal + 1}" : "—";
    }

    private static void SetDayDate(EditableRow row, int slot, string? value)
    {
        if (slot < 0 || slot >= row.Days.Count) return;

        row.Days[slot].Date = DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;
    }

    /// <summary>
    /// Starts the review table empty, for an office typing a few months straight off its ledger. One blank row so
    /// there is somewhere to type immediately; Add row provides the rest.
    /// </summary>
    private void StartManual()
    {
        Reset();
        _fileName = "Entered by hand";
        _rows.Add(new EditableRow());
    }

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < _rows.Count) _rows.RemoveAt(index);
    }

    /// <summary>Rows a single upload will read.</summary>
    /// <remarks>
    /// Capped HERE, not only at the server. The server's limit is checked when Save is pressed, by which time this
    /// page has already parsed the file and rendered six inputs per row - so an oversized history would take the
    /// browser down before the validator was ever consulted. The office is told to split by year instead.
    /// </remarks>
    private const int MaxRows = 5000;

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        _rows.Clear();

        var file = e.File;
        if (file is null) return;
        _fileName = file.Name;

        try
        {
            // 5 MB is generous for a text history and bounds what one upload can cost the server.
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            ParseCsv(await reader.ReadToEndAsync());

            if (_rows.Count == 0)
                _error = "No rows were found in that file. Check it has a header row and at least one payment.";
        }
        catch (IOException)
        {
            _error = "That file is larger than 5 MB. Split the history by year and upload each part.";
        }
        catch
        {
            _error = "That file could not be read. Save it as CSV and try again.";
        }
    }

    /// <summary>
    /// Reads the office's sheet into editable rows. Cells are carried across as written: a bad one is corrected in
    /// the table or reported by the server, never quietly discarded here.
    /// </summary>
    private void ParseCsv(string text)
    {
        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.TrimEnd('\r'))
            .Where(l => l.Trim().Length > 0)
            .ToList();

        if (lines.Count == 0) return;

        var start = lines[0].Contains("stall", StringComparison.OrdinalIgnoreCase)
                    || lines[0].Contains("period", StringComparison.OrdinalIgnoreCase) ? 1 : 0;

        for (var i = start; i < lines.Count; i++)
        {
            if (_rows.Count >= MaxRows)
            {
                _error = $"That file has more than {MaxRows:N0} rows. The first {MaxRows:N0} were read — " +
                         "split the history by year and upload each part.";
                break;
            }

            var cells = SplitCsvLine(lines[i]);
            string Cell(int index) => index < cells.Length ? cells[index].Trim() : string.Empty;

            if (IsDaily)
            {
                // Read by position, like the monthly sheet, but the market's fourth column is a count of days and
                // there is no date-paid column at all: the days ARE the dates.
                _rows.Add(new EditableRow
                {
                    StallNo = Cell(0),
                    Occupant = Cell(1),
                    Period = Cell(2),
                    DaysPaid = Cell(3),
                    OrNumber = Cell(4)
                });
                continue;
            }

            _rows.Add(new EditableRow
            {
                StallNo = Cell(0),
                Occupant = Cell(1),
                Period = Cell(2),
                AmountPaid = Cell(3),
                OrNumber = Cell(4),
                DatePaid = DateTime.TryParse(Cell(5), System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var paid) ? paid : null
            });
        }
    }

    /// <summary>Reads "2025-03", "2025/3" or "03/2025". Zero lets the server report the row rather than guessing.</summary>
    private static (int Year, int Month) ParsePeriod(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (0, 0);

        var parts = value.Split(['-', '/', ' '], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2) return (0, 0);
        if (!int.TryParse(parts[0], out var first) || !int.TryParse(parts[1], out var second)) return (0, 0);

        // A part larger than a day-of-month is the year, whichever side it is written on.
        return first > 31 ? (first, second) : (second, first);
    }

    // Honours double-quoted fields, which may contain commas and "" escapes (RFC 4180).
    private static string[] SplitCsvLine(string line)
    {
        var cells = new List<string>();
        var sb = new System.Text.StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') { sb.Append('"'); i++; }
                else inQuotes = !inQuotes;
            }
            else if (ch == ',' && !inQuotes) { cells.Add(sb.ToString()); sb.Clear(); }
            else sb.Append(ch);
        }

        cells.Add(sb.ToString());
        return cells.ToArray();
    }

    private async Task Save()
    {
        if (Code is not { } code || _rows.Count == 0) return;

        // Stopped here as well as at the server, and named by count, so the office corrects its sheet rather than
        // reading a list of rejections back afterwards.
        if (RowsNeedingAttention() is { Length: > 0 } complaint)
        {
            _saveError = complaint;
            return;
        }

        _saving = true;
        _saveError = null;
        try
        {
            if (IsDaily)
            {
                await SaveDailyAsync(code);
                return;
            }

            var rows = new List<ImportPaymentRow>(_rows.Count);
            for (var i = 0; i < _rows.Count; i++)
            {
                var row = _rows[i];
                var (year, month) = ParsePeriod(row.Period);

                rows.Add(new ImportPaymentRow(
                    RowNumber: i + 1,
                    StallNo: row.StallNo,
                    Occupant: row.Occupant,
                    BillingYear: year,
                    BillingMonth: month,
                    // Through the same reader the stallholder import uses, so "1.500,00" and "1,500.00" are both
                    // fifteen hundred rather than one of them being read as one peso fifty.
                    AmountPaid: SheetNumber.ToDecimal(row.AmountPaid) ?? 0m,
                    OrNumber: row.OrNumber,
                    DatePaid: row.DatePaid));
            }

            var result = await PaymentsApi.ImportPaymentHistoryAsync(
                new BulkImportPaymentHistoryCommand(code, null, rows));

            if (result.IsSuccess && result.Value is not null)
            {
                _result = result.Value;
                _rows.Clear();
            }
            else
            {
                // Nothing was written: the batch is one transaction, so the ledger is exactly as it was.
                _saveError = result.Error ?? "The history could not be recorded. Nothing was saved.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Records the market's history: days rather than amounts, through the facility's own daily-collection machinery.
    ///
    /// <para>Kept apart from the monthly path rather than folded into it with flags, because the two agree about
    /// almost nothing - what a row means, what the server does with it, and what the office reads back afterwards.</para>
    /// </summary>
    private async Task SaveDailyAsync(FacilityCode code)
    {
        var rows = new List<ImportDailyPaymentRow>(_rows.Count);
        for (var i = 0; i < _rows.Count; i++)
        {
            var row = _rows[i];
            var (year, month) = ParsePeriod(row.Period);

            // A count of days, not money - so it is read as a whole number and a bad cell becomes zero, which the
            // server rejects by name rather than settling something arbitrary.
            _ = int.TryParse((row.DaysPaid ?? string.Empty).Trim(), out var days);

            rows.Add(new ImportDailyPaymentRow(
                RowNumber: i + 1,
                StallNo: row.StallNo,
                Occupant: row.Occupant,
                BillingYear: year,
                BillingMonth: month,
                DaysPaid: days,
                OrNumber: row.OrNumber,
                // Only sent when the office is actually stating the days. Sent, they are honoured exactly and nothing
                // is filled in around them - so an undated line is one day fewer recorded, not a day chosen for them.
                Days: _showDates
                    ? row.Days
                        .Where(d => d.Date.HasValue)
                        .Select(d => new ImportDailyDay(
                            DateOnly.FromDateTime(d.Date!.Value),
                            string.IsNullOrWhiteSpace(d.OrNumber) ? null : d.OrNumber.Trim()))
                        .ToList()
                    : null));
        }

        var result = await PaymentsApi.ImportDailyHistoryAsync(
            new BulkImportDailyHistoryCommand(code, _section, rows));

        if (result.IsSuccess && result.Value is not null)
        {
            _dailyResult = result.Value;
            _rows.Clear();
        }
        else
        {
            // Nothing was written: the batch is one transaction, so the ledger is exactly as it was.
            _saveError = result.Error ?? "The history could not be recorded. Nothing was saved.";
        }
    }

    private void Reset()
    {
        _rows.Clear();
        _result = null;
        _dailyResult = null;
        _error = null;
        _saveError = null;
        _fileName = "Sample data";
    }
}
