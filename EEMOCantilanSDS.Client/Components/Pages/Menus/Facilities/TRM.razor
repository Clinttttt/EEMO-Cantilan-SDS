@page "/trm"
@page "/facility/trm"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IGovernedServicesApiClient GovernedApi
@inject IVehicleClassesApiClient VehicleClassesApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — @FacilityCatalog.NameOf(FacilityCode.TRM)</PageTitle>

@* The Transport Terminal is read from what Collector Mobile actually records: Transportation / Parking collections, each with the SRC the
   server issued. There is no separate list of transporters or trips to keep here; the earlier terminal trip records are kept, unchanged,
   behind "Legacy trip history". Nothing on this page records money, and every figure is the server's. The layout owns the <main> landmark. *@
<OperationTopbar Title="@FacilityCatalog.NameOf(FacilityCode.TRM)" Crumb="Transportation" />
<div class="content-area">
    <V3Hero Eyebrow="@($"Operation · {FacilityCatalog.ShortNameOf(FacilityCode.TRM)}")" Title="@FacilityCatalog.NameOf(FacilityCode.TRM)" Compact="true">
        <Meta><span class="trm-meta">@Today.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) · <InstrumentChip Instrument="CT" /> Cash Ticket</span></Meta>
        <Figures>
            <V3HeroFigure Label="Collected today" Value="@Money(_rows.Sum(x => x.Amount))" />
            <V3HeroFigure Label="Transactions today" Value="@_rows.Count.ToString("N0")" />
            @if (_classCount is { } classes)
            {
                <V3HeroFigure Label="Vehicle classes" Value="@classes.ToString("N0")" Note="with an approved rate" />
            }
        </Figures>
    </V3Hero>

    <div class="trm-toolbar">
        <div class="v3-btn-group" role="group" aria-label="Transport Terminal actions">
            <button class="v3-btn" type="button" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
            <a class="v3-btn" href="/operations/transportation">Rates &amp; classes</a>
            <a class="v3-btn" href="/trm/reports">Report</a>
            <a class="v3-btn" href="/facility/trm/legacy">Legacy trip history</a>
        </div>
    </div>

    <section class="v3-panel" aria-labelledby="trm-title" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="trm-title">Today's transportation collections</h2>
            <span class="v3-panel-meta">@_rows.Count @(_rows.Count == 1 ? "collection" : "collections")</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="trm-notice" role="alert">
                <p class="v3-notice v3-notice-error">@_error</p>
                <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }

        <div class="v3-table-wrap trm-scroll" role="region" aria-label="Today's transportation collections" tabindex="0">
            <table class="v3-table">
                <caption class="v3-sr-only">Transportation / Parking collections recorded on @Today.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</caption>
                <thead>
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col">SRC</th>
                        <th scope="col">Payer / reference</th>
                        <th scope="col">Collector</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="v3-num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@PhilippineTime.ToPhilippineTime(row.RecordedAtUtc).ToString("h:mm tt", CultureInfo.InvariantCulture)</td>
                            <td class="v3-strong">@(row.ReferenceCode ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PayerName) ? "—" : row.PayerName)@if (!string.IsNullOrWhiteSpace(row.Reference)) { <span class="v3-block">@row.Reference</span> }</td>
                            <td>@(row.CollectorName ?? "—")</td>
                            <td>@row.Disposition</td>
                            <td class="v3-num v3-strong">@Money(row.Amount)</td>
                        </tr>
                    }
                    @if (_rows.Count == 0)
                    {
                        <tr>
                            <td class="v3-empty" colspan="6">
                                @if (_loading) { <span role="status">Loading collections…</span> }
                                else if (_error is not null) { <span>Collections are unavailable.</span> }
                                else { <span>No transportation collections were recorded today.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_rows.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="5"><strong>Total today</strong></td>
                            <td class="v3-num v3-strong">@Money(_rows.Sum(x => x.Amount))</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>
</div>

@code {
    private static DateOnly Today => PhilippineTime.Today;
    private List<GovernedServiceActivityDto> _rows = [];
    private int? _classCount;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var activity = await GovernedApi.GetActivityAsync(CollectorOperationCodes.Transportation, Today, Today);
            if (activity.IsSuccess) _rows = activity.Value?.OrderByDescending(x => x.RecordedAtUtc).ToList() ?? [];
            else { _rows = []; _error = "Today's collections couldn't be loaded."; }

            // A count only the server's own list can give; if it cannot be read the figure is left out rather than guessed.
            var classes = await VehicleClassesApi.GetAsync();
            _classCount = classes.IsSuccess ? classes.Value?.Count(x => x.IsActive && x.CurrentAmount is not null) : null;
        }
        catch { _rows = []; _error = "Today's collections couldn't be loaded."; }
        finally { _loading = false; }
    }

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
