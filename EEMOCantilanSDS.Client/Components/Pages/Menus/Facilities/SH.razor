@page "/slh"
@page "/facility/slh"
@using EEMOCantilanSDS.Client.Components.Pages.Shared.SH
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Application.Dtos.Slaughterhouse
@using EEMOCantilanSDS.Application.Command.Slaughterhouse.RecordSlaughter
@using EEMOCantilanSDS.Application.Command.Slaughterhouse.UpdateSlaughter
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Constants
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject NavigationManager Navigation
@inject ISlaughterApiClient SlaughterApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
<PageTitle>StallTrack — @FacilityCatalog.NameOf(FacilityCode.SLH)</PageTitle>


@* Slaughterhouse workspace (V3). The register lists the month's transactions: legacy rows as they were recorded, and collections the
   Collectors posted on the canonical workflow (one SRC each, itemized by approved charge when the Head collects that way). Charges,
   their animal scope, rates and effective dates are set up below; a collector selects them and never prices. *@
<div class="v3-page sh-page">
    <V3Hero OperationCode="@CollectorOperationCodes.Slaughterhouse" Eyebrow="@($"Operations · {FacilityCatalog.ShortNameOf(FacilityCode.SLH)}")" Title="@FacilityCatalog.NameOf(FacilityCode.SLH)" Compact="true">
        <Icon>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 2.5c0 1.5-1.5 5-1.5 5h-2S9.5 4 9.5 2.5a2.5 2.5 0 0 1 5 0z" /><path d="M12 7.5V22" /><path d="M5 12h14" /></svg>
        </Icon>
        <Meta><span class="sh-meta">@MonthLabel · <InstrumentChip Instrument="OR" /> Official Receipt</span></Meta>
        <Figures>
            <V3HeroFigure Label="Collected" Value="@(Overview is null ? "—" : $"₱{TotalCollected:N2}")" />
            <V3HeroFigure Label="Transactions" Value="@(Overview is null ? "—" : Overview.TotalTransactions.ToString("N0"))" />
            <V3HeroFigure Label="Heads" Value="@(Overview is null ? "—" : TotalHeads.ToString("N0"))" />
        </Figures>
        <Actions>
            <a class="v3-btn" href="/collections/activity">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
                Collection Activity
            </a>
            <a class="v3-btn" href="/slh/reports">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2" /></svg>
                Reports
            </a>
            <a class="v3-btn" href="/reports/slaughterhouse">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                Slaughter list
            </a>
        </Actions>
    </V3Hero>

    <SlaughterRecordModal ShowModal="ShowRecordModal"
                          HogRate="@Overview?.HogRatePerHead"
                          LargeRate="@Overview?.LargeRatePerHead"
                          ApprovedAnimals="@Overview?.ApprovedAnimals"
                          Labels="@AnimalLabels"
                          OnClose="CloseRecordModal"
                          OnSubmit="SubmitSlaughterRecord"
                          ErrorMessage="@ErrorMessage" />

    <SlaughterOfficeRecord Show="ShowOfficeRecord" Labels="@AnimalLabels" ApprovedAnimals="@Overview?.ApprovedAnimals"
                           OnClose="CloseOfficeRecord" OnRecorded="OfficeRecorded" />

    <AddSlaughterTransactionModal ShowModal="ShowAddTransactionModal"
                                  HogRate="@Overview?.HogRatePerHead"
                                  LargeRate="@Overview?.LargeRatePerHead"
                                  ApprovedAnimals="@Overview?.ApprovedAnimals"
                                  Labels="@AnimalLabels"
                                  OwnerName="@SelectedOwnerName"
                                  TransactionDate="@SelectedTransactionDate"
                                  ORNumber="@SelectedORNumber"
                                  OnClose="CloseAddTransactionModal"
                                  OnSubmit="SubmitAddTransaction"
                                  ErrorMessage="@ErrorMessage" />

    <EditSlaughterTransactionModal ShowModal="ShowEditModal"
                                   HogRate="@Overview?.HogRatePerHead"
                                   LargeRate="@Overview?.LargeRatePerHead"
                                   Labels="@AnimalLabels"
                                   OnClose="CloseEditModal"
                                   OnSave="SubmitEditTransaction"
                                   ErrorMessage="@ErrorMessage"
                                   SelectedGroupEntries="@SelectedGroupEntriesAsObjects" />

    <section aria-labelledby="sh-animals-title" aria-busy="@(isLoading ? "true" : "false")">
        <h2 id="sh-animals-title" class="v3-sr-only">Heads by animal</h2>
        <div class="sh-cards" role="list" aria-label="Heads by animal">
            @foreach (var card in AnimalCards)
            {
                <button type="button" role="listitem" class="v3-panel sh-card @(ActiveAnimalFilter == card.Filter ? "is-on" : null)"
                        aria-pressed="@(ActiveAnimalFilter == card.Filter ? "true" : "false")" @onclick="() => ToggleCardFilter(card.Filter)">
                    <span class="sh-card-name">@card.Label</span>
                    <span class="sh-card-amount">@(Overview is null ? "—" : card.Heads.ToString("N0"))<small>@(card.Heads == 1 ? " head" : " heads")</small></span>
                    <progress class="sh-bar" max="100" value="@HeadShare(card.Heads)" aria-label="@($"{card.Label} share of heads in {MonthLabel}")"></progress>
                    <span class="sh-card-share">@HeadShare(card.Heads)% of heads</span>
                </button>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_recordedNotice))
    {
        <p class="v3-notice" role="status">@_recordedNotice</p>
    }

    <section class="v3-panel" aria-labelledby="sh-register-title" aria-busy="@(isLoading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="sh-register-title">Transactions</h2>
            <button class="v3-btn v3-btn-primary v3-btn-sm" type="button" @onclick="OpenRecordSlaughterModal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Record slaughter
            </button>
        </header>

        <div class="v3-toolbar sh-toolbar" aria-label="Transaction filters">
            <input class="v3-input sh-month" type="month" aria-label="Month" title="Month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            <label class="v3-search">
                <span class="v3-sr-only">Search owner or reference</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                <input type="search" placeholder="Search owner or reference" aria-label="Search owner or reference" autocomplete="off"
                       @bind="SearchTerm" @bind:event="oninput" />
            </label>
            <div class="sh-seg" role="group" aria-label="Animal">
                @foreach (var tab in AnimalFilters)
                {
                    <button type="button" class="@(ActiveAnimalFilter == tab ? "is-on" : null)" aria-pressed="@(ActiveAnimalFilter == tab ? "true" : "false")"
                            @onclick="() => SetAnimalFilter(tab)">@tab</button>
                }
            </div>
        </div>

        <div class="v3-table-wrap sh-scroll" role="region" aria-label="Slaughterhouse transactions" tabindex="0">
            <table class="v3-table">
                <caption class="v3-sr-only">Slaughterhouse transactions for @MonthLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Animal</th>
                        <th scope="col" class="v3-num">Heads</th>
                        <th scope="col" class="v3-num">Charges</th>
                        <th scope="col" class="v3-num">Total</th>
                        <th scope="col">Reference</th>
                        <th scope="col"><span class="v3-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr aria-hidden="true">
                                <td><Skeleton Width="80px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="130px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="70px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="30px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="70px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="70px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="100px" Height="13px" Radius="6px" /></td>
                                <td><Skeleton Width="60px" Height="26px" Radius="8px" /></td>
                            </tr>
                        }
                    }
                    else
                    {
                        @foreach (var ownerGroup in FilteredOwnerGroups)
                        {
                            var first = ownerGroup.LatestTransactions.First();
                            var hasMultipleAnimals = ownerGroup.LatestTransactions.Count > 1;
                            var hasHistory = ownerGroup.TotalTransactionDates > 1;
                            var rowKey = $"{ownerGroup.OwnerName}_{ownerGroup.ORNumber}";
                            var open = IsAnimalRowExpanded(rowKey);
                            var historyOpen = IsHistoryRowExpanded(ownerGroup.OwnerName);
                            var itemized = ownerGroup.LatestTransactions.Any(t => t.Items is { Count: > 0 });
                            var totalHeads = ownerGroup.LatestTransactions.Sum(t => t.NumberOfHeads);
                            var totalAmount = ownerGroup.LatestTransactions.Sum(t => t.TotalAmount);
                            <tr class="sh-row @(open ? "is-open" : null)">
                                <td>@ownerGroup.LatestTransactionDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    <span class="v3-strong">@ownerGroup.OwnerName</span>
                                    @if (hasHistory)
                                    {
                                        <button class="sh-link" type="button" aria-expanded="@(historyOpen ? "true" : "false")" @onclick="async () => await ToggleHistoryRow(ownerGroup.OwnerName)">
                                            @(ownerGroup.TotalTransactionDates - 1) earlier
                                        </button>
                                    }
                                </td>
                                <td>@GetAnimalTypeName(first.AnimalType, first.CustomAnimalType)@if (hasMultipleAnimals) {<span class="sh-more">+@(ownerGroup.LatestTransactions.Count - 1)</span>}</td>
                                <td class="v3-num">@totalHeads</td>
                                <td class="v3-num">
                                    @if (itemized || hasMultipleAnimals)
                                    {
                                        <button class="sh-link sh-num-link" type="button" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleAnimalRow(rowKey)">
                                            @(itemized ? $"{ownerGroup.LatestTransactions.Sum(t => t.Items?.Count ?? 0)} charges" : "Breakdown")
                                        </button>
                                    }
                                    else
                                    {
                                        <span title="@ItemizedFees(first.Components)">@Money(first.RatePerHead) / head</span>
                                    }
                                </td>
                                <td class="v3-num v3-strong">@Money(totalAmount)</td>
                                <td><span class="sh-ref">@ownerGroup.ORNumber</span></td>
                                <td class="sh-actions">
                                    <div class="v3-btn-group" role="group" aria-label="@($"Actions for {ownerGroup.OwnerName}")">
                                        <button class="v3-btn v3-btn-sm" type="button" @onclick="() => ViewEntry(first)">Record</button>
                                        @* A collection posted on the canonical workflow carries its SRC and is corrected through the correction process, never added to or edited here. *@
                                        @if (first.ReferenceCode is null)
                                        {
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => AddTransactionForOwner(first)">Add</button>
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => EditEntry(first)">Edit</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (open)
                            {
                                <tr class="sh-detail">
                                    <td colspan="8">
                                        <div class="sh-lines">
                                            @foreach (var transaction in ownerGroup.LatestTransactions)
                                            {
                                                <div class="sh-line-head">
                                                    <strong>@GetAnimalTypeName(transaction.AnimalType, transaction.CustomAnimalType)</strong>
                                                    <span>@transaction.NumberOfHeads head@(transaction.NumberOfHeads == 1 ? "" : "s")</span>
                                                    <span class="sh-line-total">@Money(transaction.TotalAmount)</span>
                                                </div>
                                                @if (transaction.Items is { Count: > 0 } items)
                                                {
                                                    <table class="sh-items" aria-label="@($"Charges for {transaction.ReferenceCode}")">
                                                        <thead><tr><th scope="col">Charge</th><th scope="col" class="v3-num">Quantity</th><th scope="col" class="v3-num">Rate</th><th scope="col" class="v3-num">Amount</th></tr></thead>
                                                        <tbody>
                                                            @foreach (var item in items)
                                                            {
                                                                <tr><td>@item.Label</td><td class="v3-num">@item.Quantity.ToString("0.##")</td><td class="v3-num">@Money(item.UnitAmount)</td><td class="v3-num">@Money(item.Amount)</td></tr>
                                                            }
                                                        </tbody>
                                                        <tfoot><tr><th scope="row" colspan="3">Total</th><td class="v3-num">@Money(items.Sum(x => x.Amount))</td></tr></tfoot>
                                                    </table>
                                                }
                                                else if (ItemizedFees(transaction.Components) is { Length: > 0 } fees)
                                                {
                                                    <p class="sh-fees">@fees</p>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (hasHistory && historyOpen && GetOwnerHistory(ownerGroup.OwnerName) is { TransactionGroups.Count: > 1 } history)
                            {
                                @foreach (var orGroup in history.TransactionGroups.Skip(1).Where(g => g.Transactions is { Count: > 0 }))
                                {
                                    var past = orGroup.Transactions.First();
                                    <tr class="sh-history">
                                        <td>@orGroup.TransactionDate.ToString("MMM d, yyyy")</td>
                                        <td>@ownerGroup.OwnerName</td>
                                        <td>@GetAnimalTypeName(past.AnimalType, past.CustomAnimalType)@if (orGroup.Transactions.Count > 1) {<span class="sh-more">+@(orGroup.Transactions.Count - 1)</span>}</td>
                                        <td class="v3-num">@orGroup.Transactions.Sum(t => t.NumberOfHeads)</td>
                                        <td class="v3-num">@(orGroup.Transactions.Any(t => t.Items is { Count: > 0 }) ? $"{orGroup.Transactions.Sum(t => t.Items?.Count ?? 0)} charges" : orGroup.Transactions.Count > 1 ? "" : $"{Money(past.RatePerHead)} / head")</td>
                                        <td class="v3-num">@Money(orGroup.Transactions.Sum(t => t.TotalAmount))</td>
                                        <td><span class="sh-ref">@orGroup.ORNumber</span></td>
                                        <td class="sh-actions"><button class="v3-btn v3-btn-sm" type="button" @onclick="() => ViewEntry(past)">Record</button></td>
                                    </tr>
                                }
                            }
                        }
                        @if (!FilteredOwnerGroups.Any())
                        {
                            <tr><td class="v3-empty" colspan="8">@(GroupedOwnerTransactions.Count == 0 ? $"No slaughter was recorded in {MonthLabel}." : "No transaction matches this filter.")</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <SlaughterChargeSetup Month="@(new DateOnly(CurrentYear, CurrentMonth, 1))" AnimalLabels="@AnimalLabels" Changed="LoadData">
        <Aside><SlaughterApprovedAnimals OnChanged="LoadData" /></Aside>
    </SlaughterChargeSetup>
</div>

@code {

    private RenderFragment SlhIcon => @<svg viewBox="0 0 24 24" style="width: 26px; height: 26px; stroke: var(--gold); fill: none; stroke-width: 2;"><path d="M14.5 2.5c0 1.5-1.5 5-1.5 5h-2S9.5 4 9.5 2.5a2.5 2.5 0 0 1 5 0z" /><path d="M12 7.5V22" /><path d="M5 12h14" /></svg>;

    // -- STATE ----------------------------------------------------
    private bool isLoading = true;
    private int CurrentYear = PhilippineTime.Now.Year;
    private int CurrentMonth = PhilippineTime.Now.Month;
    private string _monthInput = PhilippineTime.Now.ToString("yyyy-MM");
    private string MonthLabel => new DateTime(CurrentYear, CurrentMonth, 1).ToString("MMMM yyyy");
    private static string Money(decimal amount) => "₱" + amount.ToString("N2");
    private List<OwnerTransactionGroupDto> GroupedOwnerTransactions = new();
    private Dictionary<string, OwnerTransactionHistoryDto> OwnerHistories = new();
    private SlaughterOverviewDto? Overview;
    private string SearchTerm { get; set; } = string.Empty;
    private string ActiveAnimalFilter { get; set; } = "All";
    private bool ShowRecordModal { get; set; }
    private bool ShowAddTransactionModal { get; set; }
    private bool ShowEditModal { get; set; }
    private string SelectedOwnerName { get; set; } = string.Empty;
    private DateTime SelectedTransactionDate { get; set; } = PhilippineTime.Now;
    private string SelectedORNumber { get; set; } = string.Empty;
    // Stored components of the rate already charged; shown, never recomputed or edited.
    private static string ItemizedFees(SlaughterFeeComponentsDto? c)
    {
        if (c is null) return string.Empty;
        var parts = new List<string> { $"Slaughter fee ₱{c.SlaughterFee:N2}" };
        if (c.SlaughterPermit is { } permit) parts.Add($"Permit ₱{permit:N2}");
        parts.Add($"Antemortem ₱{c.AntemortemFee:N2}");
        if (c.PostmortemFee is { } post) parts.Add($"Postmortem ₱{post:N2}");
        parts.Add($"Table ₱{c.TableCharge:N2}");
        if (c.EntranceFee is { } entrance) parts.Add($"Entrance ₱{entrance:N2}");
        if (c.LivestockFee is { } livestock) parts.Add($"Livestock ₱{livestock:N2}");
        return string.Join(" · ", parts);
    }

    private SlaughterTransactionDto? SelectedEntry { get; set; }
    private List<SlaughterTransactionDto> SelectedGroupEntries { get; set; } = new();
    private List<object> SelectedGroupEntriesAsObjects => SelectedGroupEntries.Cast<object>().ToList();
    private string ErrorMessage { get; set; } = string.Empty;
    private HashSet<string> ExpandedAnimalRows { get; set; } = new();
    private HashSet<string> ExpandedHistoryRows { get; set; } = new();

    private SlaughterAnimalLabelsDto AnimalLabels => Overview?.Labels ?? new("Hog", "Carabao", "Cow");
    private List<string> AnimalFilters => new() { "All", AnimalLabels.Hog, AnimalLabels.Carabao, AnimalLabels.Cow, "Others" };

    private sealed record AnimalCard(string Label, string Filter, int Heads);
    private IEnumerable<AnimalCard> AnimalCards =>
    [
        new(AnimalLabels.Hog, AnimalLabels.Hog, Overview?.HogCount ?? 0),
        new(AnimalLabels.Carabao, AnimalLabels.Carabao, Overview?.CarabaoCount ?? 0),
        new(AnimalLabels.Cow, AnimalLabels.Cow, Overview?.CowCount ?? 0),
        new("Others", "Others", Overview?.OthersCount ?? 0)
    ];
    private int HeadShare(int heads)
    {
        var all = (Overview?.HogCount ?? 0) + (Overview?.CarabaoCount ?? 0) + (Overview?.CowCount ?? 0) + (Overview?.OthersCount ?? 0);
        return all == 0 ? 0 : (int)Math.Round(heads * 100m / all);
    }

    [PersistentState(AllowUpdates = true)]
    public SlaughterFacilityPageState? CachedSlaughterFacility { get; set; }

    // -- COMPUTED -------------------------------------------------
    private decimal TotalCollected => Overview?.TotalCollected ?? 0;
    private int TotalHeads => Overview?.TotalHeads ?? 0;
    private int HogCount => Overview?.HogCount ?? 0;
    private int CarabaoCount => Overview?.CarabaoCount ?? 0;
    private int CowCount => Overview?.CowCount ?? 0;
    private int OthersCount => Overview?.OthersCount ?? 0;

    private IEnumerable<OwnerTransactionGroupDto> FilteredOwnerGroups
    {
        get
        {
            var filtered = GroupedOwnerTransactions.AsEnumerable();

            if (ActiveAnimalFilter != "All")
            {
                if (ActiveAnimalFilter == "Others")
                {
                    filtered = filtered.Where(g => g.LatestTransactions.Any(t => t.AnimalType == AnimalType.Other));
                }
                else
                {
                    filtered = filtered.Where(g => g.LatestTransactions.Any(t => GetAnimalTypeName(t.AnimalType, t.CustomAnimalType) == ActiveAnimalFilter));
                }
            }

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                filtered = filtered.Where(g => g.OwnerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                    || (g.ORNumber != null && g.ORNumber.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)));
            }

            return filtered;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        if (CachedSlaughterFacility is { } state
            && state.Year == CurrentYear
            && state.Month == CurrentMonth)
        {
            Overview = state.Overview;
            GroupedOwnerTransactions = state.Groups.ToList();
            isLoading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        await PaintLoadingStateAsync();

        var overviewTask = SlaughterApi.GetOverviewAsync(CurrentYear, CurrentMonth);
        var groupedTask = SlaughterApi.GetGroupedTransactionsAsync(CurrentYear, CurrentMonth);

        await Task.WhenAll(overviewTask, groupedTask);

        var overviewResult = await overviewTask;
        if (overviewResult.IsSuccess)
        {
            Overview = overviewResult.Value;
        }

        var groupedResult = await groupedTask;
        if (groupedResult.IsSuccess)
        {
            GroupedOwnerTransactions = groupedResult.Value?.ToList() ?? new();
        }

        CachedSlaughterFacility = new SlaughterFacilityPageState(
            CurrentYear,
            CurrentMonth,
            Overview,
            GroupedOwnerTransactions.ToList());

        isLoading = false;
        StateHasChanged();
    }

    public sealed record SlaughterFacilityPageState(
        int Year,
        int Month,
        SlaughterOverviewDto? Overview,
        List<OwnerTransactionGroupDto> Groups);

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private string GetAnimalTypeName(AnimalType animalType, string? customAnimalType)
    {
        return animalType switch
        {
            AnimalType.Hog => AnimalLabels.Hog,
            AnimalType.Carabao => AnimalLabels.Carabao,
            AnimalType.Cow => AnimalLabels.Cow,
            AnimalType.Other => customAnimalType ?? "Other",
            _ => "Unknown"
        };
    }

    private void ToggleAnimalRow(string key)
    {
        if (ExpandedAnimalRows.Contains(key))
            ExpandedAnimalRows.Remove(key);
        else
            ExpandedAnimalRows.Add(key);
    }

    private bool IsAnimalRowExpanded(string key) => ExpandedAnimalRows.Contains(key);

    private async Task ToggleHistoryRow(string ownerName)
    {
        if (ExpandedHistoryRows.Contains(ownerName))
        {
            ExpandedHistoryRows.Remove(ownerName);
        }
        else
        {
            if (!OwnerHistories.ContainsKey(ownerName))
            {
                var historyResult = await SlaughterApi.GetOwnerHistoryAsync(ownerName, CurrentYear, CurrentMonth);
                if (historyResult.IsSuccess && historyResult.Value != null)
                {
                    OwnerHistories[ownerName] = historyResult.Value;
                }
            }
            ExpandedHistoryRows.Add(ownerName);
        }
    }

    private bool IsHistoryRowExpanded(string ownerName) => ExpandedHistoryRows.Contains(ownerName);

    private OwnerTransactionHistoryDto? GetOwnerHistory(string ownerName)
    {
        return OwnerHistories.ContainsKey(ownerName) ? OwnerHistories[ownerName] : null;
    }

    // -- ROW CLASS ------------------------------------------------
    private string GetRowClass(string animalType) => animalType switch
    {
        var x when x == AnimalLabels.Hog => "row-hog",
        var x when x == AnimalLabels.Carabao => "row-carabao",
        var x when x == AnimalLabels.Cow => "row-cow",
        _ => ""
    };

    // -- ACTIONS --------------------------------------------------
    // A month the office can look back on: the register, the totals and the by-charge breakdown all follow it.
    private async Task ChangeMonthAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var month)) return;
        CurrentYear = month.Year;
        CurrentMonth = month.Month;
        _monthInput = month.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
        OwnerHistories.Clear();
        ExpandedAnimalRows.Clear();
        ExpandedHistoryRows.Clear();
        await LoadData();
    }

    private void SetAnimalFilter(string filter) => ActiveAnimalFilter = filter;
    private void ToggleCardFilter(string filter) => ActiveAnimalFilter = ActiveAnimalFilter == filter ? "All" : filter;

    private bool ShowOfficeRecord { get; set; }
    private string? _recordedNotice;

    // Once the Head collects by approved charges the office records through the same server-priced collection as the Collector;
    // until then the existing typed-OR per-head record is unchanged.
    private async Task OpenRecordSlaughterModal()
    {
        ErrorMessage = string.Empty;
        _recordedNotice = null;
        var terms = await SlaughterApi.GetOfficeTermsAsync(DateOnly.FromDateTime(PhilippineTime.Now));
        if (terms is { IsSuccess: true, Value: { Itemized: true } })
        {
            ShowOfficeRecord = true;
            return;
        }
        ShowRecordModal = true;
    }

    private void CloseOfficeRecord() => ShowOfficeRecord = false;

    private async Task OfficeRecorded(string? referenceCode)
    {
        ShowOfficeRecord = false;
        _recordedNotice = string.IsNullOrWhiteSpace(referenceCode) ? "Recorded." : $"Recorded · {referenceCode}";
        await LoadData();
    }

    private async Task CloseRecordModal()
    {
        ShowRecordModal = false;
        ErrorMessage = string.Empty;
    }

    private async Task CloseAddTransactionModal()
    {
        ShowAddTransactionModal = false;
        SelectedOwnerName = string.Empty;
        SelectedTransactionDate = PhilippineTime.Now;
        SelectedORNumber = string.Empty;
        ErrorMessage = string.Empty;
    }

    private async Task CloseEditModal()
    {
        ShowEditModal = false;
        SelectedEntry = null;
        ErrorMessage = string.Empty;
    }

    private async Task SubmitSlaughterRecord(SlaughterRecordModal.SlaughterRecordForm form)
    {
        var hasError = false;
        var errorMsg = "";

        if (form.HogHeads > 0)
        {
            var command = new RecordSlaughterCommand(
                form.OwnerName,
                DateOnly.FromDateTime(form.TransactionDate),
                form.ORNo,
                AnimalType.Hog,
                null,
                form.HogHeads,
                null
            );
            var result = await SlaughterApi.RecordTransactionAsync(command);
            if (!result.IsSuccess)
            {
                hasError = true;
                errorMsg = result.Error ?? $"Failed to record {AnimalLabels.Hog} transaction";
            }
        }

        if (!hasError && form.CarabaoHeads > 0)
        {
            var command = new RecordSlaughterCommand(
                form.OwnerName,
                DateOnly.FromDateTime(form.TransactionDate),
                form.ORNo,
                AnimalType.Carabao,
                null,
                form.CarabaoHeads,
                null
            );
            var result = await SlaughterApi.RecordTransactionAsync(command);
            if (!result.IsSuccess)
            {
                hasError = true;
                errorMsg = result.Error ?? $"Failed to record {AnimalLabels.Carabao} transaction";
            }
        }

        if (!hasError && form.CowHeads > 0)
        {
            var command = new RecordSlaughterCommand(
                form.OwnerName,
                DateOnly.FromDateTime(form.TransactionDate),
                form.ORNo,
                AnimalType.Cow,
                null,
                form.CowHeads,
                null
            );
            var result = await SlaughterApi.RecordTransactionAsync(command);
            if (!result.IsSuccess)
            {
                hasError = true;
                errorMsg = result.Error ?? $"Failed to record {AnimalLabels.Cow} transaction";
            }
        }

        if (!hasError && form.CustomHeads > 0)
        {
            var command = new RecordSlaughterCommand(
                form.OwnerName,
                DateOnly.FromDateTime(form.TransactionDate),
                form.ORNo,
                AnimalType.Other,
                form.CustomAnimalType,
                form.CustomHeads,
                form.CustomRate
            );
            var result = await SlaughterApi.RecordTransactionAsync(command);
            if (!result.IsSuccess)
            {
                hasError = true;
                errorMsg = result.Error ?? "Failed to record custom animal transaction";
            }
        }

        if (hasError)
        {
            ErrorMessage = errorMsg;
        }
        else
        {
            await LoadData();
            await CloseRecordModal();
        }
    }

