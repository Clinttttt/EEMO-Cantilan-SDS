@page "/tpm"
@page "/facility/tpm"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.TaboanMarket
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Client.Components.Shared
@inject ITpmApiClient TpmApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — @FacilityCatalog.NameOf(FacilityCode.TPM)</PageTitle>

<header class="tpm-topbar">
    <div class="tpm-topbar-left">
        <a href="/operations" class="tpm-back-btn" aria-label="Back to Operations">
            <svg aria-hidden="true" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="tpm-topbar-title">@FacilityCatalog.NameOf(FacilityCode.TPM)</div>
            <div class="tpm-topbar-breadcrumb">
                <a href="/operations" class="tpm-breadcrumb-link">Operations</a>
                <span class="tpm-breadcrumb-sep">/</span>
                <span class="tpm-breadcrumb-active">@FacilityCatalog.ShortNameOf(FacilityCode.TPM)</span>
            </div>
        </div>
    </div>
    <div class="tpm-topbar-date">
        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
        @PhilippineTime.Now.ToString("MMMM d, yyyy")
    </div>
</header>

<div class="tpm-content-area">
    <FacilityHero Code="FacilityCode.TPM"
                  Eyebrow='@($"OPERATION · {FacilityCatalog.ShortNameOf(FacilityCode.TPM)}")'
                  Title="@FacilityCatalog.NameOf(FacilityCode.TPM)"
                  Icon="@TpmIcon"
                  Stats="@HeroStats" />

    @if (_isLoadingMonth)
    {
        <div class="tpm-page-state" aria-busy="true">Loading Tabo market days…</div>
    }
    else if (_loadError is not null)
    {
        <div class="tpm-load-error" role="alert">
            <span>@_loadError</span>
            <button type="button" @onclick="LoadOverviewAndMarketDaysAsync">Try again</button>
        </div>
    }
    else
    {
        <div class="tpm-columns">
            <section class="tpm-panel" aria-labelledby="tpm-market-days-title">
                <div class="tpm-panel-header">
                    <div id="tpm-market-days-title" class="tpm-panel-title">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        Market Days
                    </div>
                    <div class="tpm-cal-nav" aria-label="Market day month">
                        <button type="button" class="tpm-cal-nav-btn" @onclick="PrevMonth" aria-label="Previous month">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
                        </button>
                        <span class="tpm-cal-month">@CalendarMonth.ToString("MMMM yyyy")</span>
                        <button type="button" class="tpm-cal-nav-btn" disabled="@(CalendarMonth >= CurrentMonthStart)" @onclick="NextMonth" aria-label="Next month">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                        </button>
                    </div>
                </div>

                <div class="tpm-cal-desc">@MarketDayDescription</div>

                <div class="tpm-friday-list">
                    @foreach (var marketDate in MarketDatesInView)
                    {
                        var isFuture = marketDate > PhilippineTime.Now.Date;
                        var dateOnly = DateOnly.FromDateTime(marketDate);
                        var dayEntries = MonthAttendance.Where(a => a.MarketDate == dateOnly).ToList();
                        var record = MarketDays.FirstOrDefault(m => m.MarketDate == dateOnly);
                        var isSelected = SelectedMarketDate?.Date == marketDate.Date;

                        <button type="button"
                                class="tpm-friday-item @(isSelected ? "friday-selected" : "") @(isFuture ? "friday-future" : "")"
                                disabled="@isFuture"
                                aria-pressed="@isSelected"
                                @onclick="() => SelectMarketDate(marketDate)">
                            <span class="tpm-friday-date-block">
                                <span class="tpm-friday-day">@marketDate.ToString("dd")</span>
                                <span class="tpm-friday-label">@marketDate.DayOfWeek</span>
                            </span>
                            <span class="tpm-friday-info">
                                <span class="tpm-friday-full">@marketDate.ToString("MMMM d, yyyy")</span>
                                @if (!isFuture && dayEntries.Count > 0)
                                {
                                    <span class="tpm-friday-meta">@dayEntries.Count vendor entries · ₱@(record?.TotalCollected.ToString("N2") ?? "0.00") collected</span>
                                }
                                else if (!isFuture)
                                {
                                    <span class="tpm-friday-meta tpm-meta-none">No entries</span>
                                }
                                else
                                {
                                    <span class="tpm-friday-meta tpm-meta-future">Upcoming</span>
                                }
                            </span>
                            @if (!isFuture && dayEntries.Count > 0)
                            {
                                <span class="tpm-entry-count" aria-label="@($"{dayEntries.Count} vendor entries")">@dayEntries.Count</span>
                            }
                        </button>
                    }
                </div>

                <div class="tpm-cal-footer">
                    <div class="tpm-cal-sum-item">
                        <span class="tpm-cal-sum-val">@MarketDays.Count</span>
                        <span class="tpm-cal-sum-key">Market Days With Entries</span>
                    </div>
                    <div class="tpm-cal-sum-item">
                        <span class="tpm-cal-sum-val">@(Overview?.VendorEntriesThisMonth ?? 0)</span>
                        <span class="tpm-cal-sum-key">Vendor Entries</span>
                    </div>
                    <div class="tpm-cal-sum-item">
                        <span class="tpm-cal-sum-val">₱@(Overview?.CollectedThisMonth.ToString("N2") ?? "0.00")</span>
                        <span class="tpm-cal-sum-key">Month Collection</span>
                    </div>
                </div>
            </section>

            <section class="tpm-panel" aria-labelledby="tpm-vendor-entries-title">
                <div class="tpm-panel-header tpm-entries-header">
                    <div class="tpm-entries-heading">
                        <span class="tpm-selected-eyebrow">Selected Market Day</span>
                        <span id="tpm-vendor-entries-title" class="tpm-entries-title">Vendor Entries</span>
                        @if (SelectedMarketDate.HasValue)
                        {
                            <span class="tpm-selected-date">@SelectedMarketDate.Value.ToString("MMMM d, yyyy")</span>
                        }
                    </div>
                    <a class="tpm-report-btn" href="/facility/tpm/report">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h7" /></svg>
                        Report
                    </a>
                </div>

                @if (!SelectedMarketDate.HasValue)
                {
                    <div class="tpm-empty">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        <span>Select a market day to view its entries</span>
                    </div>
                }
                else if (_isLoadingAttendance)
                {
                    <div class="tpm-attendance-info" aria-busy="true" aria-label="Loading vendor entries">
                        <div class="tpm-attend-stat"><Skeleton Width="34px" Height="18px" Radius="6px" /><Skeleton Width="88px" Height="10px" Radius="6px" /></div>
                        <div class="tpm-attend-stat"><Skeleton Width="68px" Height="18px" Radius="6px" /><Skeleton Width="70px" Height="10px" Radius="6px" /></div>
                    </div>
                    <div class="tpm-search-wrap"><Skeleton Width="100%" Height="32px" Radius="8px" /></div>
                    <div class="tpm-vendor-table-wrap tpm-loading-table">
                        <table class="tpm-vendor-table" aria-hidden="true">
                            <thead><tr><th>#</th><th>Vendor</th><th>Goods / Product</th><th>Fee</th></tr></thead>
                            <tbody>
                                @for (var row = 0; row < 4; row++)
                                {
                                    <tr><td><Skeleton Width="18px" Height="12px" Radius="6px" /></td><td><Skeleton Width="115px" Height="12px" Radius="6px" /></td><td><Skeleton Width="96px" Height="12px" Radius="6px" /></td><td><Skeleton Width="52px" Height="12px" Radius="6px" /></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_attendanceError is not null)
                {
                    <div class="tpm-load-error" role="alert">
                        <span>@_attendanceError</span>
                        <button type="button" @onclick="() => SelectMarketDate(SelectedMarketDate.Value)">Try again</button>
                    </div>
                }
                else
                {
                    <div class="tpm-attendance-info">
                        <div class="tpm-attend-stat">
                            <span class="tpm-attend-val">@Attendance.Count</span>
                            <span class="tpm-attend-key">Vendor Entries</span>
                        </div>
                        <div class="tpm-attend-stat">
                            <span class="tpm-attend-val">₱@SelectedMarketDayCollection.ToString("N2")</span>
                            <span class="tpm-attend-key">Collected</span>
                        </div>
                        <div class="tpm-instrument-context"><span class="tpm-instrument-mark">OR</span><span>Official Receipt policy</span></div>
                    </div>

                    <div class="tpm-search-wrap">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input @key="SelectedMarketDate" class="tpm-search-input" placeholder="Search vendor or goods..." @oninput="OnVendorSearchChanged" aria-label="Search vendor or goods" />
                    </div>

                    @if (Attendance.Count == 0)
                    {
                        <div class="tpm-empty">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                            <span>No entries</span>
                        </div>
                    }
                    else if (!FilteredVendors.Any())
                    {
                        <div class="tpm-empty"><span>No matching entries</span></div>
                    }
                    else
                    {
                        <div class="tpm-entry-context">
                            <span class="tpm-source-label">Source</span>
                            <span>TPM attendance records · collected totals include entries marked paid</span>
                        </div>
                        <div class="tpm-vendor-table-wrap">
                            <table class="tpm-vendor-table">
                                <thead><tr><th>#</th><th>Vendor</th><th>Goods / Product</th><th>Fee</th></tr></thead>
                                <tbody>
                                    @foreach (var (vendor, index) in FilteredVendors.Select((v, i) => (v, i + 1)))
                                    {
                                        <tr>
                                            <td class="tpm-row-num">@index</td>
                                            <td class="tpm-vendor-name-cell">@vendor.VendorName</td>
                                            <td class="tpm-goods-cell">@vendor.Goods</td>
                                            <td class="tpm-fee-cell">@(vendor.IsPaid ? $"₱{vendor.Fee:N2}" : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    private RenderFragment TpmIcon => @<svg class="tpm-hero-glyph" aria-hidden="true" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>;

    private List<FacilityHero.HeroStat> HeroStats => new()
    {
        new() { Value = Overview is null ? "—" : $"₱{Overview.CollectedThisMonth:N2}", Label = "Collected This Month" },
        new() { Value = Overview is null ? "—" : Overview.MarketDates.Count.ToString(), Label = "Market Days This Month" },
        new() { Value = Overview is null ? "—" : Overview.VendorEntriesThisMonth.ToString(), Label = "Vendor Entries" }
    };

    private TpmOverviewDto? Overview;
    private List<TpmMarketDayDto> MarketDays = new();
    private List<TpmVendorAttendanceDto> MonthAttendance = new();
    private List<TpmVendorAttendanceDto> Attendance = new();
    private DateTime CalendarMonth = new(PhilippineTime.Now.Year, PhilippineTime.Now.Month, 1);
    private DateTime CurrentMonthStart => new(PhilippineTime.Now.Year, PhilippineTime.Now.Month, 1);
    private DateTime? SelectedMarketDate;
    private string VendorSearch = string.Empty;
    private string? _loadError;
    private string? _attendanceError;
    private bool _isLoadingMonth = true;
    private bool _isLoadingAttendance;

    private List<DateTime> MarketDatesInView => Overview?.MarketDates
        .Select(d => d.ToDateTime(TimeOnly.MinValue))
        .OrderBy(d => d)
        .ToList() ?? new();

    private string MarketDayDescription
    {
        get
        {
            var dates = MarketDatesInView;
            if (dates.Count == 0) return "No configured market dates for this month.";

            var first = dates[0].DayOfWeek;
            var moved = dates.FirstOrDefault(d => d.DayOfWeek != first);
            return moved == default
                ? $"Every {first}"
                : $"Every {first}, then every {moved.DayOfWeek} from {moved:MMMM d}";
        }
    }

    private decimal SelectedMarketDayCollection => SelectedMarketDate is { } selectedDate
        ? MarketDays.FirstOrDefault(day => day.MarketDate == DateOnly.FromDateTime(selectedDate))?.TotalCollected ?? 0m
        : 0m;

    private IEnumerable<TpmVendorAttendanceDto> FilteredVendors => Attendance
        .Where(a => string.IsNullOrWhiteSpace(VendorSearch)
                 || a.VendorName.Contains(VendorSearch, StringComparison.OrdinalIgnoreCase)
                 || a.Goods.Contains(VendorSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(a => a.VendorName);

    [PersistentState(AllowUpdates = true)]
    public TpmPageState? CachedTpmPage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        if (CachedTpmPage is { } state
            && state.Year == CalendarMonth.Year
            && state.Month == CalendarMonth.Month)
        {
            Overview = state.Overview;
            MarketDays = state.MarketDays.ToList();
            MonthAttendance = state.MonthAttendance.ToList();
            _isLoadingMonth = false;
            return;
        }

        await LoadOverviewAndMarketDaysAsync();
    }

    private async Task LoadOverviewAndMarketDaysAsync()
    {
        _isLoadingMonth = true;
        _loadError = null;
        Overview = null;
        MarketDays.Clear();
        MonthAttendance.Clear();
        await PaintLoadingStateAsync();

        try
        {
            var overviewTask = TpmApi.GetOverviewAsync(CalendarMonth.Year, CalendarMonth.Month);
            var marketDaysTask = TpmApi.GetMarketDaysAsync(CalendarMonth.Year, CalendarMonth.Month);
            var attendanceTask = TpmApi.GetMonthAttendanceAsync(CalendarMonth.Year, CalendarMonth.Month);
            await Task.WhenAll(overviewTask, marketDaysTask, attendanceTask);

            var overviewResult = await overviewTask;
            var marketDaysResult = await marketDaysTask;
            var attendanceResult = await attendanceTask;
            if (!overviewResult.IsSuccess || overviewResult.Value is null
                || !marketDaysResult.IsSuccess || marketDaysResult.Value is null
                || !attendanceResult.IsSuccess || attendanceResult.Value is null)
            {
                _loadError = "Tabo market-day records could not be loaded.";
                return;
            }

            Overview = overviewResult.Value;
            MarketDays = marketDaysResult.Value.ToList();
            MonthAttendance = attendanceResult.Value.ToList();
            CachedTpmPage = new TpmPageState(
                CalendarMonth.Year,
                CalendarMonth.Month,
                Overview,
                MarketDays.ToList(),
                MonthAttendance.ToList());
        }
        catch
        {
            _loadError = "Tabo market-day records could not be loaded.";
        }
        finally
        {
            _isLoadingMonth = false;
        }
    }

    private async Task PrevMonth()
    {
        CalendarMonth = CalendarMonth.AddMonths(-1);
        SelectedMarketDate = null;
        Attendance.Clear();
        await LoadOverviewAndMarketDaysAsync();
    }

    private async Task NextMonth()
    {
        if (CalendarMonth >= CurrentMonthStart) return;
        CalendarMonth = CalendarMonth.AddMonths(1);
        SelectedMarketDate = null;
        Attendance.Clear();
        await LoadOverviewAndMarketDaysAsync();
    }

    private async Task SelectMarketDate(DateTime marketDate)
    {
        if (marketDate.Date > PhilippineTime.Now.Date) return;

        SelectedMarketDate = marketDate.Date;
        VendorSearch = string.Empty;
        _attendanceError = null;
        Attendance.Clear();
        _isLoadingAttendance = true;
        await PaintLoadingStateAsync();

        try
        {
            var result = await TpmApi.GetVendorAttendanceAsync(DateOnly.FromDateTime(marketDate));
            if (!result.IsSuccess || result.Value is null)
                _attendanceError = "Vendor entries for this market day could not be loaded.";
            else
                Attendance = result.Value.ToList();
        }
        catch
        {
            _attendanceError = "Vendor entries for this market day could not be loaded.";
        }
        finally
        {
            _isLoadingAttendance = false;
        }
    }

    private void OnVendorSearchChanged(ChangeEventArgs args) =>
        VendorSearch = args.Value?.ToString() ?? string.Empty;

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    public sealed record TpmPageState(
        int Year,
        int Month,
        TpmOverviewDto? Overview,
        List<TpmMarketDayDto> MarketDays,
        List<TpmVendorAttendanceDto> MonthAttendance);
}
