@page "/facility/{Slug}/renewals"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Dtos.Stalls
@using EEMOCantilanSDS.Application.Requests.Stalls
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IStallsApiClient StallsApi
@inject FacilityState FacilityCatalog

<PageTitle>StallTrack — Renew expired terms</PageTitle>

@* The facility-owned place to renew its expired terms in one go. It was the "Renew eligible" button of the Closed Accounts report; a report changes nothing
   (IA-006), so the operation lives here with the facility. It is the same Stalls endpoint with the same arguments, one account at a time: each account keeps its
   own occupant and contract name, only the common start date and term are applied, and the server decides each one. *@
<OperationTopbar Title="Renew expired terms" Crumb="@FacilityName" ParentHref="@($"/facility/{Slug}")" ParentTitle="@FacilityName" />
<div class="content-area">
    @if (_loading)
    {
        <Skeleton Height="220px" />
    }
    else if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row" role="alert"><span>@_error</span><button type="button" class="btn-outline" @onclick="LoadAsync">Try again</button></div>
    }
    else if (_unknown)
    {
        <div class="v3-notice" role="status"><span>That facility was not found.</span><a class="btn-outline" href="/operations">Back to Operations</a></div>
    }
    else
    {
        <section class="v3-panel str-panel" aria-label="Expired terms">
            <header class="str-head">
                <h2>@FacilityName</h2>
                <span class="str-count">@(_eligible.Count) expired term@(_eligible.Count == 1 ? "" : "s")</span>
            </header>
            @if (_eligible.Count == 0)
            {
                <p class="str-empty" role="status">Nothing to renew here. Closed accounts, accounts already on a new term and accounts someone else now holds are not renewed this way.</p>
            }
            else
            {
                <form class="str-form" @onsubmit="RenewAsync" @onsubmit:preventDefault="true" aria-label="Renew these terms">
                    <label class="str-field">New term starts <input id="str-start" type="date" @bind="_start" disabled="@_busy" /></label>
                    <label class="str-field str-field-short">Term (years) <input id="str-years" type="number" min="1" max="50" @bind="_years" disabled="@_busy" /></label>
                    <div class="str-field">New term ends <span class="str-ends" role="status">@(_years >= 1 ? DomainRules.TermLastDay(_start, _years).ToString("MMM d, yyyy") : "—")</span></div>
                    <button type="submit" class="btn-primary str-submit" disabled="@(_busy || _editing is not null || Included.Count == 0)">@(_busy ? "Working…" : $"Renew {Included.Count} term{(Included.Count == 1 ? "" : "s")}")</button>
                </form>
                <p class="str-note">The lapsed period is not back-billed and nothing is written off. Use the pencil to correct a holder or contract name before renewing.</p>
                @if (_progress is not null) { <p class="str-note" role="status">@_progress</p> }
                @if (_message is not null) { <p class="str-message" role="alert">@_message</p> }

                <div class="str-table-wrap">
                <table class="str-table">
                    <thead><tr><th>@Unit</th><th>Holder</th><th>Name on contract</th><th>Term ended</th><th class="str-r">Balance</th><th>Status</th><th class="str-edit-cell"><span class="v3-sr-only">Edit</span></th></tr></thead>
                    <tbody>
                        @foreach (var row in _eligible)
                        {
                            var (holder, onContract) = NamesFor(row);
                            <tr @key="row.StallId" class="@(_excluded.Contains(row.StallId) ? "str-row-excluded" : _edits.ContainsKey(row.StallId) ? "str-row-changed" : "")">
                                <td class="str-strong">@SpaceNumber.Display(row.StallNo)</td>
                                @if (_editing == row.StallId)
                                {
                                    <td colspan="2">
                                        <div class="str-edit">
                                            <label>Holder <input id="str-edit-holder" @bind="_editHolder" @bind:event="oninput" /></label>
                                            <label>Name on contract <input id="str-edit-contract" @bind="_editContract" @bind:event="oninput" /></label>
                                            <div class="str-edit-actions">
                                                <button type="button" class="btn-primary" @onclick="() => SaveEdit(row)" disabled="@string.IsNullOrWhiteSpace(_editHolder)">Done</button>
                                                <button type="button" class="btn-outline" @onclick="CancelEdit">Cancel</button>
                                            </div>
                                            @if (!string.Equals(_editHolder?.Trim(), row.Occupant.Trim(), StringComparison.OrdinalIgnoreCase))
                                            {
                                                <p class="str-edit-warn">A new holder ends the current holder's online payment link to this @Unit.ToLowerInvariant().</p>
                                            }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td>@holder</td>
                                    <td class="str-muted">@(string.IsNullOrWhiteSpace(onContract) ? "—" : onContract)</td>
                                }
                                <td class="str-muted">@row.ExpiryDate.ToString("MMM d, yyyy")</td>
                                <td class="str-r">@(row.Uncollected > 0 ? $"₱{row.Uncollected:N0}" : "₱0")</td>
                                <td>@if (_results.TryGetValue(row.StallId, out var result)) { <span class="@(result.Ok ? "str-ok" : "str-fail")" role="status">@result.Text</span> }
                                    else if (_excluded.Contains(row.StallId)) { <span class="str-muted">Left out</span> }
                                    else if (_edits.ContainsKey(row.StallId)) { <span class="str-tag">Edited</span> }
                                    else { <span class="str-muted">Ready</span> }</td>
                                <td class="str-edit-cell">
                                    <div class="str-row-actions">
                                    @if (_editing != row.StallId && !_excluded.Contains(row.StallId))
                                    {
                                        <button type="button" class="str-pencil" @onclick="() => StartEdit(row)" disabled="@(_busy || _editing is not null)"
                                                aria-label="@($"Edit holder and contract name for {Unit} {SpaceNumber.Display(row.StallNo)}")" title="Edit holder and contract name">
                                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg>
                                        </button>
                                    }
                                    @if (_editing != row.StallId)
                                    {
                                        @* Leaves this account out of THIS renewal only; it is not closed, deleted or changed, and stays listed to put back. *@
                                        <button type="button" class="str-pencil" @onclick="() => ToggleExcluded(row.StallId)" disabled="@(_busy || _editing is not null)"
                                                aria-label="@($"{(_excluded.Contains(row.StallId) ? "Put back" : "Leave out")} {Unit} {SpaceNumber.Display(row.StallNo)}")"
                                                title="@(_excluded.Contains(row.StallId) ? "Put back into this renewal" : "Leave out of this renewal (nothing is changed)")">
                                            @(_excluded.Contains(row.StallId) ? IconUndo : IconRemove)
                                        </button>
                                    }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private List<ClosedStallAccountDto> _eligible = [];
    private readonly Dictionary<Guid, (bool Ok, string Text)> _results = [];
    private bool _loading = true, _busy, _unknown;
    private string? _error, _progress, _message;
    private DateOnly _start = PhilippineTime.Today;
    private int _years = 3;

    // Accounts left out of this renewal by the office. Display-only: a left-out account is not changed and stays listed to put back.
    private readonly HashSet<Guid> _excluded = [];
    private List<ClosedStallAccountDto> Included => _eligible.Where(x => !_excluded.Contains(x.StallId)).ToList();
    private void ToggleExcluded(Guid id) { if (!_excluded.Remove(id)) _excluded.Add(id); }
    private static readonly RenderFragment IconRemove = @<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg>;
    private static readonly RenderFragment IconUndo = @<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>;
    private FacilityCode _code;

    // Corrections typed on this page, sent with the renewal as the new term's holder and contract name. Nothing is saved until Renew.
    private readonly Dictionary<Guid, (string Holder, string? ContractName)> _edits = [];
    private Guid? _editing;
    private string? _editHolder, _editContract;

    private (string Holder, string? ContractName) NamesFor(ClosedStallAccountDto r) =>
        _edits.TryGetValue(r.StallId, out var e) ? e : (r.Occupant, r.ContractName);

    private void StartEdit(ClosedStallAccountDto r)
    {
        (_editHolder, _editContract) = NamesFor(r);
        _editing = r.StallId;
    }

    private void CancelEdit() => _editing = null;

    private void SaveEdit(ClosedStallAccountDto r)
    {
        var holder = _editHolder?.Trim();
        if (string.IsNullOrEmpty(holder)) return;
        var contract = string.IsNullOrWhiteSpace(_editContract) ? null : _editContract.Trim();
        if (holder == r.Occupant && contract == (string.IsNullOrWhiteSpace(r.ContractName) ? null : r.ContractName)) _edits.Remove(r.StallId);
        else _edits[r.StallId] = (holder, contract);
        _editing = null;
    }

    private string FacilityName => _eligible.FirstOrDefault()?.FacilityName ?? (_unknown ? Slug : FacilityCatalog.NameOf(_code));
    private string Unit => FacilityCatalog.HolderUnitFor(_code.ToString());

    // The accounts a bulk renewal may cover are exactly those whose own row offers Renew: not ended by a closure, not already on a fresh term, not a past
    // occupancy of a stall somebody else now holds, and with a term to renew (a no-contract occupancy has none). The server still decides each one.
    public static bool IsBulkRenewable(ClosedStallAccountDto r) =>
        r.State != InactiveAccountState.Closed && r.State != InactiveAccountState.Renewed && !r.StallReLet && r.DurationYears > 0;

    protected override async Task OnParametersSetAsync()
    {
        _unknown = !Enum.TryParse(Slug, ignoreCase: true, out _code) || !Enum.IsDefined(_code);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            await FacilityCatalog.EnsureLoadedAsync();
            if (_unknown) return;
            var result = await StallsApi.GetClosedStallAccountsAsync();
            if (result is not { IsSuccess: true }) { _error = result?.Error ?? "The accounts could not be loaded."; return; }
            _eligible = (result.Value ?? []).Where(r => r.FacilityCode == _code && IsBulkRenewable(r)).DistinctBy(r => r.StallId)
                .OrderBy(r => r.StallNo, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _error = "The accounts could not be loaded. Check the connection and try again."; }
        finally { _loading = false; }
    }

    private async Task RenewAsync()
    {
        if (_busy || _eligible.Count == 0) return;
        if (_years < 1) { _message = "Duration must be at least 1 year."; return; }
        _busy = true; _message = null; _results.Clear();
        var targets = Included;
        int ok = 0, failed = 0;
        // Each account keeps its own occupant and contract name (or the correction typed here); only the common start date and term are applied.
        foreach (var r in targets)
        {
            _progress = $"Renewing {ok + failed + 1} of {targets.Count}…";
            await InvokeAsync(StateHasChanged);
            try
            {
                var (holder, onContract) = NamesFor(r);
                var response = await StallsApi.RenewStallContractAsync(r.StallId, new RenewStallContractRequest(_start, _years, holder, onContract));
                if (response.IsSuccess) { ok++; _results[r.StallId] = (true, "Renewed"); _edits.Remove(r.StallId); }
                else { failed++; _results[r.StallId] = (false, response.Error ?? "Refused"); }
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { failed++; _results[r.StallId] = (false, "No answer from the server"); }
        }
        _progress = null;
        _message = failed == 0 ? null : $"{ok} renewed, {failed} failed. Please retry the remaining accounts.";
        var shown = _results.ToDictionary(x => x.Key, x => x.Value);
        await LoadAsync();                       // renewed accounts drop off; what failed is still eligible and is the retry set
        foreach (var (id, outcome) in shown) if (!outcome.Ok || _eligible.Any(e => e.StallId == id)) _results[id] = outcome;
        if (failed == 0 && ok > 0) _message = null;
        _busy = false;
    }
}
