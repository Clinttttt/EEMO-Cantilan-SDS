@page "/import/{Facility}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.IO.Compression
@using System.Text
@using System.Xml.Linq
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Command.Stalls.BulkImportStallholders
@using EEMOCantilanSDS.Application.Dtos.Stalls
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Domain.Constants
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject NavigationManager Navigation
@inject IStallsApiClient StallsApi
@inject IFacilitiesApiClient FacilitiesApi

@*
    ImportStallholders — facility-aware bulk import for stallholders (NPM, TCC, NCC, BBQ, ICE).
    Reached from the Import action in the Add Vendor modal. The admin uploads a CSV/Excel list,
    reviews and edits the rows in a table whose columns match the facility, then saves.

    Backend persistence (CSV/XLSX parsing + a bulk create command) is wired in a later step.
*@

<PageTitle>StallTrack — Import @(_facility?.Name ?? "Stallholders")</PageTitle>

<header class="topbar">
    <div class="topbar-left flex gap-2">
        <a href="@BackUrl" class="imp-back-btn" title="Back to @(_facility?.Name ?? "facility")">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="topbar-title">Import Stallholders</div>
            <div class="topbar-breadcrumb">
                <a href="/menu" class="breadcrumb-link">Dashboard</a>
                <span class="breadcrumb-sep">/</span>
                @if (_facility is not null)
                {
                    <a href="@BackUrl" class="breadcrumb-link">@_facility.ShortCode</a>
                    <span class="breadcrumb-sep">/</span>
                }
                <span class="breadcrumb-active">Import</span>
            </div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @PhilippineTime.Now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">

    @if (_facility is null)
    {
        <div class="imp-state">
            <div class="imp-state-title">Import not available</div>
            <div class="imp-state-text">Bulk import is only supported for @ImportableFacilityList.</div>
            <a class="imp-btn imp-btn-primary" href="/menu">Back to dashboard</a>
        </div>
    }
    else
    {
        <!-- ── Hero ── -->
        <div class="imp-hero">
            <div class="imp-hero-left">
                <div class="imp-hero-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                        <polyline points="17 8 12 3 7 8" />
                        <line x1="12" y1="3" x2="12" y2="15" />
                    </svg>
                </div>
                <div>
                    <div class="imp-hero-eyebrow">@(_facility.ShortCode + SectionSuffix) · Bulk Import</div>
                    <div class="imp-hero-title">Import @_facility.Name Stallholders</div>
                    <div class="imp-hero-sub">Upload a list, review &amp; edit, then save.</div>
                </div>
            </div>
            <div class="imp-steps">
                <div class="imp-step @(StepClass(1))"><span class="imp-step-no">1</span> Upload</div>
                <div class="imp-step-line"></div>
                <div class="imp-step @(StepClass(2))"><span class="imp-step-no">2</span> Review &amp; edit</div>
                <div class="imp-step-line"></div>
                <div class="imp-step @(StepClass(3))"><span class="imp-step-no">3</span> Save</div>
            </div>
        </div>

        @if (_saved && _result is not null)
        {
            <!-- ── Import results ── -->
            <div class="imp-state @(_result.FailedCount == 0 ? "imp-state-ok" : "")">
                <div class="imp-state-badge @(_result.FailedCount == 0 ? "" : "warn")">
                    @if (_result.FailedCount == 0)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
                    }
                </div>
                <div class="imp-state-title">
                    @{ var _imported = _result.CreatedCount + _result.RenewedCount; }
                    @($"{_imported} {_facility.Name}{SectionSuffix} stallholder{(_imported == 1 ? "" : "s")} imported")
                    @if (_result.RenewedCount > 0)
                    {
                        <span> (@_result.CreatedCount new · @_result.RenewedCount renewed)</span>
                    }
                </div>
                <div class="imp-state-text">
                    @if (_result.FailedCount == 0)
                    {
                        <text>All rows were imported successfully.</text>
                    }
                    else
                    {
                        <text>@_result.FailedCount of @_result.TotalRows row@(_result.TotalRows == 1 ? "" : "s") could not be imported and were skipped — see below.</text>
                    }
                </div>

                @if (_result.FailedCount > 0)
                {
                    <div class="imp-result-errors">
                        @foreach (var r in _result.Results.Where(r => !r.Created && !r.Renewed))
                        {
                            <div class="imp-result-err-row">
                                <span class="imp-result-err-row-no">Row @r.RowNumber</span>
                                <span class="imp-result-err-row-name">@(string.IsNullOrWhiteSpace(r.Occupant) ? "—" : r.Occupant)@(string.IsNullOrWhiteSpace(r.StallNo) ? "" : $" · Stall {r.StallNo}")</span>
                                <span class="imp-result-err-row-msg">@r.Error</span>
                            </div>
                        }
                    </div>
                }

                <div class="imp-state-actions">
                    <button class="imp-btn imp-btn-ghost" @onclick="ResetAll">Import another file</button>
                    <a class="imp-btn imp-btn-primary" href="@BackUrl">Back to @_facility.ShortCode</a>
                </div>
            </div>
        }
        else if (NeedsSection)
        {
            <!-- ── NPM: choose section first (each section is a separate sheet) ── -->
            <div class="imp-pick">
                <div class="imp-pick-head">
                    <div class="imp-pick-title">Which section are you importing?</div>
                    <div class="imp-pick-sub">@FacilityCatalog.NameOf(FacilityCode.NPM) keeps a separate list per section. Pick one — every row in the file you upload will be imported into it.</div>
                </div>
                <div class="imp-pick-grid">
                    @foreach (var s in NpmSections)
                    {
                        var sec = s;
                        <button type="button" class="imp-pick-card" @onclick="() => ChooseSection(sec.Name)">
                            <span class="imp-pick-icon @sec.Css">@((MarkupString)sec.Icon)</span>
                            <span class="imp-pick-name">@SectionOptionLabel(sec.Name)</span>
                            <span class="imp-pick-desc">@SectionDesc(sec)</span>
                        </button>
                    }
                    @foreach (var cs in _customSections)
                    {
                        var csName = cs;
                        <button type="button" class="imp-pick-card" @onclick="() => ChooseSection(csName)">
                            <span class="imp-pick-icon">@((MarkupString)CustomSectionIconSvg)</span>
                            <span class="imp-pick-name">@csName</span>
                            <span class="imp-pick-desc">Custom section · ₱@(_npmDailyRate.ToString("0"))/day</span>
                        </button>
                    }
                </div>
            </div>
        }
        else if (!_loaded)
        {
            <!-- ── Step 1: Upload ── -->
            <div class="imp-upload-card">
                @if (RequiresSection)
                {
                    <div class="imp-setup">
                        <div class="imp-setup-group">
                            <span class="imp-setup-key">Section</span>
                            <span class="imp-setup-val">@SectionOptionLabel(_section)</span>
                            <button type="button" class="imp-link imp-link-btn" @onclick="ChangeSection">Change</button>
                        </div>

                        @if (IsCustomSectionChosen)
                        {
                            <div class="imp-setup-divider"></div>
                            <div class="imp-setup-group">
                                <span class="imp-setup-key">Daily fee</span>
                                <div class="imp-rate">
                                    <span class="imp-rate-peso">₱</span>
                                    <input type="number" min="0" step="0.01" placeholder="section rate"
                                           @bind="_customDailyRate" @bind:event="oninput" />
                                    <span class="imp-rate-unit">/day</span>
                                </div>
                            </div>
                        }

                        <div class="imp-setup-divider"></div>
                        <div class="imp-setup-group">
                            <span class="imp-setup-key">Utilities</span>
                            <label class="imp-util @(_applyElectricity ? "on" : "")">
                                <input type="checkbox" @bind="_applyElectricity" />
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                                <span>Electricity</span>
                            </label>
                            <label class="imp-util @(_applyWater ? "on" : "")">
                                <input type="checkbox" @bind="_applyWater" />
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7s6.2 6.6 6.2 11.1a6.2 6.2 0 0 1-12.4 0C5.8 9.3 12 2.7 12 2.7z" /></svg>
                                <span>Water</span>
                            </label>
                        </div>
                    </div>
                }
                <label class="imp-drop">
                    <InputFile OnChange="OnFileChange" class="imp-file-input" accept=".csv,.xlsx" />
                    <div class="imp-drop-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                    </div>
                    <div class="imp-drop-title">Choose a file to upload</div>
                    <div class="imp-drop-sub">CSV or Excel (.xlsx) — the list of @_facility.Name stallholders</div>
                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="imp-drop-err">@_uploadError</div>
                    }
                </label>

                <div class="imp-upload-foot">
                    <a class="imp-link" href="@TemplateDataUri" download="@($"{_facility.ShortCode}-stallholders-template.csv")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                        Download CSV template
                    </a>
                    <span class="imp-foot-sep">·</span>
                    <button class="imp-link imp-link-btn imp-use-sample" @onclick="LoadSample">Use sample data instead</button>
                    <span class="imp-foot-sep">·</span>
                    @* For an office with no file at all. The same review table, starting empty. *@
                    <button class="imp-link imp-link-btn imp-enter-manually" @onclick="StartManual">Enter manually</button>
                </div>

                <div class="imp-cols-preview">
                    <div class="imp-cols-label">Columns for @_facility.ShortCode</div>
                    <div class="imp-cols-chips">
                        @foreach (var c in _facility.Columns)
                        {
                            <span class="imp-chip">@c.Label</span>
                        }
                    </div>
                    @* The office's own lists record spaces let without a contract in the leasee column itself, so the
                       import reads the basis from there. Saying so here means a barbecue or ice-plant list can be
                       uploaded exactly as it is written, with no column to add and no term to invent. *@
                    <div class="imp-cols-note">
                        Where a space is let without a signed contract, write
                        <strong>No contract (space only)</strong> — or
                        <strong>No contract (Extension @_facility.ShortCode)</strong> — in the
                        <strong>Name on Contract</strong> column. Those rows are recorded as open-ended, need no
                        effectivity or term, and print that wording on the official list.
                        A row that leaves both that column <em>and</em> the term empty is taken the same way, so a
                        list written without them uploads as it stands; the rent may be stated in either
                        <strong>Monthly Rental / Contract</strong> or <strong>Actual Mo. Rental</strong>.
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ── Step 2: Review & edit ── -->
            <div class="imp-review-bar">
                <div class="imp-review-left">
                    <div class="imp-review-count">@_rows.Count</div>
                    <div>
                        <div class="imp-review-title">rows ready to review</div>
                        <div class="imp-review-sub">
                            @($"{(string.IsNullOrEmpty(_fileName) ? "Sample data" : _fileName)} · {_facility.Name}{SectionSuffix}")
                        </div>
                    </div>
                </div>
                <div class="imp-review-actions">
                    @* Two bases, two buttons. A space let without a signed contract is not numbered by the office, so
                       it cannot be added by the same action as a contracted stall: one row needs the facility's next
                       stall number and the other must never be given one. A single "Add row" could only assume, and
                       assumed the contract, which is how a barbecue or ice-plant list — where every occupancy is a
                       space — got stall numbers the office does not issue. *@
                    <button class="imp-btn imp-btn-ghost imp-add-row" @onclick="() => AddRow(false)"
                            title="A stall let under a signed contract. Takes the facility's next stall number.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Add row (contract)
                    </button>
                    <button class="imp-btn imp-btn-ghost imp-add-space-row" @onclick="() => AddRow(true)"
                            title="A space let without a signed contract. The office issues no stall number for these.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Add row (space only)
                    </button>
                    <button class="imp-btn imp-btn-outline" @onclick="ResetAll">Discard</button>
                </div>
            </div>

            @if (_autoContinued)
            {
                <div class="imp-continue-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                    <span>
                        @* Says which rows changed and why. It used to announce that the whole batch had been
                           renumbered, which was both alarming and untrue: numbers the office supplied are kept. *@
                        @if (_renumberedClash > 0)
                        {
                            <text>
                                <strong>@_renumberedClash</strong>
                                @(_renumberedClash == 1 ? "row" : "rows")
                                carried a Stall / Space No. already in use in
                                <strong>@_facility.Name@SectionSuffix</strong>, so
                                @(_renumberedClash == 1 ? "it was" : "they were") given the next free number.
                            </text>
                        }
                        @if (_numberedBlank > 0)
                        {
                            <text>
                                <strong>@_numberedBlank</strong>
                                @(_numberedBlank == 1 ? "row" : "rows")
                                arrived without a Stall / Space No. and
                                @(_numberedBlank == 1 ? "was" : "were") numbered from the next free one.
                            </text>
                        }
                        @if (_numberedSpaces > 0)
                        {
                            <text>
                                <strong>@_numberedSpaces</strong>
                                @(_numberedSpaces == 1 ? "row is a space" : "rows are spaces")
                                held without a signed contract. The office does not number these, so
                                @(_numberedSpaces == 1 ? "it keeps" : "they keep")
                                none of the facility's stall numbers.
                            </text>
                        }
                        Every other number is exactly as your list had it.
                        @if (_numberedSpaces > 0)
                        {
                            <text>
                                You can edit any stall number below. The identifier of a space is the system's own and
                                is not editable; it follows the basis written in that row's contract column.
                            </text>
                        }
                        else
                        {
                            <text>You can still edit any Stall / Space No. below.</text>
                        }
                    </span>
                </div>
            }

            @if (_sheetQueries.Count > 0)
            {
                @* The office's own Delinquent (₱) and Whole Year Rental are not saved — arrears are computed from the
                   term and the payments, and whole-year rental is derived — so storing them would state the same money
                   twice. They are checked instead, which is the reconciliation the office does by hand, and this is
                   where the N × 12 error announced itself: a three-year term stating 37 months' rent.

                   Only impossibilities are raised. An import carries no payment history, so a figure LOWER than the
                   term supports is exactly what a part-paid account looks like and is never questioned. *@
                <div class="imp-continue-note imp-takeover-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    <span>
                        @_sheetQueries.Count @(_sheetQueries.Count == 1 ? "figure on this sheet cannot" : "figures on this sheet cannot")
                        be right for the term beside @(_sheetQueries.Count == 1 ? "it" : "them"). Worth checking before
                        you save — the import records the term and the rent, and works the balance out itself, so
                        nothing here is imported either way:
                        <ul class="imp-query-list">
                            @foreach (var q in _sheetQueries)
                            {
                                <li>Row @q.RowNumber · @q.Occupant — @q.Message</li>
                            }
                        </ul>
                    </span>
                </div>
            }

            @if (_takeovers.Count > 0)
            {
                @* A number the office has vacated is reused rather than skipped, which means the space changes
                   hands on import: the previous occupancy is ended and its payor links revoked. The office is
                   told which spaces before saving, not after. *@
                <div class="imp-continue-note imp-takeover-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    <span>
                        @_takeovers.Count @(_takeovers.Count == 1 ? "row lands" : "rows land") on a space the office
                        has vacated, so importing hands @(_takeovers.Count == 1 ? "it" : "them") to the lessee on
                        this sheet — the previous account keeps its records but stops here, and its payor login is
                        revoked:
                        <strong>@string.Join(", ", _takeovers.OrderBy(t => t.Key).Select(t => $"#{t.Key} (was {(string.IsNullOrWhiteSpace(t.Value) ? "vacant" : t.Value)})"))</strong>.
                    </span>
                </div>
            }

            <div class="imp-table-wrap">
                <table class="imp-table">
                    <thead>
                        <tr>
                            <th class="imp-th-num">#</th>
                            @foreach (var c in _facility.Columns)
                            {
                                <th style="@($"min-width:{c.MinWidth}px")">@c.Label</th>
                            }
                            <th class="imp-th-act"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _rows.Count; i++)
                        {
                            var row = _rows[i];
                            var rowIndex = i;
                            <tr>
                                <td class="imp-td-num">@(rowIndex + 1)</td>
                                @foreach (var c in _facility.Columns)
                                {
                                    var col = c;
                                    <td>
                                        @if (col.Type == "select")
                                        {
                                            <div class="imp-select-wrap">
                                                <select class="imp-cell imp-cell-select"
                                                        value="@GetCell(row, col.Key)"
                                                        @onchange="e => SetCell(row, col.Key, e.Value?.ToString())">
                                                    <option value=""></option>
                                                    @foreach (var opt in col.Options)
                                                    {
                                                        <option value="@opt">@opt</option>
                                                    }
                                                </select>
                                                <svg class="imp-select-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                                            </div>
                                        }
                                        else
                                        {
                                            @* The stall-number box is named so a test can read it without counting
                                               columns. Selecting cells by position is what failed a deployment once.
                                               CellHook does the same for the rest, so every column can be reached by
                                               name rather than by index.

                                               A space the office does not number shows its identifier but does not
                                               let it be typed over. The identifier is the system's own: it is what
                                               the occupancy is keyed, linked and routed on, and editing "SP-2" into
                                               anything else would either collide with the facility's numbering or
                                               leave the row identified by nothing. The basis is changed in the
                                               contract column, and the identifier follows from it. *@
                                            var isSpaceIdentifier = col.Key == "stallNo" && !RowIsContracted(row);
                                            <input class="imp-cell @(col.Type == "number" ? "imp-cell-num" : "") @CellHook(col.Key) @(isSpaceIdentifier ? "imp-cell-locked" : "") @(col.Key == "occupant" && OccupantExists(GetCell(row, col.Key)) ? "imp-cell-dup" : "")"
                                                   type="@(col.Type == "date" ? "date" : col.Type == "number" ? "number" : "text")"
                                                   value="@GetCell(row, col.Key)"
                                                   placeholder="@col.Placeholder"
                                                   readonly="@isSpaceIdentifier"
                                                   tabindex="@(isSpaceIdentifier ? "-1" : null)"
                                                   title="@(isSpaceIdentifier ? "The office issues no number for a space held without a signed contract. This identifier is the system's own; change the basis in the contract column instead." : col.Key == "occupant" && OccupantExists(GetCell(row, col.Key)) ? "This occupant is already an active stallholder in this facility." : null)"
                                                   @oninput="e => SetCell(row, col.Key, e.Value?.ToString())" />
                                        }
                                    </td>
                                }
                                <td class="imp-td-act">
                                    <button class="imp-row-del" title="Remove row" @onclick="() => RemoveRow(rowIndex)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2" /></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (_rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@(_facility.Columns.Count + 2)" class="imp-empty">
                                    No rows. Use “Add row” to start, or discard and upload again.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── Footer / Save ── -->
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="imp-save-error">@_saveError</div>
            }
            <div class="imp-foot-bar">
                <a class="imp-btn imp-btn-ghost" href="@BackUrl">Cancel</a>
                <button class="imp-btn imp-btn-primary" @onclick="SaveAsync" disabled="@(_rows.Count == 0 || _saving)">
                    @if (_saving)
                    {
                        <span class="imp-btn-spin"></span>
                        <text>Importing…</text>
                    }
                    else
                    {
                        <text>Save @_rows.Count stallholder@(_rows.Count == 1 ? "" : "s")</text>
                    }
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Facility { get; set; } = string.Empty;

    /// <summary>
    /// The importable facilities, named as the office names them. This sentence listed the platform's canonical
    /// codes, so an office was told to import into facilities it does not call by those names.
    /// </summary>
    private string ImportableFacilityList
    {
        get
        {
            var names = Configs.Values
                .Select(c => c.Code)
                .Distinct()
                .Select(code => FacilityCatalog.ShortNameOf(code))
                .ToList();
            return names.Count > 1
                ? string.Join(", ", names.Take(names.Count - 1)) + " and " + names[^1]
                : string.Concat(names);
        }
    }

    private FacilityImportConfig? _facility;
    private List<Dictionary<string, string>> _rows = new();
    private bool _loaded;
    private bool _saved;
    private string _fileName = string.Empty;
    private string? _uploadError;
    private string? _section;   // NPM only — chosen before upload (each section is a separate sheet)
    private bool _saving;
    private BulkImportResultDto? _result;
    private string? _saveError;

    // Auto-continue stall numbering: when imported numbers would collide with the facility's existing
    // stalls, renumber the batch to continue after the current highest number so nothing conflicts.
    private int _existingMax;
    /// <summary>Highest ordinal already used by the facility's un-numbered spaces, so a batch continues that series
    /// rather than spending a stall number.</summary>
    private int _existingSpaceMax;
    /// <summary>How many rows in this batch were given a space identifier rather than a stall number, so the note can
    /// tell the office that happened instead of leaving it to be discovered in the table.</summary>
    private int _numberedSpaces;
    /// <summary>Rows whose stall number clashed with an active stall or an earlier row, so they were given another.</summary>
    private int _renumberedClash;
    /// <summary>Rows that arrived with no stall number and were given the next free one.</summary>
    private int _numberedBlank;

    /// <summary>
    /// The rows whose Stall / Space No. was handed out by THIS SCREEN rather than written on the office's list.
    /// Only these may be re-sequenced when a row is added or removed; the office's numbers are never moved.
    /// Reference identity, so editing a row's cells does not change its provenance.
    /// </summary>
    private readonly HashSet<Dictionary<string, string>> _screenAssigned = new();

    /// <summary>
    /// The rows whose Whole Year Rental THIS SCREEN derives, rather than reading it off the office's list.
    ///
    /// <para>Only rows invented here qualify. On an uploaded row the stated whole-year is the office's own figure and
    /// the evidence the reconciliation check runs against - deriving it would make that check compare a number with
    /// itself and always agree, quietly retiring the safeguard that caught a three-year term stating 37 months' rent.
    /// A row typed in on this screen has no paper behind it, so there is nothing to reconcile and nothing to protect.</para>
    ///
    /// <para>Deliberately NOT <see cref="_screenAssigned"/>, which looks like the same idea: that set is cleared and
    /// rebuilt by every numbering pass, so provenance recorded in it would not survive adding a row.</para>
    ///
    /// <para>Reference identity, so editing a row's cells does not change its provenance.</para>
    /// </summary>
    private readonly HashSet<Dictionary<string, string>> _derivedWholeYear = new();

    /// <summary>Numbers held by active stalls in this facility, kept so a removal can re-sequence without asking the
    /// server again.</summary>
    private HashSet<string> _activeNumbers = new(StringComparer.OrdinalIgnoreCase);
    private bool _autoContinued;
    private bool _autoContinuedClashed;
    // Occupant names already active in this facility — used to flag likely-duplicate imports (informational only).
    private readonly HashSet<string> _existingOccupants = new(StringComparer.OrdinalIgnoreCase);
    // Stall number → the lessee who last held it, for numbers this file would take over from a vacated space.
    private readonly Dictionary<string, string> _takeovers = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>A figure on the office's sheet that the term beside it cannot support.</summary>
    private sealed record SheetQuery(int RowNumber, string Occupant, string Message);

    /// <summary>
    /// Queries raised against the sheet's own Delinquent (₱) and Whole Year Rental figures. Neither is imported —
    /// arrears are computed from the term and the payments, and whole-year rental is derived — so these are a check,
    /// not an input, and raising them can never change what is saved.
    /// </summary>
    private readonly List<SheetQuery> _sheetQueries = new();

    // The facility's own page, by its canonical route — the one the sidebar links to and the browser shows. Cancel
    // and the back arrow both land there rather than on whatever page happened to come before, so leaving an import
    // always returns to the facility being imported into.
    private string BackUrl => _facility is null ? "/menu" : $"/facility/{_facility.ShortCode.ToLower()}";

    protected override async Task OnParametersSetAsync()
    {
        _facility = Configs.TryGetValue((Facility ?? string.Empty).Trim().ToLowerInvariant(), out var cfg) ? cfg : null;
        if (RequiresSection)
        {
            await LoadNpmRatesAsync();
            await LoadCustomSectionsAsync();
        }
    }

    // Tenant-resolved NPM daily + fish rates (₱30 / ₱1 ordinance fallback keeps Cantilan identical), shown
    // in the section-picker descriptions. Loaded once.
    private decimal _npmDailyRate = 30m;
    private decimal _npmFishRate = 1m;
    private bool _ratesLoaded;

    private async Task LoadNpmRatesAsync()
    {
        if (_ratesLoaded) return;
        var result = await StallsApi.GetNpmRatesAsync();
        if (result.IsSuccess && result.Value is not null)
        {
            _npmDailyRate = result.Value.DailyRate;
            _npmFishRate = result.Value.FishRate;
        }
        _ratesLoaded = true;
    }

    /// <summary>
    /// The office's own name for one of the three collection areas, given the canonical key these options carry.
    /// The KEY is what the upload is filed under and what the server is told, so it does not move; only the words
    /// on the card do. A per-LGU custom section already carries its own name and is returned unchanged.
    /// </summary>
    private string SectionOptionLabel(string? sectionKey) =>
        MapSection(sectionKey) is { } section
            ? FacilityCatalog.SectionLabelOf(FacilityCode.NPM, section)
            : (sectionKey ?? string.Empty);

    // Section-option description with the tenant's resolved rate appended (Fish adds the per-kilo fee). The area is
    // named as the office names it; "Vegetable stalls" was this platform's wording on another municipality's screen.
    private string SectionDesc(NpmSectionOption sec) =>
        $"{SectionOptionLabel(sec.Name)} stalls · ₱{_npmDailyRate:0}/day" + (sec.Name == "Fish" ? $" + ₱{_npmFishRate:0}/kg" : "");

    // Per-LGU custom NPM sections offered as import targets (in addition to Vegetable/Fish/Meat).
    private List<string> _customSections = new();
    private const string CustomSectionIconSvg = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='7' rx='1'/><rect x='14' y='3' width='7' height='7' rx='1'/><rect x='3' y='14' width='7' height='7' rx='1'/><rect x='14' y='14' width='7' height='7' rx='1'/></svg>";

    private async Task LoadCustomSectionsAsync()
    {
        var result = await FacilitiesApi.GetNpmCustomSectionsAsync();
        if (result.IsSuccess && result.Value is not null)
            _customSections = result.Value.Select(c => c.Name).ToList();
    }

    private string StepClass(int step)
    {
        var current = _saved ? 3 : _loaded ? 2 : 1;
        if (step < current) return "done";
        if (step == current) return "active";
        return string.Empty;
    }

    private static string GetCell(Dictionary<string, string> row, string key)
        => row.TryGetValue(key, out var v) ? v : string.Empty;

    /// <summary>
    /// A stable class per column, so a cell can be found by the name of its column instead of its position in the row.
    /// <c>imp-stallno</c> keeps the name it already had, because tests and stylesheets refer to it.
    /// </summary>
    private static string CellHook(string key) => key switch
    {
        "stallNo" => "imp-stallno",
        _ => "imp-col-" + key.ToLowerInvariant(),
    };

    private void SetCell(Dictionary<string, string> row, string key, string? value)
    {
        row[key] = value ?? string.Empty;

        // Typing a number makes it the office's, not this screen's. Without this, a number the clerk entered into a
        // row the screen had numbered would be re-sequenced away the next time a row was added or removed - the
        // screen would quietly overwrite what they had just typed, which is the same fault as renumbering an
        // uploaded list, only slower to notice.
        if (key == "stallNo") _screenAssigned.Remove(row);

        // The same rule for the whole-year figure: once the clerk states it themselves, this screen stops deriving it
        // and never writes over it again. Otherwise the next keystroke in the rent column would erase what they typed.
        if (key == "wholeYear") _derivedWholeYear.Remove(row);

        // Twelve months of the rent, kept in step as the rent is typed - on rows this screen derives it for. The office
        // does this multiplication by hand on every list; there is no reason to ask them to do it again for a row they
        // are inventing here, and no reason for them to be queried about their own arithmetic on it.
        if (key is "monthly" or "actualMonthly") DeriveWholeYear(row);
    }

    /// <summary>
    /// Writes twelve months of the row's rent into its Whole Year Rental cell, when that cell is this screen's to fill.
    ///
    /// <para>The rent it multiplies is the ACTUAL monthly where one is stated, falling back to the contract rate - the
    /// same precedence the reconciliation check uses, so the derived figure agrees with the way the office reads the
    /// row. A row with no rent yet is left blank rather than reading ₱0.00, which would state a figure nobody meant.</para>
    /// </summary>
    private void DeriveWholeYear(Dictionary<string, string> row)
    {
        if (!_derivedWholeYear.Contains(row)) return;

        var monthly = SheetNumber.ToDecimal(GetCell(row, "actualMonthly")) is { } am && am > 0m
            ? am
            : SheetNumber.ToDecimal(GetCell(row, "monthly")) ?? 0m;

        row["wholeYear"] = monthly > 0m
            ? (monthly * 12m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;
    }

    // NPM imports one section at a time (each section is a separate physical list).
    private bool RequiresSection => _facility?.ShortCode == "NPM";
    private bool NeedsSection => RequiresSection && string.IsNullOrEmpty(_section);
    // A chosen section that isn't one of the canonical three is a per-LGU custom section.
    private bool IsCustomSectionChosen => RequiresSection && !string.IsNullOrEmpty(_section) && MapSection(_section) is null;
    // Daily fee rate for a custom-section import (0 = let the server use the section's existing rate or ₱30).
    private decimal _customDailyRate = 0m;
    // Utility applicability chosen for the whole import batch (NPM only) — stamps Electricity/Water onto
    // every newly created stall in this import.
    private bool _applyElectricity;
    private bool _applyWater;
    private string SectionSuffix => string.IsNullOrEmpty(_section) ? string.Empty : $" · {SectionOptionLabel(_section)}";

    private void ChooseSection(string section) => _section = section;

    private void ChangeSection()
    {
        _section = null;
        _rows = new();
        _derivedWholeYear.Clear();
        _loaded = false;
        _fileName = string.Empty;
        _uploadError = null;
        _autoContinued = false;
        _autoContinuedClashed = false;
        _numberedSpaces = 0;
        _renumberedClash = 0;
        _numberedBlank = 0;
        _existingMax = 0;
        _existingSpaceMax = 0;
        _existingOccupants.Clear();
        _takeovers.Clear();
        _sheetQueries.Clear();
    }

    public record NpmSectionOption(string Name, string Css, string Icon);

    private static readonly List<NpmSectionOption> NpmSections = new()
    {
        new("Vegetable", "veg",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2c0 0-1 3-1 6s1 5 1 5'/><path d='M12 13s-4-2-7-1c1 4 4 6 7 6s6-2 7-6c-3-1-7 1-7 1z'/><path d='M9 4c-2 1-3 3-3 5'/><path d='M15 4c2 1 3 3 3 5'/></svg>"),
        new("Fish", "fish",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M2 12c0 0 3-5 8-5s8 2 8 2l3-4v10l-3-4s-3 2-8 2-8-5-8-5z'/><circle cx='14' cy='11' r='1' fill='currentColor' stroke='none'/></svg>"),
        new("Meat", "meat",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M4 14c-1-2-.5-5 1.5-7s5-2.5 7.5-1.5 5 1 6 3-.5 4.5-2.5 5.5-4.5 1-7 .5S5 16 4 14z'/><path d='M10 11c-.5-1 0-2.5 1.5-3s3 0 3.5 1.5-1 3-2.5 3-2.5-.5-2.5-1.5z'/></svg>"),
    };

    /// <summary>
    /// What the office writes in the contract column for a space it lets without a signed contract. The basis is
    /// read back from this cell by <see cref="ArrangementFromContractCell"/>, which is why a row added for such a
    /// space has to carry it: an empty cell reads as a signed contract, and the numbering then issues the space one
    /// of the facility's stall numbers.
    /// </summary>
    private const string SpaceOnlyContractCell = "No contract (space only)";

    /// <summary>
    /// Whether this row is a stall held under a signed contract, which is what decides whether the office issues it a
    /// number at all. Read from the row's own contract column, so it follows the basis the office typed there.
    /// </summary>
    private bool RowIsContracted(Dictionary<string, string> row) =>
        ArrangementFromContractCell(GetCell(row, "contractName")) == OccupancyArrangement.SignedContract;

    private void AddRow(bool spaceOnly = false)
    {
        if (_facility is null) return;
        var row = NewRow(_facility);

        // A space held without a signed contract is not numbered by the office. Saying so in the row's own contract
        // column is what makes the shared numbering rule hand it a space identifier instead of the facility's next
        // stall number — which is what a blank cell got, because blank means "per signed contract".
        if (spaceOnly) row["contractName"] = SpaceOnlyContractCell;

        _rows.Add(row);

        // Invented here, so its whole-year is this screen's to work out from the rent as it is typed. An uploaded row
        // never joins this set: there the figure is the office's own, and the check against it is the point.
        _derivedWholeYear.Add(row);

        // Its number is this screen's to give, and to move again if a row is later removed. Allocated through the
        // shared rule so it steps over the office's own numbers instead of colliding with one.
        _screenAssigned.Add(row);
        ResequenceAssignedNumbers();
    }

    private static int ParseStallInt(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return 0;
        // An un-numbered space carries its own series and is NOT part of the facility's numbering, so it must not push
        // the counter: reading "SP-4" as 4 would make the next contracted stall number 5 while stalls 1 to 4 stood
        // empty — the same theft as before, in the opposite direction.
        if (SpaceNumber.IsSpace(value)) return 0;
        var m = System.Text.RegularExpressions.Regex.Match(value, @"\d+");
        return m.Success && int.TryParse(m.Value, out var n) ? n : 0;
    }

    // Case-insensitive, whitespace-collapsed name key so "Juan  Dela Cruz" and "juan dela cruz" match.
    private static string NormalizeName(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : System.Text.RegularExpressions.Regex.Replace(value.Trim(), @"\s+", " ");

    // True when an ACTIVE stallholder with this exact (normalized) name already exists in the facility.
    // Informational only — a person may legitimately hold more than one stall, so this never blocks saving.
    private bool OccupantExists(string? name)
    {
        var n = NormalizeName(name);
        return n.Length > 0 && _existingOccupants.Contains(n);
    }

    // Renumber the batch to continue after the facility's current highest stall number — but only when
    // an imported number would actually collide (existing number, blank, or an in-file duplicate).
    // Non-conflicting files keep their own numbers. The admin can still edit any cell afterward, and the
    // server's per-row uniqueness check remains the final guard.
    private async Task ApplyContinuedNumberingAsync()
    {
        _autoContinued = false;
        _autoContinuedClashed = false;
        _numberedSpaces = 0;
        _renumberedClash = 0;
        _numberedBlank = 0;
        _existingMax = 0;
        _existingSpaceMax = 0;
        _existingOccupants.Clear();
        _takeovers.Clear();
        _sheetQueries.Clear();
        if (_facility is null || _rows.Count == 0) return;

        try
        {
            var section = RequiresSection ? MapSection(_section) : null;
            var res = await StallsApi.GetStallHoldersListAsync(_facility.Code, section);
            if (!res.IsSuccess || res.Value is null) return;

            var existing = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            // Vacated numbers and who last held them, so the preview can say which spaces this file takes over.
            var vacated = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var r in res.Value.Sections.SelectMany(s => s.Rows))
            {
                var sn = (r.StallNo ?? string.Empty).Trim();

                // Expired (term lapsed) or closed stalls are VACANT/reusable — their numbers are free for the
                // import to reuse (the server renews the same stall). Only ACTIVE stalls block a number or
                // push the continue-from counter, matching the import's create-vs-renew rule. This is why a
                // fresh batch reuses the vacated slots instead of jumping past every historical number.
                //
                // The shared rule is used rather than the arithmetic written out again, because the hand-written form
                // omitted the open-ended case: a space let WITHOUT a contract carries a term of zero years, so
                // "today is past effectivity + 0 years" was true of every one of them and the Iceplant and barbecue
                // spaces — which are all let this way, and all still occupied — were read as vacant and their numbers
                // offered up for reuse.
                var expired = DomainRules.TermHasExpired(r.EffectivityDate, r.DurationYears, PhilippineTime.Today);
                var reusable = r.IsClosed || expired;
                if (reusable)
                {
                    if (sn.Length > 0) vacated[sn] = r.ActualOccupant ?? string.Empty;
                    continue;
                }

                if (sn.Length > 0) existing.Add(sn);
                _existingMax = Math.Max(_existingMax, ParseStallInt(sn));
                // The two series are tracked apart, so a batch of un-numbered spaces continues SP-n and leaves the
                // facility's stall numbers alone.
                _existingSpaceMax = Math.Max(_existingSpaceMax, SpaceNumber.HighestOrdinal(new[] { sn }));

                // Flag likely duplicates only against genuinely active stallholders (the server skips these).
                var on = NormalizeName(r.ActualOccupant);
                if (on.Length > 0) _existingOccupants.Add(on);
            }

            // What must change, row by row. A number the office supplied and that does not clash is KEPT: the whole
            // batch used to be rewritten from the facility's highest number the moment any single cell was blank,
            // duplicated, or already taken, so one bad cell in a mixed list silently renumbered every other row —
            // overwriting the physical stall numbers the office's collections are keyed on.
            AssignBatchNumbers(existing);

            _autoContinued = _renumberedClash > 0 || _numberedBlank > 0 || _numberedSpaces > 0;
            _autoContinuedClashed = _renumberedClash > 0;

            CheckSheetFigures();
            NoteTakeovers(vacated);
            _autoContinued = true;
            NoteTakeovers(vacated);
        }
        catch
        {
            // If the lookup fails, keep the file's numbers as-is; the server still validates uniqueness.
        }
    }

    /// <summary>
    /// Records which rows land on a number the office has vacated. Importing such a row hands that space to the
    /// lessee on the sheet — the previous occupancy is ended and its payor links revoked, exactly as the Add Vendor
    /// takeover does — so the preview says so before anything is saved rather than reporting it afterwards.
    /// </summary>
    /// <summary>
    /// Raises a query against the sheet's own Delinquent (₱) and Whole Year Rental figures where the term beside them
    /// cannot support what they state.
    ///
    /// <para>Neither figure is imported. Arrears are computed from the term and the payments recorded against it, and
    /// whole-year rental is derived from the rent, so storing either would state the same money twice — a stated arrears
    /// figure would be added ON TOP of what the system already calculates for those months. Checking them costs
    /// nothing and is the reconciliation the office does by hand.</para>
    ///
    /// <para>Only impossibilities are raised. An import carries no payment history, so a figure LOWER than the term
    /// supports is exactly what a part-paid account looks like and is never questioned; an office warned wrongly stops
    /// reading warnings.</para>
    /// </summary>
    private void CheckSheetFigures()
    {
        _sheetQueries.Clear();

        for (var i = 0; i < _rows.Count; i++)
        {
            var row = _rows[i];
            var occupant = GetCell(row, "occupant");
            if (string.IsNullOrWhiteSpace(occupant)) continue;

            var signed = ArrangementFromContractCell(GetCell(row, "contractName")) == OccupancyArrangement.SignedContract;
            var monthly = SheetNumber.ToDecimal(GetCell(row, "actualMonthly")) is { } am && am > 0m
                ? am
                : SheetNumber.ToDecimal(GetCell(row, "monthly")) ?? 0m;

            // Whole-year rental is derived from the rent, so a disagreement means one of the two numbers on the row is
            // wrong — the arithmetic slip that stays invisible until the year is totalled.
            var statedWholeYear = SheetNumber.ToDecimal(GetCell(row, "wholeYear")) ?? 0m;
            if (SheetReconciliation.WholeYearDisagreesWithMonthly(statedWholeYear, monthly))
            {
                _sheetQueries.Add(new SheetQuery(i + 1, occupant,
                    $"whole year states {Peso(statedWholeYear)}, but twelve months at {Peso(monthly)} is {Peso(monthly * 12)}"));
            }

            // Arrears are only checkable against a term. An open-ended space has none, so nothing is asserted.
            if (!signed) continue;

            var statedArrears = SheetNumber.ToDecimal(GetCell(row, "delinquent")) ?? 0m;
            var years = int.TryParse(SheetNumber.Normalize(GetCell(row, "years")), out var y) ? y : 0;
            if (!DateOnly.TryParse(NormalizeDate(GetCell(row, "effectivity")),
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var effectivity))
                continue;

            if (SheetReconciliation.ArrearsExceedsWhatTermCouldBill(
                    statedArrears, effectivity, years, monthly, PhilippineTime.Today))
            {
                var ceiling = SheetReconciliation.MaximumBillableToDate(
                    effectivity, years, monthly, PhilippineTime.Today);
                _sheetQueries.Add(new SheetQuery(i + 1, occupant,
                    $"delinquent states {Peso(statedArrears)}, but this term can have billed at most {Peso(ceiling)} so far"));
            }
        }
    }

    private static string Peso(decimal amount) =>
        "₱" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private void NoteTakeovers(Dictionary<string, string> vacated)
    {
        _takeovers.Clear();
        if (vacated.Count == 0) return;

        foreach (var row in _rows)
        {
            var sn = GetCell(row, "stallNo").Trim();
            if (sn.Length > 0 && vacated.TryGetValue(sn, out var previous))
                _takeovers[sn] = previous;
        }
    }

    private void RemoveRow(int index)
    {
        if (index < 0 || index >= _rows.Count) return;
        var removed = _rows[index];
        _rows.RemoveAt(index);
        _screenAssigned.Remove(removed);
        _derivedWholeYear.Remove(removed);

        // Only the numbers this screen handed out are closed up. The office's own numbers stay exactly as written -
        // renumbering the whole batch is what once overwrote the physical stall numbers a facility is keyed on.
        ResequenceAssignedNumbers();
    }

    /// <summary>
    /// Gives a number to the rows that need one, and leaves alone every number the office supplied.
    ///
    /// <para>This used to rewrite the WHOLE batch from the facility's highest number as soon as any single cell was
    /// blank, duplicated, or already taken. The office's own lists are routinely mixed — numbered stalls beside
    /// un-numbered spaces — so one blank cell renumbered every other row in the file. On a second or partial import
    /// into a populated facility that silently overwrote the physical stall numbers its collections are keyed on.</para>
    ///
    /// <para>Now each row is decided on its own: a space the office does not number takes the space series whatever
    /// the cell says, a blank or clashing stall number is given the next free one, and anything else is the office's
    /// number and is kept exactly as written.</para>
    /// </summary>
    /// <param name="activeNumbers">
    /// Numbers held by stalls that are still active. Vacated numbers — closed or lapsed — are deliberately absent, so
    /// a row reclaiming one is treated as the office renewing that stall rather than as a clash.
    /// </param>
    private void AssignBatchNumbers(HashSet<string> activeNumbers)
    {
        // Kept so a later removal can re-sequence without asking the server again.
        _activeNumbers = new HashSet<string>(activeNumbers, StringComparer.OrdinalIgnoreCase);

        var decisions = ImportNumbering.Assign(
            _rows.Select(r => (
                SuppliedStallNo: (string?)GetCell(r, "stallNo"),
                HasSignedContract: ArrangementFromContractCell(GetCell(r, "contractName")) == OccupancyArrangement.SignedContract)),
            activeNumbers,
            _existingMax,
            _existingSpaceMax);

        _renumberedClash = 0;
        _numberedBlank = 0;
        _numberedSpaces = 0;
        _screenAssigned.Clear();

        for (var i = 0; i < _rows.Count; i++)
        {
            var decision = decisions[i];
            _rows[i]["stallNo"] = decision.StallNo;

            // Whose number this is. Anything other than Kept was handed out by this screen, so it may be
            // re-sequenced later; a Kept number is the office's and must never be moved.
            if (decision.Outcome != NumberingOutcome.Kept)
                _screenAssigned.Add(_rows[i]);

            switch (decision.Outcome)
            {
                case NumberingOutcome.RenumberedClash: _renumberedClash++; break;
                case NumberingOutcome.NumberedBlank: _numberedBlank++; break;
                case NumberingOutcome.NumberedSpace: _numberedSpaces++; break;
            }
        }
    }

    /// <summary>
    /// Re-numbers only the rows this screen handed a number to, keeping them contiguous after a row is added or
    /// removed.
    ///
    /// <para>Numbers the office supplied are left exactly as written, which is the whole point: renumbering the
    /// entire batch is what once overwrote the physical stall numbers a facility's collections are keyed on. But
    /// leaving OUR OWN numbers with a hole in them after a deletion is just untidy, and reads as a fault.</para>
    /// </summary>
    private void ResequenceAssignedNumbers()
    {
        if (_screenAssigned.Count == 0) return;

        var decisions = ImportNumbering.Assign(
            _rows.Select(r => (
                // Ours are offered as blank so they are handed out afresh, in list order; the office's are supplied
                // so they are kept and, just as importantly, reserved before anything else is allocated.
                SuppliedStallNo: _screenAssigned.Contains(r) ? null : (string?)GetCell(r, "stallNo"),
                HasSignedContract: ArrangementFromContractCell(GetCell(r, "contractName")) == OccupancyArrangement.SignedContract)),
            _activeNumbers,
            _existingMax,
            _existingSpaceMax);

        for (var i = 0; i < _rows.Count; i++)
        {
            if (decisions[i].Outcome == NumberingOutcome.Kept) continue;
            _rows[i]["stallNo"] = decisions[i].StallNo;
            _screenAssigned.Add(_rows[i]);
        }
    }

    private static Dictionary<string, string> NewRow(FacilityImportConfig cfg)
    {
        var row = new Dictionary<string, string>();
        foreach (var c in cfg.Columns) row[c.Key] = c.Default;
        return row;
    }

    private async Task LoadSample()
    {
        if (_facility is null) return;
        _fileName = string.Empty;
        _uploadError = null;
        _rows = _facility.Sample.Select(r => new Dictionary<string, string>(r)).ToList();

        // The sample states its own whole-year figures, because it teaches the FORMAT of the office's list - including
        // that column. Nothing here is derived, so the sample reads exactly like a sheet.
        _derivedWholeYear.Clear();

        _loaded = true;
        await ApplyContinuedNumberingAsync();

        // The sample's numbers are THIS SCREEN'S, not the office's. Nobody wrote them on a list, so there is no
        // physical stall behind them to protect and no reason for a deletion to leave a hole - which is what made
        // the sample look broken while an uploaded file was behaving exactly as it must.
        //
        // The distinction is the point: a number from an uploaded file is kept because stall 103 is a place, and
        // renumbering 104 down to it would hand the next lessee somebody else's stall. A number from the sample is
        // ours, so it closes up.
        foreach (var row in _rows) _screenAssigned.Add(row);
        ResequenceAssignedNumbers();
    }

    /// <summary>
    /// Starts the review table empty, for an office with no file to upload — a few stalls typed straight from its
    /// records. One blank row so there is somewhere to type immediately; "Add row" provides the rest, and the same
    /// review table checks them, so there is one way to enter a batch rather than two.
    /// </summary>
    private async Task StartManual()
    {
        if (_facility is null) return;
        _fileName = "Entered by hand";
        _uploadError = null;
        var first = NewRow(_facility);
        _rows = new List<Dictionary<string, string>> { first };

        // The starting row is entered by hand like every row that follows it, so it derives its whole-year the same way.
        _derivedWholeYear.Clear();
        _derivedWholeYear.Add(first);

        _loaded = true;
        await ApplyContinuedNumberingAsync();
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        if (_facility is null) return;
        _uploadError = null;
        var file = e.File;
        if (file is null) return;
        _fileName = file.Name;

        try
        {
            List<string[]> rawRows;

            if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                using var rs = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await rs.CopyToAsync(ms);
                ms.Position = 0;
                rawRows = ReadXlsx(ms);
            }
            else if (file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                rawRows = ReadCsv(await reader.ReadToEndAsync());
            }
            else if (file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase))
            {
                _uploadError = "The old .xls format isn't supported. Please save it as .xlsx or .csv and upload again.";
                return;
            }
            else
            {
                _uploadError = "Unsupported file type. Please upload a .csv or .xlsx file.";
                return;
            }

            var rows = MapRows(rawRows, _facility, RequiresSection ? _section : null);
            if (rows.Count == 0)
            {
                _uploadError = "No stallholder rows were found in that file. Make sure it has the columns shown below and try again.";
                return;
            }

            _rows = rows;

            // Every row here came off the office's list, so every whole-year figure on screen is theirs. None is
            // derived, which is what keeps the reconciliation check meaningful.
            _derivedWholeYear.Clear();

            _loaded = true;
            await ApplyContinuedNumberingAsync();
        }
        catch (Exception)
        {
            _uploadError = "Couldn't read that file. Make sure it's a valid .csv or .xlsx export and try again.";
        }
    }

    // Maps parsed rows to the facility's columns. Prefers the FILE'S OWN HEADER when it is one we recognise, and falls
    // back to position when it is not. Built to tolerate "printable report" layouts: it skips title/section banners
    // (single-cell rows), the column-header row, and total rows; normalizes dates and numbers; strips leading "1."
    // numbering from names; and, for NPM, keeps only the rows under the section the user chose (when the file has
    // section banners).
    //
    // WHY THE HEADER MATTERS: matching by position alone is correct only while two facilities carry the same columns.
    // NPM, TCC, BBQ and ICE do, so a file prepared for one maps onto another. NCC does not — it carries "Area Loc."
    // ninth, before Delinquent — so an NPM or TCC file read positionally put a money figure into Area Loc. and left
    // Delinquent empty, silently. Reading the header fixes that for any file that has one, and the office's printed
    // reports, whose headings are their own wording, keep the positional behaviour they always had.
    private static List<Dictionary<string, string>> MapRows(List<string[]> raw, FacilityImportConfig cfg, string? targetSection)
    {
        var staged = new List<(string? Section, Dictionary<string, string> Row)>();
        string? currentSection = null;
        var sawBanner = false;
        int[]? headerMap = null;

        foreach (var cells in raw)
        {
            if (cells.Length == 0 || cells.All(string.IsNullOrWhiteSpace)) continue;

            var nonEmpty = cells.Where(c => !string.IsNullOrWhiteSpace(c)).ToArray();

            // Single-cell rows are titles/section banners (e.g. "NEW PUBLIC MARKET", "VEGETABLE AREA").
            if (nonEmpty.Length <= 1)
            {
                var sec = MatchSection(nonEmpty.Length == 1 ? nonEmpty[0] : string.Empty);
                if (sec is not null) { currentSection = sec; sawBanner = true; }
                continue;
            }

            // Column-header rows and TOTAL/sub-total rows are not data. A header is read for its column order first,
            // which is the one useful thing in it.
            if (IsNoiseRow(cells))
            {
                headerMap ??= HeaderMap(cells, cfg);
                continue;
            }

            var row = NewRow(cfg);
            for (var i = 0; i < cells.Length; i++)
            {
                var colIndex = headerMap is null
                    ? (i < cfg.Columns.Count ? i : -1)
                    : (i < headerMap.Length ? headerMap[i] : -1);
                if (colIndex < 0) continue;

                var col = cfg.Columns[colIndex];
                var val = (cells[i] ?? string.Empty).Trim();
                if (col.Key == "occupant") val = StripLeadingIndex(val);
                else if (col.Type == "date") val = NormalizeDate(val);
                else if (col.Type == "number") val = NormalizeNumber(val);
                row[col.Key] = val;
            }

            // A real row must have an occupant name.
            if (string.IsNullOrWhiteSpace(GetCell(row, "occupant"))) continue;

            staged.Add((currentSection, row));
        }

        // NPM: when the file is a full report with section banners, keep only the chosen section.
        // But if that yields nothing (e.g. a single-section export whose banner doesn't match, or Fish/
        // Meat rows without a recognised banner), fall back to ALL data rows — the user already chose the
        // target section, and the UI promises "every row in the file you upload will be imported into it".
        IEnumerable<(string? Section, Dictionary<string, string> Row)> selected = staged;
        if (!string.IsNullOrEmpty(targetSection) && sawBanner)
        {
            var filtered = staged.Where(s => string.Equals(s.Section, targetSection, StringComparison.OrdinalIgnoreCase)).ToList();
            if (filtered.Count > 0)
                selected = filtered;
        }

        return selected.Select(s => s.Row).ToList();
    }

    private static string? MatchSection(string text)
    {
        var n = Norm(text);
        if (n.Length == 0) return null;
        if (n.Contains("vegetable")) return "Vegetable";
        if (n.Contains("fish")) return "Fish";
        if (n.Contains("meat")) return "Meat";
        return null;
    }

    private static readonly string[] HeaderKeywords =
    {
        "nameoflessee", "actualoccupant", "leasee", "lessee", "stallspaceno", "stallspace",
        "effectivity", "noofyears", "monthlyrental", "monthlyrentals", "actualmorental",
        "actualmorentals", "wholeyearrental", "delinquent", "arealoc"
    };

    // A header or total row (not stallholder data).
    private static bool IsNoiseRow(string[] cells)
    {
        var joined = Norm(string.Join(" ", cells));
        if (joined.Contains("total")) return true;
        var hits = cells.Count(c =>
        {
            var n = Norm(c);
            return n.Length > 2 && HeaderKeywords.Any(h => n.Contains(h));
        });
        return hits >= 2;
    }

    /// <summary>
    /// Reads a header row into "file column i holds the facility's column n", or null when the row is not a header of
    /// ours.
    ///
    /// <para>
    /// Matching is on the label reduced to letters and digits, so "Delinquent (₱)" and "DELINQUENT ( ₱ )" are the same
    /// heading and Excel's own truncation of what it DISPLAYS is irrelevant. A prefix match catches a sheet that
    /// shortened a heading by hand. Three recognised columns are required before the map is trusted: fewer than that and
    /// this is somebody else's sheet, where position is the better guess.
    /// </para>
    /// </summary>
    private static int[]? HeaderMap(string[] cells, FacilityImportConfig cfg)
    {
        var map = new int[cells.Length];
        var taken = new HashSet<int>();
        var matched = 0;

        for (var i = 0; i < cells.Length; i++)
        {
            map[i] = -1;
            var n = Norm(cells[i]);
            if (n.Length < 3) continue;

            var idx = cfg.Columns.FindIndex(c => Norm(c.Label) == n);
            if (idx < 0)
                idx = cfg.Columns.FindIndex(c =>
                {
                    var label = Norm(c.Label);
                    return label.Length >= 3 && (label.StartsWith(n) || n.StartsWith(label));
                });

            if (idx >= 0 && taken.Add(idx))
            {
                map[i] = idx;
                matched++;
            }
        }

        return matched >= 3 ? map : null;
    }

    // "1. Merlita A. Abuso" / "12) Name" -> "Merlita A. Abuso" / "Name".
    private static string StripLeadingIndex(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value, @"^\s*\d+\s*[\.\)]\s*", string.Empty);

    private static string NormalizeDate(string raw)
    {
        if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var serial)
            && serial > 59 && serial < 100000)
            return DateTime.FromOADate(serial).ToString("yyyy-MM-dd");
        if (DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt))
            return dt.ToString("yyyy-MM-dd");
        return raw;
    }

    // Pulls the first valid number out of a cell, ignoring currency symbols, thousands separators
    // and unit suffixes — e.g. "₱1,200.00" -> "1200.00", "4.8 sq.m." -> "4.8", "3 yrs" -> "3".
    // The rule lives in the domain (SheetNumber) so it can be tested: this is a money parser, and its previous
    // reading of "1.500,00" as 1.50 was a thousandfold under-billing that no test could reach from inside a page.
    private static string NormalizeNumber(string raw) => SheetNumber.Normalize(raw);

    private static string Norm(string s) => new((s ?? string.Empty).ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

    private static List<string[]> ReadCsv(string text)
    {
        var rows = new List<string[]>();
        var lines = text.Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;
            rows.Add(SplitCsvLine(line));
        }
        return rows;
    }

    // Splits a CSV line honoring double-quoted fields (which may contain commas and "" escapes).
    private static string[] SplitCsvLine(string line)
    {
        var cells = new List<string>();
        var sb = new StringBuilder();
        var inQuotes = false;
        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];
            if (ch == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') { sb.Append('"'); i++; }
                else inQuotes = !inQuotes;
            }
            else if (ch == ',' && !inQuotes) { cells.Add(sb.ToString().Trim()); sb.Clear(); }
            else sb.Append(ch);
        }
        cells.Add(sb.ToString().Trim());
        return cells.ToArray();
    }

    // Minimal .xlsx reader (no external dependency): reads the first worksheet's rows and resolves
    // shared strings. Cells are placed at their real column index from the A1-style cell reference.
    private static List<string[]> ReadXlsx(Stream stream)
    {
        var rows = new List<string[]>();
        using var zip = new ZipArchive(stream, ZipArchiveMode.Read);
        XNamespace ns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";

        var shared = new List<string>();
        var sst = zip.GetEntry("xl/sharedStrings.xml");
        if (sst is not null)
        {
            using var s = sst.Open();
            var doc = XDocument.Load(s);
            if (doc.Root is not null)
                foreach (var si in doc.Root.Elements(ns + "si"))
                    shared.Add(SiText(si, ns));
        }

        var sheetEntry = zip.Entries
            .Where(en => en.FullName.StartsWith("xl/worksheets/sheet", StringComparison.OrdinalIgnoreCase)
                      && en.FullName.EndsWith(".xml", StringComparison.OrdinalIgnoreCase))
            .OrderBy(en => en.FullName, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();
        if (sheetEntry is null) return rows;

        using var ss = sheetEntry.Open();
        var sheet = XDocument.Load(ss);
        var sheetData = sheet.Root?.Element(ns + "sheetData");
        if (sheetData is null) return rows;

        foreach (var row in sheetData.Elements(ns + "row"))
        {
            var map = new Dictionary<int, string>();
            var maxIdx = -1;
            foreach (var c in row.Elements(ns + "c"))
            {
                var colIdx = ColIndex((string?)c.Attribute("r") ?? string.Empty);
                var type = (string?)c.Attribute("t");
                string val;
                if (type == "s")
                {
                    val = int.TryParse(c.Element(ns + "v")?.Value, out var idx) && idx >= 0 && idx < shared.Count
                        ? shared[idx] : string.Empty;
                }
                else if (type == "inlineStr")
                {
                    val = c.Element(ns + "is") is XElement isEl ? SiText(isEl, ns) : string.Empty;
                }
                else
                {
                    val = c.Element(ns + "v")?.Value ?? string.Empty;
                }
                map[colIdx] = val;
                if (colIdx > maxIdx) maxIdx = colIdx;
            }

            if (maxIdx < 0) { rows.Add(Array.Empty<string>()); continue; }
            var arr = new string[maxIdx + 1];
            for (var i = 0; i <= maxIdx; i++) arr[i] = map.TryGetValue(i, out var v) ? v : string.Empty;
            rows.Add(arr);
        }
        return rows;
    }

    private static string SiText(XElement si, XNamespace ns)
    {
        var t = si.Element(ns + "t");
        if (t is not null) return t.Value;
        // Rich text: concatenate the <r><t> runs.
        return string.Concat(si.Elements(ns + "r").Select(r => r.Element(ns + "t")?.Value ?? string.Empty));
    }

    private static int ColIndex(string cellRef)
    {
        var idx = 0;
        foreach (var ch in cellRef)
        {
            if (char.IsLetter(ch)) idx = idx * 26 + (char.ToUpperInvariant(ch) - 'A' + 1);
            else break;
        }
        return Math.Max(0, idx - 1);
    }

    private async Task SaveAsync()
    {
        if (_facility is null || _rows.Count == 0 || _saving) return;
        _saving = true;
        _saveError = null;

        try
        {
            var command = new BulkImportStallholdersCommand(
                _facility.Code,
                RequiresSection ? MapSection(_section) : null,
                _rows.Select((r, i) => BuildRow(r, i + 1)).ToList(),
                // A custom section has no canonical MarketSection — carry its name so rows land in it.
                CustomSectionName: RequiresSection && MapSection(_section) is null && !string.IsNullOrEmpty(_section)
                    ? _section : null,
                CustomDailyRate: IsCustomSectionChosen && _customDailyRate > 0m ? _customDailyRate : null,
                // Utilities apply to NPM stalls only; the batch flags stamp them onto every new stall.
                ApplyElectricity: RequiresSection && _applyElectricity,
                ApplyWater: RequiresSection && _applyWater);

            var result = await StallsApi.BulkImportStallholdersAsync(command);
            if (result.IsSuccess && result.Value is not null)
            {
                _result = result.Value;
                _saved = true;
            }
            else
            {
                _saveError = string.IsNullOrWhiteSpace(result.Error)
                    ? "The import could not be completed. Please try again."
                    : result.Error;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private ImportStallRow BuildRow(Dictionary<string, string> row, int rowNumber)
    {
        // Parsed invariantly, and against the value NormalizeNumber has already reduced to a '.' decimal point. These
        // used to use the ambient culture: on Blazor Server that is the SERVER's culture, not the clerk's, so the same
        // sheet could be read differently depending on where the container happened to be configured — and nothing in
        // the app pins it. The date cell is normalised the same way, invariantly, a few lines above its own parse.
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        DateTime? effectivity = DateTime.TryParse(GetCell(row, "effectivity"), inv,
            System.Globalization.DateTimeStyles.None, out var dt) ? dt : null;
        int years = int.TryParse(GetCell(row, "years"), System.Globalization.NumberStyles.Integer, inv, out var y) ? y : 0;
        double? area = double.TryParse(GetCell(row, "area"), System.Globalization.NumberStyles.Float, inv, out var a) ? a : null;
        decimal monthly = decimal.TryParse(GetCell(row, "monthly"), System.Globalization.NumberStyles.Number, inv, out var m) ? m : 0m;
        decimal? actualMonthly = decimal.TryParse(GetCell(row, "actualMonthly"), System.Globalization.NumberStyles.Number, inv, out var am) ? am : null;
        var contractName = GetCell(row, "contractName");
        var areaLoc = GetCell(row, "areaLoc");

        // The office's own lists write the basis of occupancy in the contract-name column itself — "No contract
        // (space only)" or "No contract (Extension TCC)" — so it is read from there rather than asking them to add
        // a column. Such a row keeps no name on a contract, and its term is open-ended.
        var arrangement = ArrangementFromContractCell(contractName);
        var signed = arrangement == OccupancyArrangement.SignedContract;

        return new ImportStallRow(
            rowNumber,
            GetCell(row, "occupant"),
            signed && !string.IsNullOrWhiteSpace(contractName) ? contractName : null,
            GetCell(row, "stallNo"),
            effectivity,
            signed ? years : 0,
            area,
            monthly,
            actualMonthly,
            string.IsNullOrWhiteSpace(areaLoc) ? null : areaLoc,
            arrangement);
    }

    /// <summary>
    /// Reads the basis of occupancy out of the "name of leasee per signed contract" cell, which is where the office
    /// records it. Anything that does not say "no contract" is taken as a signed contract, so an ordinary list
    /// imports exactly as it did before.
    /// </summary>
    private static OccupancyArrangement ArrangementFromContractCell(string? contractCell)
    {
        if (string.IsNullOrWhiteSpace(contractCell))
            return OccupancyArrangement.SignedContract;

        var text = contractCell.Trim();
        if (!text.Contains("no contract", StringComparison.OrdinalIgnoreCase))
            return OccupancyArrangement.SignedContract;

        return text.Contains("extension", StringComparison.OrdinalIgnoreCase)
            ? OccupancyArrangement.Extension
            : OccupancyArrangement.SpaceOnly;
    }

    private static MarketSection? MapSection(string? section) => section switch
    {
        "Vegetable" => MarketSection.VegetableArea,
        "Fish" => MarketSection.FishSection,
        "Meat" => MarketSection.MeatSection,
        _ => null
    };

    private void ResetAll()
    {
        _rows = new();
        _derivedWholeYear.Clear();
        _loaded = false;
        _saved = false;
        _fileName = string.Empty;
        _uploadError = null;
        _result = null;
        _saveError = null;
        _autoContinued = false;
        _autoContinuedClashed = false;
        _numberedSpaces = 0;
        _renumberedClash = 0;
        _numberedBlank = 0;
        _existingMax = 0;
        _existingSpaceMax = 0;
        _applyElectricity = false;
        _applyWater = false;
        _existingOccupants.Clear();
    }

    private string TemplateDataUri
    {
        get
        {
            if (_facility is null) return "#";
            var header = string.Join(",", _facility.Columns.Select(c => c.Label));

            // A guidance line showing WHERE the office writes the basis for a space let without a signed contract,
            // in its own wording. It names no occupant, so it is skipped on upload (a data row must name one) and
            // can never be imported as a stallholder — it is there to be read and typed over.
            var basis = _facility.Code is FacilityCode.BBQ or FacilityCode.ICE
                ? "No contract (space only)"
                : $"No contract (Extension {_facility.ShortCode})";
            var guidance = string.Join(",", _facility.Columns.Select(c => c.Key == "contractName" ? basis : string.Empty));

            // A byte-order mark, and it is load-bearing. The office opens this in Excel, which ignores the charset on a
            // data URI and reads a .csv in the system's ANSI codepage: the peso sign in "Delinquent (₱)" arrived as
            // "â‚±". A BOM is what tells Excel the file is UTF-8. Reported from use, with the mangled header visible in
            // the sheet.
            const string bom = "\uFEFF";
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(bom + header + "\n" + guidance + "\n");
        }
    }

    // ── Facility-aware schemas + sample data (hardcoded) ─────────────────────

    /// <summary>
    /// Effectivity date carried by the sample rows, taken from the current month rather than written down. A fixed date
    /// rots: this sample was authored as 2023-06-07 with three-year terms, so from June 2026 onward every row it
    /// produced arrived already expired and the office was shown a facility full of lapsed contracts it had never
    /// entered. Starting the term at the top of the present month keeps the sample current in any year — the contract
    /// is live, nothing has yet been earned, and no row arrives in arrears.
    /// </summary>
    private static string SampleEffectivity => PhilippineTime.Today.ToString("yyyy-MM") + "-01";
    public record ColumnDef(string Key, string Label, string Type = "text", string[]? Options = null,
        int MinWidth = 150, string Placeholder = "", string Default = "")
    {
        public string[] Options { get; init; } = Options ?? Array.Empty<string>();
    }

    public class FacilityImportConfig
    {
        public FacilityCode Code { get; set; }
        public string ShortCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public List<ColumnDef> Columns { get; set; } = new();
        public List<Dictionary<string, string>> Sample { get; set; } = new();
    }

    private static Dictionary<string, string> Row(params (string Key, string Val)[] cells)
    {
        var d = new Dictionary<string, string>();
        foreach (var (k, v) in cells) d[k] = v;
        return d;
    }

    private static readonly ColumnDef Occupant = new("occupant", "Actual Occupant (Leasee)", MinWidth: 200, Placeholder: "Full name");
    private static readonly ColumnDef ContractName = new("contractName", "Name on Contract", MinWidth: 200, Placeholder: "Per signed contract");
    private static readonly ColumnDef StallNo = new("stallNo", "Stall / Space No.", MinWidth: 110, Placeholder: "e.g. 1");
    private static readonly ColumnDef Effectivity = new("effectivity", "Effectivity Date", "date", MinWidth: 150);
    private static readonly ColumnDef Years = new("years", "No. of Years", "number", MinWidth: 110, Placeholder: "3");
    private static readonly ColumnDef Area = new("area", "Area (sqm)", "number", MinWidth: 110, Placeholder: "0");
    private static readonly ColumnDef Monthly = new("monthly", "Monthly Rental / Contract", "number", MinWidth: 160, Placeholder: "0.00");
    private static readonly ColumnDef ActualMonthly = new("actualMonthly", "Actual Mo. Rental", "number", MinWidth: 150, Placeholder: "0.00");
    private static readonly ColumnDef WholeYear = new("wholeYear", "Whole Year Rental", "number", MinWidth: 150, Placeholder: "0.00");
    private static readonly ColumnDef Delinquent = new("delinquent", "Delinquent (₱)", "number", MinWidth: 130, Placeholder: "0.00");

    private static readonly Dictionary<string, FacilityImportConfig> Configs = BuildConfigs();

    private static Dictionary<string, FacilityImportConfig> BuildConfigs()
    {
        // Shared core columns from the official "List of Stallholders" form. NPM adds Section,
        // NCC adds Area Location; space-only facilities (BBQ/ICE) simply leave contract columns blank.
        List<ColumnDef> Core() => new()
        {
            Occupant, ContractName, StallNo, Effectivity, Years, Area, Monthly, ActualMonthly, WholeYear, Delinquent
        };

        var npm = new FacilityImportConfig
        {
            Code = FacilityCode.NPM,
            ShortCode = "NPM",
            Name = "New Public Market",
            Columns = new()
            {
                Occupant, ContractName, StallNo, Effectivity, Years, Area, Monthly, ActualMonthly, WholeYear, Delinquent
            },
            Sample = new()
            {
                // Placeholder names, not any municipality's own payors: the sample teaches the FORMAT, and every LGU
                // that presses "Use sample data" sees the same neutral rows rather than another office's stallholders.
                Row(("occupant","Juan Dela Cruz"),("contractName","Maria Dela Cruz"),("stallNo","1"),("effectivity",SampleEffectivity),("years","3"),("area","4.8"),("monthly","900"),("actualMonthly","900"),("wholeYear","10800")),
                Row(("occupant","Maria Clara Santos"),("contractName","Maria Clara Santos"),("stallNo","2"),("effectivity",SampleEffectivity),("years","3"),("area","4.8"),("monthly","900"),("actualMonthly","900"),("wholeYear","10800")),
                Row(("occupant","Pedro Reyes"),("contractName","Pedro Reyes"),("stallNo","3"),("effectivity",SampleEffectivity),("years","3"),("area","4.8"),("monthly","900"),("actualMonthly","900"),("wholeYear","10800")),
                Row(("occupant","Josefa Mercado"),("contractName","Andres Mercado"),("stallNo","4"),("effectivity",SampleEffectivity),("years","3"),("area","4.8"),("monthly","900"),("actualMonthly","900"),("wholeYear","10800")),
                Row(("occupant","Lorenzo Bautista"),("contractName","Lorenzo Bautista"),("stallNo","5"),("effectivity",SampleEffectivity),("years","3"),("area","4.8"),("monthly","900"),("actualMonthly","900"),("wholeYear","10800")),
            }
        };

        var tcc = new FacilityImportConfig
        {
            Code = FacilityCode.TCC,
            ShortCode = "TCC",
            Name = "Tampak Commercial Center",
            Columns = Core(),
            Sample = new()
            {
                Row(("occupant","Joseph Villamor"),("contractName","Joseph Villamor"),("stallNo","1"),("effectivity",SampleEffectivity),("years","3"),("area","10.5"),("monthly","2760"),("actualMonthly","2760"),("wholeYear","33120")),
                Row(("occupant","Marlon Aguilar"),("contractName","Marlon Aguilar"),("stallNo","2"),("effectivity",SampleEffectivity),("years","3"),("area","10.5"),("monthly","2400"),("actualMonthly","2400"),("wholeYear","28800")),
                Row(("occupant","Jonalyn Ramos"),("contractName","Jonalyn Ramos"),("stallNo","3"),("effectivity",SampleEffectivity),("years","3"),("area","10.5"),("monthly","2400"),("actualMonthly","2400"),("wholeYear","28800")),
                // The office's own sheet carries spaces held without a signed contract among the contracted ones,
                // and writes the basis where the leasee's name would go — an extension of a lapsed Tampak contract,
                // or a space only. Such a row states no term, no area and no contract rental: only the rent charged.
                Row(("occupant","Bernadette Lim"),("contractName","No contract (extension)"),("actualMonthly","1500"),("wholeYear","18000")),
                Row(("occupant","Jessie Navarro"),("contractName","No contract (space only)"),("actualMonthly","900"),("wholeYear","10800")),
            }
        };

        var ncc = new FacilityImportConfig
        {
            Code = FacilityCode.NCC,
            ShortCode = "NCC",
            Name = "New Commercial Center",
            Columns = new()
            {
                Occupant, ContractName, StallNo, Effectivity, Years, Area, Monthly, ActualMonthly, WholeYear,
                new("areaLoc", "Area Loc.", "select", new[] { "Extension", "Corner", "Standard" }, MinWidth: 130),
                Delinquent
            },
            Sample = new()
            {
                Row(("occupant","Lucia Ramirez"),("contractName","Lucia Ramirez"),("stallNo","1"),("effectivity",SampleEffectivity),("years","3"),("area","10.5"),("monthly","1200"),("actualMonthly","1200"),("wholeYear","14400"),("areaLoc","Extension")),
                Row(("occupant","Ruel Ramirez"),("contractName","Ruel Ramirez"),("stallNo","2"),("effectivity",SampleEffectivity),("years","3"),("area","10.5"),("monthly","1200"),("actualMonthly","1200"),("wholeYear","14400"),("areaLoc","Extension")),
                Row(("occupant","Florencia Delgado"),("contractName","Florencia Delgado"),("stallNo","13"),("effectivity",SampleEffectivity),("years","3"),("area","35"),("monthly","3240"),("actualMonthly","3240"),("wholeYear","38880"),("areaLoc","Corner")),
                Row(("occupant","Gideon Salazar"),("contractName","Gideon Salazar"),("stallNo","16"),("effectivity",SampleEffectivity),("years","3"),("area","70"),("monthly","2400"),("actualMonthly","4800"),("wholeYear","57600"),("areaLoc","Corner")),
                Row(("occupant","Rachel Del Valle"),("contractName","Rachel Del Valle"),("stallNo","22"),("effectivity",SampleEffectivity),("years","3"),("area","35"),("monthly","3840"),("actualMonthly","3840"),("wholeYear","46080"),("areaLoc","Corner")),
            }
        };

        var bbq = new FacilityImportConfig
        {
            Code = FacilityCode.BBQ,
            ShortCode = "BBQ",
            Name = "Barbecue Stand",
            Columns = Core(),
            Sample = new()
            {
                // The Barbecue Stand list is entirely spaces let without a contract: the official sheet writes
                // "No contract(space only)" where the leasee per signed contract would be named, and leaves the
                // term, area and contract-rental columns empty. Only the rent actually charged appears.
                Row(("occupant","Joy Ramirez"),("contractName","No contract (space only)"),("actualMonthly","1600"),("wholeYear","19200")),
                Row(("occupant","Mary Anne Benitez"),("contractName","No contract (space only)"),("actualMonthly","3200"),("wholeYear","38400")),
                Row(("occupant","Lorna Arceo"),("contractName","No contract (space only)"),("actualMonthly","1600"),("wholeYear","19200")),
                Row(("occupant","Irene Paredes"),("contractName","No contract (space only)"),("actualMonthly","1600"),("wholeYear","19200")),
                Row(("occupant","Claudia Mendoza"),("contractName","No contract (space only)"),("actualMonthly","1600"),("wholeYear","19200")),
            }
        };

        var ice = new FacilityImportConfig
        {
            Code = FacilityCode.ICE,
            ShortCode = "ICE",
            Name = "Iceplant",
            Columns = Core(),
            Sample = new()
            {
                // The Iceplant list is the same shape as the Barbecue Stand's: space only, no term, no contract rate.
                Row(("occupant","Renato Mendoza"),("contractName","No contract (space only)"),("actualMonthly","2000"),("wholeYear","24000")),
                Row(("occupant","Rebecca Ortega"),("contractName","No contract (space only)"),("actualMonthly","1000"),("wholeYear","12000")),
                Row(("occupant","Martin Duran"),("contractName","No contract (space only)"),("actualMonthly","1000"),("wholeYear","12000")),
                Row(("occupant","Rolando Mendoza"),("contractName","No contract (space only)"),("actualMonthly","2000"),("wholeYear","24000")),
            }
        };

        return new(StringComparer.OrdinalIgnoreCase)
        {
            ["npm"] = npm,
            ["tcc"] = tcc,
            ["ncc"] = ncc,
            ["bbq"] = bbq,
            ["ice"] = ice,
            ["iceplant"] = ice,
        };
    }
}
