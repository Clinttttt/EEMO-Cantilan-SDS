@page "/operations/water-consumption-fees/accounts"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IWcfCollectionsApiClient WcfApi
@inject ICollectorsApiClient CollectorsApi

<PageTitle>StallTrack — Water Accounts</PageTitle>

@* Account-level WCF register, read from the same server obligations the WCF workspace shows. Every reading and amount
   is the server's; this page computes no balance. The layout owns the <main> landmark. *@
<div class="v3-page">
    <WorkspaceHeader Parent="Water Consumption Fees" ParentHref="/operations/water-consumption-fees" Title="Water Accounts" Code="WCF">
        <Meta><InstrumentChip Instrument="CT" ShowName="true" /></Meta>
        <Actions>
            <label class="v3-period">
                <span>Through</span>
                <input class="v3-input" type="month" aria-label="Show accounts through billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            </label>
            <div class="v3-btn-group" role="group" aria-label="Water account actions">
                <button class="v3-btn" type="button" @onclick="LoadAsync" disabled="@_loading">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7" /><polyline points="20 4 20 11 13 11" /></svg>
                    Refresh
                </button>
                <a class="v3-btn" href="/operations/water-consumption-fees/report">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                    Report
                </a>
            </div>
        </Actions>
    </WorkspaceHeader>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <SummaryStrip Label="Water account position" Items="SummaryItems" />

    <section class="v3-panel" aria-labelledby="wcfa-title" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="wcfa-title">Accounts</h2>
            <span class="v3-panel-meta">@Filtered.Count() of @_quotes.Count · unpaid periods through @PeriodLabel stay listed</span>
        </header>

        <div class="v3-toolbar" aria-label="Account filters">
            <label class="v3-search">
                <span class="v3-sr-only">Search payer, stall or area</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                <input type="search" placeholder="Search payer, stall or area" aria-label="Search payer, stall or area" @bind="_search" @bind:event="oninput" />
            </label>
            <select class="v3-select" aria-label="Filter by area" @bind="_area">
                <option value="">All areas</option>
                @foreach (var area in Areas)
                {
                    <option value="@area">@area</option>
                }
            </select>
            <select class="v3-select" aria-label="Filter by balance" @bind="_balance">
                <option value="">All accounts</option>
                <option value="open">With balance</option>
                <option value="settled">Settled</option>
            </select>
        </div>

        <div class="v3-table-wrap" role="region" aria-label="Water accounts" tabindex="0">
            <table class="v3-table">
                <caption class="v3-sr-only">Water accounts through @PeriodLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Payer</th>
                        <th scope="col">Period</th>
                        <th scope="col" class="v3-num">Approved amount</th>
                        <th scope="col" class="v3-num">Previously settled</th>
                        <th scope="col" class="v3-num">Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quote in Filtered)
                    {
                        <tr>
                            <td>
                                <span class="v3-strong">@(quote.PayerNameSnapshot ?? "Payer snapshot unavailable")</span>
                                <span class="v3-block">@quote.FacilityName · Stall @quote.StallNo@(string.IsNullOrWhiteSpace(quote.Section) ? "" : $" · {quote.Section}")</span>
                            </td>
                            <td>@Period(quote)</td>
                            <td class="v3-num">@Money(quote.AssessedAmount)</td>
                            <td class="v3-num">@Money(quote.CumulativeSettledEvidence)</td>
                            <td class="v3-num v3-strong">@Money(quote.OutstandingAmount)</td>
                        </tr>
                    }
                    @if (!Filtered.Any())
                    {
                        <tr>
                            <td class="v3-empty" colspan="5">
                                @if (_loading) { <span role="status">Loading accounts…</span> }
                                else if (_error is not null) { <span>Accounts are unavailable.</span> }
                                else if (_quotes.Count > 0) { <span>No accounts match these filters.</span> }
                                else { <span>No water accounts through @PeriodLabel.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="v3-panel-note">Cash Ticket numbers are recorded per collection — see Collection activity on the <a href="/operations/water-consumption-fees">WCF workspace</a>.</p>
    </section>

    @* Head/Admin source entry (IA-053): the direct approved Water amount for one source and billing month, on the one
       stall/month bill, then — once — activation for Collector Mobile through the attested cutover. Electricity on the same
       bill is never changed here. No reading, cubic metre or rate is asked for. *@
    <section class="v3-panel wcfs" aria-labelledby="wcfs-title" aria-busy="@(_setupLoading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="wcfs-title">Prepare Water amounts — @PeriodLabel</h2>
            <span class="v3-panel-meta">Optional · when no amount is prepared, the collector enters it on Mobile at collection</span>
        </header>

        @if (_setupMessage is not null)
        {
            <p class="v3-notice v3-notice-row @(_setupFailed ? "v3-notice-error" : "")" role="status">@_setupMessage</p>
        }

        <div class="v3-table-wrap" role="region" aria-label="Water sources to set up" tabindex="0">
            <table class="v3-table wcfs-table">
                <caption class="v3-sr-only">Water sources for @PeriodLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Payer</th>
                        <th scope="col">Source</th>
                        <th scope="col" class="v3-num">Approved amount</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="v3-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var source in _sources)
                    {
                        var key = source.StallId;
                        <tr>
                            <td><span class="v3-strong">@(source.PayerName ?? "Payer not named")</span></td>
                            <td>Stall @source.StallNo@(string.IsNullOrWhiteSpace(source.Section) ? "" : $" · {source.Section}")</td>
                            <td class="v3-num">
                                @if (source.Editable)
                                {
                                    <label class="wcfs-amount">
                                        <span class="v3-sr-only">Approved Water amount for stall @source.StallNo</span>
                                        <span aria-hidden="true">₱</span>
                                        <input class="v3-input" type="number" min="0.01" step="0.01" inputmode="decimal"
                                               value="@AmountInput(source)" @onchange="e => _amounts[key] = e.Value?.ToString() ?? string.Empty" />
                                    </label>
                                }
                                else
                                {
                                    <span title="@source.LockedReason">@(source.ApprovedAmount is { } a ? Money(a) : "—")</span>
                                }
                            </td>
                            <td><span class="wcfs-state @StateClass(source)">@StateLabel(source)</span></td>
                            <td class="wcfs-actions">
                                <div class="wcfs-action-group">
                                    @if (source.Editable)
                                    {
                                        <button class="v3-btn v3-btn-sm" type="button" disabled="@_busy" @onclick="() => SaveAsync(source)">Save</button>
                                    }
                                    @if (CanMigrate(source))
                                    {
                                        <button class="v3-btn v3-btn-sm" type="button" disabled="@_busy" @onclick="() => OpenActivationAsync(source)">Review legacy migration</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (_sources.Count == 0)
                    {
                        <tr>
                            <td class="v3-empty" colspan="5">
                                @if (_setupLoading) { <span role="status">Loading Water sources…</span> }
                                else if (_setupFailed && _setupMessage is not null) { <span>Water sources are unavailable.</span> }
                                else { <span>No stall has an occupant answering for @PeriodLabel.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="v3-panel-note">A prepared amount can be revised until it is collected. Historical records with legacy payments keep the legacy path; migrating one is an exceptional, attested review.</p>
    </section>
</div>

@if (_activating is { } target)
{
    <div class="v3-modal-backdrop" role="presentation" @onclick="CloseActivation">
        <section class="v3-modal wcfs-modal" role="dialog" aria-modal="true" aria-labelledby="wcfs-activate-title" @onclick:stopPropagation="true">
            <header class="v3-modal-header">
                <h2 id="wcfs-activate-title">Review legacy WCF migration</h2>
                <button class="wcfs-close" type="button" aria-label="Close" @onclick="CloseActivation">×</button>
            </header>
            <form class="v3-modal-body" id="wcfs-activate-form" @onsubmit="ActivateAsync" @onsubmit:preventDefault="true">
                <p class="wcfs-hint">
                    Stall @target.StallNo · @(target.PayerName ?? "Payer not named") · @PeriodLabel · @(target.ApprovedAmount is { } amt ? Money(amt) : "—").
                    This historical source has legacy Water records. Migrating it freezes its legacy settled amount as the opening position (nothing is re-counted as a collection) and moves it to the canonical path.
                </p>
                <fieldset class="wcfs-checks">
                    <legend>Office attestation</legend>
                    <label><input type="checkbox" @bind="_writersQuiesced" /> Legacy Web and Mobile writers for this source are stopped</label>
                    <label><input type="checkbox" @bind="_queuesDrained" /> Collector device queues are synced</label>
                    <label><input type="checkbox" @bind="_devicesComplete" /> Every collector device is accounted for</label>
                    <label><input type="checkbox" @bind="_onlineDrained" /> No online payment is in progress for this source</label>
                    <label><input type="checkbox" @bind="_inventoryReconciled" /> Cash Ticket inventory and custody are reconciled</label>
                    <label><input type="checkbox" @bind="_reportsVerified" /> Collection Activity and reports were checked</label>
                </fieldset>
                <label class="v3-field"><span>Evidence reference</span><input required maxlength="200" @bind="_evidenceReference" placeholder="e.g. checklist or memo number" /></label>

                @if (_readiness is { } readiness)
                {
                    @if (readiness.AffectedCollectors.Count > 0)
                    {
                        <fieldset class="wcfs-collectors">
                            <legend>Collectors who can record this source</legend>
                            @foreach (var collectorId in readiness.AffectedCollectors)
                            {
                                var id = collectorId;
                                <div class="wcfs-collector">
                                    <span class="v3-strong">@CollectorName(id)</span>
                                    <label class="v3-field"><span>App version</span><input maxlength="64" value="@_versions.GetValueOrDefault(id)" @onchange="e => _versions[id] = e.Value?.ToString() ?? string.Empty" /></label>
                                    <label class="wcfs-inline"><input type="checkbox" checked="@_drained.Contains(id)" @onchange="e => ToggleDrained(id, e.Value is true)" /> Device synced</label>
                                </div>
                            }
                        </fieldset>
                    }
                    @if (readiness.BlockingReasons.Count > 0)
                    {
                        <ul class="wcfs-blockers" aria-label="Still blocking activation">
                            @foreach (var reason in readiness.BlockingReasons) { <li>@reason</li> }
                        </ul>
                    }
                }
                @if (_dialogError is not null)
                {
                    <p class="v3-notice v3-notice-error" role="alert">@_dialogError</p>
                }
            </form>
            <footer class="v3-modal-footer">
                <button class="v3-btn" type="button" @onclick="CheckReadinessAsync" disabled="@_busy">Check readiness</button>
                <button class="v3-btn v3-btn-primary" type="submit" form="wcfs-activate-form" disabled="@(_busy || string.IsNullOrWhiteSpace(_evidenceReference))">Activate</button>
            </footer>
        </section>
    </div>
}

@code {
    private DateOnly _period = PhilippineTime.Today;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private List<WcfObligationQuoteDto> _quotes = [];
    private string _search = string.Empty;
    private string _area = string.Empty;
    private string _balance = string.Empty;
    private bool _loading = true;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy");
    private IEnumerable<string> Areas => _quotes.Select(x => x.Section).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);

    private IEnumerable<WcfObligationQuoteDto> Filtered => _quotes.Where(x =>
        (string.IsNullOrEmpty(_area) || x.Section == _area)
        && (_balance switch { "open" => x.OutstandingAmount > 0m, "settled" => x.OutstandingAmount <= 0m, _ => true })
        && (string.IsNullOrWhiteSpace(_search)
            || (x.PayerNameSnapshot?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.StallNo.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.FacilityName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Section.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    // Totals of the server's own per-account figures, as the WCF workspace shows them.
    private IReadOnlyList<SummaryStrip.SummaryItem> SummaryItems =>
    [
        new("Through", PeriodLabel),
        new("Accounts", _error is null ? _quotes.Count.ToString() : "—"),
        new("Assessed", _error is null ? Money(_quotes.Sum(x => x.AssessedAmount)) : "—"),
        new("Previously settled", _error is null ? Money(_quotes.Sum(x => x.CumulativeSettledEvidence)) : "—"),
        new("Outstanding", _error is null ? Money(_quotes.Sum(x => x.OutstandingAmount)) : "—", Emphasis: true),
    ];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await WcfApi.GetObligationsAsync(_period.Year, _period.Month);
            if (result.IsSuccess) _quotes = result.Value?.ToList() ?? [];
            else
            {
                _quotes = [];
                _error = "Water accounts couldn't be loaded.";
            }
        }
        catch
        {
            _quotes = [];
            _error = "Water accounts couldn't be loaded.";
        }
        finally { _loading = false; }
        _setupFailed = false;
        await LoadSetupAsync();
    }

    // ── Head/Admin Water source entry and activation ──────────────────────────────────────────────────────────
    private List<WcfSetupSourceDto> _sources = [];
    private readonly Dictionary<Guid, string> _amounts = [];
    private bool _setupLoading = true;
    private bool _setupFailed;
    private string? _setupMessage;
    private bool _busy;

    private WcfSetupSourceDto? _activating;
    private SettlementCutoverReadinessDto? _readiness;
    private Dictionary<Guid, string> _collectorNames = [];
    private readonly Dictionary<Guid, string> _versions = [];
    private readonly HashSet<Guid> _drained = [];
    private bool _writersQuiesced, _queuesDrained, _devicesComplete, _onlineDrained, _inventoryReconciled, _reportsVerified;
    private string _evidenceReference = string.Empty;
    private string? _dialogError;

    private async Task LoadSetupAsync()
    {
        _setupLoading = true;
        try
        {
            var result = await WcfApi.GetSetupSourcesAsync(_period.Year, _period.Month);
            _sources = result.IsSuccess ? result.Value?.ToList() ?? [] : [];
            if (!result.IsSuccess) { _setupFailed = true; _setupMessage = "Water sources couldn't be loaded."; }
        }
        catch
        {
            _sources = [];
            _setupFailed = true;
            _setupMessage = "Water sources couldn't be loaded.";
        }
        finally { _setupLoading = false; }
    }

    private string AmountInput(WcfSetupSourceDto source) =>
        _amounts.TryGetValue(source.StallId, out var typed) ? typed
        : source.ApprovedAmount is { } a ? a.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : string.Empty;

    private async Task SaveAsync(WcfSetupSourceDto source)
    {
        if (!decimal.TryParse(AmountInput(source), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var amount) || amount <= 0m)
        {
            _setupFailed = true;
            _setupMessage = $"Enter a positive approved amount for stall {source.StallNo}.";
            return;
        }
        _busy = true;
        try
        {
            var result = await WcfApi.EstablishObligationAsync(new WcfObligationSetupRequest(source.StallId, _period.Year, _period.Month, amount));
            _setupFailed = !result.IsSuccess;
            _setupMessage = result.IsSuccess
                ? $"Stall {source.StallNo}: {Money(amount)} approved for {PeriodLabel}."
                : result.Error ?? "The approved amount could not be saved.";
            if (result.IsSuccess)
            {
                _amounts.Remove(source.StallId);
                await LoadAsync();
            }
        }
        catch
        {
            _setupFailed = true;
            _setupMessage = "The approved amount could not be saved.";
        }
        finally { _busy = false; }
    }

    // Legacy migration is the exception: only a historical source with legacy payments, or one already in migration.
    private static bool CanMigrate(WcfSetupSourceDto s) =>
        s.UtilityBillId is not null && s.ApprovedAmount is > 0m
        && (s.SettlementAuthority == SettlementAuthority.PendingCutover
            || s.SettlementAuthority == SettlementAuthority.Legacy && !s.Editable);

    private static string StateLabel(WcfSetupSourceDto s) => s.SettlementAuthority switch
    {
        null => "No amount set",
        SettlementAuthority.Canonical => "Active",
        SettlementAuthority.PendingCutover => "Migration in progress",
        _ when s.ApprovedAmount is null => "No amount set",
        _ when !s.Editable => "Historical record",
        _ => "Prepared"
    };

    private static string StateClass(WcfSetupSourceDto s) => s.SettlementAuthority switch
    {
        SettlementAuthority.Canonical => "on",
        SettlementAuthority.PendingCutover => "pending",
        _ => "off"
    };

    private async Task OpenActivationAsync(WcfSetupSourceDto source)
    {
        _activating = source;
        _readiness = null;
        _dialogError = null;
        _evidenceReference = string.Empty;
        _writersQuiesced = _queuesDrained = _devicesComplete = _onlineDrained = _inventoryReconciled = _reportsVerified = false;
        _versions.Clear();
        _drained.Clear();
        try
        {
            var collectors = await CollectorsApi.GetAllCollectorsAsync();
            if (collectors.IsSuccess && collectors.Value is not null)
                _collectorNames = collectors.Value.ToDictionary(c => c.Id, c => c.FullName);
        }
        catch
        {
            // Names are a convenience; the ids below still identify each collector.
        }
        await CheckReadinessAsync();
    }

    private void CloseActivation() => _activating = null;

    private void ToggleDrained(Guid id, bool on)
    {
        if (on) _drained.Add(id); else _drained.Remove(id);
    }

    private string CollectorName(Guid id) => _collectorNames.GetValueOrDefault(id) ?? $"Collector {id.ToString("N")[..8]}";

    private SettlementCutoverReconciliationEvidence Evidence() => new(
        _writersQuiesced, _queuesDrained, _devicesComplete, _onlineDrained, _inventoryReconciled, _reportsVerified,
        _evidenceReference.Trim(),
        (_readiness?.AffectedCollectors ?? []).Select(id => new CutoverCollectorEvidence(
            id, _versions.GetValueOrDefault(id)?.Trim() ?? string.Empty, _readiness?.RequiredMobilePayloadVersion ?? 1,
            _drained.Contains(id), DateTime.UtcNow, _evidenceReference.Trim())).ToList());

    private async Task CheckReadinessAsync()
    {
        if (_activating?.UtilityBillId is not { } billId) return;
        _busy = true;
        _dialogError = null;
        try
        {
            var result = await WcfApi.GetActivationReadinessAsync(billId, string.IsNullOrWhiteSpace(_evidenceReference) ? null : Evidence());
            if (result.IsSuccess) _readiness = result.Value;
            else _dialogError = result.Error ?? "Readiness could not be checked.";
        }
        catch { _dialogError = "Readiness could not be checked."; }
        finally { _busy = false; }
    }

    private async Task ActivateAsync()
    {
        if (_activating?.UtilityBillId is not { } billId) return;
        _busy = true;
        _dialogError = null;
        try
        {
            var version = _readiness?.SourceVersion ?? 0;
            var result = await WcfApi.ActivateAsync(new EEMOCantilanSDS.Application.Common.Revenue.WcfActivationRequest(billId, version, Evidence()));
            if (result.IsSuccess)
            {
                _setupFailed = false;
                _setupMessage = $"Stall {_activating.StallNo} is active for Collector Mobile collection.";
                _activating = null;
                await LoadAsync();
            }
            else
            {
                _dialogError = result.Error ?? "Activation was refused.";
                await CheckReadinessAsync();
            }
        }
        catch { _dialogError = "Activation could not be completed."; }
        finally { _busy = false; }
    }

    private static string Period(WcfObligationQuoteDto quote) => new DateTime(quote.BillingYear, quote.BillingMonth, 1).ToString("MMM yyyy");

    private static string Money(decimal amount) => $"₱{amount:N2}";
}
