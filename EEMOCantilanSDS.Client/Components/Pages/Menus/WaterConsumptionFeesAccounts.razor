@page "/operations/water-consumption-fees/accounts"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IWcfCollectionsApiClient WcfApi

<PageTitle>StallTrack — Water Accounts</PageTitle>

@* Account-level WCF register, read from the same server obligations the WCF workspace shows. Every reading and amount
   is the server's; this page computes no balance. The layout owns the <main> landmark. *@
<div class="v3-page">
    <WorkspaceHeader Parent="Water Consumption Fees" ParentHref="/operations/water-consumption-fees" Title="Water Accounts" Code="WCF">
        <Meta><InstrumentChip Instrument="CT" ShowName="true" /></Meta>
        <Actions>
            <label class="v3-period">
                <span>Through</span>
                <input class="v3-input" type="month" aria-label="Show accounts through billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
            </label>
            <div class="v3-btn-group" role="group" aria-label="Water account actions">
                <button class="v3-btn" type="button" @onclick="LoadAsync" disabled="@_loading">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7" /><polyline points="20 4 20 11 13 11" /></svg>
                    Refresh
                </button>
                <a class="v3-btn" href="/operations/water-consumption-fees/report">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                    Report
                </a>
            </div>
        </Actions>
    </WorkspaceHeader>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <SummaryStrip Label="Water account position" Items="SummaryItems" />

    <section class="v3-panel" aria-labelledby="wcfa-title" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="wcfa-title">Accounts</h2>
            <span class="v3-panel-meta">@Filtered.Count() of @_quotes.Count · unpaid periods through @PeriodLabel stay listed</span>
        </header>

        <div class="v3-toolbar" aria-label="Account filters">
            <label class="v3-search">
                <span class="v3-sr-only">Search payer, stall or area</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                <input type="search" placeholder="Search payer, stall or area" aria-label="Search payer, stall or area" @bind="_search" @bind:event="oninput" />
            </label>
            <select class="v3-select" aria-label="Filter by area" @bind="_area">
                <option value="">All areas</option>
                @foreach (var area in Areas)
                {
                    <option value="@area">@area</option>
                }
            </select>
            <select class="v3-select" aria-label="Filter by balance" @bind="_balance">
                <option value="">All accounts</option>
                <option value="open">With balance</option>
                <option value="settled">Settled</option>
            </select>
        </div>

        <div class="v3-table-wrap" role="region" aria-label="Water accounts" tabindex="0">
            <table class="v3-table">
                <caption class="v3-sr-only">Water accounts through @PeriodLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Payer</th>
                        <th scope="col">Period</th>
                        <th scope="col" class="v3-num">Approved amount</th>
                        <th scope="col" class="v3-num">Previously settled</th>
                        <th scope="col" class="v3-num">Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quote in Filtered)
                    {
                        <tr>
                            <td>
                                <span class="v3-strong">@(quote.PayerNameSnapshot ?? "Payer snapshot unavailable")</span>
                                <span class="v3-block">@quote.FacilityName · Stall @quote.StallNo@(string.IsNullOrWhiteSpace(quote.Section) ? "" : $" · {quote.Section}")</span>
                            </td>
                            <td>@Period(quote)</td>
                            <td class="v3-num">@Money(quote.AssessedAmount)</td>
                            <td class="v3-num">@Money(quote.CumulativeSettledEvidence)</td>
                            <td class="v3-num v3-strong">@Money(quote.OutstandingAmount)</td>
                        </tr>
                    }
                    @if (!Filtered.Any())
                    {
                        <tr>
                            <td class="v3-empty" colspan="5">
                                @if (_loading) { <span role="status">Loading accounts…</span> }
                                else if (_error is not null) { <span>Accounts are unavailable.</span> }
                                else if (_quotes.Count > 0) { <span>No accounts match these filters.</span> }
                                else { <span>No water accounts through @PeriodLabel.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="v3-panel-note">Cash Ticket numbers are recorded per collection — see Collection activity on the <a href="/operations/water-consumption-fees">WCF workspace</a>.</p>
    </section>
</div>

@code {
    private DateOnly _period = PhilippineTime.Today;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private List<WcfObligationQuoteDto> _quotes = [];
    private string _search = string.Empty;
    private string _area = string.Empty;
    private string _balance = string.Empty;
    private bool _loading = true;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy");
    private IEnumerable<string> Areas => _quotes.Select(x => x.Section).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);

    private IEnumerable<WcfObligationQuoteDto> Filtered => _quotes.Where(x =>
        (string.IsNullOrEmpty(_area) || x.Section == _area)
        && (_balance switch { "open" => x.OutstandingAmount > 0m, "settled" => x.OutstandingAmount <= 0m, _ => true })
        && (string.IsNullOrWhiteSpace(_search)
            || (x.PayerNameSnapshot?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.StallNo.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.FacilityName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Section.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    // Totals of the server's own per-account figures, as the WCF workspace shows them.
    private IReadOnlyList<SummaryStrip.SummaryItem> SummaryItems =>
    [
        new("Through", PeriodLabel),
        new("Accounts", _error is null ? _quotes.Count.ToString() : "—"),
        new("Assessed", _error is null ? Money(_quotes.Sum(x => x.AssessedAmount)) : "—"),
        new("Previously settled", _error is null ? Money(_quotes.Sum(x => x.CumulativeSettledEvidence)) : "—"),
        new("Outstanding", _error is null ? Money(_quotes.Sum(x => x.OutstandingAmount)) : "—", Emphasis: true),
    ];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await WcfApi.GetObligationsAsync(_period.Year, _period.Month);
            if (result.IsSuccess) _quotes = result.Value?.ToList() ?? [];
            else
            {
                _quotes = [];
                _error = "Water accounts couldn't be loaded.";
            }
        }
        catch
        {
            _quotes = [];
            _error = "Water accounts couldn't be loaded.";
        }
        finally { _loading = false; }
    }

    private static string Period(WcfObligationQuoteDto quote) => new DateTime(quote.BillingYear, quote.BillingMonth, 1).ToString("MMM yyyy");

    private static string Money(decimal amount) => $"₱{amount:N2}";
}
