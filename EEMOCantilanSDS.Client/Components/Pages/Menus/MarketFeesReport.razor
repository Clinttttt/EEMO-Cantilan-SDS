@page "/operations/market-fees/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants

<PageTitle>StallTrack — Market Fees Report</PageTitle>

@* Market Fees report: the operation reports layout (Weekly, Monthly, Yearly, Status Report, History) around its transactional report body — the official Monthly Income row and the
   month's governed collections, all read from the server. The layout owns the <main> landmark. *@
<OperationReportsPage Name="Market Fees" ParentHref="/operations/market-fees" RowKey="MARKET_FEES" SeriesLabel="Fees collected" @bind-Month="_month">
    <StatusReport>
        <GovernedOperationReport OperationCode="@CollectorOperationCodes.MarketFees" Name="Market Fees" ParentHref="/operations/market-fees"
                                 RowKey="MARKET_FEES" Classification="Market Fees" Instruments="@(new[] { "CT" })"
                                 InstrumentFact="Cash Ticket" IdPrefix="mfr" ByFeeType="true"
                                 Embedded="true" Month="_month" />
    </StatusReport>
    <WeekContent>
        <OperationWeekRegister OperationCode="@CollectorOperationCodes.MarketFees" Name="Market Fees" From="context.From" To="context.To" />
    </WeekContent>
    <MonthExtras>
        <OperationFeeTypeCard OperationCode="@CollectorOperationCodes.MarketFees" Month="_month" />
    </MonthExtras>
</OperationReportsPage>

@code {
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
}
