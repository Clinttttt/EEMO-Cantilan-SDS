@page "/operations/terminal/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Common.Revenue
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject IOfficeSourcesApiClient OfficeApi
@inject IOperationSettingsApiClient OperationSettingsApi
@inject IJSRuntime JS

<PageTitle>StallTrack — Income From Terminal Report</PageTitle>

@* Income From Terminal report in the standard operation-report shell: the official Monthly Income rows of the three office sections, then
   the month's Terminal collections by section and in full (net amounts, as the Terminal page states them). Every figure is the server's.
   The layout owns the main landmark. *@
<OperationReportsPage Name="Terminal" ParentHref="/operations/terminal" RowKey="TERMINAL" GroupKey="TERMINAL" SeriesLabel="Fees collected" Month="ShellMonth" MonthChanged="OnShellMonthAsync">
<StatusReport>
<div class="v3-page orp-embedded">
    <div class="v3-btn-group no-print orp-embedded-actions" role="group" aria-label="Report actions">
                    <button class="v3-btn" type="button" @onclick="PrintAsync" disabled="@(!Ready)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                        Print
                    </button>
                    @if (Ready)
                    {
                        <a class="v3-btn" href="@ExportHref" download="@($"terminal-report-{_month:yyyy-MM}.csv")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                            Export CSV
                        </a>
                    }
                    else
                    {
                        <button class="v3-btn" type="button" disabled>Export CSV</button>
                    }
                </div>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row no-print" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="tmr-title" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="Income From Terminal Report" Period="@($"Reporting month {MonthLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>Income From Terminal</dd></div>
                <div><dt>Instrument</dt><dd>Cash Ticket</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="tmr-title" class="v3-sr-only">Income From Terminal report for @MonthLabel</h2>

        <OperationMonthlyIncome Classification="Income From Terminal" RowKey="TERMINAL" GroupKey="TERMINAL" Year="_month.Year" HeadingId="tmr-official" />

        <section class="v3-report-section" aria-labelledby="tmr-sections">
            <h3 id="tmr-sections">Sections</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Section</th>
                            <th scope="col" class="v3-num">Collections</th>
                            <th scope="col" class="v3-num">Amount</th>
                            <th scope="col" class="v3-num">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var section in Sections)
                        {
                            var rows = _rows.Where(x => x.Section == section).ToList();
                            <tr>
                                <th scope="row">@SectionName(section)</th>
                                <td class="v3-num">@(Ready ? rows.Count.ToString("N0", CultureInfo.InvariantCulture) : "—")</td>
                                <td class="v3-num">@(Ready ? Money(rows.Sum(x => x.NetAmount)) : "—")</td>
                                <td class="v3-num">@(Ready ? Share(rows.Sum(x => x.NetAmount)) : "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">Total</th>
                            <td class="v3-num">@(Ready ? _rows.Count.ToString("N0", CultureInfo.InvariantCulture) : "—")</td>
                            <td class="v3-num">@(Ready ? Money(_rows.Sum(x => x.NetAmount)) : "—")</td>
                            <td class="v3-num">—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <section class="v3-report-section" aria-labelledby="tmr-register">
            <h3 id="tmr-register">Collection register</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">SRC</th>
                            <th scope="col">Section</th>
                            <th scope="col">Collector</th>
                            <th scope="col" class="v3-num">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows.OrderBy(x => x.BusinessDate).ThenBy(x => x.SRC, StringComparer.Ordinal))
                        {
                            <tr>
                                <td>@row.BusinessDate.ToString("MMM d", CultureInfo.InvariantCulture)</td>
                                <td>@row.SRC</td>
                                <td>@(row.Section is { } s ? SectionName(s) : "—")</td>
                                <td>@(row.CollectorName ?? "—")</td>
                                <td class="v3-num">@Money(row.NetAmount)</td>
                            </tr>
                        }
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="5" class="v3-report-note">@(_loading ? "Loading collections…" : _error is not null ? "Collections are unavailable." : $"No Terminal collection was recorded in {MonthLabel}.")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </article>
</div>
</StatusReport>
<MonthExtras>
    @* The month by Terminal section, in the office's own section names: what each collected, its share of the month and how many
       collections made it. The same server figures as the Status Report's Sections table; nothing is recalculated. *@
    <div class="orp-extra-grid tmr-extras" role="list" aria-label="@($"Terminal sections, {MonthLabel}")">
        @foreach (var section in Sections)
        {
            var rows = _rows.Where(x => x.Section == section).ToList();
            var net = rows.Sum(x => x.NetAmount);
            <section class="tmr-card" role="listitem" aria-label="@SectionName(section)">
                <h2 class="tmr-card-name">@SectionName(section)</h2>
                <p class="tmr-card-amount">@(Ready ? Money(net) : "—")</p>
                <progress class="tmr-bar" max="100" value="@(Ready ? SharePercent(net) : 0)" aria-label="@($"{SectionName(section)} share of Terminal income in {MonthLabel}")"></progress>
                <dl class="tmr-card-facts">
                    <div><dt>Collections</dt><dd>@(Ready ? rows.Count.ToString("N0", CultureInfo.InvariantCulture) : "—")</dd></div>
                    <div><dt>Share of month</dt><dd>@(Ready ? Share(net) : "—")</dd></div>
                    <div><dt>Last collected</dt><dd>@(Ready && rows.Count > 0 ? rows.Max(x => x.BusinessDate).ToString("MMM d", CultureInfo.InvariantCulture) : "—")</dd></div>
                </dl>
            </section>
        }
    </div>
</MonthExtras>
</OperationReportsPage>

@code {
    private DateOnly ShellMonth => new(_month.Year, _month.Month, 1);

    private async Task OnShellMonthAsync(DateOnly month)
    {
        _month = month;
        _monthInput = month.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
        await LoadAsync();
    }

    private List<TerminalSectionSettingsStore.SectionView> _terminalSettings = [];
    private IReadOnlyList<TerminalSection> Sections => Enum.GetValues<TerminalSection>()
        .Where(section => _terminalSettings.Count == 0 || _terminalSettings.Any(x => x.Section == section && x.IsEnabled)
            || _rows.Any(x => x.Section == section)).ToArray();
    private string SectionName(TerminalSection section) =>
        _terminalSettings.FirstOrDefault(x => x.Section == section)?.DisplayName ?? OfficeCollectionWorkflow.SectionName(section);

    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private List<SourceNativeActivityDto> _rows = [];
    private bool _loading = true;
    private string? _error;

    private string MonthLabel => _month.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private bool Ready => !_loading && _error is null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var settings = await OperationSettingsApi.GetTerminalSectionsAsync();
            if (settings.IsSuccess && settings.Value is { } values) _terminalSettings = values.ToList();
            else { _terminalSettings = []; _error = "Terminal section configuration could not be loaded."; }
            var result = await OfficeApi.ActivityAsync(_month, _month.AddMonths(1).AddDays(-1), CollectorOperationCodes.Terminal);
            if (result.IsSuccess) _rows = result.Value?.ToList() ?? [];
            else { _rows = []; _error = "The Terminal collections couldn't be loaded."; }
        }
        catch
        {
            _rows = [];
            _error = "The Terminal collections couldn't be loaded.";
        }
        finally { _loading = false; }
    }

    private async Task PrintAsync()
    {
        if (Ready) await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");
    }

    private double SharePercent(decimal sectionNet)
    {
        var total = _rows.Sum(x => x.NetAmount);
        return total == 0m ? 0d : (double)(sectionNet / total * 100m);
    }

    private string Share(decimal sectionNet)
    {
        var total = _rows.Sum(x => x.NetAmount);
        return total == 0m ? "—" : (sectionNet / total * 100m).ToString("N1", CultureInfo.InvariantCulture) + "%";
    }

    private string ExportHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    private string BuildCsv()
    {
        var lines = new List<string>
        {
            Csv("Report", "Income From Terminal Report"),
            Csv("Office", Branding.OfficeName),
            Csv("Municipality", $"{Branding.Municipality}, {Branding.Province}"),
            Csv("Reporting month", MonthLabel),
            Csv("Classification", "Income From Terminal"),
            Csv("Instrument", "Cash Ticket"),
            Csv("Date prepared", PhilippineTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
            string.Empty,
            Csv("Date", "SRC", "Section", "Collector", "Amount"),
        };
        lines.AddRange(_rows.OrderBy(x => x.BusinessDate).Select(x => Csv(
            x.BusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), x.SRC,
            x.Section is { } s ? SectionName(s) : "", x.CollectorName ?? "",
            x.NetAmount.ToString("0.00", CultureInfo.InvariantCulture))));
        return string.Join("\r\n", lines);
    }

    private static string Csv(params string?[] values) =>
        string.Join(",", values.Select(v => $"\"{(v ?? string.Empty).Replace("\"", "\"\"")}\""));

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
