@page "/operations/fiesta-araw/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums

<PageTitle>StallTrack — Fiesta | Araw Report</PageTitle>

@* Fiesta | Araw report: the operation reports layout (Monthly, Yearly, Status Report, History) around its obligation report (ObligationOperationReport). The layout owns the
   <main> landmark. *@
<OperationReportsPage Name="Fiesta | Araw" ParentHref="/operations/fiesta-araw" RowKey="FIESTA_ARAW_LOT_RENTAL" SeriesLabel="Rent collected" @bind-Month="_month">
    <StatusReport>
        <ObligationOperationReport Kind="ObligationKind.FiestaArawLotRental" Name="Fiesta | Araw" ParentHref="/operations/fiesta-araw" RowKey="FIESTA_ARAW_LOT_RENTAL" Classification="Fiesta / Araw lot rental"
                                   SubjectNoun="Lot" IdPrefix="far" ShowEvent="true" Basis="A temporary event lot at the amount the office approved. The event date is not a billing date."
                                   Embedded="true" Year="_month.Year" />
    </StatusReport>
</OperationReportsPage>

@code {
    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
}
