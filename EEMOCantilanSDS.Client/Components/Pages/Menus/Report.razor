@page "/reports"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using Microsoft.AspNetCore.Components
@using EEMOCantilanSDS.Application.Dtos.Reports
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IReportsApiClient ReportsApi
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Financial Reports</PageTitle>

<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-title">Financial Reports</div>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Reports</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            Generated @GeneratedOn.ToString("MMM d, yyyy · h:mm tt")
        </div>
        <AccountChip />
    </div>
</header>

@* Two documents leave this page, and which one is decided in CSS by a class the print helper adds for the duration of the
   print. Summary prints the letterhead, KPIs, trend and facility breakdown — the report the office signs off. Register
   prints the letterhead and the collection register, the evidence behind those figures.

   The class is added by JS rather than held as page state, because Blazor Server would have to round-trip the render to the
   browser before window.print() fired, and a print that races a render is a print that sometimes contains the wrong
   document. *@
<div id="rpt-sheet" class="content-area">

    @* The "Reporting period / Scope / Frequency" strip was removed: every one of the three was already stated by the
       controls immediately below it — the period pills and year/month pickers, the facility chips, and the Monthly/Annual
       choice — and the summary badge at the end of the facility row repeats the resolved answer. What the strip did carry
       that nothing else did is the refresh state, which is why that has moved onto the facility row rather than going with
       it. Its placement there is deliberate: as a loose strip above the sheet it pushed the whole report down each time a
       facility chip was pressed. *@
    <!-- FILTER PANEL -->
    <div class="rpt-filter-panel">
        <div class="rfp-top">
            @* Section comes first: it decides WHAT the office is looking at, and the period and facility controls then
               narrow it. All five sections stay in the DOM and the inactive ones are hidden by a SCREEN-ONLY rule, never
               removed — Export Summary PDF prints the letterhead, KPIs, Trend and By facility from the @media print
               block, so dropping them from the markup would have printed an empty report whenever the office happened to
               be looking at Records. Styled as the dashboard's report tabs, with the active pill the same treatment as
               the Monthly/Annual pills beside it. *@
            <div class="rfp-ctrl rfp-jump no-print">
                <div class="rfp-label">Section</div>
                <div class="rpt-sec-tabs" role="tablist" aria-label="Report section">
                    @foreach (var s in ReportSections)
                    {
                        <button type="button" class="rpt-sec-tab @(_section == s.Key ? "on" : "")"
                                role="tab" aria-selected="@(_section == s.Key ? "true" : "false")"
                                @onclick="() => _section = s.Key">@s.Label</button>
                    }
                </div>
            </div>

            <div class="rfp-ctrl">
                <div class="rfp-label">Period</div>
                <div class="rfp-period-pills">
                    <button class="rpp @(ActiveTab == "Monthly" ? "on" : "")" @onclick='() => SetTab("Monthly")'>Monthly</button>
                    <button class="rpp @(ActiveTab == "Annual" ? "on" : "")" @onclick='() => SetTab("Annual")'>Annual</button>
                </div>
            </div>

            <div class="rfp-ctrl">
                <FhSelect Caption="Year" Value="@SelectedYear" Options="@YearOptions" ValueChanged="OnYearChanged" />
            </div>

            @if (ActiveTab == "Monthly" && SelectedYear != "all")
            {
                <div class="rfp-ctrl">
                    <FhSelect Caption="Month" Value="@SelectedMonth" Options="@MonthOptions" ValueChanged="OnMonthChanged" />
                </div>
            }

            <div class="rfp-export">
                @* Opens the Financial Summary document, which is built for paper: every section of the report stated once
                   in filing order, whatever tab this screen happens to be on. It used to print THIS page, so the sheet
                   inherited the screen's cards and broke wherever they fell, and stated only the sections the office had
                   not navigated away from. A new tab, because the office is leaving a screen it is working in. *@
                <a class="rpt-btn-pdf" href="@SummaryDocumentUrl" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="15" y2="17" /></svg>
                    Export Summary PDF
                </a>
            </div>
        </div>

        <div class="rfp-divider"></div>

        <div class="rfp-bottom">
            <div class="rfp-fac-row">
                <div class="rfp-label rfp-label-inline">Facility</div>
                <div class="rfp-chips">
                    @foreach (var (codes, label) in FacilityOptions)
                    {
                        var fc = codes;
                        <button class="rfp-chip @(SelectedFacility == fc ? "on" : "")" title="@label" @onclick='() => SelectFacility(fc)'>
                            @(codes == "All" ? "All" : ChipLabel(codes))
                        </button>
                    }
                </div>
            </div>
            <div class="rfp-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <strong>@ScopeLabel</strong>&nbsp;·&nbsp;<strong>@PeriodLabel</strong>
            </div>
            @* Rehomed from the scope strip that used to sit above the sheet. Beside the badge that already states the
               resolved scope and period, which is what is being refreshed. *@
            @if (Loading && Model is not null)
            {
                <div class="rpt-scope-state no-print" role="status" aria-live="polite">
                    <span class="rpt-refreshing-dot"></span> Refreshing @PeriodLabel…
                </div>
            }
        </div>
    </div>

    @if (Loading && Model is null)
    {
        <div class="rpt-loading no-print" aria-busy="true" aria-label="Loading financial report">
            <div class="kpi-row">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="kpi-card">
                        <div class="kpi-body rpt-loading-kpi">
                            <Skeleton Width="64%" Height="24px" Radius="7px" />
                            <Skeleton Width="44%" Height="11px" Radius="5px" />
                            <Skeleton Width="72%" Height="10px" Radius="5px" />
                        </div>
                    </div>
                }
            </div>

            <div class="rpt-loading-grid">
                <div class="rpt-loading-panel rpt-loading-panel-wide">
                    <div class="rpt-loading-panel-head">
                        <Skeleton Width="220px" Height="18px" Radius="6px" />
                        <Skeleton Width="110px" Height="34px" Radius="9px" />
                    </div>
                    <div class="rpt-loading-bars">
                        @for (var i = 0; i < 6; i++)
                        {
                            var height = $"{44 + (i % 3) * 18}px";
                            <Skeleton Height="@height" Radius="8px" />
                        }
                    </div>
                </div>

                <div class="rpt-loading-panel">
                    <div class="rpt-loading-panel-head">
                        <Skeleton Width="150px" Height="18px" Radius="6px" />
                    </div>
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="rpt-loading-row">
                            <Skeleton Width="38px" Height="38px" Radius="999px" />
                            <div class="rpt-loading-row-text">
                                <Skeleton Width="72%" Height="13px" Radius="6px" />
                                <Skeleton Width="46%" Height="10px" Radius="5px" />
                            </div>
                            <Skeleton Width="64px" Height="13px" Radius="6px" />
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model is null)
    {
        <div class="rpt-state rpt-state-error">
            Unable to load the report for @PeriodLabel.
            <button class="rpt-retry" @onclick="Load">Try again</button>
        </div>
    }
    else
    {
        <!-- PRINT / PDF HEADER (only visible when printing) -->
        <div class="rpt-pdf-header pdf-include">
            <img class="rpt-pdf-logo" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
            <div class="rpt-pdf-republic">Republic of the Philippines</div>
            <div class="rpt-pdf-office">@Branding.OfficeName</div>
            <div class="rpt-pdf-muni">Municipality of @Branding.Municipality, @Branding.Province</div>
            <div class="rpt-pdf-title">Financial Report — @PeriodLabel</div>
            <div class="rpt-pdf-meta">
                <span>Scope: <strong>@ScopeLabel</strong></span>
                <span>Frequency: <strong>@FrequencyLabel</strong></span>
                <span>Generated: <strong>@GeneratedOn.ToString("MMM d, yyyy · h:mm tt")</strong></span>
            </div>
        </div>

        <!-- FINANCIAL POSITION — KPIs -->
        <div id="rpt-overview" class="kpi-row pdf-include@(SectionOff("overview"))">
            @* Billed leads, because it is the figure the other three answer to: Billed = Collected + Current-period unpaid,
               which is why these four reconcile as a statement of position rather than reading as four unrelated numbers.
               It was previously stated only as sub-text under the collection rate.

               Paid collection records left this row for the strip below it. The count is operational — how many entries
               were encoded — where the other three are money, and a government report should lead with what was assessed
               and what came in. Nothing was dropped: it is still stated, with its coverage and the facility count. *@
            <div class="kpi-card">
                <div class="kpi-icon-wrap navy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="15" y2="17" /></svg>
                </div>
                <div class="kpi-body">
                    <div class="kpi-value">@Money(Model.Billed)</div>
                    <div class="kpi-label">Assessed — @PeriodLabel</div>
                    <div class="kpi-sub">Collected plus the balance still due</div>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon-wrap green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h7a4 4 0 0 1 0 8H6z" /><line x1="4" y1="9" x2="16" y2="9" /><line x1="4" y1="13" x2="16" y2="13" /><line x1="6" y1="4" x2="6" y2="20" /></svg>
                </div>
                <div class="kpi-body">
                    <div class="kpi-value">@Money(Model.Collected)</div>
                    <div class="kpi-label">Collected — @PeriodLabel</div>
                    @if (Model.CollectedPreviousPeriod is decimal prev && Model.PreviousPeriodLabel is not null && prev > 0)
                    {
                        var deltaAbs = Model.Collected - prev;
                        var deltaPct = deltaAbs / prev * 100m;
                        var up = deltaAbs >= 0;
                        // A percentage from a near-zero prior period (e.g. a pre-rollout month) is
                        // misleading — a swing of 10x or more shows the actual peso movement plus the
                        // prior base instead, which stays honest at any LGU's collection scale.
                        if (Math.Abs(deltaPct) < 1000m)
                        {
                            <div class="kpi-sub"><span class="@(up ? "up" : "down")">@(up ? "↑" : "↓") @Math.Abs(deltaPct).ToString("0.0")%</span> vs @Model.PreviousPeriodLabel</div>
                        }
                        else
                        {
                            <div class="kpi-sub"><span class="@(up ? "up" : "down")">@(up ? "↑" : "↓") @Money(Math.Abs(deltaAbs))</span> vs @Model.PreviousPeriodLabel (@Money(prev))</div>
                        }
                    }
                    else
                    {
                        <div class="kpi-sub">Recorded collections this period</div>
                    }
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon-wrap red">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="kpi-body">
                    <div class="kpi-value">@Money(Model.CurrentPeriodUnpaid)</div>
                    <div class="kpi-label">Current-period unpaid balance</div>
                    <div class="kpi-sub">Billed but uncollected for @PeriodLabel</div>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon-wrap gold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                </div>
                <div class="kpi-body">
                    <div class="kpi-value">@Model.CollectionRatePct%</div>
                    <div class="kpi-label">Collection rate (by amount)</div>
                    <div class="kpi-sub">@Money(Model.Collected) of @Money(Model.Billed) billed</div>
                </div>
            </div>
        </div>

        @* The Overview's body. Two panels answering questions the four cards above cannot: where the money came from, and
           what is still owed. Both are derived from figures the report already carries — no new query — and both sit
           inside the Overview section, so they hide with the tab and print with the KPIs.

           The record count that used to be a lone strip across the page now lives in the first panel's footer. Three
           loose numbers on a full-width bar read as leftovers; beside the composition they describe they read as
           context, which is what they are. *@
        <div class="rpt-panels pdf-include@(SectionOff("overview"))">
            <div class="rpt-panel">
                <div class="rpt-panel-title">Collection by model</div>
                <div class="rpt-panel-note">Recurring rent can fall into arrears; a service fee cannot.</div>
                @{
                    // Derived from the headline figure rather than by summing every row, so the two parts always add back
                    // to Collected. Summing the facility rows independently would let a rounding or grouping difference
                    // put a composition on screen that disagrees with the card above it.
                    var serviceCollected = Model.Facilities.Where(f => f.PaidOnService).Sum(f => f.Collected);
                    var recurringCollected = Model.Collected - serviceCollected;
                    var sharePct = (decimal share) => Model.Collected > 0m ? share / Model.Collected * 100m : 0m;
                }
                <div class="rpt-split">
                    <div class="rpt-split-part">
                        <div class="rpt-split-val">@Money(recurringCollected)</div>
                        <div class="rpt-split-label">Recurring · @sharePct(recurringCollected).ToString("0.0")%</div>
                        <div class="rpt-split-sub">Daily stall and monthly rental</div>
                    </div>
                    <div class="rpt-split-part">
                        <div class="rpt-split-val">@Money(serviceCollected)</div>
                        <div class="rpt-split-label">Paid on service · @sharePct(serviceCollected).ToString("0.0")%</div>
                        <div class="rpt-split-sub">Per-head, per-trip and market-day</div>
                    </div>
                </div>
                <div class="rpt-panel-foot">
                    <strong>@Model.PaidRecords</strong> of <strong>@Model.ExpectedRecords</strong> expected records recorded
                    across <strong>@Model.FacilityCount</strong> facilit@(Model.FacilityCount == 1 ? "y" : "ies")
                </div>
                @* The headline rate divides all collections by all billings. A service fee is in both halves and can never
                   be owed, so it pulls the rate toward 100% and the figure stops describing how well rent is collected.
                   Stated here, beside the split it depends on, rather than qualifying the card itself. *@
                @{
                    var recurringBilled = recurringCollected + Model.CurrentPeriodUnpaid;
                    var recurringRate = recurringBilled > 0m
                        ? (int)Math.Round(recurringCollected / recurringBilled * 100m)
                        : 0;
                }
                @if (serviceCollected > 0m && recurringBilled > 0m && recurringRate != Model.CollectionRatePct)
                {
                    <div class="rpt-panel-foot">
                        Rate on recurring rent alone <strong>@recurringRate%</strong>
                        <span class="rpt-panel-aside">against @Model.CollectionRatePct% overall</span>
                    </div>
                }
            </div>

            <div class="rpt-panel">
                <div class="rpt-panel-title">Outstanding position</div>
                <div class="rpt-panel-note">Separate scopes. Not to be added.</div>
                <div class="rpt-pos">
                    <div class="rpt-pos-row">
                        <span class="rpt-pos-label">This period</span>
                        <span class="rpt-pos-val">@Money(Model.CurrentPeriodUnpaid)</span>
                    </div>
                    <div class="rpt-pos-row">
                        <span class="rpt-pos-label">Whole account</span>
                        <span class="rpt-pos-val">
                            @Money(Model.DelinquentOutstandingTotal + Model.ArrearsOutstandingTotal)
                            <span class="rpt-pos-count">@(Model.DelinquentAccountsTotal + Model.ArrearsAccountsTotal) accounts</span>
                        </span>
                    </div>
                    @* Named rather than described. "Lapsed term exposure" is the office's own term, and the qualifier says
                       which figure it is part of, so the indent is not carrying that meaning on its own. *@
                    <div class="rpt-pos-row is-part">
                        <span class="rpt-pos-label">Lapsed term exposure <span class="rpt-pos-of">within whole account</span></span>
                        <span class="rpt-pos-val">
                            @Money(Model.LapsedWithBalanceOutstanding)
                            <span class="rpt-pos-count">@Model.LapsedWithBalanceCount occupanc@(Model.LapsedWithBalanceCount == 1 ? "y" : "ies")</span>
                        </span>
                    </div>
                    <div class="rpt-pos-row">
                        <span class="rpt-pos-label">Former occupancies</span>
                        <span class="rpt-pos-val">
                            @Money(Model.ClosedWithBalanceOutstanding)
                            <span class="rpt-pos-count">@Model.ClosedWithBalanceCount account@(Model.ClosedWithBalanceCount == 1 ? "" : "s")</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* ATTENTION & FOLLOW-UP — rendered only while its own tab is open.

           The sections that carry pdf-include cannot be treated this way — Overview, Trend and By facility — because
           Export Summary PDF is assembled by the print stylesheet from the whole page, whatever tab happens to be
           showing, so they must exist at all times and are hidden by a screen-only class instead. This section and the
           register carry no pdf-include, and the register's print button sits inside the register itself, so neither can
           be asked to print while it is closed. Leaving them out spares the office a hundred-odd table rows it is not
           looking at on every re-render. *@
        if (SectionShown("followup"))
        {
        <div id="rpt-followup" class="section-card rpt-attention-wrap" style="margin-bottom:20px;">
            <div class="section-header">
                <div>
                    <div class="section-title">Attention &amp; Follow-up</div>
                    @* Figures, not sentences. The header was two lines of description where the office wanted the numbers
                       it is being asked to act on: how many accounts, what they owe, and how much of that is behind an
                       expired term and so settled by renewing rather than by chasing. The span is kept because a follow-up
                       figure means nothing without knowing which month it stops at, but it is stated as a value now. *@
                    <div class="rpt-attn-stats">
                        <span class="rpt-attn-stat">
                            <span class="rpt-attn-stat-val">@FollowUpAccounts</span>
                            <span class="rpt-attn-stat-key">accounts</span>
                        </span>
                        <span class="rpt-attn-stat">
                            <span class="rpt-attn-stat-val is-owed">@Money(FollowUpOutstanding)</span>
                            <span class="rpt-attn-stat-key">outstanding in full</span>
                        </span>
                        @if (Model.LapsedWithBalanceCount > 0)
                        {
                            <span class="rpt-attn-stat">
                                <span class="rpt-attn-stat-val">@Money(Model.LapsedWithBalanceOutstanding)</span>
                                <span class="rpt-attn-stat-key">behind an expired term</span>
                            </span>
                        }
                        <span class="rpt-attn-stat">
                            <span class="rpt-attn-stat-val">@(string.IsNullOrEmpty(Model.AttentionSpanLabel) ? LastClosedMonthLabel : Model.AttentionSpanLabel)</span>
                            <span class="rpt-attn-stat-key">counted to</span>
                        </span>
                    </div>
                </div>
                @* This section states WHO owes and how much; it does not act. Encoding a missing OR, reviewing a contract,
                   recording a payment or checking an excused entry all happen on the follow-up queue, which carries those
                   categories as well as these two. The handoff is stated rather than left for the office to know. *@
                <a class="rpt-attn-link no-print" href="/reports/follow-up">Open full Follow-up Queue →</a>
            </div>
            @* Receivable aging earns its place only when the debt actually spans more than one band. With every account in
               the youngest band it repeats the arrears count beside it, and naming the empty bands states an absence the
               office already knows — the ages are a scale for reading a schedule, not a prediction that anyone will reach
               them. So the panel appears when there is a spread to show, and stays away when there is not. *@
            @if (Model.Aging.Count(b => b.Accounts > 0) > 1)
            {
                var filled = Model.Aging.Where(b => b.Accounts > 0).ToList();

                <div class="rpt-aging">
                    <div class="rpt-aging-head">
                        <span class="rpt-aging-label">Receivable aging</span>
                        @if (Model.LapsedWithBalanceCount > 0)
                        {
                            <span class="rpt-aging-lapsed">
                                Lapsed term exposure <strong>@Money(Model.LapsedWithBalanceOutstanding)</strong>
                                · @Model.LapsedWithBalanceCount occupanc@(Model.LapsedWithBalanceCount == 1 ? "y" : "ies")
                            </span>
                        }
                    </div>
                    <div class="rpt-aging-bands" style="--rpt-aging-count: @filled.Count">
                        @foreach (var band in filled)
                        {
                            <div class="rpt-aging-band">
                                <div class="rpt-aging-band-span">@band.Label</div>
                                <div class="rpt-aging-band-val">@Money(band.Outstanding)</div>
                                <div class="rpt-aging-band-count">@band.Accounts account@(band.Accounts == 1 ? "" : "s")</div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.LapsedWithBalanceCount > 0)
            {
                @* No spread worth a schedule, but a lapsed term still wants renewing, so that one figure is kept. *@
                <div class="rpt-aging rpt-aging-lean">
                    <span class="rpt-aging-label">Lapsed term exposure</span>
                    <span class="rpt-aging-lapsed">
                        <strong>@Money(Model.LapsedWithBalanceOutstanding)</strong>
                        · @Model.LapsedWithBalanceCount occupanc@(Model.LapsedWithBalanceCount == 1 ? "y" : "ies") still in place
                    </span>
                </div>
            }
            @* When one side is empty the grid still reserved half the sheet for it and stretched it to the other side's
               height, leaving a large void with a search box over nothing. A column with no accounts is given only the
               width it needs, and its search box is dropped — there is nothing to search. *@
            <div class="rpt-attention @(Model.DelinquentAccountsTotal == 0 ^ Model.ArrearsAccountsTotal == 0 ? "is-lopsided" : "")">
                <div class="attn-col">
                    <div class="attn-col-head">
                        <span class="attn-col-title attn-delinquent">Delinquent accounts</span>
                        <span class="attn-count attn-count-red">@Model.DelinquentAccountsTotal</span>
                    </div>
                    @* Stated from the office's own threshold rather than typed as "3", so the note cannot come to contradict
                       the figure beside it. The handler splits the two lists by the same constant. *@
                    <div class="attn-col-note">@DomainRules.DelinquentThresholdMonths or more unpaid months</div>
                    @if (Model.DelinquentAccountsTotal > 0)
                    {
                        <div class="attn-search">
                            <input type="search" value="@_delinquentSearch" @oninput="e => _delinquentSearch = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Search name or stall no.…" aria-label="Search delinquent accounts" />
                        </div>
                    }
                    <div class="delinq-list">
                        @{ var delinquentRows = Filtered(Model.Delinquent, _delinquentSearch); }
                        @if (Model.DelinquentAccountsTotal == 0)
                        {
                            @* "No delinquent accounts" read as "nothing is badly behind" while money sat in the block below
                               it: the office saw 0 here beside ₱11,370 owed by former occupancies. These lists count only
                               accounts still being billed, and that is the honest scope — a debt cannot be stated in both
                               places or the page contradicts its own totals. So the empty state points at where the money
                               is. Deliberately ONE line and not a copy of the card below: the same figure written out
                               twice on one screen is the very thing the page is careful not to do. *@
                            <div class="rpt-empty">
                                No delinquent accounts for @PeriodLabel.
                                @if (Model.ClosedWithBalanceCount > 0)
                                {
                                    <a class="rpt-empty-note" href="/reports/closed-accounts?status=ended">
                                        <span class="rpt-empty-note-val">@Money(Model.ClosedWithBalanceOutstanding)</span>
                                        <span class="rpt-empty-note-text">owed by former occupancies</span>
                                        <span class="rpt-empty-note-go" aria-hidden="true">→</span>
                                    </a>
                                }
                            </div>
                        }
                        else if (delinquentRows.Count == 0)
                        {
                            <div class="rpt-empty">No delinquent account matches “@_delinquentSearch”.</div>
                        }
                        @foreach (var d in delinquentRows)
                        {
                            <a href="@ProfileUrl(d)" class="delinq-item-link">
                                <div class="delinq-item">
                                    <div class="delinq-avatar">@Initials(d.Name)</div>
                                    <div class="delinq-info">
                                        <div class="delinq-name">@d.Name</div>
                                        <div class="delinq-loc">
                                            @d.Location
                                            @if (d.TermLapsed)
                                            {
                                                <span class="attn-lapsed" title="The contract term has run out and the space was not handed over. Still collected; needs renewing.">Lapsed</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="delinq-amount">
                                        <div class="delinq-amt-val">@Money(d.Balance)</div>
                                        <div class="delinq-months attn-age-red">@MonthsLabel(d.UnpaidMonths)</div>
                                    </div>
                                </div>
                            </a>
                        }
                        @if (Model.DelinquentAccountsTotal > Model.Delinquent.Count)
                        {
                            @* The list is capped; the count and the money above are not. Said plainly so the page is never
                               read as the whole register. *@
                            <div class="attn-capped">
                                Showing the @Model.Delinquent.Count most overdue of @Model.DelinquentAccountsTotal.
                                The figures above count every account.
                            </div>
                        }
                    </div>
                </div>
                <div class="attn-col">
                    <div class="attn-col-head">
                        <span class="attn-col-title attn-arrears">Accounts in arrears</span>
                        <span class="attn-count attn-count-amber">@Model.ArrearsAccountsTotal</span>
                    </div>
                    <div class="attn-col-note">1–@(DomainRules.DelinquentThresholdMonths - 1) unpaid months</div>
                    @if (Model.ArrearsAccountsTotal > 0)
                    {
                        <div class="attn-search">
                            <input type="search" value="@_arrearsSearch" @oninput="e => _arrearsSearch = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Search name or stall no.…" aria-label="Search accounts in arrears" />
                        </div>
                    }
                    <div class="delinq-list">
                        @{ var arrearsRows = Filtered(Model.Arrears, _arrearsSearch); }
                        @if (Model.ArrearsAccountsTotal == 0)
                        {
                            <div class="rpt-empty">No accounts in arrears for @PeriodLabel.</div>
                        }
                        else if (arrearsRows.Count == 0)
                        {
                            <div class="rpt-empty">No account in arrears matches “@_arrearsSearch”.</div>
                        }
                        @foreach (var d in arrearsRows)
                        {
                            <a href="@ProfileUrl(d)" class="delinq-item-link">
                                <div class="delinq-item">
                                    <div class="delinq-avatar">@Initials(d.Name)</div>
                                    <div class="delinq-info">
                                        <div class="delinq-name">@d.Name</div>
                                        <div class="delinq-loc">
                                            @d.Location
                                            @if (d.TermLapsed)
                                            {
                                                <span class="attn-lapsed" title="The contract term has run out and the space was not handed over. Still collected; needs renewing.">Lapsed</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="delinq-amount">
                                        <div class="delinq-amt-val amber">@Money(d.Balance)</div>
                                        <div class="delinq-months attn-age-amber">@MonthsLabel(d.UnpaidMonths)</div>
                                    </div>
                                </div>
                            </a>
                        }
                        @if (Model.ArrearsAccountsTotal > Model.Arrears.Count)
                        {
                            <div class="attn-capped">
                                Showing the @Model.Arrears.Count most overdue of @Model.ArrearsAccountsTotal.
                                The figures above count every account.
                            </div>
                        }
                    </div>
                </div>
            </div>
            @if (Model.ClosedWithBalanceCount > 0)
            {
                <a href="/reports/closed-accounts?status=ended" class="rpt-closed-note">
                    <div class="rpt-closed-note-info">
                        <div class="rpt-closed-note-title">Balances from former occupancies</div>
                        @* Every account in the lists above has an expired term too — most of Cantilan's read
                           "Jun 2023 → Jun 7, 2026" — so "ended" cannot be the distinction. What separates these is
                           that the space is no longer held by that lessee, and nothing further is billed to them. *@
                        <div class="rpt-closed-note-sub">The lessee no longer holds the space — closed, re-let, or a term they have since renewed onto. Nothing further is billed to it. A term that expired while the lessee remains in the stall is billed as normal and is in the lists above</div>                    </div>
                    <div class="rpt-closed-note-amount">
                        <div class="rpt-closed-note-val">@Money(Model.ClosedWithBalanceOutstanding)</div>
                        <div class="rpt-closed-note-count">@Model.ClosedWithBalanceCount account@(Model.ClosedWithBalanceCount == 1 ? "" : "s") · view →</div>
                    </div>
                </a>
            }
            else
            {
                @* Stated even when nothing is outstanding there, so the two lists above are never read as the whole
                   picture: a frozen or lapsed account's debt is reported by the register, not here. *@
                <a href="/reports/closed-accounts" class="rpt-closed-hint">
                    Accounts that have ended are stated in the Register of Inactive Stall Accounts →
                </a>
            }
        </div>
        }

        <!-- REVENUE TREND -->
        <div id="rpt-trend" class="section-card pdf-include rpt-trend-card@(SectionOff("trend"))" style="margin-bottom:20px;">
            <div class="section-header">
                <div>
                    <div class="section-title">Revenue Trend</div>
                    <div class="section-sub">@ScopeLabel · amounts in ₱</div>
                </div>
            </div>
            <div class="chart-wrap">
                @if (TrendBars.Count == 0)
                {
                    <div class="rpt-empty">No trend data for @PeriodLabel.</div>
                }
                else
                {
                    <div class="chart-legend">
                        <div class="legend-item"><div class="legend-dot" style="background:var(--navy)"></div> Collected</div>
                        <div class="legend-item"><div class="legend-dot" style="background:var(--gold)"></div> Selected period</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#dde4ea"></div> Current-period unpaid balance</div>
                    </div>
                    <div class="rpt-trend-plot">
                        <div class="rpt-yaxis" aria-hidden="true">
                            @foreach (var lbl in AxisLabels)
                            {
                                <span>@lbl</span>
                            }
                        </div>
                        <div class="rpt-plot">
                            <div class="rpt-grid" aria-hidden="true">
                                @foreach (var _ in AxisLabels)
                                {
                                    <div class="rpt-grid-line"></div>
                                }
                            </div>
                            <div class="bar-chart">
                                @{ var bi = 0; }
                                @foreach (var m in TrendBars)
                                {
                                    var delay = $"{bi * 70}ms";
                                    <div class="bar-group" @key="(_renderEpoch, bi)">
                                        <div class="bar-wrap" aria-label="@m.Label — collected @Money(m.Collected), unpaid @Money(m.Unpaid)">
                                            <div class="bar @(m.IsSelected ? "gold-bar" : "collected")" style="height:@Pct(m.Collected)%;animation-delay:@delay"></div>
                                            <div class="bar unpaid" style="height:@Pct(m.Unpaid)%;animation-delay:@delay"></div>
                                            <div class="bar-tip" role="tooltip">
                                                <div class="bar-tip-title">@m.Label</div>
                                                <div class="bar-tip-row"><span class="bar-tip-dot tip-collected"></span><span class="bar-tip-key">Collected</span><span class="bar-tip-val">@Money(m.Collected)</span></div>
                                                <div class="bar-tip-row"><span class="bar-tip-dot tip-unpaid"></span><span class="bar-tip-key">Unpaid</span><span class="bar-tip-val">@Money(m.Unpaid)</span></div>
                                            </div>
                                        </div>
                                        <div class="bar-month" style="@(m.IsSelected ? "color:var(--gold);font-weight:700" : "")">@m.Label@(m.IsSelected ? " ●" : "")</div>
                                    </div>
                                    bi++;
                                }
                            </div>
                        </div>
                    </div>
                    @* The chart answers which direction; this answers by how much. It is also the part that survives being
                       printed and discussed at a desk, where a bar two pixels tall says nothing. The rate per period is
                       collected over collected-plus-unpaid — the same identity the headline rate uses, so a period's rate
                       here and the card above can never disagree. *@
                    @if (Model.Trend.Count > 0)
                    {
                        <div class="rpt-trend-table-wrap">
                            <table class="rpt-trend-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Period</th>
                                        <th scope="col" class="r">Collected</th>
                                        <th scope="col" class="r">Unpaid</th>
                                        <th scope="col" class="r">Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Trend)
                                    {
                                        var pBilled = p.Collected + p.Unpaid;
                                        <tr class="@(p.IsSelected ? "is-selected" : "")">
                                            <td>
                                                @p.Label
                                                @if (p.IsSelected)
                                                {
                                                    <span class="rpt-trend-here">selected</span>
                                                }
                                            </td>
                                            <td class="r">@Money(p.Collected)</td>
                                            <td class="r is-owed">@Money(p.Unpaid)</td>
                                            <td class="r">@(pBilled > 0m ? Math.Round(p.Collected / pBilled * 100m).ToString("0") + "%" : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* Movement rides on the totals line. It used to close the section as a panel of three figures, but two
                       of the three — the selected period and the one before it — are already rows in the table above, so the
                       panel restated the table. What the table cannot state is the change between them, so that is all that
                       is left here.

                       The near-zero guard is the one the Collected card uses: beyond ten times, the movement is stated in
                       pesos with the base named, because a percentage against a pre-rollout month makes any month look like
                       a thousandfold rise and two figures on one screen must not contradict each other. *@
                    <div class="rpt-ytd-note">
                        Collected across shown periods: <strong>@Money(Model.YtdCollected)</strong>
                        @if (Model.CollectedPreviousPeriod is decimal prevCollected && Model.PreviousPeriodLabel is not null && prevCollected > 0m)
                        {
                            var move = Model.Collected - prevCollected;
                            var movePct = move / prevCollected * 100m;
                            var rose = move >= 0m;
                            var moveBase = Math.Abs(movePct) < 1000m
                                ? $"({Math.Abs(movePct).ToString("0.0")}% of {Model.PreviousPeriodLabel})"
                                : $"(from {Money(prevCollected)} in {Model.PreviousPeriodLabel})";

                            @* The separators are character references, not spaces. Razor trims markup whitespace at the
                               leading edge of a code block, which is what once ran "₱6,128" straight into the percentage
                               beside it; a non-breaking space survives that trim and keeps the movement on the same visual
                               line as the total it qualifies. *@
                            <text>&#160;</text><span class="rpt-ytd-move @(rose ? "is-up" : "is-down")">@(rose ? "↑" : "↓") @Money(Math.Abs(move))</span><text>&#160;</text><span class="rpt-ytd-base">@moveBase</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- REVENUE BY FACILITY -->
        @* Print-only spacer: it owns the page break and the whitespace above the card, so the card's own
           border never sits against the top edge of the sheet. Invisible on screen. *@
        <div class="rpt-page-space" aria-hidden="true"></div>
        <div id="rpt-facility" class="section-card pdf-include@(SectionOff("facility"))" style="margin-bottom:20px;">
            <div class="section-header">
                <div>
                    @* The rate here is not the rate the Dashboard states for the same market, and the two get read side by
                       side. A mark next to the period rather than another sub-line: the rule is wanted when a figure is
                       questioned, not on every reading. Hover or focus shows it, a press pins it open for touch, and it
                       stays in the markup either way so the hover can work at all. Screen only. *@
                    <div class="section-title">
                        Revenue by Facility — @PeriodLabel<span class="rpt-rule-wrap no-print"><button type="button" class="rpt-rule-mark"
                                @onclick="() => _facilityRuleOpen = !_facilityRuleOpen"
                                aria-expanded="@(_facilityRuleOpen ? "true" : "false")"
                                aria-controls="rpt-facility-rule"
                                aria-label="How the rate in this table is measured">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="9" x2="10" y2="14" /><line x1="10" y1="6.2" x2="10" y2="6.3" stroke-width="2" /></svg>
                        </button><span id="rpt-facility-rule" class="rpt-rule-pop @(_facilityRuleOpen ? "is-open" : "")" role="note">
                            <span class="rpt-rule-key">Rate basis</span>
                            <span class="rpt-rule-line">Rate is <strong>collected ÷ (collected + unpaid)</strong> for the period.</span>
                            <span class="rpt-rule-line">Fish and utilities are collected with <strong>nothing assessed against them</strong>, so they push this rate up. The Dashboard compares <strong>daily fees with daily fees due</strong>, which is why it reads lower.</span>
                        </span></span>
                    </div>
                    <div class="section-sub">Collection differs by facility model; unpaid/rate apply only to billed cycles</div>
                </div>
            </div>
            <div class="rpt-table-scroll">
                <table class="fac-table">
                    <thead>
                        <tr>
                            <th scope="col">Facility</th>
                            <th scope="col">Collection model</th>
                            <th scope="col">Collected</th>
                            <th scope="col">Unpaid (period)</th>
                            <th scope="col">Paid / expected</th>
                            <th scope="col">Rate</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Facilities)
                        {
                            var expandable = f.Detail is not null;
                            var open = expandable && _expandedFacilities.Contains(f.Code);
                            <tr class="@(expandable ? "fac-expandable" : "")" @onclick="@(() => ToggleFacility(f.Code, expandable))">
                                <td>
                                    <div class="fac-name">
                                        @if (expandable)
                                        {
                                            <span class="fac-caret @(open ? "open" : "")">&#9654;</span>
                                        }
                                        <span class="fac-code-badge">@FacilityCatalog.ShortNameOf(f.Code)</span> @f.Name
                                    </div>
                                </td>
                                <td><span class="fac-model">@f.Model</span></td>
                                <td class="mono-num">@Money(f.Collected)</td>
                                <td class="mono-num" style="@(f.Unpaid.HasValue && f.Unpaid > 0 ? "color:var(--red);" : "color:var(--text-muted);")">@(f.Unpaid.HasValue ? Money(f.Unpaid.Value) : "—")</td>
                                @* Coverage, not a bare count: 284 means nothing until the office knows whether the roll was
                                   290 or 400. The expected figure was computed per facility all along and discarded before
                                   it reached here. A paid-on-service facility has no roll — every transaction IS the
                                   collection — so it keeps a plain count rather than a denominator invented for it. *@
                                <td class="mono-num">
                                    @if (f.PaidOnService || f.ExpectedRecords <= 0)
                                    {
                                        @f.PaidRecords
                                    }
                                    else
                                    {
                                        @f.PaidRecords<span class="fac-cov-sep"> / </span>@f.ExpectedRecords
                                    }
                                </td>
                                <td style="font-weight:700;color:@(f.RatePct.HasValue ? "var(--navy)" : "var(--text-muted)");">@(f.RatePct.HasValue ? f.RatePct + "%" : "—")</td>
                                <td><span class="status-pill @StatusClass(f.Status)">@f.Status</span></td>
                            </tr>
                            @if (open && f.Detail is { } nd)
                            {
                                @* What the row's Collected is made of. Electricity and water are named when any was
                                   collected, rather than falling into the leftover line, so the lines add up to the total
                                   in the column above.

                                   The panels beside this one are deliberately left as the office had them. Naming the
                                   utilities due inside Outstanding and totalling it there was tried and reverted: the
                                   subtotal landed above the full-month coverage lines, which made the group read as
                                   though it ended halfway down. What is owed on electricity and water keeps its own
                                   panel, where the office is used to finding it. *@
                                var utilities = nd.ElecCollected + nd.WaterCollected;
                                var other = f.Collected - nd.DailyFeeCollected - nd.FishCollected - utilities;
                                <tr class="fac-detail-row">
                                    <td colspan="7">
                                        <div class="fac-detail">
                                            <div class="fac-detail-group">
                                                <div class="fac-detail-heading">Collected breakdown</div>
                                                <div class="fac-detail-item"><span>Daily stall fee</span><strong>@Money(nd.DailyFeeCollected)</strong></div>
                                                <div class="fac-detail-item"><span>Fish KG</span><strong>@Money(nd.FishCollected)</strong></div>
                                                @if (utilities > 0)
                                                {
                                                    <div class="fac-detail-item"><span>Electricity &amp; water</span><strong>@Money(utilities)</strong></div>
                                                }
                                                @if (other > 0)
                                                {
                                                    <div class="fac-detail-item"><span>Other</span><strong>@Money(other)</strong></div>
                                                }
                                                <div class="fac-detail-item fac-detail-total"><span>Total collected</span><strong>@Money(f.Collected)</strong></div>
                                            </div>
                                            <div class="fac-detail-group">
                                                <div class="fac-detail-heading">Outstanding</div>
                                                <div class="fac-detail-item"><span>Unpaid this period</span><strong class="fac-detail-red">@Money(nd.PeriodBalance)</strong></div>
                                                @if (nd.FullMonthCoverage > 0)
                                                {
                                                    <div class="fac-detail-item"><span>Full-month coverage  ₱900</span><strong>@Money(nd.FullMonthCoverage)</strong></div>
                                                    @if (nd.ExcusedAmount > 0)
                                                    {                                            
                                                        <div class="fac-detail-item"><span>Absent</span><strong class="fac-detail-amber">@Money(nd.ExcusedAmount)</strong></div>
                                                    }
                                                    <div class="fac-detail-item"><span>Full-month coverage balance</span><strong class="fac-detail-red">@Money(nd.FullMonthCoverageBalance)</strong></div>
                                                }
                                            </div>
                                            @if (nd.ElecCollected > 0 || nd.WaterCollected > 0 || nd.UtilityOutstanding > 0)
                                            {
                                                <div class="fac-detail-group">
                                                    <div class="fac-detail-heading">Electricity &amp; Water</div>
                                                    <div class="fac-detail-item"><span>Electricity</span><strong>@Money(nd.ElecCollected)</strong></div>
                                                    <div class="fac-detail-item"><span>Water</span><strong>@Money(nd.WaterCollected)</strong></div>
                                                    <div class="fac-detail-item fac-detail-total"><span>Total collected</span><strong>@Money(utilities)</strong></div>
                                                </div>
                                            }
                                            @if (nd.UtilityOutstanding > 0)
                                            {
                                                <div class="fac-detail-group">
                                                    <div class="fac-detail-heading">Utilities Due</div>
                                                    <div class="fac-detail-item"><span>Electricity &amp; water</span><strong class="fac-detail-red">@Money(nd.UtilityOutstanding)</strong></div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fac-foot">
                            <td colspan="2"><strong>Total — @ScopeLabel</strong></td>
                            <td class="mono-num"><strong>@Money(Model.Collected)</strong></td>
                            <td class="mono-num" style="color:var(--red);"><strong>@Money(Model.CurrentPeriodUnpaid)</strong></td>
                            <td class="mono-num"><strong>@Model.PaidRecords</strong></td>
                            <td style="font-weight:700;color:var(--navy);"><strong>@Model.CollectionRatePct%</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @* What the total row cannot say. The 19% it states is one figure over two unlike things: a paid-on-service fee
               is in Collected but can never be in Unpaid, so every peso of it lifts the rate toward 100% while the whole
               outstanding balance sits on the billed facilities. Split here, at the rows it describes, using the same
               distinction the Overview's collection-by-model panel makes — the same idea twice, not two ideas.

               Both halves are derived from the totals rather than by summing the rows independently, so they always add back
               to the row above: the service side is summed and the billed side is what remains of Collected. *@
            @{
                var facServiceCollected = Model.Facilities.Where(f => f.PaidOnService).Sum(f => f.Collected);
                var facBilledCollected = Model.Collected - facServiceCollected;
                var facBilledBilled = facBilledCollected + Model.CurrentPeriodUnpaid;
                var facBilledRate = facBilledBilled > 0m ? (int)Math.Round(facBilledCollected / facBilledBilled * 100m) : 0;

                // The single largest share of what is owed. The table holds it, but only after the office has read eight
                // rows and done the arithmetic; naming it turns the table into a finding.
                var facWorst = Model.Facilities
                    .Where(f => !f.PaidOnService && (f.Unpaid ?? 0m) > 0m)
                    .OrderByDescending(f => f.Unpaid ?? 0m)
                    .FirstOrDefault();
            }
            <div class="fac-close">
                <div class="fac-close-split">
                    <div class="fac-close-part">
                        <div class="fac-close-key">Billed facilities</div>
                        <div class="fac-close-val">
                            @Money(facBilledCollected) collected
                            <span class="fac-close-aside">· @Money(Model.CurrentPeriodUnpaid) outstanding · @facBilledRate%</span>
                        </div>
                    </div>
                    <div class="fac-close-part">
                        <div class="fac-close-key">Paid on service</div>
                        <div class="fac-close-val">@Money(facServiceCollected) collected</div>
                    </div>
                </div>
                @if (facWorst is not null && Model.CurrentPeriodUnpaid > 0m)
                {
                    var worstShare = (facWorst.Unpaid ?? 0m) / Model.CurrentPeriodUnpaid * 100m;
                    <div class="fac-close-note">
                        Most of it is in one place: <strong>@Money(facWorst.Unpaid ?? 0m)</strong>
                        at @FacilityCatalog.ShortNameOf(facWorst.Code) @facWorst.Name,
                        @worstShare.ToString("0")% of everything outstanding this period.
                    </div>
                }
            </div>
        </div>

        @* COLLECTION REGISTER — rendered only while its own tab is open, for the reason given above the Attention
           section: it carries no pdf-include, and the button that prints it is inside it. *@
        if (SectionShown("records"))
        {
        <div id="rpt-records" class="section-card" style="margin-bottom:20px;">
            <div class="section-header">
                <div>
                    <div class="section-title">Collection register — @PeriodLabel</div>
                    @* The plain count and scope are gone: the title already names the period and the badge above states the
                       scope, so it was a third statement of the same thing. What remains is the one thing nothing else
                       says — that the list is capped — and it appears only when the cap is actually reached, so a complete
                       register carries no line at all. *@
                    @if (Model.RecentRecords.Count >= RegisterListLimit)
                    {
                        <div class="section-sub">The @RegisterListLimit most recent of this period</div>
                    }
                </div>
                <div class="rpt-register-actions no-print">
                    @* Its own print action rather than a place in the Summary PDF: the summary is the report the office
                       signs off, and fifty rows of evidence a period would make it a different document. *@
                    <button type="button" class="rpt-register-print" @onclick="PrintRegister" disabled="@(Model.RecentRecords.Count == 0)">
                        Print register
                    </button>
                    <a class="rpt-attn-link" href="/transactions">Open all transactions →</a>
                </div>
            </div>
            <div class="rpt-table-scroll">
                <table class="tx-table">
                    <thead>
                        <tr>
                            <th scope="col">OR / Ref #</th>
                            <th scope="col">Payor / Stall</th>
                            <th scope="col">Facility</th>
                            <th scope="col">Date</th>
                            <th scope="col">Type</th>
                            <th scope="col">Recorded by</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentRecords.Count == 0)
                        {
                            <tr><td colspan="7"><div class="rpt-empty">No records for @ScopeLabel.</div></td></tr>
                        }
                        @foreach (var tx in Model.RecentRecords)
                        {
                            <tr>
                                <td class="tx-id">@tx.Reference</td>
                                @* The column has always said "Payor / Stall" and shown only the payor. The stall was carried
                                   on the row all along — it is what the profile link is built from — so a register that
                                   names a facility but not the space inside it was stating less than it held. Three of
                                   Cantilan's market sections each hold a "Stall 1", so the payor's name alone does not
                                   identify what was collected on. *@
                                <td>
                                    <a href="@ProfileUrl(tx)" class="vendor-link">@tx.Payor</a>
                                    @if (!string.IsNullOrWhiteSpace(tx.StallNo))
                                    {
                                        <div class="tx-sub">@SpaceNumber.Describe(tx.StallNo)</div>
                                    }
                                </td>
                                <td><span class="fac-code-badge">@FacilityCatalog.ShortNameOf(tx.FacilityCode)</span></td>
                                <td style="color:var(--text-muted);font-size:12.5px;">@tx.RecordedAt.ToString("MMM d, yyyy")</td>
                                <td><span class="pay-method">@tx.Method</span></td>
                                @* Who took the money. The transaction feed has carried this since it was normalised, and this
                                   report dropped it on the way through — for an LGU register that is exactly the attribution
                                   worth keeping. Blank where the source has none rather than inventing an actor. *@
                                <td class="tx-actor">@(string.IsNullOrWhiteSpace(tx.Collector) ? "—" : tx.Collector)</td>
                                <td class="amount-green">@Money(tx.Amount)</td>
                            </tr>
                        }
                    </tbody>
                    @* A print-only footer. With the page margin at zero — which is what keeps the browser's date, title and
                       URL off a government document — nothing else can put whitespace at the FOOT of a continuation sheet:
                       the container's padding applies once, at the end of the flow. A table footer repeats on every page,
                       so this is the only element that can hold that space. Invisible on screen. *@
                    <tfoot class="tx-print-foot" aria-hidden="true">
                        <tr><td colspan="7"></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
        }

        @* MISCELLANEOUS — the period's metered electricity and water, per payor. Rendered only while its own tab is
           open, and outside the Summary PDF, for the same reasons as the register above.

           The office's own word: the month-end sheet calls this table Miscellaneous, and this is that table, through the
           same repository method, so a figure questioned on one document is found in the other. It states what was
           CHARGED — the one thing no other figure on this report says — and from whom. The money is already inside the
           report's Collected and Unpaid, so nothing here is added to any total; the closing line says so. *@
        if (SectionShown("misc"))
        {
        <div id="rpt-misc" class="section-card" style="margin-bottom:20px;">
            <div class="section-header">
                <div>
                    <div class="section-title">Miscellaneous — @PeriodLabel</div>
                    <div class="section-sub">Electricity and water, billed per reading</div>
                </div>
                @* The same two actions the register carries, for the same two reasons: this table is filed, and the
                   readings behind it are entered somewhere else. Disabled rather than hidden when there is nothing to
                   print, so the action does not appear and disappear. *@
                <div class="rpt-register-actions no-print">
                    <button type="button" class="rpt-register-print" @onclick="PrintMisc" disabled="@(Model.Misc is null)">
                        Print misc
                    </button>
                    <a class="rpt-attn-link" href="@UtilityBillingUrl">Utility Billing →</a>
                </div>
            </div>

            @if (Model.Misc is { } misc)
            {
                var spansFacilities = misc.Rows.Select(r => r.Facility).Distinct().Count() > 1;

                <div class="rpt-table-scroll">
                    <table class="tx-table">
                        <thead>
                            <tr>
                                @if (spansFacilities)
                                {
                                    <th scope="col">Facility</th>
                                }
                                <th scope="col">Space</th>
                                <th scope="col">Payor</th>
                                <th scope="col" class="r">Electricity</th>
                                <th scope="col" class="r">Water</th>
                                @if (misc.AmountsRecorded)
                                {
                                    <th scope="col" class="r">Charged</th>
                                    <th scope="col" class="r">Collected</th>
                                    <th scope="col" class="r">Balance</th>
                                }
                                <th scope="col">OR No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in misc.Rows)
                            {
                                <tr>
                                    @if (spansFacilities)
                                    {
                                        <td>@FacilityCatalog.ShortNameOf(u.Facility)</td>
                                    }
                                    <td>@SpaceNumber.Display(u.StallNo)</td>
                                    <td>@(string.IsNullOrWhiteSpace(u.Payor) ? "—" : u.Payor)</td>
                                    @* With a reading and a rate the cell is money. Where the office only marks a utility
                                       settled or not, money would be a row of noughts, so the cell states the standing
                                       instead — and a utility that charged nothing is not owed, and says so. *@
                                    <td class="r">@MiscCell(misc.AmountsRecorded, u.ElecCharge, u.ElecStatus)</td>
                                    <td class="r">@MiscCell(misc.AmountsRecorded, u.WaterCharge, u.WaterStatus)</td>
                                    @if (misc.AmountsRecorded)
                                    {
                                        <td class="r">@Money(u.Charged)</td>
                                        <td class="r">@(u.Collected > 0m ? Money(u.Collected) : "—")</td>
                                        <td class="r @(u.Balance > 0m ? "is-owed" : "")">@(u.Balance > 0m ? Money(u.Balance) : "—")</td>
                                    }
                                    <td>@(string.IsNullOrWhiteSpace(u.ORNumber) ? "—" : u.ORNumber)</td>
                                </tr>
                            }
                        </tbody>
                        @if (misc.AmountsRecorded)
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="@(spansFacilities ? 3 : 2)"><strong>Total</strong></td>
                                    <td class="r"><strong>@Money(misc.Rows.Sum(r => r.ElecCharge))</strong></td>
                                    <td class="r"><strong>@Money(misc.Rows.Sum(r => r.WaterCharge))</strong></td>
                                    <td class="r"><strong>@Money(misc.Charged)</strong></td>
                                    <td class="r"><strong>@(misc.Collected > 0m ? Money(misc.Collected) : "—")</strong></td>
                                    <td class="r @(misc.Due > 0m ? "is-owed" : "")"><strong>@(misc.Due > 0m ? Money(misc.Due) : "—")</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                @* What the section is for, in one line: this money is not an addition to the report. Laid out as a label
                   and its figures rather than a sentence, so it cannot run together or off the card. *@
                <div class="rpt-misc-close">
                    <span class="rpt-misc-close-key">
                        @(misc.AmountsRecorded ? "Already inside the period's collected" : "Settled this period")
                    </span>
                    <span class="rpt-misc-close-val">
                        @if (misc.AmountsRecorded)
                        {
                            <strong>@Money(misc.Collected)</strong>
                        }
                        else
                        {
                            <strong>@misc.Settled</strong>
                        }
                        <span class="rpt-misc-close-sep" aria-hidden="true">·</span>
                        <span class="rpt-misc-close-aside">@misc.Settled settled</span>
                        <span class="rpt-misc-close-sep" aria-hidden="true">·</span>
                        <span class="rpt-misc-close-aside">@misc.Outstanding still owing</span>
                    </span>
                </div>
            }
            else
            {
                @* Absent figures rather than a table of noughts: either the office raised no bill for this period, or the
                   period is a year, which is billed and filed a month at a time. *@
                <div class="rpt-rule-note">
                    <div class="rpt-rule-key">Nothing billed</div>
                    <div>No electricity or water was billed for @PeriodLabel. Utilities are billed per month, so this section states a single month.</div>
                </div>
            }
        </div>
        }
    }

</div>

@code {
    // ── Filter selection ── (defaults to the current Philippine month/year)
    private string ActiveTab = "Monthly";
    private string SelectedYear = PhilippineTime.Today.Year.ToString();
    private string SelectedMonth = PhilippineTime.Today.ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture);
    private string SelectedFacility = "All";

    private FinancialReportDto? Model;
    private bool Loading = true;

    [PersistentState(AllowUpdates = true)]
    public FinancialReportPageState? CachedFinancialReport { get; set; }

    private readonly HashSet<FacilityCode> _expandedFacilities = new();

    private void ToggleFacility(FacilityCode code, bool expandable)
    {
        if (!expandable) return;
        if (!_expandedFacilities.Add(code)) _expandedFacilities.Remove(code);
    }

    private DateTime GeneratedOn => PhilippineTime.Now;

    private static readonly List<string> Months = new()
    {
        "January","February","March","April","May","June",
        "July","August","September","October","November","December"
    };

    // Year options: the current Philippine year and the two prior years. Computed per render so it
    // always includes the current year (the default), even across a year rollover without a restart.
    private List<int> Years => Enumerable.Range(PhilippineTime.Today.Year - 2, 3).ToList();

    // Option lists for the custom Year/Month dropdowns (value == label for both).
    private IReadOnlyList<(string Value, string Label)> YearOptions =>
        Years.OrderByDescending(y => y).Select(y => (y.ToString(), y.ToString()))
            .Append(("all", "All time"))
            .ToList();
    private IReadOnlyList<(string Value, string Label)> MonthOptions =>
        Months.Select(m => (m, m)).ToList();

    private async Task OnYearChanged(string value) { SelectedYear = value; await Load(); }
    private async Task OnMonthChanged(string value) { SelectedMonth = value; await Load(); }

    // Data-driven: "All" + the tenant's actual facilities.
    private List<(string Code, string Label)> FacilityOptions
    {
        get
        {
            var opts = new List<(string Code, string Label)> { ("All", "All Facilities") };
            opts.AddRange(FacilityCatalog.All.Select(c => (c.ToString(), FacilityCatalog.NameOf(c))));
            return opts;
        }
    }

    // Authoritative scope labels (fall back to selection before/while loading).
    private string PeriodLabel => Model?.PeriodLabel
        ?? (SelectedYear == "all" ? "All time" : ActiveTab == "Monthly" ? $"{SelectedMonth} {SelectedYear}" : SelectedYear);
    private string ScopeLabel => SelectedFacility != "All" && Enum.TryParse<FacilityCode>(SelectedFacility, out var _slc)
        ? FacilityCatalog.NameOf(_slc)
        : (Model?.ScopeLabel ?? (SelectedFacility == "All" ? "All facilities" : SelectedFacility));
    private string FrequencyLabel => Model?.Frequency ?? ActiveTab;

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();

        if (TryApplyCachedFinancialReport())
            return;

        await Load();
    }

    private async Task SetTab(string tab)
    {
        ActiveTab = tab;
        await Load();
    }

    // Chip label: tenant short name (canonical stays e.g. "NPM"; custom shows its Head-chosen acronym).
    private string ChipLabel(string codes) =>
        Enum.TryParse<FacilityCode>(codes, out var c) ? FacilityCatalog.ShortNameOf(c) : codes;

    private async Task SelectFacility(string code)
    {
        SelectedFacility = code;
        await Load();
    }

    private async Task Load()
    {
        // Keep the currently-shown report visible while the new one loads (a small "Refreshing…" cue
        // shows instead of blanking the page). Only the very first load shows the full loading state.
        Loading = true;
        await PaintLoadingStateAsync();

        var allTime = SelectedYear == "all";
        var period = allTime || ActiveTab == "Annual" ? ReportPeriod.Yearly : ReportPeriod.Monthly;
        var year = allTime ? PhilippineTime.Today.Year : int.Parse(SelectedYear);
        int? month = (!allTime && period == ReportPeriod.Monthly) ? Months.IndexOf(SelectedMonth) + 1 : null;
        FacilityCode? facility = SelectedFacility == "All" ? null : Enum.Parse<FacilityCode>(SelectedFacility);

        // Cold-start resilience: tolerate the brief window before the circuit attaches the JWT.
        var loaded = false;
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var result = await ReportsApi.GetFinancialReportAsync(period, year, month, facility, allTime);
            if (result.IsSuccess)
            {
                Model = result.Value;
                if (Model is not null)
                {
                    CachedFinancialReport = new FinancialReportPageState(
                        ActiveTab,
                        SelectedYear,
                        SelectedMonth,
                        SelectedFacility,
                        Model);
                }

                loaded = true;
                break;
            }
            if (result.Status is not (ResultStatus.Unauthorized or ResultStatus.Forbidden))
                break;
            await Task.Delay(400);
        }

        // The old report stays visible only while a NEW one is loading; if the load definitively
        // fails, clear it so the error state shows for the new selection (never stale data).
        if (!loaded)
            Model = null;

        // Recompute the y-axis scale for the new data and bump the epoch so bars re-animate.
        var trendMax = TrendBars.Count == 0 ? 0m : TrendBars.Max(t => Math.Max(t.Collected, t.Unpaid));
        _scale = ComputeTrendScale(trendMax);
        _renderEpoch++;

        Loading = false;
        StateHasChanged();
    }

    private bool TryApplyCachedFinancialReport()
    {
        if (CachedFinancialReport is not { } state
            || state.ActiveTab != ActiveTab
            || state.SelectedYear != SelectedYear
            || state.SelectedMonth != SelectedMonth
            || state.SelectedFacility != SelectedFacility)
        {
            return false;
        }

        Model = state.Model;
        var trendMax = TrendBars.Count == 0 ? 0m : TrendBars.Max(t => Math.Max(t.Collected, t.Unpaid));
        _scale = ComputeTrendScale(trendMax);
        _renderEpoch++;
        Loading = false;
        return true;
    }

    // ── Trend scaling (nice round axis + tight ceiling so bars stay tall) ──
    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private List<ReportTrendPointDto> TrendBars =>
        (Model?.Trend ?? new List<ReportTrendPointDto>()).TakeLast(6).ToList();

    private int _renderEpoch;                                   // bumped each load → bar-grow animation replays
    private (decimal Ceiling, decimal Step) _scale = (1000m, 250m);

    // Smallest "nice" step (1 / 2 / 2.5 / 5 × 10ⁿ) whose ceiling needs ≤ 5 intervals. Produces round
    // labels (₱100k, ₱200k, …) and a ceiling just above the data, so bars stay tall instead of stubby.
    private static (decimal Ceiling, decimal Step) ComputeTrendScale(decimal max)
    {
        if (max <= 0) return (1000m, 250m);
        decimal[] mantissas = { 1m, 2m, 2.5m, 5m };
        for (var e = 0; e <= 12; e++)
        {
            var pow = (decimal)Math.Pow(10, e);
            foreach (var man in mantissas)
            {
                var step = man * pow;
                var intervals = (int)Math.Ceiling(max / step);
                if (intervals <= 5)
                {
                    var ceiling = step * intervals;
                    // Headroom: keep the tallest bar off the top gridline (never above ~90% of the ceiling).
                    while (max > 0.9m * ceiling)
                        ceiling += step;
                    return (ceiling, step);
                }
            }
        }
        return (max, max);
    }

    private int Pct(decimal v)
    {
        var ceiling = _scale.Ceiling;
        if (ceiling <= 0) return 0;
        return Math.Clamp((int)Math.Round(v / ceiling * 100m), 0, 100);
    }

    // Axis labels top → bottom: ceiling, ceiling − step, … , ₱0 (one gridline per label).
    private List<string> AxisLabels
    {
        get
        {
            var (ceiling, step) = _scale;
            if (step <= 0) return new List<string> { AxisFmt(ceiling), "₱0" };
            var labels = new List<string>();
            for (var v = ceiling; v >= 0; v -= step)
                labels.Add(AxisFmt(v));
            return labels;
        }
    }

    private static string AxisFmt(decimal v)
    {
        if (v <= 0) return "₱0";
        if (v >= 1_000_000m) return "₱" + (v / 1_000_000m).ToString("0.##") + "M";
        if (v >= 1_000m) return "₱" + (v / 1_000m).ToString("0.#") + "k";
        return "₱" + v.ToString("0");
    }

    private static string Money(decimal v) => "₱" + v.ToString("N0");

    // The headline follow-up figures. Taken from the report's own totals, NEVER by counting or summing the two lists
    // beside them: those are capped at the most overdue accounts, so an office with more accounts than the cap was told
    // it had fewer and owed less — under a heading that says "outstanding in full".
    private int FollowUpAccounts => Model.DelinquentAccountsTotal + Model.ArrearsAccountsTotal;

    private decimal FollowUpOutstanding => Model.DelinquentOutstandingTotal + Model.ArrearsOutstandingTotal;

    // The last month that has actually closed — what the attention figures are counted up to.
    private static string LastClosedMonthLabel =>
        new DateOnly(EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Year,
                     EEMOCantilanSDS.Domain.Common.PhilippineTime.Today.Month, 1)
            .AddMonths(-1)
            .ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static string MonthsLabel(int months) => $"{months} unpaid month{(months == 1 ? "" : "s")}";

    // Per-column search over the two attention lists. Both are already loaded, so filtering happens here rather
    // than as another request: the office types a name to find one account among dozens without leaving the page.
    private string _delinquentSearch = "";
    private string _arrearsSearch = "";

    private static IReadOnlyList<AttentionAccountDto> Filtered(IReadOnlyList<AttentionAccountDto> rows, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return rows;
        var term = search.Trim();
        return rows
            .Where(r => r.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.StallNo.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.Location.Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpper()
            : (parts[0][..1] + parts[^1][..1]).ToUpper();
    }

    private static string StatusClass(string status) => status switch
    {
        "Good" => "good",
        "On track" => "warn",
        "Behind" => "bad",
        "Paid on service" => "good",
        _ => "muted"
    };

    private static string ProfileUrl(FacilityCode code, string stallNo) =>
        $"/profile/{code.ToString().ToLower()}/{stallNo}";

    /// <summary>
    /// Links an attention row to the stall itself. The market numbers spaces per section, so "Stall 1" exists three
    /// times over in New Public Market and a facility-and-number link opened whichever one the lookup found first —
    /// Ana Reyes's row could open Pantom Dant's profile. The route accepts a stall id, so use it when we have one.
    /// </summary>
    private static string ProfileUrl(AttentionAccountDto row) =>
        row.StallId is { } id && id != Guid.Empty
            ? $"/profile/{row.FacilityCode.ToString().ToLower()}/{id}"
            : ProfileUrl(row.FacilityCode, row.StallNo);

    /// <summary>
    /// Links a Recent Records row to the stall it is about — by id, for the same reason as the overload above.
    /// </summary>
    /// <remarks>
    /// This row kept passing the NUMBER after the attention rows were fixed (7d4b2bc2), because FinancialRecordDto carried no
    /// stall id to pass: the feed's Reference is a label shared with plates and animals, not an identity. The id is carried
    /// through the feed now. Falls back to the number where there is no id — rows about slaughter, terminal trips and
    /// market-day vendors have no stall, and for those the fallback is the existing behaviour, unchanged.
    /// </remarks>
    private static string ProfileUrl(FinancialRecordDto tx) =>
        tx.StallId is { } id && id != Guid.Empty
            ? $"/profile/{tx.FacilityCode.ToString().ToLower()}/{id}"
            : ProfileUrl(tx.FacilityCode, tx.StallNo);

    public sealed record FinancialReportPageState(
        string ActiveTab,
        string SelectedYear,
        string SelectedMonth,
        string SelectedFacility,
        FinancialReportDto Model);

    // Export PDF = browser print of the report. A scoped @media print stylesheet (Report.razor.css)
    // narrows the printed page to the header + KPIs + Revenue Trend + Revenue by Facility, laid out
    // cleanly on paper. "Save as PDF" in the print dialog produces the PDF.
    // ── Report sections ──────────────────────────────────────────────────────────────────────────────────────
    //
    // The report is five sections deep and only the first fits on a screen, so they are shown one at a time rather than
    // stacked. Which of them may leave the DOM is decided by the print stylesheet, not by this state:
    //
    //   • overview, trend, by facility — pdf-include. Export Summary PDF reads the markup as a whole, whatever tab is
    //     open, so these must exist at all times and are hidden by a screen-only class (SectionOff).
    //   • follow-up, records, misc — never in that document, and the register's own print button sits inside the
    //     register. These are rendered only while open (SectionShown), which took the page from 116 kb of markup to 30 kb.
    private static readonly (string Key, string Label)[] ReportSections =
    [
        ("overview", "Overview"),
        ("followup", "Follow-up"),
        ("trend", "Trend"),
        ("facility", "By facility"),
        ("records", "Records"),
        ("misc", "Misc"),
    ];

    private string _section = "overview";

    /// <summary>
    /// Whether the rate-basis note under the By facility heading is open. Closed by default: the office asked for the
    /// rule to be available, not stated on every reading.
    /// </summary>
    private bool _facilityRuleOpen;

    /// <summary>
    /// The register's row cap, as the server applies it.
    /// </summary>
    /// <remarks>
    /// Stated here only so the page can say whether the list it received is the whole period or the newest N of it. It
    /// must match GetFinancialReportQueryHandler.RegisterLimit; if the two ever part, the page would claim a complete
    /// register while showing a truncated one, which on a financial report is worse than saying nothing. A component test
    /// holds the two together.
    /// </remarks>
    private const int RegisterListLimit = 50;

    /// <summary>Marks a section as off-screen. Hidden for the eye only; print is governed by the print stylesheet.</summary>
    private string SectionOff(string key) => _section == key ? string.Empty : " rpt-sec-off";

    /// <summary>
    /// Whether a section that is never printed should be in the markup at all. Overview, Trend and By facility do not use
    /// this — they must exist whatever tab is open, because Export Summary PDF is assembled from the whole page — but
    /// Attention and the register are only ever read on screen, and the register's print button is inside it.
    /// </summary>
    private bool SectionShown(string key) => _section == key;

    /// <summary>
    /// What one utility's cell states. Where the office records a reading and a rate, that is money. Where it only marks
    /// a utility settled or not, money would be a nought that reads as "nothing charged", so the cell states the standing
    /// instead. A utility that charged nothing is neither: it is not billed here at all.
    /// </summary>
    private string MiscCell(bool amountsRecorded, decimal charge, PaymentStatus status)
    {
        if (amountsRecorded)
            return charge > 0m ? Money(charge) : "—";

        return status switch
        {
            PaymentStatus.Paid => "Settled",
            PaymentStatus.Partial => "Part-settled",
            _ => "Unpaid"
        };
    }

    /// <summary>
    /// Prints one document with an extra class in force, so the print stylesheet can choose which document.
    /// </summary>
    /// <remarks>
    /// The class is applied in the browser for the duration of the print rather than held here, because a Blazor Server
    /// render has to reach the client before <c>window.print()</c> runs — a print racing a render is a print that
    /// sometimes contains the wrong document.
    /// </remarks>
    private async Task PrintRegister() =>
        await JS.InvokeVoidAsync("stalltrackPrint.sectionDocument", "#rpt-sheet", "print-register");

    /// <summary>
    /// Prints the Miscellaneous table as its own document, the way the register prints as its own. The same helper and
    /// the same shape of stylesheet, so there is one mechanism for "print this section" rather than two.
    /// </summary>
    private async Task PrintMisc() =>
        await JS.InvokeVoidAsync("stalltrackPrint.sectionDocument", "#rpt-sheet", "print-misc");

    /// <summary>
    /// The Financial Summary document, on the period and scope this screen is showing. Its own page, so the filed
    /// document is laid out for paper rather than assembled out of a screen by a print stylesheet.
    /// </summary>
    private string SummaryDocumentUrl
    {
        get
        {
            var allTime = SelectedYear == "all";
            var period = allTime || ActiveTab == "Annual" ? "yearly" : "monthly";
            var year = allTime ? PhilippineTime.Today.Year : int.Parse(SelectedYear);
            var month = Months.IndexOf(SelectedMonth) + 1;
            var url = $"/reports/financial-summary?period={period}&year={year}&month={month}";

            if (SelectedFacility != "All") url += $"&facility={SelectedFacility}";
            if (allTime) url += "&allTime=true";

            return url;
        }
    }

    /// <summary>
    /// The market's utility billing screen, on the month this report is showing. The readings behind the Miscellaneous
    /// table are entered there, so the office lands on the period it was just reading rather than on today's.
    /// </summary>
    private string UtilityBillingUrl
    {
        get
        {
            var year = SelectedYear == "all" ? PhilippineTime.Today.Year : int.Parse(SelectedYear);
            var month = Months.IndexOf(SelectedMonth) + 1;
            return $"/npm/reports?view=utilities&year={year}&month={month}";
        }
    }
}
