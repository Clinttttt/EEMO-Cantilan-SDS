@page "/operations/ecf"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IEcfCollectionsApiClient EcfApi

<PageTitle>StallTrack — Electricity Consumption Fees</PageTitle>

@* The layout owns the <main> landmark. The register, the selected-source panel and amount preparation are the shared UtilityWorkspace;
   this page adds only what is ECF-specific: recording an Official Receipt payment against a prepared amount, the unfinished-collection
   notice (shown only when a server draft exists) and the month's collection activity. *@
<UtilityWorkspace @ref="_workspace" Kind="UtilityKind.Electricity" OnPeriodLoaded="PeriodLoadedAsync">
    <Notices>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="v3-notice" role="status">@_message</p>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="v3-notice v3-notice-error" role="alert">@_error</p>
        }
        @if (_draft is { } draft)
        {
            <div class="v3-notice ecf-draft" role="status">
                <span>Unfinished collection · @Money(draft.TotalAmount) · @(draft.PayerNameSnapshot ?? "payer not recorded")@(draft.RequiresBusinessDateRefresh ? " · from an earlier date" : "")</span>
                <span class="ecf-draft-actions">
                    <button class="v3-btn v3-btn-sm" type="button" @onclick="() => OpenDraft(false)">Resume</button>
                    <button class="v3-btn v3-btn-sm" type="button" @onclick="() => OpenDraft(true)">Discard</button>
                </span>
            </div>
        }
    </Notices>
    <SourceActions Context="source">
        @if (source.Mode == "Direct")
        {
            <p class="ecf-note">Direct collections are recorded by Collectors on Mobile.</p>
        }
        else if (source.UtilityBillId is { } billId && source.Mode == "Prepared" && source.Outstanding > 0m)
        {
            @if (source.Authority == SettlementAuthority.Canonical)
            {
                <button class="v3-btn v3-btn-primary" type="button" disabled="@_busy" @onclick="() => OpenRecordAsync(billId, false)">Record payment</button>
            }
            else if (source.Authority == SettlementAuthority.Legacy)
            {
                <button class="v3-btn" type="button" disabled="@_busy" @onclick="() => OpenRecordAsync(billId, true)">Review authority</button>
            }
            else
            {
                <span class="v3-state">Reconciliation in progress</span>
            }
        }
    </SourceActions>
    <Activity>
        <section class="v3-panel" aria-labelledby="ecf-activity-title">
            <header class="v3-panel-header">
                <h2 id="ecf-activity-title">Collection activity</h2>
                <span class="v3-panel-meta">@_activity.Count in @_periodLabel · <a href="/collections/activity">All collections</a></span>
            </header>
            <div class="v3-table-wrap" role="region" aria-label="Posted ECF collections" tabindex="0">
                <table class="v3-table">
                    <caption class="v3-sr-only">Posted ECF collections for @_periodLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col">Business date</th>
                            <th scope="col">Reference · payer</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="v3-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in _activity)
                        {
                            <tr>
                                <td>@activity.BusinessDate.ToString("dd MMM yyyy")<span class="v3-block">Recorded @PhilippineTime.ToPhilippineTime(activity.RecordedAtUtc).ToString("HH:mm")</span></td>
                                <td><a class="v3-strong" href="@($"/collections/activity?src={Uri.EscapeDataString(activity.ReferenceCode)}")">@activity.ReferenceCode</a><span class="v3-block">@(activity.PayerName ?? "No payer recorded")</span></td>
                                <td>@activity.CurrentDisposition</td>
                                <td class="v3-num v3-strong">@Money(activity.TotalAmount)</td>
                            </tr>
                        }
                        @if (_activity.Count == 0)
                        {
                            <tr><td class="v3-empty" colspan="4">@(_activityError ?? $"No ECF collections were recorded in {_periodLabel}.")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </Activity>
</UtilityWorkspace>

@if (_recording is { } quote)
{
    <EcfRecordPaymentDialog Quote="quote" OnClosed="RecordClosedAsync" />
}
@if (_resuming is { } resuming)
{
    <EcfRecordPaymentDialog Draft="resuming" StartDiscarding="_resumeDiscarding" OnClosed="RecordClosedAsync" />
}
@if (_activating is { } activating)
{
    <EcfActivationDialog Quote="activating" OnClose="() => _activating = null" OnActivated="ActivatedAsync" />
}

@code {
    private UtilityWorkspace? _workspace;
    private List<EcfCollectionActivityDto> _activity = [];
    private string _periodLabel = PhilippineTime.Today.ToString("MMMM yyyy");
    private EcfCollectionDraftDto? _draft;
    private EcfObligationQuoteDto? _recording, _activating;
    private EcfCollectionDraftDto? _resuming;
    private bool _resumeDiscarding, _busy;
    private string? _message, _error, _activityError;

    // The register loads the month; this page then reads that month's activity and whether an unfinished server draft exists.
    private async Task PeriodLoadedAsync((int Year, int Month) period)
    {
        _periodLabel = new DateOnly(period.Year, period.Month, 1).ToString("MMMM yyyy");
        try
        {
            var current = await EcfApi.GetCurrentDraftAsync();
            _draft = current.IsSuccess ? current.Value : null;
            var from = new DateOnly(period.Year, period.Month, 1);
            var activity = await EcfApi.GetActivityAsync(from, from.AddMonths(1).AddDays(-1));
            _activityError = activity.IsSuccess ? null : "Collection activity could not be loaded.";
            _activity = activity.IsSuccess ? activity.Value?.ToList() ?? [] : [];
        }
        catch { _activityError = "Collection activity could not be loaded."; }
    }

    private async Task OpenRecordAsync(Guid billId, bool review)
    {
        _busy = true; _error = null; _message = null;
        try
        {
            var result = await EcfApi.GetObligationAsync(billId);
            if (result is { IsSuccess: true, Value: { } quote }) { if (review) _activating = quote; else _recording = quote; }
            else _error = string.IsNullOrWhiteSpace(result?.Error) ? "The source could not be opened." : result.Error;
        }
        catch { _error = "The source could not be opened."; }
        finally { _busy = false; }
    }

    private void OpenDraft(bool discard) { _resuming = _draft; _resumeDiscarding = discard; }

    private async Task RecordClosedAsync(bool changed)
    {
        _recording = null; _resuming = null; _resumeDiscarding = false;
        if (changed && _workspace is not null) await _workspace.RefreshAsync();
    }

    private async Task ActivatedAsync()
    {
        _message = "The source is active for canonical collection.";
        _activating = null;
        if (_workspace is not null) await _workspace.RefreshAsync();
    }

    private static string Money(decimal amount) => $"₱{amount:N2}";
}
