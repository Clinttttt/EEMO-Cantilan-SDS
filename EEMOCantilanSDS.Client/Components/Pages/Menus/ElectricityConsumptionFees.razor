@page "/operations/ecf"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.JSInterop
@inject IEcfCollectionsApiClient EcfApi
@inject IJSRuntime JS

<PageTitle>StallTrack — General Distribution / ECF</PageTitle>

<main class="ecf-page">
    <nav class="ecf-breadcrumb" aria-label="Breadcrumb">
        <a href="/operations">Operations</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">General Distribution / ECF</span>
    </nav>

    <FacilityHero Eyebrow="@($"{Branding.OfficeAcronym} Admin · Operations · ECF")"
                  Title="General Distribution / ECF"
                  Subtitle="Electricity assessments and Official Receipt collection preparation."
                  Icon="@ElectricityIcon"
                  Stats="HeroStats" />

    <section class="ecf-period-desk" aria-labelledby="ecf-period-title">
        <div class="ecf-period-copy">
            <p class="ecf-eyebrow">BILLING PERIOD</p>
            <h2 id="ecf-period-title">@BillingPeriodLabel</h2>
            <p>Authoritative Electricity source facts from the current utility register.</p>
        </div>
        <div class="ecf-period-actions">
            <div class="ecf-instrument" aria-label="ECF policy resolves to Official Receipt">
                <span class="ecf-or-chip">OR</span>
                <strong>Official Receipt</strong>
            </div>
                <div class="ecf-action-buttons">
                    <button class="ecf-button ecf-button-secondary" type="button" @onclick="ReloadAsync" disabled="@_busy">
                        Refresh sources
                    </button>
                    <a class="ecf-button ecf-button-secondary ecf-view-all" href="/operations/ecf/accounts">View All</a>
                    <a class="ecf-button ecf-button-report" href="/operations/ecf/report">Report</a>
                </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="ecf-notice" role="status">@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="ecf-notice ecf-notice-error" role="alert">@_error</div>
    }

    <div class="ecf-main-grid">
        <section class="ecf-panel ecf-assessments-panel" aria-labelledby="ecf-assessments-title">
            <header class="ecf-panel-header">
                <div>
                    <p class="ecf-eyebrow">ELECTRICITY SOURCES</p>
                    <h2 id="ecf-assessments-title">ECF Obligations</h2>
                    <p>Amounts, readings, payer evidence, and outstanding balances come from UtilityBill Electricity.</p>
                </div>
                <div class="ecf-assessment-header-actions">
                    <span class="ecf-period-tag">@BillingPeriodLabel</span>
                </div>
            </header>

            <div class="ecf-toolbar" aria-label="ECF source filters">
                <label class="ecf-filter-control">
                    <span class="ecf-sr-only">Filter by area</span>
                    <select aria-label="Filter by area" @bind="_areaFilter">
                        <option value="">All Areas</option>
                        @foreach (var section in Sections)
                        {
                            <option value="@section">@section</option>
                        }
                    </select>
                </label>
                <label class="ecf-search-control">
                    <span class="ecf-sr-only">Search stall, occupant, facility, or area</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.8" />
                        <path d="m16 16 4.5 4.5" />
                    </svg>
                    <input type="search" placeholder="Search stall, occupant, facility, or area..."
                           aria-label="Search ECF sources" @bind="_searchText" @bind:event="oninput" />
                </label>
            </div>

            <div class="ecf-table-wrap ecf-assessment-scroll" role="region" aria-label="ECF Electricity source obligations" tabindex="0">
                <table class="ecf-table ecf-assessment-table">
                    <caption class="ecf-sr-only">@BillingPeriodLabel ECF Electricity source obligations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Payer / Source</th>
                            <th scope="col">Meter</th>
                            <th scope="col" class="ecf-number">Due</th>
                            <th scope="col" class="ecf-number">Settled</th>
                            <th scope="col" class="ecf-number">Outstanding</th>
                            <th scope="col">Authority</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quote in FilteredQuotes)
                        {
                            <tr>
                                <td class="ecf-occupant-cell">
                                    <strong class="ecf-account-name">@PayerLabel(quote)</strong>
                                    <span class="ecf-account-area">@SourceContext(quote)</span>
                                </td>
                                <td>@MeterBasis(quote)</td>
                                <td class="ecf-number">@Money(quote.AssessedAmount)</td>
                                <td class="ecf-number">@Money(quote.CumulativeSettledEvidence)</td>
                                <td class="ecf-number ecf-balance">@Money(quote.OutstandingAmount)</td>
                                <td><span class="ecf-period-tag">@quote.SettlementAuthority</span></td>
                                <td>
                                    @if (quote.CanAddToDraft && DraftRemaining(quote) > 0m)
                                    {
                                        <button class="ecf-button ecf-button-primary" type="button"
                                                @onclick="() => AddToCollectionAsync(quote)" disabled="@(_busy || (_draft?.RequiresBusinessDateRefresh ?? false))">
                                            @(DraftRemaining(quote) < quote.OutstandingAmount ? "Add remaining balance" : "Add to Collection")
                                        </button>
                                    }
                                    else if (quote.SettlementAuthority == SettlementAuthority.PendingCutover)
                                    {
                                        <span>Cutover reconciliation in progress</span>
                                    }
                                    else if (_draft is not null)
                                    {
                                        <span>Current Collection in progress</span>
                                    }
                                    else
                                    {
                                        <span>Settled</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!FilteredQuotes.Any())
                        {
                            <tr><td class="ecf-empty-cell" colspan="7">No ECF Electricity obligations were found for this billing period.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="ecf-table-footer">
                <span>@FilteredQuotes.Count() ECF obligations</span>
                <span>Source: UtilityBill / Electricity</span>
            </footer>
        </section>

        <aside class="ecf-panel ecf-summary-panel" aria-labelledby="ecf-composer-title">
            <header class="ecf-panel-header">
                <div>
                    <p class="ecf-eyebrow">SERVER-PERSISTED · NON-FINANCIAL UNTIL POSTED</p>
                    <h2 id="ecf-composer-title">Current Collection</h2>
                    <p>Rent and ECF entry converge on the same server collection draft.</p>
                </div>
            </header>

            @if (_draft is null)
            {
                <div class="ecf-composer-empty">
                    <p>No open collection draft is attached to this user.</p>
                    <p>Choose an eligible Electricity obligation and add it to a draft.</p>
                    <a class="ecf-button ecf-button-secondary" href="/collections/current">Open Payor-first Collection</a>
                </div>
            }
            else
            {
                <dl class="ecf-summary-list">
                    <div><dt>Draft</dt><dd>@ShortId(_draft.DraftId)</dd></div>
                    <div><dt>Revision</dt><dd>@_draft.Revision</dd></div>
                    <div><dt>Status</dt><dd>@_draft.Status</dd></div>
                    <div><dt>Payer snapshot</dt><dd>@(_draft.PayerNameSnapshot ?? "Not recorded")</dd></div>
                    <div><dt>Accountable document</dt><dd>@(_draft.DocumentNumber ?? "Select available OR")</dd></div>
                </dl>

                @if (_draft.RequiresBusinessDateRefresh)
                {
                    <div class="ecf-draft-footnote" role="alert">
                        This draft belongs to an earlier Philippine business date. Refresh its source facts, then review the new revision.
                        <button class="ecf-button ecf-button-secondary" type="button" disabled="@_busy"
                                @onclick="ResumeDraftAsync">Refresh draft for today</button>
                    </div>
                }

                @foreach (var line in _draft.Lines)
                {
                    <div class="ecf-draft-line">
                        <div>
                            <strong>@line.ClassificationName</strong>
                            <span>@Money(line.Amount)</span>
                        </div>
                        @foreach (var allocation in line.Allocations ?? [])
                        {
                            <span>@allocation.SourceLabel · @Money(allocation.Amount)</span>
                        }
                    </div>
                }

                <label class="ecf-field ecf-document-select">
                    <span>Available Official Receipt</span>
                    <select value="@(_draft.AccountableDocumentId?.ToString() ?? string.Empty)"
                            @onchange="SelectDocumentAsync" disabled="@(_busy || _draft.RequiresBusinessDateRefresh)">
                        <option value="">Select available OR</option>
                        @foreach (var document in _availableReceipts)
                        {
                            <option value="@document.DocumentId">@document.DocumentNumber · @document.State</option>
                        }
                    </select>
                </label>

                <div class="ecf-amount-due">
                    <span>DRAFT TOTAL</span>
                    <strong>@Money(_draft.TotalAmount)</strong>
                </div>

                <footer class="ecf-modal-footer ecf-composer-actions">
                    <a class="ecf-button ecf-button-primary" href="/collections/current">Open Current Collection</a>
                </footer>
                <p class="ecf-draft-footnote">Drafting and review do not create revenue, allocate settlement, or consume an OR.</p>
            }
        </aside>
    </div>

    <section class="ecf-panel ecf-activity-panel" aria-labelledby="ecf-activity-title">
        <header class="ecf-panel-header ecf-activity-header">
            <div>
                <p class="ecf-eyebrow">CANONICAL COLLECTION EVENTS</p>
                <h2 id="ecf-activity-title">Collection Activity</h2>
                <p>One parent row per posted Collection. Legacy receipts are not reconstructed here.</p>
            </div>
        </header>

        <div class="ecf-table-wrap" role="region" aria-label="Posted ECF Collection Activity" tabindex="0">
            <table class="ecf-table ecf-activity-table">
                <caption class="ecf-sr-only">Posted itemized ECF collections for @BillingPeriodLabel</caption>
                <thead>
                    <tr>
                        <th scope="col">Business date</th>
                        <th scope="col">Document / payer</th>
                        <th scope="col">Disposition</th>
                        <th scope="col" class="ecf-number">Total</th>
                        <th scope="col">Items / detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in _activity)
                    {
                        <tr>
                            <td>@activity.BusinessDate.ToString("dd MMM yyyy")<span class="ecf-account-area">Recorded @PhilippineTime.ToPhilippineTime(activity.RecordedAtUtc).ToString("HH:mm")</span></td>
                            <td><strong>@activity.DocumentNumber</strong><span class="ecf-account-area">@(activity.PayerName ?? "No payer snapshot")</span></td>
                            <td>@activity.CurrentDisposition</td>
                            <td class="ecf-number">@Money(activity.TotalAmount)</td>
                            <td>
                                <details>
                                    <summary>@activity.ItemCount item@(activity.ItemCount == 1 ? "" : "s")</summary>
                                    <ul class="ecf-activity-detail">
                                        @foreach (var line in activity.Lines)
                                        {
                                            <li>
                                                <strong>@line.ClassificationName</strong> — @Money(line.Amount)
                                                <span>@MonthName(line.BillingMonth) @line.BillingYear · @line.Allocation</span>
                                                <span>@SnapshotSummary(line.CalculationSnapshot)</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </td>
                        </tr>
                    }
                    @if (_activity.Count == 0)
                    {
                        <tr><td class="ecf-empty-cell" colspan="5">No canonical ECF Collections were posted during this billing period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>

@code {
    private DateTime _period = PhilippineTime.Today.ToDateTime(TimeOnly.MinValue);
    private string _areaFilter = string.Empty;
    private string _searchText = string.Empty;
    private List<EcfObligationQuoteDto> _quotes = [];
    private List<EcfAvailableDocumentDto> _availableReceipts = [];
    private List<EcfCollectionActivityDto> _activity = [];
    private EcfCollectionDraftDto? _draft;
    private EcfObligationQuoteDto? _draftSourceQuote;
    private decimal _proposedAmount;
    private bool _busy;
    private string? _message;
    private string? _error;

    private string BillingPeriodLabel => _period.ToString("MMMM yyyy");
    private IEnumerable<string> Sections => _quotes.Select(x => x.Section).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<EcfObligationQuoteDto> FilteredQuotes => _quotes.Where(quote =>
        (string.IsNullOrEmpty(_areaFilter) || quote.Section == _areaFilter)
        && (string.IsNullOrWhiteSpace(_searchText)
            || PayerLabel(quote).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || quote.StallNo.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || quote.FacilityName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || quote.Section.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));
    private decimal TotalBilled => _quotes.Sum(x => x.AssessedAmount);
    private decimal TotalSettled => _quotes.Sum(x => x.CumulativeSettledEvidence);
    private decimal TotalOutstanding => _quotes.Sum(x => x.OutstandingAmount);
    private EcfObligationQuoteDto? CurrentDraftQuote => _draftSourceQuote;
    private decimal DraftRemaining(EcfObligationQuoteDto quote) => quote.OutstandingAmount
        - (_draft?.Lines.SelectMany(x => x.Allocations ?? [])
            .Where(x => x.SourceKind == CollectionSourceKind.UtilityBill
                && x.SourceId == quote.UtilityBillId && x.SourcePart == CollectionSourcePart.Electricity)
            .Sum(x => x.Amount) ?? 0m);

    private List<FacilityHero.HeroStat> HeroStats =>
    [
        new() { Value = Money(TotalBilled), Label = "Assessed" },
        new() { Value = Money(TotalSettled), Label = "Settlement evidence" },
        new() { Value = Money(TotalOutstanding), Label = "Outstanding" }
    ];

    private RenderFragment ElectricityIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M13.2 2.5 5.8 13h5.4l-.6 8.5L18.2 11h-5.5l.5-8.5Z" />
    </svg>;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ReloadAsync()
    {
        _period = PhilippineTime.Today.ToDateTime(TimeOnly.MinValue);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var year = _period.Year;
            var month = _period.Month;
            var quotes = await EcfApi.GetObligationsAsync(year, month);
            if (!quotes.IsSuccess)
            {
                _error = ErrorText(quotes, "Unable to load ECF source obligations.");
                return;
            }
            _quotes = quotes.Value?.ToList() ?? [];

            var receipts = await EcfApi.GetAvailableReceiptsAsync();
            if (!receipts.IsSuccess)
            {
                _error = ErrorText(receipts, "Unable to load available Official Receipts.");
                return;
            }
            _availableReceipts = receipts.Value?.ToList() ?? [];

            var current = await EcfApi.GetCurrentDraftAsync();
            if (current.IsSuccess)
            {
                _draft = current.Value;
                _proposedAmount = _draft?.TotalAmount ?? 0m;
                await LoadDraftSourceAsync();
            }
            else if (current.Status != ResultStatus.NotFound)
            {
                _error = ErrorText(current, "Unable to recover the current server draft.");
                return;
            }
            else
            {
                _draft = null;
                _draftSourceQuote = null;
                _proposedAmount = 0m;
            }

            var from = new DateOnly(year, month, 1);
            var to = from.AddMonths(1).AddDays(-1);
            var activity = await EcfApi.GetActivityAsync(from, to);
            if (!activity.IsSuccess)
            {
                _error = ErrorText(activity, "Unable to load canonical ECF Collection Activity.");
                return;
            }
            _activity = activity.Value?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddToCollectionAsync(EcfObligationQuoteDto quote)
    {
        await RunAsync(async () =>
        {
            var result = await EcfApi.AddEcfLineAsync(new AddEcfDraftLineRequest(
                quote.UtilityBillId, DraftRemaining(quote), _draft?.Revision));
            if (!SetDraftResult(result, "ECF source added to the server draft.")) return;
            await ReloadSupportingDataAsync();
        });
    }

    private async Task UpdateAmountAsync()
    {
        if (_draft is null) return;
        await RunAsync(async () =>
        {
            var result = await EcfApi.UpdateAllocationAsync(_draft.DraftId,
                new UpdateEcfDraftAllocationRequest(_draft.Revision, _proposedAmount));
            SetDraftResult(result, "Draft amount updated. Review is required again.");
        });
    }

    private async Task RefreshDraftSourceAsync()
    {
        if (_draft?.Lines.FirstOrDefault() is not { } line) return;
        await RunAsync(async () =>
        {
            var result = await EcfApi.UpdateAllocationAsync(_draft.DraftId,
                new UpdateEcfDraftAllocationRequest(_draft.Revision, _proposedAmount));
            if (SetDraftResult(result, "Source facts refreshed. Review the new revision before posting."))
                await ReloadSupportingDataAsync();
        });
    }

    private async Task SelectDocumentAsync(ChangeEventArgs args)
    {
        if (_draft is null) return;
        Guid? documentId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await RunAsync(async () =>
        {
            var result = await EcfApi.SelectDocumentAsync(_draft.DraftId,
                new SelectEcfDraftDocumentRequest(_draft.Revision, documentId));
            SetDraftResult(result, "Official Receipt selection updated. Review is required again.");
        });
    }

    private async Task ResumeDraftAsync()
    {
        if (_draft is null || !_draft.RequiresBusinessDateRefresh) return;
        await RunAsync(async () =>
        {
            var result = await EcfApi.ResumeDraftAsync(_draft.DraftId,
                new EcfDraftRevisionRequest(_draft.Revision));
            SetDraftResult(result, "Draft refreshed for the current Philippine business date. Review the new revision before posting.");
        });
    }

    private async Task ReviewAsync()
    {
        if (_draft is null) return;
        await RunAsync(async () =>
        {
            var result = await EcfApi.ReviewAsync(_draft.DraftId, new EcfDraftRevisionRequest(_draft.Revision));
            SetDraftResult(result, "This exact draft revision was reviewed.");
        });
    }

    private async Task PostAsync()
    {
        if (_draft is null) return;
        await RunAsync(async () =>
        {
            var key = $"stalltrack.ecf.post-operation.{_draft.DraftId:N}.{_draft.Revision}";
            string? stored = await JS.InvokeAsync<string?>("sessionStorage.getItem", key);
            if (!Guid.TryParse(stored, out var operationId))
            {
                operationId = Guid.NewGuid();
                await JS.InvokeVoidAsync("sessionStorage.setItem", key, operationId.ToString("D"));
            }
            var result = await EcfApi.PostAsync(_draft.DraftId,
                new PostEcfCollectionDraftRequest(_draft.Revision, operationId));
            if (!result.IsSuccess)
            {
                _error = ErrorText(result, "ECF Collection could not be posted.");
                return;
            }
            _message = $"Collection {ShortId(result.Value!.CollectionId)} · {result.Value.DocumentNumber} · {Money(result.Value.Amount)} · {result.Value.CurrentDisposition}.";
            await ReloadSupportingDataAsync();
        });
    }

    private async Task DiscardAsync()
    {
        if (_draft is null) return;
        await RunAsync(async () =>
        {
            var result = await EcfApi.DiscardAsync(_draft.DraftId, new EcfDraftRevisionRequest(_draft.Revision));
            if (SetDraftResult(result, "Draft discarded. No financial record or document was created."))
            {
                _draft = null;
                _proposedAmount = 0m;
            }
        });
    }

    private async Task ReloadSupportingDataAsync()
    {
        var current = await EcfApi.GetCurrentDraftAsync();
        _draft = current.IsSuccess ? current.Value : null;
        _proposedAmount = _draft?.TotalAmount ?? 0m;
        var quotes = await EcfApi.GetObligationsAsync(_period.Year, _period.Month);
        if (quotes.IsSuccess) _quotes = quotes.Value?.ToList() ?? [];
        await LoadDraftSourceAsync();
        var receipts = await EcfApi.GetAvailableReceiptsAsync();
        if (receipts.IsSuccess) _availableReceipts = receipts.Value?.ToList() ?? [];
        var from = new DateOnly(_period.Year, _period.Month, 1);
        var activity = await EcfApi.GetActivityAsync(from, from.AddMonths(1).AddDays(-1));
        if (activity.IsSuccess) _activity = activity.Value?.ToList() ?? [];
    }

    private async Task LoadDraftSourceAsync()
    {
        if (_draft?.Lines.FirstOrDefault() is not { } line)
        {
            _draftSourceQuote = null;
            return;
        }
        var quote = _quotes.FirstOrDefault(x => x.UtilityBillId == line.UtilityBillId);
        if (quote is null)
        {
            var result = await EcfApi.GetObligationAsync(line.UtilityBillId);
            quote = result.IsSuccess ? result.Value : null;
        }
        _draftSourceQuote = quote;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private bool SetDraftResult(Result<EcfCollectionDraftDto> result, string successMessage)
    {
        if (!result.IsSuccess)
        {
            _error = ErrorText(result, "The server draft could not be updated.");
            return false;
        }
        _draft = result.Value;
        _proposedAmount = _draft?.TotalAmount ?? 0m;
        _message = successMessage;
        return true;
    }

    private static string ErrorText<T>(Result<T> result, string fallback) =>
        string.IsNullOrWhiteSpace(result.Error) ? fallback : result.Error!;

    private static string PayerLabel(EcfObligationQuoteDto quote) =>
        quote.PayerNameSnapshot ?? "Payer snapshot unavailable";

    private static string SourceContext(EcfObligationQuoteDto quote) =>
        $"{quote.FacilityName} · Stall {quote.StallNo}{(string.IsNullOrWhiteSpace(quote.Section) ? string.Empty : $" · {quote.Section}")} · {MonthName(quote.BillingMonth)} {quote.BillingYear}";

    private static string MeterBasis(EcfObligationQuoteDto quote) =>
        $"{quote.Consumption:N2} kWh × PHP {quote.RatePerKwh:N2}";

    private static string Money(decimal amount) => $"₱{amount:N2}";
    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
    private static string MonthName(int month) => month is >= 1 and <= 12
        ? new DateTime(2000, month, 1).ToString("MMM")
        : "Unknown period";

    private static string SnapshotSummary(string? snapshot)
    {
        if (string.IsNullOrWhiteSpace(snapshot)) return "Snapshot unavailable";
        return "Frozen Electricity source, readings, rate, period, and calculation facts";
    }
}
