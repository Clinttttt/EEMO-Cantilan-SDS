@page "/settings/user-guide"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared

<PageTitle>StallTrack — User Guide</PageTitle>

@* Orientation for the office (panel, User Adoption): what each part of StallTrack is for, in the order the work happens. Static text;
   rates and names are never written here, they are whatever the office has set. *@
<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-title">User Guide</div>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <a class="breadcrumb-link" href="/settings">Settings</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">User Guide</span>
        </div>
    </div>
    <div class="topbar-right">
        <AccountChip />
    </div>
</header>

<div class="content-area">
    <div class="v3-page ug-page">
        <nav class="ug-toc" aria-label="Guide sections">
            <ol>
                @foreach (var s in Sections)
                {
                    <li><a href="@($"/settings/user-guide#{s.Id}")">@s.Title</a></li>
                }
            </ol>
        </nav>

        <div class="v3-panel ug-body">
            @foreach (var s in Sections)
            {
                <section class="ug-section" id="@s.Id" aria-labelledby="@($"{s.Id}-h")">
                    <h2 id="@($"{s.Id}-h")">@s.Title</h2>
                    <ul class="ug-steps">
                        @foreach (var step in s.Steps)
                        {
                            @* The page's name inside the sentence is the link, so no step repeats it as a separate label. *@
                            var at = step.Link is null ? -1 : step.Text.IndexOf(step.Link, StringComparison.Ordinal);
                            <li>
                                @if (at >= 0)
                                {
                                    <text>@(step.Text[..at])<a href="@step.Href">@step.Link</a>@(step.Text[(at + step.Link!.Length)..])</text>
                                }
                                else
                                {
                                    @step.Text
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>

@code {
    // Link is the page's name as it appears in Text; Href is that page.
    private sealed record Step(string Text, string? Link = null, string? Href = null);
    private sealed record Section(string Id, string Title, Step[] Steps);

    private static readonly Section[] Sections =
    [
        new("start", "Getting started",
        [
            new("Sign in with the account the Head created for you."),
            new("The menu holds the daily work: Operations to collect, Monitoring to follow up, Reports to print."),
            new("Turn on two-factor authentication in Settings, under Your account.", "Settings", "/settings"),
            new("Dark mode is at the bottom of the menu. Printed reports always stay light."),
        ]),
        new("billing", "Billing rules",
        [
            new("In Billing Policy, the Head sets the due day, grace period, months payable ahead and whether a whole year may be paid at once.", "Billing Policy", "/settings/billing-policy"),
            new("With Oldest month first on, a payment settles the oldest unpaid month first."),
            new("Late charges: a surcharge once on each unpaid month, then monthly interest on the rent and surcharge, up to the limit set. Enter the ordinance or resolution as the authority."),
            new("A change takes effect on the date chosen. Months already billed keep their rules."),
        ]),
        new("office", "Collecting at the office",
        [
            new("Open Operations, choose the facility or operation, then find the space.", "Operations", "/operations"),
            new("Choose the months being paid and enter the official receipt or cash ticket number."),
            new("Fines and penalties are paid under Fines & Penalties; late charges are added there automatically.", "Fines & Penalties", "/operations/fines"),
            new("Payors' online payments appear in Online Payments. Check anything under Needs attention.", "Online Payments", "/online-payments"),
        ]),
        new("field", "Collecting in the field",
        [
            new("Each collector signs in to the StallTrack collector app with the account set up in Collectors.", "Collectors", "/collectors"),
            new("Today's work lists what each collector is assigned to collect."),
            new("Choose the space or payer, add what is paid, check the total and enter the receipt number issued."),
            new("Without signal, collections wait on the phone and are sent once it is back online."),
            new("Field collections appear in Collection Activity.", "Collection Activity", "/collections/activity"),
        ]),
        new("remit", "Remittance",
        [
            new("Collectors turn over what they collected; the office checks it against the receipts."),
            new("Remittance & Liquidation lists each collector's remittances. Open one to see its receipts and amounts.", "Remittance & Liquidation", "/remittances"),
        ]),
        new("followup", "Following up accounts",
        [
            new("Monitoring lists accounts that need attention: Delinquent, Arrears and missing receipts.", "Monitoring", "/monitoring/follow-up"),
            new("Review account shows unpaid rent, surcharges, interest and the total due, month by month."),
            new("Spaces & Occupants opens any space and its Statement of Account.", "Spaces & Occupants", "/vendors"),
            new("Payors are reminded before rent is due and when it is overdue."),
        ]),
        new("reports", "Reports",
        [
            new("Billing Register: every account of a facility and what it owes. Summary shows the totals.", "Billing Register", "/reports/billing-register"),
            new("Monthly Collection Report: the month's collections by revenue source.", "Monthly Collection Report", "/reports/month-end"),
            new("Every other report is on the Reports page, ready to print.", "Reports", "/reports"),
            new("Audit Trail records who did what, and when.", "Audit Trail", "/audit-trail"),
        ]),
        new("payors", "Payor portal",
        [
            new("Payors open their portal account with the activation code on their Statement of Account."),
            new("They see their balances and payment history, and can pay rent online."),
        ]),
    ];
}
