@page "/operations/transfer-large-cattle"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Constants

<PageTitle>StallTrack — Transfer Large Cattle</PageTitle>

@* Transfer Large Cattle (IA-049): an occasional Official Receipt transaction with a direct approved amount, recorded
   by an assigned collector on Collector Mobile. It is a governed configurable service, kept deliberately simple: no
   livestock registry or certificate system. Nothing on this page records money. The layout owns the <main> landmark. *@
<div class="v3-page">
    @* Identity only: the workspace below owns the collections and setup reads, so the hero adds no second figure or request. *@
    <V3Hero Compact="true" Eyebrow="Operations · Governed service" Title="Transfer Large Cattle">
        <Icon><svg viewBox="0 0 24 24"><path d="M3 8h13l4 4v5h-3" /><circle cx="8" cy="17" r="2" /><circle cx="17" cy="17" r="2" /><path d="M3 8v9h3m5 0h4" /></svg></Icon>
        <Meta><span>Occasional transfer, direct approved amount</span><InstrumentChip Instrument="OR" ShowName="true" /></Meta>
        <Actions><a href="/operations/transfer-large-cattle/report">Report</a></Actions>
    </V3Hero>

    <GovernedServiceWorkspace OperationCode="@CollectorOperationCodes.TransferLargeCattle" Name="Transfer Large Cattle" />
</div>
