@page "/operations/water-consumption-fees/report"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Text
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IWcfCollectionsApiClient WcfApi
@inject IJSRuntime JS

<PageTitle>StallTrack — Water Consumption Fees Report</PageTitle>

@* Printable WCF report. Every figure is either the server's own obligation data through the selected billing month or
   is shown as unavailable ("—"). Nothing is sample data, and no target, rate or percentage is invented. The letterhead
   is the tenant's. The layout owns the <main> landmark. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader Parent="Water Consumption Fees" ParentHref="/operations/water-consumption-fees" Title="WCF Report" Code="WCF">
            <Meta><InstrumentChip Instrument="CT" ShowName="true" /></Meta>
            <Actions>
                <label class="v3-period">
                    <span>Through</span>
                    <input class="v3-input" type="month" aria-label="Report obligations through billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                </label>
                <div class="v3-btn-group" role="group" aria-label="Report actions">
                    <button class="v3-btn" type="button" @onclick="PrintAsync" disabled="@(!Ready)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                        Print
                    </button>
                    @if (Ready)
                    {
                        <a class="v3-btn" href="@ExportHref" download="@($"wcf-report-{_period:yyyy-MM}.csv")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                            Export CSV
                        </a>
                    }
                    else
                    {
                        <button class="v3-btn" type="button" disabled>Export CSV</button>
                    }
                </div>
            </Actions>
        </WorkspaceHeader>
    </div>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row no-print" role="alert">
            <span>@_error The report can't be prepared until they load.</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="wcfr-title" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="Water Consumption Fees Report" Period="@($"Obligations through {PeriodLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>Water Consumption Fees (WCF)</dd></div>
                <div><dt>Instrument</dt><dd>Cash Ticket</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="wcfr-title" class="v3-sr-only">Water Consumption Fees report through @PeriodLabel</h2>

        <MonthlyIncomeUnavailable Classification="WCF" Year="_period.Year" HeadingId="wcfr-official" />

        <section class="v3-report-section" aria-labelledby="wcfr-position">
            <h3 id="wcfr-position">Obligation position — through @PeriodLabel</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col" class="v3-num">Obligations</th>
                            <th scope="col" class="v3-num">With balance</th>
                            <th scope="col" class="v3-num">Approved amount</th>
                            <th scope="col" class="v3-num">Previously settled</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="v3-num">@Figure(_quotes.Count.ToString())</td>
                            <td class="v3-num">@Figure(_quotes.Count(x => x.OutstandingAmount > 0m).ToString())</td>
                            <td class="v3-num">@Figure(Money(TotalAssessed))</td>
                            <td class="v3-num">@Figure(Money(TotalSettled))</td>
                            <td class="v3-num">@Figure(Money(TotalOutstanding))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="v3-report-section" aria-labelledby="wcfr-accounts">
            <h3 id="wcfr-accounts">Obligations — through @PeriodLabel</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Payer / stall</th>
                            <th scope="col">Period</th>
                            <th scope="col" class="v3-num">Approved amount</th>
                            <th scope="col" class="v3-num">Previously settled</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quote in OrderedQuotes)
                        {
                            <tr>
                                <td>@Payer(quote)<span class="v3-block">@Source(quote)</span></td>
                                <td>@Period(quote)</td>
                                <td class="v3-num">@Money(quote.AssessedAmount)</td>
                                <td class="v3-num">@Money(quote.CumulativeSettledEvidence)</td>
                                <td class="v3-num">@Money(quote.OutstandingAmount)</td>
                            </tr>
                        }
                        @if (!_quotes.Any())
                        {
                            <tr><td colspan="5" class="v3-report-note">@(_loading ? "Loading obligations…" : _error is not null ? "Obligations are unavailable." : $"No WCF obligations through {PeriodLabel}.")</td></tr>
                        }
                    </tbody>
                    @if (_quotes.Any())
                    {
                        <tfoot>
                            <tr>
                                <th scope="row" colspan="2">Total · @_quotes.Count obligation@(_quotes.Count == 1 ? "" : "s")</th>
                                <td class="v3-num">@Money(TotalAssessed)</td>
                                <td class="v3-num">@Money(TotalSettled)</td>
                                <td class="v3-num">@Money(TotalOutstanding)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            <p class="v3-report-note">Basis: WCF obligations recorded in StallTrack through this billing month, including earlier periods still unpaid, as of the date prepared. Cash Ticket numbers are recorded per collection.</p>
        </section>
    </article>
</div>

@code {
    private DateOnly _period = PhilippineTime.Today;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private List<WcfObligationQuoteDto> _quotes = [];
    private bool _loading = true;
    private string? _error;

    private string PeriodLabel => _period.ToString("MMMM yyyy");
    private bool Ready => !_loading && _error is null;
    private IEnumerable<WcfObligationQuoteDto> OrderedQuotes => _quotes
        .OrderBy(x => x.FacilityName).ThenBy(x => x.StallNo, StringComparer.OrdinalIgnoreCase)
        .ThenBy(x => x.BillingYear).ThenBy(x => x.BillingMonth);

    // Totals of the listed server figures only.
    private decimal TotalAssessed => _quotes.Sum(x => x.AssessedAmount);
    private decimal TotalSettled => _quotes.Sum(x => x.CumulativeSettledEvidence);
    private decimal TotalOutstanding => _quotes.Sum(x => x.OutstandingAmount);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString() + "-01", "yyyy-MM-dd", out var parsed))
        {
            _period = parsed;
            _monthInput = parsed.ToString("yyyy-MM");
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await WcfApi.GetObligationsAsync(_period.Year, _period.Month);
            if (result.IsSuccess) _quotes = result.Value?.ToList() ?? [];
            else
            {
                _quotes = [];
                _error = "WCF obligations couldn't be loaded.";
            }
        }
        catch
        {
            _quotes = [];
            _error = "WCF obligations couldn't be loaded.";
        }
        finally { _loading = false; }
    }

    private async Task PrintAsync()
    {
        if (Ready) await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");
    }

    private string Figure(string value) => Ready ? value : "—";

    private string ExportHref => $"data:text/csv;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(BuildCsv()))}";

    private string BuildCsv()
    {
        var rows = new List<string>
        {
            Csv("Report", "Water Consumption Fees Report"),
            Csv("Office", Branding.OfficeName),
            Csv("Municipality", $"{Branding.Municipality}, {Branding.Province}"),
            Csv("Obligations through", PeriodLabel),
            Csv("Date prepared", PhilippineTime.Now.ToString("yyyy-MM-dd")),
            Csv("Annual target", "not available"),
            string.Empty,
            Csv("Payer", "Facility", "Stall", "Area", "Period", "Approved amount", "Previously settled", "Outstanding"),
        };
        rows.AddRange(OrderedQuotes.Select(x => Csv(
            Payer(x), x.FacilityName, x.StallNo, x.Section, Period(x),

            x.AssessedAmount.ToString("0.00"), x.CumulativeSettledEvidence.ToString("0.00"), x.OutstandingAmount.ToString("0.00"))));
        rows.Add(Csv("Total", "", "", "", "",
            TotalAssessed.ToString("0.00"), TotalSettled.ToString("0.00"), TotalOutstanding.ToString("0.00")));
        return string.Join("\r\n", rows);
    }

    private static string Csv(params string[] values) =>
        string.Join(",", values.Select(value => $"\"{value.Replace("\"", "\"\"")}\""));

    private static string Payer(WcfObligationQuoteDto quote) => quote.PayerNameSnapshot ?? "Payer snapshot unavailable";

    private static string Source(WcfObligationQuoteDto quote) =>
        $"{quote.FacilityName} · Stall {quote.StallNo}{(string.IsNullOrWhiteSpace(quote.Section) ? "" : $" · {quote.Section}")}";

    private static string Period(WcfObligationQuoteDto quote) => new DateTime(quote.BillingYear, quote.BillingMonth, 1).ToString("MMM yyyy");

    private static string Money(decimal amount) => $"₱{amount:N2}";
}
