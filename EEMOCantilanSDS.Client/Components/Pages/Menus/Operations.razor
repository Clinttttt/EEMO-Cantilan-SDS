@page "/operations"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.Facilities
@inject IFacilitiesApiClient FacilitiesApi

<PageTitle>StallTrack — Operations</PageTitle>

<main class="operations-page">
    <header class="operations-hero">
        <div class="operations-hero-left">
            <span class="operations-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </span>
            <div class="operations-hero-copy">
                <p class="operations-hero-eyebrow">@Branding.OfficeAcronym Admin · Operations</p>
                <h1>Operations</h1>
                <p>Economic-enterprise income and operational workspaces.</p>
            </div>
        </div>
        <div class="operations-hero-metrics" aria-label="Operations summary">
            <div class="operations-hero-metric">
                <span class="operations-hero-value">
                    @if (_loading)
                    {
                        <span aria-label="Loading configured facilities">…</span>
                    }
                    else if (_loadFailed)
                    {
                        <span aria-label="Configured facility count unavailable">—</span>
                    }
                    else
                    {
                        @_facilities.Count
                    }
                </span>
                <span class="operations-hero-key">Configured facilities</span>
            </div>
            <span class="operations-hero-divider" aria-hidden="true"></span>
            <div class="operations-hero-metric">
                <span class="operations-hero-value">3</span>
                <span class="operations-hero-key">Income groups</span>
            </div>
        </div>
        <span class="operations-hero-progress" aria-hidden="true"></span>
    </header>

    @if (_loading)
    {
        <p class="operations-discovery" role="status">Loading configured facility links…</p>
    }
    else if (_loadFailed)
    {
        <div class="operations-discovery operations-discovery-error" role="alert">
            <p>Configured facility links are unavailable.</p>
            <button type="button" @onclick="LoadFacilitiesAsync">Try again</button>
        </div>
    }
    else if (_facilities.Count == 0)
    {
        <p class="operations-discovery" role="status">No configured facility links are currently available.</p>
    }

    <div class="operations-grid">
        <section class="operations-card operations-card-span" aria-labelledby="income-from-market-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.NPM" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="income-from-market-title">Income from Market</h2>
                    <p class="operations-card-label">MARKET OPERATIONS</p>
                    <p class="operations-card-description">Market, utility, vendor, transportation, and enterprise-related collections.</p>
                </div>
            </header>

            <ul class="operations-services operations-services-columns">
                @foreach (var service in IncomeFromMarketServices)
                {
                    var workspace = service.WorkspaceCode is { } workspaceCode ? ConfiguredFacility(workspaceCode) : null;
                    <li class="operations-register-item">
                        @if (workspace is not null)
                        {
                            <a class="operations-register-row operations-register-row-link" href="@FacilityHref(workspace)">
                                <span class="operations-instrument-slot">
                                    @if (service.Instrument is not null)
                                    {
                                        <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                                    }
                                </span>
                                <span class="operations-service-name">@ServiceLabel(service, workspace)</span>
                                <span class="operations-row-chevron" aria-hidden="true">→</span>
                            </a>
                        }
                        else
                        {
                            <div class="operations-register-row">
                                <span class="operations-instrument-slot">
                                    @if (service.Instrument is not null)
                                    {
                                        <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                                    }
                                </span>
                                <span class="operations-service-name">@ServiceLabel(service, workspace)</span>
                                <span class="operations-row-chevron" aria-hidden="true">→</span>
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>

        <section class="operations-card" aria-labelledby="rent-income-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.TCC" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="rent-income-title">Rent Income — Stall Rental</h2>
                    <p class="operations-card-label">RENT INCOME</p>
                    <p class="operations-card-description">Permanent stall and recurring rental income.</p>
                </div>
            </header>

            <ul class="operations-facility-links operations-rental-facility-links" aria-label="Configured rent-income facilities">
                @foreach (var facility in RentIncomeFacilities)
                {
                    <li class="operations-register-item">
                        <a class="operations-register-row operations-register-row-link" href="@FacilityHref(facility)">
                            <span class="operations-instrument-slot">
                                <span class="operations-instrument operations-instrument-or" aria-label="Official Receipt">OR</span>
                            </span>
                            <span class="operations-service-name">@facility.Name (@facility.Code)</span>
                            <span class="operations-row-chevron" aria-hidden="true">→</span>
                        </a>
                    </li>
                }
                <li class="operations-register-item">
                    <div class="operations-register-row">
                        <span class="operations-instrument-slot"></span>
                        <span class="operations-service-name">Arrears</span>
                        <span class="operations-row-chevron" aria-hidden="true">→</span>
                    </div>
                </li>
            </ul>
        </section>

        <section class="operations-card" aria-labelledby="space-rental-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M4 19h16M6 19V8l6-4 6 4v11M9 19v-5h6v5M8 9h.01M12 9h.01M16 9h.01" />
                    </svg>
                </span>
                <div class="operations-card-heading">
                    <h2 id="space-rental-title">Space Rental</h2>
                    <p class="operations-card-label">SPACE RENTAL</p>
                    <p class="operations-card-description">Temporary, open-space, and event-related rental income.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in SpaceRentalServices)
                {
                    <li class="operations-register-item">
                        <div class="operations-register-row">
                            <span class="operations-instrument-slot">
                                @if (service.Instrument is not null)
                                {
                                    <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                                }
                            </span>
                            <span class="operations-service-name">@service.Name</span>
                            <span class="operations-row-chevron" aria-hidden="true">→</span>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="operations-card operations-card-span" aria-labelledby="slaughterhouse-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.SLH" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="slaughterhouse-title">Slaughterhouse</h2>
                    <p class="operations-card-label">SPECIALIZED ENTERPRISE</p>
                    <p class="operations-card-description">Livestock processing, approved slaughter charges, and itemized collection activity.</p>
                </div>
            </header>

            @if (SlaughterhouseWorkspace is { } slaughterhouse)
            {
                <ul class="operations-services" aria-label="Slaughterhouse workspace">
                    <li class="operations-register-item">
                        <a class="operations-register-row operations-register-row-link" href="@FacilityHref(slaughterhouse)">
                            <span class="operations-instrument-slot">
                                <span class="operations-instrument operations-instrument-or" aria-label="Official Receipt">OR</span>
                            </span>
                            <span class="operations-service-name">@slaughterhouse.Name (@slaughterhouse.Code)</span>
                            <span class="operations-row-chevron" aria-hidden="true">→</span>
                        </a>
                    </li>
                </ul>
            }
            else if (!_loading && !_loadFailed)
            {
                <p class="operations-no-facilities">The slaughterhouse workspace is not currently configured.</p>
            }
        </section>

        @if (OtherEconomicEnterpriseWorkspaces.Any())
        {
            <section class="operations-card operations-card-span" aria-labelledby="other-enterprises-title">
                <header class="operations-card-header">
                    <span class="operations-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M3 20h18M5 20V8l7-4 7 4v12M8 20v-5h8v5M8 9h.01M12 9h.01M16 9h.01" />
                        </svg>
                    </span>
                    <div class="operations-card-heading">
                        <h2 id="other-enterprises-title">Other Economic Enterprises</h2>
                        <p class="operations-card-label">CONFIGURED ENTERPRISES</p>
                        <p class="operations-card-description">Tenant-configured enterprise workspaces and additional revenue operations.</p>
                    </div>
                </header>

                <ul class="operations-services operations-additional-links" aria-label="Other configured economic-enterprise workspaces">
                    @foreach (var facility in OtherEconomicEnterpriseWorkspaces)
                    {
                        <li class="operations-register-item">
                            <a class="operations-register-row operations-register-row-link" href="@FacilityHref(facility)">
                                <span class="operations-instrument-slot"></span>
                                <span class="operations-service-name">@facility.Name (@facility.Code)</span>
                                <span class="operations-row-chevron" aria-hidden="true">→</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</main>

@code {
    private static readonly IReadOnlyList<OperationService> IncomeFromMarketServices =
    [
        new("Market Fees", "CT"),
        new("General Distribution / ECF", "OR"),
        new("Water Consumption Fees / WCF", "CT"),
        new("Tabo", "CT", FacilityCode.TPM),
        new("Fish / Meat Vendor Fees", "OR"),
        new("Landing / Berthing", "CT"),
        new("Transportation Fees", "CT", FacilityCode.TRM),
        new("Weight & Measure / Registration", "OR"),
        new("Transfer Large Cattle", null),
        new("Ice Plant", null, FacilityCode.ICE),
    ];

    private static readonly IReadOnlyList<OperationService> SpaceRentalServices =
    [
        new("Vegetable / Fruits", "CT"),
        new("Kanmanggay", "OR"),
        new("Lot Rental — Fiesta / Araw", "OR"),
        new("Fines", "OR"),
    ];

    private IReadOnlyList<FacilitySidebarSummaryDto> _facilities = Array.Empty<FacilitySidebarSummaryDto>();
    private bool _loading = true;
    private bool _loadFailed;

    private IEnumerable<FacilitySidebarSummaryDto> RentIncomeFacilities =>
        new[] { FacilityCode.NPM, FacilityCode.NCC, FacilityCode.TCC, FacilityCode.BBQ }
            .Select(ConfiguredFacility)
            .OfType<FacilitySidebarSummaryDto>();

    private FacilitySidebarSummaryDto? SlaughterhouseWorkspace =>
        ConfiguredFacility(FacilityCode.SLH);

    private IEnumerable<FacilitySidebarSummaryDto> OtherEconomicEnterpriseWorkspaces => _facilities
        .Where(facility => IsRouteable(facility.Code) && IsCustomFacility(facility.Code))
        .OrderBy(facility => facility.Code);

    protected override Task OnInitializedAsync() => LoadFacilitiesAsync();

    private async Task LoadFacilitiesAsync()
    {
        _loading = true;
        _loadFailed = false;

        try
        {
            var period = EEMOCantilanSDS.Domain.Common.PhilippineTime.Now;
            var result = await FacilitiesApi.GetFacilitySummariesAsync(period.Year, period.Month);
            if (!result.IsSuccess || result.Value is null)
            {
                _facilities = Array.Empty<FacilitySidebarSummaryDto>();
                _loadFailed = true;
                return;
            }

            _facilities = result.Value.OrderBy(facility => facility.Code).ToArray();
        }
        catch
        {
            // A discovery page must not substitute the enum/fallback list when the tenant source is unavailable.
            _facilities = Array.Empty<FacilitySidebarSummaryDto>();
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string InstrumentCssClass(string instrument) =>
        $"operations-instrument operations-instrument-{instrument.ToLowerInvariant()}";

    private static string ServiceLabel(OperationService service, FacilitySidebarSummaryDto? workspace) =>
        service.WorkspaceCode == FacilityCode.ICE
            ? $"{workspace?.Name ?? service.Name} ({FacilityCode.ICE})"
            : service.Name;

    private static string InstrumentName(string instrument) => instrument switch
    {
        "OR" => "Official Receipt",
        "CT" => "Cash Ticket",
        _ => instrument,
    };

    private FacilitySidebarSummaryDto? ConfiguredFacility(FacilityCode code) =>
        _facilities.FirstOrDefault(facility => facility.Code == code && IsRouteable(facility.Code));

    private string FacilityHref(FacilitySidebarSummaryDto facility)
    {
        var peers = _facilities.Select(peer => (Code: peer.Code, ShortName: (string?)peer.ShortName));
        var slug = EEMOCantilanSDS.Client.Services.FacilityState.SlugFor(facility.Code, facility.ShortName, peers);
        return $"/facility/{slug}";
    }

    private static bool IsRouteable(FacilityCode code) => Enum.IsDefined(code);

    private static bool IsCustomFacility(FacilityCode code) =>
        (int)code >= (int)FacilityCode.Custom1 && (int)code <= (int)FacilityCode.Custom5;

    private sealed record OperationService(string Name, string? Instrument, FacilityCode? WorkspaceCode = null);
}
