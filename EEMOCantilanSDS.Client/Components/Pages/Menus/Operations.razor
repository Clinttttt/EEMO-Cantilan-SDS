@page "/operations"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.Facilities
@using EEMOCantilanSDS.Domain.Enums
@inject IFacilitiesApiClient FacilitiesApi
@inject IOperationSettingsApiClient OperationSettingsApi
@using EEMOCantilanSDS.Application.Dtos.Settings

<PageTitle>StallTrack — Operations</PageTitle>

@* The layout owns the <main> landmark; this page is a region inside it. *@
<div class="ops-page">
    <header class="ops-header">
        <h1 class="ops-title">Operations</h1>
        <p class="ops-subtitle">Revenue operations and account follow-up</p>
    </header>

    @if (_loading)
    {
        <p class="ops-notice" role="status">Loading configured facilities…</p>
    }
    else if (_loadFailed)
    {
        <div class="ops-notice ops-notice-error" role="alert">
            <p>Configured facilities couldn't be loaded.</p>
            <button type="button" class="ops-retry" @onclick="LoadFacilitiesAsync">Try again</button>
        </div>
    }
    else if (_facilities.Count == 0)
    {
        <p class="ops-notice" role="status">No configured facilities are available.</p>
    }

    @if (!_loading && _settingsFailed)
    {
        @* Which independent operations an office lists is its own configuration. When it can't be read the lines are unknown, not
           absent, so none are guessed at (and none are shown that the office never chose). *@
        <div class="ops-notice ops-notice-error" role="alert">
            <p>This office's operation list couldn't be loaded.</p>
            <button type="button" class="ops-retry" @onclick="LoadFacilitiesAsync">Try again</button>
        </div>
    }

    <div class="ops-sheet">
        <div class="ops-columns" aria-hidden="true">
            <span>Income line</span>
            <span>Receipt</span>
            <span>Pages</span>
            <span></span>
        </div>

        @if (ShowGroup(MarketLines.Count))
        {
        <section class="ops-group" aria-labelledby="income-from-market-title">
            <h2 id="income-from-market-title" class="ops-group-title">
                Income from Market
                <span class="ops-group-count">@LineCount(MarketLines.Count)</span>
            </h2>
            <ul class="ops-rows">
                @foreach (var service in MarketLines)
                {
                    var workspace = service.WorkspaceCode is { } workspaceCode ? ConfiguredFacility(workspaceCode) : null;
                    var href = service.Route ?? (workspace is not null ? FacilityHref(workspace) : null);
                    <li class="ops-item" data-facility-code="@workspace?.Code">
                        @Line(ServiceLabel(service, workspace), service.Code ?? (workspace is null ? null : Acronym(workspace)), service.Receipts, href,
                              workspace is not null ? $"{workspace.Name} ({Acronym(workspace)})" : null,
                              ExtraLinks(service, workspace), Absence(service))
                    </li>
                }
            </ul>
        </section>
        }

        @if (ShowRentGroup)
        {
        <section class="ops-group" aria-labelledby="rent-income-title" aria-busy="@(_loading ? "true" : "false")">
            <h2 id="rent-income-title" class="ops-group-title">
                Rent Income — Stall Rental
                @if (!_loading && !_loadFailed)
                {
                    <span class="ops-group-count">@LineCount(RentIncomeFacilities.Count())</span>
                }
            </h2>
            <ul class="ops-rows" aria-label="Configured rent-income facilities">
                @if (_loading)
                {
                    for (var i = 0; i < 3; i++)
                    {
                        <li class="ops-item ops-item-placeholder" aria-hidden="true">
                            <div class="ops-row"><Skeleton Width="40%" Height="12px" /></div>
                        </li>
                    }
                }
                else if (_loadFailed)
                {
                    @* The rent-income facilities come from the office's own facility record; when it can't be read the
                       lines are unknown, not absent. *@
                    <li class="ops-item ops-item-note">Stall-rental facility lines couldn't be loaded.</li>
                }
                @foreach (var facility in RentIncomeFacilities)
                {
                    <li class="ops-item" data-facility-code="@facility.Code">
                        @Line(facility.Name, Acronym(facility), OfficialReceipt, FacilityHref(facility),
                              $"{facility.Name} ({Acronym(facility)})", FacilityLinks(facility), NoWorkspace)
                    </li>
                }
            </ul>
        </section>
        }

        @if (ShowGroup(SpaceLines.Count + SpaceRentalFacilities.Count()))
        {
        <section class="ops-group" aria-labelledby="space-rental-title">
            <h2 id="space-rental-title" class="ops-group-title">
                Space Rental
                <span class="ops-group-count">@LineCount(SpaceLines.Count + SpaceRentalFacilities.Count())</span>
            </h2>
            <ul class="ops-rows">
                @foreach (var facility in SpaceRentalFacilities)
                {
                    <li class="ops-item" data-facility-code="@facility.Code">
                        @Line(facility.Name, Acronym(facility), OfficialReceipt, FacilityHref(facility),
                              $"{facility.Name} ({Acronym(facility)})", FacilityLinks(facility), NoWorkspace)
                    </li>
                }
                @foreach (var service in SpaceLines)
                {
                    <li class="ops-item">
                        @Line(ServiceLabel(service, null), null, service.Receipts, service.Route, null, service.Links ?? NoLinks, NoWorkspace,
                              SettingFor(service)?.PolicyNotice is null ? null : "Policy confirmation required")
                    </li>
                }
            </ul>
        </section>
        }

        @* Its own official group (Monthly Income B), in the same register as the others rather than a separate card. For an office
           that has adopted tenant configuration it is shown only where it has a Terminal facility, like the other facility-backed lines. *@
        @if (ShowTerminal)
        {
        <section class="ops-group" aria-labelledby="income-from-terminal-title">
            <h2 id="income-from-terminal-title" class="ops-group-title">
                Income From Terminal
                <span class="ops-group-count">@LineCount(1)</span>
            </h2>
            <ul class="ops-rows">
                <li class="ops-item">
            @Line("Terminal", null, CashTicket, "/operations/terminal", null, TerminalLinks, NoWorkspace)
                </li>
            </ul>
        </section>
        }

        @* Shown only with authoritative content: a configured slaughterhouse. An empty shell (or a "not configured" line)
           is not a Monthly Income row and is left out. *@
        @if (SlaughterhouseWorkspace is { } slaughterhouse)
        {
            <section class="ops-group" aria-labelledby="income-from-slaughterhouse-title">
                <h2 id="income-from-slaughterhouse-title" class="ops-group-title">
                    Income From Slaughterhouse
                    <span class="ops-group-count">@LineCount(1)</span>
                </h2>
                <ul class="ops-rows">
                    <li class="ops-item" data-facility-code="@slaughterhouse.Code">
                        @Line(slaughterhouse.Name, Acronym(slaughterhouse), OfficialReceipt, FacilityHref(slaughterhouse),
                              $"{slaughterhouse.Name} ({Acronym(slaughterhouse)})", FacilityLinks(slaughterhouse), NoWorkspace)
                    </li>
                </ul>
            </section>
        }

        <section class="ops-group" aria-labelledby="follow-up-operations-title">
            <h2 id="follow-up-operations-title" class="ops-group-title">Others <span class="ops-group-count">2 lines</span></h2>
            <ul class="ops-rows">
                <li class="ops-item">@Line("Arrears & Delinquency", null, NoReceipt, "/operations/arrears", null, ArrearsLinks, NoWorkspace)</li>
                <li class="ops-item">@Line("Fines & Penalties", null, OfficialReceipt, "/operations/fines", null, NoLinks, NoWorkspace)</li>
            </ul>
        </section>

    </div>
</div>

@code {
    private static readonly Receipt[] OfficialReceipt = [new("OR")];
    private static readonly Receipt[] CashTicket = [new("CT")];
    private static readonly Receipt[] NoReceipt = [];
    private static readonly QuickLink[] NoLinks = [];
    private static readonly QuickLink[] ArrearsLinks = [new("Report", "/operations/arrears/report")];
    private static readonly QuickLink[] TerminalLinks = [new("Report", "/operations/terminal/report")];

    /// <summary>The pages a facility has beside its workspace: its reports, and the Slaughterhouse's slaughter list.</summary>
    private QuickLink[] FacilityLinks(FacilitySidebarSummaryDto facility) => facility.Code switch
    {
        FacilityCode.NPM => facility.Archetype == BillingArchetype.MonthlyRental
            ? [new("Reports", "/facility/market-rent/reports")]
            : [new("Reports", "/npm/reports")],
        FacilityCode.TCC => [new("Reports", "/tcc/reports")],
        FacilityCode.NCC => [new("Reports", "/ncc/reports")],
        FacilityCode.BBQ => [new("Reports", "/bbq/reports")],
        FacilityCode.ICE => [new("Reports", "/ice/reports")],
        FacilityCode.SLH => [new("Reports", "/slh/reports"), new("Slaughter list", "/reports/slaughterhouse")],
        _ when IsCustomFacility(facility.Code) => [new("Reports", $"/{facility.Code.ToString().ToLowerInvariant()}/reports")],
        _ => NoLinks
    };

    /// <summary>At most this many page names fit the column; the rest are counted ("+2") and named in the tooltip and hover card.</summary>
    private const int ShownPages = 3;

    private static readonly IReadOnlyList<OperationService> IncomeFromMarketServices =
    [
        new("Market Fees", CashTicket, Route: "/operations/market-fees",
            OperationCode: "MARKET_FEES",
            Links: [new("Report", "/operations/market-fees/report")]),
        // Display names per Clint (2026-09-30); the office sheet row reads "Gen. Distribution / ECF".
        new("Electricity Consumption Fees", OfficialReceipt, Route: "/operations/ecf", Code: "ECF",
            OperationCode: "ECF",
            Links: [new("Accounts", "/operations/ecf/accounts"), new("Statements", "/operations/ecf/statements"), new("Report", "/operations/ecf/report")]),
        new("Water Consumption Fees", CashTicket, Route: "/operations/water-consumption-fees", Code: "WCF",
            OperationCode: "WCF",
            Links: [new("Accounts", "/operations/water-consumption-fees/accounts"), new("Statements", "/operations/water-consumption-fees/statements"), new("Report", "/operations/water-consumption-fees/report")]),
        // Tabo = OR per IA-045 (EEMO Head, 2026-09-27).
        new("Tabo", OfficialReceipt, FacilityCode.TPM, Links: [new("Report", "/facility/tpm/report")]),
        new("Fish | Meat Vendor Fees", OfficialReceipt, Route: "/operations/fish-meat-vendor-fees",
            OperationCode: "FISH_MEAT_VENDOR_FEE",
            Links: [new("Registry", "/operations/fish-meat-vendor-fees/manage"), new("Holder list", "/operations/fish-meat-vendor-fees/holder-list"), new("Report", "/operations/fish-meat-vendor-fees/report")]),
        new("Landing | Berthing", CashTicket, Route: "/operations/landing-berthing",
            OperationCode: "LANDING_BERTHING",
            Links: [new("Report", "/operations/landing-berthing/report")]),
        // Cash Ticket on Collector Mobile, direct amount received; it is a separate source from Income From Terminal.
        new("Transportation | Parking", CashTicket, Route: "/operations/transportation",
            OperationCode: "TRANSPORTATION",
            Links: [new("Report", "/operations/transportation/report")]),
        new("Weight & Measure", OfficialReceipt, Route: "/operations/weight-and-measure", OperationCode: "WEIGHT_AND_MEASURE",
            Links: [new("Report", "/operations/weight-and-measure/report")]),
        // Official Receipt, Collector Mobile, direct approved amount (IA-049).
        new("Transfer Large Cattle", OfficialReceipt, Route: "/operations/transfer-large-cattle",
            OperationCode: "TRANSFER_LARGE_CATTLE",
            Links: [new("Report", "/operations/transfer-large-cattle/report")]),
        // Official Receipt, own ICE_PLANT classification (IA-050); monthly obligation, installments allowed.
        new("Ice Plant", OfficialReceipt, FacilityCode.ICE),
    ];

    private static readonly IReadOnlyList<OperationService> SpaceRentalServices =
    [
        // Whole payment = OR, daily transaction = CT per IA-046 (EEMO Head, 2026-09-27).
        new("Vegetable | Fruits", [new("OR", "Monthly rental"), new("CT", "Daily transaction")], Route: "/operations/vegetable-fruit",
            OperationCode: "VEGETABLE_FRUIT_SPACE_RENTAL",
            Links: [new("Space holders", "/operations/vegetable-fruit/space-holders"), new("Daily report", "/operations/vegetable-fruit/daily-report"), new("Report", "/operations/vegetable-fruit/report")]),
        new("Kanmanggay", OfficialReceipt, Route: "/operations/kanmanggay",
            OperationCode: "KANMANGGAY_SPACE_RENTAL",
            Links: [new("Space holders", "/operations/kanmanggay/space-holders"), new("Report", "/operations/kanmanggay/report")]),
        new("Fiesta | Araw", OfficialReceipt, Route: "/operations/fiesta-araw",
            OperationCode: "FIESTA_ARAW_LOT_RENTAL",
            Links: [new("Space holders", "/operations/fiesta-araw/space-holders"), new("Report", "/operations/fiesta-araw/report")]),
    ];

    // The tenant's own acronym for a facility ("RR"), never its internal slot code ("Custom1"): the saved short name, else one derived from its name.
    private string Acronym(FacilitySidebarSummaryDto facility) =>
        EEMOCantilanSDS.Client.Services.FacilityState.AcronymOf(facility);

    private IReadOnlyList<FacilitySidebarSummaryDto> _facilities = Array.Empty<FacilitySidebarSummaryDto>();
    private bool _loading = true;
    private bool _loadFailed;
    private TenantOperationSettingsDto? _settings;
    private bool _settingsFailed;

    /// <summary>
    /// The facility list fetched during prerender, carried into the interactive pass so the page asks the API once
    /// per load instead of twice. Only a successful load is stored; a failure still loads again and Try again always
    /// re-fetches.
    /// </summary>
    [PersistentState(AllowUpdates = true)]
    public FacilitySidebarSummaryDto[]? CachedFacilities { get; set; }

    /// <summary>The office's operation configuration, carried across prerender for the same reason as the facilities.</summary>
    [PersistentState(AllowUpdates = true)]
    public TenantOperationSettingsDto? CachedSettings { get; set; }

    private IEnumerable<FacilitySidebarSummaryDto> RentIncomeFacilities =>
        new[] { FacilityCode.NPM, FacilityCode.NCC, FacilityCode.TCC, FacilityCode.BBQ, FacilityCode.Custom1, FacilityCode.Custom2, FacilityCode.Custom3, FacilityCode.Custom4, FacilityCode.Custom5 }
            .Select(ConfiguredFacility)
            .OfType<FacilitySidebarSummaryDto>()
            .Where(f => !IsCustomFacility(f.Code) || f.CustomCategory == CustomFacilityCategory.StallRent);

    private IEnumerable<FacilitySidebarSummaryDto> SpaceRentalFacilities =>
        new[] { FacilityCode.Custom1, FacilityCode.Custom2, FacilityCode.Custom3, FacilityCode.Custom4, FacilityCode.Custom5 }
            .Select(ConfiguredFacility).OfType<FacilitySidebarSummaryDto>()
            .Where(f => f.CustomCategory == CustomFacilityCategory.SpaceRental);

    private FacilitySidebarSummaryDto? SlaughterhouseWorkspace =>
        ConfiguredFacility(FacilityCode.SLH);

    protected override Task OnInitializedAsync()
    {
        if (CachedFacilities is { } cached && CachedSettings is { } cachedSettings)
        {
            _facilities = cached;
            _settings = cachedSettings;
            _loading = false;
            return Task.CompletedTask;
        }

        return LoadFacilitiesAsync();
    }

    private async Task LoadFacilitiesAsync()
    {
        _loading = true;
        _loadFailed = false;
        _settingsFailed = false;

        await LoadSettingsAsync();

        try
        {
            var period = EEMOCantilanSDS.Domain.Common.PhilippineTime.Now;
            var result = await FacilitiesApi.GetFacilitySummariesAsync(period.Year, period.Month);
            if (!result.IsSuccess || result.Value is null)
            {
                _facilities = Array.Empty<FacilitySidebarSummaryDto>();
                _loadFailed = true;
                return;
            }

            var facilities = result.Value.OrderBy(facility => facility.Code).ToArray();
            _facilities = facilities;
            CachedFacilities = facilities;
        }
        catch
        {
            // A discovery page must not substitute the enum/fallback list when the tenant source is unavailable.
            _facilities = Array.Empty<FacilitySidebarSummaryDto>();
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var result = await OperationSettingsApi.GetAsync();
            if (result.IsSuccess && result.Value is not null)
            {
                _settings = result.Value;
                CachedSettings = result.Value;
                return;
            }
        }
        catch
        {
            // Falls through to the unknown state below.
        }

        _settings = null;
        _settingsFailed = true;
    }

    /// <summary>
    /// True once the office has adopted tenant operation configuration (it declared operations at onboarding, or its Head has
    /// edited them). An office that has not is read with the documented legacy fallback: every line shown, under its established
    /// name - which is how Cantilan and every office activated before configuration existed behave, unchanged.
    /// </summary>
    private bool Adopted => _settings?.UsesConfiguration == true;

    private TenantOperationSettingDto? SettingFor(OperationService service) =>
        service.OperationCode is null ? null : _settings?.Items.FirstOrDefault(i => i.OperationCode == service.OperationCode);

    /// <summary>
    /// The lines this office lists. An independent operation is shown when the office lists it; a facility-backed one (Tabo, Ice
    /// Plant) only when it has that facility. While the configuration is unknown (loading, or it failed) nothing is guessed.
    /// Listing is presentation: it never decides whether anything may be collected, and hiding a line removes no data or history.
    /// </summary>
    private IReadOnlyList<OperationService> VisibleServices(IReadOnlyList<OperationService> services)
    {
        if (_settings is null) return Array.Empty<OperationService>();
        if (!Adopted) return services;
        return services.Where(service => service.OperationCode is null
            ? service.WorkspaceCode is { } code && ConfiguredFacility(code) is not null
            : SettingFor(service)?.IsListed == true).ToList();
    }

    private IReadOnlyList<OperationService> MarketLines => VisibleServices(IncomeFromMarketServices);

    private IReadOnlyList<OperationService> SpaceLines => VisibleServices(SpaceRentalServices);

    /// <summary>A group is shown when it has lines; the legacy fallback always shows its groups, as it always has.</summary>
    private bool ShowGroup(int lines) => _settings is not null && (!Adopted || lines > 0);

    private bool ShowRentGroup => _loading || _loadFailed || _settings is null || !Adopted || RentIncomeFacilities.Any();

    private bool ShowTerminal => _settings is not null && (!Adopted || ConfiguredFacility(FacilityCode.TRM) is not null);

    /// <summary>
    /// One register line: a single link when a workspace exists, plain text otherwise (no navigation affordance),
    /// plus a detail card revealed by CSS on hover or keyboard focus — no server round-trip per hover.
    /// </summary>
    private const string NoWorkspace = "No workspace yet";

    /// <summary>
    /// Why a facility-backed line has no link: the office's facility record is still loading, couldn't be read, or
    /// does not configure that facility. Only the last is a statement about the office.
    /// </summary>
    private string Absence(OperationService service) => service.WorkspaceCode is null
        ? NoWorkspace
        : _loading ? "Loading…"
        : _loadFailed ? "Couldn't be loaded"
        : "Not configured for this office";

    private RenderFragment Line(string name, string? facilityCode, IReadOnlyList<Receipt> receipts, string? href,
        string? workspace, IReadOnlyList<QuickLink> links, string absence, string? detail = null) => __builder =>
    {
        if (href is not null)
        {
            <a class="ops-row ops-row-link" href="@href">
                @LineCells(name, facilityCode, receipts, links, linked: true, detail: detail)
            </a>
        }
        else
        {
            <div class="ops-row">
                @LineCells(name, facilityCode, receipts, links, linked: false, absence, detail)
            </div>
        }

        <div class="ops-card">
            <div class="ops-card-body">
                <p class="ops-card-title">@name</p>
                <dl class="ops-card-facts">
                    @foreach (var receipt in receipts)
                    {
                        <dt>@(receipt.When ?? "Receipt")</dt>
                        <dd>@InstrumentName(receipt.Instrument)</dd>
                    }
                    <dt>Workspace</dt>
                    <dd>@(href is null ? absence : workspace ?? name)</dd>
                </dl>
                @if (href is not null)
                {
                    <div class="ops-card-links">
                        <a href="@href">Open</a>
                        @foreach (var link in links)
                        {
                            <a href="@link.Href">@link.Label</a>
                        }
                    </div>
                }
            </div>
        </div>
    };

    private RenderFragment LineCells(string name, string? facilityCode, IReadOnlyList<Receipt> receipts,
        IReadOnlyList<QuickLink> links, bool linked, string? absence = null, string? detail = null) => __builder =>
    {
        <span class="ops-row-name">
            @name
            @if (facilityCode is not null)
            {
                <span class="ops-row-code">@facilityCode</span>
            }
            @if (detail is not null)
            {
                <small class="ops-row-detail">@detail</small>
            }
        </span>
        <span class="ops-row-receipts">
            @foreach (var receipt in receipts)
            {
                <span class="@InstrumentCssClass(receipt.Instrument)">
                    <span aria-hidden="true">@receipt.Instrument</span>
                    <span class="ops-sr-only">@(receipt.When is null ? InstrumentName(receipt.Instrument) : $"{receipt.When}: {InstrumentName(receipt.Instrument)}")</span>
                </span>
            }
        </span>
        <span class="ops-row-pages">
            @if (linked)
            {
                var pages = links.Select(link => link.Label).Prepend("Workspace").ToList();
                <span class="ops-pages-list" title="@string.Join(" · ", pages)">@string.Join(" · ", pages.Take(ShownPages))</span>
                @if (pages.Count > ShownPages)
                {
                    <span class="ops-pages-more" aria-hidden="true">+@(pages.Count - ShownPages)</span>
                    <span class="ops-sr-only">@string.Join(", ", pages.Skip(ShownPages))</span>
                }
            }
            else
            {
                <span aria-hidden="true">—</span>
                <span class="ops-sr-only">@(absence ?? NoWorkspace)</span>
            }
        </span>
        <span class="ops-row-go" aria-hidden="true">
            @if (linked)
            {
                <svg viewBox="0 0 24 24" focusable="false"><polyline points="9 6 15 12 9 18" /></svg>
            }
        </span>
    };

    private IReadOnlyList<QuickLink> ExtraLinks(OperationService service, FacilitySidebarSummaryDto? workspace) =>
        service.Route is not null || workspace is not null
            ? service.Links ?? (workspace is not null ? FacilityLinks(workspace) : NoLinks)
            : NoLinks;

    private static string LineCount(int count) => count == 1 ? "1 line" : $"{count} lines";

    private static string InstrumentCssClass(string instrument) =>
        $"ops-instrument ops-instrument-{instrument.ToLowerInvariant()}";

    private string ServiceLabel(OperationService service, FacilitySidebarSummaryDto? workspace) =>
        service.WorkspaceCode == FacilityCode.ICE ? workspace?.Name ?? service.Name : SettingFor(service)?.DisplayName ?? service.Name;

    private static string InstrumentName(string instrument) => instrument switch
    {
        "OR" => "Official Receipt",
        "CT" => "Cash Ticket",
        _ => instrument,
    };

    private FacilitySidebarSummaryDto? ConfiguredFacility(FacilityCode code) =>
        _facilities.FirstOrDefault(facility => facility.Code == code && IsRouteable(facility.Code));

    private string FacilityHref(FacilitySidebarSummaryDto facility)
    {
        var peers = _facilities.Select(peer => (Code: peer.Code, ShortName: (string?)peer.ShortName));
        var slug = EEMOCantilanSDS.Client.Services.FacilityState.SlugFor(facility.Code, facility.ShortName, peers);
        return $"/facility/{slug}";
    }

    private static bool IsRouteable(FacilityCode code) => Enum.IsDefined(code);

    private static bool IsCustomFacility(FacilityCode code) =>
        (int)code >= (int)FacilityCode.Custom1 && (int)code <= (int)FacilityCode.Custom5;

    private sealed record Receipt(string Instrument, string? When = null);

    private sealed record QuickLink(string Label, string Href);

    private sealed record OperationService(
        string Name,
        IReadOnlyList<Receipt> Receipts,
        FacilityCode? WorkspaceCode = null,
        string? Route = null,
        IReadOnlyList<QuickLink>? Links = null,
        string? Code = null,
        // The stable tenant-operation code, for a line the municipality itself lists and names. Null for a facility-backed line.
        string? OperationCode = null);
}
