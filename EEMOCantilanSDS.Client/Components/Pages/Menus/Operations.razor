@page "/operations"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.Facilities
@inject IFacilitiesApiClient FacilitiesApi

<PageTitle>StallTrack — Operations</PageTitle>

<main class="operations-page">
    <header class="operations-hero">
        <div class="operations-hero-left">
            <span class="operations-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </span>
            <div class="operations-hero-copy">
                <p class="operations-hero-eyebrow">@Branding.OfficeAcronym Admin · Operations</p>
                <h1>Operations</h1>
                <p>Facility workspaces and economic-enterprise services.</p>
            </div>
        </div>
        <div class="operations-hero-metrics" aria-label="Operations summary">
            <div class="operations-hero-metric">
                <span class="operations-hero-value">
                    @if (_loading)
                    {
                        <span aria-label="Loading configured facilities">…</span>
                    }
                    else if (_loadFailed)
                    {
                        <span aria-label="Configured facility count unavailable">—</span>
                    }
                    else
                    {
                        @_facilities.Count
                    }
                </span>
                <span class="operations-hero-key">Configured facilities</span>
            </div>
            <span class="operations-hero-divider" aria-hidden="true"></span>
            <div class="operations-hero-metric">
                <span class="operations-hero-value">6</span>
                <span class="operations-hero-key">Operational areas</span>
            </div>
        </div>
        <span class="operations-hero-progress" aria-hidden="true"></span>
    </header>

    @if (_loading)
    {
        <p class="operations-discovery" role="status">Loading configured facility links…</p>
    }
    else if (_loadFailed)
    {
        <div class="operations-discovery operations-discovery-error" role="alert">
            <p>Configured facility links are unavailable.</p>
            <button type="button" @onclick="LoadFacilitiesAsync">Try again</button>
        </div>
    }
    else if (_facilities.Count == 0)
    {
        <p class="operations-discovery" role="status">No configured facility links are currently available.</p>
    }

    <div class="operations-grid">
        <section class="operations-card" aria-labelledby="public-market-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.NPM" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="public-market-title">Public Market</h2>
                    <p class="operations-card-label">MARKET OPERATIONS</p>
                    <p class="operations-card-description">Permanent market spaces and related collection services.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in PublicMarketServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (ConfiguredFacility(FacilityCode.NPM) is { } npm)
            {
                <div class="operations-card-actions">
                    <a class="operations-action-link" href="@FacilityHref(npm)">
                        Open @npm.Name
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            }
        </section>

        <section class="operations-card" aria-labelledby="rental-spaces-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.TCC" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="rental-spaces-title">Commercial &amp; Rental Spaces</h2>
                    <p class="operations-card-label">RENTAL OPERATIONS</p>
                    <p class="operations-card-description">Permanent rental facilities and recurring space obligations.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in CommercialRentalServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            <div class="operations-card-actions">
                @if (RentalFacilities.Any())
                {
                    <ul class="operations-facility-links" aria-label="Configured rental facilities">
                        @foreach (var facility in RentalFacilities)
                        {
                            <li>
                                <a class="operations-facility-link" href="@FacilityHref(facility)">
                                    <span class="operations-facility-code">@facility.ShortName</span>
                                    <span class="operations-facility-name">@facility.Name</span>
                                    <span class="operations-facility-arrow" aria-hidden="true">→</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else if (!_loading && !_loadFailed)
                {
                    <p class="operations-no-facilities">No configured rental facilities are available.</p>
                }
            </div>
        </section>

        <section class="operations-card" aria-labelledby="temporary-space-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M4 19h16M6 19V8l6-4 6 4v11M9 19v-5h6v5M8 9h.01M12 9h.01M16 9h.01" />
                    </svg>
                </span>
                <div class="operations-card-heading">
                    <h2 id="temporary-space-title">Temporary / Open-Space Rental</h2>
                    <p class="operations-card-label">SPACE &amp; EVENT OPERATIONS</p>
                    <p class="operations-card-description">Temporary selling spaces, open-space use, and event or lot rentals.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in TemporarySpaceServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>

        <section class="operations-card" aria-labelledby="taboan-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.TPM" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="taboan-title">Tabo-an Public Market</h2>
                    <p class="operations-card-label">MARKET-DAY OPERATIONS</p>
                    <p class="operations-card-description">Market-day vendor activity and Tabo collections.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in TaboanServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (ConfiguredFacility(FacilityCode.TPM) is { } tpm)
            {
                <div class="operations-card-actions">
                    <a class="operations-action-link" href="@FacilityHref(tpm)">
                        Open @tpm.Name
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            }
        </section>

        <section class="operations-card" aria-labelledby="transport-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.TRM" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="transport-title">Transportation &amp; Parking</h2>
                    <p class="operations-card-label">TRANSPORT OPERATIONS</p>
                    <p class="operations-card-description">Terminal trips and future vehicle-class based transportation collections.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in TransportationServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (ConfiguredFacility(FacilityCode.TRM) is { } trm)
            {
                <div class="operations-card-actions">
                    <a class="operations-action-link" href="@FacilityHref(trm)">
                        Open @trm.Name
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            }
        </section>

        <section class="operations-card" aria-labelledby="slaughterhouse-title">
            <header class="operations-card-header">
                <span class="operations-card-icon" aria-hidden="true">
                    <FacilityMark Code="FacilityCode.SLH" Ink="FacilityMarkInk.White" Size="20" />
                </span>
                <div class="operations-card-heading">
                    <h2 id="slaughterhouse-title">Slaughterhouse</h2>
                    <p class="operations-card-label">SERVICE OPERATIONS</p>
                    <p class="operations-card-description">Per-animal slaughter activity and approved service charges.</p>
                </div>
            </header>

            <ul class="operations-services">
                @foreach (var service in SlaughterhouseServices)
                {
                    <li class="operations-service-row">
                        <span class="operations-service-name">@service.Name</span>
                        <span class="operations-service-status">
                            @if (service.Instrument is not null)
                            {
                                <span class="@InstrumentCssClass(service.Instrument)" aria-label="@InstrumentName(service.Instrument)">@service.Instrument</span>
                            }
                            @if (service.Status is not null)
                            {
                                <span class="@StatusCssClass(service.Status)">@service.Status</span>
                            }
                        </span>
                    </li>
                }
            </ul>

            @if (ConfiguredFacility(FacilityCode.SLH) is { } slh)
            {
                <div class="operations-card-actions">
                    <a class="operations-action-link" href="@FacilityHref(slh)">
                        Open @slh.Name
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            }
        </section>
    </div>

    <section class="operations-additional" aria-label="Additional planned service">
        <div class="operations-additional-heading">
            <p class="operations-additional-label">ADDITIONAL PLANNED SERVICE</p>
            <h2>Landing / Berthing</h2>
        </div>
        <div class="operations-additional-status" aria-label="Cash Ticket policy reference, planned for V2">
            <span class="operations-instrument operations-instrument-ct" aria-label="Cash Ticket">CT</span>
            <span class="operations-status-badge operations-status-planned-v2">Planned V2</span>
        </div>
    </section>
</main>

@code {
    private static readonly IReadOnlyList<OperationService> PublicMarketServices =
    [
        new("Permanent stalls / applicable permanent rental", "OR", null),
        new("Market Fees", "CT", null),
        new("ECF", "OR", null),
        new("WCF", "CT", "Planned"),
        new("Fish / Meat Vendor Fee", "OR", null),
        new("Weight & Measure", "OR", null),
        new("Penalties / Fines", "OR", null),
    ];

    private static readonly IReadOnlyList<OperationService> CommercialRentalServices =
    [
        new("Applicable permanent rental charges", "OR", null),
    ];

    private static readonly IReadOnlyList<OperationService> TemporarySpaceServices =
    [
        new("Vegetable / Fruit Space Rental", "CT", null),
        new("Kanmanggay / Space Rental", null, "Planned"),
        new("Lot / Event Rental", null, "Planned"),
    ];

    private static readonly IReadOnlyList<OperationService> TaboanServices =
    [
        new("Tabo / market-day collection", "CT", null),
    ];

    private static readonly IReadOnlyList<OperationService> TransportationServices =
    [
        new("Current terminal activity", null, "Current"),
        new("Transportation / Parking", "CT", null),
        new("Vehicle-class rate model", null, "Planned"),
    ];

    private static readonly IReadOnlyList<OperationService> SlaughterhouseServices =
    [
        new("Current approved slaughter charges", "OR", null),
        new("Approved configurable add-ons", null, "Planned"),
    ];

    private IReadOnlyList<FacilitySidebarSummaryDto> _facilities = Array.Empty<FacilitySidebarSummaryDto>();
    private bool _loading = true;
    private bool _loadFailed;

    private IEnumerable<FacilitySidebarSummaryDto> RentalFacilities => _facilities
        .Where(facility => facility.Code is FacilityCode.TCC or FacilityCode.NCC or FacilityCode.BBQ or FacilityCode.ICE
            || IsCustomFacility(facility.Code))
        .OrderBy(facility => facility.Code);

    protected override Task OnInitializedAsync() => LoadFacilitiesAsync();

    private async Task LoadFacilitiesAsync()
    {
        _loading = true;
        _loadFailed = false;

        try
        {
            var period = EEMOCantilanSDS.Domain.Common.PhilippineTime.Now;
            var result = await FacilitiesApi.GetFacilitySummariesAsync(period.Year, period.Month);
            if (!result.IsSuccess || result.Value is null)
            {
                _facilities = Array.Empty<FacilitySidebarSummaryDto>();
                _loadFailed = true;
                return;
            }

            _facilities = result.Value.OrderBy(facility => facility.Code).ToArray();
        }
        catch
        {
            // A discovery page must not substitute the enum/fallback list when the tenant source is unavailable.
            _facilities = Array.Empty<FacilitySidebarSummaryDto>();
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string InstrumentCssClass(string instrument) =>
        $"operations-instrument operations-instrument-{instrument.ToLowerInvariant()}";

    private static string StatusCssClass(string status) =>
        $"operations-status-badge operations-status-{status.ToLowerInvariant().Replace(' ', '-')}";

    private static string InstrumentName(string instrument) => instrument switch
    {
        "OR" => "Official Receipt",
        "CT" => "Cash Ticket",
        _ => instrument,
    };

    private FacilitySidebarSummaryDto? ConfiguredFacility(FacilityCode code) =>
        _facilities.FirstOrDefault(facility => facility.Code == code && IsRouteable(facility.Code));

    private string FacilityHref(FacilitySidebarSummaryDto facility)
    {
        var peers = _facilities.Select(peer => (Code: peer.Code, ShortName: (string?)peer.ShortName));
        var slug = EEMOCantilanSDS.Client.Services.FacilityState.SlugFor(facility.Code, facility.ShortName, peers);
        return $"/facility/{slug}";
    }

    private static bool IsRouteable(FacilityCode code) => Enum.IsDefined(code);

    private static bool IsCustomFacility(FacilityCode code) =>
        (int)code >= (int)FacilityCode.Custom1 && (int)code <= (int)FacilityCode.Custom5;

    private sealed record OperationService(string Name, string? Instrument, string? Status);
}
