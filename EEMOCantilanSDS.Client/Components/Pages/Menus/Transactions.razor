@page "/transactions"
@page "/collections/activity"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@using EEMOCantilanSDS.Application.Dtos.Collections
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Client.Components.Shared
@inject ICollectionActivityApiClient ActivityApi
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog

<PageTitle>StallTrack — Collection Activity</PageTitle>
<OperationNameWatcher OnChanged="@(() => StateHasChanged())" />

<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-title">Collection Activity</div>
        <div class="topbar-breadcrumb">
            <span>@Branding.OfficeAcronym Admin</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-active">Collection Activity</span>
        </div>
    </div>
    <div class="topbar-right">
        <a class="v3-btn v3-btn-sm" href="/reports/collection-reconciliation">Reconciliation</a>
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @PhilippineTime.Now.ToString("MMMM d, yyyy")
        </div>
    </div>
</header>

<div class="content-area">

    <V3Hero Eyebrow="@($"{Branding.OfficeAcronym} Admin · Collections")" Title="Collection Activity"
            Subtitle="Posted collections and recorded legacy payments.">
        <Icon>
            <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z" /><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" /></svg>
        </Icon>
        <Figures>
            <V3HeroFigure Label="Records" Value="@Visible.Count.ToString("N0")" Note="@SelectedDate.ToString("MMM d, yyyy")" />
            <V3HeroFigure Label="Collected" Value="@($"₱{Visible.Sum(e => e.Amount):N2}")" Note="@ScopeLabel" />
            @if (Visible.Any(e => e.Verification is not null))
            {
                @* Collector direct collections only. The cash above is counted whether or not it is verified; this is the part the Head has confirmed. *@
                <V3HeroFigure Label="Direct, verified" Value="@($"₱{Visible.Where(e => e.Verification == "Verified").Sum(e => e.NetAmount):N2}")"
                              Note="@($"of ₱{Visible.Where(e => e.Verification is not null and not "Reversed").Sum(e => e.NetAmount):N2} recorded")" />
            }
            @if (Visible.Any(e => e.CorrectionEffect != 0m))
            {
                <V3HeroFigure Label="Net after corrections" Value="@($"₱{Visible.Sum(e => e.NetAmount):N2}")" />
            }
        </Figures>
    </V3Hero>

    <!-- Controls: source scope + source + day navigator (single row) -->
    <div class="txn-controls">
            <div class="txn-segment" role="group" aria-label="Source scope">
                @foreach (var g in Scopes)
                {
                    <button type="button"
                            class="txn-seg-tab @(_scope == g.Key ? "active" : "")"
                            aria-pressed="@(_scope == g.Key ? "true" : "false")"
                            @onclick="() => SetScope(g.Key)">
                        @g.Label
                    </button>
                }
            </div>
            <div class="txn-source">
                <FhSelect Caption="Source" Value="@_source" Options="@SourceOptions" ValueChanged="@(v => _source = v)" />
            </div>

        <div class="txn-nav">
            <div class="txn-daynav">
                <button type="button" class="txn-navbtn" @onclick="PrevDay" aria-label="Previous day">
                    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
                </button>

                <div class="txn-datebox @(IsToday ? "is-today" : "")" @onclick="OpenPicker">
                    <div class="txn-datebox-icon">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    </div>
                    <div class="txn-datebox-text">
                        <span class="txn-datebox-main">@(IsToday ? "Today" : SelectedDate.ToString("dddd"))</span>
                        <span class="txn-datebox-sub">@SelectedDate.ToString("MMMM d, yyyy")</span>
                    </div>
                    <svg class="txn-datebox-chev" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                    <input type="date" @ref="_dateInput" class="txn-datebox-input" value="@SelectedDate.ToString("yyyy-MM-dd")"
                           max="@PhilippineTime.Today.ToString("yyyy-MM-dd")" @onchange="OnDatePicked" aria-label="Pick a date" />
                </div>

                <button type="button" class="txn-navbtn" disabled="@IsToday" @onclick="NextDay" aria-label="Next day">
                    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </button>

                @if (!IsToday)
                {
                    <button type="button" class="txn-jump-today" @onclick="GoToday" title="Jump to Today" aria-label="Jump to today">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15 14" /></svg>
                    </button>
                }
            </div>

            <button type="button" class="txn-refresh" title="Refresh" aria-label="Refresh" @onclick="Reload">
                <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" /></svg>
            </button>
        </div>
        <div class="txn-search-row">
            <div class="txn-search">
                <svg class="txn-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" class="txn-search-input" placeholder="Search SRC or payer" aria-label="Search by SRC, document or payer" autocomplete="off"
                       value="@_search" @oninput="OnSearchInputAsync" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button type="button" class="txn-search-clear" aria-label="Clear search" @onclick="ClearSearch">×</button>
                }
            </div>
            <DirectCollectionReview @ref="_directReview" />
        </div>
    </div>

    <!-- Feed table: one row per collection / document event -->
    <div class="section-card txn-card">
        @if (IsLoading)
        {
            <table class="txn-table txn-loading-table" aria-busy="true" aria-label="Loading collection activity">
                <thead>
                    <tr>
                        <th>Date &amp; time</th>
                        <th>Source</th>
                        <th>Payer</th>
                        <th>Details</th>
                        <th class="txn-num">Amount</th>
                        <th>Receipt</th>
                        <th>Status</th>
                        <th>Recorded by</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < 8; i++)
                    {
                        <tr>
                            <td><Skeleton Width="92px" Height="12px" Radius="6px" /></td>
                            <td><Skeleton Width="110px" Height="13px" Radius="6px" /></td>
                            <td><Skeleton Width="130px" Height="13px" Radius="6px" /></td>
                            <td><Skeleton Width="115px" Height="12px" Radius="6px" /></td>
                            <td class="txn-num"><Skeleton Width="78px" Height="13px" Radius="6px" /></td>
                            <td><Skeleton Width="68px" Height="13px" Radius="6px" /></td>
                            <td><Skeleton Width="60px" Height="22px" Radius="999px" /></td>
                            <td><Skeleton Width="92px" Height="13px" Radius="6px" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_loadFailed)
        {
            <div class="txn-empty" role="alert">
                <div class="txn-empty-title">Collection activity could not be loaded</div>
                <div class="txn-empty-text">Check the connection and refresh.</div>
                <button type="button" class="txn-retry" @onclick="Reload">Retry</button>
            </div>
        }
        else if (Visible.Count == 0)
        {
            <div class="txn-empty" role="status">
                <div class="txn-empty-ic">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="txn-empty-title">No collection activity @(IsToday ? "yet today" : "on this day")</div>
                <div class="txn-empty-text">Nothing recorded for @SelectedDate.ToString("MMMM d, yyyy")@(IsFiltered ? $" in {ScopeLabel}" : ""). Use the arrows or calendar to browse other days.</div>
            </div>
        }
        else
        {
            <div class="txn-scroll" role="region" aria-label="Collection activity" tabindex="0">
                <table class="txn-table">
                    <caption class="v3-sr-only">Collection activity for @SelectedDate.ToString("MMMM d, yyyy")</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date &amp; time</th>
                            <th scope="col">Source</th>
                            <th scope="col">Payer</th>
                            <th scope="col">Details</th>
                            <th scope="col" class="txn-num">Amount</th>
                            <th scope="col">Receipt</th>
                            <th scope="col">Status</th>
                            <th scope="col">Recorded by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var sessionByCollection = CompleteVisibleSessions
                                .SelectMany(s => s.Children.Where(e => e.CollectionId.HasValue)
                                    .Select(e => (Id: e.CollectionId!.Value, Session: s)))
                                .ToDictionary(x => x.Id, x => x.Session);
                        }
                        @foreach (var e in Visible)
                        {
                            var session = e.CollectionId is { } id ? sessionByCollection.GetValueOrDefault(id) : null;
                            @if (session is { } combined)
                            {
                                @if (combined.Children[0].CollectionId == e.CollectionId)
                                {
                                    var first = combined.Children[0];
                                    var atGroup = first.RecordedAtUtc is { } utcGroup ? PhilippineTime.ToPhilippineTime(utcGroup) : (DateTime?)null;
                                    <tr @key="combined.SessionId" class="txn-row" tabindex="0" aria-label="Open @combined.Children.Count collections in one checkout"
                                        @onclick="() => OpenSession(combined)">
                                        <td class="txn-when"><div class="txn-date">@first.BusinessDate.ToString("MMM d, yyyy")</div>
                                            @if (atGroup is { } groupTime) { <div class="txn-time">@groupTime.ToString("h:mm tt")</div> }
                                        </td>
                                        <td><div class="txn-source-name">Combined collection</div></td>
                                        <td class="txn-party">@first.PayerName</td>
                                        <td><div class="txn-kind">@combined.Children.Count separate collections</div><div class="txn-ref">View itemized SRCs and receipts</div></td>
                                        <td class="txn-num txn-amount">&#8369;@combined.Children.Sum(c => c.Amount).ToString("N2")
                                            @if (combined.Children.Any(c => c.CorrectionEffect != 0m))
                                            { <div class="txn-net">Net &#8369;@combined.Children.Sum(c => c.NetAmount).ToString("N2")</div> }
                                        </td>
                                        <td class="txn-or">@combined.Children.Count separate SRCs</td>
                                        <td><span class="txn-status">@(combined.Children.Any(c => c.CorrectionEffect != 0m) ? "Contains corrections" : "Posted")</span></td>
                                        <td class="txn-recorder">@first.RecordedBy</td>
                                    </tr>
                                }
                            }
                            else
                            {
                            var expandable = e.Lines.Count > 1 || e.Corrections.Count > 0;
                            var expanded = _expanded.Contains(e.EventKey);
                            var at = e.RecordedAtUtc is { } utc ? PhilippineTime.ToPhilippineTime(utc) : (DateTime?)null;
                            <tr @key="e.EventKey" class="txn-row" tabindex="0" aria-label="@($"Open {e.ReferenceCode ?? e.DocumentNumber ?? SourceLabel(e)}")"
                                @onclick="() => OpenReview(e)" @onkeydown="args => OnRowKey(args, e)">
                                <td class="txn-when">
                                    <div class="txn-date">@e.BusinessDate.ToString("MMM d, yyyy")</div>
                                    @if (at is { } t)
                                    {
                                        <div class="txn-time">@t.ToString("h:mm tt")</div>
                                    }
                                </td>
                                <td>
                                    <div class="txn-source-name">@SourceLabel(e)</div>
                                    @if (e.Facility is { } fac)
                                    {
                                        <span class="txn-fac-badge">@FacilityCatalog.ShortNameOf(fac)</span>
                                    }
                                </td>
                                <td class="txn-party">@(string.IsNullOrWhiteSpace(e.PayerName) ? "—" : e.PayerName)</td>
                                <td>
                                    <div class="txn-kind">
                                        @Detail(e)
                                    </div>
                                    @if (e.Subject is { Length: > 0 } subject)
                                    {
                                        <div class="txn-ref">@subject</div>
                                    }
                                </td>
                                <td class="txn-num txn-amount">
                                    &#8369;@e.Amount.ToString("N2")
                                    @if (e.CorrectionEffect != 0m)
                                    {
                                        <div class="txn-net">Net &#8369;@e.NetAmount.ToString("N2")</div>
                                    }
                                </td>
                                <td class="txn-or">
                                    @if (!string.IsNullOrWhiteSpace(e.DocumentNumber))
                                    {
                                        <span class="txn-physical">
                                            @if (e.InstrumentType is { } instrument)
                                            {
                                                <InstrumentChip Instrument="@(instrument == RevenueInstrumentType.OfficialReceipt ? "OR" : "CT")" />
                                            }
                                            @e.DocumentNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="txn-src-none">None recorded</span>
                                    }
                                    @if (e.ReplacementReferenceCodes.Count > 0)
                                    {
                                        <span class="txn-physical">Replaced by @string.Join(", ", e.ReplacementReferenceCodes)</span>
                                    }
                                </td>
                                <td>
                                    <span class="txn-status @StatusClass(e)">@StatusText(e)</span>
                                    @if (!string.IsNullOrEmpty(e.Verification)) { <div class="txn-verify">@e.Verification</div> }
                                </td>
                                <td class="txn-recorder">@e.RecordedBy</td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_feed?.Truncated == true)
            {
                <p class="txn-truncated" role="status">Showing the latest @_feed.Events.Count.ToString("N0") of @_feed.EventCount.ToString("N0") collections for this day.</p>
            }
        }
    </div>

</div>

@if (_sessionReview is { } combinedReview)
{
    <div class="v3-modal-backdrop" role="presentation" @onclick="CloseSession">
        <section class="v3-modal txr" role="dialog" aria-modal="true" aria-label="Combined collection details" @onclick:stopPropagation="true">
            <header class="txr-head"><div class="txr-head-text"><h2>@(combinedReview.Children[0].PayerName ?? "Collection session")</h2>
                <p>@combinedReview.Children.Count separate collections · @combinedReview.Children[0].BusinessDate.ToString("MMM d, yyyy")</p></div></header>
            <div class="v3-modal-body txr-body">
                <table class="txr-items" aria-label="Itemized checkout collections">
                    <thead><tr><th>Operation and reference</th><th>Instrument / receipt</th><th class="txn-num">Amount</th></tr></thead>
                    <tbody>
                    @foreach (var child in combinedReview.Children)
                    {
                        <tr><td><strong>@SourceLabel(child)</strong><div class="txn-ref">@child.ReferenceCode</div>
                            <div class="txn-ref">@StatusText(child)@if (child.CorrectionEffect != 0m) { <span> · Correction &#8369;@child.CorrectionEffect.ToString("N2")</span> }</div>
                            @if (child.ReplacementReferenceCodes.Count > 0)
                            { <div class="txn-ref">Replacement SRC: @string.Join(", ", child.ReplacementReferenceCodes)</div> }
                            @foreach (var line in child.Lines) { <div class="txn-ref">@LineLabel(line) · &#8369;@line.Amount.ToString("N2")</div> }
                            </td><td>@(child.InstrumentType == RevenueInstrumentType.OfficialReceipt ? "OR" : child.InstrumentType == RevenueInstrumentType.CashTicket ? "CT" : "Unspecified")
                                <div class="txn-ref">@(string.IsNullOrWhiteSpace(child.DocumentNumber) ? "None recorded" : child.DocumentNumber)</div>
                                @if (child.ReplacementDocumentNumbers.Count > 0)
                                { <div class="txn-ref">Replacement: @string.Join(", ", child.ReplacementDocumentNumbers)</div> }
                            </td><td class="txn-num"><div class="txr-amount"><div class="txr-amount-fig">&#8369;@child.Amount.ToString("N2")
                                @if (child.CorrectionEffect != 0m) { <div class="txn-net">Net &#8369;@child.NetAmount.ToString("N2")</div> }</div>
                                <button class="v3-btn v3-btn-sm" type="button" @onclick="() => OpenSessionChild(child)">Details</button></div>
                            </td></tr>
                    }
                    </tbody>
                    <tfoot><tr><th colspan="2">Total collected</th><td class="txn-num">&#8369;@combinedReview.Children.Sum(c => c.Amount).ToString("N2")</td></tr>
                    @if (combinedReview.Children.Any(c => c.CorrectionEffect != 0m))
                    { <tr><th colspan="2">Net after corrections</th><td class="txn-num">&#8369;@combinedReview.Children.Sum(c => c.NetAmount).ToString("N2")</td></tr> }
                    </tfoot>
                </table>
            </div>
            <footer class="txr-foot"><button type="button" class="v3-btn v3-btn-primary" @onclick="CloseSession">Close</button></footer>
        </section>
    </div>
}
@if (_review is { } r)
{
    var isCanonical = !string.IsNullOrWhiteSpace(r.ReferenceCode) && r.CollectionId is not null;
    var recordedAt = r.RecordedAtUtc is { } utc ? PhilippineTime.ToPhilippineTime(utc) : (DateTime?)null;
    var groups = r.Lines.GroupBy(SourceName).ToList();
    <div class="v3-modal-backdrop" role="presentation" @onclick="CloseReview">
        <section class="v3-modal txr" role="dialog" aria-modal="true" aria-labelledby="txr-title" @onclick:stopPropagation="true" @onkeydown="OnReviewKey">
            <header class="txr-head">
                <div class="txr-head-text">
                    <h2 id="txr-title">@(string.IsNullOrWhiteSpace(r.PayerName) ? SourceLabel(r) : r.PayerName)</h2>
                    <p>@r.BusinessDate.ToString("MMM d, yyyy")@(recordedAt is { } at ? " · " + at.ToString("h:mm tt") : "")</p>
                </div>
                <button class="txr-close" type="button" aria-label="Close" @onclick="CloseReview"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></button>
            </header>
            <div class="v3-modal-body txr-body">
                <div class="txr-section-heading">Collection details</div>
                <dl class="txr-meta">
                    <div><dt>Status</dt><dd><span class="txn-status @StatusClass(r)">@StatusText(r)</span>@if (!string.IsNullOrEmpty(r.Verification)) {<span class="txr-sub">@r.Verification</span>}</dd></div>
                    <div><dt>Source</dt><dd>@SourceLabel(r)@(r.Facility is { } f ? $" · {FacilityCatalog.ShortNameOf(f)}" : "")</dd></div>
                    <div><dt>Recorded by</dt><dd>@r.RecordedBy</dd></div>
                    @if (!string.IsNullOrWhiteSpace(r.ReferenceCode))
                    {
                        <div><dt>StallTrack reference</dt><dd>@r.ReferenceCode</dd></div>
                    }
                    <div><dt>Receipt</dt><dd>
                        @if (!string.IsNullOrWhiteSpace(r.DocumentNumber))
                        {
                            @if (r.InstrumentType is { } instrument) { <InstrumentChip Instrument="@(instrument == RevenueInstrumentType.OfficialReceipt ? "OR" : "CT")" /> }
                            @r.DocumentNumber
                        }
                        else { <span class="txn-muted">None recorded</span> }
                    </dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(r.Subject))
                {
                    <p class="txr-subject">@r.Subject</p>
                }

                <div class="txr-section-heading txr-items-heading">Itemized charges</div>
                <table class="txr-items" aria-label="Itemized collection">
                    <thead>
                        <tr><th scope="col">Item</th><th scope="col">Period</th><th scope="col" class="txn-num">Amount</th></tr>
                    </thead>
                    <tbody>
                        @if (groups.Count == 0)
                        {
                            <tr><td>@Detail(r)</td><td></td><td class="txn-num">&#8369;@r.Amount.ToString("N2")</td></tr>
                        }
                        @foreach (var group in groups)
                        {
                            @if (groups.Count > 1)
                            {
                                <tr class="txr-group"><th scope="rowgroup" colspan="2">@group.Key</th><td class="txn-num">@(group.Count() > 1 ? "₱" + group.Sum(l => l.Amount).ToString("N2") : "")</td></tr>
                            }
                            @foreach (var line in group)
                            {
                                <tr>
                                    <td>@LineLabel(line)</td>
                                    <td>@LinePeriod(line)</td>
                                    <td class="txn-num">&#8369;@line.Amount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr><th scope="row" colspan="2">Total collected</th><td class="txn-num">&#8369;@r.Amount.ToString("N2")</td></tr>
                        @if (r.CorrectionEffect != 0m)
                        {
                            <tr><th scope="row" colspan="2">Correction</th><td class="txn-num">&#8369;@r.CorrectionEffect.ToString("N2")</td></tr>
                            <tr class="txr-net"><th scope="row" colspan="2">Net after correction</th><td class="txn-num">&#8369;@r.NetAmount.ToString("N2")</td></tr>
                        }
                    </tfoot>
                </table>

        @if (r.Corrections.Count > 0)
        {
            <h3 class="txn-drawer-h">Correction history</h3>
            <ul class="txn-corrections">
                @foreach (var c in r.Corrections)
                {
                    <li>
                        <strong>@CorrectionLabel(c.CorrectionType)</strong> · @c.EffectiveDate.ToString("MMM d, yyyy") · &#8369;@c.FinancialEffect.ToString("N2")
                        @if (!string.IsNullOrWhiteSpace(c.Reason)) { <div class="txn-muted">@c.Reason</div> }
                    </li>
                }
            </ul>
        }

        @if (!isCanonical)
        {
            <p class="txn-note" role="status">This entry was recorded through a legacy financial workflow. No canonical Collection or SRC was issued; the recorded amount and any receipt evidence are preserved.</p>
        }
        else
        {
            <h3 class="txn-drawer-h">Correction status</h3>
            @if (_reviewLoading) { <p class="txn-muted" role="status">Checking correction status…</p> }
            else if (_reviewError is not null) { <p class="txn-error" role="alert">@_reviewError</p> }
            else if (_reviewInfo is { } info)
            {
                @if (info.HasCorrection || _reversed is not null)
                {
                    @* The server is the authority: a corrected receipt shows only its status and evidence, never a reversal control. *@
                    <p class="txn-status-line"><span class="txn-status corrected txn-status-reversed">Reversed</span> The original @r.ReferenceCode is kept; the linked correction is listed above.</p>
                    @if (_reversed is { } done)
                    {
                        <p class="txn-success" role="status">&#8369;@done.ReopenedAmount.ToString("N2") reopened on the source.</p>
                    }
                }
                else
                {
                    <p class="txn-note" role="status">@(info.Remitted ? "Remitted. " : info.Eligibility.BlockCode == "TurnedOver" ? "Office-origin receipt. " : info.OfficeOrigin ? "Office-origin receipt: its turnover status is not established by the current workflow. " : "Not remitted. ")@info.Eligibility.Explanation</p>
                }
                @if (!(info.HasCorrection || _reversed is not null) && info.Eligibility.CanCorrect && !_arming)
                {
                    <button type="button" class="v3-btn v3-btn-sm" @onclick="() => _arming = true">Reverse this collection…</button>
                }
                else if (!(info.HasCorrection || _reversed is not null) && info.Eligibility.CanCorrect)
                {
                    <div class="txn-reverse-field">
                        <label class="txn-field-label" for="txn-reason">Reason for reversal <span>(required)</span></label>
                        <textarea id="txn-reason" class="txn-reason" rows="4" maxlength="500"
                                  placeholder="State why this collection must be reversed"
                                  aria-required="true" @bind="Reason" @bind:event="oninput"></textarea>
                    </div>
                    <label class="txn-ack"><input type="checkbox" @bind="_ack" /> I confirm this reverses @r.ReferenceCode and reopens the month's balance.</label>
                    @if (_reverseError is not null) { <p class="txn-error" role="alert">@_reverseError</p> }
                    <button type="button" class="v3-btn v3-btn-primary" disabled="@(!_ack || string.IsNullOrWhiteSpace(_reason) || _working)" @onclick="ReverseAsync">@(_working ? "Reversing…" : "Reverse collection")</button>
                    <button type="button" class="v3-btn v3-btn-sm" disabled="@_working" @onclick="CancelArming">Cancel</button>
                }
            }
        }
            </div>
            <footer class="txr-foot">
                <button type="button" class="v3-btn txr-download" @onclick="DownloadReviewCsvAsync">Download CSV</button>
                @if (isCanonical)
                {
                    <a class="v3-btn" href="@ReconciliationHref(r)">View Reconciliation</a>
                }
                @if (!isCanonical && r.Verification is not null && r.CollectionId is not null)
                {
                    <button type="button" class="v3-btn" @onclick="OpenCollectionReviewAsync">Review details</button>
                }
                <button type="button" class="v3-btn v3-btn-primary" @onclick="CloseReview">Close</button>
            </footer>
        </section>
    </div>
}

@code {
    private const int Limit = 1000;

    private sealed record ShownSession(Guid SessionId, IReadOnlyList<CollectionActivityEventDto> Children);
    private ShownSession? _sessionReview;
    private IReadOnlyList<ShownSession> CompleteVisibleSessions
    {
        get
        {
            var visible = Visible;
            var children = visible.Where(e => e.CollectionId.HasValue)
                .ToDictionary(e => e.CollectionId!.Value);
            var positions = visible.Select((e, index) => (e.CollectionId, index))
                .Where(x => x.CollectionId.HasValue)
                .ToDictionary(x => x.CollectionId!.Value, x => x.index);
            return (_feed?.Sessions ?? []).Select(s => new ShownSession(s.SessionId,
                    s.CollectionIds.Where(id => children.ContainsKey(id))
                        .OrderBy(id => positions[id]).Select(id => children[id]).ToArray()))
                .Where(s => s.Children.Count > 1 &&
                    (_feed?.Sessions?.FirstOrDefault(x => x.SessionId == s.SessionId)?.CollectionIds.Count ?? 0) == s.Children.Count)
                .ToArray();
        }
    }
    private void OpenSession(ShownSession session) => _sessionReview = session;
    private void CloseSession() => _sessionReview = null;
    private async Task OpenSessionChild(CollectionActivityEventDto child)
    {
        _sessionReview = null;
        await OpenReview(child);
    }

    // ── Collection review ──
    private CollectionActivityEventDto? _review;
    private CollectionReviewDto? _reviewInfo;
    private HeadCorrectionResultDto? _reversed;
    private bool _reviewLoading, _working, _ack, _arming;
    private string? _reviewError, _reverseError;
    private string _reason = string.Empty;
    private Guid _operationId = Guid.NewGuid();

    // A different reason is a different intent, so it gets its own operation; the same reason retried after a lost reply replays.
    private string Reason { get => _reason; set { if (_reason != value) { _reason = value; _operationId = Guid.NewGuid(); } } }

    private static string ReconciliationHref(CollectionActivityEventDto e) =>
        $"/reports/collection-reconciliation?from={e.BusinessDate:yyyy-MM-dd}&to={e.BusinessDate:yyyy-MM-dd}";

    private async Task OpenReview(CollectionActivityEventDto e)
    {
        _review = e; _reviewInfo = null; _reversed = null; _reviewError = null; _reverseError = null;
        _reason = string.Empty; _ack = false; _arming = false; _operationId = Guid.NewGuid();
        if (e.CollectionId is not { } id || string.IsNullOrWhiteSpace(e.ReferenceCode)) return;
        _reviewLoading = true;
        var result = await ActivityApi.GetReviewAsync(id);
        _reviewLoading = false;
        if (_review?.CollectionId != id) return;
        if (result.IsSuccess && result.Value is not null) _reviewInfo = result.Value;
        else _reviewError = "Correction status could not be loaded. Close and try again.";
    }

    private async Task DownloadReviewCsvAsync()
    {
        if (_review is not { } entry) return;

        var csv = new System.Text.StringBuilder();
        // Quote every cell, and neutralize spreadsheet formulas in user-entered text.
        static string EscapeCsv(string? value)
        {
            var safe = value ?? string.Empty;
            if (safe.Length > 0 && "=+@-\t\r\n".Contains(safe[0]))
                safe = "'" + safe;
            return "\"" + safe.Replace("\"", "\"\"") + "\"";
        }
        void Add(params string?[] fields) =>
            csv.AppendLine(string.Join(",", fields.Select(EscapeCsv)));
        static string Amount(decimal amount) =>
            amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

        Add("StallTrack — Collection Activity Details");
        Add("Information copy only — not an OR, CT, SRC or official receipt");
        Add("Record type", string.IsNullOrWhiteSpace(entry.ReferenceCode) || entry.CollectionId is null
            ? "Legacy payment record" : "Canonical collection");
        Add("Payor", entry.PayerName);
        Add("Business date", entry.BusinessDate.ToString("yyyy-MM-dd"));
        if (entry.RecordedAtUtc is { } recorded)
            Add("Recorded at (Philippine time)", PhilippineTime.ToPhilippineTime(recorded).ToString("yyyy-MM-dd HH:mm"));
        Add("Source", SourceLabel(entry));
        if (entry.Facility is { } facility)
            Add("Facility", FacilityCatalog.ShortNameOf(facility));
        Add("Status", StatusText(entry));
        if (!string.IsNullOrWhiteSpace(entry.Verification)) Add("Verification", entry.Verification);
        Add("Recorded by", entry.RecordedBy);
        if (!string.IsNullOrWhiteSpace(entry.ReferenceCode))
            Add("StallTrack reference", entry.ReferenceCode);
        if (!string.IsNullOrWhiteSpace(entry.DocumentNumber))
        {
            Add("Physical receipt type", entry.InstrumentType switch
            {
                RevenueInstrumentType.OfficialReceipt => "OR",
                RevenueInstrumentType.CashTicket => "CT",
                _ => "Not identified"
            });
            Add("Physical receipt number (as recorded)", entry.DocumentNumber);
        }
        else Add("Physical receipt", "None recorded");
        if (!string.IsNullOrWhiteSpace(entry.Subject)) Add("Account/period", entry.Subject);

        Add();
        Add("Itemized charges");
        Add("Item", "Period", "Amount (PHP)");
        if (entry.Lines.Count == 0)
            Add(Detail(entry), "", Amount(entry.Amount));
        else foreach (var line in entry.Lines)
            Add(LineLabel(line), LinePeriod(line), Amount(line.Amount));
        Add("Total collected (PHP)", "", Amount(entry.Amount));
        if (entry.CorrectionEffect != 0m)
        {
            Add("Correction (PHP)", "", Amount(entry.CorrectionEffect));
            Add("Net after correction (PHP)", "", Amount(entry.NetAmount));
        }

        if (entry.Corrections.Count > 0)
        {
            Add();
            Add("Correction history");
            foreach (var correction in entry.Corrections)
            {
                Add(CorrectionLabel(correction.CorrectionType),
                    correction.EffectiveDate.ToString("yyyy-MM-dd"),
                    Amount(correction.FinancialEffect), correction.Reason);
            }
        }
        if (string.IsNullOrWhiteSpace(entry.ReferenceCode) || entry.CollectionId is null)
            Add("Record notice", "Legacy financial record; no canonical Collection or SRC was issued.");
        else if (_reviewInfo is { } status)
            Add("Correction status", status.Eligibility.Explanation);

        // Use the existing browser download helper: no server mutation or new dependency.
        var identifier = new string((entry.ReferenceCode ?? "legacy")
            .Where(ch => char.IsLetterOrDigit(ch) || ch == '-').ToArray());
        var filename = $"collection-details-{entry.BusinessDate:yyyy-MM-dd}-{identifier}.csv";
        var bytes = new System.Text.UTF8Encoding(true).GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await JS.InvokeVoidAsync("downloadFileFromBytes", filename,
            Convert.ToBase64String(bytes), "text/csv;charset=utf-8");
    }

    private void CloseReview() { _review = null; _reviewInfo = null; _arming = false; }

    private void OnReviewKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseReview(); }
    private void OnRowKey(KeyboardEventArgs args, CollectionActivityEventDto e) { if (args.Key is "Enter" or " ") _ = OpenReview(e); }

    // The Head's verification review for this collection (direct collections only), opened on the same record.
    private DirectCollectionReview? _directReview;
    private async Task OpenCollectionReviewAsync()
    {
        if (_review?.CollectionId is not { } id || _directReview is null) return;
        CloseReview();
        await _directReview.OpenDetailAsync(id);
    }

    private static string LineLabel(CollectionActivityLineDto line)
    {
        var part = line.SourcePart switch { "Water" => "Water", "Electricity" => "Electricity", _ => null };
        return !string.IsNullOrWhiteSpace(line.Description) ? line.Description! : part ?? line.ClassificationName;
    }

    private static string LinePeriod(CollectionActivityLineDto line) =>
        line.PeriodYear is { } y && line.PeriodMonth is { } m ? new DateOnly(y, m, 1).ToString("MMM yyyy") : "";
    private void CancelArming() { _arming = false; _ack = false; _reason = string.Empty; _reverseError = null; _operationId = Guid.NewGuid(); }

    private static string ReverseMessage(string? code) => code switch
    {
        "AlreadyCorrected" => "A correction is already recorded for this collection.",
        "Remitted" => "This cash is already part of a remittance.",
        "OutsideCurrentBusinessDate" => "Only today's receipts can be reversed here.",
        "ConcurrentCorrection" => "Another correction was in progress. Reload and check the status.",
        "CorrectionIntentConflict" => "That operation was already used with a different reason. Reload and try again.",
        "InvalidReason" => "Enter a reason of up to 500 characters.",
        _ => "The correction was not recorded. Reload and check the status before trying again."
    };

    private async Task ReverseAsync()
    {
        if (_review?.CollectionId is not { } id || _working) return;
        _working = true; _reverseError = null;
        try
        {
            var result = await ActivityApi.ReverseAsync(new(_operationId, id, _reason.Trim()));
            if (result.IsSuccess && result.Value is not null)
            {
                _reversed = result.Value;
                _arming = false;
                await ReloadAsync(paintLoading: false);
                // Re-read the authoritative state so the drawer shows the correction, not the pre-reversal eligibility.
                _review = _feed?.Events.FirstOrDefault(x => x.CollectionId == id) ?? _review;
                var fresh = await ActivityApi.GetReviewAsync(id);
                if (fresh.IsSuccess && fresh.Value is not null) _reviewInfo = fresh.Value;
            }
            else _reverseError = ReverseMessage(result.Error);
        }
        catch (HttpRequestException) { _reverseError = "The reply was lost. Retry to confirm: the same request is never recorded twice."; }
        finally { _working = false; }
    }

    private DateOnly SelectedDate = PhilippineTime.Today;
    private bool IsLoading = true;
    private bool _loadFailed;
    private CollectionActivityFeedDto? _feed;
    private string _scope = "all";
    private string _source = AllSources;
    private const string AllSources = "all";

    /// <summary>Optional exact SRC from a workspace link; opens that collection's business date.</summary>
    [SupplyParameterFromQuery(Name = "src")] public string? Src { get; set; }

    [PersistentState(AllowUpdates = true)]
    public TransactionsPageState? CachedTransactions { get; set; }

    private bool IsToday => SelectedDate == PhilippineTime.Today;
    private readonly HashSet<string> _expanded = new();
    private ElementReference _dateInput;

    // Source scopes: a presentation grouping over the event's primary classification, never a business placement.
    private static readonly IReadOnlyList<(string Key, string Label)> Scopes =
    [
        ("all", "All"), ("facilities", "Facilities"), ("operations", "Operations"), ("utilities", "Utilities"), ("space", "Space rental")
    ];

    private static readonly HashSet<string> UtilityCodes = new(StringComparer.Ordinal) { "ECF", "WCF" };
    private static readonly HashSet<string> SpaceCodes = new(StringComparer.Ordinal)
        { "VEGETABLE_FRUIT_SPACE_RENTAL", "KANMANGGAY_SPACE_RENTAL", "FIESTA_ARAW_LOT_RENTAL" };

    private static string PrimaryCode(CollectionActivityEventDto e) => e.Lines.Count == 0 ? string.Empty : e.Lines[0].ClassificationCode;

    private static string ScopeOf(CollectionActivityEventDto e)
    {
        var code = PrimaryCode(e);
        if (UtilityCodes.Contains(code)) return "utilities";
        if (SpaceCodes.Contains(code)) return "space";
        return e.Facility is not null ? "facilities" : "operations";
    }

    private IReadOnlyList<CollectionActivityEventDto> InScope =>
        (_feed?.Events ?? []).Where(e => _scope == "all" || ScopeOf(e) == _scope).ToList();

    private List<CollectionActivityEventDto> Visible =>
        InScope.Where(e => _source == AllSources || SourceLabel(e) == _source).Where(MatchesSearch).ToList();

    private string _search = string.Empty;

    // A complete SRC that is not on the loaded day is looked up on the server (exact, case-insensitive) and the page jumps to
    // that Collection's business date. Partial text only filters the loaded day.
    private static readonly System.Text.RegularExpressions.Regex SrcPattern = new("^SRC-[0-9]{4}-[0-9]{6,}$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private void ClearSearch() => _search = string.Empty;

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        var code = _search.Trim();
        if (!SrcPattern.IsMatch(code) || Visible.Any(x => string.Equals(x.ReferenceCode, code, StringComparison.OrdinalIgnoreCase)))
            return;
        try
        {
            var result = await ActivityApi.GetAsync(SelectedDate, SelectedDate, limit: Limit, reference: code);
            if (result.IsSuccess && result.Value is { Events.Count: > 0 } found)
            {
                SelectedDate = found.To;
                _scope = "all";
                _source = AllSources;
                await ReloadAsync(paintLoading: true);
            }
        }
        catch { /* a failed lookup leaves the loaded day as it was */ }
    }

    // Case-insensitive over the collection reference (SRC), any physical document recorded with it, and the payer.
    private bool MatchesSearch(CollectionActivityEventDto e)
    {
        var q = _search.Trim();
        return q.Length == 0
            || (e.ReferenceCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (e.DocumentNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (e.PayerName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private IReadOnlyList<(string Value, string Label)> SourceOptions =>
        new[] { (AllSources, "All sources") }
            .Concat(InScope.Select(SourceLabel).Distinct().Order(StringComparer.CurrentCulture).Select(n => (n, n)))
            .ToList();

    private bool IsFiltered => _scope != "all" || _source != AllSources || !string.IsNullOrWhiteSpace(_search);

    private string ScopeLabel => _source != AllSources ? _source
        : _scope == "all" ? "All sources" : Scopes.First(s => s.Key == _scope).Label;

    /// <summary>The name this office uses for a source (its own operation name where it has set one); the established name otherwise.</summary>
    private string SourceName(CollectionActivityLineDto line)
    {
        var code = line.ClassificationCode;
        string? name = line.ClassificationName;
        // Slaughterhouse line names are frozen charges, not the parent operation's name.
        if (code == "SLAUGHTERHOUSE" && line.SourceKind == "GovernedService") name = line.ParentSourceName;
        return Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetService<OperationNameService>(Services)?.NameForSource(code, name)
            ?? SourceNames.For(code, name);
    }

    private string SourceLabel(CollectionActivityEventDto e)
    {
        var code = PrimaryCode(e);
        // Rent is read by facility: "Permanent Stall Rent" alone would merge every facility's stalls into one source.
        if (code == "PERMANENT_STALL_RENT" && e.Facility is { } fac)
            return $"{FacilityCatalog.ShortNameOf(fac)} rent";
        return e.Lines.Count == 0 ? "Collection" : SourceName(e.Lines[0]);
    }

    private static string Detail(CollectionActivityEventDto e) =>
        e.Lines.Count > 1 ? $"{e.Lines.Count} items" : e.Lines.FirstOrDefault()?.Description ?? "Collection";

    private static string LineDetail(CollectionActivityLineDto line)
    {
        var period = line.PeriodYear is { } y && line.PeriodMonth is { } m ? new DateOnly(y, m, 1).ToString("MMM yyyy") : null;
        return string.Join(" · ", new[] { line.Description, period }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string StatusText(CollectionActivityEventDto e) => e.Authority == "Legacy"
        ? e.LegacyStatus switch { "Partial" => "Partial", _ => "Paid" }
        : e.Disposition;

    private static string StatusClass(CollectionActivityEventDto e) => StatusText(e) switch
    {
        "Paid" or "Posted" => "paid",
        "Partial" or "Document corrected" => "partial",
        _ => "corrected"
    };

    private static string CorrectionLabel(string type) => type switch
    {
        "Void" => "Voided",
        "Reversal" => "Reversed",
        "Replacement" => "Replaced by a new collection",
        "DocumentCorrection" => "Document corrected",
        _ => "Correction"
    };

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    private void SetScope(string scope)
    {
        _scope = scope;
        _source = AllSources;
    }

    private async Task OpenPicker() => await JS.InvokeVoidAsync("openDatePicker", _dateInput);

    protected override async Task OnInitializedAsync()
    {
        await FacilityCatalog.EnsureLoadedAsync();
        if (CachedTransactions is { } state && state.SelectedDate == SelectedDate && string.IsNullOrWhiteSpace(Src))
        {
            _feed = state.Feed;
            IsLoading = false;
            return;
        }

        await ReloadAsync(paintLoading: true);
        // A deep link from a workspace (?src=SRC) opens that collection exactly as typing its reference into the search would.
        if (!string.IsNullOrWhiteSpace(Src)) await OnSearchInputAsync(new ChangeEventArgs { Value = Src });
    }

    private async Task ShowLatest()
    {
        SelectedDate = PhilippineTime.Today;
        await Reload();
    }

    private Task GoToday() => ShowLatest();

    private async Task PrevDay()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        await Reload();
    }

    private async Task NextDay()
    {
        if (IsToday) return;                       // never navigate into the future
        SelectedDate = SelectedDate.AddDays(1);
        await Reload();
    }

    private async Task OnDatePicked(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            SelectedDate = d > PhilippineTime.Today ? PhilippineTime.Today : d;
            await Reload();
        }
    }

    private Task Reload() => ReloadAsync();

    private async Task ReloadAsync(bool paintLoading = false)
    {
        IsLoading = true;
        _loadFailed = false;
        _expanded.Clear();
        _sessionReview = null;
        if (paintLoading)
            await PaintLoadingAsync();

        // Cold-start resilience: during prerender the JWT may not be attached yet, so the API can return
        // 401/403 before the circuit is ready. Retry briefly, and NEVER persist a failed load — otherwise the
        // cached empty feed is served on the interactive pass and every refresh, and the reload is skipped.
        for (var attempt = 0; attempt < 5; attempt++)
        {
            var result = await ActivityApi.GetAsync(SelectedDate, SelectedDate, limit: Limit);
            if (result.IsSuccess && result.Value is { } feed)
            {
                _feed = feed;
                CachedTransactions = new TransactionsPageState(SelectedDate, feed);
                IsLoading = false;
                return;
            }
            if (result.Status is not (ResultStatus.Unauthorized or ResultStatus.Forbidden))
                break;
            await Task.Delay(400);
        }

        // Failed load: say so, but do NOT cache it, so the next lifecycle/refresh retries.
        _feed = null;
        _loadFailed = true;
        IsLoading = false;
    }

    private async Task PaintLoadingAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    public sealed record TransactionsPageState(DateOnly SelectedDate, CollectionActivityFeedDto Feed);
}
