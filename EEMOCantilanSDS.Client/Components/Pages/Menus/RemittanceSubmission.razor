@page "/remittances/group/{SubmissionId:guid}"
@page "/accountable-forms/remittances/group/{SubmissionId:guid}"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Components.Shared
@using EEMOCantilanSDS.Domain.Entities.Revenue
@using EEMOCantilanSDS.Domain.Enums
@inject IRemittancesApiClient Api
@inject IJSRuntime JS
@inject EEMOCantilanSDS.Client.Services.BrandingState Branding

<PageTitle>StallTrack — Remittance</PageTitle>

@* One multi-collector remittance action (IA-052). Each collector's remittance is its own record with its own collections,
   amount and status; this report only lays them side by side. It is evidence of turnover, not a receipt or income, and it
   creates and changes nothing. The layout owns the <main> landmark. *@
<div class="v3-page rm-page">
    <header class="rs-header no-print">
        <div class="rs-header-text">
            <a class="rs-crumb" href="/remittances">Remittance &amp; Liquidation</a>
            <h1>Remittance @if (_data?.StatusLabel is "Voided" or "Partly voided") { <span class="rs-status">@_data.StatusLabel</span> }</h1>
            <p>@Subtitle</p>
        </div>
        <div class="rs-header-actions">
            <a class="v3-btn" href="/remittances">Back</a>
            <button class="v3-btn v3-btn-primary" type="button" @onclick="PrintAsync">Print summary</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="v3-notice v3-notice-error" role="alert">@_error</p>
    }
    @if (_data is null && _error is null)
    {
        <p role="status">Loading remittance…</p>
    }
    @if (_data is { } d)
    {
        <div class="rm-print-head" aria-hidden="true"><ReportLetterhead Title="Remittance / Liquidation Summary" Period="@PeriodLabel(d)" /></div>

        <SummaryStrip Label="Remittance" Items="Summary(d)" />

        <section class="v3-panel" aria-labelledby="rs-collectors-title">
            <header class="v3-panel-header">
                <h2 id="rs-collectors-title">Collectors</h2>
                <span class="v3-panel-meta">@d.StatusLabel · @InstrumentLabel(d.Instrument) · @d.RemittanceDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
            </header>
            <div class="v3-table-wrap" role="region" aria-label="Collector summary" tabindex="0">
                <table class="v3-table">
                    <thead>
                        <tr>
                            <th scope="col">Collector</th>
                            <th scope="col" class="v3-num">Collections</th>
                            <th scope="col" class="v3-num">Collected</th>
                            <th scope="col" class="v3-num">Remitted</th>
                            <th scope="col" class="v3-num">Difference</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in d.Remittances)
                        {
                            <tr>
                                <td class="v3-strong"><a href="@($"/remittances/{item.Row.Id}")">@item.Row.CollectorName</a></td>
                                <td class="v3-num">@item.Row.CollectionCount</td>
                                <td class="v3-num">@Money(item.Row.ExpectedAmount)</td>
                                <td class="v3-num">@Money(item.Row.RemittedAmount)</td>
                                <td class="v3-num @(item.Row.DifferenceAmount != 0m ? "rm-diff-flag" : null)">@Money(item.Row.DifferenceAmount)</td>
                                <td>@StatusLabel(item)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong>Combined total</strong></td>
                            <td class="v3-num">@d.CollectionCount</td>
                            <td class="v3-num">@Money(d.ExpectedAmount)</td>
                            <td class="v3-num v3-strong">@Money(d.RemittedAmount)</td>
                            <td class="v3-num">@Money(d.DifferenceAmount)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @foreach (var item in d.Remittances)
        {
            <section class="v3-panel rs-collector" aria-label="@($"Collections covered for {item.Row.CollectorName}")" @key="item.Row.Id">
                <header class="v3-panel-header">
                    <h2>@item.Row.CollectorName</h2>
                    <span class="v3-panel-meta">@item.Row.CollectionCount collections · @Money(item.Row.ExpectedAmount)</span>
                </header>
                <p class="rs-meta">
                    <span>Recorded by <strong>@item.RecordedBy</strong> · @item.Row.RecordedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture)</span>
                    <span>@InstrumentLabel(item.Row.Instrument)</span>
                    @if (!string.IsNullOrWhiteSpace(item.VoidReason)) { <span class="rm-diff-flag">Voided · @item.VoidReason</span> }
                </p>
                <div class="rs-collector-body">
                    <div class="v3-table-wrap rs-covered" role="region" aria-label="@($"Collections of {item.Row.CollectorName}")" tabindex="0">
                        <table class="v3-table">
                            <thead>
                                <tr><th scope="col">Date</th><th scope="col">Source</th><th scope="col">Payer</th><th scope="col" class="v3-num">Amount</th><th scope="col">Reference</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var collection in item.Collections)
                                {
                                    <tr>
                                        <td class="rs-date">@collection.BusinessDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                                        <td>@SourceLabel(collection)</td>
                                        <td>@(string.IsNullOrWhiteSpace(collection.PayerName) ? "—" : collection.PayerName)</td>
                                        <td class="v3-num">@Money(collection.NetAmount)</td>
                                        <td class="rm-trace">@collection.ReferenceCode</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="rs-breakdown">
                        <h3>By source</h3>
                        <table class="rs-breakdown-table">
                            <tbody>
                                @foreach (var line in item.Breakdown)
                                {
                                    <tr><td>@EEMOCantilanSDS.Client.Services.SourceNames.For(line.Name)</td><td class="v3-num">@Money(line.Amount)</td></tr>
                                }
                            </tbody>
                            <tfoot><tr><th scope="row">Total collected</th><td class="v3-num">@Money(item.Row.ExpectedAmount)</td></tr></tfoot>
                        </table>
                    </div>
                </div>
            </section>
        }

        @* On paper the summary closes with the office's signatories, as every official sheet does. *@
        <div class="rm-print-sign" aria-hidden="true">
            <OfficialSignatories Configured="@Signatories" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid SubmissionId { get; set; }

    /// <summary>?print=1 opens the browser print dialog once the report has loaded.</summary>
    [SupplyParameterFromQuery(Name = "print")] public string? Print { get; set; }

    private RemittanceSubmissionDto? _data;
    private string? _error;
    private bool _printed;

    private string? Subtitle => _data is null ? null
        : $"{_data.Remittances.Count} collectors · {_data.RemittanceDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    // The office's configured report signatories (cached branding); the sheet prints Prepared by and Certified Correct.
    private IReadOnlyList<EEMOCantilanSDS.Application.Command.Municipalities.SetReportSignatories.ReportSignatoryDto> Signatories =>
        Branding.Signatories
            .Where(s => OfficialSignatories.OfficialRoles.Contains(s.Caption, StringComparer.OrdinalIgnoreCase))
            .Select(s => new EEMOCantilanSDS.Application.Command.Municipalities.SetReportSignatories.ReportSignatoryDto(s.Caption, s.Name, s.Title)).ToList();

    protected override async Task OnInitializedAsync() => await Branding.EnsureLoadedAsync();

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        try
        {
            var result = await Api.GetSubmissionAsync(SubmissionId);
            if (result.IsSuccess) _data = result.Value;
            else _error = result.Status == EEMOCantilanSDS.Application.Common.ResultStatus.NotFound
                ? "This remittance was not found." : "The remittance could not be loaded.";
        }
        catch { _error = "The remittance could not be loaded."; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null && Print == "1" && !_printed)
        {
            _printed = true;
            try { await JS.InvokeVoidAsync("print"); } catch (JSException) { }
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    private static IReadOnlyList<SummaryStrip.SummaryItem> Summary(RemittanceSubmissionDto d) =>
    [
        new("Collected", Money(d.ExpectedAmount)),
        new("Remitted", Money(d.RemittedAmount)),
        new("Difference", Money(d.DifferenceAmount), Emphasis: d.DifferenceAmount != 0m),
        new("Collections", d.CollectionCount.ToString(CultureInfo.InvariantCulture)),
    ];

    private static string StatusLabel(RemittanceDetailDto item) => item.Row.Status == RemittanceStatus.Voided ? "Voided"
        : item.NeedsReview ? "Needs review" : "Recorded";

    private static string PeriodLabel(RemittanceSubmissionDto d) =>
        $"{d.PeriodFrom.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)} – {d.PeriodTo.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    private static string InstrumentLabel(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "Official Receipt",
        RevenueInstrumentType.CashTicket => "Cash Ticket",
        _ => "OR and CT"
    };

    private static string SourceLabel(RemittanceCollectionDto collection) => collection.Lines.Count == 0 ? "—"
        : string.Join(" · ", collection.Lines.Select(l => EEMOCantilanSDS.Client.Services.SourceNames.For(l.Name)));

    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";
}
