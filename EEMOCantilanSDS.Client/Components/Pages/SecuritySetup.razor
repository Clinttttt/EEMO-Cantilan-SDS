@page "/security-setup"
@using EEMOCantilanSDS.Application.Dtos.Auth
@inject IMfaApiClient MfaApi
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "SuperAdmin")]

<PageTitle>@Branding.OfficeAcronym Admin — Security Setup</PageTitle>

@*
    Optional two-factor enrolment for Heads, presented as a modal over the portal.

    Enforced AFTER sign-in, never before: the Head is already authenticated when they arrive, so a mandatory
    requirement can never lock anyone out. Once two-factor is active the dialog steps aside.

    The page deliberately renders a placeholder of the portal behind the dialog. The backdrop blurs whatever
    sits beneath it, so the real sidebar and top bar read as the portal being held back rather than a blank
    slab. The placeholder carries NO figures — only neutral bars — because inventing dashboard numbers, even
    decoratively, would misrepresent the office's data.
*@

<div class="secsetup-stage" aria-hidden="true">
    <div class="secsetup-stage-head">
        <div>
            <div class="secsetup-bone secsetup-bone-title"></div>
            <div class="secsetup-bone secsetup-bone-sub"></div>
        </div>
        <div class="secsetup-bone secsetup-bone-btn"></div>
    </div>

    <div class="secsetup-stage-tiles">
        @for (var tile = 0; tile < 4; tile++)
        {
            <div class="secsetup-stage-card">
                <div class="secsetup-bone secsetup-bone-num"></div>
                <div class="secsetup-bone secsetup-bone-label"></div>
            </div>
        }
    </div>

    <div class="secsetup-stage-main">
        <div class="secsetup-stage-card secsetup-stage-table">
            <div class="secsetup-bone secsetup-bone-label"></div>
            @for (var row = 0; row < 6; row++)
            {
                <div class="secsetup-stage-row">
                    <div class="secsetup-bone secsetup-bone-cell"></div>
                    <div class="secsetup-bone secsetup-bone-cell secsetup-bone-cell-sm"></div>
                    <div class="secsetup-bone secsetup-bone-cell secsetup-bone-cell-sm"></div>
                </div>
            }
        </div>
        <div class="secsetup-stage-card secsetup-stage-side">
            <div class="secsetup-bone secsetup-bone-label"></div>
            @for (var line = 0; line < 4; line++)
            {
                <div class="secsetup-bone secsetup-bone-line"></div>
            }
        </div>
    </div>
</div>

<div class="secsetup-backdrop">
    <div class="secsetup-modal" role="dialog" aria-modal="true" aria-labelledby="secsetup-title">

        <div class="secsetup-head">
            <div class="secsetup-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                    <rect x="9.5" y="10.5" width="5" height="4.5" rx="1" />
                    <path d="M10.75 10.5V9.25a1.25 1.25 0 0 1 2.5 0v1.25" />
                </svg>
            </div>
            <div class="secsetup-head-text">
                <div class="secsetup-eyebrow">Recommended for @Branding.OfficeAcronym Heads</div>
                <h1 class="secsetup-title" id="secsetup-title">Secure your Head account</h1>
                <p class="secsetup-sub">
                    Two-factor authentication adds a second step at sign-in. It is optional — you can leave it
                    off and continue with your password alone.
                </p>
            </div>
        </div>

        <div class="secsetup-body">
            @if (_enabled)
            {
                <div class="secsetup-confirm">
                    <div class="secsetup-confirm-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 13 4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <div class="secsetup-confirm-title">Two-factor authentication is active</div>
                        <p class="secsetup-note">
                            Your account is protected. Keep your recovery codes somewhere safe.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @* Two rows: why it is required, then what it involves. Splitting the wall of prose into
                   labelled rows lets a Head who is mid-task grasp the requirement at a glance. Shared with
                   the Settings dialog so both read identically. *@
                <TwoFactorIntro Reason="@($"Your account can create and reset staff accounts and read every financial record for {Branding.Municipality}, so a second sign-in step is strongly recommended.")" />

                @* ShowIntro="false": the rows above already say what the panel's opening sentence says, and
                   repeating it inside the same dialog reads as padding. *@
                <div class="secsetup-panel">
                    <TwoFactorPanel Flat="true" ShowIntro="false" OnStatusChanged="OnStatusChanged" />
                </div>
            }
        </div>

        <div class="secsetup-foot">
            @if (_enabled)
            {
                <button class="secsetup-btn secsetup-btn-primary" type="button" @onclick="Continue">
                    Continue to dashboard
                </button>
            }
            else
            {
                @* No longer a gate: a Head may leave two-factor off and go straight to work. *@
                <button class="secsetup-btn" type="button" @onclick="Continue">
                    Not now — continue to dashboard
                </button>
                <span class="secsetup-foot-note">You can turn this on later in Settings.</span>
            }
        </div>

    </div>
</div>

@code {
    private bool _enabled;

    private void OnStatusChanged(MfaStatusDto status)
    {
        // The panel reports every state change, so the gate lifts the moment enrolment completes.
        _enabled = status.Enabled;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await Branding.EnsureLoadedAsync();
        try
        {
            var status = await MfaApi.GetMfaStatusAsync();
            if (status.IsSuccess && status.Value is not null)
                _enabled = status.Value.Enabled;
        }
        catch { /* leave the requirement in place if the check fails — it is only a convenience */ }
    }

    private void Continue() => Navigation.NavigateTo("/menu", forceLoad: true);
}
