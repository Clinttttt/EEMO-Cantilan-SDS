@page "/forgot-password"
@attribute [AllowAnonymous]

@using EEMOCantilanSDS.Application.Command.Auth.AdminAuth.RequestPasswordReset
@using EEMOCantilanSDS.Application.Dtos.Tenancy
@using Microsoft.AspNetCore.WebUtilities
@inject IAuthApiClient AuthApi
@inject IMunicipalitiesApiClient MunicipalitiesApi
@inject NavigationManager Navigation

<PageTitle>StallTrack — Forgot Password</PageTitle>

@*
    Self-service password reset — step 1 of 2 (request the emailed link).

    Enumeration-safe by design: the confirmation panel below is shown for EVERY submission, whether or not
    an account matched, so this page can never be used to discover which usernames or emails exist. The
    server behaves identically.

    Per-LGU: ?lgu={code} (carried over from the scoped login page) themes this page to that municipality and
    scopes the account lookup to it. With no code the Cantilan defaults apply — unchanged default behaviour.
*@

<div class="setup-root">

    <!-- Left panel — the shared sign-in branding panel, themed per LGU (defaults to Cantilan) -->
    <AuthBrandPanel SealPath="@SealPath"
                    MunicipalityName="@MunicipalityName"
                    OfficeAcronym="@OfficeAcronym"
                    OfficeName="@OfficeName"
                    IsDefaultBrand="@_isDefaultBrand" />

    <!-- Right panel — form / confirmation -->
    <div class="setup-right">
        <div class="setup-form-wrap">
            <section class="login-card">

                @if (Submitted)
                {
                    <div class="setup-form-header">
                        <div class="login-header-icon activated-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" />
                            </svg>
                        </div>
                        <div class="setup-form-title">Check your email</div>
                        <div class="setup-form-desc">
                            If that email address is registered on an account, a password reset link is on
                            its way. The link can be used once and expires in 30 minutes.
                        </div>
                    </div>
                    <div class="setup-form">
                        <div class="setup-secure-note">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
                            </svg>
                            <span>
                                No email after a few minutes? Check your spam folder, or ask your
                                @OfficeAcronym Head to reset your password directly.
                            </span>
                        </div>
                        <button class="setup-submit" @onclick="GoToLogin">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
                            </svg>
                            <span>Back to sign in</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="setup-form-header">
                        <div class="login-header-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                            </svg>
                        </div>
                        <div class="setup-form-title">Forgot your password?</div>
                        <div class="setup-form-desc">
                            Enter the email address registered on your account. We'll email you a secure,
                            single-use link to set a new password.
                        </div>
                    </div>

                    <div class="setup-form">
                        <div class="form-group">
                            <label class="form-label" for="fp-identifier">Email Address</label>
                            <div class="form-input-wrap @(FieldError.Length > 0 ? "form-input-error" : "")">
                                <svg class="form-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" />
                                </svg>
                                <input id="fp-identifier"
                                       type="email"
                                       class="form-input"
                                       value="@Identifier"
                                       @oninput="@((e) => Identifier = e.Value?.ToString() ?? string.Empty)"
                                       @onkeydown="OnKeyDown"
                                       placeholder="name@example.com"
                                       autocomplete="email"
                                       disabled="@(!FormReady)" />
                            </div>
                            @if (FieldError.Length > 0)
                            {
                                <span class="form-error">@FieldError</span>
                            }
                        </div>

                        <button class="setup-submit @(IsLoading ? "setup-submit-loading" : "")"
                                @onclick="HandleSubmit"
                                disabled="@(IsLoading || !FormReady)">
                            @if (IsLoading)
                            {
                                <span class="setup-spinner"></span>
                                <span>Sending…</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" />
                                </svg>
                                <span>Email me a reset link</span>
                            }
                        </button>

                        <div class="setup-secure-note">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                            <span>
                                For your protection we never reveal whether an account exists. Only a
                                registered, verified email address can receive a reset link.
                            </span>
                        </div>

                        <button type="button" class="login-forgot" @onclick="GoToLogin">← Back to sign in</button>                    </div>
                }

            </section>
        </div>
    </div>

</div>

@code {
    /// <summary>Whether this form can keep what is typed into it.</summary>
    /// <remarks>
    /// The app prerenders, and the boot splash hides as soon as prerendered markup is present - it looks for ".setup-root", which is
    /// this page's own root. So on a slow connection a complete but dead form is shown before the circuit connects, and Blazor's
    /// interactive first render then replaces the inputs with empty component state, discarding anything typed in between. Login.razor
    /// carries the full account; this is the same fault on the same root.
    /// </remarks>
    private bool FormReady => RendererInfo.IsInteractive;
    // ── Form state ──
    string Identifier = string.Empty;
    string FieldError = string.Empty;
    bool IsLoading;
    bool Submitted;

    // ── Per-LGU branding (defaults are Cantilan's, so the default LGU is unchanged) ──
    const string DefaultSealPath = "/images/LGU_CANTILAN_LOGO.jpg";
    const string NeutralSealPath = "/images/stalltrack-seal.png";
    string SealPath = DefaultSealPath;
    string MunicipalityName = "Cantilan";
    string OfficeAcronym = "EEMO";
    string OfficeName = "Economic Enterprise and Management Office";
    // True for Cantilan (the default LGU) or before any LGU resolves — keeps Cantilan's building-photo
    // backdrop. False for any other LGU so its panel uses the neutral backdrop instead (that photo carries
    // "Municipality of Cantilan" signage). Mirrors the sign-in page exactly.
    bool _isDefaultBrand = true;

    // The LGU this page is scoped to, from ?lgu={code} (carried over from a scoped login page).
    string LguParam = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("lgu", out var lguValues))
        {
            var lgu = lguValues.ToString().Trim();
            if (!string.IsNullOrEmpty(lgu))
            {
                LguParam = lgu;
                try
                {
                    var branding = await MunicipalitiesApi.GetBrandingByIdentifierAsync(lgu);
                    if (branding.IsSuccess && branding.Value is not null)
                        ApplyBranding(branding.Value);
                }
                catch { /* keep the default branding on any failure — never block recovery */ }
            }
        }
    }

    void ApplyBranding(MunicipalityBrandingDto b)
    {
        var isCantilan = string.Equals(b.Code, "CANTILAN", StringComparison.OrdinalIgnoreCase);
        _isDefaultBrand = isCantilan;
        SealPath = !string.IsNullOrWhiteSpace(b.SealPath) ? b.SealPath!
            : isCantilan ? DefaultSealPath : NeutralSealPath;
        MunicipalityName = string.IsNullOrWhiteSpace(b.Name) ? "Cantilan" : b.Name;
        OfficeAcronym = !string.IsNullOrWhiteSpace(b.OfficeAcronym) ? b.OfficeAcronym!
            : isCantilan ? "EEMO" : MunicipalityName;
        OfficeName = string.IsNullOrWhiteSpace(b.OfficeName) ? "Economic Enterprise and Management Office" : b.OfficeName;
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsLoading)
            await HandleSubmit();
    }

    async Task HandleSubmit()
    {
        FieldError = string.Empty;

        var entered = Identifier.Trim();
        if (string.IsNullOrWhiteSpace(entered))
        {
            FieldError = "Enter the email address on your account.";
            return;
        }
        // Format check only — mirrors the server validator. Whether the address belongs to an account is
        // never revealed (the confirmation below is identical either way).
        if (!IsPlausibleEmail(entered))
        {
            FieldError = "Enter a valid email address.";
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            await AuthApi.RequestPasswordResetAsync(
                new RequestPasswordResetCommand(entered, string.IsNullOrEmpty(LguParam) ? null : LguParam));
        }
        catch
        {
            /* swallowed on purpose: the confirmation must look identical either way (no enumeration,
               and a transient email/network fault must not hint that the account exists) */
        }
        finally
        {
            IsLoading = false;
            // Always show the same confirmation, regardless of the outcome.
            Submitted = true;
            StateHasChanged();
        }
    }

    // Conservative shape check (one @, a dot in the domain, no spaces). Deliberately not a strict RFC
    // validator — the server validates too, and over-strict client rules reject legitimate addresses.
    static bool IsPlausibleEmail(string value)
    {
        if (value.Contains(' ')) return false;
        var at = value.IndexOf('@');
        if (at <= 0 || at != value.LastIndexOf('@')) return false;
        var domain = value[(at + 1)..];
        var dot = domain.IndexOf('.');
        return dot > 0 && dot < domain.Length - 1;
    }

    void GoToLogin() =>
        Navigation.NavigateTo(string.IsNullOrEmpty(LguParam) ? "/login" : $"/login?lgu={Uri.EscapeDataString(LguParam)}");
}
