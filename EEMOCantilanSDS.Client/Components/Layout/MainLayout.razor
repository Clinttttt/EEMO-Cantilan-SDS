@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<EEMOCantilanSDS.Client.Components.Shared.GlobalLoadingBar />

@if (showSidebar)
{
    <div class="admin-layout">
        <Sidebar />
        
        <main class="admin-main">
            @Body
        </main>
    </div>
    @* Two-factor is offered once to a Head who has it switched off, then left to their judgement — it is no
       longer compulsory, so nobody is held on the setup page. Fails quiet and never blocks work. *@
    <EEMOCantilanSDS.Client.Components.Shared.MfaReminderPrompt />
    @* An office-issued password must be replaced before anything else. The API refuses every other endpoint meanwhile, so
       this only decides WHERE the user is sent; it is not the security boundary. *@
    <EEMOCantilanSDS.Client.Components.Shared.MustChangePasswordGuard />
    <EEMOCantilanSDS.Client.Components.Shared.SessionGuard LoginPath="/login" LogoutEndpoint="/api/authproxy/logout" />
}
else
{
    @Body
}

@code {
    private bool showSidebar = true;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateSidebarVisibility();
    }

    // First interactive render means the circuit is up and the app shell is on screen — remove the
    // branded boot splash that was covering the initial-load blank.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("hideStallTrackSplash"); }
            catch { /* JS not ready / not on a circuit. */ }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateSidebarVisibility();
        StateHasChanged();
    }

    /// <summary>
    /// Which pages stand alone is stated by <see cref="AppShell.IsStandalonePage"/> — a pure rule, so it can be tested in
    /// both directions rather than only observed on screen.
    /// </summary>
    private void UpdateSidebarVisibility()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        showSidebar = !AppShell.IsStandalonePage(path);
    }
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
