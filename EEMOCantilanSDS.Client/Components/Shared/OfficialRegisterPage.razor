@inject IJSRuntime JS

@* THE OFFICIAL REGISTER PAGE: the Stall Holder List's own topbar, hero, single-row toolbar and printed letterhead, shared by every official holder list and
   register so they read as one reporting system. It shares the PRESENTATION only: the page that uses it supplies its own data, filters, table and totals, and keeps
   its own source and financial rules. The toolbar order is fixed: search, then the page's filters, then Print, Download CSV, Save as PDF and Back. *@
<header class="topbar">
    <div class="topbar-left flex gap-2">
        <a href="@BackHref" class="lsh-back-btn" aria-label="@($"Back to {BackName}")">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="topbar-title">@Title</div>
            <div class="topbar-breadcrumb">
                <a href="/menu" class="breadcrumb-link">Dashboard</a>
                <span class="breadcrumb-sep">/</span>
                <a href="@BackHref" class="breadcrumb-link">@BackName</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-active">@Title</span>
            </div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @PhilippineTime.Now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

<div class="content-area">
    <div class="lsh-hero">
        <div class="lsh-hero-left">
            <div class="lsh-hero-icon">
                <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><circle cx="3" cy="6" r="1" /><circle cx="3" cy="12" r="1" /><circle cx="3" cy="18" r="1" /></svg>
            </div>
            <div>
                <div class="lsh-hero-eyebrow">@Eyebrow</div>
                <div class="lsh-hero-title">@Title</div>
                <div class="lsh-hero-sub">Municipality of @Branding.Municipality, @Branding.Province</div>
            </div>
        </div>
        <div class="lsh-hero-stats">
            @for (var i = 0; i < Stats.Count; i++)
            {
                @if (i > 0) { <div class="lsh-hero-divider"></div> }
                <div class="lsh-hero-stat">
                    <div class="lsh-hero-val">@Stats[i].Value</div>
                    <div class="lsh-hero-key">@Stats[i].Key</div>
                </div>
            }
        </div>
        <div class="lsh-hero-progress"><div class="lsh-hero-progress-fill" style="width:100%"></div></div>
    </div>

    <div class="page-toolbar">
        <div class="toolbar-left">
            <div class="search-box">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" placeholder="@SearchPlaceholder" aria-label="@SearchPlaceholder" value="@SearchQuery"
                       @oninput="e => SearchQueryChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <span class="search-clear" role="button" aria-label="Clear search" @onclick="() => SearchQueryChanged.InvokeAsync(string.Empty)">×</span>
                }
            </div>
            @Filters
        </div>
        <div class="lsh-actions">
            <button class="lsh-btn" type="button" @onclick="PrintAsync" title="Opens the print dialog — the sheet prints landscape so every column fits.">
                <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Print
            </button>
            <a class="lsh-btn" download="@CsvFileName" href="@CsvHref">
                <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Download CSV
            </a>
            <button class="lsh-btn lsh-btn-primary" type="button" @onclick="PrintAsync" title="Opens the print dialog — choose &quot;Save as PDF&quot; as the destination.">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Save as PDF
            </button>
            <a href="@BackHref" class="lsh-btn">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
                Back to @BackName
            </a>
        </div>
    </div>

    <div class="lsh-doc-panel">
        <div class="lsh-doc-header">
            <img class="lsh-doc-logo" src="@Branding.SealPath" alt="@Branding.Municipality seal" />
            <div class="lsh-doc-republic">Republic of the Philippines</div>
            <div class="lsh-doc-office">@Branding.OfficeName</div>
            <div class="lsh-doc-gov">Municipality of @Branding.Municipality, @Branding.Province</div>
            <div class="lsh-doc-title">@Title</div>
            <div class="lsh-doc-facility">@OperationName.ToUpper()</div>
            @if (!string.IsNullOrWhiteSpace(DocSubtitle)) { <div class="lsh-doc-section">@DocSubtitle.ToUpper()</div> }
        </div>
        @ChildContent
    </div>
</div>

@code {
    public sealed record Stat(string Value, string Key);

    /// <summary>The document's title, also the hero's.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    /// <summary>The operation or facility the document is of (printed under the title, upper-cased).</summary>
    [Parameter, EditorRequired] public string OperationName { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = string.Empty;
    /// <summary>A second centred line under the operation, for a filter that becomes part of the document's identity (a section, a tax year).</summary>
    [Parameter] public string? DocSubtitle { get; set; }
    [Parameter, EditorRequired] public string BackHref { get; set; } = "/operations";
    [Parameter, EditorRequired] public string BackName { get; set; } = "Operations";
    [Parameter] public IReadOnlyList<Stat> Stats { get; set; } = [];
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";
    [Parameter] public string SearchQuery { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }
    /// <summary>The page's own filters, drawn immediately after the search box.</summary>
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter, EditorRequired] public string CsvFileName { get; set; } = "register.csv";
    /// <summary>The CSV text of exactly what the document shows (same columns, order, rows).</summary>
    [Parameter] public string CsvText { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string CsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(CsvText);

    // Landscape: the injected rule comes from js/print.js immediately before printing (a scoped @page does not reach the print engine reliably).
    private async Task PrintAsync() => await JS.InvokeVoidAsync("stalltrackPrint.landscape");
}
