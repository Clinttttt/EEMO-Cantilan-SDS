@using EEMOCantilanSDS.Domain.Enums
@inject EEMOCantilanSDS.Client.Services.BrandingState Branding
@inject EEMOCantilanSDS.Client.Services.FacilityState Facilities

@*
    The facility's seal: the municipality's own mark inside a ring naming the facility.

    Drawn rather than stored as an image, because the ring's text is per-tenant AND per-facility - there is no one
    seal to ship. The mark in the centre is the tenant's own, from its branding, so no LGU is ever shown another's
    crest.

    The rings and the crest are ordinary CSS and an ordinary img. Only the curved text needs SVG, because nothing
    else can set type on a path. Keeping the crest out of the SVG means a browser that will not draw an <image>
    inside one still shows the seal rather than an empty circle.

    Decorative: every surface that shows this also names the facility in text beside it, so it is hidden from
    assistive technology rather than read out twice.
*@

<div class="fseal" style="width:@(Size)px;height:@(Size)px" aria-hidden="true">
    @* The FACILITY's own mark, from the shared artwork the portal and the collector app both draw from, so a market
       stall carries the market's mark and a commercial-centre space the storefront. The municipality's crest belongs to
       the municipality, not to one of its facilities, and a seal naming the market while showing the town's arms said
       the wrong thing about which of the two the page was about.

       A facility a Head added for their own LGU has no artwork of its own, so the tenant's crest stands in rather than
       leaving the ring hollow. *@
    <span class="fseal-mark">
        <FacilityMark Code="@Code" Ink="FacilityMarkInk.Navy" Size="@(Size / 3)">
            <Fallback>
                <img class="fseal-crest" src="@SealSrc" alt="" />
            </Fallback>
        </FacilityMark>
    </span>

    <svg class="fseal-type" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <defs>
            @* Unique per instance: two seals on one page must not share a path. *@
            <path id="fseal-top-@_id" d="M 60,60 m -45,0 a 45,45 0 1,1 90,0" fill="none" />
            <path id="fseal-bottom-@_id" d="M 60,60 m -45,0 a 45,45 0 1,0 90,0" fill="none" />
        </defs>

        <text font-size="@RingFontSize" font-weight="700" letter-spacing="1.2" fill="currentColor">
            <textPath href="#fseal-top-@_id" startOffset="50%" text-anchor="middle">@RingText</textPath>
        </text>

        <text font-size="7.5" font-weight="600" letter-spacing="1.6" fill="currentColor">
            <textPath href="#fseal-bottom-@_id" startOffset="50%" text-anchor="middle">OFFICIAL SEAL</textPath>
        </text>
    </svg>
</div>

@code {
    /// <summary>The facility the seal names.</summary>
    [Parameter, EditorRequired] public FacilityCode Code { get; set; }

    /// <summary>Drawn size in CSS pixels.</summary>
    [Parameter] public int Size { get; set; } = 76;

    /// <summary>
    /// Overrides the ring text, for a surface that knows a better name for the facility than the catalogue does — a
    /// Head-added custom facility, for instance.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];

    /// <summary>
    /// The facility's name, upper-cased as a seal is struck. A name too long for the arc gives way to the office's own
    /// short code rather than overrunning itself at the top of the circle, where the two ends would collide.
    /// </summary>
    private string RingText
    {
        get
        {
            var name = (!string.IsNullOrWhiteSpace(Name) ? Name! : Facilities.NameOf(Code)).Trim();
            if (name.Length == 0) name = Facilities.ShortNameOf(Code);

            return (name.Length > 30 ? Facilities.ShortNameOf(Code) : name).ToUpperInvariant();
        }
    }

    /// <summary>
    /// Set down a step for the longer names so they still fit the arc. Two sizes rather than a formula: the office
    /// sees these side by side in a list, and type that changes size with every name reads as a fault.
    /// </summary>
    private string RingFontSize => RingText.Length > 20 ? "8" : "10";

    private string SealSrc =>
        string.IsNullOrWhiteSpace(Branding.SealPath)
            ? EEMOCantilanSDS.Client.Services.BrandingState.NeutralSealPath
            : Branding.SealPath;
}
