@using System.Globalization
@using System.Text
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IGovernedServicesApiClient GovernedApi
@inject IJSRuntime JS

@* The standard operation report for a TRANSACTIONAL governed operation (Market Fees, Landing / Berthing, Transportation,
   Transfer Large Cattle, Vegetable / Fruits): the ECF report's shell — header, period, Print / Export CSV, tenant letterhead,
   classification and instrument facts — with a transactional body. Every figure is the server's: the official Monthly
   Income row for the line, the month's collected amount from that same row, and the governed-activity register. There is
   no "outstanding" here: these operations are paid on service and create no obligation. *@
<div class="v3-page">
    <div class="no-print">
        <WorkspaceHeader Parent="@Name" ParentHref="@ParentHref" Title="@($"{Name} Report")" Code="@Code">
            <Meta>
                @foreach (var chip in Instruments)
                {
                    <InstrumentChip Instrument="@chip" ShowName="@(Instruments.Count == 1)" />
                }
            </Meta>
            <Actions>
                <label class="v3-period">
                    <span>Month</span>
                    <input class="v3-input" type="month" aria-label="Reporting month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                </label>
                <div class="v3-btn-group" role="group" aria-label="Report actions">
                    <button class="v3-btn" type="button" @onclick="PrintAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
                        Print
                    </button>
                    @if (_activity is not null)
                    {
                        <a class="v3-btn" href="@ExportHref" download="@($"{Slug}-report-{_month:yyyy-MM}.csv")">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                            Export CSV
                        </a>
                    }
                </div>
            </Actions>
        </WorkspaceHeader>
    </div>

    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error v3-notice-row no-print" role="alert">
            <span>@_error</span>
            <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <article class="v3-report-sheet print-report-sheet" aria-labelledby="@($"{IdPrefix}-title")" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="@($"{Name} Report")" Period="@($"Reporting month {MonthLabel}")">
            <Facts>
                <div><dt>Classification</dt><dd>@Classification</dd></div>
                <div><dt>Instrument</dt><dd>@InstrumentFact</dd></div>
            </Facts>
        </ReportLetterhead>
        <h2 id="@($"{IdPrefix}-title")" class="v3-sr-only">@Name report for @MonthLabel</h2>

        <OperationMonthlyIncome Classification="@Classification" RowKey="@RowKey" Year="_month.Year" HeadingId="@($"{IdPrefix}-official")" />

        <section class="v3-report-section" aria-labelledby="@($"{IdPrefix}-position")">
            <h3 id="@($"{IdPrefix}-position")">Summary</h3>
            <dl class="v3-report-summary">
                <div><dt>Transactions</dt><dd>@Count(_activity?.Count)</dd></div>
                @if (Instruments.Count > 1)
                {
                    <div><dt>Official Receipts</dt><dd>@Count(_activity?.Count(x => x.Instrument == RevenueInstrumentType.OfficialReceipt))</dd></div>
                    <div><dt>Cash Tickets</dt><dd>@Count(_activity?.Count(x => x.Instrument == RevenueInstrumentType.CashTicket))</dd></div>
                }
                <div><dt>Collectors</dt><dd>@Count(_activity?.Select(x => x.CollectorName ?? "Office").Distinct().Count())</dd></div>
            </dl>
        </section>

        @if (ByFeeType && (_totals is null || _totals.Count > 0))
        {
            <section class="v3-report-section" aria-labelledby="@($"{IdPrefix}-fees")">
                <h3 id="@($"{IdPrefix}-fees")">By fee type</h3>
                <div class="v3-table-wrap">
                    <table class="v3-report-table">
                        <thead>
                            <tr>
                                <th scope="col">Fee type</th>
                                <th scope="col" class="v3-num">Transactions</th>
                                <th scope="col" class="v3-num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_totals is null || _totals.Count == 0)
                            {
                                <tr><td colspan="3" class="v3-report-note">@(_loading ? "Loading…" : _totals is null ? "The breakdown by fee type is unavailable." : $"No fee type collections in {MonthLabel}.")</td></tr>
                            }
                            else
                            {
                                @foreach (var total in _totals)
                                {
                                    <tr>
                                        <td>@total.Name</td>
                                        <td class="v3-num">@total.Collections.ToString("N0", CultureInfo.InvariantCulture)</td>
                                        <td class="v3-num">@Money(total.Amount)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (_totals is { Count: > 0 })
                        {
                            <tfoot>
                                <tr>
                                    <th scope="row">Total</th>
                                    <td class="v3-num">@_totals.Sum(x => x.Collections).ToString("N0", CultureInfo.InvariantCulture)</td>
                                    <td class="v3-num">@Money(_totals.Sum(x => x.Amount))</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </section>
        }

        <section class="v3-report-section" aria-labelledby="@($"{IdPrefix}-register")">
            <h3 id="@($"{IdPrefix}-register")">Collection register</h3>
            <div class="v3-table-wrap">
                <table class="v3-report-table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">SRC</th>
                            @if (ShowInstrument)
                            {
                                <th scope="col">Instrument</th>
                            }
                            @if (ModeAware)
                            {
                                <th scope="col">Mode</th>
                            }
                            @if (ShowFeeType)
                            {
                                <th scope="col">Fee type</th>
                            }
                            <th scope="col">Payer / reference</th>
                            <th scope="col">Collector</th>
                            <th scope="col" class="v3-num">Amount</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_activity is null || _activity.Count == 0)
                        {
                            <tr><td colspan="@ColumnCount" class="v3-report-note">@(_loading ? "Loading collections…" : _activity is null ? "Collections are unavailable." : $"No {Name} collections were recorded in {MonthLabel}.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _activity.OrderBy(x => x.BusinessDate).ThenBy(x => x.ReferenceCode, StringComparer.Ordinal))
                            {
                                <tr>
                                    <td>@row.BusinessDate.ToString("MMM d", CultureInfo.InvariantCulture)</td>
                                    <td>@row.ReferenceCode</td>
                                    @if (ShowInstrument)
                                    {
                                        <td>@InstrumentShort(row.Instrument)</td>
                                    }
                                    @if (ModeAware)
                                    {
                                        <td>@ModeLabel(row.Mode)</td>
                                    }
                                    @if (ShowFeeType)
                                    {
                                        <td>@(row.FeeOptionName ?? "—")</td>
                                    }
                                    <td>@(row.PayerName ?? "Walk-up")@(string.IsNullOrWhiteSpace(row.Reference) ? "" : $" · {row.Reference}")</td>
                                    <td>@(row.CollectorName ?? "Office")</td>
                                    <td class="v3-num">@Money(row.Amount)</td>
                                    <td>@row.Disposition</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </article>
</div>

@code {
    /// <summary>CollectorOperationCodes value, e.g. MARKET_FEES.</summary>
    [Parameter, EditorRequired] public string OperationCode { get; set; } = string.Empty;

    /// <summary>The line's display name, e.g. "Market Fees".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string ParentHref { get; set; } = string.Empty;

    /// <summary>The official Monthly Income row key for the line.</summary>
    [Parameter, EditorRequired] public string RowKey { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Classification { get; set; } = string.Empty;

    /// <summary>"OR" and/or "CT", as the canonical policy permits; two for a mode-aware operation.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Instruments { get; set; } = [];

    /// <summary>The Instrument fact on the letterhead; for a dual-instrument operation it says what decides it.</summary>
    [Parameter, EditorRequired] public string InstrumentFact { get; set; } = string.Empty;

    [Parameter] public string? Code { get; set; }

    [Parameter] public bool ModeAware { get; set; }

    [Parameter, EditorRequired] public string IdPrefix { get; set; } = "gor";

    /// <summary>Adds a "By fee type" breakdown and a Fee type column, for an operation collected by approved fee type (Market Fees).</summary>
    [Parameter] public bool ByFeeType { get; set; }

    // One instrument is already stated in the header and letterhead, so the register repeats it only when two can apply.
    private bool ShowInstrument => Instruments.Count > 1;
    private bool ShowFeeType => ByFeeType && (_activity?.Any(x => x.FeeOptionName is not null) ?? false);
    private int ColumnCount => 6 + (ShowInstrument ? 1 : 0) + (ModeAware ? 1 : 0) + (ShowFeeType ? 1 : 0);
    private IReadOnlyList<FeeOptionTotalDto>? _totals;

    private DateOnly _month = new(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private IReadOnlyList<GovernedServiceActivityDto>? _activity;
    private string? _error;
    private bool _loading;

    private string MonthLabel => _month.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private string Slug => OperationCode.ToLowerInvariant().Replace('_', '-');

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeMonthAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            _month = month;
            _monthInput = month.ToString("yyyy-MM", CultureInfo.InvariantCulture);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await GovernedApi.GetActivityAsync(OperationCode, _month, _month.AddMonths(1).AddDays(-1));
            if (result is { IsSuccess: true, Value: { } rows }) _activity = rows;
            else { _activity = null; _error = $"The {Name} collections could not be loaded."; }
            if (ByFeeType)
            {
                var totals = await GovernedApi.GetFeeOptionTotalsAsync(OperationCode, _month, _month.AddMonths(1).AddDays(-1));
                _totals = totals is { IsSuccess: true, Value: { } list } ? list : null;
            }
        }
        catch
        {
            _activity = null;
            _totals = null;
            _error = $"The {Name} collections could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("stalltrackPrint.reportDocument");

    private string ExportHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildCsv());

    private string BuildCsv()
    {
        var rows = new List<string>
        {
            Csv("Report", $"{Name} Report"),
            Csv("Office", Branding.OfficeName),
            Csv("Municipality", $"{Branding.Municipality}, {Branding.Province}"),
            Csv("Reporting month", MonthLabel),
            Csv("Classification", Classification),
            Csv("Instrument", InstrumentFact),
            Csv("Date prepared", PhilippineTime.Now.ToString("yyyy-MM-dd")),
            string.Empty,
            Csv("Date", "SRC", "Instrument", "Mode", "Fee type", "Payer", "Reference", "Collector", "Amount", "Status"),
        };
        rows.AddRange((_activity ?? []).OrderBy(x => x.BusinessDate).Select(x => Csv(
            x.BusinessDate.ToString("yyyy-MM-dd"), x.ReferenceCode, InstrumentShort(x.Instrument), ModeLabel(x.Mode), x.FeeOptionName,
            x.PayerName ?? "Walk-up", x.Reference ?? "", x.CollectorName ?? "Office",
            x.Amount.ToString("0.00", CultureInfo.InvariantCulture), x.Disposition)));
        return string.Join("\r\n", rows);
    }

    private static string Csv(params string?[] values) =>
        string.Join(",", values.Select(v => $"\"{(v ?? string.Empty).Replace("\"", "\"\"")}\""));

    private static string Count(int? value) => value is { } v ? v.ToString(CultureInfo.InvariantCulture) : "—";

    private static string InstrumentShort(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "OR",
        RevenueInstrumentType.CashTicket => "CT",
        _ => "—",
    };

    private static string ModeLabel(GovernedServiceMode? mode) => mode switch
    {
        null => "—",
        _ => mode.Value.ToString() switch
        {
            "WholePayment" => "Monthly rental",
            "DailyTransaction" => "Daily transaction",
            var other => other,
        },
    };

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
