@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using System.Globalization
@implements IAsyncDisposable
@inject IUtilityRegisterApiClient RegisterApi
@inject IJSRuntime JS

@* The ECF / WCF workspace, one composition for both utilities: a compact header, the source register (server-filtered, counted and
   paged), the selected source's detail and actions, then whatever the page adds (its notices and its collection activity). It
   states the server's figures and computes none: an approved amount is an obligation, money collected is the canonical Collections'
   alone, and a source collected directly never shows an invented balance. *@
<div class="v3-page uw-page">
    <V3Hero Eyebrow="@Eyebrow" Title="@Title" Compact="true">
        <Meta><span class="uw-meta">@PeriodLabel · <InstrumentChip Instrument="@InstrumentCode" /> @InstrumentName</span></Meta>
        <Figures>
            <V3HeroFigure Label="Assessed" Value="@Figure(_page?.Totals.Assessed)" Note="@(_page is null ? null : "Approved amounts")" />
            <V3HeroFigure Label="Net settled" Value="@Figure(_page?.Totals.Collected)" Note="@DirectNote" />
            <V3HeroFigure Label="Outstanding" Value="@Figure(_page?.Totals.Outstanding)" Note="@(_page is null ? null : "Prepared balances")" />
        </Figures>
        <Actions>
            <a class="v3-btn" href="@BasePath/statements">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
                Statements
            </a>
            <a class="v3-btn" href="@BasePath/report">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><polyline points="14 3 14 9 20 9" /><line x1="8" y1="14" x2="16" y2="14" /><line x1="8" y1="17" x2="13" y2="17" /></svg>
                Report
            </a>
        </Actions>
    </V3Hero>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="v3-notice" role="status">@_message</p>
    }
    @Notices

    @if (_showActivity)
    {
        <div class="uw-enter">@Activity?.Invoke(EventCallback.Factory.Create(this, HideActivity))</div>
    }
    else
    {
    <div class="uw-layout uw-enter @(Selected is null ? "uw-idle" : null)">
        <section class="v3-panel uw-register" aria-labelledby="uw-register-title" aria-busy="@(_loading ? "true" : "false")">
            <header class="v3-panel-header uw-register-head">
                <h2 id="uw-register-title">@RegisterTitle</h2>
                <span class="v3-panel-meta" role="status">@Summary</span>
            </header>

            <div class="v3-toolbar uw-toolbar no-print" aria-label="Source filters">
                <input class="v3-input uw-month" type="month" aria-label="Billing month" title="Billing month" value="@_monthInput" @onchange="ChangeMonthAsync" />
                <label class="v3-search">
                    <span class="v3-sr-only">Search payer, stall or space</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                    <input type="search" placeholder="Search payer or stall" aria-label="Search payer, stall or space" autocomplete="off"
                           value="@_search" @oninput="OnSearchInput" />
                </label>
                <select class="v3-select uw-facility" aria-label="Facility" title="Facility" @onchange="ChangeFacilityAsync">
                    <option value="" selected="@(_facility == "")">All facilities</option>
                    @foreach (var facility in _page?.Facilities ?? [])
                    {
                        <option value="@((int)facility.Code)" selected="@(_facility == ((int)facility.Code).ToString())">@facility.Name</option>
                    }
                </select>
                <button class="v3-btn uw-icon-btn" type="button" @onclick="ShowActivity" aria-label="Show collection activity" title="Collection activity">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
                </button>
                <details class="uw-filters">
                    <summary class="v3-btn uw-icon-btn" aria-label="@(AreaOrStatusActive ? "Filters, applied" : "Filters")" title="Filters">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
                        @if (AreaOrStatusActive) { <span class="uw-filter-dot" aria-hidden="true"></span> }
                    </summary>
                    <div class="uw-filter-pop" role="group" aria-label="Area and status">
                        <label class="uw-field">
                            <span>Area</span>
                            <select class="v3-select" aria-label="Area" @onchange="ChangeSectionAsync">
                                <option value="" selected="@(_section == "")">All areas</option>
                                @foreach (var section in _page?.Sections ?? [])
                                {
                                    <option value="@section" selected="@(_section == section)">@SectionLabel(section)</option>
                                }
                            </select>
                        </label>
                        <label class="uw-field">
                            <span>Status</span>
                            <select class="v3-select" aria-label="Status" @onchange="ChangeStatusAsync">
                                @foreach (var (value, label) in Statuses)
                                {
                                    <option value="@value" selected="@(_status == value)">@label</option>
                                }
                            </select>
                        </label>
                        <button class="v3-btn v3-btn-sm" type="button" disabled="@(!Filtered)" @onclick="ClearFiltersAsync">Clear filters</button>
                    </div>
                </details>
                <button class="v3-btn uw-icon-btn" type="button" @onclick="RefreshAsync" disabled="@_loading" aria-label="Refresh sources" title="Refresh sources">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5" /></svg>
                </button>
                <button class="v3-btn uw-icon-btn" type="button" @onclick="OpenBatch" disabled="@(_loading || _page is null)" aria-label="Prepare multiple amounts" title="Prepare multiple amounts">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </button>
            </div>

            @if (_error is not null)
            {
                <div class="v3-notice v3-notice-error v3-notice-row" role="alert">
                    <span>@_error</span>
                    <button class="v3-btn v3-btn-sm" type="button" @onclick="RefreshAsync">Try again</button>
                </div>
            }

            <div class="v3-table-wrap uw-scroll" @ref="_register" role="region" aria-label="@(Title) sources" tabindex="0">
                <table class="v3-table uw-table">
                    <caption class="v3-sr-only">@Title sources for @PeriodLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col">Payor / source</th>
                            <th scope="col" class="v3-num">Approved</th>
                            <th scope="col" class="v3-num">Net settled</th>
                            <th scope="col" class="v3-num">Outstanding</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _page?.Rows ?? [])
                        {
                            <tr class="uw-row @(IsSelected(row) ? "is-selected" : "")" @key="row.StallId" aria-selected="@(IsSelected(row) ? "true" : "false")" @onclick="() => Select(row)">
                                <td>
                                    <button type="button" class="uw-row-btn" aria-label="@($"Open {PayerOf(row)}, {ContextOf(row)}")">
                                        <span class="v3-strong uw-payer">@PayerOf(row)</span>
                                        <span class="v3-block uw-context">@ContextOf(row)</span>
                                    </button>
                                </td>
                                <td class="v3-num">@(row.Approved is { } approved ? Money(approved) : "—")</td>
                                <td class="v3-num">@Money(row.Collected)@if (row.AwaitingConfirmation > 0m) { <span class="v3-block uw-awaiting">+@Money(row.AwaitingConfirmation) awaiting</span> }</td>
                                <td class="v3-num v3-strong">@(row.Mode == "Prepared" ? Money(row.Outstanding) : "—")</td>
                                <td><span class="uw-status uw-status-@row.Status.ToLowerInvariant()">@StatusLabel(row.Status)</span></td>
                            </tr>
                        }
                        @if (_page is { Rows.Count: 0 } && !_loading)
                        {
                            <tr>
                                <td class="v3-empty" colspan="5">
                                    @if (Filtered)
                                    {
                                        <span>No source matches these filters.</span>
                                        <button class="v3-btn v3-btn-sm" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
                                    }
                                    else
                                    {
                                        <span>No verified @UtilityName source is registered for @PeriodLabel. A space appears here when its @UtilityName service is recorded on the space.</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_page is null && _loading)
                        {
                            <tr><td class="v3-empty" colspan="5"><span role="status">Loading sources…</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_page is { Total: > 0 } pg)
            {
                <footer class="uw-pager no-print">
                    <span class="uw-pager-info">@(_skip + 1)–@(_skip + pg.Rows.Count) of @(pg.Total)</span>
                    <div class="v3-btn-group" role="group" aria-label="Pages">
                        <button class="v3-btn v3-btn-sm" type="button" disabled="@(_skip == 0 || _loading)" @onclick="PreviousAsync">Previous</button>
                        <button class="v3-btn v3-btn-sm" type="button" disabled="@(_skip + pg.Rows.Count >= pg.Total || _loading)" @onclick="NextAsync">Next</button>
                    </div>
                </footer>
            }
        </section>

        <aside class="v3-panel uw-detail" aria-labelledby="uw-detail-title">
            @if (Selected is { } source)
            {
                <header class="v3-panel-header">
                    <h2 id="uw-detail-title">@PayerOf(source)</h2>
                    <span class="uw-status uw-status-@source.Status.ToLowerInvariant()">@StatusLabel(source.Status)</span>
                </header>
                <div class="v3-panel-body uw-detail-body">
                    <p class="uw-detail-context">@ContextOf(source) · @PeriodLabel</p>
                    <dl class="v3-facts uw-facts" aria-label="Source position">
                        <div><dt>Amount method</dt><dd>@MethodOf(source)</dd></div>
                        <div><dt>Approved</dt><dd>@(source.Approved is { } approved ? Money(approved) : "Not prepared")</dd></div>
                        <div><dt>Net settled</dt><dd>@Money(source.Collected)</dd></div>
                        @if (source.AwaitingConfirmation > 0m) { <div><dt>Awaiting confirmation</dt><dd class="v3-strong">@Money(source.AwaitingConfirmation)</dd></div> }
                        @if (source.Mode == "Prepared")
                        {
                            <div><dt>Outstanding</dt><dd class="v3-strong">@Money(source.Outstanding)</dd></div>
                        }
                    </dl>

                    <p class="uw-note">@StatusNote(source)</p>

                    @if (source.CanPrepare)
                    {
                        <section class="uw-prepare" aria-labelledby="uw-prepare-title">
                            <h3 id="uw-prepare-title">@(source.Mode == "Prepared" ? "Revise approved amount" : "Prepare amount")</h3>
                            @if (!_reviewing)
                            {
                                <label class="uw-field">
                                    <span>Approved amount (₱)</span>
                                    <input class="v3-input" type="text" inputmode="decimal" autocomplete="off" aria-describedby="uw-prepare-help"
                                           value="@_amountText" @oninput="OnAmountInput" />
                                </label>
                                <p id="uw-prepare-help" class="uw-help">Records an obligation only. No collection or SRC is created.</p>
                                @if (_amountError is not null) { <p class="uw-error" role="alert">@_amountError</p> }
                                <button class="v3-btn v3-btn-primary" type="button" disabled="@(_amount is null || _busy)" @onclick="() => _reviewing = true">Review</button>
                            }
                            else
                            {
                                <p class="uw-review" role="status">Approve <strong>@Money(_amount!.Value)</strong> of @UtilityName for <strong>@PayerOf(source)</strong>.</p>
                                <p class="uw-review-context">@PeriodLabel · This step records an approved amount only; it does not collect payment.</p>
                                <div class="uw-review-actions">
                                    <button class="v3-btn" type="button" disabled="@_busy" @onclick="() => _reviewing = false">Back</button>
                                    <button class="v3-btn v3-btn-primary" type="button" disabled="@_busy" @onclick="SaveAmountAsync">Save approved amount</button>
                                </div>
                            }
                        </section>
                    }
                    else if (source.PrepareLock is not null)
                    {
                        <p class="uw-note">@source.PrepareLock</p>
                    }

                    @SourceActions?.Invoke(source)
                </div>
            }
            else
            {
                <header class="v3-panel-header"><h2 id="uw-detail-title">Source details</h2></header>
                <div class="v3-panel-body uw-empty-detail"><p class="uw-note">Select a source to see its position, prepare its approved amount or record a payment.</p></div>
            }
        </aside>
    </div>
    }

</div>

@if (_batchOpen)
{
    <div class="v3-modal-backdrop" role="presentation" @onclick="CloseBatch">
        <section class="v3-modal uw-batch" role="dialog" aria-modal="true" aria-labelledby="uw-batch-title" @onclick:stopPropagation="true">
            <header class="v3-modal-header">
                <h2 id="uw-batch-title">Prepare multiple amounts</h2>
                <button class="v3-btn v3-btn-sm" type="button" aria-label="Close" @onclick="CloseBatch">Close</button>
            </header>
            <div class="v3-modal-body">
                @if (_batchResult is { } result)
                {
                    <p role="status" class="uw-review"><strong>@result.PreparedCount</strong> prepared@(result.RefusedCount > 0 ? $", {result.RefusedCount} not changed" : "") for @PeriodLabel.</p>
                    <ul class="uw-batch-results">
                        @foreach (var outcome in result.Outcomes)
                        {
                            <li class="@(outcome.Prepared ? "is-ok" : "is-refused")">
                                <strong>@BatchLabel(outcome.StallId)</strong> — @(outcome.Prepared ? "Prepared" : outcome.Reason)
                            </li>
                        }
                    </ul>
                }
                else if (_batchReviewing)
                {
                    <p class="uw-review">Review these approved amounts for @PeriodLabel. Each source keeps its own amount; nothing is divided between payors and nothing is collected.</p>
                    <table class="v3-table">
                        <thead><tr><th scope="col">Source</th><th scope="col" class="v3-num">Approved amount</th></tr></thead>
                        <tbody>
                            @foreach (var entry in BatchEntries)
                            {
                                <tr><td>@entry.Label</td><td class="v3-num">@Money(entry.Amount)</td></tr>
                            }
                        </tbody>
                        <tfoot><tr><th scope="row">@BatchEntries.Count source@(BatchEntries.Count == 1 ? "" : "s")</th><td class="v3-num v3-strong">@Money(BatchEntries.Sum(x => x.Amount))</td></tr></tfoot>
                    </table>
                }
                else
                {
                    <p class="uw-help">Enter an approved amount for each source you want to prepare. Leave the others blank.</p>
                    <div class="v3-table-wrap">
                        <table class="v3-table">
                            <thead><tr><th scope="col">Source</th><th scope="col">Status</th><th scope="col" class="v3-num">Amount (₱)</th></tr></thead>
                            <tbody>
                                @foreach (var row in PreparableRows)
                                {
                                    <tr @key="row.StallId">
                                        <td><span class="v3-strong">@PayerOf(row)</span><span class="v3-block uw-context">@ContextOf(row)</span></td>
                                        <td><span class="uw-status uw-status-@row.Status.ToLowerInvariant()">@StatusLabel(row.Status)</span></td>
                                        <td class="v3-num">
                                            <input class="v3-input uw-batch-input" placeholder="0.00" type="text" inputmode="decimal" autocomplete="off"
                                                   aria-label="@($"Approved amount for {PayerOf(row)}, {ContextOf(row)}")"
                                                   value="@BatchText(row.StallId)" @oninput="e => SetBatch(row.StallId, e.Value?.ToString())" />
                                        </td>
                                    </tr>
                                }
                                @if (!PreparableRows.Any())
                                {
                                    <tr><td class="v3-empty" colspan="3">No listed source can be prepared. Filter to sources without an amount, or change the page.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_batchError is not null) { <p class="uw-error" role="alert">@_batchError</p> }
                }
            </div>
            <footer class="v3-modal-footer">
                @if (_batchResult is null && !_batchReviewing)
                {
                    <span class="uw-batch-count" role="status">@BatchEntries.Count to prepare</span>
                }
                @if (_batchResult is not null)
                {
                    <button class="v3-btn v3-btn-primary" type="button" @onclick="CloseBatch">Done</button>
                }
                else if (_batchReviewing)
                {
                    <button class="v3-btn" type="button" disabled="@_busy" @onclick="() => _batchReviewing = false">Back</button>
                    <button class="v3-btn v3-btn-primary" type="button" disabled="@_busy" @onclick="SaveBatchAsync">Save approved amounts</button>
                }
                else
                {
                    <button class="v3-btn" type="button" @onclick="CloseBatch">Cancel</button>
                    <button class="v3-btn v3-btn-primary" type="button" disabled="@(BatchEntries.Count == 0)" @onclick="ReviewBatch">Review</button>
                }
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public UtilityKind Kind { get; set; }

    /// <summary>Page-specific notices shown under the header (ECF unfinished collection, WCF Collector Mobile status).</summary>
    [Parameter] public RenderFragment? Notices { get; set; }

    /// <summary>Page-specific actions for the selected source (record a payment, review a legacy migration).</summary>
    [Parameter] public RenderFragment<UtilityRegisterRowDto>? SourceActions { get; set; }

    /// <summary>The page's own compact collection activity.</summary>
    [Parameter] public RenderFragment<EventCallback>? Activity { get; set; }

    /// <summary>Raised after the register has loaded for a month, so the page can load that month's activity.</summary>
    [Parameter] public EventCallback<(int Year, int Month)> OnPeriodLoaded { get; set; }

    private UtilityRegisterPageDto? _page;
    private int _year = PhilippineTime.Today.Year, _month = PhilippineTime.Today.Month;
    private string _monthInput = PhilippineTime.Today.ToString("yyyy-MM");
    private string _search = "", _facility = "", _section = "", _status = "All";
    private int _skip, _take = 25;
    private bool _loading, _busy;
    private string? _error, _message;
    private int _generation;
    private CancellationTokenSource? _debounce;
    private Guid? _selectedId;

    // Preparing one amount
    private string _amountText = "";
    private decimal? _amount;
    private string? _amountError;
    private bool _reviewing;

    // Preparing several
    private bool _batchOpen, _batchReviewing;
    private readonly Dictionary<Guid, string> _batchText = [];
    private string? _batchError;
    private UtilityPrepareResult? _batchResult;

    private static readonly (string Value, string Label)[] Statuses =
    [
        ("All", "All statuses"), ("Unprepared", "Unprepared"), ("Unpaid", "Unpaid"), ("Partial", "Partial"),
        ("Settled", "Settled"), ("Direct", "Direct collections"), ("NeedsReview", "Needs review")
    ];

    private bool IsEcf => Kind == UtilityKind.Electricity;
    private string UtilityName => IsEcf ? "electricity" : "water";
    private string Eyebrow => IsEcf ? "Operations · ECF" : "Operations · WCF";
    private string Title => IsEcf ? "Electricity Consumption Fees" : "Water Consumption Fees";
    private string RegisterTitle => IsEcf ? "Electricity sources" : "Water sources";
    private string InstrumentCode => IsEcf ? "OR" : "CT";
    private string InstrumentName => IsEcf ? "Official Receipt" : "Cash Ticket";
    private string BasePath => IsEcf ? "/operations/ecf" : "/operations/water-consumption-fees";
    private string PeriodLabel => new DateOnly(_year, _month, 1).ToString("MMMM yyyy");
    private bool Filtered => _search.Length > 0 || _facility != "" || _section != "" || _status != "All";

    private string Summary => _page is null ? (_loading ? "Loading…" : "") : $"{_page.Total} source{(_page.Total == 1 ? "" : "s")}";
    private string? DirectNote => _page is null ? null : _page.Totals.AwaitingConfirmation > 0m ? $"{Money(_page.Totals.AwaitingConfirmation)} direct, awaiting Head confirmation" : _page.Totals.DirectCollected > 0m ? $"{Money(_page.Totals.DirectCollected)} of it direct" : "Applied to this month";
    private UtilityRegisterRowDto? Selected => _page?.Rows.FirstOrDefault(r => r.StallId == _selectedId);
    private bool IsSelected(UtilityRegisterRowDto row) => row.StallId == _selectedId;
    private IEnumerable<UtilityRegisterRowDto> PreparableRows => (_page?.Rows ?? []).Where(r => r.CanPrepare);

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Reloads the register for the current filters (used after a payment is recorded elsewhere on the page).</summary>
    public Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++_generation;
        _loading = true; _error = null;
        try
        {
            FacilityCode? facility = int.TryParse(_facility, out var code) && Enum.IsDefined((FacilityCode)code) ? (FacilityCode)code : null;
            var result = await RegisterApi.GetRegisterAsync(new(Kind, _year, _month, facility, _section == "" ? null : _section,
                _status == "All" ? null : _status, _search.Trim().Length == 0 ? null : _search.Trim(), _skip, _take));
            if (generation != _generation) return;                  // a newer search or page has superseded this answer
            if (result is { IsSuccess: true, Value: { } page })
            {
                _page = page;
                if (_selectedId is { } id && page.Rows.All(r => r.StallId != id)) { _selectedId = null; ResetPrepare(); }
            }
            else _error = result?.Error ?? "Unable to load the sources. Try again.";
        }
        catch { if (generation == _generation) _error = "Unable to load the sources. Try again."; }
        finally
        {
            if (generation == _generation) _loading = false;
        }
        if (generation == _generation && _error is null) await OnPeriodLoaded.InvokeAsync((_year, _month));
    }

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (!DateOnly.TryParseExact((args.Value?.ToString() ?? "") + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)) return;
        (_year, _month, _monthInput, _skip) = (parsed.Year, parsed.Month, parsed.ToString("yyyy-MM"), 0);
        _selectedId = null; ResetPrepare();
        await LoadAsync();
    }

    // Typing searches the server after a short pause; a newer keystroke supersedes any answer still on its way.
    private void OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? "";
        _generation++;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        _ = DebouncedAsync(_debounce.Token);
    }

    private async Task DebouncedAsync(CancellationToken token)
    {
        try { await Task.Delay(300, token); } catch (OperationCanceledException) { return; }
        _skip = 0;
        await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private Task ChangeFacilityAsync(ChangeEventArgs a) { _facility = a.Value?.ToString() ?? ""; _section = ""; _skip = 0; return LoadAsync(); }
    private Task ChangeSectionAsync(ChangeEventArgs a) { _section = a.Value?.ToString() ?? ""; _skip = 0; return LoadAsync(); }
    private Task ChangeStatusAsync(ChangeEventArgs a) { _status = a.Value?.ToString() ?? "All"; _skip = 0; return LoadAsync(); }
    private Task PreviousAsync() { _skip = Math.Max(0, _skip - _take); return LoadAsync(); }
    private Task NextAsync() { _skip += _take; return LoadAsync(); }
    private Task ClearFiltersAsync() { (_search, _facility, _section, _status, _skip) = ("", "", "", "All", 0); return LoadAsync(); }

    private void Select(UtilityRegisterRowDto row)
    {
        if (_selectedId == row.StallId) return;
        _selectedId = row.StallId; ResetPrepare();
        _amountText = row.Approved is { } approved ? approved.ToString("0.00", CultureInfo.InvariantCulture) : "";
        _amount = row.Approved;
    }

    // ── Prepare one amount ───────────────────────────────────────────────────────────────────────
    private void ResetPrepare() { _reviewing = false; _amountText = ""; _amount = null; _amountError = null; }

    private void OnAmountInput(ChangeEventArgs args)
    {
        _amountText = args.Value?.ToString() ?? "";
        (_amount, _amountError) = ParseAmount(_amountText);
    }

    private static (decimal? Amount, string? Error) ParseAmount(string text)
    {
        var cleaned = text.Replace("₱", "").Replace(",", "").Trim();
        if (cleaned.Length == 0) return (null, null);
        if (!decimal.TryParse(cleaned, NumberStyles.Number, CultureInfo.InvariantCulture, out var value) || value <= 0m
            || value != decimal.Round(value, 2) || value > 1_000_000m)
            return (null, "Enter a positive amount in pesos and centavos.");
        return (value, null);
    }

    private async Task SaveAmountAsync()
    {
        if (Selected is not { } source || _amount is not { } amount || _busy) return;
        _busy = true; _error = null;
        try
        {
            var result = await RegisterApi.PrepareAsync(new(Kind, _year, _month, [new(source.StallId, amount, source.SourceVersion)]));
            if (result is { IsSuccess: true, Value: { } value } && value.Outcomes.Count == 1)
            {
                var outcome = value.Outcomes[0];
                if (outcome.Prepared) _message = $"{Money(amount)} approved for {PayerOf(source)}. No collection was recorded.";
                else _error = outcome.Reason;
            }
            else _error = result?.Error ?? "The amount could not be prepared.";
            _reviewing = false;
        }
        catch { _error = "The amount could not be prepared."; _reviewing = false; }
        finally { _busy = false; }
        await LoadAsync();
    }

    // ── Prepare several amounts ──────────────────────────────────────────────────────────────────
    private sealed record BatchEntry(Guid StallId, string Label, decimal Amount, long Version);

    private void OpenBatch() { _batchOpen = true; _batchReviewing = false; _batchResult = null; _batchError = null; _batchText.Clear(); }
    private void CloseBatch() { _batchOpen = false; }
    private string BatchText(Guid id) => _batchText.GetValueOrDefault(id, "");
    private void SetBatch(Guid id, string? text) { _batchText[id] = text ?? ""; _batchError = null; }

    private List<BatchEntry> BatchEntries => PreparableRows
        .Select(r => (Row: r, Parsed: ParseAmount(BatchText(r.StallId))))
        .Where(x => x.Parsed.Amount is not null)
        .Select(x => new BatchEntry(x.Row.StallId, $"{PayerOf(x.Row)} · {ContextOf(x.Row)}", x.Parsed.Amount!.Value, x.Row.SourceVersion))
        .ToList();

    private string BatchLabel(Guid id) => _page?.Rows.Where(r => r.StallId == id).Select(r => $"{PayerOf(r)} · {ContextOf(r)}").FirstOrDefault() ?? "Source";

    private void ReviewBatch()
    {
        var invalid = PreparableRows.Where(r => BatchText(r.StallId).Trim().Length > 0 && ParseAmount(BatchText(r.StallId)).Amount is null).ToList();
        if (invalid.Count > 0) { _batchError = $"Check the amount for {PayerOf(invalid[0])}: enter a positive amount in pesos and centavos."; return; }
        _batchReviewing = BatchEntries.Count > 0;
    }

    private async Task SaveBatchAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await RegisterApi.PrepareAsync(new(Kind, _year, _month, BatchEntries.Select(e => new UtilityPrepareItem(e.StallId, e.Amount, e.Version)).ToList()));
            if (result is { IsSuccess: true, Value: { } value }) _batchResult = value;
            else { _batchError = result?.Error ?? "The amounts could not be prepared."; _batchReviewing = false; }
        }
        catch { _batchError = "The amounts could not be prepared."; _batchReviewing = false; }
        finally { _busy = false; }
        await LoadAsync();
    }

    // ── Presentation ─────────────────────────────────────────────────────────────────────────────
    private static string PayerOf(UtilityRegisterRowDto row) => string.IsNullOrWhiteSpace(row.Payer) ? "No occupant on record" : row.Payer;

    private static string ContextOf(UtilityRegisterRowDto row) =>
        string.Join(" · ", new[] { row.FacilityName, string.IsNullOrWhiteSpace(row.Section) ? null : SectionLabel(row.Section), $"Stall {row.StallNo.Replace("-", "-⁠")}" }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string SectionLabel(string raw) => System.Text.RegularExpressions.Regex.Replace(raw, "(?<=[a-z])(?=[A-Z])", " ");

    private bool AreaOrStatusActive => _section != "" || _status != "All";

    // One short line on where the period stands; the longer rules live in the handoff, not on every source.
    private static string StatusNote(UtilityRegisterRowDto row) => row.Status switch
    {
        "Unprepared" => "No approved amount for this period.",
        "Unpaid" => $"{Money(row.Outstanding)} remaining.",
        "Partial" => $"{Money(row.Outstanding)} remaining.",
        "Settled" => "Settled for this period.",
        "Direct" => row.AwaitingConfirmation > 0m ? $"{Money(row.AwaitingConfirmation)} recorded by the collector; it is settled here once the Head confirms it in Collection Review." : "Collection recorded without a prepared assessment.",
        "NeedsReview" => "Source requires office review.",
        _ => ""
    };

    private static string MethodOf(UtilityRegisterRowDto row) => row.Mode switch
    {
        "Prepared" => "Prepared amount",
        "Direct" => "Direct collection",
        _ => "Not set"
    };

    private static string StatusLabel(string status) => status switch
    {
        "NeedsReview" => "Needs review",
        "Direct" => "Direct collections",
        _ => status
    };

    private static string Money(decimal amount) => $"₱{amount:N2}";
    private static string Figure(decimal? amount) => amount is { } value ? Money(value) : "—";

    // The register shows about six sources; the rest scroll inside it (sized by the same measuring module as the governed-service history).
    private const int VisibleSources = 5;
    private bool _showActivity, _observed;
    private void ShowActivity() { _showActivity = true; _observed = false; }
    private void HideActivity() => _showActivity = false;
    private ElementReference _register;
    private IJSObjectReference? _scrollModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _scrollModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/collectionHistory.js");
        if (!_showActivity && !_observed)
        {
            _observed = true;
            await _scrollModule.InvokeVoidAsync("observe", _register, VisibleSources);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _debounce?.Cancel();
        if (_scrollModule is null) return;
        try
        {
            await _scrollModule.InvokeVoidAsync("disconnect", _register);
            await _scrollModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
