@* A small set of mutually exclusive choices as the stallholder drawer's basis-of-occupancy cards (avm-choice). A visual selector only; what each
   value means belongs to the page that supplies it. *@
<div class="avm-choice" role="radiogroup" aria-label="@Label" style="--avm-choice-count: @Items.Count">
    @foreach (var item in Items)
    {
        var selected = item.Value == Value;
        <button type="button" class="avm-choice-item @(selected ? "is-selected" : "")" role="radio" aria-checked="@(selected ? "true" : "false")" @onclick="() => Pick(item.Value)">
            <span class="avm-choice-title">@item.Title</span>
            @if (!string.IsNullOrWhiteSpace(item.Note))
            {
                <span class="avm-choice-note">@item.Note</span>
            }
        </button>
    }
</div>

@code {
    public sealed record Choice(string Value, string Title, string? Note = null);

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<Choice> Items { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task Pick(string value) => ValueChanged.InvokeAsync(value);
}
