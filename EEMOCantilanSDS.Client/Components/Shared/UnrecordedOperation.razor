@using EEMOCantilanSDS.Domain.Common

@* The body of a Monthly Income line whose collections StallTrack does not record yet: a plain "not recorded" state and
   the line's policy. It records, estimates and lists nothing itself — no sample rows, no entry form, no collector,
   payor or accountable-form management (those stay in Collectors, Payors and Accountable Forms). *@
<div class="uo-layout">
    <section class="v3-panel" aria-labelledby="@_titleId">
        <header class="v3-panel-header">
            <h2 id="@_titleId">Collection</h2>
            <span class="v3-panel-meta">@PhilippineTime.Today.ToString("dddd, MMMM d, yyyy")</span>
        </header>
        <div class="v3-panel-body uo-unavailable">
            <div class="v3-empty-block" role="status">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                <strong>@Name collections aren't recorded in StallTrack yet</strong>
                <p>@Detail Nothing is estimated or entered on this page in the meantime.</p>
            </div>
        </div>
        @if (Assignable)
        {
            <p class="v3-panel-note uo-note">
                Collectors can already be assigned this operation in <a href="/collectors">Collectors</a>. Assignment is
                permission only; Collector Mobile shows it as not yet collectible until a writer is approved.
            </p>
        }
    </section>

    @if (SemanticCode is not null)
    {
        <RevenuePolicyPanel SemanticCode="@SemanticCode" />
    }
    else if (Policy is not null)
    {
        @Policy
    }
</div>

@code {
    private readonly string _titleId = $"uo-{Guid.NewGuid():N}";

    /// <summary>The Monthly Income line name as the sheet shows it.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>One sentence on what will appear here once the line is recorded.</summary>
    [Parameter, EditorRequired] public string Detail { get; set; } = string.Empty;

    /// <summary>Revenue classification to read the effective policy from; omit when the line has none.</summary>
    [Parameter] public string? SemanticCode { get; set; }

    /// <summary>Policy panel content when there is no single classification to read (e.g. contextual policy).</summary>
    [Parameter] public RenderFragment? Policy { get; set; }

    /// <summary>True when the line is a collector operation assignable in Collectors (CollectorOperationCodes).</summary>
    [Parameter] public bool Assignable { get; set; }
}
