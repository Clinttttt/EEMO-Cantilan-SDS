@* Operation workspaces return to Operations; child pages name their explicit parent.
   Markup and classes are the ones the facility pages use, so an obligation operation reads like the rest. *@
@implements IDisposable
@using EEMOCantilanSDS.Client.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (OperationCode is not null)
{
    <PageTitle>StallTrack — @ShownTitle</PageTitle>
}
<header class="topbar operation-context">
    <div class="topbar-left flex gap-2">
        <a href="@BackHref" class="tcc-back-btn" aria-label="@($"Back to {BackTitle}")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </a>
        <div>
            <div class="topbar-title">@ShownTitle</div>
            <div class="topbar-breadcrumb">
                <a href="/menu" class="breadcrumb-link">Dashboard</a>
                @if (!BackHref.StartsWith("/monitoring/", StringComparison.Ordinal))
                {
                    <span class="breadcrumb-sep">/</span>
                    <a href="/operations" class="breadcrumb-link">Operations</a>
                }
                @if (ParentHref is not null && ParentHref != "/operations")
                {
                    <span class="breadcrumb-sep">/</span>
                    <a href="@ParentHref" class="breadcrumb-link">@BackTitle</a>
                }
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-active">@Crumb — @PhilippineTime.Now.ToString("MMMM yyyy")</span>
            </div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @PhilippineTime.Now.ToString("MMMM d, yyyy")
        </div>
        <AccountChip />
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>
    /// The stable operation code this page is the workspace of. When given, the title is the municipality's own name for the operation
    /// (falling back to <see cref="Title"/>, the established wording, when none applies). Presentation only.
    /// </summary>
    [Parameter] public string? OperationCode { get; set; }

    private OperationNameService? _names;
    private string BackHref => ParentHref ?? "/operations";
    private string BackTitle => ParentTitle is not null && OperationCode is not null && BackHref.StartsWith("/operations/", StringComparison.Ordinal)
        ? _names?.NameFor(OperationCode, ParentTitle) ?? ParentTitle : ParentTitle ?? "Operations";
    private string ShownTitle => _names is not null && OperationCode is not null ? _names.NameFor(OperationCode, Title) : Title;

    protected override async Task OnInitializedAsync()
    {
        if (OperationCode is null) return;
        // Resolved optionally so a page rendered without the service (a test, a preview) simply shows its own title.
        _names = Services.GetService<OperationNameService>();
        if (_names is null) return;
        _names.Changed += OnNamesChanged;
        await _names.EnsureLoadedAsync();
    }

    private void OnNamesChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_names is not null) _names.Changed -= OnNamesChanged;
    }
    [Parameter, EditorRequired] public string Crumb { get; set; } = string.Empty;
    [Parameter] public string? ParentHref { get; set; }
    [Parameter] public string? ParentTitle { get; set; }
}
