@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@*
    Sends an administrator to the change-password screen while the office-issued password is still in place.

    The API is the real gate — it refuses every other endpoint until the password is changed, so this component is the
    experience rather than the security. Without it the portal would render normally and then fail every request with 403,
    which reads as a broken system rather than an instruction.

    Renders nothing. Mounted from MainLayout beside the session guard and the two-factor reminder, following the same pattern:
    a small component that watches one condition and stays silent otherwise.
*@

@code {
    /// <summary>The claim the API sets from the account's flag; carried into the cookie at sign-in.</summary>
    private const string MustChangeClaim = "must_change_password";

    private const string ChangePasswordPath = "/change-password";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated != true) return;

        if (!bool.TryParse(user.FindFirst(MustChangeClaim)?.Value, out var required) || !required) return;

        // Already there — never navigate to the page from the page, which would loop.
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path.StartsWith("change-password", StringComparison.OrdinalIgnoreCase)) return;

        // ?required=1 tells the page to explain WHY the user is there and to withhold Cancel: there is nowhere to cancel to
        // while the API is refusing everything else.
        Navigation.NavigateTo($"{ChangePasswordPath}?required=1", forceLoad: false);
    }
}
