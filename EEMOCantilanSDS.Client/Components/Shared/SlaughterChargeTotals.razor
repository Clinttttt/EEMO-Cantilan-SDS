@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Application.Dtos.Slaughterhouse
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IGovernedServicesApiClient GovernedApi

@* Slaughterhouse collected by approved charge, for a period: the server's own totals per charge (the amounts frozen on each collection).
   Each charge states the animals it is approved for, so two charges of the same name (a Hog Slaughter Fee and a Cow one) read apart.
   Per-head collections appear on one line, "not itemized", so the table adds up to the same figure as the register and the official
   Monthly Income. Hidden when no collection in the period used a charge. *@
@if (_totals is { Count: > 0 } totals && totals.Any(t => t.FeeOptionId is not null))
{
    <section class="v3-report-section" aria-labelledby="@HeadingId">
        <h3 id="@HeadingId">By charge</h3>
        <div class="v3-table-wrap">
            <table class="v3-report-table">
                <thead>
                    <tr>
                        <th scope="col">Charge</th>
                        <th scope="col">Animals</th>
                        <th scope="col" class="v3-num">Quantity</th>
                        <th scope="col" class="v3-num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var total in totals)
                    {
                        <tr>
                            <td>@total.Name</td>
                            <td>@AnimalsFor(total.FeeOptionId)</td>
                            <td class="v3-num">@(total.Quantity is { } q ? q.ToString("N0", CultureInfo.InvariantCulture) : "—")</td>
                            <td class="v3-num">₱@total.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Total</th>
                        <td></td>
                        <td></td>
                        <td class="v3-num">₱@totals.Sum(t => t.Amount).ToString("N2", CultureInfo.InvariantCulture)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public DateOnly From { get; set; }
    [Parameter, EditorRequired] public DateOnly To { get; set; }
    [Parameter] public string HeadingId { get; set; } = "slh-by-charge";
    /// <summary>The office's own names for the animals; the standard names when not given.</summary>
    [Parameter] public SlaughterAnimalLabelsDto? Labels { get; set; }

    private IReadOnlyList<FeeOptionTotalDto>? _totals;
    private Dictionary<Guid, int?> _scopes = [];
    private DateOnly _loadedFrom, _loadedTo;

    protected override async Task OnParametersSetAsync()
    {
        if (_totals is not null && _loadedFrom == From && _loadedTo == To) return;
        _loadedFrom = From;
        _loadedTo = To;
        try
        {
            var result = await GovernedApi.GetFeeOptionTotalsAsync(CollectorOperationCodes.Slaughterhouse, From, To);
            _totals = result is { IsSuccess: true, Value: { } rows } ? rows : [];
        }
        catch { _totals = []; }

        if (_scopes.Count == 0 && _totals.Any(t => t.FeeOptionId is not null))
        {
            try
            {
                var options = await GovernedApi.GetFeeOptionsAsync(CollectorOperationCodes.Slaughterhouse);
                if (options is { IsSuccess: true, Value: { } list })
                    _scopes = list.ToDictionary(o => o.Id, o => o.ApplicableAnimals);
            }
            catch { /* the charges still read; only their animals are left unstated */ }
        }
    }

    /// <summary>The animals a charge is approved for; "—" for the per-head line and for a charge the list does not name.</summary>
    private string AnimalsFor(Guid? feeOptionId)
    {
        if (feeOptionId is not { } id || !_scopes.TryGetValue(id, out var stored)) return "—";
        if (stored is null or 0) return "All animals";
        var names = new List<string>();
        if ((stored.Value & (int)SlaughterAnimalScope.Hog) != 0) names.Add(Labels?.Hog ?? "Hog");
        if ((stored.Value & (int)SlaughterAnimalScope.Carabao) != 0) names.Add(Labels?.Carabao ?? "Carabao");
        if ((stored.Value & (int)SlaughterAnimalScope.Cow) != 0) names.Add(Labels?.Cow ?? "Cow");
        if ((stored.Value & (int)SlaughterAnimalScope.Other) != 0) names.Add("Others");
        return string.Join(", ", names);
    }
}
