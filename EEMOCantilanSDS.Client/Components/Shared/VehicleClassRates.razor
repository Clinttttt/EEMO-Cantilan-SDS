@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using Microsoft.AspNetCore.Components.Authorization
@inject IVehicleClassesApiClient VehicleClassesApi

@* The vehicle classes Transportation / Parking is collected by, and each class's approved rate (IA-030, IA-050). The Head
   defines them; Head and Admin read them. A rate applies from its effective date and is never retroactive, and a class
   with no rate in force is not offered to a collector. *@
<section class="v3-panel" aria-labelledby="@_titleId" aria-busy="@(_loading ? "true" : "false")">
    <header class="v3-panel-header">
        <h2 id="@_titleId">Vehicle classes and rates</h2>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="v3-notice v3-notice-error vcr-notice" role="alert">@_error</p>
    }

    <div class="v3-table-wrap" role="region" aria-label="Vehicle classes" tabindex="0">
        <table class="v3-table">
            <caption class="v3-sr-only">Vehicle classes with the approved rate in force today</caption>
            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col" class="v3-num">Approved rate</th>
                    <th scope="col">Since</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="v3-sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in _classes)
                {
                    <tr>
                        <td class="v3-strong">@vehicle.DisplayName<span class="v3-block">@vehicle.Code</span></td>
                        <td class="v3-num">@(vehicle.CurrentAmount is { } amount ? $"₱{amount:N2}" : "No rate in force")</td>
                        <td>@(vehicle.CurrentEffectiveDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "—")</td>
                        <td>@(vehicle.IsActive ? "Active" : "Retired")</td>
                        <td>
                            <AuthorizeView Roles="SuperAdmin">
                                <Authorized>
                                    <button class="v3-btn v3-btn-sm" type="button" @onclick="() => Edit(vehicle)">Change rate</button>
                                    <button class="v3-btn v3-btn-sm" type="button" @onclick="() => ToggleAsync(vehicle)">@(vehicle.IsActive ? "Retire" : "Restore")</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
                @if (_classes.Count == 0)
                {
                    <tr><td class="v3-empty" colspan="5">@(_loading ? "Loading vehicle classes…" : _error is not null ? "Vehicle classes are unavailable." : "No vehicle class has been defined yet.")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <form class="vcr-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-label="Define a vehicle class rate">
                <label class="v3-field"><span>Code</span>
                    <input class="v3-input" type="text" maxlength="40" required placeholder="e.g. JEEPNEY" @bind="_code" readonly="@_editing" /></label>
                <label class="v3-field"><span>Display name</span>
                    <input class="v3-input" type="text" maxlength="80" required @bind="_name" /></label>
                <label class="v3-field"><span>Effective from</span>
                    <input class="v3-input" type="date" required @bind="_effective" /></label>
                <label class="v3-field"><span>Approved rate (₱)</span>
                    <input class="v3-input" type="number" min="0.01" step="0.01" required @bind="_amount" /></label>
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <p class="v3-notice v3-notice-error" role="alert">@_formError</p>
                }
                <p class="vcr-note">A new rate applies from its effective date. Collections already posted keep the rate they were charged, and earlier trips are never re-priced or given a class.</p>
                <div class="vcr-actions">
                    @if (_editing)
                    {
                        <button class="v3-btn" type="button" @onclick="Reset">Cancel</button>
                    }
                    <button class="v3-btn v3-btn-primary" type="submit" disabled="@_saving">@(_editing ? "Save new rate" : "Add class")</button>
                </div>
            </form>
        </Authorized>
    </AuthorizeView>
</section>

@code {
    private readonly string _titleId = $"vcr-{Guid.NewGuid():N}";
    private List<VehicleClassDto> _classes = [];
    private bool _loading = true;
    private bool _saving;
    private bool _editing;
    private string? _error;
    private string? _formError;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private DateOnly _effective = PhilippineTime.Today;
    private decimal? _amount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await VehicleClassesApi.GetAsync();
            if (result.IsSuccess) _classes = result.Value?.ToList() ?? [];
            else { _classes = []; _error = "Vehicle classes couldn't be loaded."; }
        }
        catch { _classes = []; _error = "Vehicle classes couldn't be loaded."; }
        finally { _loading = false; }
    }

    private void Edit(VehicleClassDto vehicle)
    {
        _editing = true;
        _formError = null;
        _code = vehicle.Code;
        _name = vehicle.DisplayName;
        _amount = vehicle.CurrentAmount;
        _effective = PhilippineTime.Today.AddDays(1);
    }

    private void Reset()
    {
        _editing = false;
        _formError = null;
        _code = _name = string.Empty;
        _amount = null;
        _effective = PhilippineTime.Today;
    }

    private async Task SaveAsync()
    {
        if (_saving || _amount is not > 0m) return;
        _saving = true;
        _formError = null;
        try
        {
            var result = await VehicleClassesApi.SaveAsync(new SaveVehicleClassRequest(_code, _name, _effective, _amount.Value));
            if (!result.IsSuccess) { _formError = result.Error ?? "The rate could not be saved."; return; }
            Reset();
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ToggleAsync(VehicleClassDto vehicle)
    {
        _error = null;
        var result = await VehicleClassesApi.SetActiveAsync(vehicle.Id, !vehicle.IsActive);
        if (!result.IsSuccess) { _error = result.Error ?? "The change could not be saved."; return; }
        await LoadAsync();
    }
}
