@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IObligationsApiClient ObligationsApi
@inject IEcfCollectionsApiClient CollectionsApi
@inject IBusinessPayorsApiClient PayorsApi

@* The body of a specialized obligation line (IA-050): Fish/Meat Vendor Fee, Kanmanggay space rental, Fiesta/Araw lot
   rental. The Head opens an account and approves its amount; the register shows what was assessed, collected and is
   still owed. Money is never recorded here: it is collected on an Official Receipt in Current Collection, and the
   balance is only what canonical allocations say. *@
@if (SpaceExperience)
{
    <FacilityHero Title="@Name" Eyebrow="@(Kind == ObligationKind.FiestaArawLotRental ? "OPERATION · EVENT LOT RENTAL" : "OPERATION · SPACE RENTAL")" Stats="SpaceStats" ShowProgress="true" ProgressPercentage="@CollectionRate">
        <Icon><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg></Icon>
    </FacilityHero>
    <Toolbar SearchQuery="@_search"
             OnSearch="v => _search = v"
             ActiveFilter="@_filter"
             OnFilterChanged="v => _filter = v"
             Filters="@StatusFilters"
             SearchPlaceholder="@($"Search {SubjectNoun.ToLowerInvariant()} no. or occupant…")"
             MiddleContent="@ActionBarContent" />
}
<div class="obw-layout">
    <section class="v3-panel" aria-labelledby="@_accountsTitleId" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="@_accountsTitleId">@(ReadOnlyHistory ? "Historical accounts" : SpaceExperience ? (_holders ? "Space Holders" : $"All {SubjectNoun}s") : $"{Name} accounts")</h2>
            <AuthorizeView Roles="SuperAdmin">
                <Authorized>
                    @if (!_opening && !SpaceExperience && !ReadOnlyHistory)
                    {
                        <button class="v3-btn v3-btn-sm" type="button" @onclick="OpenForm">Open account</button>
                    }
                </Authorized>
            </AuthorizeView>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="obw-retry" role="alert">
                <p class="v3-notice v3-notice-error">@_error</p>
                <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }

        <div class="v3-table-wrap" role="region" aria-label="@($"{Name} accounts")" tabindex="0">
            <table class="v3-table">
                <caption class="v3-sr-only">@Name accounts with approved amount, assessed, collected and remaining</caption>
                <thead>
                    <tr>
                        <th scope="col">Payor</th>
                        <th scope="col">@SubjectNoun</th>
                        @if (SpaceExperience && _holders) { <th scope="col">Start date</th><th scope="col">Status</th> }
                        <th scope="col" class="v3-num">@AmountHeading</th>
                        <th scope="col" class="v3-num">Assessed</th>
                        <th scope="col" class="v3-num">Collected</th>
                        <th scope="col" class="v3-num">Remaining</th>
                        <th scope="col"><span class="v3-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in VisibleAccounts)
                    {
                        <tr>
                            <td class="v3-strong">@(account.PayerName ?? "—")</td>
                            <td>@account.SubjectLabel@if (account.Kind == ObligationKind.FiestaArawLotRental && account.Event is { } lotEvent)
                            {<span class="v3-block">@LotLabel(account)</span>}
                            else if (account.ActiveTo is { } ended) {<span class="v3-block">Ended @ended.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>}</td>
                            @if (SpaceExperience && _holders)
                            {
                                <td>@account.ActiveFrom.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                                <td><span class="obw-status">@(account.ActiveTo is not null ? "Closed" : "Active")</span></td>
                            }
                            <td class="v3-num">@(account.CurrentAmount is { } amount ? Money(amount) : "—")</td>
                            <td class="v3-num">@Money(account.AssessedToDate)</td>
                            <td class="v3-num">@Money(account.CollectedToDate)</td>
                            <td class="v3-num v3-strong">@Money(account.OutstandingToDate)</td>
                            <td class="obw-actions">
                                <button class="v3-btn v3-btn-sm" type="button" aria-expanded="@(_selected == account.Id ? "true" : "false")"
                                        @onclick="() => ToggleRegisterAsync(account.Id)">Periods</button>
                                <AuthorizeView Roles="SuperAdmin">
                                    <Authorized>
                                        @if (!ReadOnlyHistory && account.Kind != ObligationKind.FiestaArawLotRental && account.ActiveTo is null)
                                        {
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => OpenRate(account)">Change amount</button>
                                        }
                                        @if (!ReadOnlyHistory && account.ActiveTo is null)
                                        {
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => CloseAsync(account.Id)">@(SpaceExperience ? "Close account" : "End")</button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                        @if (_selected == account.Id)
                        {
                            <tr class="obw-register-row">
                                <td colspan="@(_holders ? 9 : 7)">
                                    <table class="v3-table obw-register" aria-label="@($"{account.SubjectLabel} periods")">
                                        <thead>
                                            <tr>
                                                <th scope="col">Period</th>
                                                <th scope="col" class="v3-num">Assessed</th>
                                                <th scope="col" class="v3-num">Collected</th>
                                                <th scope="col" class="v3-num">Remaining</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var period in _register)
                                            {
                                                <tr>
                                                    <td>@PeriodLabel(account, period)</td>
                                                    <td class="v3-num">@Money(period.AssessedAmount)</td>
                                                    <td class="v3-num">@Money(period.SettledAmount)</td>
                                                    <td class="v3-num v3-strong">@Money(period.OutstandingAmount)</td>
                                                </tr>
                                            }
                                            @if (_register.Count == 0)
                                            {
                                                <tr><td class="v3-empty" colspan="4">@(_registerLoading ? "Loading periods…" : "No period is billable yet.")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                    @if (!VisibleAccounts.Any())
                    {
                        <tr>
                            <td class="v3-empty" colspan="@(_holders ? 9 : 7)">
                                @if (_loading) { <span role="status">Loading accounts…</span> }
                                else if (_error is not null) { <span>Accounts are unavailable.</span> }
                                else { <span>No @(SubjectNoun == "Lot" ? "lots" : "spaces") found.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_accounts.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="@(_holders ? 5 : 3)"><strong>Total</strong></td>
                            <td class="v3-num v3-strong">@Money(_workspace?.Assessed ?? _accounts.Sum(x => x.AssessedToDate))</td>
                            <td class="v3-num v3-strong">@Money(_workspace?.Collected ?? _accounts.Sum(x => x.CollectedToDate))</td>
                            <td class="v3-num v3-strong">@Money(_workspace?.Outstanding ?? _accounts.Sum(x => x.OutstandingToDate))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>

</div>

<AuthorizeView Roles="SuperAdmin">
    <Authorized>
        <AddNewDrawer Show="@(_opening && !ReadOnlyHistory)" Title="@($"Open {Name} account")" Subtitle="@OpenSubtitle"
                      FormId="obw-open-form" FormLabel="Open account" SubmitText="Open account" Saving="_saving" Error="@_formError"
                      OnSubmit="CreateAsync" OnCancel="CloseForm">
            @if (Kind == ObligationKind.FishMeatVendorFee)
            {
                <AddNewSection Title="NPM Fish / Meat stall" Plain="true">
                    <div class="avm-group">
                        <label class="avm-label" for="obw-stall">Stall <span class="avm-req">*</span></label>
                        <select id="obw-stall" class="avm-input" @bind="_stallId" required>
                            <option value="">Choose a stall</option>
                            @foreach (var stall in _stalls.Where(x => !x.HasAccount))
                            {
                                <option value="@stall.StallId" disabled="@(stall.PayorId is null)">
                                    @stall.StallNo · @stall.Section · @(stall.PayerName ?? "occupant not linked to a Payor")
                                </option>
                            }
                        </select>
                        <span class="avm-hint">The Payor is the one linked to the stall's occupant in NPM.</span>
                    </div>
                </AddNewSection>
            }
            else
            {
                <AddNewSection Title="@(Kind == ObligationKind.FiestaArawLotRental ? "Event & Occupant Information" : "Occupant Information")" Plain="true">
                    <div class="avm-group">
                        <label class="avm-label">@(Kind == ObligationKind.FiestaArawLotRental ? "Event" : "Basis of Occupancy") <span class="avm-req">*</span></label>
                        @if (Kind == ObligationKind.FiestaArawLotRental)
                        {
                            <ChoiceCards Label="Event" Items="EventChoices" Value="@(((int)_lotEvent).ToString())" ValueChanged="PickEvent" />
                        }
                        else
                        {
                            <ChoiceCards Label="Basis of occupancy" Items="BasisChoices" Value="@(_signedContract ? "signed" : "space")" ValueChanged="PickBasis" />
                        }
                    </div>
                    <div class="avm-row-2">
                        @* The occupant is the Business Payor the account is held in. It is chosen from the server's list, never matched from the typed name. *@
                        <div class="avm-group">
                            <label class="avm-label">Actual Occupant <span class="avm-req">*</span></label>
                            @if (SelectedPayor is { } chosen)
                            {
                                <div class="obw-selected" role="status">
                                    <span class="obw-selected-name">@chosen.DisplayName</span>
                                    <button class="obw-link" type="button" @onclick="ClearPayor">Change</button>
                                </div>
                            }
                            else
                            {
                                <input class="avm-input" type="search" aria-label="Search occupants" placeholder="Search by name" @bind="_payorSearch" @bind:event="oninput" @onkeyup="SearchPayorsAsync" />
                                @if (_payors.Count > 0)
                                {
                                    <ul class="obw-results" role="listbox" aria-label="Business Payors found">
                                        @foreach (var payor in _payors)
                                        {
                                            <li><button class="obw-option" type="button" role="option" aria-selected="false" @onclick="() => _payorId = payor.PayorId.ToString()">@payor.DisplayName</button></li>
                                        }
                                    </ul>
                                }
                                @if (_payors.Count == 0 && _payorSearch.Trim().Length >= 2)
                                {
                                    <span class="avm-hint">No Business Payor found.</span>
                                }
                                @if (_payorSearch.Trim().Length >= 2)
                                {
                                    <button class="obw-link" type="button" @onclick="CreatePayorAsync" disabled="@_saving">Create Business Payor “@_payorSearch.Trim()”</button>
                                }
                            }
                        </div>
                        @if (Kind == ObligationKind.KanmanggaySpaceRental)
                        {
                            <div class="avm-group">
                                <label class="avm-label">Contract reference</label>
                                @if (_signedContract)
                                {
                                    <input class="avm-input" type="text" maxlength="200" placeholder="As written on the contract" @bind="_contractRef" />
                                }
                                else
                                {
                                    <div class="avm-input avm-input-locked">No contract (space only)</div>
                                }
                            </div>
                        }
                    </div>
                </AddNewSection>

                <AddNewSection Title="@(Kind == ObligationKind.FiestaArawLotRental ? "Lot & Event Details" : "Space & Contract Details")" Plain="true">
                    <div class="avm-row-2">
                        <div class="avm-group">
                            <label class="avm-label">Operation</label>
                            <div class="avm-input avm-input-locked">@(Kind == ObligationKind.FiestaArawLotRental ? EventChoices.FirstOrDefault(x => x.Value == ((int)_lotEvent).ToString())?.Title ?? Name : Name)</div>
                        </div>
                        <div class="avm-group">
                            @* Left blank, the number is assigned by the server within this operation; it is never worked out here. *@
                            <label class="avm-label" for="obw-subject">@(SubjectNoun == "Lot" ? "Lot No." : "Space No.")</label>
                            <input id="obw-subject" class="avm-input" type="text" maxlength="120" placeholder="Assigned automatically" @bind="_subject" />
                        </div>
                    </div>
                    <div class="avm-row-2">
                        @if (Kind == ObligationKind.FiestaArawLotRental)
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-event-date">Event date <span class="avm-req">*</span></label>
                                <input id="obw-event-date" class="avm-input" type="date" required @bind="_eventDate" />
                            </div>
                            <div class="avm-group">
                                <label class="avm-label" for="obw-amount">Approved lot amount (₱) <span class="avm-req">*</span></label>
                                <input id="obw-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                            </div>
                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-start">@(_signedContract ? "Contract Effectivity (month)" : "Occupying Since (month)") <span class="avm-req">*</span></label>
                                <input id="obw-start" class="avm-input" type="month" required aria-label="Start month" value="@_startMonth" @onchange="e => _startMonth = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="avm-group">
                                <label class="avm-label" for="obw-amount">Approved monthly rental (₱) <span class="avm-req">*</span></label>
                                <input id="obw-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                            </div>
                        }
                    </div>
                </AddNewSection>
            }
        </AddNewDrawer>

        <AddNewDrawer Show="@(!_opening && _rateFor is not null && !ReadOnlyHistory)" Edit="true" Title="Change approved amount" Subtitle="@_rateFor?.SubjectLabel"
                      FormId="obw-rate-form" FormLabel="Change approved amount" SubmitText="Save amount" Saving="_saving" Error="@_formError"
                      OnSubmit="SaveRateAsync" OnCancel="CloseForm">
            <AddNewSection Title="New amount" Plain="true">
                <div class="avm-row-2">
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-month">Effective from (month) <span class="avm-req">*</span></label>
                        <input id="obw-rate-month" class="avm-input" type="month" required aria-label="Effective from (month)" value="@_rateMonth" @onchange="e => _rateMonth = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-amount">Approved monthly amount (₱) <span class="avm-req">*</span></label>
                        <input id="obw-rate-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                    </div>
                </div>
            </AddNewSection>
        </AddNewDrawer>
    </Authorized>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(_saved))
{
    <p class="v3-notice" role="status">@_saved</p>
}

@code {
    private readonly string _accountsTitleId = $"obw-a-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public ObligationKind Kind { get; set; }

    /// <summary>The line's name as the Monthly Income sheet shows it.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>What an account is for: Stall, Space or Lot.</summary>
    [Parameter, EditorRequired] public string SubjectNoun { get; set; } = string.Empty;
    [Parameter] public bool SpaceExperience { get; set; }
    [Parameter] public bool ReadOnlyHistory { get; set; }
    [Parameter] public string? ReportsHref { get; set; }

    /// <summary>The bulk-import page for this line; the Import list action is offered only when there is one.</summary>
    [Parameter] public string? ImportHref { get; set; }
    private ObligationWorkspaceDto? _workspace;
    private string _search = string.Empty, _filter = "All";
    private bool _holders;
    private static readonly List<string> StatusFilters = new() { "All", "Paid", "Partial", "Unpaid", "Closed" };
    private double CollectionRate => _workspace is { Assessed: > 0m } w ? (double)Math.Min(100m, Math.Round(w.Collected / w.Assessed * 100m, 0)) : 0;
    private RenderFragment ActionBarContent => @<div class="obw-actions-bar">
        <button class="btn-outline" type="button" @onclick="() => _holders = true">@(SubjectNoun == "Lot" ? "Lot / Space Holder List" : "Space Holder List")</button>
        <button class="btn-outline" type="button" @onclick="() => _holders = false">Manage Space Holders</button>
        <a class="btn-outline" href="@ReportsHref">Reports</a>
        <AuthorizeView Roles="SuperAdmin"><Authorized>
            @if (!string.IsNullOrWhiteSpace(ImportHref)) { <a class="btn-outline" href="@ImportHref">Import list</a> }
            <button class="btn-primary" type="button" @onclick="OpenForm">+ Add New</button>
        </Authorized></AuthorizeView>
    </div>;
    private List<FacilityHero.HeroStat> SpaceStats => [
        new() { Label = "Collected", Value = _workspace is null ? "—" : Money(_workspace.Collected) },
        new() { Label = "Remaining", Value = _workspace is null ? "—" : Money(_workspace.Outstanding) },
        new() { Label = $"Total {SubjectNoun.ToLowerInvariant()}s", Value = _accounts.Count.ToString(CultureInfo.InvariantCulture) }];
    private IEnumerable<ObligationAccountDto> VisibleAccounts => _accounts.Where(a =>
        (!SpaceExperience || (_filter == "Closed" ? a.ActiveTo is not null : a.ActiveTo is null))
        && (!SpaceExperience || _filter switch
        {
            "Paid" => a.AssessedToDate > 0m && a.OutstandingToDate == 0m,
            "Partial" => a.CollectedToDate > 0m && a.OutstandingToDate > 0m,
            "Unpaid" => a.CollectedToDate == 0m,
            _ => true
        })
        && (string.IsNullOrWhiteSpace(_search) || a.SubjectLabel.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (a.PayerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)));

    private string AmountHeading => Kind == ObligationKind.FiestaArawLotRental ? "Approved amount" : "Approved monthly";

    private List<ObligationAccountDto> _accounts = [];
    private List<ObligationQuoteDto> _register = [];
    private List<VendorFeeStallDto> _stalls = [];
    private List<CollectionPayorDto> _payors = [];
    private bool _loading = true;
    private bool _registerLoading;
    private string? _error;
    private Guid? _selected;

    private bool _opening;
    private ObligationAccountDto? _rateFor;
    private bool _saving;
    private bool _signedContract = true;
    private string _contractRef = string.Empty;
    private CollectionPayorDto? SelectedPayor => _payors.FirstOrDefault(x => x.PayorId.ToString() == _payorId);
    private void ClearPayor() { _payorId = string.Empty; _payorSearch = string.Empty; _payors = []; }
    private string? _formError;
    private string? _saved;
    private string _payorSearch = string.Empty;
    private string _payorId = string.Empty;
    private string _stallId = string.Empty;
    private string _subject = string.Empty;
    private LotRentalEvent _lotEvent = LotRentalEvent.Fiesta;
    private DateOnly _eventDate = PhilippineTime.Today;
    private string _startMonth = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private string _rateMonth = PhilippineTime.Today.AddMonths(1).ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private decimal? _amount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (SpaceExperience)
            {
                var workspace = await ObligationsApi.GetWorkspaceAsync(Kind);
                _workspace = workspace.IsSuccess ? workspace.Value : null;
                _accounts = _workspace?.Accounts.ToList() ?? [];
                if (!workspace.IsSuccess) _error = workspace.Error ?? $"{Name} accounts couldn't be loaded.";
                return;
            }
            var result = await ObligationsApi.GetAccountsAsync(Kind);
            if (result.IsSuccess) _accounts = result.Value?.ToList() ?? [];
            else { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        }
        catch { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        finally { _loading = false; }
    }

    private async Task ToggleRegisterAsync(Guid accountId)
    {
        if (_selected == accountId) { _selected = null; return; }
        _selected = accountId;
        _register = [];
        _registerLoading = true;
        try
        {
            var result = await ObligationsApi.GetRegisterAsync(accountId);
            _register = result.IsSuccess ? result.Value?.ToList() ?? [] : [];
        }
        catch { _register = []; }
        finally { _registerLoading = false; }
    }

    private async Task OpenForm()
    {
        _formError = null; _saved = null; _rateFor = null;
        _payorSearch = _payorId = _stallId = _subject = _contractRef = string.Empty;
        _signedContract = true; _lotEvent = LotRentalEvent.Fiesta;
        _payors = [];
        _amount = null;
        _opening = true;
        if (Kind == ObligationKind.FiestaArawLotRental && _operations.Count == 0) await LoadOperationsAsync();
        if (Kind == ObligationKind.FishMeatVendorFee)
        {
            try
            {
                var stalls = await ObligationsApi.GetVendorStallsAsync();
                _stalls = stalls.IsSuccess ? stalls.Value?.ToList() ?? [] : [];
                if (!stalls.IsSuccess) _formError = "The NPM Fish and Meat stalls couldn't be loaded.";
            }
            catch { _stalls = []; _formError = "The NPM Fish and Meat stalls couldn't be loaded."; }
        }
    }

    private void OpenRate(ObligationAccountDto account)
    {
        _formError = null; _saved = null; _opening = false;
        _rateFor = account;
        _amount = account.CurrentAmount;
    }

    private void CloseForm() { _opening = false; _rateFor = null; _formError = null; }

    private string OpenSubtitle => Kind == ObligationKind.FiestaArawLotRental
        ? "A lot for an event, with the approved amount."
        : Kind == ObligationKind.FishMeatVendorFee ? "A vendor stall with its approved monthly amount." : "A space with its approved monthly amount.";

    /// <summary>Creates a Business Payor from the typed name, only on the office's press, and selects it. A same-named Payor is never reused silently.</summary>
    private async Task CreatePayorAsync()
    {
        var name = _payorSearch.Trim();
        if (name.Length < 2 || _saving) return;
        _saving = true;
        _formError = null;
        try
        {
            var result = await PayorsApi.CreatePayorAsync(new CreatePayorRequest(name, BusinessPayorKind.Person));
            if (result.IsSuccess && result.Value is { } created)
            {
                _payors = [new CollectionPayorDto(created.PayorId, created.DisplayName)];
                _payorId = created.PayorId.ToString();
            }
            else if (result.Error?.StartsWith("DUPLICATE_PAYOR", StringComparison.Ordinal) == true)
                _formError = $"A Business Payor named {name} already exists. Choose it from the list instead.";
            else _formError = result.Error ?? "The Business Payor could not be created.";
        }
        catch { _formError = "The Business Payor could not be created."; }
        finally { _saving = false; }
    }

    private async Task SearchPayorsAsync()
    {
        if (_payorSearch.Trim().Length < 2) { _payors = []; return; }
        try
        {
            var result = await CollectionsApi.SearchCollectionPayorsAsync(_payorSearch.Trim());
            _payors = result.IsSuccess ? result.Value?.ToList() ?? [] : [];
        }
        catch { _payors = []; }
    }

    private static readonly IReadOnlyList<ChoiceCards.Choice> BasisChoices =
    [
        new("signed", "Signed lease contract", "Leased under a signed contract"),
        new("space", "No contract (space only)", "Occupies the space without a contract")
    ];

    // Fiesta and Araw are the server's own events; they are read from the approved operations and the enum is only the fallback.
    private IReadOnlyList<SpaceRentalOperationDto> _operations = [];
    private IReadOnlyList<ChoiceCards.Choice> EventChoices
    {
        get
        {
            var events = _operations.Where(x => x.Kind == ObligationKind.FiestaArawLotRental && x.Event is not null).ToList();
            return events.Count > 0
                ? events.Select(x => new ChoiceCards.Choice(((int)x.Event!.Value).ToString(), x.DisplayName)).ToArray()
                : [new(((int)LotRentalEvent.Fiesta).ToString(), "Fiesta"), new(((int)LotRentalEvent.Araw).ToString(), "Araw")];
        }
    }
    private void PickBasis(string value) => _signedContract = value == "signed";
    private void PickEvent(string value) => _lotEvent = (LotRentalEvent)int.Parse(value, CultureInfo.InvariantCulture);

    private async Task LoadOperationsAsync()
    {
        try
        {
            var result = await ObligationsApi.GetSpaceOperationsAsync();
            if (result.IsSuccess) _operations = result.Value?.ToList() ?? [];
        }
        catch { _operations = []; }
    }

    private static bool TryMonthStart(string value, out DateOnly month)
    {
        month = default;
        return DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out month);
    }

    private async Task CreateAsync()
    {
        if (_saving) return;
        _formError = null;
        var isLot = Kind == ObligationKind.FiestaArawLotRental;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        DateOnly start;
        if (isLot) start = _eventDate;
        else if (!TryMonthStart(_startMonth, out start)) { _formError = "Choose the month the account starts."; return; }
        Guid? stallId = null;
        var payorId = Guid.Empty;
        if (Kind == ObligationKind.FishMeatVendorFee)
        {
            if (!Guid.TryParse(_stallId, out var parsedStall)) { _formError = "Choose an NPM Fish or Meat stall."; return; }
            stallId = parsedStall;
        }
        else if (!Guid.TryParse(_payorId, out payorId)) { _formError = "Choose a Business Payor."; return; }

        _saving = true;
        try
        {
            var subject = Kind == ObligationKind.FishMeatVendorFee
                ? _stalls.FirstOrDefault(x => x.StallId == stallId)?.StallNo ?? string.Empty
                : _subject.Trim();
            var result = await ObligationsApi.CreateAccountAsync(new CreateObligationAccountRequest(
                Kind, payorId, stallId, subject, isLot ? _lotEvent : null, isLot ? _eventDate : null, start, _amount!.Value,
                // Occupancy basis is recorded for Kanmanggay only; no contract is implied for a space-only occupancy.
                Kind == ObligationKind.KanmanggaySpaceRental ? (_signedContract ? OccupancyArrangement.SignedContract : OccupancyArrangement.SpaceOnly) : null,
                Kind == ObligationKind.KanmanggaySpaceRental && _signedContract && !string.IsNullOrWhiteSpace(_contractRef) ? _contractRef.Trim() : null));
            if (!result.IsSuccess) { _formError = result.Error ?? "The account could not be opened."; return; }
            _opening = false;
            _saved = $"{Name} account opened.";
            // A holder that was just added must be visible: a Paid / Partial filter or a search left on the list would hide it.
            _filter = "All";
            _search = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task SaveRateAsync()
    {
        if (_saving || _rateFor is null) return;
        _formError = null;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        if (!TryMonthStart(_rateMonth, out var effective)) { _formError = "Choose the month the amount takes effect."; return; }
        _saving = true;
        try
        {
            var result = await ObligationsApi.SetRateAsync(_rateFor.Id, new SetObligationRateRequest(effective, _amount!.Value));
            if (!result.IsSuccess) { _formError = result.Error ?? "The amount could not be saved."; return; }
            _rateFor = null;
            _saved = "Approved amount saved. It applies from its effective month.";
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task CloseAsync(Guid accountId)
    {
        _saved = null;
        var result = await ObligationsApi.CloseAccountAsync(accountId, new CloseObligationAccountRequest(PhilippineTime.Today));
        if (!result.IsSuccess) { _error = result.Error ?? "The account could not be ended."; return; }
        _saved = "Account ended. Its assessed periods and collections are unchanged.";
        await LoadAsync();
    }

    private static string Money(decimal amount) => $"₱{amount:N2}";

    private static string LotLabel(ObligationAccountDto account) =>
        $"{account.Event} · {account.EventDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    private static string PeriodLabel(ObligationAccountDto account, ObligationQuoteDto period) =>
        account.Kind == ObligationKind.FiestaArawLotRental
            ? period.PeriodStart.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            : period.PeriodStart.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
}
