                        </TermField>
                        <Note><div class="avm-section-note">The event date identifies this one-time rental. No monthly lease term is created.</div></Note>
                    </RentalContractFields>
                    <AddNewSection Title="Space Information" Plain="true">
                        <div class="avm-row-2"><div class="avm-group">
