    private static bool TryMonthStart(string value, out DateOnly month)
    {
        month = default;
        return DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out month);
    }

    private Task CreateAsync() => SubmitAccountAsync(false);
    private Task ConfirmAdvanceAsync() => SubmitAccountAsync(true);

    private async Task SubmitAccountAsync(bool confirmed)
    {
        if (_saving || !_opening || ReadOnlyHistory || (confirmed && _advanceRequest is null)) return;
        _formError = null;
        var isLot = Kind == ObligationKind.FiestaArawLotRental;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        DateOnly start;
        if (isLot) start = _eventDate;
        else if (SupportsContractBasis && _signedContract && _contractDate is { } signedOn)
            start = new DateOnly(signedOn.Year, signedOn.Month, 1);
        else if (SupportsContractBasis && _signedContract)
        { _formError = "Choose the contract effectivity date."; return; }
        else if (!TryMonthStart(_startMonth, out start)) { _formError = "Choose the month the account starts."; return; }
        Guid? stallId = null;
        var payorId = Guid.Empty;
        if (Kind == ObligationKind.FishMeatVendorFee)
        {
            if (!Guid.TryParse(_stallId, out var parsedStall)) { _formError = "Choose an NPM Fish or Meat stall."; return; }
            stallId = parsedStall;
        }
        else if (_occupant.Trim().Length < 2) { _formError = Kind == ObligationKind.FiestaArawLotRental ? "Enter the lot holder." : "Enter the actual occupant."; return; }

        var subject = Kind == ObligationKind.FishMeatVendorFee
            ? _stalls.FirstOrDefault(x => x.StallId == stallId)?.StallNo ?? string.Empty
            : ServerAssignedNumber ? string.Empty : _subject.Trim();
        var request = new CreateObligationAccountRequest(
            Kind, payorId, stallId, subject, isLot ? _lotEvent : null, isLot ? _eventDate : null, start, _amount!.Value,
            // Both space and event lot accounts persist basis/reference; event accounts carry no monthly lease metadata.
            SupportsContractBasis || isLot ? (_signedContract ? OccupancyArrangement.SignedContract : OccupancyArrangement.SpaceOnly) : null,
            (SupportsContractBasis || isLot) && _signedContract && !string.IsNullOrWhiteSpace(_contractRef) ? _contractRef.Trim() : null,
            Kind == ObligationKind.FishMeatVendorFee ? null : _occupant.Trim(),
            SupportsContractBasis && _signedContract ? _contractName.Trim() : null,
            SupportsContractBasis && _signedContract && _contractDate is { } contractOn ? DateOnly.FromDateTime(contractOn) : null,
            // Only Cantilan has the confirmed flexible Kanmanggay duration policy; Vegetable/Fruit retains its recorded term.
            Kind == ObligationKind.KanmanggaySpaceRental && _signedContract && !DurationUnconfirmed
                ? (_contractYears > 0 || _contractMonths == 0 ? _contractYears : null)
                : Kind == ObligationKind.VegetableFruitSpaceRental && _signedContract && _contractYears > 0 ? _contractYears : null,
            SupportsContractBasis ? _areaSqm : null,
            SupportsContractBasis ? _areaLocation.Trim() : null,
            SupportsContractBasis && _signedContract ? _contractRate : null,
            ContractMonths: SupportsContractBasis && _signedContract && _contractMonths > 0
                && (Kind == ObligationKind.VegetableFruitSpaceRental || Kind == ObligationKind.KanmanggaySpaceRental && !DurationUnconfirmed) ? _contractMonths : null);
        var today = PhilippineTime.Today;
        var futureMonth = isLot && new DateOnly(start.Year, start.Month, 1) > new DateOnly(today.Year, today.Month, 1);
        if ((futureMonth && !confirmed) || (confirmed && request != _advanceRequest))
        {
            _advanceRequest = request;
            return;
        }
        _saving = true;
        try
        {
            var result = await ObligationsApi.CreateAccountAsync(request);
            if (!result.IsSuccess) { _formError = result.Error ?? "The account could not be opened."; return; }
            _opening = false;
            _saved = isLot ? "Lot account opened successfully." : $"{Name} account opened.";
            // A holder that was just added must be visible: a Paid / Partial filter or a search left on the list would hide it.
            _filter = "All";
            _lifecycle = "Active";
            _search = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; _advanceRequest = null; }
    }

    private bool _changeApprovedAmount;
    private async Task SaveHolderAsync()
    {
        if (_saving || _editFor is not { } account) return;
        _formError = null;
        SetObligationRateRequest? rateChange = null;
        if (_changeApprovedAmount)
        {
            if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
            if (!TryMonthStart(_rateMonth, out var effective)) { _formError = "Choose the month the amount takes effect."; return; }
            rateChange = new(effective, _amount.Value);
        }
        _saving = true;
        try
        {
            var request = new CorrectObligationHolderRequest(_occupant,
                _signedContract ? OccupancyArrangement.SignedContract : OccupancyArrangement.SpaceOnly,
                _signedContract ? _contractRef : null, _signedContract ? _contractName : null,
                _signedContract && _contractDate is { } contractDate ? DateOnly.FromDateTime(contractDate) : null,
                _signedContract && DurationUnconfirmed ? account.ContractYears : _signedContract && _contractYears > 0 ? _contractYears : null,
                _areaSqm, _areaLocation, _signedContract ? _contractRate : null, rateChange,
                _signedContract && DurationUnconfirmed ? account.ContractMonths : _signedContract && _contractMonths > 0 ? _contractMonths : null);
            var result = await ObligationsApi.CorrectHolderAsync(account.Id, request);
            if (!result.IsSuccess) { _formError = result.Error ?? "Holder details could not be saved."; return; }
            _editFor = null;
            _saved = "Space-holder evidence updated with an audit entry. Existing collections and assessments were not changed.";
            await LoadAsync();
        }
        catch { _formError = "Holder details could not be saved."; }
        finally { _saving = false; }
    }

    private async Task SaveRateAsync()
    {
        if (_saving || _rateFor is null) return;
        _formError = null;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        if (!TryMonthStart(_rateMonth, out var effective)) { _formError = "Choose the month the amount takes effect."; return; }
        _saving = true;
        try
        {
            var result = await ObligationsApi.SetRateAsync(_rateFor.Id, new SetObligationRateRequest(effective, _amount!.Value));
            if (!result.IsSuccess) { _formError = result.Error ?? "The amount could not be saved."; return; }
            _rateFor = null;
            _saved = "Approved amount saved. It applies from its effective month.";
            await LoadAsync();
            if (_selected is { } selected) await LoadRegisterAsync(selected);
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private ObligationAccountDto? _closeFor;
    private Task CloseAsync(Guid accountId)
    {
        _closeFor = _accounts.FirstOrDefault(a => a.Id == accountId);
        _formError = null;
        return Task.CompletedTask;
    }
    private void CancelClose() { _closeFor = null; _formError = null; }
    private async Task ConfirmCloseAsync()
    {
        if (_saving || _closeFor is null) return;
        _saving = true;
        _saved = null;
        try
        {
            var result = await ObligationsApi.CloseAccountAsync(_closeFor.Id, new CloseObligationAccountRequest(PhilippineTime.Today));
            if (!result.IsSuccess) { _formError = result.Error ?? "The account could not be ended."; return; }
            _closeFor = null;
            _selected = null;
            _saved = "Account ended. Its assessed periods and collections are unchanged.";
            await LoadAsync();
        }
        catch { _formError = "The account could not be ended."; }
        finally { _saving = false; }
    }

