                          SubmitText="Save changes" Saving="_saving" Error="@_formError"
                          OnSubmit="SaveHolderAsync" OnCancel="CloseForm">
                <RentalLesseeFields Form="RegistrationState" OccupantId="obw-occupant"
                                    ContractNameSupported="true" OccupantPlaceholder="Current space occupant"
