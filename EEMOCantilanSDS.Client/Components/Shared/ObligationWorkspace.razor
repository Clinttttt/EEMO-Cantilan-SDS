    // The peso action is the stall registers' own: a read-only acknowledgement of this month's rental (this event's amount for a lot), from the account's period
    // register and its posted collections. It records nothing; money is posted on Collector Mobile or in Current Collection.
    private Guid _openSession;
    private ObligationAccountDto? _receiptAccount;
    private string _receiptPeriod = "", _receiptSrc = "", _receiptPaid = "", _receiptNote = "";
    private IReadOnlyList<CollectionReceiptModal.ReceiptLine> _receiptLines = [];
    private async Task OpenAccountReceipt(ObligationAccountDto account)
    {
        var lot = account.Kind == ObligationKind.FiestaArawLotRental;
        var month = new DateOnly(PhilippineTime.Today.Year, PhilippineTime.Today.Month, 1);
        decimal due = account.CurrentAmount ?? 0m, paid = 0m; var src = "";
        try
        {
            var register = await ObligationsApi.GetRegisterAsync(account.Id);
            var periods = (register.Value ?? []).Where(p => p.AccountId == account.Id).ToList();
            var period = lot ? periods.OrderBy(p => p.PeriodStart).FirstOrDefault() : periods.FirstOrDefault(p => p.PeriodStart == month);
            if (period is not null) { due = period.AssessedAmount; paid = period.SettledAmount; }
            var payments = await ObligationsApi.GetPaymentsAsync(account.Id);
            var latest = (payments.Value ?? []).Where(p => p.Disposition != "Reversed" && (lot || p.PeriodStart == month)).OrderByDescending(p => p.RecordedAtUtc).FirstOrDefault();
            src = latest?.ReferenceCode ?? "";
        }
        catch { /* the receipt still states the approved amount; the balance is read from the register when it is available */ }
        _receiptPeriod = lot ? $"{account.Event} {account.EventDate:MMM d, yyyy}" : month.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
        _receiptSrc = src;
        _receiptLines = [new(lot ? "Approved Event Amount" : "Monthly Rental", $"₱{due:N2}"), new("Balance Due", $"₱{Math.Max(0m, due - paid):N2}")];
        _receiptPaid = $"₱{paid:N2}";
        _receiptNote = lot ? "This acknowledges receipt of the event lot payment stated above. Keep for your records." : "This acknowledges receipt of the monthly rental payment stated above. Keep for your records.";
        _receiptAccount = account;
    }
    private void CloseReceipt() => _receiptAccount = null;
