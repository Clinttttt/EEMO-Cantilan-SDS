@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using EEMOCantilanSDS.Client.Services
@inject IObligationsApiClient ObligationsApi
@inject NavigationManager Navigation

@* The body of a specialized obligation line (IA-050): Fish/Meat Vendor Fee, Kanmanggay space rental, Fiesta/Araw lot
   rental. The Head opens an account and approves its amount; the register shows what was assessed, collected and is
   still owed. Money is never recorded here: it is collected on an Official Receipt in Current Collection, and the
   balance is only what canonical allocations say. *@
@if (SpaceExperience && !Management)
{
    <div role="region" aria-label="@($"{Name} totals: all registered accounts, including closed accounts, to date")">
    @if (Workspace is { } workspace)
    {
        <RentalWorkspaceHero Workspace="workspace" Stats="SpaceStats" Scope="All accounts · to date"
                             Icon="SpaceIcon" ProgressPercentage="CollectionRate" />
    }
    else
    {
    <FacilityHero Title="@Name" Eyebrow="@(Kind == ObligationKind.FiestaArawLotRental ? "OPERATION · EVENT LOT RENTAL" : "OPERATION · SPACE RENTAL")" Stats="SpaceStats" ShowProgress="true" ProgressPercentage="@CollectionRate">
        <Icon><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg></Icon>
    </FacilityHero>
    }
    </div>
    @AfterHero
}
@if (SpaceExperience)
{
    @if (Management)
    {
        <RentalRegistryHero Title="Spaces &amp; Occupants" Progress="CollectionRate">
            <Figures>
                <V3HeroFigure Label="Registered units" Value="@(_loading || _error is not null ? "—" : _accounts.Count.ToString())" Note="@($"{_accounts.Count(a => a.ActiveTo is null)} active · {_accounts.Count(a => a.ActiveTo is not null)} closed")" />
                <V3HeroFigure Label="Assessed" Value="@(_workspace is null ? "—" : Money(_workspace.Assessed))" Note="All accounts · to date" />
                <V3HeroFigure Label="Collected" Value="@(_workspace is null ? "—" : Money(_workspace.Collected))" Note="All accounts · to date" />
                <V3HeroFigure Label="Remaining" Value="@(_workspace is null ? "—" : Money(_workspace.Outstanding))" Note="All accounts · to date" />
            </Figures>
        </RentalRegistryHero>

    }
    <Toolbar SearchQuery="@_search"
             OnSearch="v => _search = v"
             ActiveFilter="@_filter"
             OnFilterChanged="v => _filter = v"
             Filters="@(Overview ? OverviewFilters : StatusFilters)"
             BeforeSearch="@(Management ? RegistryPicker : null)"
             BeforeFilters="@(Management ? LifecycleFilters : ToolbarMode)"
             FilterLabel="@(Management ? "Payment status" : "Account position")"
             SearchPlaceholder="@($"Search {SubjectNoun.ToLowerInvariant()} no. or occupant…")"
             MiddleContent="@ActionBarContent" />
}
@if (!Management && (Overview || Workspace?.Source is EventLotRentalSource))
{
    <RentalSummaryStrip Title="@(Workspace?.TableTitle ?? "Space Rentals")" Description="@(Kind == ObligationKind.FiestaArawLotRental ? "Event lot rental · account-to-date position" : "Approved monthly rental · account-to-date position")"
                        Available="@(!_loading && _error is null)" StatusScope="Active registrations · account-to-date position"
                        Paid="@_accounts.Count(a => a.ActiveTo is null && PaymentStatus(a) == "Paid")"
                        Unpaid="@_accounts.Count(a => a.ActiveTo is null && PaymentStatus(a) == "Unpaid")"
                        Partial="@_accounts.Count(a => a.ActiveTo is null && PaymentStatus(a) == "Partial")"
                        Collected="@(_workspace is null ? "—" : Money(_workspace.Collected))" />
    @if (_error is not null) { <div role="alert" class="v3-notice v3-notice-error">@_error <button type="button" class="btn-outline" @onclick="LoadAsync">Try again</button></div> }
    <RegisteredRentalTable TItem="ObligationAccountDto" Rows="RentalRows" Unit="@SubjectNoun"
                           AmountLabel="@(Kind == ObligationKind.FiestaArawLotRental ? "Approved event amount" : "Monthly amount")"
                           Loading="_loading" Failed="@(_error is not null)" PaymentTitle="View account periods"
                           OnPayment="OpenAccountPosition" OnHistory="OpenAccountHistory" OnProfile="OpenAccountProfile" />
}
else
{
<div class="obw-layout">
    <section class="v3-panel" aria-labelledby="@_accountsTitleId" aria-busy="@(_loading ? "true" : "false")">
        <header class="v3-panel-header">
            <h2 id="@_accountsTitleId">@(ReadOnlyHistory ? "Historical accounts" : Management ? Name : Workspace?.TableTitle ?? (Overview ? "Space Rentals" : $"{Name} accounts"))</h2>
            @if (SpaceExperience && !_loading && _error is null)
            { <span class="obw-note">@VisibleAccounts.Count() of @_accounts.Count @SubjectNoun.ToLowerInvariant()s shown</span> }
            <AuthorizeView Roles="SuperAdmin">
                <Authorized>
                    @if (!_opening && !SpaceExperience && !ReadOnlyHistory)
                    {
                        <button class="v3-btn v3-btn-sm" type="button" @onclick="OpenForm">Open account</button>
                    }
                </Authorized>
            </AuthorizeView>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="obw-retry" role="alert">
                <p class="v3-notice v3-notice-error">@_error</p>
                <button class="v3-btn v3-btn-sm" type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }

        @if (Management)
        {
            <RentalRegistryTable TItem="ObligationAccountDto" Rows="RentalRows" Unit="@SubjectNoun" RateLabel="@(Kind == ObligationKind.FiestaArawLotRental ? "Approved event amount" : "Monthly Rate")"
                                 Loading="_loading" Failed="@(_error is not null)" OnInspect="a => ToggleRegisterAsync(a.Id)" Actions="RegistryAccountActions" Position="RegistryAccountPosition" />
            @if (_selected is { } selectedId && _accounts.FirstOrDefault(a => a.Id == selectedId) is { } selectedAccount)
            {
                <section class="v3-panel obw-profile" aria-label="Account profile">
                    <header class="v3-panel-header"><h2>@SpaceAccountPresentation.Occupant(selectedAccount) · @selectedAccount.SubjectLabel</h2></header>
                    <dl class="obw-account-facts">
                        <div><dt>Source account</dt><dd>@selectedAccount.Kind · @selectedAccount.Id</dd></div>
                        <div><dt>Effective date</dt><dd>@selectedAccount.ActiveFrom.ToString("MMM d, yyyy")</dd></div>
                        <div><dt>Occupancy basis</dt><dd>@(selectedAccount.Event is not null ? $"{selectedAccount.Event} · {selectedAccount.EventDate}" : SpaceAccountPresentation.Basis(selectedAccount))</dd></div>
                        @if (!string.IsNullOrWhiteSpace(selectedAccount.ContractName)) { <div><dt>Name on signed contract</dt><dd>@selectedAccount.ContractName</dd></div> }
                        @if (selectedAccount.ContractEffectiveDate is { } contractDate) { <div><dt>Contract effectivity</dt><dd>@contractDate.ToString("MMM d, yyyy")</dd></div> }
                        @if (selectedAccount.ContractYears is { } contractYears) { <div><dt>Recorded contract duration</dt><dd>@contractYears years</dd></div> }
                        @if (selectedAccount.AreaSqm is { } spaceArea) { <div><dt>Recorded area</dt><dd>@spaceArea.ToString("N2") sq.m</dd></div> }
                        @if (!string.IsNullOrWhiteSpace(selectedAccount.AreaLocation)) { <div><dt>Area location / note</dt><dd>@selectedAccount.AreaLocation</dd></div> }
                        @if (SpaceAccountPresentation.Reference(selectedAccount) is { Length: > 0 } reference) { <div><dt>Contract reference</dt><dd>@reference</dd></div> }
                        <div><dt>Approved amount effective from</dt><dd>@selectedAccount.CurrentAmountEffectiveFrom?.ToString("MMM yyyy")</dd></div>
                        @if (selectedAccount.ActiveTo is { } closed) { <div><dt>Closed on</dt><dd>@closed.ToString("MMM d, yyyy")</dd></div> }
                    </dl>
                    <AuthorizeView Roles="SuperAdmin">
                        <Authorized>
                            @if (!ReadOnlyHistory && selectedAccount.ActiveTo is null)
                            {
                                <div class="obw-actions" role="group" aria-label="Authorized account changes">
                                    @if (selectedAccount.Kind != ObligationKind.FiestaArawLotRental)
                                    {
                                        <button type="button" class="v3-btn v3-btn-sm" @onclick="() => OpenRate(selectedAccount)">Change amount</button>
                                    }
                                    <button type="button" class="v3-btn v3-btn-sm" @onclick="() => CloseAsync(selectedAccount.Id)">Close account</button>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                    @if (_registerError is not null) { <div role="alert">@_registerError <button type="button" class="btn-outline" @onclick="() => LoadRegisterAsync(selectedId)">Try again</button></div> }
                    else if (_registerLoading) { <Skeleton Height="100px" /> }
                    else { <div class="v3-table-wrap"><table class="v3-table obw-register" aria-label="@($"{selectedAccount.SubjectLabel} periods")"><thead><tr><th>Period</th><th>Assessed</th><th>Collected</th><th>Remaining</th></tr></thead><tbody>
                        @foreach (var p in _register) { <tr><td>@PeriodLabel(selectedAccount, p)</td><td>@Money(p.AssessedAmount)</td><td>@Money(p.SettledAmount)</td><td>@Money(p.OutstandingAmount)</td></tr> }
                        @if (_register.Count == 0) { <tr><td colspan="4">No period is billable yet.</td></tr> }
                    </tbody></table></div> }
                </section>
            }
        }
        else
        {
        <div class="v3-table-wrap" role="region" aria-label="@($"{Name} accounts")" tabindex="0">
            <table class="v3-table @(Management || Workspace?.Source is EventLotRentalSource ? "obw-management-table" : "")">
                <caption class="v3-sr-only">@Name accounts with approved amount, assessed, collected and remaining</caption>
                <thead>
                    <tr>
                        <th scope="col">@SubjectNoun</th>
                        <th scope="col">@(Kind == ObligationKind.FiestaArawLotRental ? "Lot holder" : "Occupant")</th>
                        @if (SpaceExperience) { <th scope="col">Start date</th><th scope="col">Status</th> }
                        <th scope="col" class="v3-num">@AmountHeading</th>
                        <th scope="col" class="v3-num">Assessed</th>
                        <th scope="col" class="v3-num">Collected</th>
                        <th scope="col" class="v3-num">Remaining</th>
                        <th scope="col"><span class="v3-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in VisibleAccounts)
                    {
                        <tr>
                            <td data-label="@SubjectNoun">@account.SubjectLabel@if (account.Kind == ObligationKind.FiestaArawLotRental && account.Event is { } lotEvent)
                            {<span class="v3-block">@LotLabel(account)</span>}
                            else if (account.ActiveTo is { } ended) {<span class="v3-block">Ended @ended.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>}</td>
                            <td class="v3-strong" data-label="Occupant">@SpaceAccountPresentation.Occupant(account)</td>
                            @if (SpaceExperience)
                            {
                                <td data-label="Start date">@account.ActiveFrom.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                                <td data-label="Status"><AccountStatusPill Status="@(account.ActiveTo is not null ? "Closed" : "Active")" /></td>
                            }
                            <td class="v3-num" data-label="@AmountHeading">@(account.CurrentAmount is { } amount ? Money(amount) : "—")</td>
                            <td class="v3-num" data-label="Assessed">@Money(account.AssessedToDate)</td>
                            <td class="v3-num" data-label="Collected">@Money(account.CollectedToDate)</td>
                            <td class="v3-num v3-strong" data-label="Remaining">@Money(account.OutstandingToDate)</td>
                            <td class="obw-actions-cell"><div class="obw-actions" role="group" aria-label="@($"Account actions for {account.SubjectLabel}")">
                                <button class="v3-btn v3-btn-sm" type="button" aria-expanded="@(_selected == account.Id ? "true" : "false")"
                                        @onclick="() => ToggleRegisterAsync(account.Id)">Periods</button>
                                <AuthorizeView Roles="SuperAdmin">
                                    <Authorized>
                                        @if (!ReadOnlyHistory && account.Kind != ObligationKind.FiestaArawLotRental && account.ActiveTo is null)
                                        {
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => OpenRate(account)">Change amount</button>
                                        }
                                        @if (!ReadOnlyHistory && account.ActiveTo is null)
                                        {
                                            <button class="v3-btn v3-btn-sm" type="button" @onclick="() => CloseAsync(account.Id)">@(SpaceExperience ? "Close account" : "End")</button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </div></td>
                        </tr>
                        @if (_selected == account.Id)
                        {
                            <tr class="obw-register-row">
                                <td colspan="@(SpaceExperience ? 9 : 7)">
                                    @if (SupportsContractBasis)
                                    {
                                        <dl class="obw-account-facts">
                                            <div><dt>Occupancy basis</dt><dd>@SpaceAccountPresentation.Basis(account)</dd></div>
                                            @if (!string.IsNullOrWhiteSpace(SpaceAccountPresentation.Reference(account)))
                                            { <div><dt>Contract reference</dt><dd>@account.ContractReference</dd></div> }
                                            <div><dt>Approved amount effective from</dt><dd>@(account.CurrentAmountEffectiveFrom?.ToString("MMM yyyy") ?? "Not recorded")</dd></div>
                                            @if (account.ActiveTo is { } closed) { <div><dt>Closed on</dt><dd>@closed.ToString("MMM d, yyyy")</dd></div> }
                                        </dl>
                                    }
                                    @if (_registerError is not null)
                                    {
                                        <div role="alert" class="v3-notice v3-notice-error">@_registerError <button class="v3-btn v3-btn-sm" type="button" @onclick="() => LoadRegisterAsync(account.Id)">Try again</button></div>
                                    }
                                    <table class="v3-table obw-register" aria-label="@($"{account.SubjectLabel} periods")">
                                        <thead>
                                            <tr>
                                                <th scope="col">Period</th>
                                                <th scope="col" class="v3-num">Assessed</th>
                                                <th scope="col" class="v3-num">Collected</th>
                                                <th scope="col" class="v3-num">Remaining</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var period in _register)
                                            {
                                                <tr>
                                                    <td>@PeriodLabel(account, period)</td>
                                                    <td class="v3-num">@Money(period.AssessedAmount)</td>
                                                    <td class="v3-num">@Money(period.SettledAmount)</td>
                                                    <td class="v3-num v3-strong">@Money(period.OutstandingAmount)</td>
                                                </tr>
                                            }
                                            @if (_register.Count == 0)
                                            {
                                                <tr><td class="v3-empty" colspan="4">@(_registerLoading ? "Loading periods…" : _registerError is not null ? "Periods are unavailable." : "No period is billable yet.")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                    @if (!VisibleAccounts.Any())
                    {
                        <tr>
                            <td class="v3-empty" colspan="@(SpaceExperience ? 9 : 7)">
                                @if (_loading) { <span role="status">Loading accounts…</span><Skeleton Height="24px" /> }
                                else if (_error is not null) { <span>Accounts are unavailable.</span> }
                                else if (SpaceExperience && _accounts.Count > 0) { <span>@(!string.IsNullOrWhiteSpace(_search) ? "No accounts match this search." : _lifecycle == "All" ? "No accounts match the selected payment position." : _lifecycle == "Closed" ? "No closed accounts match the selected payment position." : "No active registrations match the selected payment position.")</span> }
                                else { <span>No @(SubjectNoun == "Lot" ? "lots" : "spaces") found.</span> }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_accounts.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="@(SpaceExperience ? 5 : 3)"><strong>Total</strong> <span class="obw-note" title="All registered accounts, including closed accounts. Search and filters do not change totals.">All accounts · to date</span></td>
                            <td class="v3-num v3-strong" data-label="Assessed">@Money(_workspace?.Assessed ?? _accounts.Sum(x => x.AssessedToDate))</td>
                            <td class="v3-num v3-strong" data-label="Collected">@Money(_workspace?.Collected ?? _accounts.Sum(x => x.CollectedToDate))</td>
                            <td class="v3-num v3-strong" data-label="Remaining">@Money(_workspace?.Outstanding ?? _accounts.Sum(x => x.OutstandingToDate))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
        }
    </section>

</div>
}

@if (_detailsAccount is { } details)
{ <ObligationRentalDetails Account="details" History="_detailsHistory" OnClose="() => _detailsAccount = null" /> }

<AuthorizeView Roles="SuperAdmin">
    <Authorized>
        <AddNewDrawer Show="@(_opening && _advanceRequest is null && !ReadOnlyHistory)" Title="@(SupportsContractBasis ? "Add New Space Holder" : $"Open {Name} account")" Subtitle="@OpenSubtitle"
                      FormId="obw-open-form" FormLabel="Open account" SubmitText="Open account" Saving="_saving" Error="@_formError"
                      OnSubmit="CreateAsync" OnCancel="CloseForm" LeadingFooterActions="@ImportAction">
            @if (Kind == ObligationKind.FishMeatVendorFee)
            {
                <AddNewSection Title="NPM Fish / Meat stall" Plain="true">
                    <div class="avm-group">
                        <label class="avm-label" for="obw-stall">Stall <span class="avm-req">*</span></label>
                        <select id="obw-stall" class="avm-input" @bind="_stallId" required>
                            <option value="">Choose a stall</option>
                            @foreach (var stall in _stalls.Where(x => !x.HasAccount))
                            {
                                <option value="@stall.StallId" disabled="@(stall.PayorId is null)">
                                    @stall.StallNo · @stall.Section · @(stall.PayerName ?? "occupant not linked to a Payor")
                                </option>
                            }
                        </select>
                        <span class="avm-hint">The Payor is the one linked to the stall's occupant in NPM.</span>
                    </div>
                </AddNewSection>
            }
            else
            {
                @if (SupportsContractBasis)
                {
                    <RentalLesseeFields Form="RegistrationState" ContractNameSupported="true" OccupantId="obw-occupant"
                                        OccupantPlaceholder="Current space occupant" OnArrangement="SelectRentalBasis">
                        <ExtraFields>
                            @if (_signedContract)
                            {
                                <div class="avm-row-2"><div class="avm-group">
                                    <label class="avm-label">Contract reference</label>
                                    <input class="avm-input" type="text" maxlength="200" placeholder="As written on the contract" @bind="_contractRef" />
                                </div></div>
                            }
                        </ExtraFields>
                    </RentalLesseeFields>
                }
                else
                {
                <AddNewSection Title="@(Kind == ObligationKind.FiestaArawLotRental ? "Event & Occupant Information" : Workspace is not null ? "Lessee Information" : "Occupant Information")" Plain="true">
                    <div class="avm-group">
                        <label class="avm-label">@(Kind == ObligationKind.FiestaArawLotRental ? "Event" : "Basis of Occupancy") <span class="avm-req">*</span></label>
                        @if (Kind == ObligationKind.FiestaArawLotRental)
                        {
                            <ChoiceCards Label="Event" Items="EventChoices" Value="@(((int)_lotEvent).ToString())" ValueChanged="PickEvent" />
                        }
                        else
                        {
                            <ChoiceCards Label="Basis of occupancy" Items="BasisChoices" Value="@(_signedContract ? "signed" : "space")" ValueChanged="PickBasis" />
                        }
                    </div>
                    <div class="@(SupportsContractBasis && _signedContract ? "avm-row-2" : "avm-group")">
                        @* The holder is the source's own occupant: typed once on the account, never a master record or a name match. *@
                        <div class="avm-group">
                            <label class="avm-label" for="obw-occupant">@(Kind == ObligationKind.FiestaArawLotRental ? "Lot holder" : "Actual occupant") <span class="avm-req">*</span></label>
                            <input id="obw-occupant" class="avm-input" type="text" maxlength="200" autocomplete="off" aria-label="Actual occupant" @bind="_occupant" @bind:event="oninput" />
                        </div>
                        @if (SupportsContractBasis && _signedContract)
                        {
                            <div class="avm-group">
                                <label class="avm-label">Contract reference</label>
                                <input class="avm-input" type="text" maxlength="200" placeholder="As written on the contract" @bind="_contractRef" />
                            </div>
                        }
                    </div>
                </AddNewSection>
                }

                @if (SupportsContractBasis)
                {
                    <RentalContractFields>
                        <SourceField><div class="avm-group"><label class="avm-label">Operation <span class="avm-req">*</span></label><div class="avm-input avm-input-locked">@Name</div></div></SourceField>
                        <NumberField><RentalUnitNumberField ServerAssigned="true" SuggestedNumber="@NextSpaceNumber" SignedContract="_signedContract" /></NumberField>
                        <EffectivityField>
                            @if (_signedContract)
                            {
                                <RentalEffectivityField SignedContract="true" InputId="obw-contract-date" Label="Contract Effectivity Date" Date="@_contractDate" DateChanged="value => _contractDate = value" />
                            }
                            else
                            {
                                <RentalEffectivityField SignedContract="false" MonthPrecision="true" InputId="obw-start"
                                    Label="Occupying Since (month)" Month="@_startMonth" MonthChanged="v => _startMonth = v" />
                            }
                        </EffectivityField>
                        <TermField>
                            @if (_signedContract && Kind == ObligationKind.KanmanggaySpaceRental)
                            {
                                <div class="avm-group">
                                    <label class="avm-label" for="obw-contract-years">Contract Duration (No. of Years)</label>
                                    <select id="obw-contract-years" class="avm-input" @bind="_contractYears"><option value="3">3 years</option></select>
                                    <span class="avm-hint-muted">MEEDO standard. Recorded term does not automatically expire or renew the account.</span>
                                </div>
                            }
                        </TermField>
                    </RentalContractFields>
                    <AddNewSection Title="Space Information" Plain="true">
                        <div class="avm-row-2"><div class="avm-group">
                            <label class="avm-label" for="obw-area">Area (sq.m)</label>
                            <input id="obw-area" type="number" class="avm-input" min="0" max="1000000" step="0.01" placeholder="Area if recorded" @bind="_areaSqm" />
                        </div></div>
                    </AddNewSection>
                }
                else
                {
                <AddNewSection Title="@(Kind == ObligationKind.FiestaArawLotRental ? "Lot & Event Details" : "Space & Contract Details")" Plain="true">
                    <div class="avm-row-2">
                        <div class="avm-group">
                            <label class="avm-label">Operation</label>
                            <div class="avm-input avm-input-locked">@(Kind == ObligationKind.FiestaArawLotRental ? EventChoices.FirstOrDefault(x => x.Value == ((int)_lotEvent).ToString())?.Title ?? Name : Name)</div>
                        </div>
                        @if (!ServerAssignedNumber)
                        {
                        <div class="avm-group">
                            <label class="avm-label" for="obw-subject">@(SubjectNoun == "Lot" ? "Lot No." : "Space No.")</label>
                            <input id="obw-subject" class="avm-input" type="text" maxlength="120" placeholder="Assigned automatically" @bind="_subject" />
                        </div>
                        }
                        else if (Workspace is not null)
                        {
                            <div class="avm-group">
                                <label class="avm-label">Space No.</label>
                                <div class="avm-input avm-input-locked">Assigned by the server on registration</div>
                            </div>
                        }
                    </div>
                    <div class="avm-row-2">
                        @if (Kind == ObligationKind.FiestaArawLotRental)
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-event-date">Event date <span class="avm-req">*</span></label>
                                <input id="obw-event-date" class="avm-input" type="date" required @bind="_eventDate" />
                            </div>
                            <div class="avm-group">
                                <label class="avm-label" for="obw-amount">Approved lot amount (₱) <span class="avm-req">*</span></label>
                                <input id="obw-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                            </div>
                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-start">@(EffectiveMonthLabel ?? (_signedContract ? "Contract Effectivity (month)" : "Occupying Since (month)")) <span class="avm-req">*</span></label>
                                <input id="obw-start" class="avm-input" type="month" required aria-label="Start month" value="@_startMonth" @onchange="e => _startMonth = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            @if (!SupportsContractBasis)
                            {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-amount">Approved monthly rental (₱) <span class="avm-req">*</span></label>
                                <input id="obw-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                            </div>
                            }
                        }
                    </div>
                </AddNewSection>
                }
                @if (SupportsContractBasis)
                {
                    <AddNewSection Title="Rental Rates" Plain="true">
                        <RentalRateFields Form="RegistrationState" InputId="obw-amount" Minimum="0.01m" Step="0.01" Entered="() => StateHasChanged()" />
                    </AddNewSection>
                    <AddNewSection Title="Additional Information" Plain="true">
                        <div class="avm-row-2"><div class="avm-group">
                            <label class="avm-label" for="obw-area-note">Area Location / Note</label>
                            <input id="obw-area-note" class="avm-input" type="text" maxlength="250" placeholder="e.g. Extension, Corner" @bind="_areaLocation" />
                        </div></div>
                    </AddNewSection>
                    <AddNewSection Title="Applicable Charges" Plain="true">
                        <RentalRateFields Form="RegistrationState" ChargeCard="true" Minimum="0.01m" Step="0.01" SourceName="@Name"
                                          Entered="() => StateHasChanged()" Changed="() => StateHasChanged()">
                            <Icon>@SpaceIcon</Icon>
                        </RentalRateFields>
                    </AddNewSection>
                }
            }
        </AddNewDrawer>

        @if (_advanceRequest is { } advance)
        {
            <AddNewDrawer Show="true" Title="Register lot holder in advance?"
                          Subtitle="The selected event is scheduled for a future month. Confirm the details before opening this account."
                          FormId="obw-advance-form" FormLabel="Confirm advance registration" SubmitText="Confirm registration" CancelText="Review details"
                          Saving="_saving" OnSubmit="ConfirmAdvanceAsync" OnCancel="ReviewAdvance">
                <dl class="obw-account-facts">
                    <div><dt>Event</dt><dd>@AdvanceEventName</dd></div>
                    <div><dt>Lot holder</dt><dd>@advance.ActualOccupant</dd></div>
                    <div><dt>Event date</dt><dd>@advance.EventDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</dd></div>
                    <div><dt>Approved amount</dt><dd>@Money(advance.Amount)</dd></div>
                </dl>
            </AddNewDrawer>
        }

        <AddNewDrawer Show="@(!_opening && _rateFor is not null && !ReadOnlyHistory)" Edit="true" Title="Change approved amount" Subtitle="@_rateFor?.SubjectLabel"
                      FormId="obw-rate-form" FormLabel="Change approved amount" SubmitText="Save amount" Saving="_saving" Error="@_formError"
                      OnSubmit="SaveRateAsync" OnCancel="CloseForm">
            <AddNewSection Title="New amount" Plain="true">
                <div class="avm-row-2">
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-month">Effective from (month) <span class="avm-req">*</span></label>
                        <input id="obw-rate-month" class="avm-input" type="month" required aria-label="Effective from (month)" value="@_rateMonth" @onchange="e => _rateMonth = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-amount">Approved monthly amount (₱) <span class="avm-req">*</span></label>
                        <input id="obw-rate-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                    </div>
                </div>
            </AddNewSection>
        </AddNewDrawer>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="SuperAdmin"><Authorized>
@if (_closeFor is { } closing)
{
    <AddNewDrawer Show="true" Edit="true" Title="Close space account" Subtitle="@SpaceAccountPresentation.Occupant(closing)"
                  FormId="obw-close-form" FormLabel="Confirm account closure" SubmitText="Confirm closure" Saving="_saving" Error="@_formError"
                  OnSubmit="ConfirmCloseAsync" OnCancel="CancelClose">
        <p class="v3-notice">Close @closing.SubjectLabel as of @PhilippineTime.Today.ToString("MMM d, yyyy")? Previously assessed periods and collections remain readable. Future assessments stop according to the account's closure date.</p>
    </AddNewDrawer>
}
</Authorized></AuthorizeView>

@if (!string.IsNullOrWhiteSpace(_saved))
{
    <p class="v3-notice obw-success" role="status" aria-live="polite">@_saved</p>
}

@code {
    private readonly string _accountsTitleId = $"obw-a-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public ObligationKind Kind { get; set; }

    /// <summary>The line's name as the Monthly Income sheet shows it.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>What an account is for: Stall, Space or Lot.</summary>
    [Parameter, EditorRequired] public string SubjectNoun { get; set; } = string.Empty;
    [Parameter] public bool SpaceExperience { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Management { get; set; }
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public SpaceAccountPresentation? Presentation { get; set; }
    [Parameter] public RentalWorkspaceDefinition? Workspace { get; set; }
    [Parameter] public bool ServerAssignedNumber { get; set; }
    [Parameter] public string? EffectiveMonthLabel { get; set; }
    [Parameter] public string? AccountCountLabel { get; set; }
    [Parameter] public RenderFragment? AfterHero { get; set; }
    [Parameter] public RenderFragment? ToolbarMode { get; set; }
    private bool SupportsContractBasis => EEMOCantilanSDS.Domain.Entities.Revenue.ObligationAccount.IsMonthlySpaceKind(Kind);
    [Parameter] public bool ReadOnlyHistory { get; set; }
    [Parameter] public string? ReportsHref { get; set; }

    /// <summary>The bulk-import page for this line; the Import list action is offered only when there is one.</summary>
    [Parameter] public string? ImportHref { get; set; }
    private ObligationWorkspaceDto? _workspace;
    private string _search = string.Empty, _filter = "All";
    private string _lifecycle = "Active";
    private static readonly List<string> StatusFilters = new() { "All", "Paid", "Partial", "Unpaid" };
    private static readonly List<string> OverviewFilters = new() { "All", "Paid", "Partial", "Unpaid", "Closed" };
    private RenderFragment LifecycleFilters => @<div role="group" aria-label="Account lifecycle" class="obw-lifecycle">
        @foreach (var lifecycle in new[] { "All", "Active", "Closed" })
        {
            <button class="v3-btn v3-btn-sm" type="button" aria-pressed="@(_lifecycle == lifecycle ? "true" : "false")" @onclick="() => _lifecycle = lifecycle">@lifecycle</button>
        }
    </div>;
    private double CollectionRate => _workspace is { Assessed: > 0m } w ? (double)Math.Min(100m, Math.Round(w.Collected / w.Assessed * 100m, 0)) : 0;
    private RenderFragment SpaceIcon => @<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>;
    private RenderFragment RegistryPicker => @<RentalWorkspacePicker Compact="true" Selected="@(Kind == ObligationKind.FiestaArawLotRental ? "FA" : Kind == ObligationKind.KanmanggaySpaceRental ? "KM" : "Vegetable/Fruits")" />;
    private RenderFragment ActionBarContent => @<text>
        @if (Workspace is { } workspace)
        {
            <RentalWorkspaceNavigation Workspace="workspace" ShowManagement="@(!Management)">@RegistrationAction</RentalWorkspaceNavigation>
        }
        else
        { @LegacyActionBar }
    </text>;
    private RenderFragment RegistrationAction => @<AuthorizeView Roles="SuperAdmin"><Authorized>
        <button class="btn-primary" type="button" @onclick="OpenForm">+ Add New</button>
    </Authorized></AuthorizeView>;
    private RenderFragment LegacyActionBar => @<div class="obw-actions-bar">
        @if (Presentation is { } presentation)
        {
            <a class="btn-outline" href="@presentation.RosterHref">Space Holder List</a>
            @if (!Management) { <a class="btn-outline" href="@presentation.ManagementHref">Manage Space Holders</a> }
        }
        <a class="btn-outline" href="@ReportsHref">Reports</a>
        @RegistrationAction
    </div>;
    private RenderFragment? ImportAction => string.IsNullOrWhiteSpace(ImportHref) ? null : @<button type="button" class="btn-ghost" disabled="@_saving" @onclick="OpenImport">Import list</button>;
    private void OpenImport() { if (!_saving && !string.IsNullOrWhiteSpace(ImportHref)) Navigation.NavigateTo(ImportHref); }
    private List<FacilityHero.HeroStat> SpaceStats => [
        new() { Label = "Collected", Value = _workspace is null ? "—" : Money(_workspace.Collected) },
        new() { Label = "Remaining", Value = _workspace is null ? "—" : Money(_workspace.Outstanding) },
        new() { Label = AccountCountLabel ?? $"Registered {SubjectNoun.ToLowerInvariant()}s", Value = _loading || _error is not null ? "—" : _accounts.Count.ToString(CultureInfo.InvariantCulture) }];
    private IEnumerable<ObligationAccountDto> VisibleAccounts => _accounts.Where(a =>
        (!SpaceExperience || (!Overview && _lifecycle == "All") || ((Overview ? _filter == "Closed" : _lifecycle == "Closed") ? a.ActiveTo is not null : a.ActiveTo is null))
        && (!SpaceExperience || _filter switch
        {
            "Paid" => a.AssessedToDate > 0m && a.OutstandingToDate == 0m,
            "Partial" => a.CollectedToDate > 0m && a.OutstandingToDate > 0m,
            "Unpaid" => a.CollectedToDate == 0m,
            _ => true
        })
        && (string.IsNullOrWhiteSpace(_search) || a.SubjectLabel.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || SpaceAccountPresentation.Occupant(a).Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private string AmountHeading => Kind == ObligationKind.FiestaArawLotRental ? "Approved amount" : "Approved monthly";

    private List<ObligationAccountDto> _accounts = [];
    private List<ObligationQuoteDto> _register = [];
    private List<VendorFeeStallDto> _stalls = [];
    private bool _loading = true;
    private bool _registerLoading;
    private int _registerRequest;
    private string? _registerError;
    private string? _error;
    private Guid? _selected;

    private bool _opening;
    private CreateObligationAccountRequest? _advanceRequest;
    private ObligationAccountDto? _rateFor;
    private bool _saving;
    private bool _signedContract = true;
    private string _contractRef = string.Empty;
    private string _contractName = string.Empty;
    private string _areaLocation = string.Empty;
    private decimal? _areaSqm;
    private int _contractYears = 3;
    private DateTime? _contractDate = PhilippineTime.Now.Date;
    private string? NextSpaceNumber
    {
        get
        {
            if (!ServerAssignedNumber || _loading || _error is not null) return null;
            var max = _accounts.Where(x => x.Kind == Kind && x.Event is null)
                .Select(x => long.TryParse(x.SubjectLabel, out var number) && number > 0 ? number : 0L)
                .DefaultIfEmpty().Max();
            return max < long.MaxValue ? (max + 1).ToString(CultureInfo.InvariantCulture) : null;
        }
    }
    private string? _formError;
    private string? _saved;
    private string _occupant = string.Empty;
    private string _stallId = string.Empty;
    private string _subject = string.Empty;
    private LotRentalEvent _lotEvent = LotRentalEvent.Fiesta;
    private DateOnly _eventDate = PhilippineTime.Today;
    private string _startMonth = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private string _rateMonth = PhilippineTime.Today.AddMonths(1).ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private decimal? _amount;
    private RenderFragment<ObligationAccountDto> RegistryAccountPosition => a => @<div class="obw-note">Assessed @Money(a.AssessedToDate)<br />Collected @Money(a.CollectedToDate)<br />Remaining @Money(a.OutstandingToDate)</div>;
    private RenderFragment<ObligationAccountDto> RegistryAccountActions => a => @<div class="obw-actions" role="group" aria-label="@($"Account actions for {a.SubjectLabel}")">
        <button class="v3-btn v3-btn-sm" type="button" title="View payment position" aria-label="View payment position" @onclick="() => OpenAccountPosition(a)">₱</button>
        <button class="v3-btn v3-btn-sm" type="button" title="Payment history" aria-label="Payment history" @onclick="() => OpenAccountHistory(a)">↺</button>
        <button class="v3-btn v3-btn-sm" type="button" title="Manage account details" aria-label="Manage account details" @onclick="() => ToggleRegisterAsync(a.Id)">→</button>
    </div>;
    private ObligationAccountDto? _detailsAccount;
    private bool _detailsHistory;
    private static string PaymentStatus(ObligationAccountDto a) => a.AssessedToDate > 0m && a.OutstandingToDate == 0m ? "Paid"
        : a.CollectedToDate > 0m && a.OutstandingToDate > 0m ? "Partial" : "Unpaid";
    private IEnumerable<RentalTableRow<ObligationAccountDto>> RentalRows => VisibleAccounts.Select(a => new RentalTableRow<ObligationAccountDto>(a,
        a.SubjectLabel, SpaceAccountPresentation.Occupant(a), a.Kind == ObligationKind.FiestaArawLotRental ? "Event lot" :
        !string.IsNullOrWhiteSpace(a.ContractName) ? a.ContractName :
        string.IsNullOrWhiteSpace(SpaceAccountPresentation.Reference(a)) ? SpaceAccountPresentation.Basis(a) : $"Contract ref: {a.ContractReference}",
        (a.ContractEffectiveDate ?? a.ActiveFrom).ToString("MMM d, yyyy"), a.CurrentAmount, PaymentStatus(a), a.ActiveTo is null ? "Active" : "Closed",
        a.Event is not null ? LotLabel(a) : null));
    private void OpenAccountPosition(ObligationAccountDto account) { _detailsAccount = account; _detailsHistory = false; }
    private void OpenAccountHistory(ObligationAccountDto account) { _detailsAccount = account; _detailsHistory = true; }
    private void OpenAccountProfile(ObligationAccountDto account) => Navigation.NavigateTo(
        account.Kind == ObligationKind.FiestaArawLotRental ? $"/vendors?workspace=FA&account={account.Id}" : $"{Presentation?.ManagementHref ?? "/operations/kanmanggay/manage-space-holders"}?account={account.Id}");

    private IRentalRegistrationState RegistrationState => new ObligationRentalRegistrationState(
        () => _occupant, v => _occupant = v,
        () => _signedContract ? OccupancyArrangement.SignedContract : OccupancyArrangement.SpaceOnly,
        v => _signedContract = v == OccupancyArrangement.SignedContract,
        () => _amount ?? 0m, v => _amount = v,
        () => _contractName, v => _contractName = v);
    private void SelectRentalBasis(OccupancyArrangement arrangement) => _signedContract = arrangement == OccupancyArrangement.SignedContract;

    protected override void OnParametersSet()
    {
        // Fail closed on a miswired presentation adapter; never map one source into another.
        if (Workspace is { Source: MonthlySpaceRentalSource monthly } && monthly.Kind != Kind
            || Workspace is { Source: EventLotRentalSource eventLot } && eventLot.Kind != Kind
            || Workspace?.Source is FacilityRentalSource)
            throw new InvalidOperationException("The rental presentation does not match this obligation source.");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (Management && AccountId is { } id && _accounts.FirstOrDefault(a => a.Id == id) is { } selected)
        {
            _lifecycle = selected.ActiveTo is null ? "Active" : "Closed";
            await ToggleRegisterAsync(id);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _workspace = null;
        _accounts = [];
        try
        {
            if (SpaceExperience)
            {
                var workspace = await ObligationsApi.GetWorkspaceAsync(Kind);
                _workspace = workspace.IsSuccess ? workspace.Value : null;
                _accounts = _workspace?.Accounts.Where(a => a.Kind == Kind).ToList() ?? [];
                if (!workspace.IsSuccess) _error = workspace.Error ?? $"{Name} accounts couldn't be loaded.";
                return;
            }
            var result = await ObligationsApi.GetAccountsAsync(Kind);
            if (result.IsSuccess) _accounts = result.Value?.Where(a => a.Kind == Kind).ToList() ?? [];
            else { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        }
        catch { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        finally { _loading = false; }
    }

    private async Task ToggleRegisterAsync(Guid accountId)
    {
        if (_selected == accountId) { _selected = null; return; }
        _selected = accountId;
        await LoadRegisterAsync(accountId);
    }

    private async Task LoadRegisterAsync(Guid accountId)
    {
        var request = ++_registerRequest;
        _register = [];
        _registerError = null;
        _registerLoading = true;
        try
        {
            var result = await ObligationsApi.GetRegisterAsync(accountId);
            if (request != _registerRequest || _selected != accountId) return;
            _register = result.IsSuccess ? result.Value?.ToList() ?? [] : [];
            if (!result.IsSuccess) _registerError = result.Error ?? "Periods could not be loaded.";
        }
        catch { if (request == _registerRequest && _selected == accountId) { _register = []; _registerError = "Periods could not be loaded."; } }
        finally { if (request == _registerRequest) _registerLoading = false; }
    }

    private async Task OpenForm()
    {
        _formError = null; _saved = null; _rateFor = null; _advanceRequest = null;
        _occupant = _stallId = _subject = _contractRef = _contractName = _areaLocation = string.Empty;
        _areaSqm = null; _contractYears = 3; _contractDate = PhilippineTime.Now.Date;
        _signedContract = true; _lotEvent = LotRentalEvent.Fiesta;
        _amount = null;
        _opening = true;
        if (Kind == ObligationKind.FiestaArawLotRental && _operations.Count == 0) await LoadOperationsAsync();
        if (Kind == ObligationKind.FishMeatVendorFee)
        {
            try
            {
                var stalls = await ObligationsApi.GetVendorStallsAsync();
                _stalls = stalls.IsSuccess ? stalls.Value?.ToList() ?? [] : [];
                if (!stalls.IsSuccess) _formError = "The NPM Fish and Meat stalls couldn't be loaded.";
            }
            catch { _stalls = []; _formError = "The NPM Fish and Meat stalls couldn't be loaded."; }
        }
    }

    private void OpenRate(ObligationAccountDto account)
    {
        _formError = null; _saved = null; _opening = false; _advanceRequest = null;
        _rateFor = account;
        _amount = account.CurrentAmount;
    }

    private void CloseForm() { if (_saving) return; _opening = false; _rateFor = null; _formError = null; _advanceRequest = null; }
    private void ReviewAdvance() { if (!_saving) _advanceRequest = null; }
    private string AdvanceEventName => EventChoices.FirstOrDefault(x => x.Value == ((int)_advanceRequest!.Event!.Value).ToString())?.Title ?? _advanceRequest!.Event.ToString()!;

    private string OpenSubtitle => Kind == ObligationKind.FiestaArawLotRental
        ? "A lot for an event, with the approved amount."
        : Kind == ObligationKind.FishMeatVendorFee ? "A vendor stall with its approved monthly amount." : $"Register a new {Name} space holder in the system.";

    private static readonly IReadOnlyList<ChoiceCards.Choice> BasisChoices =
    [
        new("signed", "Signed lease contract", "Leased under a signed contract"),
        new("space", "No contract (space only)", "Occupies the space without a contract")
    ];

    // Fiesta and Araw are the server's own events; they are read from the approved operations and the enum is only the fallback.
    private IReadOnlyList<SpaceRentalOperationDto> _operations = [];
    private IReadOnlyList<ChoiceCards.Choice> EventChoices
    {
        get
        {
            var events = _operations.Where(x => x.Kind == ObligationKind.FiestaArawLotRental && x.Event is not null).ToList();
            return events.Count > 0
                ? events.Select(x => new ChoiceCards.Choice(((int)x.Event!.Value).ToString(), x.DisplayName)).ToArray()
                : [new(((int)LotRentalEvent.Fiesta).ToString(), "Fiesta"), new(((int)LotRentalEvent.Araw).ToString(), "Araw")];
        }
    }
    private void PickBasis(string value) => _signedContract = value == "signed";
    private void PickEvent(string value) => _lotEvent = (LotRentalEvent)int.Parse(value, CultureInfo.InvariantCulture);

    private async Task LoadOperationsAsync()
    {
        try
        {
            var result = await ObligationsApi.GetSpaceOperationsAsync();
            if (result.IsSuccess) _operations = result.Value?.ToList() ?? [];
        }
        catch { _operations = []; }
    }

    private static bool TryMonthStart(string value, out DateOnly month)
    {
        month = default;
        return DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out month);
    }

    private Task CreateAsync() => SubmitAccountAsync(false);
    private Task ConfirmAdvanceAsync() => SubmitAccountAsync(true);

    private async Task SubmitAccountAsync(bool confirmed)
    {
        if (_saving || !_opening || ReadOnlyHistory || (confirmed && _advanceRequest is null)) return;
        _formError = null;
        var isLot = Kind == ObligationKind.FiestaArawLotRental;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        DateOnly start;
        if (isLot) start = _eventDate;
        else if (SupportsContractBasis && _signedContract && _contractDate is { } signedOn)
            start = new DateOnly(signedOn.Year, signedOn.Month, 1);
        else if (SupportsContractBasis && _signedContract)
        { _formError = "Choose the contract effectivity date."; return; }
        else if (!TryMonthStart(_startMonth, out start)) { _formError = "Choose the month the account starts."; return; }
        Guid? stallId = null;
        var payorId = Guid.Empty;
        if (Kind == ObligationKind.FishMeatVendorFee)
        {
            if (!Guid.TryParse(_stallId, out var parsedStall)) { _formError = "Choose an NPM Fish or Meat stall."; return; }
            stallId = parsedStall;
        }
        else if (_occupant.Trim().Length < 2) { _formError = Kind == ObligationKind.FiestaArawLotRental ? "Enter the lot holder." : "Enter the actual occupant."; return; }

        var subject = Kind == ObligationKind.FishMeatVendorFee
            ? _stalls.FirstOrDefault(x => x.StallId == stallId)?.StallNo ?? string.Empty
            : ServerAssignedNumber ? string.Empty : _subject.Trim();
        var request = new CreateObligationAccountRequest(
            Kind, payorId, stallId, subject, isLot ? _lotEvent : null, isLot ? _eventDate : null, start, _amount!.Value,
            // Monthly space accounts record occupancy basis; space-only occupancy implies no contract.
            SupportsContractBasis ? (_signedContract ? OccupancyArrangement.SignedContract : OccupancyArrangement.SpaceOnly) : null,
            SupportsContractBasis && _signedContract && !string.IsNullOrWhiteSpace(_contractRef) ? _contractRef.Trim() : null,
            Kind == ObligationKind.FishMeatVendorFee ? null : _occupant.Trim(),
            SupportsContractBasis && _signedContract ? _contractName.Trim() : null,
            SupportsContractBasis && _signedContract && _contractDate is { } contractOn ? DateOnly.FromDateTime(contractOn) : null,
            Kind == ObligationKind.KanmanggaySpaceRental && _signedContract ? _contractYears : null,
            SupportsContractBasis ? _areaSqm : null,
            SupportsContractBasis ? _areaLocation.Trim() : null);
        var today = PhilippineTime.Today;
        var futureMonth = isLot && new DateOnly(start.Year, start.Month, 1) > new DateOnly(today.Year, today.Month, 1);
        if ((futureMonth && !confirmed) || (confirmed && request != _advanceRequest))
        {
            _advanceRequest = request;
            return;
        }
        _saving = true;
        try
        {
            var result = await ObligationsApi.CreateAccountAsync(request);
            if (!result.IsSuccess) { _formError = result.Error ?? "The account could not be opened."; return; }
            _opening = false;
            _saved = isLot ? "Lot account opened successfully." : $"{Name} account opened.";
            // A holder that was just added must be visible: a Paid / Partial filter or a search left on the list would hide it.
            _filter = "All";
            _lifecycle = "Active";
            _search = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; _advanceRequest = null; }
    }

    private async Task SaveRateAsync()
    {
        if (_saving || _rateFor is null) return;
        _formError = null;
        if (_amount is not > 0m) { _formError = "Enter the approved amount."; return; }
        if (!TryMonthStart(_rateMonth, out var effective)) { _formError = "Choose the month the amount takes effect."; return; }
        _saving = true;
        try
        {
            var result = await ObligationsApi.SetRateAsync(_rateFor.Id, new SetObligationRateRequest(effective, _amount!.Value));
            if (!result.IsSuccess) { _formError = result.Error ?? "The amount could not be saved."; return; }
            _rateFor = null;
            _saved = "Approved amount saved. It applies from its effective month.";
            await LoadAsync();
            if (_selected is { } selected) await LoadRegisterAsync(selected);
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private ObligationAccountDto? _closeFor;
    private Task CloseAsync(Guid accountId)
    {
        _closeFor = _accounts.FirstOrDefault(a => a.Id == accountId);
        _formError = null;
        return Task.CompletedTask;
    }
    private void CancelClose() { _closeFor = null; _formError = null; }
    private async Task ConfirmCloseAsync()
    {
        if (_saving || _closeFor is null) return;
        _saving = true;
        _saved = null;
        try
        {
            var result = await ObligationsApi.CloseAccountAsync(_closeFor.Id, new CloseObligationAccountRequest(PhilippineTime.Today));
            if (!result.IsSuccess) { _formError = result.Error ?? "The account could not be ended."; return; }
            _closeFor = null;
            _selected = null;
            _saved = "Account ended. Its assessed periods and collections are unchanged.";
            await LoadAsync();
        }
        catch { _formError = "The account could not be ended."; }
        finally { _saving = false; }
    }

    private static string Money(decimal amount) => $"₱{amount:N2}";

    private static string LotLabel(ObligationAccountDto account) =>
        $"{account.Event} · {account.EventDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    private static string PeriodLabel(ObligationAccountDto account, ObligationQuoteDto period) =>
        account.Kind == ObligationKind.FiestaArawLotRental
            ? period.PeriodStart.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            : period.PeriodStart.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
}
