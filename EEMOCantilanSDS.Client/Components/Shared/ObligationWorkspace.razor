                        }
                        else
                        {
                            <div class="avm-group">
                                <label class="avm-label">Occupying Since</label>
                                <div class="avm-input avm-input-locked">@editing.ActiveFrom.ToString("MMM d, yyyy")</div>
                            </div>
                        }
                    </EffectivityField>
                    <TermField>
                        @if (_signedContract && DurationUnconfirmed)
                        {
                            <div class="avm-group">
                                <span class="avm-label">Contract Duration</span>
                                <p class="avm-hint">@(_editFor?.ContractYears is { } kept ? $"{DomainRules.DescribeTerm(kept, _editFor?.ContractMonths)}, as already recorded. " : "Not recorded. ")Policy confirmation required before a duration can be recorded or changed.</p>
                            </div>
                        }
                        else if (_signedContract && Kind == ObligationKind.KanmanggaySpaceRental)
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-contract-years">Contract Duration (No. of Years)</label>
                                <select id="obw-contract-years" class="avm-input" @bind="_contractYears">
                                    <option value="0">Not recorded</option>
                                    @for (var year = 1; year <= 50; year++)
                                    {
                                        <option value="@year">@year @(year == 1 ? "year" : "years")</option>
                                    }
                                </select>
                                <label class="avm-label" for="obw-contract-months">Plus months (optional)</label>
                                <select id="obw-contract-months" class="avm-input" @bind="_contractMonths">
                                    <option value="0">None</option>
                                    @for (var month = 1; month <= 11; month++)
                                    {
                                        <option value="@month">@month @(month == 1 ? "month" : "months")</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (_signedContract && Kind == ObligationKind.VegetableFruitSpaceRental)
                        {
                            <div class="avm-group">
                                <label class="avm-label" for="obw-contract-years">Contract Duration (No. of Years)</label>
                                <select id="obw-contract-years" class="avm-input" @bind="_contractYears">
                                    <option value="0">Not recorded</option>
                                    @for (var year = 1; year <= 10; year++)
                                    {
                                        <option value="@year">@year @(year == 1 ? "year" : "years")</option>
                                    }
                                </select>
                                <label class="avm-label" for="obw-contract-months">Plus months (optional)</label>
                                <select id="obw-contract-months" class="avm-input" @bind="_contractMonths">
                                    <option value="0">None</option>
                                    @for (var month = 1; month <= 11; month++)
                                    {
                                        <option value="@month">@month @(month == 1 ? "month" : "months")</option>
                                    }
                                </select>
                            </div>
                        }
                    </TermField>
                </RentalContractFields>
                <AddNewSection Title="Rent / Space Information" Plain="true">
                    <div class="avm-row-2"><div class="avm-group">
                        <label class="avm-label" for="obw-area">Area (sq.m)</label>
                        <input id="obw-area" class="avm-input" type="number" min="0" max="1000000" step="0.01" @bind="_areaSqm" />
                    </div></div>
                </AddNewSection>
                @* Existing signed-contract rate evidence remains on the account; rental changes use the approved rate workflow. *@
                <AddNewSection Title="Additional Information" Plain="true">
                    <div class="avm-row-2"><div class="avm-group">
                        <label class="avm-label" for="obw-area-note">Area Location / Note</label>
                        <input id="obw-area-note" class="avm-input" type="text" maxlength="250" @bind="_areaLocation" />
                    </div></div>
                </AddNewSection>
                <div class="avm-hint-muted">
                    Approved monthly rental: @(editing.CurrentAmount is { } approved ? Money(approved) : "Not effective yet").
                    Rate changes take effect from the month you select and do not rewrite previous collections.
                </div>
                <div class="obw-actions">
                    <label><input type="checkbox" @bind="_changeApprovedAmount" /> Change approved amount</label>
                </div>
                @if (_changeApprovedAmount)
                {
                    <div class="avm-row-2">
                        <div class="avm-group">
                            <label class="avm-label" for="obw-holder-rate-month">Effective from (month)</label>
                            <input id="obw-holder-rate-month" class="avm-input" type="month" required value="@_rateMonth" @onchange="e => _rateMonth = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="avm-group">
                            <label class="avm-label" for="obw-holder-rate-amount">Approved monthly amount</label>
                            <input id="obw-holder-rate-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                        </div>
                    </div>
                }
            </AddNewDrawer>
        }

        <AddNewDrawer Show="@(!_opening && _rateFor is not null && !ReadOnlyHistory)" Edit="true" Title="Change approved amount" Subtitle="@_rateFor?.SubjectLabel"
                      FormId="obw-rate-form" FormLabel="Change approved amount" SubmitText="Save amount" Saving="_saving" Error="@_formError"
                      OnSubmit="SaveRateAsync" OnCancel="CloseForm">
            <AddNewSection Title="New amount" Plain="true">
                <div class="avm-row-2">
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-month">Effective from (month) <span class="avm-req">*</span></label>
                        <input id="obw-rate-month" class="avm-input" type="month" required aria-label="Effective from (month)" value="@_rateMonth" @onchange="e => _rateMonth = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="avm-group">
                        <label class="avm-label" for="obw-rate-amount">Approved monthly amount (₱) <span class="avm-req">*</span></label>
                        <input id="obw-rate-amount" class="avm-input" type="number" min="0.01" step="0.01" required @bind="_amount" />
                    </div>
                </div>
            </AddNewSection>
        </AddNewDrawer>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="SuperAdmin"><Authorized>
@if (_closeFor is { } closing)
{
    <AddNewDrawer Show="true" Edit="true" Title="Close space account" Subtitle="@SpaceAccountPresentation.Occupant(closing)"
                  FormId="obw-close-form" FormLabel="Confirm account closure" SubmitText="Confirm closure" Saving="_saving" Error="@_formError"
                  OnSubmit="ConfirmCloseAsync" OnCancel="CancelClose">
        <p class="v3-notice">Mark Space @closing.SubjectLabel (@SpaceAccountPresentation.Occupant(closing)) as Closed on @PhilippineTime.Today.ToString("MMM d, yyyy")? It will no longer appear in active collection lists. Previously assessed periods and collections remain readable. Their balances remain intact, and future assessments stop at the closure date. This is not contract renewal or reopening.</p>
    </AddNewDrawer>
}
</Authorized></AuthorizeView>

@if (!string.IsNullOrWhiteSpace(_saved))
{
    <p class="v3-notice obw-success" role="status" aria-live="polite">@_saved</p>
}

@code {
    private readonly string _accountsTitleId = $"obw-a-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public ObligationKind Kind { get; set; }

    /// <summary>The line's name as the Monthly Income sheet shows it.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>What an account is for: Stall, Space or Lot.</summary>
    [Parameter, EditorRequired] public string SubjectNoun { get; set; } = string.Empty;
    [Parameter] public bool SpaceExperience { get; set; }
    [Parameter] public bool Overview { get; set; }
    [Parameter] public bool Management { get; set; }
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public SpaceAccountPresentation? Presentation { get; set; }
    [Parameter] public RentalWorkspaceDefinition? Workspace { get; set; }
    [Parameter] public bool ServerAssignedNumber { get; set; }
    [Parameter] public string? EffectiveMonthLabel { get; set; }
    [Parameter] public string? AccountCountLabel { get; set; }
    [Parameter] public RenderFragment? AfterHero { get; set; }
    [Parameter] public RenderFragment? ToolbarMode { get; set; }
    private bool SupportsContractBasis => EEMOCantilanSDS.Domain.Entities.Revenue.ObligationAccount.IsMonthlySpaceKind(Kind);
    [Parameter] public bool ReadOnlyHistory { get; set; }
    [Parameter] public string? ReportsHref { get; set; }

    /// <summary>The bulk-import page for this line; the Import list action is offered only when there is one.</summary>
    [Parameter] public string? ImportHref { get; set; }
    private ObligationWorkspaceDto? _workspace;
    private string _search = string.Empty, _filter = "All";
    private string _lifecycle = "Active";
    private static readonly List<string> StatusFilters = new() { "All", "Paid", "Partial", "Unpaid" };
    private static readonly List<string> OverviewFilters = new() { "All", "Paid", "Partial", "Unpaid", "Closed" };
    private string RegistryCode => Kind == ObligationKind.FiestaArawLotRental ? "FA" : Kind == ObligationKind.KanmanggaySpaceRental ? "KM" : "Vegetable/Fruits";
    private static readonly IReadOnlyList<(string Value, string Label)> KmContractYearOptions =
        [("0", "No whole years"), ("1", "1 year"), ("2", "2 years"), ("3", "3 years"), ("5", "5 years"), ("custom", "Custom…")];
    // Match the existing NCC/TCC FhSelect presets, but permit no recorded term for Vegetable/Fruits.
    private static readonly IReadOnlyList<(string Value, string Label)> VfContractYearOptions =
        [("0", "Not recorded"), ("1", "1 year"), ("2", "2 years"), ("3", "3 years"), ("5", "5 years"), ("custom", "Custom…")];
    private bool _vfCustomYears;
    private void SetVfContractYears(string value)
    {
        _vfCustomYears = value == "custom";
        if (_vfCustomYears) _contractYears = 0;
        else if (int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var years)) _contractYears = years;
    }
    private bool _closedShortcut;
    private bool _advancedLifecycle;
    private string RegistryFilter => _closedShortcut ? "Closed" : _filter;
    private void SetLifecycle(ChangeEventArgs e) { _lifecycle = e.Value?.ToString() ?? "Active"; _closedShortcut = false; _advancedLifecycle = true; }
    private void SetRegistryFilter(string filter)
    {
        if (filter == "Closed") { _lifecycle = "Closed"; _filter = "All"; _closedShortcut = true; _advancedLifecycle = false; }
        else
        {
            if (!_advancedLifecycle) _lifecycle = "Active";
            _filter = filter; _closedShortcut = false;
        }
    }
    private double CollectionRate => _workspace is { Assessed: > 0m } w ? (double)Math.Min(100m, Math.Round(w.Collected / w.Assessed * 100m, 0)) : 0;
    private RenderFragment SpaceIcon => @<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>;
    private RenderFragment ActionBarContent => @<text>
        @if (Workspace is { } workspace)
        {
            <RentalWorkspaceNavigation Workspace="workspace" ShowManagement="@(!Management)">@RegistrationAction</RentalWorkspaceNavigation>
        }
        else
        { @LegacyActionBar }
    </text>;
    private RenderFragment RegistrationAction => @<AuthorizeView Roles="SuperAdmin"><Authorized>
        <button class="btn-primary" type="button" @onclick="OpenForm">+ Add New</button>
    </Authorized></AuthorizeView>;
    private RenderFragment LegacyActionBar => @<div class="obw-actions-bar">
        @if (Presentation is { } presentation)
        {
            <a class="btn-outline" href="@presentation.RosterHref">Space Holder List</a>
            @if (!Management) { <a class="btn-outline" href="@presentation.ManagementHref">Manage Space Holders</a> }
        }
        <a class="btn-outline" href="@ReportsHref">Reports</a>
        @RegistrationAction
    </div>;
    // The same two actions, with the same icons, as the stallholder Add New: bring the office's own list in, and look back at lists already brought in.
    private RenderFragment? ImportAction => string.IsNullOrWhiteSpace(ImportHref) ? null : @<div class="avm-import-group">
        <button type="button" class="btn-ghost avm-import-btn" disabled="@_saving" @onclick="OpenImport" title="Bulk import @(SupportsContractBasis ? "space holders" : "lot holders") from a file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
            Import list
        </button>
    </div>;
    private void OpenImport() { if (!_saving && !string.IsNullOrWhiteSpace(ImportHref)) Navigation.NavigateTo(ImportHref); }
    private string SubmitLabel => Kind == ObligationKind.FishMeatVendorFee ? "Open account" : Kind == ObligationKind.FiestaArawLotRental ? "Add Rent / Space Holder" : "Add Rent / Space Holder";
    private List<FacilityHero.HeroStat> SpaceStats => [
        new() { Label = "Collected", Value = _workspace is null ? "—" : Money(_workspace.Collected) },
        new() { Label = "Remaining", Value = _workspace is null ? "—" : Money(_workspace.Outstanding) },
        new() { Label = AccountCountLabel ?? $"Registered {SubjectNoun.ToLowerInvariant()}s", Value = _loading || _error is not null ? "—" : _accounts.Count.ToString(CultureInfo.InvariantCulture) }];
    private IEnumerable<ObligationAccountDto> VisibleAccounts => _accounts.Where(a =>
        (!SpaceExperience || (!Overview && _lifecycle == "All") || ((Overview ? _filter == "Closed" : _lifecycle == "Closed") ? !RentalAccountStatus.IsCurrent(a) : RentalAccountStatus.IsCurrent(a)))
        && (!SpaceExperience || _filter switch
        {
            "Paid" => a.AssessedToDate > 0m && a.OutstandingToDate == 0m,
            "Partial" => a.CollectedToDate > 0m && a.OutstandingToDate > 0m,
            "Unpaid" => a.CollectedToDate == 0m,
            _ => true
        })
        && (string.IsNullOrWhiteSpace(_search) || a.SubjectLabel.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || SpaceAccountPresentation.Occupant(a).Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private string AmountHeading => Kind == ObligationKind.FiestaArawLotRental ? "Approved amount" : "Approved monthly";

    private List<ObligationAccountDto> _accounts = [];
    private List<ObligationQuoteDto> _register = [];
    private List<VendorFeeStallDto> _stalls = [];
    private bool _loading = true;
    private bool _registerLoading;
    private int _registerRequest;
    private string? _registerError;
    private string? _error;
    private Guid? _selected;

    private bool _opening;
    private CreateObligationAccountRequest? _advanceRequest;
    private ObligationAccountDto? _rateFor;
    private ObligationAccountDto? _editFor;
    private bool _saving;
    private bool _signedContract = true;
    private string _contractRef = string.Empty;
    private string _contractName = string.Empty;
    private string _areaLocation = string.Empty;
    private decimal? _areaSqm;
    /// <summary>What the signed contract states per month; evidence recorded on the account, never what is billed.</summary>
    private decimal? _contractRate;
    private int _contractYears = 3;
    /// <summary>Optional extra months beyond the years (0 = none). With 0 years it is a months-only term.</summary>
    private int _contractMonths;

    // Cantilan defaults Kanmanggay's signed term to three years but permits the actual recorded duration. For another office the server
    // refuses to record one until a duration policy is confirmed, so the form does not offer the choice (and never sends one).
