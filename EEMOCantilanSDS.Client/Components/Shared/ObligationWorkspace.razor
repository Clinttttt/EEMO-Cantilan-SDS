                            <input id="obw-area" type="number" class="avm-input" min="0" max="1000000" step="0.01" placeholder="Area if recorded" @bind="_areaSqm" />
                        </div></div>
                    </AddNewSection>
                }
                else
                {
                @if (Kind == ObligationKind.FiestaArawLotRental)
                {
                    @* An event is a one-time rental; reuse the NCC/TCC rental form grid without pretending it has a multi-year lease. *@
                    <RentalContractFields Title="Rent / Space & Event Details">
                        <SourceField>
                            <div class="avm-group">
                                <label class="avm-label">Operation</label>
                                <div class="avm-input avm-input-locked">@Name</div>
                            </div>
                        </SourceField>
                        <NumberField>
                            <div class="avm-group">
                                <label class="avm-label" for="obw-subject">Rent / Space No.</label>
                                <input id="obw-subject" class="avm-input" type="text" maxlength="120"
                                       placeholder="Assigned automatically" @bind="_subject" />
                            </div>
                        </NumberField>
                        <EffectivityField>
                            <div class="avm-group">
                                <label class="avm-label" for="obw-event-date">Event date <span class="avm-req">*</span></label>
                                <input id="obw-event-date" class="avm-input" type="date" required @bind="_eventDate" />
                            </div>
                        </EffectivityField>
                        <TermField>
                            <div class="avm-group">
                                <label class="avm-label">Event <span class="avm-req">*</span></label>
