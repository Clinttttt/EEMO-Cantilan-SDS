    protected override void OnParametersSet()
    {
        // Fail closed on a miswired presentation adapter; never map one source into another.
        if (Workspace is { Source: MonthlySpaceRentalSource monthly } && monthly.Kind != Kind
            || Workspace is { Source: EventLotRentalSource eventLot } && eventLot.Kind != Kind
            || Workspace?.Source is FacilityRentalSource)
            throw new InvalidOperationException("The rental presentation does not match this obligation source.");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (Management && AccountId is { } id && _accounts.FirstOrDefault(a => a.Id == id) is { } selected)
        {
            _lifecycle = RentalAccountStatus.IsOpen(selected) ? "Active" : "Closed";
            await ToggleRegisterAsync(id);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _workspace = null;
        _accounts = [];
        try
        {
            if (SpaceExperience)
            {
                var workspace = await ObligationsApi.GetWorkspaceAsync(Kind);
                _workspace = workspace.IsSuccess ? workspace.Value : null;
                _accounts = _workspace?.Accounts.Where(a => a.Kind == Kind).ToList() ?? [];
                if (!workspace.IsSuccess) _error = workspace.Error ?? $"{Name} accounts couldn't be loaded.";
                return;
            }
            var result = await ObligationsApi.GetAccountsAsync(Kind);
            if (result.IsSuccess) _accounts = result.Value?.Where(a => a.Kind == Kind).ToList() ?? [];
            else { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        }
        catch { _accounts = []; _error = $"{Name} accounts couldn't be loaded."; }
        finally { _loading = false; }
    }

    private async Task ToggleRegisterAsync(Guid accountId)
    {
        if (_selected == accountId) { _selected = null; return; }
        _selected = accountId;
        await LoadRegisterAsync(accountId);
    }

    private async Task LoadRegisterAsync(Guid accountId)
    {
        var request = ++_registerRequest;
        _register = [];
        _registerError = null;
        _registerLoading = true;
        try
        {
            var result = await ObligationsApi.GetRegisterAsync(accountId);
            if (request != _registerRequest || _selected != accountId) return;
            _register = result.IsSuccess ? result.Value?.ToList() ?? [] : [];
            if (!result.IsSuccess) _registerError = result.Error ?? "Periods could not be loaded.";
        }
        catch { if (request == _registerRequest && _selected == accountId) { _register = []; _registerError = "Periods could not be loaded."; } }
        finally { if (request == _registerRequest) _registerLoading = false; }
    }

