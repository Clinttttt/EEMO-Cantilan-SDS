@* A show/hide control for a masked password field.

   One component rather than the same two icons pasted at every password box: the office types passwords into the
   two-factor dialogs, the restore prompts, the payment-credential fields and the sign-in pages, and typing a password you
   cannot see into a form that only reports "incorrect" gives no way to tell a typo from a wrong password — while the
   failed attempts count towards a lockout.

   Place it inside a positioned wrapper (.pw-reveal-wrap, or the sign-in pages' .form-input-wrap); the button is absolutely
   positioned against it. Kept out of the tab order so Tab still runs label, field, submit. *@

<button type="button"
        class="form-eye-btn"
        tabindex="-1"
        title="@Label"
        aria-label="@Label"
        @onclick="Toggle"
        @onclick:stopPropagation="true">
    @if (Shown)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" />
            <line x1="1" y1="1" x2="23" y2="23" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
            <circle cx="12" cy="12" r="3" />
        </svg>
    }
</button>

@code {
    /// <summary>Whether the field is currently revealed.</summary>
    [Parameter] public bool Shown { get; set; }

    /// <summary>Raised with the new state, so the field's own flag stays owned by its page.</summary>
    [Parameter] public EventCallback<bool> ShownChanged { get; set; }

    private string Label => Shown ? "Hide password" : "Show password";

    private Task Toggle() => ShownChanged.InvokeAsync(!Shown);
}
