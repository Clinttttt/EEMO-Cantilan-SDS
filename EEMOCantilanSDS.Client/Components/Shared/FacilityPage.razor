@typeparam TStall where TStall : class, new()
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Application.Dtos.Stalls
@using EEMOCantilanSDS.Application.Dtos.Payments
@using EEMOCantilanSDS.Client.Services
@inject IStallsApiClient StallsApi
@inject IPaymentsApiClient PaymentsApi
@inject IFacilitiesApiClient FacilitiesApi
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Client.Services.FacilityState Facilities

<OperationTopbar Title="@Facilities.NameOf(FacilityCodeEnum)" Crumb="@Facilities.ShortNameOf(FacilityCodeEnum)" />

<div class="content-area">
            @if (Workspace is { } workspace)
            {
                <RentalWorkspaceHero Workspace="workspace" Icon="@FacilityIcon" Stats="@HeroStats"
                                     Scope="@PhilippineTime.Today.ToString("MMMM yyyy")" ProgressPercentage="@CollectionRate" />
            }
            else
            {
            <FacilityHero Code="FacilityCodeEnum"
                          Icon="@FacilityIcon"
                          Stats="@HeroStats"
                          ShowProgress="true"
                          ProgressPercentage="@CollectionRate" />
            }

            <Toolbar SearchQuery="@SearchQuery"
                     OnSearch="OnSearchInput"
                     ActiveFilter="@ActiveStatus"
                     OnFilterChanged="OnFilterChange"
                     Filters="@StatusFilters"
                     ShowSearch="true"
                     SearchPlaceholder="@($"Search {SpaceWord.ToLowerInvariant()} no. or occupant…")"
                     MiddleContent="@ActionBarContent"
                     Actions="@ToolbarActions">
            </Toolbar>

            @if (FacilityCodeEnum == FacilityCode.NPM)
            {
                <div style="display:flex;align-items:center;gap:12px;margin:0 0 12px;max-width:330px;">
                    <span style="white-space:nowrap;font-size:13px;">Market section</span>
                    <FhSelect Block="true" Value="@_marketAreaFilter" Options="MonthlyMarketAreaFilters"
                              ValueChanged="v => _marketAreaFilter = v" />
                </div>
            }

            <RentalSummaryStrip Title="@(FacilityCodeEnum == FacilityCode.NCC ? "Stall Rent" : $"All {SpaceWord}s")"
                                Description="@FacilityDescription" Paid="PaidCount" Unpaid="UnpaidCount" Partial="PartialCount"
                                Collected="@(_summary is null ? "—" : $"₱{_summary.TotalRevenue:N0}")" />

            <FacilityStallsTable TStall="TStall"
                                 Facility="@FacilityShortCode"
                                 ColumnSet="MonthlyTable"
                                 IsLoading="_loading"
                                 FilteredStalls="FilteredStalls"
                                 OnPaymentClick="OpenPayment"
                                 OnHistoryClick="OpenHistory"
                                 OnEditClick="OpenEdit" />
        </div>

<CollectionReceiptModal Show="ShowPayment"
                        FacilityName="@FacilityName"
                        PeriodLabel="@PhilippineTime.Now.ToString("MMMM yyyy")"
                        StallNo="@(PaymentStall is null ? string.Empty : StallNoSelector(PaymentStall))"
                        PayorName="@(PaymentStall is null ? string.Empty : ActualOccupantSelector(PaymentStall))"
                        OrNumber="@(PaymentStall is null ? string.Empty : GetStallOr(PaymentStall))"
                        Lines="MonthlyReceiptLines"
                        TotalLabel="Total Paid"
                        TotalValue="@($"₱{ReceiptPaidAmount:N2}")"
                        NoteText="This acknowledges receipt of the monthly rental payment stated above. Keep for your records."
                        OnClose="ClosePayment" />

<PaymentHistoryModal TStall="TStall"
                     Show="ShowHistory"
                     Stall="HistoryStall"
                     OnClose="() => ShowHistory = false" />

<AddVendorModal Show="ShowAddVendorModal"
                IsEditing="false"
                Form="VendorForm"
                @bind-FormError="VendorErrorMessage"
                FieldErrors="VendorFieldErrors"
                FacilityOptions="FacilityOptions"
                CustomSectionNames="_marketCustomSections"
                FacilityLocked="true"
                ExistingStallNos="FacilityStallNos"
                ReuseOfferMessage="@_vendorReuseOffer"
                OnReuseConfirm="ConfirmStallTakeOverAsync"
                OnSave="SubmitAddVendor"
                OnCancel="CloseAddVendorModal"
                OnFacilityChanged="() => {}"
                OnSectionChanged="() => {}"
                OnToggleFee="ToggleVendorFee" />


@code {
    [Parameter] public FacilityCode FacilityCodeEnum { get; set; }
    [Parameter] public RentalWorkspaceDefinition? Workspace { get; set; }
    [Parameter] public string FacilityName { get; set; } = string.Empty;
    [Parameter] public string FacilityShortCode { get; set; } = string.Empty;
    [Parameter] public string FacilityDescription { get; set; } = string.Empty;
    [Parameter] public RenderFragment FacilityIcon { get; set; } = null!;
    [Parameter] public decimal DefaultMonthlyRate { get; set; }
    [Parameter] public List<string> DefaultFeeTypes { get; set; } = new();
    [Parameter] public Func<Application.Dtos.Stalls.StallDto, bool, bool, decimal, string, TStall> StallMapper { get; set; } = null!;
    [Parameter] public Func<TStall, bool> IsPaidSelector { get; set; } = null!;
    [Parameter] public Func<TStall, bool> IsPartialSelector { get; set; } = null!;
    [Parameter] public Func<TStall, bool> IsActiveSelector { get; set; } = null!;
    [Parameter] public Func<TStall, decimal> MonthlyRateSelector { get; set; } = null!;
    [Parameter] public Func<TStall, decimal> PartialAmountSelector { get; set; } = null!;
    [Parameter] public Func<TStall, string> StallNoSelector { get; set; } = null!;
    [Parameter] public Func<TStall, string> ActualOccupantSelector { get; set; } = null!;
    [Parameter] public Func<TStall, string> ContractNameSelector { get; set; } = null!;
    [Parameter] public Func<TStall, MarketSection?>? MarketSectionSelector { get; set; }
    [Parameter] public Func<TStall, string?>? CustomMarketSectionSelector { get; set; }
    [Parameter] public Action<TStall, string> ORNumberSetter { get; set; } = null!;
    [Parameter] public string? ReportsUrl { get; set; }

    protected override void OnParametersSet()
    {
        if (Workspace is not null && Workspace.Source != new FacilityRentalSource(FacilityCodeEnum))
            throw new InvalidOperationException("The rental presentation does not match this facility source.");
    }

    private string SearchQuery = string.Empty;
    private string ActiveStatus = "All";
    private readonly List<string> StatusFilters = new() { "All", "Paid", "Partial", "Unpaid", "Closed" };
    
    private List<TStall> Stalls = new();
    private readonly DateTime _statePeriod = PhilippineTime.Now;
    private bool _loading = true;
    private bool ShowPayment = false;
    private TStall? PaymentStall = null;
    private bool ShowHistory = false;
    private TStall? HistoryStall = null;
    
    private bool ShowAddVendorModal { get; set; }
    private string VendorErrorMessage { get; set; } = string.Empty;
    private Dictionary<string, string> VendorFieldErrors { get; set; } = new();
    private AddVendorModal.VendorModalForm VendorForm = new();
    private List<string> _marketCustomSections = [];
    private string _marketAreaFilter = "all";

    [PersistentState(AllowUpdates = true)]
    public FacilityPagePersistentState? CachedFacilityState { get; set; }

    // Existing stall numbers for this facility — feeds the modal's next-number suggestion.
    private IReadOnlyCollection<string> FacilityStallNos => Stalls.Select(StallNoSelector).ToList();

    protected override async Task OnInitializedAsync()
    {
        // Load the tenant's facility catalog in the background — it only gates the Reports button
        // (CanShowReports defaults to visible until loaded), so it must never delay navigation/first paint.
        _ = LoadFacilityCatalogAsync();
        _loading = true;

        if (CachedFacilityState is not null
            && CachedFacilityState.FacilityCode == FacilityCodeEnum
            && CachedFacilityState.Year == _statePeriod.Year
            && CachedFacilityState.Month == _statePeriod.Month)
        {
            // The persisted stall roster does not cache tenant-defined section names.
            if (FacilityCodeEnum == FacilityCode.NPM)
            {
                var sectionsResult = await FacilitiesApi.GetNpmCustomSectionsAsync();
                _marketCustomSections = sectionsResult.IsSuccess && sectionsResult.Value is not null
                    ? sectionsResult.Value.Where(s => !s.IsClosed).Select(s => s.Name).ToList()
                    : [];
            }
            LoadStallsFromPersistentState(CachedFacilityState);
            _loading = false;
            return;
        }

        CachedFacilityState = null;

        await PaintLoadingStateAsync();

        try { await LoadStallsFromApi(); }
        finally
        {
            _loading = false;
        }
    }

    private async Task PaintLoadingStateAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private async Task LoadStallsFromApi()
    {
        if (FacilityCodeEnum == FacilityCode.NPM)
        {
            var sectionsResult = await FacilitiesApi.GetNpmCustomSectionsAsync();
            _marketCustomSections = sectionsResult.IsSuccess && sectionsResult.Value is not null
                ? sectionsResult.Value.Where(s => !s.IsClosed).Select(s => s.Name).ToList()
                : [];
        }
        var summary = await FacilitiesApi.GetFacilityReportsAsync(FacilityCodeEnum, ReportPeriod.Monthly, _statePeriod.Year, _statePeriod.Month);
        _summary = summary?.IsSuccess == true ? summary.Value : null;
        var stallsTask = StallsApi.GetStallsByFacilityPaginatedAsync(FacilityCodeEnum, null, null, 100);
        var paymentsTask = PaymentsApi.GetFacilityPaymentRecordsAsync(FacilityCodeEnum, _statePeriod.Year, _statePeriod.Month);

        await Task.WhenAll(stallsTask, paymentsTask);

        var result = await stallsTask;
        if (result.IsSuccess && result.Value != null)
        {
            // Single batch call for all current-month payment records (avoids per-stall N+1)
            var paymentsResult = await paymentsTask;
            var stallDtos = result.Value.Items.ToList();
            var paymentDtos = paymentsResult.IsSuccess && paymentsResult.Value != null
                ? paymentsResult.Value.ToList()
                : new List<FacilityPaymentRecordDto>();

            CachedFacilityState = new FacilityPagePersistentState(
                FacilityCodeEnum,
                _statePeriod.Year,
                _statePeriod.Month,
                stallDtos,
                paymentDtos,
                _summary);
            RebuildStalls(stallDtos, paymentDtos);
        }
    }

    private void LoadStallsFromPersistentState(FacilityPagePersistentState state)
    {
        RebuildStalls(state.Stalls, state.Payments);
        _summary = state.Summary;
    }

    private EEMOCantilanSDS.Application.Dtos.Facilities.FacilityReportsDto? _summary;

    private void RebuildStalls(IReadOnlyList<StallDto> stallDtos, IReadOnlyList<FacilityPaymentRecordDto> paymentDtos)
    {
        var payments = paymentDtos.ToDictionary(p => p.StallId);
        Stalls.Clear();

        // Only list payors whose contract is still within its duration; expired-contract active
        // stalls are excluded from the facility view (StallContractStatus.IsCurrentVendor).
        foreach (var dto in stallDtos.Where(StallContractStatus.IsCurrentVendor))
        {
            bool isPaid = false;
            bool isPartial = false;
            decimal partialAmount = 0;
            string orNumber = dto.ORNumber ?? string.Empty;

            if (payments.TryGetValue(dto.Id, out var payment))
            {
                isPaid = payment.Status == PaymentStatus.Paid;
                isPartial = payment.Status == PaymentStatus.Partial;
                partialAmount = payment.TotalPaid;
                orNumber = payment.ORNumber ?? dto.ORNumber ?? string.Empty;
            }

            Stalls.Add(StallMapper(dto, isPaid, isPartial, partialAmount, orNumber));
        }
    }

    private IEnumerable<TStall> ActiveStalls => Stalls.Where(IsActiveSelector);
    private int ActiveStallsCount => ActiveStalls.Count();
    private decimal TotalCollected => ActiveStalls.Where(s => IsPaidSelector(s) || IsPartialSelector(s))
        .Sum(s => IsPartialSelector(s) ? PartialAmountSelector(s) : MonthlyRateSelector(s));
    private decimal TotalPending => ActiveStalls.Where(s => !IsPaidSelector(s))
        .Sum(s => MonthlyRateSelector(s) - (IsPartialSelector(s) ? PartialAmountSelector(s) : 0));
    private List<FacilityHero.HeroStat> HeroStats => new()
    {
        new() { Value = _summary is null ? "—" : $"₱{_summary.TotalRevenue:N0}", Label = "Collected" },
        new() { Value = _summary is null ? "—" : $"₱{_summary.PendingPaymentAmount:N0}", Label = "Pending" },
        new() { Value = _summary is null ? "—" : $"{_summary.CollectionRate:N0}%", Label = "Collection Rate" },
        new() { Value = _summary?.TotalStalls.ToString() ?? "—", Label = $"Total {SpaceWord}s" }
    };
    private int CollectionRate => ActiveStallsCount > 0 ? (int)((double)ActiveStalls.Count(IsPaidSelector) / ActiveStallsCount * 100) : 0;

    private IEnumerable<TStall> FilteredStalls => Stalls.Where(s =>
    {
        bool matchStatus = ActiveStatus switch
        {
            "Paid" => IsPaidSelector(s) && !IsPartialSelector(s) && IsActiveSelector(s),
            "Partial" => IsPartialSelector(s) && IsActiveSelector(s),
            "Unpaid" => !IsPaidSelector(s) && !IsPartialSelector(s) && IsActiveSelector(s),
            // Closed OR lapsed: both are off the list of spaces being let, and the office reads their balances on the
            // follow-up queue and the register of inactive accounts.
            "Closed" => !IsActiveSelector(s),
            _ => IsActiveSelector(s)
        };
        bool matchSearch = string.IsNullOrWhiteSpace(SearchQuery)
            || ActualOccupantSelector(s).Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || StallNoSelector(s).Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || ContractNameSelector(s).Contains(SearchQuery, StringComparison.OrdinalIgnoreCase);
        return matchStatus && matchSearch && MatchesMonthlyMarketArea(s);
    }).OrderBy(s => NaturalStallKey(StallNoSelector(s)), StringComparer.Ordinal);

    private IReadOnlyList<(string Value, string Label)> MonthlyMarketAreaFilters =>
        new List<(string Value, string Label)>
        {
            ("all", "All Sections"),
            ("section:VegetableArea", Facilities.SectionLabelOf(FacilityCode.NPM, MarketSection.VegetableArea)),
            ("section:FishSection", Facilities.SectionLabelOf(FacilityCode.NPM, MarketSection.FishSection)),
            ("section:MeatSection", Facilities.SectionLabelOf(FacilityCode.NPM, MarketSection.MeatSection))
        }.Concat(_marketCustomSections.Select(name => ($"custom:{name}", name))).ToList();

    private bool MatchesMonthlyMarketArea(TStall stall)
    {
        if (FacilityCodeEnum != FacilityCode.NPM || _marketAreaFilter == "all") return true;
        if (_marketAreaFilter.StartsWith("section:", StringComparison.Ordinal))
            return string.Equals(MarketSectionSelector?.Invoke(stall)?.ToString(),
                _marketAreaFilter["section:".Length..], StringComparison.Ordinal);
        if (_marketAreaFilter.StartsWith("custom:", StringComparison.Ordinal))
            return string.Equals(CustomMarketSectionSelector?.Invoke(stall),
                _marketAreaFilter["custom:".Length..], StringComparison.OrdinalIgnoreCase);
        return false;
    }

    // Orders stall numbers naturally ("2" before "10") by zero-padding digit runs, matching the
    // backend report ordering. Plain string ordering put "10" before "2".
    private static string NaturalStallKey(string stallNo) =>
        string.IsNullOrEmpty(stallNo)
            ? string.Empty
            : System.Text.RegularExpressions.Regex.Replace(stallNo, "[0-9]+", m => m.Value.PadLeft(12, '0'));

    private int PaidCount => ActiveStalls.Count(IsPaidSelector);
    private int UnpaidCount => ActiveStalls.Count(s => !IsPaidSelector(s) && !IsPartialSelector(s));
    private int PartialCount => ActiveStalls.Count(IsPartialSelector);
    private decimal CollectedAmount => ActiveStalls.Where(IsPaidSelector).Sum(MonthlyRateSelector);

    // Reports are only offered for facilities the current tenant actually operates. While the
    // FacilityState catalog is still loading (Count == 0) the action is allowed so it never flickers off.
    private bool CanShowReports => !string.IsNullOrEmpty(ReportsUrl)
        && (Facilities.All.Count == 0 || Facilities.All.Contains(FacilityCodeEnum));

    private async Task LoadFacilityCatalogAsync()
    {
        await Facilities.EnsureLoadedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private List<Toolbar.ToolbarAction> ToolbarActions
    {
        get
        {
            var actions = new List<Toolbar.ToolbarAction>();
            if (CanShowReports)
            {
                actions.Add(new()
                {
                    Label = "Reports",
                    Icon = """<svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z" /></svg>""",
                    ClassName = "btn-outline",
                    Title = "View Facility Reports & Analytics",
                    OnClickHandler = async () =>
                    {
                        Navigation.NavigateTo(ReportsUrl!);
                        await Task.CompletedTask;
                    }
                });
            }
            actions.Add(new()
            {
                Label = "Add New",
                Icon = """<svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>""",
                ClassName = "btn-primary",
                Title = $"Add a new {SpaceWord.ToLowerInvariant()}",
                OnClickHandler = async () => { OpenAddVendorModal(); await Task.CompletedTask; }
            });
            return actions;
        }
    }

    private RenderFragment ActionBarContent => @<text>
        @if (Workspace is { } workspace)
        { <RentalWorkspaceNavigation Workspace="workspace" ShowReports="false" /> }
        else
        { <ActionBar Facility="@FacilityShortCode.ToLower()" /> }
    </text>;

    private async Task OnSearchInput(string value) => SearchQuery = value;
    private async Task OnFilterChange(string filter) => ActiveStatus = filter;

    private void OpenPayment(TStall s)
    {
        PaymentStall = s;
        ShowPayment = true;
    }

    private void ClosePayment()
    {
        ShowPayment = false;
        PaymentStall = null;
    }

    private async Task HandleSavePayment(FacilityPaymentModal<TStall>.PaymentSubmitDto payment)
    {
        if (PaymentStall != null)
        {
            ORNumberSetter(PaymentStall, payment.OrNumber);
            await LoadStallsFromApi();
            ShowPayment = false;
            PaymentStall = null;
        }
    }

    // The amount actually paid this month (Paid → full rent, Partial → partial, else 0).
    private decimal ReceiptPaidAmount => PaymentStall is null ? 0m
        : IsPaidSelector(PaymentStall) ? MonthlyRateSelector(PaymentStall)
        : IsPartialSelector(PaymentStall) ? PartialAmountSelector(PaymentStall)
        : 0m;

    // Monthly-rental lines for the receipt (rate + remaining balance).
    private IReadOnlyList<CollectionReceiptModal.ReceiptLine> MonthlyReceiptLines
    {
        get
        {
            if (PaymentStall is null) return Array.Empty<CollectionReceiptModal.ReceiptLine>();
            var rate = MonthlyRateSelector(PaymentStall);
            var balance = Math.Max(0m, rate - ReceiptPaidAmount);
            return new List<CollectionReceiptModal.ReceiptLine>
            {
                new("Monthly Rental", $"₱{rate:N2}"),
                new("Balance Due", $"₱{balance:N2}")
            };
        }
    }

    // Each facility's stall model exposes an OR property (OrNumber/ORNumber) — read it generically.
    private static string GetStallOr(TStall stall)
    {
        var prop = stall?.GetType().GetProperty(
            "OrNumber",
            System.Reflection.BindingFlags.Public
            | System.Reflection.BindingFlags.Instance
            | System.Reflection.BindingFlags.IgnoreCase);
        return prop?.GetValue(stall) as string ?? string.Empty;
    }

    private void OpenHistory(TStall s)
    {
        HistoryStall = s;
        ShowHistory = true;
    }

    private void OpenEdit(TStall s) => Navigation.NavigateTo($"/profile/{FacilityShortCode.ToLower()}/{StallNoSelector(s)}");

    private List<AddVendorModal.VendorFacilityOption> FacilityOptions => new()
    {
        new() { Code = FacilityCodeEnum == FacilityCode.NPM ? nameof(FacilityCode.NPM) : FacilityShortCode, Name = FacilityName }
    };

    private void OpenAddVendorModal()
    {
        VendorForm = new()
        {
            FacilityCode = FacilityCodeEnum == FacilityCode.NPM ? nameof(FacilityCode.NPM) : FacilityShortCode,
            StallNo = string.Empty,
            ActualOccupant = string.Empty,
            ContractName = string.Empty,
            SelectedSection = string.Empty,
            AreaSqm = 0,
            MonthlyRate = DefaultMonthlyRate,
            ContractDate = PhilippineTime.Now.Date,
            ContractYears = 3,
            AreaLocation = string.Empty,
            FeeTypes = new(DefaultFeeTypes)
        };
        VendorErrorMessage = string.Empty;
        VendorFieldErrors.Clear();
        ShowAddVendorModal = true;
        StateHasChanged();
    }

    private void CloseAddVendorModal()
    {
        ShowAddVendorModal = false;
        VendorForm = new();
        VendorErrorMessage = string.Empty;
        VendorFieldErrors.Clear();
        // The handover offer belongs to the attempt that raised it. Leaving it set put a stale dialog over the
        // next blank form, and left the take-over flag armed for a stall nobody had asked about.
        _vendorReuseOffer = null;
        _takeOverVacatedStall = false;
    }

    private void ToggleVendorFee(string fee)
    {
        if (VendorForm.FeeTypes.Contains(fee))
            VendorForm.FeeTypes.Remove(fee);
        else
            VendorForm.FeeTypes.Add(fee);
    }

    private async Task SubmitAddVendor()
    {
        VendorErrorMessage = string.Empty;
        VendorFieldErrors.Clear();

        var fees = ApplicableFees.BaseRental;
        if (VendorForm.FeeTypes.Contains("Electricity"))
            fees |= ApplicableFees.Electricity;
        if (VendorForm.FeeTypes.Contains("Water"))
            fees |= ApplicableFees.Water;

        NccAreaLocation? nccAreaLocation = null;
        string? nccAreaNote = null;
        if (FacilityCodeEnum == FacilityCode.NCC && !string.IsNullOrWhiteSpace(VendorForm.AreaLocation))
        {
            var raw = VendorForm.AreaLocation.Trim();
            nccAreaNote = raw;   // preserve the exact label so custom municipality area names are kept + shown
            // Map the standard labels to the enum (keeps Cantilan's NCC section reports intact); any other
            // custom name stays as free text (no fixed bucket) — the label still displays via AreaNote.
            nccAreaLocation = raw.Equals("Extension", StringComparison.OrdinalIgnoreCase) ? NccAreaLocation.Extension
                : raw.Equals("Corner", StringComparison.OrdinalIgnoreCase) ? NccAreaLocation.Corner
                : raw.Equals("Standard", StringComparison.OrdinalIgnoreCase) ? NccAreaLocation.Standard
                : (NccAreaLocation?)null;
        }

        MarketSection? npmSection = null;
        string? npmCustomSection = null;
        // A monthly-rented market may file a stall under no section; the server allows it.
        if (FacilityCodeEnum == FacilityCode.NPM
            && !(Facilities.IsMonthlyRentMarket && string.IsNullOrEmpty(VendorForm.SelectedSection)))
        {
            var chosen = MonthlyMarketSectionSelection.Resolve(VendorForm.SelectedSection, VendorForm.CustomSectionName);
            if (chosen.Error is not null)
            {
                VendorFieldErrors["Section"] = chosen.Error;
                return;
            }
            npmSection = chosen.Section;
            npmCustomSection = chosen.CustomSectionName;
            if (npmSection == MarketSection.FishSection) fees |= ApplicableFees.FishFee;
        }

        var command = new Application.Command.Stalls.CreateStall.CreateStallCommand(
            FacilityCodeEnum,
            VendorForm.StallNo.Trim(),
            VendorForm.MonthlyRate,
            fees,
            npmSection,
            nccAreaLocation,
            VendorForm.AreaSqm > 0 ? VendorForm.AreaSqm : null,
            nccAreaNote,
            null,
            VendorForm.ActualOccupant.Trim(),
            string.IsNullOrWhiteSpace(VendorForm.ContractName) ? null : VendorForm.ContractName.Trim(),
            VendorForm.ContractDate,
            VendorForm.ContractYears,
            CustomSectionName: npmCustomSection,
            ReuseVacatedStall: _takeOverVacatedStall,
            Arrangement: VendorForm.Arrangement,
            ContractMonths: VendorForm.ContractMonths > 0 ? VendorForm.ContractMonths : null);

        var result = await StallsApi.CreateStallAsync(command);

        if (result.IsSuccess)
        {
            await LoadStallsFromApi();
            CloseAddVendorModal();
        }
        else
        {
            if (result.ValidationErrors != null && result.ValidationErrors.Any())
            {
                foreach (var error in result.ValidationErrors)
                {
                    VendorFieldErrors[error.Key] = error.Value.FirstOrDefault() ?? string.Empty;
                }
            }
            else
            {
                VendorErrorMessage = result.Error ?? "Failed to create stall. Please check all required fields.";
            }
            _takeOverVacatedStall = false;   // one confirmation per attempt
            OfferStallTakeOverIfDuplicate();
            StateHasChanged();
        }
    }

    // ── Taking over a vacated space ───────────────────────────────────────────────────────────────────
    // A facility has a fixed number of physical spaces. When an occupant leaves, the space stays — so the office must
    // be able to put the next occupant in Space 1 rather than being pushed into inventing a number beyond the
    // building. The record, its number and its whole history are kept; only a new occupancy begins on it. The server
    // refuses if that space is in fact still occupied, so this only ever offers what is actually possible.
    private bool _takeOverVacatedStall;
    private string? _vendorReuseOffer;

    private async Task ConfirmStallTakeOverAsync()
    {
        _takeOverVacatedStall = true;
        _vendorReuseOffer = null;
        VendorFieldErrors.Remove("StallNo");
        VendorErrorMessage = string.Empty;
        await SubmitAddVendor();
    }

    /// <summary>
    /// Turns the validator's flat "already exists" into an offer the office can act on. Worded conditionally, because
    /// only the server knows whether that space is closed, lapsed, or genuinely occupied.
    /// </summary>
    private void OfferStallTakeOverIfDuplicate()
    {
        var duplicate = VendorFieldErrors.TryGetValue("StallNo", out var message)
            && message.Contains("already exists", StringComparison.OrdinalIgnoreCase);

        var label = SpaceWord;
        _vendorReuseOffer = duplicate
            ? $"{label} {VendorForm.StallNo.Trim()} already exists here. If it was closed or its occupancy has ended, "
              + $"you can assign {(string.IsNullOrWhiteSpace(VendorForm.ActualOccupant) ? "the new occupant" : VendorForm.ActualOccupant.Trim())} "
              + $"to it — the {label.ToLowerInvariant()} keeps its number and its full history, and a new occupancy begins."
            : null;
    }

    /// <summary>
    /// Shared facility vocabulary for headings, search, counters and registration actions.
