@using EEMOCantilanSDS.Application.Command.Facilities.UpdateFacility
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IFacilitiesApiClient FacilitiesApi
@inject FacilityState FacilityCatalog
@inject AuthenticationStateProvider AuthState

@*
    Renames a market section's label — or clears it back to the office's default — from wherever the label is
    shown, so the Head does not have to go to Facility Configuration to correct a name.

    Only the three canonical sections can be renamed here: their label belongs to the FACILITY, so one edit is
    consistent everywhere. A per-LGU custom section's name lives on its stalls, which is a different (and much
    heavier) operation, so no pencil is offered for those.

    Only the Head sees the pencil — the API's facility endpoints are SuperAdmin-only, and offering a control
    that can only end in "forbidden" is worse than not offering it.

    Never printed: the affordance carries `no-print` and its own print rule.
*@

@if (_section is not null && _isHead)
{
    <span class="slp no-print">
        <button type="button" class="slp-btn" title="Rename @Label" aria-label="Rename @Label"
                @onclick="Open" @onclick:stopPropagation="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
            </svg>
        </button>

        @if (_open)
        {
            <span class="slp-pop" @onclick:stopPropagation="true">
                <span class="slp-pop-title">Section name</span>
                <input class="slp-input" type="text" value="@_draft" @oninput="OnInput"
                       placeholder="@DefaultLabel" maxlength="40" aria-label="Section name" />
                <span class="slp-pop-hint">Leave empty to use the default name (@DefaultLabel).</span>

                @if (_error is not null)
                {
                    <span class="slp-pop-error">@_error</span>
                }

                <span class="slp-pop-actions">
                    <button type="button" class="slp-cancel" @onclick="Close" disabled="@_busy">Cancel</button>
                    @if (!IsDefault)
                    {
                        <button type="button" class="slp-clear" @onclick="UseDefault" disabled="@_busy">Use default</button>
                    }
                    <button type="button" class="slp-save" @onclick="Save" disabled="@_busy">
                        @(_busy ? "Saving…" : "Save")
                    </button>
                </span>
            </span>
        }
    </span>
}

@code {
    /// <summary>The facility whose section label is being edited.</summary>
    [Parameter, EditorRequired] public FacilityCode Facility { get; set; }

    /// <summary>
    /// The section as it is keyed across the app — the canonical label ("Vegetable Area") or a custom section's
    /// own name. A custom section resolves to no enum and therefore shows no pencil.
    /// </summary>
    [Parameter, EditorRequired] public string SectionKey { get; set; } = string.Empty;

    /// <summary>Raised after a successful save so the host can reload what it shows.</summary>
    [Parameter] public EventCallback OnRenamed { get; set; }

    private MarketSection? _section;
    private bool _open;
    private bool _busy;
    private bool _isHead;
    private string _draft = string.Empty;
    private string? _error;

    private string DefaultLabel => _section is { } s ? FacilityState.CanonicalSectionLabel(s) : SectionKey;
    private string Label => _section is { } s ? FacilityCatalog.SectionLabelOf(Facility, s) : SectionKey;
    private bool IsDefault => string.Equals(Label, DefaultLabel, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        // SuperAdmin = the LGU's Head. Any tenant's Head may rename their own facility's sections.
        var state = await AuthState.GetAuthenticationStateAsync();
        _isHead = state.User.IsInRole("SuperAdmin")
            || state.User.Claims.Any(c =>
                string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
                && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnParametersSet() =>
        _section = FacilityState.SectionFromCanonical(SectionKey)
                   ?? FacilityState.SectionFromCanonical(CanonicalOf(SectionKey));

    /// <summary>
    /// A host may pass the label the office sees ("Gulayan") rather than the canonical key. Map it back by
    /// asking the catalogue which canonical section currently displays that label.
    /// </summary>
    private string? CanonicalOf(string displayed)
    {
        foreach (var candidate in new[] { MarketSection.VegetableArea, MarketSection.FishSection, MarketSection.MeatSection })
        {
            if (string.Equals(FacilityCatalog.SectionLabelOf(Facility, candidate), displayed, StringComparison.OrdinalIgnoreCase))
                return FacilityState.CanonicalSectionLabel(candidate);
        }
        return null;
    }

    private void Open()
    {
        _draft = IsDefault ? string.Empty : Label;
        _error = null;
        _open = true;
    }

    private void Close()
    {
        _open = false;
        _error = null;
    }

    private void OnInput(ChangeEventArgs e) => _draft = e.Value?.ToString() ?? string.Empty;

    private Task UseDefault()
    {
        _draft = string.Empty;
        return Save();
    }

    private async Task Save()
    {
        if (_section is not { } section || _busy) return;
        _busy = true;
        _error = null;

        // The facility's own name, acronym, description and the other two section labels must travel with the
        // request: the API replaces all three labels together, so sending only this one would clear the others.
        var config = await FacilitiesApi.GetFacilityConfigurationAsync();
        var facility = config.IsSuccess
            ? config.Value?.Configured.FirstOrDefault(f =>
                string.Equals(f.Code, Facility.ToString(), StringComparison.OrdinalIgnoreCase))
            : null;

        if (facility is null)
        {
            _error = "Couldn't read this facility's settings. Please try again.";
            _busy = false;
            return;
        }

        var value = string.IsNullOrWhiteSpace(_draft) ? null : _draft.Trim();
        var veg = section == MarketSection.VegetableArea ? value : facility.VegetableSectionLabel;
        var fish = section == MarketSection.FishSection ? value : facility.FishSectionLabel;
        var meat = section == MarketSection.MeatSection ? value : facility.MeatSectionLabel;

        var result = await FacilitiesApi.UpdateFacilityAsync(new UpdateFacilityCommand(
            facility.Code, facility.Name, facility.ShortName, facility.Description, veg, fish, meat));

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = string.IsNullOrWhiteSpace(result.Error) ? "Couldn't save the section name." : result.Error;
            return;
        }

        // Refresh the catalogue so every surface picks the new label up, then let the host reload its data.
        await FacilityCatalog.ReloadAsync();
        _open = false;
        await OnRenamed.InvokeAsync();
    }
}
