@using EEMOCantilanSDS.Client.Services
@inject FacilityState Facilities

<FacilityHero Code="@((Workspace.Source as FacilityRentalSource)?.Code)"
              Title="@Workspace.DisplayName(Facilities)" Eyebrow="@($"OPERATION · {Workspace.DisplayCode}")"
              Scope="@Scope" Icon="@Icon" Stats="Stats" ShowProgress="true" ProgressPercentage="ProgressPercentage" />

@code {
    [Parameter, EditorRequired] public RentalWorkspaceDefinition Workspace { get; set; } = null!;
    [Parameter, EditorRequired] public List<FacilityHero.HeroStat> Stats { get; set; } = [];
    [Parameter, EditorRequired] public string Scope { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public double ProgressPercentage { get; set; }
}
