@using System.Globalization
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IObligationsApiClient Accounts
@inject IPaymentsApiClient Payments
@inject IDailyCollectionApiClient Daily
@inject FacilityState Facilities
@inject IPenaltiesApiClient Fines
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="account-review" @ref="_root">
<VendorDrawerShell Show="@(!_assessingFine)" KeepMounted="true" Title="@(Context.IsAccount ? "Review account" : "Review item")" Subtitle="@($"{ReviewOccupant} · {SourceName} · {Context.Reference}")" OnClose="OnClose">
    <Icon><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg></Icon>
    <ChildContent>
        @if (_loading)
        { <div role="status"><Skeleton Height="160px" /><span class="v3-sr-only">Loading account position…</span></div> }
        else if (_error is not null)
        { <div class="v3-notice v3-notice-error" role="alert">@_error</div><button type="button" class="v3-btn" @onclick="Load">Try again</button> }
        else
        {
            <p class="review-scope">As of @PhilippineTime.Today.ToString("MMM d, yyyy")@if (Context.SnapshotDate != PhilippineTime.Today) { <span> · Queue dated @Context.SnapshotDate.ToString("MMM d, yyyy")</span> }</p>
            @if (_hasLedger && (Owed.Any() || Context.FacilityItem?.ReasonKind != "contract"))
            {
                <dl class="review-summary">
                    <div><dt>Outstanding balance</dt><dd>@Money(Outstanding)</dd></div>
                    <div><dt>Periods with a balance</dt><dd>@Owed.Count()</dd></div>
                    <div><dt>Earliest period with balance</dt><dd>@(Owed.FirstOrDefault()?.Label ?? "None")</dd></div>
                    <div><dt>Collected in displayed periods</dt><dd>@Money(_periods.Sum(p => p.Collected))</dd></div>
                </dl>
                @if (_reconciliationWarning is not null)
                { <p class="v3-notice v3-notice-error" role="alert">@_reconciliationWarning</p> }
                <section aria-label="Outstanding billing periods">
                    <h3>@(IsEvent ? "Event obligation" : IsNpm ? "NPM outstanding month position" : "Outstanding billing periods")</h3>
                    @if (!Owed.Any()) { <p>No outstanding assessed periods were returned.</p> }
                    @foreach (var year in Owed.GroupBy(p => p.Date.Year))
                    {
                        <details class="review-year" open="@(year.Key == Owed.First().Date.Year)">
                            <summary>@year.Key <span>@year.Count() @(year.Count() == 1 ? "period" : "periods") with balance · @Money(year.Sum(p => p.Remaining))</span></summary>
                            @PeriodTable(year)
                        </details>
                    }
                    @if (_periods.Any(p => p.Remaining == 0))
                    { <details class="review-year"><summary>Settled assessed periods</summary>@PeriodTable(_periods.Where(p => p.Remaining == 0))</details> }
                </section>
                <p class="review-scope">Receipt allocations and correction history are unavailable here. Period totals are authoritative.</p>
                @if (_periods.Any(p => p.Eligible) && IsEvent)
                { <p class="review-scope">Record payment on Collector Mobile · Fiesta / Araw · Official Receipt.</p> }
                @if (_periods.Any(p => p.Eligible) && Context.ObligationItem is not null && !IsEvent)
                { <p class="review-scope">Record payment on Collector Mobile · Registered Monthly account · Official Receipt.</p> }
            }
            else if (Context.IsAccount && Context.FacilityItem?.ReasonKind != "contract")
            { <p>Detailed account periods are unavailable for this queue identity. Open the source account to review its authoritative position.</p> }

            <details class="review-year" open="@(!_hasLedger || Context.FacilityItem?.ReasonKind == "contract")">
                <summary>@(Context.FacilityItem?.ReasonKind == "contract" ? "Contract review" : "Account information")</summary>
                <dl class="review-facts">
                    <div><dt>Registered occupant</dt><dd>@ReviewOccupant</dd></div>
                    <div><dt>Source</dt><dd>@SourceName</dd></div>
                    @if (Context.FacilityItem?.Model is { Length: > 0 } model) { <div><dt>Billing basis</dt><dd>@model</dd></div> }
                    @if (_account is not null) { <div><dt>Account status</dt><dd>@(_account.ActiveTo is null ? "Active" : "Closed")</dd></div> }
                    @if (_account is not null)
                    {
                        @if (_account.Arrangement is { } basis) { <div><dt>Occupancy basis</dt><dd>@(basis == OccupancyArrangement.SignedContract ? "Signed lease contract" : "No contract (space only)")</dd></div> }
                        <div><dt>Effective from</dt><dd>@_account.ActiveFrom.ToString("MMM d, yyyy")</dd></div>
                        @if (_account.ActiveTo is { } end) { <div><dt>Closed on</dt><dd>@end.ToString("MMM d, yyyy")</dd></div> }
                        @if (_account.EventDate is { } eventDate) { <div><dt>Event</dt><dd>@_account.Event · @eventDate.ToString("MMM d, yyyy")</dd></div> }
                        @if (_account.ContractName is { Length: > 0 }) { <div><dt>Name on contract</dt><dd>@_account.ContractName</dd></div> }
                        @if (_account.ContractReference is { Length: > 0 }) { <div><dt>Contract reference</dt><dd>@_account.ContractReference</dd></div> }
                        @if (_account.ContractEffectiveDate is { } start) { <div><dt>Signed commencement</dt><dd>@start.ToString("MMM d, yyyy")</dd></div> }
                        @if (_account.ContractYears is { } years) { <div><dt>Recorded duration</dt><dd>@years years</dd></div> }
                    }
                    @if (Context.FacilityItem is { } item) {
                        <div><dt>Follow-up reason</dt><dd>@item.Reason</dd></div>
                        <div><dt>Coverage</dt><dd>@item.Period</dd></div>
                    }
                </dl>
            </details>
            @if (FineAccount is { } fineAccount) { <section class="review-charges" aria-label="Other assessed charges"><h3>Other assessed charges</h3><AccountFineAssessments Account="fineAccount" OnAssess="OpenFine" RefreshVersion="_fineRefreshVersion" /></section> }
            else { <section class="review-charges" aria-label="Other assessed charges"><h3>Other assessed charges</h3><p>@(_fineAccountError ?? "A verified liable registration is required to read fine assessments.")</p>
                @if(Context.FacilityItem?.StallId is not null) {
                    <button type="button" class="v3-btn v3-btn-sm" disabled="@_selectingSource" @onclick="LoadSourceAccounts">Select verified source account</button>
                    @if(_sourceAccounts is not null) { <div aria-label="Source contracts">
                        @foreach(var source in _sourceAccounts) { <button type="button" class="v3-btn v3-btn-sm" @onclick="()=>SelectSource(source)">@source.Occupant · @source.Area · @source.Unit · @source.StartsOn?.ToString("MMM d, yyyy") – @source.EndsOn?.ToString("MMM d, yyyy") · @source.Lifecycle</button> }
                        @if(_sourceAccounts.Count==0) { <p>No source contracts are available.</p> }
                    </div> }
                }
            </section> }
        }
    </ChildContent>
    <Footer>
        <div class="review-footer-actions">
        <button class="btn-outline" type="button" @onclick="OnClose">Close</button>
        @if (!string.IsNullOrWhiteSpace(Context.Link)) { <a class="btn-outline" href="@Context.Link">@(Context.IsAccount ? "Open source account" : "Open source item")</a> }
        @if (ActionLabel is { } action)
        { <button type="button" class="btn-primary" disabled="@(_loading || _error is not null || _reconciliationWarning is not null || (action == "Record payment" && (!_hasLedger || !Owed.Any())))" @onclick="OnAction">@action</button> }
        </div>
    </Footer>
</VendorDrawerShell>
@if (_assessingFine && FineAccount is { } assessingAccount)
{
    <FineAssessmentDrawer Account="assessingAccount" ManageFocus="false" OnClose="ReturnToReview" OnSaved="FineSaved" />
}
</div>

@code {
    [Parameter, EditorRequired] public FollowUpReviewContext Context { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback<DateOnly> OnPeriodSelected { get; set; }
    private sealed record Period(DateOnly Date, string Label, decimal Assessed, decimal Collected, decimal Remaining,
        bool Eligible, string? Receipt = null, DateTime? PaidAt = null);
    private List<Period> _periods = [];
    private ObligationAccountDto? _account;
    private bool _loading = true, _hasLedger;
    private bool _assessingFine, _head, _focusNeedsBind=true;
    private int _fineRefreshVersion;
    private FineAccountRef? _facilityFineAccount;
    private string? _verifiedOccupant;
    private string ReviewOccupant => _account?.ActualOccupant ?? _verifiedOccupant ?? Context.Name;
    private string? _fineAccountError;
    private IReadOnlyList<FineAccountOption>? _sourceAccounts;
    private bool _selectingSource;
    [CascadingParameter] private Task<AuthenticationState>? Authentication { get; set; }
    private string? _error, _reconciliationWarning;
    private ElementReference _root;
    private IJSObjectReference? _focus;
    private string SourceName => Context.ObligationItem?.Scope.DisplayName ?? (Context.FacilityItem is { } i ? Facilities.NameOf(i.Facility) : "Account");
    private bool IsEvent => Context.ObligationItem?.Scope.Kind == EEMOCantilanSDS.Application.Dtos.Reports.FollowUpScopeKind.EventLot;
    private bool IsNpm => Context.FacilityItem?.Facility == FacilityCode.NPM;
    private FineAccountRef? FineAccount => _account is { } a ? new(a.Kind switch {
        ObligationKind.KanmanggaySpaceRental => EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind.Kanmanggay,
        ObligationKind.VegetableFruitSpaceRental => EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind.VegetableFruitMonthly,
        _ => EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind.FiestaAraw }, a.Id) :
        _facilityFineAccount;
    private IEnumerable<Period> Owed => _periods.Where(p => p.Remaining > 0).OrderBy(p => p.Date);
    private decimal Outstanding => _account?.OutstandingToDate ?? _periods.Sum(p => p.Remaining);
    private static string Money(decimal value) => $"₱{value:N2}";
    private static string Status(Period p) => p.Remaining == 0 ? "Paid" : p.Collected > 0 ? "Partial" : "Unpaid";
    protected override async Task OnInitializedAsync() { _head=Authentication is not null && (await Authentication).User.IsInRole("SuperAdmin"); await Load(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusNeedsBind) return;
        _focusNeedsBind=false;
        try { _focus ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/account-review.js"); if (_focus is not null) { await _focus.InvokeVoidAsync("release", _root); await _focus.InvokeVoidAsync("bind", _root); } }
        catch (InvalidOperationException) { } // Prerender has no browser focus.
    }
    private void OpenFine() { if (!_head || FineAccount is null) return; _assessingFine=true; _focusNeedsBind=true; }
    private void ReturnToReview() { _assessingFine=false; _focusNeedsBind=true; }
    private void FineSaved() { _fineRefreshVersion++; ReturnToReview(); }
    private async Task ResolveFineAccount()
    {
        if (Context.IsAccount && Context.FacilityItem is { StallId: { } stallId } item)
        {
            try
            {
                var resolved=await Fines.ResolveFacilityFineAccountAsync(stallId,item.Facility,Context.SnapshotDate,item.ContractId);
                if (resolved is {IsSuccess:true,Value:not null} && resolved.Value.Account.AccountId != Guid.Empty && resolved.Value.Account.Kind == EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind.FacilityContract &&
                    resolved.Value.Facility == item.Facility && (!item.ContractId.HasValue || item.ContractId == resolved.Value.Account.AccountId))
                { _facilityFineAccount=resolved.Value.Account; _verifiedOccupant=resolved.Value.Occupant; }
                else _fineAccountError="Liable occupancy could not be verified. Reload the queue or open the source account.";
            }
            catch { _fineAccountError="Fine account verification is unavailable. Reload the queue or open the source account."; }
        }
    }
    private async Task LoadSourceAccounts()
    {
        if(Context.FacilityItem is not {StallId:{ } stallId} item) return;
        _selectingSource=true;
        try { var result=await Fines.GetFacilityFineAccountsAsync(stallId,item.Facility);
            if(result is {IsSuccess:true,Value:not null} && result.Value.All(x=>x.Facility==item.Facility && x.Account.Kind==EEMOCantilanSDS.Domain.Entities.Revenue.FineAccountKind.FacilityContract)) _sourceAccounts=result.Value;
            else _fineAccountError="Source contracts could not be loaded. Open the source account.";
        } catch { _fineAccountError="Source contracts are unavailable. Open the source account."; } finally {_selectingSource=false;}
    }
    private async Task SelectSource(FineAccountOption source)
    {
        if(Context.FacilityItem is not {StallId:{ } stallId} item || _sourceAccounts?.Contains(source)!=true) return;
        var result=await Fines.ResolveFacilityFineAccountAsync(stallId,item.Facility,Context.SnapshotDate,source.Account.AccountId);
        if(result is {IsSuccess:true,Value:not null} && result.Value.Account==source.Account && result.Value.Facility==item.Facility)
        { _facilityFineAccount=source.Account;_verifiedOccupant=result.Value.Occupant;_fineAccountError=null;_sourceAccounts=null; }
        else _fineAccountError="This source contract could not be verified. Reload the source account.";
    }
    private async Task Load()
    {
        _loading = true; _error = null; _periods = []; _account = null; _hasLedger = false; _reconciliationWarning = null; _facilityFineAccount=null; _verifiedOccupant=null; _fineAccountError=null;
        try
        {
            if (Context.ObligationItem is { } obligation)
            {
                var kind = obligation.Scope.OperationCode switch
                {
                    "KANMANGGAY_SPACE_RENTAL" => ObligationKind.KanmanggaySpaceRental,
                    "VEGETABLE_FRUIT_SPACE_RENTAL" => ObligationKind.VegetableFruitSpaceRental,
                    "FIESTA_ARAW_LOT_RENTAL" => ObligationKind.FiestaArawLotRental,
                    _ => (ObligationKind?)null
                };
                if (kind is null) throw new InvalidOperationException("This source has no supported account-register adapter.");
                var accounts = await Accounts.GetAccountsAsync(kind.Value);
                if (accounts is not { IsSuccess: true, Value: not null }) throw new InvalidOperationException(accounts?.StatusCode is 401 or 403 ? "You are not authorized to review this account." : "The source account could not be loaded.");
                _account = accounts.Value.SingleOrDefault(a => a.Id == obligation.AccountId && a.Kind == kind)
                    ?? throw new InvalidOperationException("The account is unavailable in this source.");
                var register = await Accounts.GetRegisterAsync(obligation.AccountId);
                if (register is not { IsSuccess: true, Value: not null }) throw new InvalidOperationException(register?.StatusCode is 401 or 403 ? "You are not authorized to review these periods." : "Account periods could not be loaded.");
                if (register.Value.Any(p => p.AccountId != obligation.AccountId || p.Kind != kind)) throw new InvalidOperationException("The period read returned a different source account.");
                _periods = register.Value.Where(p => p.AssessedAmount > 0).Select(p => new Period(p.PeriodStart,
                    IsEvent ? $"{p.Event} · {p.PeriodStart:MMM d, yyyy}" : p.PeriodStart.ToString("MMMM yyyy"),
                    p.AssessedAmount, p.SettledAmount, p.OutstandingAmount, p.CanAddToDraft)).OrderBy(p => p.Date).ToList();
                if (_periods.Sum(p => p.Remaining) != _account.OutstandingToDate)
                    _reconciliationWarning = "Period balances do not reconcile with the account total. Reload before arranging payment.";
                _hasLedger = true;
            }
            else if (Context.IsAccount && Context.FacilityItem is { StallId: { } id } item)
            {
                var result = await Payments.GetOutstandingMonthsAsync(id, item.ContractId, Context.PeriodYear, Context.PeriodMonth);
                if (result is not { IsSuccess: true, Value: not null }) throw new InvalidOperationException(result?.StatusCode is 401 or 403 ? "You are not authorized to review these periods." : "Outstanding periods could not be loaded.");
                foreach (var p in result.Value.Where(p => !p.IsExcused && p.TotalBill > 0))
                {
                    if (!DateOnly.TryParseExact(p.Period + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
                        throw new InvalidOperationException("A billing period could not be identified. Open the source account.");
                    _periods.Add(new(date, date.ToString("MMMM yyyy"), p.TotalBill, p.AmountPaid, p.BalanceDue, true, p.ORNumber, p.PaidAt));
                }
                _periods = _periods.OrderBy(p => p.Date).ToList(); _hasLedger = true;
            }
            await ResolveFineAccount();
        }
        catch (Exception ex) { _error = ex is InvalidOperationException ? ex.Message : "Account review could not be loaded."; }
        finally { _loading = false; }
    }
    private RenderFragment PeriodTable(IEnumerable<Period> periods) => @<div class="review-table-wrap">
        <table class="v3-table review-table"><thead><tr><th>Billing period</th><th>Assessed</th><th>Collected</th><th>Remaining</th><th>Status</th></tr></thead><tbody>
        @foreach (var p in periods)
        {
            <tr><td><button type="button" class="review-period-toggle" aria-expanded="@(_expanded.Contains(p.Date) ? "true" : "false")" aria-label="@($"Review {p.Label}")" @onclick="() => TogglePeriod(p.Date)"><span aria-hidden="true">@(_expanded.Contains(p.Date) ? "▾" : "▸")</span> @p.Label</button></td><td data-label="Assessed">@Money(p.Assessed)</td><td data-label="Collected">@Money(p.Collected)</td><td data-label="Remaining">@Money(p.Remaining)</td><td data-label="Status"><AccountStatusPill Status="@Status(p)" /></td></tr>
            @if (_expanded.Contains(p.Date))
            {
                <tr class="review-detail-row"><td colspan="5"><div class="review-period-detail">
                    @if (p.Receipt is { Length: > 0 }) { <p>Recorded OR: @p.Receipt @p.PaidAt?.ToString("MMM d, yyyy")</p> }
                    <p>@(p.Eligible ? Context.ObligationItem is not null ? "Payable through registered-account collection on Mobile." : "Payment eligibility is confirmed in the source payment form." : "Not eligible for a new settlement.")</p>
                    @if (IsNpm) {
                        <button class="v3-btn v3-btn-sm" type="button" aria-expanded="@(_dayPeriod == p.Date ? "true" : "false")" @onclick="() => ToggleDays(p)">Review eligible days</button>
                        @if (_dayPeriod == p.Date) {
                            <div class="review-days">
                            @if (_dayError is not null) { <p role="alert">@_dayError</p> }
                            else if (_days is null) { <p role="status">Loading eligible days…</p> }
                            else {
                                <table aria-label="Eligible unpaid dates" class="review-day-table"><thead><tr><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach (var day in _days) { <tr><td>@day.Date.ToString("MMM d, yyyy")</td><td>@Money(day.Fee)</td><td>Pending</td></tr> }</tbody></table>
                                @if (_days.Count == 0) { <p>No eligible unpaid dates returned.</p> }
                                <p class="review-scope">Unpaid dates only. Month-goal adjustments use Whole Payment.</p>
                            }
                            </div>
                        }
                    }
                </div></td></tr>
            }
        }
        </tbody></table>
    </div>;
    private readonly HashSet<DateOnly> _expanded = [];
    private async Task TogglePeriod(DateOnly date)
    {
        if (!_expanded.Add(date)) { _expanded.Remove(date); return; }
        await OnPeriodSelected.InvokeAsync(date);
    }
    private Task ToggleDays(Period period)
    {
        if (_dayPeriod == period.Date) { _dayPeriod = null; return Task.CompletedTask; }
        return LoadDays(period);
    }
    private DateOnly? _dayPeriod;
    private IReadOnlyList<EEMOCantilanSDS.Application.Dtos.DailyCollections.SettleableNpmDayDto>? _days;
    private string? _dayError;
    private async Task LoadDays(Period period)
    {
        _dayPeriod = period.Date; _days = null; _dayError = null;
        try
        {
            var result = await Daily.GetSettleableNpmDaysAsync(Context.FacilityItem!.StallId!.Value, period.Date.Year, period.Date.Month, Context.FacilityItem.ContractId);
            if (_dayPeriod != period.Date) return;
            if (result is not { IsSuccess: true, Value: not null }) { _dayError = "Eligible dates could not be loaded."; return; }
            _days = result.Value;
        }
        catch { if (_dayPeriod == period.Date) _dayError = "Eligible dates could not be loaded."; }
    }
    public async ValueTask DisposeAsync()
    {
        if (_focus is null) return;
        try { await _focus.InvokeVoidAsync("release", _root); await _focus.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
