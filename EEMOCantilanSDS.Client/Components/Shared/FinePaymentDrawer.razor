@using EEMOCantilanSDS.Application.Dtos.Revenue
@inject IPenaltiesApiClient Api
<AddNewDrawer Show="true" Title="Record fine payment" Subtitle="Official Receipt · Full remaining fine balance"
    FormId="fine-payment" FormLabel="Record fine payment" Saving="_saving" Error="@_error" OnCancel="Close"
    SubmitText="@(_outcome is not null ? "Payment recorded" : _reviewed ? "Record payment" : "Review payment")"
    SubmitDisabled="@(_loading || _outcome is not null || _quote is not {CanSettle:true})" CancelText="Close" OnSubmit="Submit">
    <ChildContent>
        @if (_loading) { <p role="status">Loading fine quote…</p> }
        else if (_quote is { } quote) {
            <AddNewSection Plain="true" Title="Fine payment">
                <p><strong>@quote.Occupant</strong><br />@quote.Source · @quote.Unit</p>
                <dl><dt>Assessed</dt><dd>₱@quote.Assessed.ToString("N2")</dd><dt>Collected</dt><dd>₱@quote.Settled.ToString("N2")</dd>
                    <dt>Remaining</dt><dd>₱@quote.Remaining.ToString("N2")</dd></dl>
                @if (!quote.CanSettle) { <p>@quote.IneligibleReason</p> }
                @if (_current is not null && _draft is null) { <p>This fine will join your compatible OR draft. Review every item before recording payment.</p> }
                @if ((_draft ?? _current) is { } displayed) {
                    <div class="v3-table-wrap"><table class="v3-table"><thead><tr><th>OR item</th><th class="v3-num">Amount</th></tr></thead><tbody>
                        @foreach(var line in displayed.Lines) { <tr><td>@line.ClassificationName</td><td class="v3-num">₱@line.Amount.ToString("N2")</td></tr> }
                    </tbody></table></div>
                }
                @if (_reviewed && _draft is not null) { <p>Confirm receipt of ₱@_draft.TotalAmount.ToString("N2"). The server will issue the SRC.</p> }
            </AddNewSection>
        }
        @if (_outcome is { } outcome) { <p role="status">Payment recorded · @outcome.ReferenceCode · ₱@outcome.Amount.ToString("N2")</p> }
    </ChildContent>
    <LeadingFooterActions>
        @if(_outcome is null && _draft is not null && _draft.Lines.Count==1 && _draft.Lines[0].SourceKind==EEMOCantilanSDS.Domain.Enums.CollectionSourceKind.FineAssessment) {
            <button class="btn-ghost" type="button" disabled="@_saving" @onclick="Discard">Discard draft</button>
        }
    </LeadingFooterActions>
</AddNewDrawer>
@code {
    [Parameter] public Guid AssessmentId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPaid { get; set; }
    private FineSettlementQuoteDto? _quote; private EcfCollectionDraftDto? _draft,_current; private EcfPostOutcomeDto? _outcome;
    private Guid _operation=Guid.NewGuid(); private bool _loading=true,_saving,_reviewed; private string? _error;
    protected override async Task OnInitializedAsync() {
        try {
            var quote=await Api.QuoteFineAsync(AssessmentId);
            if(quote is {IsSuccess:true,Value:not null}) {
                _quote=quote.Value;
                {
                    var current=await Api.GetCurrentFineDraftAsync(AssessmentId);
                    if(current is {IsSuccess:true,Value:not null}) {
                        _current=current.Value;
                        if(_current.Lines.Any(l=>l.SourceKind==EEMOCantilanSDS.Domain.Enums.CollectionSourceKind.FineAssessment&&l.SourceId==AssessmentId)) _draft=_current;
                    } else if(current is not null && current.StatusCode!=404) _error=current.Error??"The current draft cannot include this fine.";
                }
            } else _error=quote?.Error??"The fine quote is unavailable.";
        }
        catch {_error="The fine quote is unavailable.";} finally {_loading=false;}
    }
    private Task Close()=>_saving?Task.CompletedTask:OnClose.InvokeAsync();
    private async Task Discard() {
        if(_saving || _draft is null || _outcome is not null) return;
        _saving=true;
        try {
            var result=await Api.DiscardFineDraftAsync(_draft.DraftId,new(_draft.Revision));
            if(result is not {IsSuccess:true}) {_error=result?.Error??"The draft could not be discarded.";return;}
            _draft=_current=null; _reviewed=false; _operation=Guid.NewGuid();
            var quote=await Api.QuoteFineAsync(AssessmentId);
            _quote=quote is {IsSuccess:true,Value:not null}?quote.Value:null; _error=_quote is null?"The fine quote is unavailable.":null;
        } catch {_error="The draft result is unavailable. Reload before continuing.";} finally {_saving=false;}
    }
    private async Task Submit() {
        if(_loading||_saving||_outcome is not null||_quote is not {CanSettle:true}) return;
        _saving=true; _error=null;
        try {
            if(!_reviewed) {
                if(_draft is null) {
                    var added=await Api.AddFineDraftAsync(new(AssessmentId,_quote.QuoteToken,_quote.Remaining,_current?.Revision));
                    if(added is not {IsSuccess:true,Value:not null}) {_error=added?.Error??"The payment draft could not be created.";return;}
                    _draft=added.Value;
                }
                var review=await Api.ReviewFineDraftAsync(_draft.DraftId,new(_draft.Revision));
                if(review is not {IsSuccess:true,Value:not null}) {_error=review?.Error??"The payment needs review.";return;}
                _draft=review.Value; _reviewed=true;
            } else if(_draft is not null) {
                var post=await Api.PostFineDraftAsync(_draft.DraftId,new(_draft.Revision,_operation));
                if(post is {IsSuccess:true,Value:not null}) {_outcome=post.Value; await OnPaid.InvokeAsync();}
                else _error=post?.Error??"Payment was not confirmed. Reload and review the source.";
            }
        } catch {_error="The result is unavailable. Retry to recover this same payment.";} finally {_saving=false;}
    }
}
