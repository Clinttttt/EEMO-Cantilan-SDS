@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Enums
@inject IBusinessPayorsApiClient PayorsApi

@* The office's explicit act of giving one occupancy a Business Payor. A name match is only ever shown as a candidate; choosing one only
   highlights it, and nothing is linked until the office presses Link Payor (or Create and link). The occupant text is never changed. *@
<SideDrawer Show="true" Title="Link Business Payor" Subtitle="@($"{Occupancy.FacilityShortName} · {Occupancy.StallNo}")" OnClose="OnClose">
    <ChildContent>
        <div class="lpd-body">
            <dl class="lpd-facts">
                <div><dt>Space</dt><dd>@Occupancy.FacilityShortName · @Occupancy.StallNo</dd></div>
                <div><dt>Recorded occupant</dt><dd>@Occupancy.ActualOccupant</dd></div>
            </dl>

            <section class="lpd-section" aria-labelledby="lpd-find">
                <h3 id="lpd-find" class="lpd-section-title">Business Payor</h3>
                <form class="lpd-search" aria-label="Find a Business Payor" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                    <label class="v3-field">
                        <span class="v3-sr-only">Search Business Payors</span>
                        <input type="search" maxlength="100" @bind="_search" @bind:event="oninput" placeholder="Search by name" />
                    </label>
                    <button class="v3-btn" type="submit" disabled="@(_busy || _search.Trim().Length < 2)">Search</button>
                </form>

                @if (_busy && _candidates is null)
                {
                    <p class="lpd-muted" role="status">Searching…</p>
                }
                else if (_candidates is { Count: > 0 })
                {
                    <ul class="lpd-results" aria-label="Business Payors found" role="listbox">
                        @foreach (var candidate in _candidates)
                        {
                            var selected = _selected?.PayorId == candidate.PayorId;
                            <li>
                                <button class="lpd-option @(selected ? "is-selected" : "")" type="button" role="option" aria-selected="@(selected ? "true" : "false")" @onclick="() => _selected = candidate">
                                    <span class="lpd-check" aria-hidden="true">@(selected ? "✓" : "")</span>
                                    <span class="lpd-option-text">
                                        <strong>@candidate.DisplayName</strong>
                                        <span class="lpd-muted">@(candidate.Contexts.Count == 0 ? "Not linked to anything yet" : string.Join(" · ", candidate.Contexts))</span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (_searched)
                {
                    <p class="lpd-muted" role="status">No Business Payor found.</p>
                }
            </section>

            <details class="lpd-create" open="@_duplicate">
                <summary>Create a new Business Payor</summary>
                <div class="lpd-create-body">
                    <label class="v3-field"><span>Name</span><input maxlength="200" @bind="_name" @bind:event="oninput" /></label>
                    <label class="v3-field">
                        <span>Type</span>
                        <select @bind="_kind">
                            <option value="@BusinessPayorKind.Person">Person</option>
                            <option value="@BusinessPayorKind.Organization">Organization</option>
                        </select>
                    </label>
                    @if (_duplicate)
                    {
                        <label class="lpd-confirm">
                            <input type="checkbox" @bind="_confirmDuplicate" />
                            A Business Payor with this name already exists. This is a different person.
                        </label>
                    }
                    <button class="v3-btn" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || (_duplicate && !_confirmDuplicate))" @onclick="CreateAsync">Create and link</button>
                </div>
            </details>

            @if (_error is not null)
            {
                <p class="v3-notice v3-notice-error" role="alert">@_error</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="v3-btn" type="button" @onclick="OnClose">Cancel</button>
        <button class="v3-btn v3-btn-primary" type="button" disabled="@(_busy || _selected is null)" @onclick="() => LinkAsync(_selected!)">Link Payor</button>
    </Footer>
</SideDrawer>

@code {
    [Parameter, EditorRequired] public PayorOccupancyDto Occupancy { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PayorLinkOutcomeDto> OnLinked { get; set; }

    private string _search = string.Empty;
    private string _name = string.Empty;
    private BusinessPayorKind _kind = BusinessPayorKind.Person;
    private bool _duplicate, _confirmDuplicate, _searched, _busy;
    private string? _error;
    private IReadOnlyList<PayorCandidateDto>? _candidates;
    private PayorCandidateDto? _selected;

    protected override void OnInitialized()
    {
        _name = Occupancy.ActualOccupant;
        _search = Occupancy.ActualOccupant;
    }

    private async Task SearchAsync()
    {
        if (_search.Trim().Length < 2) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await PayorsApi.SearchPayorsAsync(_search.Trim());
            if (result.IsSuccess) { _candidates = result.Value; _searched = true; }
            else _error = result.Error ?? "The search could not be completed.";
        }
        catch { _error = "The search could not be completed."; }
        finally { _busy = false; }
    }

    private async Task LinkAsync(PayorCandidateDto candidate)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await PayorsApi.LinkAsync(new LinkPayorRequest(Occupancy.ContractId, candidate.PayorId));
            if (result.IsSuccess) await OnLinked.InvokeAsync(result.Value!);
            else _error = result.Error ?? "The Business Payor could not be linked.";
        }
        catch { _error = "The Business Payor could not be linked."; }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await PayorsApi.CreateAndLinkAsync(new CreatePayorAndLinkRequest(
                Occupancy.ContractId, _name.Trim(), _kind, _duplicate && _confirmDuplicate));
            if (result.IsSuccess) { await OnLinked.InvokeAsync(result.Value!); return; }
            if (result.Error?.StartsWith("DUPLICATE_PAYOR", StringComparison.Ordinal) == true)
            {
                _duplicate = true;
                _search = _name;
                await SearchAsync();
                _error = "A Business Payor with this name already exists. Link it above, or confirm this is a different person.";
            }
            else _error = result.Error ?? "The Business Payor could not be created.";
        }
        catch { _error = "The Business Payor could not be created."; }
        finally { _busy = false; }
    }
}
