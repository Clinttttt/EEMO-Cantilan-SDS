@* Step 2's summary bar: how many rows are being reviewed, where they came from, and the row actions (Add row, Discard). *@
<div class="imp-review-bar">
    <div class="imp-review-left">
        <div class="imp-review-count">@Count</div>
        <div>
            <div class="imp-review-title">@Title</div>
            <div class="imp-review-sub">@Subtitle</div>
            @if (!string.IsNullOrWhiteSpace(Detail)) { <div class="imp-review-detail" role="status">@Detail</div> }
        </div>
    </div>
    <div class="imp-review-actions">@ChildContent</div>
</div>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public string Subtitle { get; set; } = string.Empty;

    /// <summary>The line under the count; "rows ready to review" unless the host can also say some are not ready.</summary>
    [Parameter] public string Title { get; set; } = "rows ready to review";

    /// <summary>Optional status line, e.g. "2 ready · 1 invalid".</summary>
    [Parameter] public string? Detail { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
