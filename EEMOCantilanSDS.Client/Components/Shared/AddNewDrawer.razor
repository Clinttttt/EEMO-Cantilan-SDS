@* ADD NEW DRAWER — the one shape every "Add New" takes, and it is the stallholder drawer's own: VendorDrawerShell (overlay, civic-blue header with its
   icon tile, scrolling body, fixed footer) around one form of sections. Operations supply their fields as the form's content (AddNewSection,
   ChoiceCards, avm-* groups). Presentation only: validation, state and the save itself stay with the page. *@
<VendorDrawerShell Show="Show" Title="@Title" Subtitle="@Subtitle" OnClose="RequestClose">
    <Icon>
        @if (Edit)
        {
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" /></svg>
        }
    </Icon>
    <ChildContent>
        <form id="@FormId" aria-label="@FormLabel" @onsubmit="OnSubmit" @onsubmit:preventDefault="true" @onchange="Touch" @oninput="Touch">
            @ChildContent
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="avm-error" role="alert">@Error</div>
            }
            @if (_confirmDiscard)
            {
                <div class="avm-error" role="alertdialog" aria-label="Discard changes">You have unsaved changes. Discard them and close?</div>
            }
        </form>
    </ChildContent>
    <Footer>
        @if (LeadingFooterActions is not null)
        {
            <div class="add-new-footer-leading">@LeadingFooterActions</div>
        }
        @if (_confirmDiscard)
        {
            <button type="button" class="btn-ghost" @onclick="KeepEditing">Keep editing</button>
            <button type="button" class="btn-primary" @onclick="Discard">Discard changes</button>
        }
        else
        {
            @if (ShowCancel) { <button type="button" class="btn-ghost" disabled="@Saving" @onclick="FooterCancel">@CancelText</button> }
            <button type="submit" class="btn-primary" form="@FormId" disabled="@(Saving || SubmitDisabled)">@SubmitText</button>
        }
    </Footer>
</VendorDrawerShell>

@code {
    [Parameter] public bool Show { get; set; }

    /// <summary>A change to something that exists (a rate, a rule) rather than a new record: the header shows a pencil.</summary>
    [Parameter] public bool Edit { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public string FormId { get; set; } = string.Empty;

    /// <summary>The form's accessible name.</summary>
    [Parameter] public string? FormLabel { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Save";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool SubmitDisabled { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnFooterCancel { get; set; }
    private Task FooterCancel() => OnFooterCancel.HasDelegate ? OnFooterCancel.InvokeAsync() : OnCancel.InvokeAsync();

    /// <summary>False for a drawer whose close X is the one dismiss control (no second Cancel button beside Save).</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>True to ask before closing a drawer in which a field was changed. Opt-in; closing an untouched form never asks.</summary>
    [Parameter] public bool GuardUnsaved { get; set; }
    private bool _touched, _confirmDiscard, _wasShown;
    private void Touch() { if (Show) _touched = true; }
    private void KeepEditing() => _confirmDiscard = false;
    private Task Discard() { _confirmDiscard = false; _touched = false; return OnCancel.InvokeAsync(); }
    private Task RequestClose()
    {
        if (GuardUnsaved && _touched && !Saving) { _confirmDiscard = true; return Task.CompletedTask; }
        return OnCancel.InvokeAsync();
    }
    /// <summary>Identifies one filling-in of the form. While it is unchanged, edits survive the drawer being hidden for a step (an advance review) and shown again; a new key is a fresh form.</summary>
    [Parameter] public object? SessionKey { get; set; }
    private object? _sessionKey;
    protected override void OnParametersSet()
    {
        if (SessionKey is not null) { if (!Equals(SessionKey, _sessionKey)) { _touched = false; _confirmDiscard = false; _sessionKey = SessionKey; } }
        else if (Show && !_wasShown) { _touched = false; _confirmDiscard = false; }
        _wasShown = Show;
    }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Optional navigation actions before Cancel/Submit; callers retain permission and saving guards.</summary>
    [Parameter] public RenderFragment? LeadingFooterActions { get; set; }
}
