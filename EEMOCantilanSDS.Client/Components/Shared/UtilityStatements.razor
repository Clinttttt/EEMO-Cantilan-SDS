@using System.Globalization
@using EEMOCantilanSDS.Client.Exports

@* The official register of one utility (ECF or WCF): the Stall Holder List's own document, with eight columns. Every figure is the server's obligation read
   (assessed, outstanding) handed in by the owning workspace; this component calculates and records nothing and the register is evidence, never a receipt.
   The per-payor statement evidence stays in the source's API; it is not drawn here. *@
<OfficialRegisterPage Title="@($"{UtilityName} Statements")" OperationName="@PeriodLabel" Eyebrow="@($"OPERATIONS · {UtilityCode}")"
                      BackHref="@BackHref" BackName="@BackName" Stats="Stats" SearchPlaceholder="Search name or stall" @bind-SearchQuery="_search"
                      CsvFileName="@CsvFileName" CsvText="@CsvText">
    <Filters>
        <input class="lsh-input" type="month" aria-label="Billing month" title="Billing month" value="@MonthValue" @onchange="OnMonthChanged" />
        <div class="lsh-seg" role="group" aria-label="Balance filter">
            <button type="button" class="lsh-seg-item @(!_balanceOnly ? "active" : "")" aria-pressed="@(!_balanceOnly ? "true" : "false")" @onclick="() => _balanceOnly = false">All</button>
            <button type="button" class="lsh-seg-item @(_balanceOnly ? "active" : "")" aria-pressed="@(_balanceOnly ? "true" : "false")" @onclick="() => _balanceOnly = true">With balance</button>
        </div>
    </Filters>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="lsh-state" role="alert">
                @if (SetupRequired) { <span><strong>Setup required.</strong> @Error</span> <a class="lsh-btn" href="/settings/revenue">Open Revenue Setup</a> }
                else { <span>@Error</span> <button type="button" class="lsh-btn" @onclick="OnRetry">Try again</button> }
            </div>
        }
        else if (Loading)
        {
            <p class="lsh-state" role="status">Loading the register…</p>
        }
        else
        {
            <div class="lsh-section-block">
                <div class="lsh-section-label-row">
                    <span class="lsh-section-label">ALL BILLING MONTHS</span>
                    <span class="lsh-section-count">@Visible.Count line@(Visible.Count == 1 ? "" : "s")</span>
                </div>
                <div class="lsh-table-wrap"><table class="lsh-table us-col">
                    <thead>
                        <tr>
                            <th class="col-no">#</th>
                            <th class="col-name">Name of Lessee <br /><span class="th-sub">(Actual Occupants)</span></th>
                            <th class="col-month">Billing <br />Month</th>
                            <th class="col-op">Operations</th>
                            <th class="col-sec">Section</th>
                            <th class="col-stall">Stall <br />No.</th>
                            <th class="col-amt">Assessed</th>
                            <th class="col-amt">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Visible.Count; i++)
                        {
                            var l = Visible[i];
                            <tr>
                                <td class="c">@(i + 1)</td>
                                <td class="tl fw">@l.Payor</td>
                                <td class="c">@MonthName(l)</td>
                                <td class="c">@Operation(l)</td>
                                <td class="c">@SectionOf(l)</td>
                                <td class="c">@StallOf(l)</td>
                                <td class="r">@Money(l.Assessed)</td>
                                <td class="r">@Money(l.Outstanding)</td>
                            </tr>
                        }
                        @if (Visible.Count == 0)
                        {
                            <tr><td colspan="8" class="c txt-muted">@(Lines.Count == 0 ? $"No {UtilityCode} charges were assessed for {PeriodLabel}." : "No billing line matches the filter.")</td></tr>
                        }
                    </tbody>
                    @if (Visible.Count > 0)
                    {
                        <tfoot>
                            <tr class="tfoot-row">
                                <td colspan="6" class="tfoot-label">Total</td>
                                <td class="r tfoot-val">@Money(Visible.Sum(l => l.Assessed))</td>
                                <td class="r tfoot-val">@Money(Visible.Sum(l => l.Outstanding))</td>
                            </tr>
                        </tfoot>
                    }
                </table></div>
            </div>
        }
    </ChildContent>
</OfficialRegisterPage>

@code {
    private string _search = string.Empty;
    private bool _balanceOnly;

    /// <summary>Short utility code shown in headings, e.g. ECF.</summary>
    [Parameter, EditorRequired] public string UtilityCode { get; set; } = string.Empty;
    /// <summary>Full name printed on the document, e.g. Electricity Consumption Fees.</summary>
    [Parameter, EditorRequired] public string UtilityName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PeriodLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<StatementLine> Lines { get; set; } = [];
    [Parameter, EditorRequired] public string BackHref { get; set; } = "/operations";
    [Parameter, EditorRequired] public string BackName { get; set; } = "Operations";
    /// <summary>The selected billing month as yyyy-MM; the host owns the selection and the load.</summary>
    [Parameter] public string MonthValue { get; set; } = string.Empty;
    [Parameter] public EventCallback<ChangeEventArgs> OnMonthChanged { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool SetupRequired { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>One billing month of one space, exactly as the obligation read states it.</summary>
    public sealed record StatementLine(
        Guid StallId, string StallNo, string Section, string Payor, int Year, int Month,
        decimal Assessed, decimal Settled, decimal Outstanding, string FacilityName = "");

    private List<StatementLine> Visible => Lines
        .Where(l => (!_balanceOnly || l.Outstanding > 0m)
            && (string.IsNullOrWhiteSpace(_search)
                || l.Payor.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || l.StallNo.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || l.Section.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(l => l.Payor, StringComparer.OrdinalIgnoreCase).ThenBy(l => l.StallNo, StringComparer.OrdinalIgnoreCase)
        .ThenBy(l => l.Year).ThenBy(l => l.Month).ToList();

    private IReadOnlyList<OfficialRegisterPage.Stat> Stats =>
    [
        new(Loading || Error is not null ? "—" : Lines.Select(l => (l.StallId, l.Payor)).Distinct().Count().ToString(CultureInfo.InvariantCulture), "Accounts"),
        new(Loading || Error is not null ? "—" : Lines.Count.ToString(CultureInfo.InvariantCulture), "Billing lines"),
        new(Loading || Error is not null ? "—" : Money(Lines.Sum(l => l.Assessed)), "Assessed"),
        new(Loading || Error is not null ? "—" : Money(Lines.Sum(l => l.Outstanding)), "Balance")
    ];

    private static string MonthName(StatementLine l) => new DateOnly(l.Year, l.Month, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private static string Operation(StatementLine l) => string.IsNullOrWhiteSpace(l.FacilityName) ? "—" : l.FacilityName;
    // Where no section applies, the operation's own name stands in the Section column rather than an empty field.
    private static string SectionOf(StatementLine l) => !string.IsNullOrWhiteSpace(l.Section) ? l.Section : Operation(l);
    private static string StallOf(StatementLine l) => string.IsNullOrWhiteSpace(l.StallNo) ? "—" : l.StallNo;
    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";

    private string CsvFileName => $"{UtilityCode.ToLowerInvariant()}-statements-{MonthValue}.csv";

    /// <summary>The filtered rows, in the printed column order. Amounts keep their precision; text is escaped for CSV and for spreadsheet formulas.</summary>
    private string CsvText
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("#,Name of Lessee (Actual Occupants),Billing Month,Operations,Section,Stall No.,Assessed,Balance");
            var rows = Visible;
            for (var i = 0; i < rows.Count; i++)
            {
                var l = rows[i];
                sb.AppendLine(string.Join(',', new[] { (i + 1).ToString(CultureInfo.InvariantCulture), CsvCell.Escape(l.Payor), CsvCell.Escape(MonthName(l)), CsvCell.Escape(Operation(l)),
                    CsvCell.Escape(SectionOf(l)), CsvCell.Escape(StallOf(l)), l.Assessed.ToString("0.00", CultureInfo.InvariantCulture), l.Outstanding.ToString("0.00", CultureInfo.InvariantCulture) }));
            }
            return sb.ToString();
        }
    }
}
