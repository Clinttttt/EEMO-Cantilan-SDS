@using EEMOCantilanSDS.Domain.Entities.Revenue
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

@* The Fish / Meat registration drawer: the shared right-hand drawer shell (kept mounted so it slides in and out like the stallholder drawer) around
   full-width fields and stacked registration choices. Registering a vendor and renewing a registration are the same drawer; a renewal fixes the vendor's type and asks for the
   tax year it is for. Presentation only: validation, operation IDs and saving stay with the page. *@
<VendorDrawerShell Show="Show" KeepMounted="true" Title="@Title" Subtitle="@Subtitle" OnClose="OnCancel">
    <Icon>
        @if (IsRenew)
        {
            <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><polyline points="21 3 21 8 16 8" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /><polyline points="3 21 3 16 8 16" /></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" /></svg>
        }
    </Icon>
    <ChildContent>
        <form class="vendor-registration-form" id="@FormId" aria-label="@FormLabel" @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
            @SourceContext
            <VendorRegistrationFields Model="Model" FormId="@FormId" IsRenew="IsRenew" TaxYears="TaxYears" />
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="avm-error" role="alert">@Error</div>
            }
            @if (_pendingNavigation is not null)
            {
                <div class="avm-error" role="alertdialog" aria-label="Leave registration">You have unsaved registration details. Leave this form?</div>
            }
        </form>
    </ChildContent>
    <Footer>
        @if (_pendingNavigation is not null)
        {
            <button type="button" class="btn-ghost" @onclick="() => _pendingNavigation = null">Keep editing</button>
            <button type="button" class="btn-primary" @onclick="ContinueNavigation">Continue</button>
        }
        else
        {
        @if (ImportEnabled)
        {
            <AuthorizeView Roles="SuperAdmin"><Authorized>
                <div class="vendor-import-action"><button type="button" class="btn-ghost" disabled="@Saving" title="Import vendor registrations from a file" @onclick="RequestImport">Import list</button></div>
            </Authorized></AuthorizeView>
        }
        <button type="button" class="btn-ghost" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn-primary" form="@FormId" disabled="@(Saving || !CanSubmit)">@SubmitText</button>
        }
    </Footer>
</VendorDrawerShell>
@if (ImportEnabled)
{
    <NavigationLock ConfirmExternalNavigation="@(Dirty && !_allowNavigation)" OnBeforeInternalNavigation="BeforeNavigation" />
}

@code {
    private static readonly IReadOnlyList<ChoiceCards.Choice> TypeChoices = [new("1", "Fish"), new("2", "Meat")];
    private static readonly IReadOnlyList<ChoiceCards.Choice> KindChoices = [new("1", "New"), new("2", "Renew")];

    [Parameter] public bool Show { get; set; }
    [Parameter] public RenderFragment? SourceContext { get; set; }
    [Parameter, EditorRequired] public VendorRegistrationForm Model { get; set; } = new();
    [Parameter] public string FormId { get; set; } = "fmv-register-form";
    [Parameter] public string FormLabel { get; set; } = "Register vendor";
    [Parameter] public string Title { get; set; } = "Register vendor";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Register";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool CanSubmit { get; set; } = true;
    /// <summary>Ordinary Head registration only. NPM association and renewal do not offer import navigation.</summary>
    [Parameter] public bool ShowImport { get; set; }
    [Parameter] public string? Error { get; set; }

    /// <summary>A renewal: the type is the registration's own and the tax year is chosen from <see cref="TaxYears"/>.</summary>
    [Parameter] public bool IsRenew { get; set; }
    [Parameter] public IReadOnlyList<int> TaxYears { get; set; } = [];
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private IReadOnlyList<(string Value, string Label)> YearOptions => TaxYears.Select(y => (y.ToString(), y.ToString())).ToList();
    private bool ImportEnabled => Show && ShowImport && !IsRenew && SourceContext is null;
    private bool Dirty => _openingFingerprint is not null && _openingFingerprint != Model.Fingerprint;
    private bool _wasShown, _allowNavigation;
    private string? _openingFingerprint, _pendingNavigation;
    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) { _openingFingerprint = Model.Fingerprint; _pendingNavigation = null; _allowNavigation = false; }
        _wasShown = Show;
    }
    private void RequestImport()
    {
        if (Saving || !ImportEnabled) return;
        var target = "/operations/fish-meat-vendor-fees/import";
        if (Dirty) _pendingNavigation = target;
        else Navigation.NavigateTo(target);
    }
    private void BeforeNavigation(LocationChangingContext context)
    {
        if (!Dirty || _allowNavigation) return;
        context.PreventNavigation();
        _pendingNavigation = context.TargetLocation;
        StateHasChanged();
    }
    private void ContinueNavigation()
    {
        if (_pendingNavigation is not { } target || Saving) return;
        _allowNavigation = true; _pendingNavigation = null;
        Navigation.NavigateTo(target);
    }
}
