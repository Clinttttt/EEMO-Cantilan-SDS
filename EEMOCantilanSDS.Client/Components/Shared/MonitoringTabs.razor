@* MONITORING TABS — the in-page switch between the Monitoring registers (Follow-ups | Contracts). The sidebar keeps one "Monitoring"
   entry; this only moves between registers. Presentation only: plain links, no state. *@
<nav class="mt-tabs" aria-label="Monitoring registers">
    <a href="/monitoring/follow-up" class="mt-tab @(Current == "follow-up" ? "mt-tab-active" : "")" aria-current="@PageIf("follow-up")">Follow-ups</a>
    <a href="/monitoring/contracts" class="mt-tab @(Current == "contracts" ? "mt-tab-active" : "")" aria-current="@PageIf("contracts")">Contracts</a>
</nav>

@code {
    /// <summary>"follow-up" or "contracts".</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "follow-up";

    private string? PageIf(string tab) => Current == tab ? "page" : null;
}
