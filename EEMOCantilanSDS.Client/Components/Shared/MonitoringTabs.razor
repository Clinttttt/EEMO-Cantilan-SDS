@* MONITORING TABS — in-page navigation between monitoring work queues. The sidebar keeps one "Monitoring"
   entry; this only moves between registers. Presentation only: plain links, no state. *@
<nav class="mt-tabs" aria-label="Monitoring registers">
    <a href="/monitoring/follow-up" class="mt-tab @(Current == "follow-up" ? "mt-tab-active" : "")" aria-current="@PageIf("follow-up")">Follow-ups</a>
    <a href="/monitoring/contracts" class="mt-tab @(Current == "contracts" ? "mt-tab-active" : "")" aria-current="@PageIf("contracts")">Contracts</a>
    <a href="/monitoring/npm-requests" class="mt-tab @(Current == "npm-requests" ? "mt-tab-active" : "")" aria-current="@PageIf("npm-requests")">NPM requests</a>
    @if (ShowHistory)
    {
        <a href="/reports/follow-up/history" class="mt-tab fq-history-link" title="Past-period snapshot from source records; this is not a log of actions or local hides.">Past-period view</a>
    }
</nav>

@code {
    /// <summary>"follow-up", "contracts", or "npm-requests".</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "follow-up";
    [Parameter] public bool ShowHistory { get; set; }

    private string? PageIf(string tab) => Current == tab ? "page" : null;
}
