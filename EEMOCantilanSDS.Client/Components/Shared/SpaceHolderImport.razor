@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Enums
@inject IObligationsApiClient Api

@* Bulk import of space holders and event lots. It is the stallholder import's own implementation, adapted rather than imitated: the same hero,
   upload card, review bar, editable grid and footer bar (the shared Import* components); only the columns and what a row means are this
   page's. Every row is checked here and then by the server's typed preview. A row's holder is its own typed occupant, never a master record, made
   from a compact action in its status cell; nothing is linked or created from a name. Occupancy basis is stated per row, never assumed. *@
<div class="shi">
    <ImportHero Eyebrow="@($"{Name} · Bulk Import")" Title="@($"Import {Name} {Holders}")" Step="Step" Blue="BlueHero" />

    @if (_result is not null)
    {
        var notImported = _result.NeedsReview.Count + _notImported;
        <ImportResultCard Ok="@(_result.Imported > 0 && notImported == 0)"
                          Errors="@(_result.NeedsReview.Select((line, i) => new ImportResultError(i + 1, string.Empty, line)).ToList())">
            <Title>@_result.Imported @(_result.Imported == 1 ? "rent / space holder" : Holders.ToLowerInvariant()) imported</Title>
            <Text>
                @if (notImported > 0) { <text>@notImported need review and were not imported.</text> }
                @if (_result.Skipped > 0) { <text> @_result.Skipped skipped.</text> }
                @if (notImported == 0 && _result.Skipped == 0) { <text>Every row was imported.</text> }
            </Text>
            <ChildContent>
                <ImportButton Kind="ghost" OnClick="ResetAll">Import another list</ImportButton>
                <ImportButton Kind="primary" Href="@BackHref">Back to @Name</ImportButton>
            </ChildContent>
        </ImportResultCard>
    }
    else if (Rows.Count == 0)
    {
        <ImportUploadCard Subtitle="@($"the list of {Name} {Holders.ToLowerInvariant()}")" OnFile="OnFileChange" UploadError="@_uploadError"
                          TemplateHref="@TemplateUri" TemplateFileName="@($"{Slug}-template.csv")" OnSample="LoadSample" OnManual="StartManual"
                          ColumnsFor="@Name" ColumnLabels="Columns.Select(c => c.Label)">
            <Notes>
                @if (!IsEvent)
                {
                    <div class="imp-cols-note">Choose <strong>Add row with contract</strong> or <strong>Add row for rent/space only</strong>. For uploaded rows, review the lease choice in row actions. Unfilled numbers are assigned automatically.</div>
                }
                else
                {
                    <div class="imp-cols-note">Choose Fiesta or Araw for each row. Event rentals are charged once; they are not monthly leases.</div>
                }
            </Notes>
        </ImportUploadCard>
    }
    else
    {
        <ImportReviewBar Count="Rows.Count" Title="rows to review" Detail="@ReviewCounts" Subtitle="@($"{(string.IsNullOrEmpty(_fileName) ? "Entered here" : _fileName)} · {Name}")">
            @if (IsEvent)
            {
                <ImportButton Kind="ghost" Class="imp-add-row" OnClick="() => AddRow(true)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add row
                </ImportButton>
            }
            else
            {
                @* The same pair the stallholder import offers: a row with a signed contract, and a row for a space let without one. *@
                <ImportButton Kind="ghost" Class="imp-add-row" OnClick="() => AddRow(true)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add row with contract
                </ImportButton>
                <ImportButton Kind="ghost" Class="imp-add-space-row" OnClick="() => AddRow(false)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add row for rent/space only
                </ImportButton>
            }
            <ImportButton Kind="outline" Disabled="@Saving" OnClick="ResetAll">Discard</ImportButton>
        </ImportReviewBar>


        <ImportGrid TRow="Row" Columns="ReviewColumns" Rows="Rows" Label="Rent / space holders to import" GetCell="CellOf" OnChange="CellChanged" OnRemove="RemoveRow"
                    Compact="true" IsReadonly="IsLocked" Placeholder="PlaceholderOf" CellTitle="TitleOf" OptionText="OptionText">
            <Status Context="row">
                @{ var (state, why) = StatusOf(row); }
                <div class="shi-status">
                    <span class="shi-chip-status @(state == SpaceHolderImportStatus.Ready ? "shi-ready" : "shi-invalid")">@StatusLabel(state)</span>
                    @if (state != SpaceHolderImportStatus.Ready)
                    {
                        <p class="shi-why" role="status">@(why ?? "Review this row before importing.")</p>
                    }
                </div>
            </Status>
            <RowActions Context="row">
                @{ var (state, why) = StatusOf(row); }
                <button class="shi-row-edit" type="button" title="@(why ?? "Edit rent/space details")"
                        aria-label="Edit row details @(Rows.IndexOf(row) + 1)" aria-haspopup="dialog"
                        @ref="_editButtons[row]" @onclick="() => OpenEditor(row)">
                    @(state == SpaceHolderImportStatus.Ready ? "Details" : "Review")
                </button>
            </RowActions>
        </ImportGrid>

        @if (_editing is { } editing)
        {
            <VendorDrawerShell Show="true" AnimateEntry="true" Title="@($"Row {Rows.IndexOf(editing) + 1} · {(string.IsNullOrWhiteSpace(editing.Name) ? "Rent / space holder" : editing.Name)}")"
                               Subtitle="Edit this row before importing. Changes stay in the review list." OnClose="CloseEditor">
                <Icon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16 3l5 5L8 21H3v-5L16 3Z" /></svg></Icon>
                <ChildContent>
                    <div class="shi-editor" tabindex="-1" @ref="_editorHeading">
                        @if (StatusOf(editing).Status != SpaceHolderImportStatus.Ready)
                        {
                            <p class="shi-why shi-editor-error" id="@_errorId" role="status">@(StatusOf(editing).Why ?? "Review this row before importing.")</p>
                        }
                        <section class="avm-section">
                            <div class="avm-section-label">Holder &amp; @(IsEvent ? "Event" : "Space")</div>
                            <div class="avm-row-2">
                                @foreach (var col in ReviewColumns) { @EditorField(editing, col) }
                            </div>
                        </section>
                        @if (!IsEvent)
                        {
                            <section class="avm-section">
                                <div class="avm-section-label">Contract Information</div>
                                <div class="avm-row-2">
                                    @foreach (var col in new[] { ContractNameCol, ContractReferenceCol, YearsCol }) { @EditorField(editing, col) }
                                </div>
                            </section>
                            <section class="avm-section">
                                <div class="avm-section-label">Space &amp; Rental Details</div>
                                <div class="avm-row-2">
                                    @foreach (var col in new[] { AreaCol, AreaLocCol, ContractRateCol, WholeYearCol, DelinquentCol }) { @EditorField(editing, col) }
                                </div>
                                <p class="avm-section-note">Whole Year Rental is a display calculation from the approved monthly rental. Delinquency is available from the account ledger after registration.</p>
                            </section>
                        }
                        <section class="avm-section">
                            <div class="avm-section-label">Additional Information</div>
                            @EditorField(editing, ClosedCol)
                        </section>
                    </div>
                </ChildContent>
                <Footer>
                    <ImportButton Kind="ghost" Disabled="@(Rows.IndexOf(editing) == 0)" OnClick="() => OpenEditor(Rows[Rows.IndexOf(editing) - 1])">Previous row</ImportButton>
                    <ImportButton Kind="ghost" Disabled="@(Rows.IndexOf(editing) == Rows.Count - 1)" OnClick="() => OpenEditor(Rows[Rows.IndexOf(editing) + 1])">Next row</ImportButton>
                    <ImportButton Kind="primary" OnClick="CloseEditor">Back to review</ImportButton>
                </Footer>
            </VendorDrawerShell>
        }

        <ImportFootBar CancelHref="@BackHref" Error="@Message" Saving="Saving" Disabled="@(ReadyCount == 0 || _previewing)" OnSave="ImportAsync"
                       SaveLabel="@($"Import {ReadyCount} ready {(ReadyCount == 1 ? "row" : "rows")}")">
            <span class="shi-foot-note" role="status">
                @if (_previewing) { <text>Checking rows…</text> }
                else if (_previewNote is not null) { <text>@_previewNote</text> }
                else { <text>@ReviewCounts. Only ready rows are imported.</text> }
            </span>
        </ImportFootBar>
    }
</div>

@code {
    [Parameter] public ObligationKind Kind { get; set; }

    /// <summary>The operation's name as the office knows it ("Kanmanggay", "Fiesta / Araw").</summary>
    [Parameter] public string Name { get; set; } = "Kanmanggay";

    /// <summary>Where "Back to ..." and Cancel return to.</summary>
    [Parameter] public string BackHref { get; set; } = "/menu";
    /// <summary>Historical registers may retain their documented numbers; ordinary imports use server allocation.</summary>
    [Parameter] public bool AllowImportedNumbers { get; set; } = true;
    [Parameter] public string EffectiveMonthLabel { get; set; } = "Effectivity Date";

    /// <summary>The civic-blue hero of the newer Operations pages instead of the light import hero.</summary>
    [Parameter] public bool BlueHero { get; set; } = true;

    private bool IsEvent => Kind == ObligationKind.FiestaArawLotRental;
    private string Holders => "Rent / Space Holders";
    private string Slug => IsEvent ? "fiesta-araw-lot-holders" : "kanmanggay-space-holders";
    private string? Message, _uploadError, _fileName;
    private bool Saving;
    private int _notImported;
    private ImportSpaceHoldersResult? _result;
    private List<Row> Rows = [];
    private Row? _editing, _returnFocus;
    private bool _focusEditor;
    private ElementReference _editorHeading;
    private readonly Dictionary<Row, ElementReference> _editButtons = [];
    private readonly string _errorId = $"shi-error-{Guid.NewGuid():N}";

    private void OpenEditor(Row row) { _editing = row; _focusEditor = true; }
    private void CloseEditor() { _returnFocus = _editing; _editing = null; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEditor) { _focusEditor = false; await _editorHeading.FocusAsync(); }
        else if (_returnFocus is { } row)
        {
            _returnFocus = null;
            if (_editButtons.TryGetValue(row, out var button)) await button.FocusAsync();
        }
    }

    private static string StatusLabel(SpaceHolderImportStatus state) => state switch
    {
        SpaceHolderImportStatus.Ready => "Ready",
        SpaceHolderImportStatus.Invalid => "Invalid",
        SpaceHolderImportStatus.NeedsSourceHolder => "Needs holder",
        SpaceHolderImportStatus.NeedsPayor => "Needs review",
        _ => "Needs review"
    };

    private int Step => _result is not null || Saving ? 3 : Rows.Count > 0 ? 2 : 1;
    private int ReadyCount => Rows.Count(r => StatusOf(r).Status == SpaceHolderImportStatus.Ready);
    private int InvalidCount => Rows.Count(r => StatusOf(r).Status == SpaceHolderImportStatus.Invalid);
    private int NeedsReviewCount => Rows.Count - ReadyCount - InvalidCount;
    private string ReviewCounts => $"{ReadyCount} ready · {InvalidCount} invalid" + (NeedsReviewCount > 0 ? $" · {NeedsReviewCount} need review" : "");

    private const string Signed = "Signed lease contract", SpaceOnly = "No contract (space only)";

    // NCC/TCC are the single source for rental-register visible labels and widths.
    // Do not expose administrative basis, contract reference, closure or validation as permanent columns.
    private static readonly ImportColumn SubjectCol = RentalImportColumns.Number with { Key = "subject", Label = "Rent / Space No.", Placeholder = "Auto" };
    private static readonly ImportColumn OccupantCol = RentalImportColumns.Occupant with { Key = "name" };
    private static readonly ImportColumn ContractNameCol = RentalImportColumns.ContractName;
    private static readonly ImportColumn EffectivityCol = RentalImportColumns.Effectivity with { Key = "start" };
    private static readonly ImportColumn YearsCol = RentalImportColumns.Years;
    private static readonly ImportColumn AreaCol = RentalImportColumns.Area;
    private static readonly ImportColumn ContractRateCol = RentalImportColumns.ContractMonthly with { Key = "contractRate" };
    private static readonly ImportColumn MonthlyCol = RentalImportColumns.ActualMonthly with { Key = "amount" };
    private static readonly ImportColumn WholeYearCol = RentalImportColumns.WholeYear;
    private static readonly ImportColumn AreaLocCol = RentalImportColumns.AreaLocation;
    private static readonly ImportColumn DelinquentCol = RentalImportColumns.Delinquent;
    private static readonly ImportColumn EventCol = new("event", "Event", "select", ["Fiesta", "Araw"], MinWidth: 130);
    private static readonly ImportColumn EventDateCol = new("start", "Event date", "date", MinWidth: 150);
    private static readonly ImportColumn EventAmountCol = new("amount", "Approved Event Amount (₱)", "number", MinWidth: 170, Placeholder: "0.00");
    private static readonly ImportColumn BasisCol = new("basis", "Lease type", "select", Options: [Signed, SpaceOnly]);
    private static readonly ImportColumn ContractReferenceCol = new("contractRef", "Contract reference", Placeholder: "Per signed lease");
    private static readonly ImportColumn ClosedCol = new("closed", "Closed on", "date");
    private IReadOnlyList<ImportColumn> ReviewColumns => IsEvent ? Columns : [OccupantCol, SubjectCol, BasisCol, EffectivityCol, MonthlyCol];
    private static string OptionText(ImportColumn col, string value) => col.Key == "basis" ? value == Signed ? "Contract" : "Space only" : value;

    private RenderFragment EditorField(Row row, ImportColumn col) => @<label class="avm-group">
        <span class="avm-label">@col.Label</span>
        @if (col.Type == "select")
        {
            <select class="avm-input @(ErrorColumn(row) == col.Key ? "form-input-error" : "")" aria-label="@($"{col.Label} of row {Rows.IndexOf(row) + 1}")" value="@CellOf(row, col)"
                    aria-invalid="@(ErrorColumn(row) == col.Key ? "true" : null)" aria-describedby="@(StatusOf(row).Status != SpaceHolderImportStatus.Ready ? _errorId : null)"
                    @onchange="e => CellChanged(new(row, col, e.Value?.ToString()))">
                <option value="">Choose…</option>
                @foreach (var option in col.Options) { <option value="@option">@OptionText(col, option)</option> }
            </select>
        }
        else
        {
            <input class="avm-input @(IsLocked(row, col) ? "avm-input-locked" : "") @(ErrorColumn(row) == col.Key ? "form-input-error" : "")"
                   aria-label="@($"{col.Label} of row {Rows.IndexOf(row) + 1}")" aria-invalid="@(ErrorColumn(row) == col.Key ? "true" : null)"
                   aria-describedby="@(StatusOf(row).Status != SpaceHolderImportStatus.Ready ? _errorId : null)"
                   type="@col.Type" step="@(col.Type == "number" ? "any" : null)" maxlength="@(col.Key == "contractRef" ? "200" : null)" value="@CellOf(row, col)" readonly="@IsLocked(row, col)"
                   placeholder="@(PlaceholderOf(row, col) ?? col.Placeholder)" title="@TitleOf(row, col)"
                   @oninput="e => CellChanged(new(row, col, e.Value?.ToString()))" />
        }
        @if (ErrorColumn(row) == col.Key) { <span class="form-error">@StatusOf(row).Why</span> }
    </label>;

    // Attach the existing validation result to its field; this does not add or change validation rules.
    private string? ErrorColumn(Row row) => row.Error switch
    {
        "Occupant is required" => "name",
        "Check approved amount" => "amount",
        "Choose the effectivity date" or "Use yyyy-MM-dd" => "start",
        "Choose Fiesta or Araw" => "event",
        "Choose an occupancy basis" => "basis",
        "No contract has no contract reference" => "contractRef",
        "Area location is too long" => "areaLoc",
        "Check area (sq.m)" => "area",
        "Years must be a whole number from 1 to 50" or "A Kanmanggay signed contract runs three years" => "years",
        "Check the contract monthly rental" => "contractRate",
        "Check closure date" => "closed",
        _ => row.Preview?.Code == "DuplicateSpace" ? "subject" : null
    };

    private IReadOnlyList<ImportColumn> Columns => IsEvent
        ? [OccupantCol, SubjectCol, EventCol, EventDateCol, EventAmountCol]
        : [OccupantCol, ContractNameCol, SubjectCol, EffectivityCol, YearsCol, AreaCol,
           ContractRateCol, MonthlyCol, WholeYearCol, AreaLocCol, DelinquentCol];

    // HEADER ONLY: a template carries column names and nothing the office could mistake for data the platform put there.
    private string TemplateUri => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join(",", Columns.Select(c => c.Label)) + "\r\n");

    private sealed class Row
    {
        public string Subject = "", Name = "", Amount = "", Start = "", ClosedText = "", EventName = "", ContractRef = "", BasisText = "";
        public string ContractName = "", YearsText = "", AreaText = "", ContractRateText = "", AreaLocation = "";
        public decimal Approved;
        public int? Years;
        public decimal? Area, ContractRate;
        public DateOnly StartDate;
        public DateOnly? Closed;
        public LotRentalEvent? Event;
        public string? Error;
        public SpaceHolderImportRowResult? Preview;

        public OccupancyArrangement? Basis => BasisText switch { Signed => OccupancyArrangement.SignedContract, SpaceOnly => OccupancyArrangement.SpaceOnly, _ => null };
    }

    // ── The grid's view of a row ───────────────────────────────────────────────────────────────────────────────────────
    // Columns are told apart by their own key, never by a label that an operation can reword.
    private string CellOf(Row row, ImportColumn col) => col.Key switch
    {
        "subject" => row.Subject,
        "name" => row.Name,
        "basis" => row.BasisText,
        "contractRef" => row.ContractRef,
        "contractName" => row.ContractName,
        "years" => row.YearsText,
        "area" => row.AreaText,
        "contractRate" => row.ContractRateText,
        "areaLoc" => row.AreaLocation,
        "delinquent" => string.Empty, // The canonical ledger computes arrears after registration.
        "wholeYear" => row.Approved > 0m ? (row.Approved * 12m).ToString("0.00", CultureInfo.InvariantCulture) : string.Empty,
        "event" => row.EventName,
        "closed" => row.ClosedText,
        "amount" => row.Amount,
        _ => row.Start
    };

    private void CellChanged(ImportCellChange<Row> change)
    {
        var row = change.Row;
        var value = change.Value ?? string.Empty;
        switch (change.Column.Key)
        {
            case "subject": row.Subject = value; break;
            case "name": row.Name = value; break;
            case "basis":
                row.BasisText = value;
                if (row.Basis != OccupancyArrangement.SignedContract)                                               // a space let without a contract carries no contract data
                    row.ContractRef = row.ContractName = row.YearsText = row.ContractRateText = string.Empty;
                break;
            case "contractRef": row.ContractRef = value; break;
            case "contractName": row.ContractName = value; break;
            case "years": row.YearsText = value; break;
            case "area": row.AreaText = value; break;
            case "contractRate": row.ContractRateText = value; break;
            case "areaLoc": row.AreaLocation = value; break;
            case "delinquent": break; // Display-only; never fabricate or import arrears.
            case "wholeYear": break;                                                                                // derived, never typed
            case "event": row.EventName = value; break;
            case "closed": row.ClosedText = value; break;
            case "amount": row.Amount = value; break;
            default: row.Start = value; break;
        }
        row.Preview = null;
        Validate(row);
        SchedulePreview();
    }

    // Contract data on a space let without a contract is shown settled, not typeable; the whole-year figure is always derived.
    private static readonly HashSet<string> ContractOnly = ["contractRef", "contractName", "years", "contractRate"];
    private bool IsLocked(Row row, ImportColumn col) => (col.Key == "subject" && !AllowImportedNumbers) || (!IsEvent && (col.Key is "wholeYear" or "delinquent" || ContractOnly.Contains(col.Key) && row.Basis != OccupancyArrangement.SignedContract));

    private static string? PlaceholderOf(Row row, ImportColumn col) =>
        col.Key == "subject"
            ? row.Preview?.Facts is { NumberOrigin: SpaceNumberOrigin.ServerSuggested } facts && !string.IsNullOrWhiteSpace(facts.Account.SubjectLabel) ? $"Auto · {facts.Account.SubjectLabel}" : "Auto"
            : col.Key is "wholeYear" or "delinquent" ? "—"
            : ContractOnly.Contains(col.Key) && row.Basis != OccupancyArrangement.SignedContract ? "—" : null;

    private static string? TitleOf(Row row, ImportColumn col) => col.Key == "subject"
        ? "Leave blank to have the server assign the next number." : null;

    // A row's state is the server's word once it has been checked there; until then (or if the check is unavailable) it is what this page can
    // tell: a row that fails its own checks is Invalid.
    private static (SpaceHolderImportStatus Status, string? Why) StatusOf(Row row) =>
        row.Error is not null ? (SpaceHolderImportStatus.Invalid, row.Error)
        : row.Preview is { } line ? (line.Status, line.Status is SpaceHolderImportStatus.Ready ? null : line.Message)
        : (SpaceHolderImportStatus.Ready, null);

    // ── Getting rows in ────────────────────────────────────────────────────────────────────────────────────────────────
    private void StartManual() { _uploadError = null; _fileName = null; Rows = [NewRow(null)]; SchedulePreview(); }
    private void AddRow(bool withContract) { Rows.Add(NewRow(withContract)); }
    // A lot has no basis; a space starts as a signed contract or as a space let without one, as the office chooses, and is never guessed.
    private Row NewRow(bool? withContract) { var row = new Row { BasisText = IsEvent || withContract is null ? string.Empty : withContract == true ? Signed : SpaceOnly }; Validate(row); return row; }

    // Sample rows exist to show what a filled register looks like. They are never saved except through the normal import.
    private void LoadSample()
    {
        _uploadError = null;
        _fileName = null;
        var month = PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        var today = PhilippineTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        Rows = IsEvent
            ? [Sample("1", "Maria Santos", amount: "2500", start: today, evt: "Fiesta"), Sample("2", "Jose Ramirez", amount: "3000", start: today, evt: "Fiesta"), Sample("1", "Ana Lopez", amount: "2500", start: today, evt: "Araw")]
            : [Sample("1", "Maria Santos", amount: "1500", start: today, basis: Signed, contract: "LC-2026-001", contractName: "Maria Santos", years: Kind == ObligationKind.KanmanggaySpaceRental ? "3" : "", area: "9.5", contractRate: "1500"), Sample("2", "Jose Ramirez", amount: "1200", start: today, basis: SpaceOnly), Sample("", "Ana Lopez", amount: "1800", start: today, basis: SpaceOnly)];
        foreach (var row in Rows) Validate(row);
        SchedulePreview();
    }

    private static Row Sample(string subject, string name, string amount, string start, string basis = "", string contract = "", string evt = "",
        string contractName = "", string years = "", string area = "", string contractRate = "") =>
        new() { Subject = subject, Name = name, Amount = amount, Start = start, BasisText = basis, ContractRef = contract, EventName = evt,
            ContractName = contractName, YearsText = years, AreaText = area, ContractRateText = contractRate };

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        var file = e.File;
        if (file is null) return;
        try
        {
            List<string[]> raw;
            if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                raw = SpreadsheetReader.ReadXlsx(buffer);
            }
            else if (file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                raw = SpreadsheetReader.ReadCsv(await reader.ReadToEndAsync());
            }
            else
            {
                _uploadError = file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase)
                    ? "The old .xls format isn't supported. Save it as .xlsx or .csv and upload again."
                    : "Unsupported file type. Upload a .csv or .xlsx file.";
                return;
            }
            if (!TryLoad(raw, file.Name)) _uploadError = "No rows were found in that file, or it has more than 200. Check the columns shown below and try again.";
        }
        catch (Exception)
        {
            _uploadError = "Couldn't read that file. Make sure it's a valid .csv or .xlsx export and try again.";
        }
    }

    // Reads rows by the file's own header when it has one we recognise, and by the documented column order when it has not.
    private bool TryLoad(List<string[]> raw, string? fileName)
    {
        var map = ColumnOrder;
        var rows = new List<Row>();
        foreach (var cells in raw)
        {
            if (cells.Length == 0 || cells.All(string.IsNullOrWhiteSpace)) continue;
            if (HeaderMapFor(cells) is { } header) { map = header; continue; }
            var row = new Row();
            for (var i = 0; i < cells.Length && i < map.Length; i++) Put(row, map[i], (cells[i] ?? string.Empty).Trim());
            if (string.IsNullOrWhiteSpace(row.Subject) && string.IsNullOrWhiteSpace(row.Name)) continue;
            if (!string.IsNullOrWhiteSpace(row.BasisText)) row.BasisText = CanonicalBasis(row.BasisText);
            else if (!string.IsNullOrWhiteSpace(row.ContractRef) || !string.IsNullOrWhiteSpace(row.ContractName) || !string.IsNullOrWhiteSpace(row.YearsText)) row.BasisText = Signed;   // only a signed contract has these
            Validate(row);
            rows.Add(row);
        }
        if (rows.Count is 0 or > 200) return false;
        Rows = rows;
        _fileName = fileName;
        _uploadError = null;
        Message = null;
        SchedulePreview();
        return true;
    }

    private enum Col { None, Subject, Name, Amount, Start, Closed, Event, Basis, Contract, ContractName, Years, Area, ContractRate, WholeYear, AreaLoc, Delinquent }

    private Col[] ColumnOrder => IsEvent
        ? [Col.Subject, Col.Name, Col.Event, Col.Start, Col.Amount, Col.Closed]
        : AllowImportedNumbers ? [Col.Subject, Col.Name, Col.Basis, Col.ContractName, Col.Contract, Col.Start, Col.Years, Col.Area, Col.ContractRate, Col.Amount, Col.WholeYear, Col.Closed]
        : [Col.Name, Col.Basis, Col.ContractName, Col.Contract, Col.Start, Col.Years, Col.Area, Col.ContractRate, Col.Amount, Col.WholeYear, Col.Closed];

    private static string Norm(string s) => new((s ?? string.Empty).ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

    private static Col ColFor(string header) => Norm(header) switch
    {
        "space" or "spaceno" or "spacenumber" or "lot" or "lotno" or "stallspaceno" or "rentspaceno" => Col.Subject,
        "occupant" or "actualoccupant" or "name" or "nameofoccupant" or "holder" or "nameoflesseeactualoccupants" or "nameoflesseeactualoccupant" or "actualoccupantlessee" or "actualoccupantleasee" => Col.Name,
        "monthly" or "monthlyrental" or "approvedmonthly" or "approvedmonthlyrental" or "approvedamount" or "approvedlotamount" or "approvedeventamount" or "amount" or "rental" or "actualmorental" or "actualmonthlyrental" or "actualmonthlyrentals" => Col.Amount,
        "start" or "startdate" or "startmonth" or "effectivemonth" or "effectivity" or "effectivitydate" or "contracteffectivitymonth" or "startcontracteffectivity" or "eventdate" or "occupyingsince" or "effectivityoflesseecontract" or "contractdate" => Col.Start,
        "closedon" or "closed" or "closeddate" or "enddate" => Col.Closed,
        "event" or "eventfiestaaraw" => Col.Event,
        "occupancybasis" or "basis" or "basisofoccupancy" or "arrangement" => Col.Basis,
        "contractreference" or "contractref" or "contractno" or "contract" => Col.Contract,
        "nameoncontract" or "nameoflesseepersignedcontract" or "nameoflesseepercontract" or "nameonsignedcontract" or "contractlessee" => Col.ContractName,
        "noofyears" or "years" or "numberofyears" or "term" or "contractduration" or "duration" => Col.Years,
        "area" or "areasqm" or "areasqmeter" or "areasqmeters" => Col.Area,
        "monthlyrentalcontract" or "monthlyrentalpercontract" or "monthlyrentalspercontract" or "monthlyrentalspercontract" or "contractrate" or "contractmonthlyrental" => Col.ContractRate,
        "wholeyearrental" or "wholeyear" or "annualrental" or "wholeyear12monthly" => Col.WholeYear,
        "arealoc" or "arealocation" => Col.AreaLoc,
        "delinquent" or "delinquentamount" => Col.Delinquent,
        _ => Col.None
    };

    // A header row is recognised when at least three of its cells name columns; its order then replaces the documented one.
    private static Col[]? HeaderMapFor(string[] cells)
    {
        var map = cells.Select(ColFor).ToArray();
        return map.Count(c => c != Col.None) >= 3 ? map : null;
    }

    private void Put(Row row, Col column, string value)
    {
        switch (column)
        {
            case Col.Subject: row.Subject = AllowImportedNumbers ? value : string.Empty; break;
            case Col.Name: row.Name = StripLeadingIndex(value); break;
            case Col.Amount: row.Amount = SheetNumber.Normalize(value); break;
            case Col.Start: row.Start = NormalizeStart(value); break;
            case Col.Closed: row.ClosedText = NormalizeDate(value); break;
            case Col.Event: row.EventName = value; break;
            case Col.Basis: row.BasisText = value; break;
            case Col.Contract: row.ContractRef = value; break;
            case Col.ContractName: row.ContractName = StripLeadingIndex(value); break;
            case Col.Years: row.YearsText = SheetNumber.Normalize(value); break;
            case Col.Area: row.AreaText = SheetNumber.Normalize(value); break;
            case Col.ContractRate: row.ContractRateText = SheetNumber.Normalize(value); break;
            case Col.AreaLoc: row.AreaLocation = value; break;
            case Col.Delinquent: break; // Billed arrears are never imported.
            case Col.WholeYear: break;                                             // derived from the monthly rental, never read from a sheet
        }
    }

    private static string StripLeadingIndex(string value) => System.Text.RegularExpressions.Regex.Replace(value, @"^\s*\d+\s*[\.\)]\s*", string.Empty);

    // An Excel date arrives as a serial number; a text date is read as written.
    private static string NormalizeDate(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        if (double.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var serial) && serial > 59 && serial < 100000)
            return DateTime.FromOADate(serial).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if (raw.Length == 7 && raw[4] == '-') return raw + "-01";
        return DateTime.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : raw;
    }

    // A signed contract's effectivity is a date (billing starts in that month); an event's is the event date. A bare month is read as the 1st.
    private string NormalizeStart(string raw) => NormalizeDate(raw);

    // The basis is read only from words that say it. Anything else is left blank for the office to choose, never guessed.
    private static string CanonicalBasis(string text)
    {
        var n = Norm(text);
        if (n.Contains("nocontract") || n.Contains("spaceonly") || n == "space") return SpaceOnly;
        if (n.Contains("signed") || n.Contains("lease") || n.Contains("contract")) return Signed;
        return string.Empty;
    }

    // ── Validation ─────────────────────────────────────────────────────────────────────────────────────────────────────
    private void Validate(Row row)
    {
        row.Error = null;
        if (!decimal.TryParse(SheetNumber.Normalize(row.Amount), NumberStyles.Number, CultureInfo.InvariantCulture, out row.Approved) || row.Approved <= 0m)
            row.Error = "Check approved amount";
        var date = row.Start.Length == 7 ? row.Start + "-01" : row.Start;
        if (!DateOnly.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out row.StartDate))
            row.Error = IsEvent ? "Use yyyy-MM-dd" : "Choose the effectivity date";
        if (IsEvent)
        {
            if (Enum.TryParse<LotRentalEvent>(row.EventName, true, out var ev) && Enum.IsDefined(ev)) row.Event = ev;
            else { row.Event = null; row.Error = "Choose Fiesta or Araw"; }
        }
        else if (row.Basis is null) row.Error = "Choose an occupancy basis";
        else if (row.Basis == OccupancyArrangement.SpaceOnly && !string.IsNullOrWhiteSpace(row.ContractRef)) row.Error = "No contract has no contract reference";
        row.Years = null; row.Area = null; row.ContractRate = null;
        if (!IsEvent)
        {
            if (row.AreaLocation.Length > 250) row.Error = "Area location is too long";
            // Area is a plain recorded measure; the contract's term and stated rate exist only behind a signed contract.
            if (!string.IsNullOrWhiteSpace(row.AreaText))
            {
                if (decimal.TryParse(SheetNumber.Normalize(row.AreaText), NumberStyles.Number, CultureInfo.InvariantCulture, out var area) && area >= 0m && area <= 1_000_000m && decimal.Round(area, 2) == area)
                    row.Area = area == 0m ? null : area;
                else row.Error = "Check area (sq.m)";
            }
            if (row.Basis == OccupancyArrangement.SignedContract)
            {
                if (!string.IsNullOrWhiteSpace(row.YearsText))
                {
                    if (!decimal.TryParse(SheetNumber.Normalize(row.YearsText), NumberStyles.Number, CultureInfo.InvariantCulture, out var years) || years != decimal.Truncate(years) || years is < 1 or > 50)
                        row.Error = "Years must be a whole number from 1 to 50";
                    else if (Kind == ObligationKind.KanmanggaySpaceRental && years != 3m) row.Error = "A Kanmanggay signed contract runs three years";
                    else row.Years = (int)years;
                }
                if (!string.IsNullOrWhiteSpace(row.ContractRateText))
                {
                    if (decimal.TryParse(SheetNumber.Normalize(row.ContractRateText), NumberStyles.Number, CultureInfo.InvariantCulture, out var stated) && stated > 0m && stated <= 1_000_000m && decimal.Round(stated, 2) == stated)
                        row.ContractRate = stated;
                    else row.Error = "Check the contract monthly rental";
                }
            }
        }
        // The number may be blank: the server numbers it. Only the occupant is required here.
        if (string.IsNullOrWhiteSpace(row.Name)) row.Error = "Occupant is required";
        row.Closed = null;
        if (!string.IsNullOrWhiteSpace(row.ClosedText))
        {
            if (DateOnly.TryParseExact(row.ClosedText.Trim(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)) row.Closed = end;
            else row.Error = "Check closure date";
        }
    }

    private void RemoveRow(int index)
    {
        if (index < 0 || index >= Rows.Count) return;
        if (_editing == Rows[index]) _editing = null;
        _editButtons.Remove(Rows[index]);
        Rows.RemoveAt(index);
        if (Rows.Count == 0) { _fileName = null; Message = null; _previewNote = null; }
        else SchedulePreview();
    }

    // One id per filling-in of the list: a second click or a retry after a lost response is the same submission, so it cannot register the holders twice.
    private Guid _operationId = Guid.NewGuid();
    private void ResetAll() { _editing = null; _editButtons.Clear(); _operationId = Guid.NewGuid(); Rows = []; _result = null; Message = null; _uploadError = null; _fileName = null; _notImported = 0; _previewNote = null; }

    // ── The server's typed preview ─────────────────────────────────────────────────────────────────────────────────────
    private bool _previewing;
    private string? _previewNote;
    private CancellationTokenSource? _previewDelay;

    // Billing starts in the month of the effectivity date; the signed contract keeps the date itself. Nothing is invented for a column left blank.
    private ImportSpaceHolderRow BuildRow(Row r)
    {
        var signed = !IsEvent && r.Basis == OccupancyArrangement.SignedContract;
        var billingStart = IsEvent ? r.StartDate : new DateOnly(r.StartDate.Year, r.StartDate.Month, 1);
        return new(new(Kind, Guid.Empty, null, AllowImportedNumbers ? r.Subject.Trim() : string.Empty,
            r.Event, IsEvent ? r.StartDate : null, billingStart, r.Approved,
            IsEvent ? null : r.Basis, !signed || string.IsNullOrWhiteSpace(r.ContractRef) ? null : r.ContractRef.Trim(), r.Name.Trim(),
            signed && !string.IsNullOrWhiteSpace(r.ContractName) ? r.ContractName.Trim() : null,
            signed ? r.StartDate : null, signed ? r.Years : null, IsEvent ? null : r.Area,
            IsEvent || string.IsNullOrWhiteSpace(r.AreaLocation) ? null : r.AreaLocation.Trim(), signed ? r.ContractRate : null), r.Closed);
    }

    private void SchedulePreview()
    {
        _previewDelay?.Cancel();
        _previewDelay = new CancellationTokenSource();
        _ = DebouncedPreviewAsync(_previewDelay.Token);
    }

    private async Task DebouncedPreviewAsync(CancellationToken token)
    {
        try { await Task.Delay(400, token); } catch (OperationCanceledException) { return; }
        await InvokeAsync(PreviewAsync);
    }

    // Asks the server to check every well-formed row without saving anything: it answers Ready / Needs Payor / Invalid with a stable code,
    // finds duplicate spaces, and suggests the next number in this operation. Nothing is created or reserved by asking.
    private async Task PreviewAsync()
    {
        foreach (var row in Rows) row.Preview = null;
        var checkable = Rows.Where(r => r.Error is null).ToList();
        if (checkable.Count == 0 || checkable.Count > 200) { _previewNote = null; StateHasChanged(); return; }
        _previewing = true;
        StateHasChanged();
        try
        {
            var result = await Api.PreviewSpaceHoldersAsync(new(checkable.Select(BuildRow).ToList()));
            if (result.IsSuccess && result.Value is { } preview && preview.Rows.Count == checkable.Count)
            {
                var ordered = preview.Rows.OrderBy(x => x.RowNumber).ToList();
                for (var i = 0; i < checkable.Count; i++) checkable[i].Preview = ordered[i];
                _previewNote = null;
            }
            else _previewNote = "The server check is unavailable. Rows are checked here only; the server checks them again when you import.";
        }
        catch { _previewNote = "The server check is unavailable. Rows are checked here only; the server checks them again when you import."; }
        finally { _previewing = false; StateHasChanged(); }
    }

    // ── Saving ─────────────────────────────────────────────────────────────────────────────────────────────────────────
    private async Task ImportAsync()
    {
        // Only rows the office's own checks and the server's preview call Ready are sent. A blank number stays blank, so the server numbers it
        // again under its own lock when it saves; the suggestion shown in the grid is only a hint.
        var ready = Rows.Where(r => StatusOf(r).Status == SpaceHolderImportStatus.Ready).ToList();
        if (Saving || _previewing || ready.Count == 0) return;
        Saving = true;
        Message = null;
        try
        {
            var result = await Api.ImportSpaceHoldersAsync(new(ready.Select(BuildRow).ToList(), _operationId));
            if (result.IsSuccess && result.Value is { } summary)
            {
                _notImported = Rows.Count - ready.Count;
                _result = summary;
            }
            else Message = result.Error ?? "The import could not be completed.";
        }
        catch { Message = "The import could not be confirmed. Reload the holder list before retrying."; }
        finally { Saving = false; }
    }
}
