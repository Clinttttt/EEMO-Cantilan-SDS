@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject IOfficeSourcesApiClient Api

@* From NPM occupants: the office confirms which NPM occupant is which registered Fish/Meat vendor. One row per occupant with its link state and a
   single contextual action. The server rules are unchanged: a verification note is required, a historical occupancy or an area/type exception and a
   possible duplicate each need an explicit confirmation, a name match is only a suggestion, and only the Head links, registers or corrects. *@
@if (Show)
{
<VendorDrawerShell Show="@(Show && !_registering)" Title="From NPM occupants" Subtitle="Fish and Meat areas" OnClose="Close">
    <Icon><svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-2 2M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l2-2" /></svg></Icon>
    <ChildContent>
        @if (_loading) { <p role="status">Loading NPM occupancies…</p> }
        else if (_selected is null)
        {
            <div class="npm-link-tools">
                <input class="avm-input" type="search" aria-label="Search NPM occupants" placeholder="Search occupant or stall" autocomplete="off" @bind="_search" @bind:event="oninput" />
                <div class="npm-link-seg" role="group" aria-label="Area">
                    @foreach (var (value, label) in AreaFilters)
                    {
                        <button type="button" class="@(_area == value ? "is-active" : "")" aria-pressed="@(_area == value ? "true" : "false")" @onclick="() => _area = value">@label</button>
                    }
                </div>
            </div>
            <details class="npm-link-more">
                <summary>More views</summary>
                <div class="npm-link-options npm-link-filters">
                    <label><input type="checkbox" @bind="_historical" @bind:after="Load" /> Include historical occupancies</label>
                    <label><input type="checkbox" @bind="_exceptions" @bind:after="Load" /> Include other areas for manual review</label>
                </div>
            </details>
            @foreach (var row in VisibleRows)
            {
                var linked = row.Links.Any(x => x.CorrectedAtUtc == null);
                <button type="button" class="npm-link-candidate" title="@(linked ? "View the linked registration" : "Link or register this vendor")" @onclick="() => Select(row)">
                    <span class="npm-link-identity"><strong>@row.Occupant</strong><span>@row.Area · Stall @row.StallNo@(row.Active ? "" : " · Historical")</span></span>
                    <span class="npm-link-state @(linked ? "is-linked" : "is-open")">@(linked ? "Linked" : "Not linked")</span>
                    <svg class="npm-link-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-2 2M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l2-2" /></svg>
                </button>
            }
            @if (VisibleRows.Count == 0 && _error is null) { <p class="npm-link-empty">No occupancies match this view.</p> }
        }
        else
        {
            <section class="npm-link-summary" aria-label="Occupant information">
                <h3>@_selected.Occupant</h3>
                <p>New Public Market · @_selected.Area · Stall @_selected.StallNo · @(_selected.Active ? "Active occupancy" : "Historical occupancy") · Tax year @TaxYear</p>
                <details class="npm-link-evidence"><summary>Source details</summary>
                    <dl class="npm-link-facts"><div><dt>Contract reference</dt><dd>@_selected.ContractId</dd></div><div><dt>Effective from</dt><dd>@_selected.EffectiveFrom.ToString("MMM d, yyyy")</dd></div></dl>
                </details>
            </section>
            @if (_selected.Links.Count > 0 || _correcting.HasValue)
            {
            <section class="npm-link-section" aria-label="Registration status">
            <h3>Linked registration</h3>
            @foreach (var link in _selected.Links)
            {
                <div class="npm-link-record">
                    <strong>@VendorName(link.VendorRegistrationId)</strong>
                    <span>@(link.CorrectedAtUtc.HasValue ? "Corrected link" : "Verified registration linked")</span>
                    <a href="@DetailsUrl(link.VendorRegistrationId)">View registration</a>
                    <details class="npm-link-evidence"><summary>Verification history</summary><p>@link.ConfirmedBy · @link.ConfirmedAtUtc.ToString("MMM d, yyyy") · @link.ConfirmationNote</p>
                    @if (link.CorrectedAtUtc is { } corrected) { <p>@link.CorrectionReason · @link.CorrectedBy · @corrected.ToString("MMM d, yyyy")</p> }</details>
                    @if (!link.CorrectedAtUtc.HasValue && _head)
                    {
                        <button type="button" class="btn-ghost" disabled="@_saving" @onclick="() => _correcting = link.Id">Correct link</button>
                    }
                </div>
            }
            @if (_correcting.HasValue)
            {
                <div class="avm-group"><label class="avm-label" for="npm-correction">Correction reason</label>
                <input id="npm-correction" class="avm-input" maxlength="500" @bind="_correctionReason" />
                </div>
            }
            </section>
            }
            @if (_head && !_correcting.HasValue)
            {
                <section class="npm-link-section" aria-label="Registration action">
                @if (!_path.HasValue)
                {
                    <p class="npm-link-muted">This occupant is already linked. Link a separate registration only for a verified separate business or vendor type.</p>
                    <button type="button" class="btn-ghost" @onclick="() => ChoosePath(ReviewPath.Link)">Link a separate registration</button>
                }
                else if (_path == ReviewPath.Link)
                {
                    <h3>Link a registration</h3>
                    @if (_selected.PossibleMatches.Count > 0)
                    {
                        <p class="npm-link-muted">Similar names are suggestions only. Choose the one that is the same vendor.</p>
                        <div class="npm-link-picks" role="group" aria-label="Possible matches">
                            @foreach (var match in _selected.PossibleMatches) { <button type="button" class="npm-link-pick @(_vendorId == match.Id.ToString() ? "is-picked" : "")" aria-pressed="@(_vendorId == match.Id.ToString() ? "true" : "false")" @onclick="() => PickVendor(match.Id)"><strong>@match.DisplayName</strong><span>@match.VendorType · @(match.BusinessName ?? "No business name recorded")</span></button> }
                        </div>
                    }
                    <div class="avm-group"><label class="avm-label" for="npm-vendor-search">@(_selected.PossibleMatches.Count > 0 ? "Or search another registration" : "Search registrations")</label>
                    <input id="npm-vendor-search" class="avm-input" type="search" autocomplete="off" placeholder="Vendor or business" @bind="_vendorSearch" @bind:event="oninput" /></div>
                    @if (_vendorSearch.Trim().Length >= 2)
                    {
                        <div class="npm-link-picks" role="group" aria-label="Search results">
                            @foreach (var v in FilteredVendors.Take(6)) { <button type="button" class="npm-link-pick @(_vendorId == v.Id.ToString() ? "is-picked" : "")" aria-pressed="@(_vendorId == v.Id.ToString() ? "true" : "false")" @onclick="() => PickVendor(v.Id)"><strong>@v.DisplayName</strong><span>@v.VendorType · @(v.BusinessName ?? "No business name recorded")</span></button> }
                            @if (!FilteredVendors.Any()) { <p class="npm-link-empty">No registration matches.</p> }
                        </div>
                    }
                    @if (SelectedVendor is { } vendor)
                    {
                        <div class="npm-link-confirmation"><strong>@vendor.DisplayName</strong><span>@vendor.VendorType · @(vendor.BusinessName ?? "No business name recorded") · Tax year @vendor.TaxYear</span><span>Link to NPM · @_selected.Area · Stall @_selected.StallNo</span></div>
                    }
                    <button type="button" class="btn-ghost npm-link-switch" @onclick="() => ChoosePath(ReviewPath.New)">Register a new vendor instead</button>
                }
                else
                {
                    <h3>Register from NPM</h3>
                    <p class="npm-link-muted">No registration is linked to this occupant. Review the office registration details next; only the occupant name and suggested Fish/Meat type come from NPM.</p>
                    <button type="button" class="btn-ghost npm-link-switch" @onclick="() => ChoosePath(ReviewPath.Link)">Link an existing registration instead</button>
                }
                @if (_path.HasValue)
                {
                @if (_path == ReviewPath.Link)
                {
                <div class="avm-group npm-office-evidence"><label class="avm-label" for="npm-confirmation">Office link verification <span class="avm-req">*</span></label>
                <input id="npm-confirmation" class="avm-input" maxlength="500" placeholder="Reference or evidence checked by the office" @bind="_note" />
                <small class="npm-link-muted">Required to confirm the NPM association; this is not a payment or vendor fee.</small></div>
                }
                <div class="npm-link-options">
                    @if (RequiresException) { <label><input type="checkbox" @bind="_exceptionConfirmed" /> Exception confirmed<span>Verify this historical occupancy or area/type exception.</span></label> }
                    @if (_path == ReviewPath.New && RequiresDuplicateReview) { <label><input type="checkbox" @bind="_duplicatesReviewed" /> Existing records reviewed<span>A separate legitimate business or vendor type is confirmed.</span></label> }
                </div>
                }
                </section>
            }
        }
        @if (_error is not null) { <div class="avm-error" role="alert">@_error @if (_selected is null) { <button class="btn-ghost" type="button" disabled="@_loading" @onclick="Load">Retry</button> }</div> }
    </ChildContent>
    <Footer>
        @if (_selected is null) { <button class="btn-ghost" type="button" disabled="@_saving" @onclick="Close">Close</button> }
        else
        {
            <button class="btn-ghost" type="button" disabled="@_saving" @onclick="Back">Back</button>
            @if (_head && _correcting.HasValue) { <button type="button" class="btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_correctionReason))" @onclick="Correct">Confirm correction</button> }
            else if (_head && _path == ReviewPath.Link) { <button type="button" class="btn-primary" disabled="@(!CanContinue || SelectedVendor is null)" @onclick="Link">Confirm link</button> }
            else if (_head && _path == ReviewPath.New) { <button type="button" class="btn-primary" disabled="@(!CanContinue || RequiresDuplicateReview && !_duplicatesReviewed)" @onclick="NewRegistration">Register from NPM</button> }
        }
    </Footer>
</VendorDrawerShell>
@if (_registering)
{
<VendorRegistrationDrawer Show="@(Show && _registering)" Model="_form" Title="Register Fish/Meat vendor" Subtitle="@($"Tax year {TaxYear} · NPM-linked registration")" CanSubmit="@(!string.IsNullOrWhiteSpace(_note))"
                          FormId="npm-vendor-register" Saving="_saving" Error="@_error" OnSubmit="Register" OnCancel="BackToReview">
    <SourceContext>
        @if (_selected is not null)
        {
            <div class="npm-link-record"><strong>NPM occupancy</strong><span>@_selected.Area · Stall @_selected.StallNo · Tax year @TaxYear</span><details class="npm-link-evidence"><summary>Source details</summary><p>Contract @_selected.ContractId</p></details></div>
            <div class="avm-group npm-office-evidence"><label class="avm-label" for="npm-registration-evidence">Office link reference <span class="avm-req">*</span></label>
                <input id="npm-registration-evidence" class="avm-input" maxlength="500" placeholder="Source verified by office / reference checked" @bind="_note" @bind:event="oninput" />
                <small class="npm-link-muted">Only for documenting the verified NPM association. No collection is recorded.</small></div>
            @if (!_selected.Active || _selected.SuggestedType != _form.Type) { <div class="npm-link-options"><label><input type="checkbox" @bind="_exceptionConfirmed" /> Exception confirmed<span>Verify this historical occupancy or area/type exception.</span></label></div> }
        }
    </SourceContext>
</VendorRegistrationDrawer>
}
}

@code {
    private enum ReviewPath { Link, New }
    private static readonly (string Value, string Label)[] AreaFilters = [("All", "All"), ("Fish", "Fish"), ("Meat", "Meat")];
    private ReviewPath? _path;
    private string _area = "All";
    private bool HasVerifiedLink => _selected?.Links.Any(x => x.CorrectedAtUtc == null) == true;
    private bool RequiresDuplicateReview => HasVerifiedLink || _selected?.PossibleMatches.Count > 0;
    private FishMeatVendorRegistrationDto? SelectedVendor => Guid.TryParse(_vendorId, out var id) ? _vendors.FirstOrDefault(x => x.Id == id) : null;
    private bool RequiresException => _selected is { } source && (!source.Active || !source.SuggestedType.HasValue || _path == ReviewPath.Link && SelectedVendor is { } vendor && source.SuggestedType != vendor.VendorType);
    private bool CanContinue => !_saving && (_path == ReviewPath.New || !string.IsNullOrWhiteSpace(_note)) && (!RequiresException || _exceptionConfirmed);
    private void ChoosePath(ReviewPath path) { _path = path; _exceptionConfirmed = false; _duplicatesReviewed = false; _error = null; }
    // A suggestion is chosen by an explicit click; nothing is ever preselected.
    private void PickVendor(Guid id) { _vendorId = id.ToString(); _exceptionConfirmed = false; _error = null; }
    private void Back() { if (_saving) return; if (_correcting.HasValue) _correcting = null; else { _path = null; _selected = null; } _error = null; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public int TaxYear { get; set; }
    [Parameter] public Guid? InitialContractId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? Authentication { get; set; }
    private bool _head, _wasShown, _loading, _saving, _registering, _historical, _exceptions, _exceptionConfirmed, _duplicatesReviewed;
    private string _search = "", _vendorSearch = "", _vendorId = "", _note = "", _correctionReason = "";
    private string? _error, _submittedIntent;
    private Guid _operation = Guid.NewGuid();
    private Guid? _correcting;
    private IReadOnlyList<NpmVendorCandidate> _rows = [];
    private IReadOnlyList<FishMeatVendorRegistrationDto> _vendors = [];
    private NpmVendorCandidate? _selected;
    private VendorRegistrationForm _form = new();
    private IReadOnlyList<NpmVendorCandidate> VisibleRows => _rows
        .Where(x => _area switch { "Fish" => x.SuggestedType == FishMeatVendorType.Fish, "Meat" => x.SuggestedType == FishMeatVendorType.Meat, _ => true })
        .Where(x => string.IsNullOrWhiteSpace(_search) || $"{x.Occupant} {x.StallNo} {x.Area}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
    private IEnumerable<FishMeatVendorRegistrationDto> FilteredVendors => _vendors.Where(x => $"{x.DisplayName} {x.BusinessName}".Contains(_vendorSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private string VendorName(Guid id) => _vendors.FirstOrDefault(x => x.Id == id)?.DisplayName ?? "Recorded vendor registration";
    private string DetailsUrl(Guid id) => $"/operations/fish-meat-vendor-fees/manage?taxYear={TaxYear}&registrationId={id}";
    protected override async Task OnParametersSetAsync()
    {
        if (Show && !_wasShown)
        {
            _head = Authentication is not null && (await Authentication).User.IsInRole("SuperAdmin");
            _selected = null; _registering = false; _historical = InitialContractId.HasValue; _exceptions = InitialContractId.HasValue; _area = "All";
            await Load();
            if (InitialContractId is { } id)
            {
                var row = _rows.SingleOrDefault(x => x.ContractId == id);
                if (row is null) _error = "This NPM occupancy is unavailable."; else Select(row);
            }
        }
        _wasShown = Show;
    }
    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            var candidates = await Api.NpmVendorCandidatesAsync(TaxYear, _historical, _exceptions);
            var vendors = await Api.RegistrationsAsync(TaxYear);
            if (!candidates.IsSuccess || !vendors.IsSuccess) { _rows = []; _error = "NPM registration evidence could not be loaded."; return; }
            _rows = candidates.Value!.Rows; _vendors = vendors.Value!;
        }
        catch { _error = "NPM registration evidence could not be loaded."; }
        finally { _loading = false; }
    }
    // The situation decides the first step: similar names to review, or nothing to link and so a registration from NPM. An occupant that is already linked shows
    // that link and offers nothing until the Head asks to link a separate registration.
    private void Select(NpmVendorCandidate row)
    {
        _selected = row; _vendorId = ""; _vendorSearch = ""; _note = ""; _error = null; _correcting = null;
        _exceptionConfirmed = false; _duplicatesReviewed = false; _submittedIntent = null; _operation = Guid.NewGuid();
        _path = row.Links.Any(x => x.CorrectedAtUtc == null) ? null : row.PossibleMatches.Count > 0 ? ReviewPath.Link : ReviewPath.New;
    }
    private ConfirmNpmVendorAssociationRequest Request() => new(_operation, _selected!.ContractId, _selected.StallId, _selected.SourceVersion, _note.Trim(), _exceptionConfirmed, _duplicatesReviewed);
    private void PrepareIntent(string intent)
    {
        if (_submittedIntent is not null && _submittedIntent != intent) _operation = Guid.NewGuid();
        _submittedIntent = intent;
    }
    private async Task Link()
    {
        if (_saving || !_head || !Guid.TryParse(_vendorId, out var id)) return;
        PrepareIntent($"link|{id}|{_selected?.SourceVersion}|{_note}|{_exceptionConfirmed}|{_duplicatesReviewed}");
        _saving = true; _error = null;
        try { var result = await Api.LinkNpmVendorAsync(id, Request()); if (!result.IsSuccess) _error = Problem(result.Error); else await RefreshSelected(); }
        catch { _error = "The link could not be saved. Retry keeps the same request identity."; }
        finally { _saving = false; }
    }
    private void NewRegistration()
    {
        _form = new() { Name = _selected!.Occupant, Type = _selected.SuggestedType ?? FishMeatVendorType.Fish, Kind = VendorRegistrationKind.New, TaxYear = TaxYear };
        _registering = true; _error = null;
    }
    private async Task Register()
    {
        if (_saving || !_head || string.IsNullOrWhiteSpace(_note)) return;
        PrepareIntent($"register|{_form.Fingerprint}|{_selected?.SourceVersion}|{_note}|{_exceptionConfirmed}|{_duplicatesReviewed}");
        _saving = true; _error = null;
        try
        {
            var result = await Api.RegisterAsync(new(_operation, TaxYear, _form.Type, _form.Kind, _form.Name.Trim(),
                VendorRegistrationForm.Blank(_form.Business), VendorRegistrationForm.Blank(_form.Address), null, Request(),
                VendorRegistrationForm.Blank(_form.LastName), VendorRegistrationForm.Blank(_form.FirstName),
                VendorRegistrationForm.Blank(_form.MiddleName), VendorRegistrationForm.Blank(_form.NameExtension),
                VendorRegistrationForm.Blank(_form.Sex), VendorRegistrationForm.Blank(_form.NatureOfBusiness)));
            if (!result.IsSuccess) _error = Problem(result.Error); else { _registering = false; await RefreshSelected(); }
        }
        catch { _error = "The registration could not be saved. Retry keeps the same request identity."; }
        finally { _saving = false; }
    }
    private async Task Correct()
    {
        if (_saving || !_head || _correcting is not { } id) return;
        PrepareIntent($"correct|{id}|{_correctionReason}"); _saving = true; _error = null;
        try { var result = await Api.CorrectNpmVendorLinkAsync(id, new(_operation, _correctionReason.Trim())); if (!result.IsSuccess) _error = Problem(result.Error); else await RefreshSelected(); }
        catch { _error = "The correction could not be saved."; }
        finally { _saving = false; }
    }
    private async Task RefreshSelected()
    {
        var id = _selected!.ContractId; await Load(); _selected = _rows.SingleOrDefault(x => x.ContractId == id);
        _correcting = null; _path = null; _submittedIntent = null; _operation = Guid.NewGuid(); await OnSaved.InvokeAsync();
    }
    private static string Problem(string? code) => code switch
    {
        "RequiresDuplicateReview" => "Review existing registrations before confirming a distinct new registration.",
        "RequiresExceptionConfirmation" => "Confirm the historical occupancy or area/type exception before saving.",
        "NpmOccupancyChanged" => "The NPM occupancy changed. Close and reopen this review.",
        "NpmRegistrationAlreadyLinked" or "AssociationAlreadyExists" => "A verified link already exists. Open the existing registration.",
        "RegistrationIntentConflict" => "This request was already saved with different details. Reopen the review.",
        "RegistryConcurrencyConflict" => "Another request was saved concurrently. Retry or reopen the review.",
        _ => "The request could not be saved. Verify the source account and confirmation evidence."
    };
    private async Task Close() { if (!_saving) await OnClose.InvokeAsync(); }
    private void BackToReview() { if (!_saving) { _registering = false; _error = null; } }
}
