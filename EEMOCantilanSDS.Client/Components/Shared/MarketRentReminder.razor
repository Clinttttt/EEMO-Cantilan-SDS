@using System.Security.Claims
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject IStallsApiClient StallsApi
@inject IFacilitiesApiClient FacilitiesApi
@inject EEMOCantilanSDS.Client.Services.FacilityState FacilityCatalog
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@*
    One-time confirmation of the market's MONTHLY rent, for an LGU that has not stated one.

    A market space is let for a monthly rent and collected in daily installments. Where an LGU has not stated its
    ordinance month, the system charges thirty of its daily fee. That is right for an office whose ordinance follows
    the same convention and quietly wrong for one whose does not — so the office is shown the figure in force and
    asked to confirm it, once.

    Design rules:
      • The reference tenant is never asked: the constants this platform derives from are its own ordinance, so its
        ₱30 × 30 = ₱900 is already the figure on its paper. The API decides this, not the page.
      • Head only. An Admin cannot edit rates, so a question they cannot answer would be noise.
      • Only for a tenant that runs a market.
      • A calm notice in the office's own palette, not an alarm: the figure in force is correct until told otherwise,
        so nothing here is coloured as a fault.
      • FAILS QUIET. Any error and nothing is shown; a setup question must never stand between the office and its work.
*@

@if (_show)
{
    <div class="rent-confirm-backdrop" @onclick="Later"></div>
    <div class="rent-confirm" role="dialog" aria-modal="true" aria-labelledby="rent-confirm-title"
         tabindex="-1" @ref="_dialog" @onkeydown="OnKeyDown">
        <div class="rent-confirm-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21h18" />
                <path d="M5 21V8l7-4 7 4v13" />
                <path d="M9 21v-6h6v6" />
            </svg>
        </div>

        <div id="rent-confirm-title" class="rent-confirm-title">
            @(_askingBasis ? "How does your office measure a market month?" : "Confirm the monthly market rent")
        </div>

        @if (_askingBasis)
        {
            @* Asked FIRST, and asked before the office records vendors, because the answer decides what every month those
               vendors owe adds up to. Stated in the office's OWN figures rather than by naming two conventions: both are
               defensible ordinances and the difference only becomes plain when the numbers sit side by side. *@
            <p class="rent-confirm-text">
                A market space is collected per day. What a MONTH owes is your ordinance's decision, and both answers below
                are ordinary. Your daily fee is <strong>@Money(_daily)</strong>.
            </p>

            <div class="rent-basis-choices">
                <label class="rent-basis-choice @(_basisChoice == NpmMonthBasis.RentGoal ? "rent-basis-on" : "")">
                    <input type="radio" name="rent-basis" checked="@(_basisChoice == NpmMonthBasis.RentGoal)"
                           @onchange="() => _basisChoice = NpmMonthBasis.RentGoal" />
                    <span class="rent-basis-name">Fixed monthly rent</span>
                    <span class="rent-basis-meta">The monthly obligation remains the same regardless of the number of days in the month. Every month owes @Money(_daily * DaysInMonthConvention).</span>
                </label>

                <label class="rent-basis-choice @(_basisChoice == NpmMonthBasis.PureDays ? "rent-basis-on" : "")">
                    <input type="radio" name="rent-basis" checked="@(_basisChoice == NpmMonthBasis.PureDays)"
                           @onchange="() => _basisChoice = NpmMonthBasis.PureDays" />
                    <span class="rent-basis-name">Calendar-day billing</span>
                    <span class="rent-basis-meta">The monthly obligation is based on the actual number of days in the month. A 31-day month owes @Money(_daily * 31), February @Money(_daily * 28).</span>
                </label>
            </div>

            @if (_error is not null)
            {
                <p class="rent-confirm-error">@_error</p>
            }

            <div class="rent-confirm-actions">
                <button type="button" class="rent-confirm-later" @onclick="Later" disabled="@_saving">Not now</button>
                <button type="button" class="rent-confirm-go" @onclick="ConfirmBasisAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save this rule")
                </button>
            </div>
        }
        else
        {
        <p class="rent-confirm-text">
            A market space is let for a monthly rent and collected in daily installments. Your office has not yet
            stated its monthly amount, so the system is using
            <strong>@Money(_inUse)</strong> a month — @Money(_daily) a day × @DaysInMonthConvention.
        </p>
        <p class="rent-confirm-note">
            If your ordinance states that amount, confirm it. If it states another, set it in
            <strong>Settings → Facilities &amp; Rates</strong>, and every balance, report and official list will state
            the figure your office reconciles against.
        </p>

        @if (_error is not null)
        {
            <p class="rent-confirm-error">@_error</p>
        }

        <div class="rent-confirm-actions">
            <button type="button" class="rent-confirm-later" @onclick="Later" disabled="@_saving">Not now</button>
            <button type="button" class="rent-confirm-secondary" @onclick="OpenRates" disabled="@_saving">Review rates</button>
            <button type="button" class="rent-confirm-go" @onclick="ConfirmInUseAsync" disabled="@_saving">
                @(_saving ? "Confirming…" : $"Confirm {Money(_inUse)}")
            </button>
        </div>
        }
    </div>
}

@code {
    private bool _show;
    private bool _saving;
    private string? _error;
    private decimal _inUse;
    private decimal _daily;
    private ElementReference _dialog;
    private bool _focused;

    /// <summary>
    /// Whether the office is being asked which RULE it measures a month by, rather than to confirm a monthly amount.
    /// </summary>
    /// <remarks>
    /// The rule comes first and supersedes the rent question: an office that has not said how it measures a month cannot
    /// sensibly be asked to confirm a monthly figure, and on the days basis it will never have one to confirm. Answering
    /// "a monthly rent" then falls through to the rent question in the same dialog, so the office is never shown two.
    /// </remarks>
    private bool _askingBasis;
    private NpmMonthBasis _basisChoice = NpmMonthBasis.RentGoal;

    /// <summary>
    /// Records the office's rule. Nothing already collected is re-priced; what changes is what the next month is measured by.
    /// </summary>
    private async Task ConfirmBasisAsync()
    {
        if (_saving) return;
        _saving = true;
        _error = null;

        try
        {
            var result = await FacilitiesApi.SetNpmMonthBasisAsync(_basisChoice);
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "That could not be saved. Set it in Settings → Facilities & Rates.";
                return;
            }

            _askingBasis = false;

            // A monthly rent still has to be confirmed where the office says its month IS one and has not stated a figure.
            // On the days basis there is nothing further to ask, so the dialog closes.
            _show = _basisChoice == NpmMonthBasis.RentGoal && _inUse > 0m;
        }
        catch
        {
            _error = "That could not be saved. Set it in Settings → Facilities & Rates.";
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Escape closes it, as a dialog must for anyone working from the keyboard.</summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!_saving && e.Key is "Escape" or "Esc") Later();
    }

    /// <summary>Moves focus into the dialog once, so the keyboard lands inside what covers the page.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_show || _focused) return;
        _focused = true;
        try { await _dialog.FocusAsync(); } catch { /* focus is a courtesy, never a failure */ }
    }

    private static int DaysInMonthConvention => EEMOCantilanSDS.Domain.Constants.DomainRules.DailyBilledMonthDays;

    private static readonly string[] SuppressedRoutes =
    {
        "/login", "/logout", "/security-setup", "/activate", "/reset-password", "/verify-email", "/onboarding",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (IsSuppressedRoute()) return;

            var auth = await AuthState.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true) return;
            // Only a Head may set a rate, so only a Head is asked to confirm one.
            if (!auth.User.IsInRole("SuperAdmin")) return;

            // A tenant with no market has no market rent to confirm.
            await FacilityCatalog.EnsureLoadedAsync();
            if (!FacilityCatalog.All.Contains(FacilityCode.NPM)) return;

            var rates = await StallsApi.GetNpmRatesAsync();
            if (!rates.IsSuccess || rates.Value is null) return;

            // The API decides whether this LGU should be asked at all — the reference tenant never is.
            if (!rates.Value.NeedsMonthRuleConfirmation && !rates.Value.NeedsMonthlyRentConfirmation) return;

            _daily = rates.Value.DailyRate;
            _inUse = rates.Value.MonthlyRentInUse;

            // The rule first: it decides whether a monthly amount is even a thing this office has.
            _askingBasis = rates.Value.NeedsMonthRuleConfirmation;
            _basisChoice = rates.Value.MonthBasis;

            _show = _askingBasis ? _daily > 0m : _inUse > 0m;
        }
        catch
        {
            // Fails quiet by design: a setup question must never break a page.
            _show = false;
        }
    }

    private bool IsSuppressedRoute()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        return SuppressedRoutes.Any(r => path.StartsWith(r, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Closes it for this visit. Nothing is recorded, so the office is asked again until it answers.</summary>
    private void Later() => _show = false;

    private void OpenRates()
    {
        _show = false;
        Navigation.NavigateTo("/settings/facilities");
    }

    /// <summary>
    /// Confirms the figure already in force as this LGU's own stated rent, through the ordinary rate path — so the
    /// office can answer without retyping a number it has just been shown, and nothing about its money changes.
    /// </summary>
    private async Task ConfirmInUseAsync()
    {
        if (_saving || _inUse <= 0m) return;
        _saving = true;
        _error = null;

        try
        {
            var result = await FacilitiesApi.SetFacilityRateAsync(FacilityCode.NPM, FeeRateKey.NpmMonthlyStall, _inUse);
            if (result.IsSuccess)
                _show = false;
            else
                _error = result.Error ?? "That could not be saved. Set the monthly rent in Settings → Facilities & Rates.";
        }
        catch
        {
            _error = "That could not be saved. Set the monthly rent in Settings → Facilities & Rates.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string Money(decimal value) => "₱" + value.ToString("N0");
}
