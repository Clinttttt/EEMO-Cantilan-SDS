@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject IOfficialReportsApiClient Api

@* Head-only correction of one official Monthly Income cell. It records an audited report adjustment: the system amount stays
   exactly as collected, and no Collection, SRC or remittance is touched. *@
<AddNewDrawer Show="Show" Edit="true" Title="Adjust official amount" Subtitle="@($"{RowLabel} · {PeriodLabel}")"
              FormId="@_formId" FormLabel="Adjust official amount" SubmitText="Save adjustment" Saving="_saving" Error="@_error"
              OnSubmit="SaveAsync" OnCancel="CloseAsync">
    <AddNewSection Title="Amount" Plain="true">
        <dl class="rad-figures">
            <div><dt>System amount</dt><dd>@Money(Cell.SystemAmount)</dd></div>
            <div><dt>Difference</dt><dd class="@(Difference == 0m ? "" : "rad-diff")">@SignedMoney(Difference)</dd></div>
        </dl>
        <div class="avm-group">
            <label class="avm-label" for="@($"{_formId}-official")">Official amount (₱) <span class="avm-req">*</span></label>
            <input id="@($"{_formId}-official")" class="avm-input" type="number" min="0" step="0.01" required @bind="_official" @bind:event="oninput" />
        </div>
    </AddNewSection>
    <AddNewSection Title="Reason" Plain="true">
        <div class="avm-group">
            <label class="avm-label" for="@($"{_formId}-reason")">Reason <span class="avm-req">*</span></label>
            <input id="@($"{_formId}-reason")" class="avm-input" maxlength="500" required @bind="_reason" @bind:event="oninput" />
        </div>
        <div class="avm-group">
            <label class="avm-label" for="@($"{_formId}-ref")">Reference (optional)</label>
            <input id="@($"{_formId}-ref")" class="avm-input" maxlength="100" @bind="_reference" />
        </div>
    </AddNewSection>
    @if (Cell.Adjustment is not null)
    {
        <AddNewSection Title="History" Plain="true">
            @if (_history is null)
            {
                <button type="button" class="v3-btn v3-btn-sm" @onclick="LoadHistoryAsync" disabled="@_historyLoading">Show adjustment history</button>
                @if (_historyFailed) { <span class="avm-hint">The history could not be loaded.</span> }
            }
            else
            {
                <ul class="rad-history" aria-label="Adjustment history">
                    @foreach (var rev in _history)
                    {
                        <li>
                            <strong>@Money(rev.SystemAmountAtRevision ?? 0m) → @Money((rev.SystemAmountAtRevision ?? 0m) + rev.Amount)</strong>
                            <span>@rev.SourceOrReason@(string.IsNullOrWhiteSpace(rev.Reference) ? "" : $" · {rev.Reference}")</span>
                            <span class="rad-meta">@rev.ActorName · @rev.RecordedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture)</span>
                        </li>
                    }
                </ul>
            }
        </AddNewSection>
    }
</AddNewDrawer>

@code {
    private readonly string _formId = $"rad-{Guid.NewGuid():N}";

    [Parameter] public bool Show { get; set; }
    [Parameter, EditorRequired] public int Year { get; set; }
    [Parameter, EditorRequired] public int Month { get; set; }
    [Parameter, EditorRequired] public string RowKey { get; set; } = string.Empty;
    [Parameter] public string RowLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public MonthlyIncomeCellDto Cell { get; set; } = new(0m, 0m);
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal? _official;
    private string _reason = string.Empty;
    private string _reference = string.Empty;
    private string? _error;
    private bool _saving, _wasShown, _historyLoading, _historyFailed;
    private Guid _operationId = Guid.NewGuid();
    private List<ReportRevisionDto>? _history;

    private string PeriodLabel => $"{CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(Month)} {Year}";
    private decimal Difference => (_official ?? Cell.SystemAmount) - Cell.SystemAmount;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _official = Cell.OfficialAmount;
            _reason = string.Empty;
            _reference = string.Empty;
            _error = null;
            _history = null;
            _historyFailed = false;
            _operationId = Guid.NewGuid();
        }
        _wasShown = Show;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (_official is null || string.IsNullOrWhiteSpace(_reason)) { _error = "Enter the official amount and the reason."; return; }
        _saving = true;
        _error = null;
        try
        {
            var result = await Api.AdjustMonthlyIncomeAsync(new SetMonthlyIncomeAdjustmentRequest(_operationId, RowKey, Year, Month,
                Cell.SystemAmount, _official.Value, _reason.Trim(), string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim(),
                Cell.Adjustment?.Id));
            if (!result.IsSuccess) { _error = ReportGovernanceMessages.For(result.Error); return; }
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch { _error = ReportGovernanceMessages.For(null); }
        finally { _saving = false; }
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        _historyFailed = false;
        try
        {
            var result = await Api.GetGovernanceAsync(Year);
            if (result.IsSuccess)
                _history = result.Value!.Where(r => r.Kind == OfficialReportRevisionKind.MonthlyAdjustment && r.RowKey == RowKey && r.Month == Month)
                    .OrderByDescending(r => r.Revision).ToList();
            else _historyFailed = true;
        }
        catch { _historyFailed = true; }
        finally { _historyLoading = false; }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";
    private static string SignedMoney(decimal amount) => amount == 0m ? "—" : (amount > 0m ? "+" : "−") + Money(Math.Abs(amount));
}
