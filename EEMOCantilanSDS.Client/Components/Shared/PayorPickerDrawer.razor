@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Enums
@inject IEcfCollectionsApiClient PayorsApi
@inject IBusinessPayorsApiClient BusinessPayors

@* Choosing the Account holder of one import row. The occupant's name only pre-fills the search box; nothing is searched, matched, linked or
   created until the office presses Search, selects a result and presses Use Payor, or presses Create. A name match is only a candidate. *@
<SideDrawer Show="true" Wide="false" Title="Account holder" Subtitle="@Occupant" OnClose="OnClose">
    <ChildContent>
        <div class="ppd-body">
            <form class="ppd-search" aria-label="Find an account holder" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <label class="v3-field">
                    <span class="v3-sr-only">Search Account holders</span>
                    <input type="search" maxlength="100" placeholder="Search by name" @bind="_search" @bind:event="oninput" />
                </label>
                <button class="v3-btn" type="submit" disabled="@_busy">Search</button>
            </form>

            @if (_busy && _candidates is null)
            {
                <p class="ppd-muted" role="status">Searching…</p>
            }
            else if (_candidates is { Count: > 0 })
            {
                <ul class="ppd-results" aria-label="Account holders found" role="listbox">
                    @foreach (var candidate in _candidates)
                    {
                        var selected = _selected?.PayorId == candidate.PayorId;
                        <li>
                            <button class="ppd-option @(selected ? "is-selected" : "")" type="button" role="option" aria-selected="@(selected ? "true" : "false")" @onclick="() => _selected = candidate">
                                <span class="ppd-check" aria-hidden="true">@(selected ? "✓" : "")</span>
                                <span class="ppd-option-text">
                                    <strong>@candidate.DisplayName</strong>
                                    @if (candidate.Contexts is { Count: > 0 }) { <span class="ppd-muted">@string.Join(" · ", candidate.Contexts)</span> }
                                    @if (string.Equals(candidate.DisplayName, Occupant.Trim(), StringComparison.OrdinalIgnoreCase)) { <span class="ppd-muted">Same name as the occupant</span> }
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (_searched)
            {
                <p class="ppd-muted" role="status">No Account holder found.</p>
            }

            <details class="ppd-create" open="@_duplicate">
                <summary>Create a new account holder</summary>
                <div class="ppd-create-body">
                    <label class="v3-field"><span>Name</span><input maxlength="200" @bind="_name" @bind:event="oninput" /></label>
                    @if (_duplicate)
                    {
                        <label class="ppd-confirm">
                            <input type="checkbox" @bind="_confirmDuplicate" />
                            An account holder with this name already exists. This is a different person.
                        </label>
                    }
                    <button class="v3-btn" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || (_duplicate && !_confirmDuplicate))" @onclick="CreateAsync">Create and use</button>
                </div>
            </details>

            @if (_error is not null)
            {
                <p class="v3-notice v3-notice-error" role="alert">@_error</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="v3-btn" type="button" @onclick="OnClose">Cancel</button>
        <button class="v3-btn v3-btn-primary" type="button" disabled="@(_busy || _selected is null)" @onclick="UseSelectedAsync">Use Payor</button>
    </Footer>
</SideDrawer>

@code {
    /// <summary>The occupant the row names; it only pre-fills the search.</summary>
    [Parameter] public string Occupant { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Name)> OnPicked { get; set; }

    private string _search = string.Empty, _name = string.Empty;
    private bool _busy, _searched, _duplicate, _confirmDuplicate;
    private string? _error;
    private IReadOnlyList<CollectionPayorDto>? _candidates;
    private CollectionPayorDto? _selected;

    protected override void OnInitialized() { _search = Occupant; _name = Occupant; }

    private async Task SearchAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await PayorsApi.SearchCollectionPayorsAsync(_search.Trim());
            _candidates = result.IsSuccess ? result.Value ?? [] : [];
            _searched = true;
            if (!result.IsSuccess) _error = "The search could not be completed.";
        }
        catch { _error = "The search could not be completed."; }
        finally { _busy = false; }
    }

    private Task UseSelectedAsync() => _selected is { } chosen ? OnPicked.InvokeAsync((chosen.PayorId, chosen.DisplayName)) : Task.CompletedTask;

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await BusinessPayors.CreatePayorAsync(new CreatePayorRequest(_name.Trim(), BusinessPayorKind.Person, _duplicate && _confirmDuplicate));
            if (result.IsSuccess && result.Value is { } created) { await OnPicked.InvokeAsync((created.PayorId, created.DisplayName)); return; }
            if (result.Error?.StartsWith("DUPLICATE_PAYOR", StringComparison.Ordinal) == true)
            {
                _duplicate = true;
                _search = _name;
                _error = "An account holder with this name already exists. Choose it above, or confirm this is a different person.";
                _busy = false;
                await SearchAsync();
            }
            else _error = result.Error ?? "The Account holder could not be created.";
        }
        catch { _error = "The Account holder could not be created."; }
        finally { _busy = false; }
    }
}
