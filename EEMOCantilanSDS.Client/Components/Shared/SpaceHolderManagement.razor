@using EEMOCantilanSDS.Client.Services

<PageTitle>StallTrack — @Source.Name — Manage Space Holders</PageTitle>
<OperationTopbar Title="Manage Space Holders" Crumb="Manage Space Holders" ParentHref="@Source.Route" ParentTitle="@Source.Name" />
<div class="content-area">
    <ObligationWorkspace Kind="Source.Kind" Name="@Source.Name" SubjectNoun="Space" SpaceExperience="true" Management="true"
                         Workspace="@(Source.Kind == EEMOCantilanSDS.Domain.Enums.ObligationKind.KanmanggaySpaceRental ? RentalWorkspaceCatalog.Kanmanggay : null)"
                         Presentation="Source" AccountId="AccountId" ServerAssignedNumber="true" ReportsHref="@Source.ReportsHref" ImportHref="@Source.ImportHref" />
</div>

@code {
    [Parameter, EditorRequired] public SpaceAccountPresentation Source { get; set; } = null!;
    [Parameter] public Guid? AccountId { get; set; }
}
