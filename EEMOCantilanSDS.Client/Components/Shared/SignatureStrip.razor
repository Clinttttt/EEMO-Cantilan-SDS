@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Common
@using Microsoft.AspNetCore.Components.Authorization
@inject BrandingState Branding
@inject ISettingsApiClient SettingsApi
@inject AuthenticationStateProvider AuthState

@*
    The signature strip at the foot of an official sheet — the same one on every document, so a change made on
    one sheet is the footer the whole office prints.

    Each line can be renamed (its caption and the name beneath it) or removed, and a line can be added, through
    the pencil beside it. The lines are stored per LGU, so another municipality keeps its own; an LGU that never
    touches this prints exactly the trio it prints today.

    Everything editable is `no-print`: on paper only the rule, the caption and the name appear.
*@

<div class="sig-strip">
    @foreach (var slot in Slots)
    {
        var index = Slots.IndexOf(slot);
        <div class="sig-slot">
            <span class="sig-caption">
                @slot.Caption
                @if (_isHead)
                {
                    <button type="button" class="sig-edit no-print" title="Edit or remove this signatory"
                            aria-label="Edit or remove @slot.Caption" @onclick="() => Open(index)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                        </svg>
                    </button>
                }
            </span>
            <strong class="sig-name">@slot.Name</strong>
        </div>
    }

    @if (ShowDatePrepared)
    {
        @* Not a signatory: the date the sheet was produced, so it is stated but never editable. *@
        <div class="sig-slot">
            <span class="sig-caption">Date Prepared</span>
            <strong class="sig-name">@PhilippineTime.Now.ToString("MMM d, yyyy")</strong>
        </div>
    }

    @if (_isHead && Slots.Count < MaxSlots)
    {
        <div class="sig-slot sig-slot-add no-print">
            <button type="button" class="sig-add" @onclick="OpenNew">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Add signatory
            </button>
        </div>
    }
</div>

@if (_editing is not null)
{
    <div class="sig-dialog-backdrop no-print" @onclick="Close"></div>
    <div class="sig-dialog no-print" role="dialog" aria-label="Signatory">
        <div class="sig-dialog-title">@(_editing == Slots.Count ? "Add signatory" : "Signatory")</div>

        <label class="sig-field">
            <span>Caption</span>
            <input type="text" value="@_caption" @oninput="e => _caption = e.Value?.ToString() ?? string.Empty"
                   placeholder="e.g. Prepared by" maxlength="60" />
        </label>

        <label class="sig-field">
            <span>Name or position</span>
            <input type="text" value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                   placeholder="e.g. Administrative Staff" maxlength="60" />
        </label>

        @if (_error is not null)
        {
            <div class="sig-dialog-error">@_error</div>
        }

        <div class="sig-dialog-actions">
            @if (_editing < Slots.Count)
            {
                <button type="button" class="sig-remove" @onclick="Remove" disabled="@_busy">Remove</button>
            }
            <span class="sig-dialog-spacer"></span>
            <button type="button" class="sig-cancel" @onclick="Close" disabled="@_busy">Cancel</button>
            <button type="button" class="sig-save" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
        </div>

        @if (_isHead)
        {
            <button type="button" class="sig-reset" @onclick="ResetToDefault" disabled="@_busy">
                Restore the office's default signatories
            </button>
        }
    </div>
}

@code {
    /// <summary>Adds the sheet's "Date Prepared" line after the signatories (not itself a signatory).</summary>
    [Parameter] public bool ShowDatePrepared { get; set; }

    /// <summary>A signature strip is a row on paper; more than six lines cannot be read across a sheet.</summary>
    private const int MaxSlots = 6;

    private List<BrandingState.Signatory> Slots => _slots ??= Branding.Signatories.ToList();
    private List<BrandingState.Signatory>? _slots;

    private bool _isHead;
    private bool _busy;
    private int? _editing;                 // index being edited; == Slots.Count when adding
    private string _caption = string.Empty;
    private string _name = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Branding.EnsureLoadedAsync();

        // Only the Head may change what the office prints — the endpoint is SuperAdmin-only, so offering the
        // control to anyone else would only ever end in a refusal.
        var state = await AuthState.GetAuthenticationStateAsync();
        _isHead = state.User.IsInRole("SuperAdmin")
            || state.User.Claims.Any(c =>
                string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
                && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));
    }

    private void Open(int index)
    {
        _editing = index;
        _caption = Slots[index].Caption;
        _name = Slots[index].Name;
        _error = null;
    }

    private void OpenNew()
    {
        _editing = Slots.Count;
        _caption = string.Empty;
        _name = string.Empty;
        _error = null;
    }

    private void Close()
    {
        _editing = null;
        _error = null;
    }

    private async Task Save()
    {
        if (_editing is not { } index) return;

        if (string.IsNullOrWhiteSpace(_caption) && string.IsNullOrWhiteSpace(_name))
        {
            _error = "Give the line a caption, a name, or both — otherwise remove it.";
            return;
        }

        var next = Slots.ToList();
        var entry = new BrandingState.Signatory(_caption.Trim(), _name.Trim());
        if (index < next.Count) next[index] = entry; else next.Add(entry);

        await Commit(next);
    }

    private async Task Remove()
    {
        if (_editing is not { } index || index >= Slots.Count) return;

        var next = Slots.ToList();
        next.RemoveAt(index);
        await Commit(next);
    }

    /// <summary>Clears the LGU's own lines so the sheets go back to the office's standard trio.</summary>
    private async Task ResetToDefault() => await Commit(new List<BrandingState.Signatory>());

    private async Task Commit(List<BrandingState.Signatory> next)
    {
        _busy = true;
        _error = null;

        var error = await Branding.SaveSignatoriesAsync(SettingsApi, next);

        _busy = false;
        if (error is not null)
        {
            _error = error;
            return;
        }

        // Re-read through the state so an empty list falls back to the default trio rather than showing nothing.
        _slots = Branding.Signatories.ToList();
        _editing = null;
    }
}
