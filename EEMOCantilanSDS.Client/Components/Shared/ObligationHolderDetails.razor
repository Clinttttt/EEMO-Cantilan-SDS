@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Payments
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Domain.Common
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Enums
@inject IObligationsApiClient ObligationsApi

@* A space or lot account's details in the stall-holder drawer: occupant and contract evidence, the approved billing amount apart from the contract's own
   figure, and the months' payment position (the same read-only calendar the stall drawer carries). Source-owned: every value is the account register's or the
   period register's; nothing is repriced or computed here. *@
<RentalDetailsDrawer Title="@SpaceAccountPresentation.Occupant(Account)" Context="Header" StatusText="@RentalAccountStatus.Label(Account)"
                     StatusClass="@(RentalAccountStatus.IsOpen(Account) ? "pill-active" : "pill-inactive")" Summary="SummaryItems" Sections="SectionRows" Fees="FeeRows"
                     NoFeesText="@NoFees" HistoryLabel="History" EditLabel="Edit Occupant & Space"
                     OnClose="OnClose" OnHistory="OnHistory" OnEdit="@(CanEditNow ? OnEdit : default)">
    @if (IsLot)
    {
        <section class="dv-section" aria-label="Event settlement">
            <h3 class="dv-section-title">Event settlement</h3>
            <dl class="dv-kv">
                <div class="dv-kv-row"><dt class="dv-kv-key">Assessed</dt><dd class="dv-kv-val">@Money(Account.AssessedToDate)</dd></div>
                <div class="dv-kv-row"><dt class="dv-kv-key">Collected</dt><dd class="dv-kv-val">@Money(Account.CollectedToDate)</dd></div>
                <div class="dv-kv-row"><dt class="dv-kv-key">Balance</dt><dd class="dv-kv-val">@Money(Account.OutstandingToDate)</dd></div>
            </dl>
        </section>
    }
    else if (_loaded)
    {
        <MonthlyPaymentCalendar StallId="Account.Id" ContractDate="@Start" MonthlyRate="@(Account.CurrentAmount ?? 0m)" PaymentHistory="_months" ReadOnly="true" />
    }
    else if (_failed)
    {
        <p class="dv-none" role="alert">The payment months could not be loaded. Payment History still shows what was collected.</p>
    }
</RentalDetailsDrawer>

@code {
    [Parameter, EditorRequired] public ObligationAccountDto Account { get; set; } = null!;
    [Parameter] public string Operation { get; set; } = "Space Rental";
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnHistory { get; set; }

    private List<PaymentHistoryDto> _months = [];
    private bool _loaded, _failed;

    private bool IsLot => Account.Kind == ObligationKind.FiestaArawLotRental;
    private bool CanEditNow => CanEdit && RentalAccountStatus.IsOpen(Account) && !IsLot;
    private DateTime? Start => (Account.ContractEffectiveDate ?? Account.ActiveFrom).ToDateTime(TimeOnly.MinValue);
    private string NoFees => IsLot ? "No additional fees for this lot." : "No additional fees for this space.";

    protected override async Task OnInitializedAsync()
    {
        if (IsLot) return;
        try
        {
            var register = await ObligationsApi.GetRegisterAsync(Account.Id);
            if (register.IsSuccess)
            {
                _months = SpacePaymentMonths.From((register.Value ?? []).Where(p => p.AccountId == Account.Id));
                _loaded = true;
            }
            else _failed = true;
        }
        catch { _failed = true; }
    }

    private IReadOnlyList<string> Header => new[] { $"{(IsLot ? "Lot" : "Space")} {Account.SubjectLabel}", Operation }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();

    private IReadOnlyList<RentalDetailsDrawer.SummaryItem> SummaryItems
    {
        get
        {
            var items = new List<RentalDetailsDrawer.SummaryItem>
            {
                new(IsLot ? "Event amount" : "Monthly rental", Account.CurrentAmount is { } amount ? $"₱{amount.ToString("N0", CultureInfo.InvariantCulture)}" : "—", Account.CurrentAmount is null)
            };
            if (IsLot)
            {
                items.Add(new("Event date", Account.EventDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not recorded", Account.EventDate is null));
                items.Add(Settlement);
            }
            else
            {
                items.Add(new("Contract date", Account.ContractEffectiveDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "No contract", Account.ContractEffectiveDate is null));
                items.Add(Settlement);
                if (Account.AreaSqm is > 0) items.Add(new("Area", $"{Account.AreaSqm:0.##} sq.m"));
            }
            return items;
        }
    }

    // The current month for a monthly account, the whole event for a lot: whether it is settled, part-settled or open.
    private RentalDetailsDrawer.SummaryItem Settlement
    {
        get
        {
            if (IsLot) return Pill("Settlement", Account.OutstandingToDate <= 0m && Account.AssessedToDate > 0m, Account.CollectedToDate > 0m);
            var label = PhilippineTime.Today.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
            if (!_loaded) return new(label, "—", true);
            var current = _months.FirstOrDefault(m => m.Period == PhilippineTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture));
            return current is null ? new(label, "Not assessed", true) : Pill(label, current.Status == PaymentStatus.Paid, current.Status == PaymentStatus.Partial);
        }
    }

    private static RentalDetailsDrawer.SummaryItem Pill(string label, bool paid, bool partial) =>
        new(label, null, PillText: paid ? "Paid" : partial ? "Partial" : "Unpaid", PillClass: paid ? "pill-paid" : partial ? "pill-partial" : "pill-unpaid");

    private IReadOnlyList<RentalDetailsDrawer.Section> SectionRows
    {
        get
        {
            var rows = new List<RentalDetailsDrawer.Row> { new(IsLot ? "Lot holder" : "Actual occupant", SpaceAccountPresentation.Occupant(Account)) };
            if (IsLot)
            {
                rows.Add(new("Event", Account.Event?.ToString() ?? "Not recorded", Account.Event is null));
                rows.Add(new("Event date", Account.EventDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not recorded", Account.EventDate is null));
                rows.Add(new("Lot no.", Account.SubjectLabel));
                rows.Add(new("Active from", Account.ActiveFrom.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)));
                if (Account.ActiveTo is { } closed) rows.Add(new(RentalAccountStatus.IsOpen(Account) ? "Ends on" : "Closed on", closed.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)));
                return [new("Lot holder & event", rows)];
            }
            rows.Add(new("Basis of occupancy", SpaceAccountPresentation.Basis(Account)));
            rows.Add(new("Name on contract", Account.ContractName ?? "No contract", string.IsNullOrWhiteSpace(Account.ContractName)));
            if (!string.IsNullOrWhiteSpace(Account.ContractReference)) rows.Add(new("Contract reference", Account.ContractReference));
            rows.Add(new("Facility", Operation));
            rows.Add(new("Space no.", Account.SubjectLabel));
            if (Account.ContractEffectiveDate is { } start && Account.ContractYears is { } years && years > 0)
            {
                var expiry = DomainRules.TermLastDay(start, years);
                rows.Add(new("Contract duration", $"{years} year{(years > 1 ? "s" : "")}", Note: $"(expires {expiry.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)})", NoteExpired: expiry < PhilippineTime.Today));
            }
            else rows.Add(new("Contract duration", "No contract", true));
            rows.Add(new("Active from", Account.ActiveFrom.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)));
            if (Account.ActiveTo is { } ended) rows.Add(new(RentalAccountStatus.IsOpen(Account) ? "Ends on" : "Closed on", ended.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)));
            if (!string.IsNullOrWhiteSpace(Account.AreaLocation)) rows.Add(new("Area note", Account.AreaLocation));
            return [new("Occupant & contract", rows)];
        }
    }

    private IReadOnlyList<RentalDetailsDrawer.Fee> FeeRows
    {
        get
        {
            var fees = new List<RentalDetailsDrawer.Fee>();
            if (Account.CurrentAmount is { } amount)
                fees.Add(IsLot
                    ? new("Approved event amount", "Lot rental · One-time for the event", $"₱{amount.ToString("N0", CultureInfo.InvariantCulture)}")
                    : new("Approved monthly rental", $"{Operation} · Billed monthly", $"₱{amount.ToString("N0", CultureInfo.InvariantCulture)}", "/mo"));
            if (!IsLot && Account.ContractMonthlyRate is { } stated)
                fees.Add(new("Rental per contract", "Evidence only · Not billed", $"₱{stated.ToString("N0", CultureInfo.InvariantCulture)}", "/mo"));
            return fees;
        }
    }

    private static string Money(decimal? value) => value is { } money ? $"₱{money.ToString("N2", CultureInfo.InvariantCulture)}" : "—";
}
