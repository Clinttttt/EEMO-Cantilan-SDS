@* The official Monthly Income row of a report sheet, shown as unavailable ("—") because StallTrack does not yet hold
   approved annual targets or classified monthly income. It never prints a typed-in or estimated figure. *@
<section class="v3-report-section" aria-labelledby="@HeadingId">
    <h3 id="@HeadingId">Monthly income — fiscal year @Year</h3>
    <div class="v3-table-wrap">
        <table class="v3-report-table">
            <thead>
                <tr>
                    <th scope="col">Classification</th>
                    <th scope="col" class="v3-num">Annual target</th>
                    @foreach (var month in Months)
                    {
                        <th scope="col" class="v3-num">@month</th>
                    }
                    <th scope="col" class="v3-num">Total</th>
                    <th scope="col" class="v3-num">%</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@Classification</th>
                    @for (var i = 0; i < Months.Length + 3; i++)
                    {
                        <td class="v3-num">—</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
    <p class="v3-report-note">— means no figure is available in StallTrack; it is not zero. The approved annual target and classified monthly income are not yet provided to this report.</p>
</section>

@code {
    private static readonly string[] Months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    [Parameter, EditorRequired] public string Classification { get; set; } = string.Empty;

    [Parameter, EditorRequired] public int Year { get; set; }

    /// <summary>Id of the section heading, so the page (and its tests) can address this section.</summary>
    [Parameter, EditorRequired] public string HeadingId { get; set; } = string.Empty;
}
