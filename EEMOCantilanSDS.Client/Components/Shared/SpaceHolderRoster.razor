@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Client.Exports
@inject IObligationsApiClient ObligationsApi
@inject IJSRuntime JS

<PageTitle>StallTrack — @Source.Name — Space Holder List</PageTitle>
<div class="no-print">
    <OperationTopbar Title="Space Holder List" Crumb="Space Holder List" ParentHref="@Source.Route" ParentTitle="@Source.Name" />
</div>
<div class="content-area space-roster">
    <div class="v3-toolbar no-print" aria-label="Roster controls">
        <label><span class="v3-sr-only">Search occupant or space number</span><input class="v3-input" type="search" placeholder="Search occupant or space no…" @bind="_search" @bind:event="oninput" /></label>
        <label class="v3-period"><span>Occupancy</span><select class="v3-select" aria-label="Account lifecycle" @bind="_lifecycle"><option>Active</option><option>Closed</option><option>All</option></select></label>
        <div class="v3-btn-group" role="group" aria-label="Document actions">
            <button class="v3-btn" type="button" disabled="@(!Ready)" @onclick="PrintAsync">Print</button>
            <button class="v3-btn" type="button" disabled="@(!Ready)" @onclick="DownloadExcelAsync">Excel</button>
            @if (Ready) { <a class="v3-btn" href="@CsvHref" download="@(FileName + ".csv")">CSV</a> }
            <button class="v3-btn" type="button" disabled="@(!Ready)" @onclick="PrintAsync" title="Choose Save as PDF in the print dialog">Save as PDF</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="v3-notice v3-notice-error no-print" role="alert">@_error <button type="button" class="v3-btn v3-btn-sm" @onclick="LoadAsync">Try again</button></div>
    }
    <article class="v3-report-sheet print-report-sheet space-roster-sheet" aria-label="Official space holder roster" aria-busy="@(_loading ? "true" : "false")">
        <ReportLetterhead Title="SPACE HOLDER LIST" Period="@Source.Name.ToUpperInvariant()">
            <Facts>
                <div><dt>Current records as of</dt><dd>@(_asOf?.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) ?? "Unavailable")</dd></div>
                <div><dt>Occupancy scope</dt><dd>@_lifecycle</dd></div>
                <div><dt>Records</dt><dd>@(Ready ? Rows.Count.ToString(CultureInfo.InvariantCulture) : "—")</dd></div>
            </Facts>
        </ReportLetterhead>
        @if (!string.IsNullOrWhiteSpace(_search)) { <p class="v3-report-note">Search: @_search</p> }
        <div class="space-roster-table-wrap">
            <table class="v3-report-table space-roster-table">
                <colgroup><col class="roster-number" /><col class="roster-occupant" /><col class="roster-space" /><col class="roster-basis" /><col class="roster-reference" /><col class="roster-date" /><col class="roster-amount" /><col class="roster-status" /></colgroup>
                <thead><tr><th scope="col">#</th><th scope="col">Actual occupant</th><th scope="col">Space No.</th><th scope="col">Occupancy basis</th><th scope="col">Contract reference</th><th scope="col">Effectivity</th><th scope="col" class="v3-num">Approved monthly rental</th><th scope="col">Status</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Rows.Count; i++)
                    {
                        var account = Rows[i];
                        <tr><td>@(i + 1)</td><td>@SpaceAccountPresentation.Occupant(account)</td><td>@account.SubjectLabel</td><td>@SpaceAccountPresentation.Basis(account)</td><td>@(SpaceAccountPresentation.Reference(account) is { Length: > 0 } reference ? reference : "—")</td><td>@((account.ContractEffectiveDate ?? account.ActiveFrom).ToString("MMM d, yyyy", CultureInfo.InvariantCulture))</td><td class="v3-num">@(account.CurrentAmount is { } amount ? "₱" + amount.ToString("N2", CultureInfo.InvariantCulture) : "—")</td><td>@(account.ActiveTo is null ? "Active" : $"Closed {account.ActiveTo:MMM d, yyyy}")</td></tr>
                    }
                    @if (Rows.Count == 0)
                    {
                        <tr><td colspan="8" class="v3-empty">@(_loading ? "Loading roster…" : _error is not null ? "The roster is unavailable." : _accounts.Count == 0 ? "No space holders registered." : !string.IsNullOrWhiteSpace(_search) ? "No records match this search." : _lifecycle == "Closed" ? "No closed accounts recorded." : "No active registrations.")
                            @if (_loading) { <Skeleton Height="24px" /><span class="v3-sr-only" role="status">Loading the space holder roster</span> }
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="v3-report-note">Effectivity shows the recorded signed-contract date when available, otherwise the source occupancy start. Space-only occupancy does not imply a signed contract. Approved amounts are the account register's current amounts. Closed accounts retain their history; an unavailable amount is shown as —. This is a current register, not a reconstructed historical roster.</p>
    </article>
</div>

@code {
    [Parameter, EditorRequired] public SpaceAccountPresentation Source { get; set; } = null!;
    private IReadOnlyList<ObligationAccountDto> _accounts = [];
    private string _search = "", _lifecycle = "Active";
    private bool _loading = true;
    private string? _error;
    private DateOnly? _asOf;
    private bool Ready => !_loading && _error is null && _asOf is not null;
    private IReadOnlyList<ObligationAccountDto> Rows => _accounts.Where(a => a.Kind == Source.Kind
        && (_lifecycle == "All" || (_lifecycle == "Closed" ? a.ActiveTo is not null : a.ActiveTo is null))
        && (string.IsNullOrWhiteSpace(_search) || SpaceAccountPresentation.Occupant(a).Contains(_search, StringComparison.OrdinalIgnoreCase) || a.SubjectLabel.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(a => a.SubjectLabel, StringComparer.OrdinalIgnoreCase).ThenBy(a => a.ActiveFrom).ToArray();
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null; _accounts = []; _asOf = null;
        try
        {
            var result = await ObligationsApi.GetAccountsAsync(Source.Kind);
            if (result.IsSuccess && result.Value is { } accounts) { _accounts = accounts; _asOf = PhilippineTime.Today; }
            else _error = result.Error ?? "The space holder roster could not be loaded.";
        }
        catch { _error = "The space holder roster could not be loaded."; }
        finally { _loading = false; }
    }
    private async Task PrintAsync() { if (Ready) await JS.InvokeVoidAsync("stalltrackPrint.landscape"); }
    private string FileName => $"space-holders-{Source.Route.Split('/').Last()}-{_lifecycle.ToLowerInvariant()}-{_asOf:yyyy-MM-dd}";
    private static readonly IReadOnlyList<SheetColumn> Columns = [new("#", SheetValueKind.Number), new("Actual occupant", SheetValueKind.Text), new("Space No.", SheetValueKind.Text), new("Occupancy basis", SheetValueKind.Text), new("Contract reference", SheetValueKind.Text), new("Effectivity", SheetValueKind.Date), new("Approved monthly rental", SheetValueKind.Money), new("Status", SheetValueKind.Text)];
    private IReadOnlyList<IReadOnlyList<object?>> ExportRows => Rows.Select((a, i) => (IReadOnlyList<object?>)new object?[] { i + 1, SpaceAccountPresentation.Occupant(a), a.SubjectLabel, SpaceAccountPresentation.Basis(a), SpaceAccountPresentation.Reference(a), a.ContractEffectiveDate ?? a.ActiveFrom, a.CurrentAmount, a.ActiveTo is null ? "Active" : $"Closed {a.ActiveTo:MMM d, yyyy}" }).ToArray();
    private string CsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join("\r\n",
        new[] { Csv("SPACE HOLDER LIST", Source.Name), Csv("Office", Branding.OfficeName), Csv("Municipality", Branding.Municipality, Branding.Province), Csv("Current records as of", _asOf?.ToString("yyyy-MM-dd"), "Occupancy", _lifecycle), Csv("Search", _search), Csv(Columns.Select(c => c.Header).ToArray()) }
        .Concat(ExportRows.Select(row => Csv(row.Select(v => v switch { DateOnly date => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), decimal amount => amount.ToString("0.00", CultureInfo.InvariantCulture), _ => Convert.ToString(v, CultureInfo.InvariantCulture) }).ToArray())))));
    private static string Csv(params string?[] cells) => string.Join(',', cells.Select(c => CsvCell.Escape(c ?? "")));
    private async Task DownloadExcelAsync()
    {
        if (!Ready) return;
        var bytes = SpreadsheetBuilder.Build("Space Holder List", Columns, ExportRows);
        await JS.InvokeVoidAsync("downloadFileFromBytes", FileName + ".xlsx", Convert.ToBase64String(bytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
