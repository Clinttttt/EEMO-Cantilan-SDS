@using System.Globalization
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Client.Exports
@inject IObligationsApiClient ObligationsApi

@* The holder list of a space or lot operation, in the Stall Holder List's own document. Rows are the account register's current records (not a reconstructed
   historical roster); contract facts appear only where a signed contract records them, and nothing is invented for a space-only or extension occupancy. *@
<PageTitle>StallTrack — @Source.Name — @(IsLot ? "Lot" : "Space") Holder List</PageTitle>
<OfficialRegisterPage Title="@($"{Source.Name} {(IsLot ? "Lot" : "Space")} Holder List")" OperationName="@Source.Name" Eyebrow="@($"OPERATIONS · {Source.Name.ToUpperInvariant()}")"
                      BackHref="@Source.Route" BackName="@Source.Name" Stats="Stats"
                      SearchPlaceholder="@($"Search name or {Source.Unit.ToLowerInvariant()} no…")" @bind-SearchQuery="_search"
                      CsvFileName="@(FileName + ".csv")" CsvText="@CsvText">
    <Filters>
        <div class="lsh-seg" role="group" aria-label="Occupancy filter">
            @foreach (var choice in LifecycleChoices)
            {
                <button type="button" class="lsh-seg-item @(_lifecycle == choice ? "active" : "")" aria-pressed="@(_lifecycle == choice ? "true" : "false")" @onclick="() => _lifecycle = choice">@choice</button>
            }
        </div>
    </Filters>
    <ChildContent>
        @if (_error is not null)
        {
            <div class="lsh-state" role="alert"><span>@_error</span> <button type="button" class="lsh-btn" @onclick="LoadAsync">Try again</button></div>
        }
        else if (_loading)
        {
            <p class="lsh-state" role="status">Loading the holder list…</p>
        }
        else
        {
            <div class="lsh-section-block">
                <div class="lsh-section-label-row">
                    <span class="lsh-section-label">@Source.Name.ToUpperInvariant()</span>
                    <span class="lsh-section-count">@Rows.Count @Source.Unit.ToLowerInvariant()@(Rows.Count == 1 ? "" : "s")</span>
                </div>
                @if (IsLot)
                {
                    <div class="lsh-table-wrap"><table class="lsh-table lot-col">
                        <thead>
                            <tr>
                                <th class="col-no">#</th><th class="col-name">Name of Lessee</th><th class="col-no2">Lot No.</th>
                                <th class="col-event">Event</th><th class="col-amt">Approved <br />Amount</th><th class="col-contract">Contract</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Rows.Count; i++)
                            {
                                var a = Rows[i];
                                <tr class="@(Closed(a) ? "row-closed" : "")">
                                    <td class="c">@(i + 1)</td>
                                    <td class="tl fw @(Closed(a) ? "txt-closed" : "")">@SpaceAccountPresentation.Occupant(a)</td>
                                    <td class="c">@Dash(a.SubjectLabel)</td>
                                    <td class="c">@(a.Event is null ? "—" : a.Event.ToString())</td>
                                    <td class="r">@Money(a.CurrentAmount)</td>
                                    <td class="tl txt-muted">@ContractText(a)</td>
                                </tr>
                            }
                            @EmptyRow(6)
                        </tbody>
                        @if (Rows.Count > 0)
                        {
                            <tfoot><tr class="tfoot-row"><td colspan="4" class="tfoot-label">Total</td><td class="r tfoot-val">@Money(Rows.Sum(a => a.CurrentAmount ?? 0m))</td><td></td></tr></tfoot>
                        }
                    </table></div>
                }
                else
                {
                    <div class="lsh-table-wrap"><table class="lsh-table sp-col">
                        <thead>
                            <tr>
                                <th class="col-no">#</th>
                                <th class="col-name">Name of Lessee <br /><span class="th-sub">(Actual Occupants)</span></th>
                                <th class="col-name">Name of Lessee <br /><span class="th-sub">per Signed Contract</span></th>
                                <th class="col-space">Space <br />No.</th>
                                <th class="col-date">Effectivity of <br />Lessee Contract</th>
                                <th class="col-yrs">No. of <br />Years</th>
                                <th class="col-area">Area</th>
                                <th class="col-amt">Monthly Rentals <br />per Contract</th>
                                <th class="col-amt">Actual Mo. <br />Rentals</th>
                                <th class="col-amt">Whole Year <br />Rental *</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Rows.Count; i++)
                            {
                                var a = Rows[i];
                                var signed = a.Arrangement == OccupancyArrangement.SignedContract;
                                <tr class="@(Closed(a) ? "row-closed" : "")">
                                    <td class="c">@(i + 1)</td>
                                    <td class="tl fw @(Closed(a) ? "txt-closed" : "")">@SpaceAccountPresentation.Occupant(a)</td>
                                    @if (signed)
                                    {
                                        <td class="tl txt-muted">@Dash(a.ContractName)</td>
                                    }
                                    else
                                    {
                                        <td class="tl txt-muted">@SpaceAccountPresentation.Basis(a)</td>
                                    }
                                    <td class="c">@Dash(a.SubjectLabel)</td>
                                    <td class="c">@(signed && a.ContractEffectiveDate is { } d ? d.ToString("M/d/yyyy", CultureInfo.InvariantCulture) : "—")</td>
                                    <td class="c">@(signed && a.ContractYears is { } y ? y.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                    <td class="c">@(a.AreaSqm is > 0 ? $"{a.AreaSqm:0.##} sq.m." : "—")</td>
                                    <td class="r">@(signed ? Money(a.ContractMonthlyRate) : "—")</td>
                                    <td class="r">@Money(a.CurrentAmount)</td>
                                    <td class="r">@Money(WholeYear(a))</td>
                                </tr>
                            }
                            @EmptyRow(10)
                        </tbody>
                        @if (Rows.Count > 0)
                        {
                            <tfoot><tr class="tfoot-row"><td colspan="8" class="tfoot-label">Total</td>
                                <td class="r tfoot-val">@Money(Rows.Sum(a => a.CurrentAmount ?? 0m))</td><td class="r tfoot-val">@Money(Rows.Sum(a => WholeYear(a) ?? 0m))</td></tr></tfoot>
                        }
                    </table></div>
                    <p class="lsh-footnote">* Whole Year Rental is a projection: twelve times the approved actual monthly rental. No annual amount is recorded.</p>
                }
            </div>
        }
    </ChildContent>
</OfficialRegisterPage>

@code {
    [Parameter, EditorRequired] public SpaceAccountPresentation Source { get; set; } = null!;
    private IReadOnlyList<ObligationAccountDto> _accounts = [];
    private string _search = "", _lifecycle = "Active";
    private bool _loading = true;
    private string? _error;
    private bool IsLot => Source.Kind == ObligationKind.FiestaArawLotRental;
    private bool Ready => !_loading && _error is null;
    private static readonly IReadOnlyList<string> LifecycleChoices = ["Active", "Closed", "All"];
    private static bool Closed(ObligationAccountDto a) => !RentalAccountStatus.IsOpen(a);
    private int Count(bool active) => _accounts.Count(a => a.Kind == Source.Kind && RentalAccountStatus.IsOpen(a) == active);

    private IReadOnlyList<ObligationAccountDto> Rows => _accounts.Where(a => a.Kind == Source.Kind
        && (_lifecycle == "All" || (_lifecycle == "Closed" ? Closed(a) : !Closed(a)))
        && (string.IsNullOrWhiteSpace(_search) || SpaceAccountPresentation.Occupant(a).Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (a.ContractName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || a.SubjectLabel.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(a => a.SubjectLabel, StringComparer.OrdinalIgnoreCase).ThenBy(a => a.ActiveFrom).ToArray();

    private IReadOnlyList<OfficialRegisterPage.Stat> Stats =>
    [
        new(Ready ? _accounts.Count(a => a.Kind == Source.Kind).ToString(CultureInfo.InvariantCulture) : "—", $"Registered {Source.Unit.ToLowerInvariant()}s"),
        new(Ready ? Count(true).ToString(CultureInfo.InvariantCulture) : "—", "Active"),
        new(Ready ? Count(false).ToString(CultureInfo.InvariantCulture) : "—", "Closed")
    ];

    private RenderFragment EmptyRow(int cols) => __builder =>
    {
        if (Rows.Count == 0)
        {
            <tr><td colspan="@cols" class="c txt-muted">@(!_accounts.Any(a => a.Kind == Source.Kind) ? $"No {Source.Unit.ToLowerInvariant()} holders registered." : !string.IsNullOrWhiteSpace(_search) ? "No records match this search." : _lifecycle == "Closed" ? "No closed accounts recorded." : "No active registrations.")</td></tr>
        }
    };

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
    private static string Money(decimal? amount) => amount is { } v ? $"₱{v.ToString("N2", CultureInfo.InvariantCulture)}" : "—";
    private static decimal? WholeYear(ObligationAccountDto a) => a.CurrentAmount is { } m ? m * 12m : null;
    // Contract = the recorded reference or arrangement, only as the register states it.
    private static string ContractText(ObligationAccountDto a) =>
        !string.IsNullOrWhiteSpace(SpaceAccountPresentation.Reference(a)) ? SpaceAccountPresentation.Reference(a)
        : a.Arrangement is null ? "—" : SpaceAccountPresentation.Basis(a);

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null; _accounts = [];
        try
        {
            var result = await ObligationsApi.GetAccountsAsync(Source.Kind);
            if (result.IsSuccess && result.Value is { } accounts) _accounts = accounts;
            else _error = result.Error ?? "The holder list could not be loaded.";
        }
        catch { _error = "The holder list could not be loaded."; }
        finally { _loading = false; }
    }

    private string FileName => $"{(IsLot ? "lot" : "space")}-holders-{Source.Route.Split('/').Last()}-{_lifecycle.ToLowerInvariant()}-{PhilippineTime.Today:yyyy-MM-dd}";

    private string CsvText
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(IsLot ? "#,Name of Lessee,Lot No.,Event,Approved Amount,Contract"
                : "#,Name of Lessee (Actual Occupants),Name of Lessee per Signed Contract,Space No.,Effectivity of Lessee Contract,No. of Years,Area,Monthly Rentals per Contract,Actual Mo. Rentals,Whole Year Rental (12 x actual monthly)");
            var rows = Rows;
            for (var i = 0; i < rows.Count; i++)
            {
                var a = rows[i];
                var signed = a.Arrangement == OccupancyArrangement.SignedContract;
                var cells = IsLot
                    ? new[] { Dash(SpaceAccountPresentation.Occupant(a)), Dash(a.SubjectLabel), a.Event is null ? "—" : a.Event.ToString()!, Amount(a.CurrentAmount), ContractText(a) }
                    : new[] { Dash(SpaceAccountPresentation.Occupant(a)), signed ? Dash(a.ContractName) : SpaceAccountPresentation.Basis(a), Dash(a.SubjectLabel),
                        signed && a.ContractEffectiveDate is { } d ? d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "—", signed && a.ContractYears is { } y ? y.ToString(CultureInfo.InvariantCulture) : "—",
                        a.AreaSqm is > 0 ? a.AreaSqm.Value.ToString("0.##", CultureInfo.InvariantCulture) : "—", signed ? Amount(a.ContractMonthlyRate) : "—", Amount(a.CurrentAmount), Amount(WholeYear(a)) };
                sb.AppendLine((i + 1).ToString(CultureInfo.InvariantCulture) + "," + string.Join(',', cells.Select(CsvCell.Escape)));
            }
            return sb.ToString();
        }
    }
    private static string Amount(decimal? v) => v is { } x ? x.ToString("0.00", CultureInfo.InvariantCulture) : "—";
}
