@* The one button every bulk import uses (stallholder import, space and lot imports). A link when it has an Href, otherwise a button. *@
@if (Href is not null)
{
    <a class="imp-btn imp-btn-@Kind @Class" href="@Href" title="@Title">@ChildContent</a>
}
else
{
    <button class="imp-btn imp-btn-@Kind @Class" type="button" title="@Title" disabled="@Disabled" @onclick="OnClick">@ChildContent</button>
}

@code {
    /// <summary>primary, outline or ghost.</summary>
    [Parameter] public string Kind { get; set; } = "ghost";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
