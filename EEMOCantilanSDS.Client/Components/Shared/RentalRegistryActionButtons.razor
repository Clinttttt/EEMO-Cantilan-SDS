@* One presentation for rental-registry actions. Source-owning parents keep their own
   account IDs, authorizations, commands, confirmations and persistence handlers. *@
<div class="action-btns rental-registry-actions" role="group" aria-label="@($"Actions for {Subject}")">
    <button type="button" class="action-btn" title="View Details" aria-label="View Details" @onclick="() => OnInspect.InvokeAsync()">
        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
    </button>
    <button type="button" class="action-btn" title="View Profile" aria-label="View Profile" @onclick="() => OnProfile.InvokeAsync()">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
    </button>
    @if (ShowEdit)
    {
    <button type="button" class="action-btn" disabled="@(!CanEdit)" title="@(CanEdit ? EditTitle : EditUnavailableReason)" aria-label="@(CanEdit ? EditTitle : EditUnavailableReason)" @onclick="() => OnEdit.InvokeAsync()">
        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
    </button>
    }
    @if (ShowHistory)
    {
    <button type="button" class="action-btn" title="Payment History" aria-label="Payment History" @onclick="() => OnHistory.InvokeAsync()">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
    </button>
    }
    @if (ShowToggle)
    {
    <button type="button" class="action-btn @(IsActive ? "action-danger" : "action-success")"
            disabled="@(!CanToggle)" title="@ToggleTitle" aria-label="@ToggleTitle" @onclick="() => OnToggle.InvokeAsync()">
        @if (IsActive)
        {
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
        }
    </button>
    }
</div>

@code {
    [Parameter] public string Subject { get; set; } = "rental account";
    /// <summary>A read-only list shows only View Details and View Profile; the management registry shows all five.</summary>
    [Parameter] public bool ShowEdit { get; set; } = true;
    [Parameter] public bool ShowHistory { get; set; } = true;
    [Parameter] public bool ShowToggle { get; set; } = true;
    [Parameter] public string EditTitle { get; set; } = "Edit";
    [Parameter] public string EditUnavailableReason { get; set; } = "Editing is unavailable for this account.";
    [Parameter] public string ToggleTitle { get; set; } = "Close Stall";
    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool CanToggle { get; set; } = true;
    [Parameter] public EventCallback OnInspect { get; set; }
    [Parameter] public EventCallback OnProfile { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnHistory { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}