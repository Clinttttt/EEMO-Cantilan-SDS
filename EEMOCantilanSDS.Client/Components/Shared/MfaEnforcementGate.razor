@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Routing
@inject IMfaApiClient MfaApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@implements IDisposable

@*
    Mandatory two-factor gate for Heads (SuperAdmin).

    Renders nothing. It checks once per circuit whether the signed-in user is a Head without two-factor and,
    if so, keeps them on /security-setup until they enrol.

    Design rules:
      • Enforced only AFTER sign-in, so it can never lock anyone out — they are already authenticated.
      • FAILS OPEN: if the status check errors (network, expired token), no redirect happens. A security nag
        must never become a denial of service against a legitimate Head.
      • The status is fetched ONCE and cached, then re-applied on navigation, so blocking costs no extra API
        calls.
      • Only SuperAdmin is gated; ordinary Admins and Collectors are untouched.
*@

@code {
    private bool _mustEnrol;

    /// <summary>Routes that must stay reachable, or the user could neither enrol nor sign out.</summary>
    private static readonly string[] Allowed =
    {
        "/security-setup", "/login", "/logout", "/settings"
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (!IsHead(state.User))
                return;

            var status = await MfaApi.GetMfaStatusAsync();
            // Fail open: only gate when the API positively reports two-factor as OFF.
            if (!status.IsSuccess || status.Value is null || status.Value.Enabled)
                return;

            _mustEnrol = true;
            Redirect();
        }
        catch
        {
            // Fail open by design.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_mustEnrol) Redirect();
    }

    private void Redirect()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        if (Allowed.Any(a => path.StartsWith(a, StringComparison.OrdinalIgnoreCase)))
            return;

        Navigation.NavigateTo("/security-setup");
    }

    // The cookie principal is built from the raw JWT, so the role can land under "role", ClaimTypes.Role,
    // or a schema URI. Matches AccountChip's approach.
    private static bool IsHead(ClaimsPrincipal user) =>
        user.IsInRole("SuperAdmin")
        || user.Claims.Any(c =>
            string.Equals(c.Value, "SuperAdmin", StringComparison.OrdinalIgnoreCase)
            && c.Type.Contains("role", StringComparison.OrdinalIgnoreCase));

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
