@using EEMOCantilanSDS.Client.Services
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Domain.Enums
@inject FacilityState Facilities
@inject IObligationsApiClient Operations
@inject NavigationManager Navigation

@if (Compact)
{
    <div class="rental-compact-picker">
        <button id="rental-workspace-picker" type="button" class="rental-compact-trigger" aria-label="Select facility or operation"
                aria-expanded="@(_open ? "true" : "false")" aria-controls="rental-compact-options" @onclick="() => _open = !_open">
            <span class="rental-compact-caption"><strong>@CurrentShortCode</strong><small>@CurrentName</small></span>
            <span class="rental-compact-chevron" aria-hidden="true">⌄</span>
        </button>
        @if (_open)
        {
            <div class="rental-compact-backdrop" @onclick="() => _open = false"></div>
            <div id="rental-compact-options" class="rental-compact-options" role="group" aria-label="Facility or operation">
                @foreach (var entry in Entries)
                {
                    <button type="button" class="rental-compact-option @(entry.Code == Selected ? "selected" : "")"
                            aria-current="@(entry.Code == Selected ? "true" : "false")" @onclick="() => SelectCode(entry.Code)">
                        @entry.Name
                        @if (entry.Code == Selected) { <span aria-hidden="true">✓</span> }
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    <div class="rental-picker">
        <label for="rental-workspace-picker">Facility / Operation</label>
        <select id="rental-workspace-picker" class="avm-input" value="@Selected" @onchange="Select">
            @foreach (var entry in Entries) { <option value="@entry.Code">@entry.Code · @entry.Name</option> }
        </select>
    </div>
}
@code {
    [Parameter] public string Selected { get; set; } = "NPM";
    [Parameter] public bool Compact { get; set; }
    private bool _open;
    private List<(string Code, string Name)> _operations = [];
    private IEnumerable<(string Code, string Name)> Entries =>
        Facilities.Rental.Select(f => (f.ToString(), Facilities.NameOf(f))).Concat(_operations);
    private string CurrentName => Entries.FirstOrDefault(x => x.Code == Selected).Name ?? Selected;
    private string CurrentShortCode => Selected == "Vegetable/Fruits" ? "VF" : Selected;
    protected override async Task OnInitializedAsync()
    {
        await Facilities.EnsureLoadedAsync();
        try
        {
            var result = await Operations.GetSpaceOperationsAsync();
            foreach (var kind in (result?.Value ?? []).Select(x => x.Kind).Distinct())
            {
                if (kind == ObligationKind.KanmanggaySpaceRental) _operations.Add(("KM", "Kanmanggay"));
                if (kind == ObligationKind.FiestaArawLotRental) _operations.Add(("FA", "Fiesta / Araw"));
                if (kind == ObligationKind.VegetableFruitSpaceRental) _operations.Add(("Vegetable/Fruits", "Vegetable / Fruits Monthly"));
            }
        }
        catch { /* The selected source remains usable when discovery fails. */ }
        if (!_operations.Any(x => x.Code == Selected) && Selected is "KM" or "FA" or "Vegetable/Fruits")
            _operations.Add((Selected, Selected == "KM" ? "Kanmanggay" : Selected == "FA" ? "Fiesta / Araw" : "Vegetable / Fruits Monthly"));
    }
    private void Select(ChangeEventArgs e) => SelectCode(e.Value?.ToString());
    private void SelectCode(string? code)
    {
        _open = false;
        if (string.IsNullOrWhiteSpace(code)) return;
        if (_operations.Any(x => x.Code == code))
            Navigation.NavigateTo($"/vendors?workspace={Uri.EscapeDataString(code)}");
        else if (Enum.TryParse<FacilityCode>(code, out var facility) && Facilities.Rental.Contains(facility))
            Navigation.NavigateTo($"/vendors?facility={facility.ToString().ToLowerInvariant()}");
    }
}