@* One titled group of fields in an Add New form. Fields sit in a two-column grid on a wide drawer and one column on a narrow one;
   a field that should span the row carries the class "ans-span". *@
<section class="ans" aria-labelledby="@_titleId">
    <h3 class="ans-title" id="@_titleId">@Title</h3>
    @if (Plain)
    {
        @ChildContent
    }
    else
    {
        <div class="ans-grid">@ChildContent</div>
    }
</section>

@code {
    private readonly string _titleId = $"ans-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Content that lays itself out (choice cards, a selected-payor row) rather than as grid fields.</summary>
    [Parameter] public bool Plain { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
