@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Mobile.Models
@inject IMobileApiClient Api
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync

@if (_loading) { <LoadingState Text="Loading vendors…" /> }
else
{
    <label class="form-field"><span class="form-label">Search vendors</span><input class="form-input" placeholder="Name or stall no." @bind="_search" @bind:event="oninput" /></label>
    <div class="section-label">Vendors</div>
    @if (_vendors.Count == 0) { <div class="state-card">No Fish/Meat vendors available.</div> }
    @foreach (var vendor in _vendors.Where(x => string.IsNullOrWhiteSpace(_search) || (x.PayerName + " " + x.StallNo).Contains(_search, StringComparison.OrdinalIgnoreCase)))
    {
        <button type="button" class="vendor-row" disabled="@(!vendor.CanCollect)" @onclick="() => Open(vendor)">
            <span><strong>@vendor.PayerName</strong><small>@vendor.Section · Stall @vendor.StallNo</small>
                @if (!vendor.CanCollect) { <small>@vendor.Reason</small> }
            </span><span aria-hidden="true">›</span>
        </button>
    }
    @if (_recent.Count > 0)
    {
        <div class="section-label">Recent collections</div>
        @foreach (var capture in _recent)
        {
            <div class="vendor-row"><span><strong>@capture.Name</strong><small>@capture.Date.ToString("MMM d", CultureInfo.InvariantCulture) · @capture.Status</small></span><strong>@Money(capture.Amount)</strong></div>
        }
    }
}
@if (_message is not null) { <div class="state-card" role="status">@_message</div> }
@if (_selected is { } selected)
{
    <div class="sheet-overlay" @onclick="Close">
        <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="vendor-fee-title" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div><h2 class="sheet-title" id="vendor-fee-title">Collect vendor fee</h2>
            <p class="sheet-sub">@selected.PayerName<br />@selected.Section · Stall @selected.StallNo</p>
            <label class="form-field"><span class="form-label">Amount received</span><input class="form-input" type="number" inputmode="decimal" min="0.01" step="0.01" @bind="_amount" aria-label="Amount received" /></label>
            <div class="receipt-meta-row"><span>Instrument</span><strong>OR · Official Receipt</strong></div>
            @if (_error is not null) { <p class="form-error" role="alert">@_error</p> }
            <div class="sheet-btn-row"><button class="btn-cancel" type="button" @onclick="Close" disabled="@_saving">Cancel</button><button class="btn-confirm" type="button" @onclick="RecordAsync" disabled="@_saving">@(_saving ? "Recording…" : "Record collection")</button></div>
        </section>
    </div>
}

@code {
    [Parameter] public DateOnly BusinessDate { get; set; }
    private IReadOnlyList<DirectVendorFeeSource> _vendors = [];
    private sealed record Recent(string Name, DateOnly Date, decimal Amount, string Status);
    private IReadOnlyList<Recent> _recent = [];
    private DirectVendorFeeSource? _selected;
    private decimal _amount;
    private string _search = "";
    private string? _error, _message;
    private bool _loading = true, _saving;
    private Guid _sessionId, _itemId;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        try
        {
            var sources = await Api.GetDirectVendorFeeSourcesAsync();
            _vendors = sources.Value ?? [];
            if (!sources.IsSuccess) _message = "Vendor sources are unavailable. Refresh while online.";
            _recent = (await Sync.GetAllAsync()).Where(x => x.CollectionSession?.Intent.Items.Any(i => i.Kind == CollectionSessionItemKind.VendorFee) == true)
                .OrderByDescending(x => x.CreatedAt).Take(5).Select(x =>
                {
                    var item = x.CollectionSession!.Intent.Items.First(i => i.Kind == CollectionSessionItemKind.VendorFee);
                    var collection = x.CollectionSessionResult?.Collections.FirstOrDefault(c => c.ClientItemIds.Contains(item.ClientItemId));
                    var name = _vendors.FirstOrDefault(v => v.StallId == item.VendorFee!.StallId)?.PayerName ?? "Vendor fee";
                    return new Recent(name, x.BusinessDate, collection?.Amount ?? item.ConfirmedAmount,
                        collection?.ReferenceCode ?? (x.LocalStatus == PendingLocalStatus.ReconciliationRequired ? "Needs review" : "Waiting to sync"));
                }).ToArray();
        }
        catch { _message = "Connect to load vendor sources."; }
        finally { _loading = false; }
    }
    private void Open(DirectVendorFeeSource vendor) { _selected = vendor; _amount = 0; _error = null; _sessionId = Guid.NewGuid(); _itemId = Guid.NewGuid(); }
    private void Close() { if (!_saving) _selected = null; }
    private async Task RecordAsync()
    {
        if (_selected is not { PayorId: { } payer } vendor || _saving) return;
        if (_amount <= 0 || decimal.Round(_amount, 2) != _amount) { _error = "Enter a positive amount with at most two decimals."; return; }
        _saving = true;
        try
        {
            var intent = new CollectionSessionIntent(_sessionId, BusinessDate, payer,
                [new(_itemId, CollectionSessionItemKind.VendorFee, _amount, VendorFee: new(vendor.StallId))]);
            var reviewed = await Api.QuoteCollectionSessionAsync(intent);
            if (reviewed.Value is not { CanRecord: true } quote) { _error = reviewed.Value?.Problems.FirstOrDefault()?.Message ?? "Connection required to review."; return; }
            await Sync.EnqueueCollectionSessionAsync(new(intent, quote.QuoteFingerprint), quote.GrandTotal);
            _selected = null; _message = "Waiting to sync";
            if (Sync.IsOnline) await Sync.SyncNowAsync(force: true);
            var pending = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == _sessionId);
            var result = pending?.CollectionSessionResult;
            if (result?.Status == CollectionSessionStatus.Recorded) _message = "Recorded · " + result.Collections.Single().ReferenceCode;
            else if (pending?.LocalStatus == PendingLocalStatus.ReconciliationRequired) _message = "Needs review · Open Records.";
            await LoadAsync();
        }
        catch (IOException) { _error = "The collection could not be safely saved. Check device storage."; }
        catch { _error = "Connection required to review. Check Records before trying again."; }
        finally { _saving = false; }
    }
    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
