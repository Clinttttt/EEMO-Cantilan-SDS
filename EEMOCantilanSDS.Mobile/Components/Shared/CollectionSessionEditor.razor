    private CollectionSessionIntent Intent => new(_sessionId, BusinessDate, null, _items.ToArray(),
        SourceIdentity: _source?.Identity, PayerSnapshot: _direct && !string.IsNullOrWhiteSpace(_snapshot) ? _snapshot.Trim() : null);

    // What kind of finder this page is: a registered vendor only, an occupant only, or any source.
    private bool VendorOnly => OnlyOperation is CollectorOperationCodes.WeightAndMeasure;
    private bool BrowserMode => _source is null && !_direct && Correction is null && OnlyOperation is null;
    private bool DirectAllowed => !VendorOnly && !CollectorOperationCodes.IsSpaceObligation(OnlyOperation) && OnlyOperation is not (CollectorOperationCodes.Wcf or CollectorOperationCodes.VegetableFruitSpaceRental);
    private string SourceHeading => OnlyOperation == CollectorOperationCodes.Terminal ? "Income From Terminal" : "Source";
    private string SearchLabel => OnlyOperation == CollectorOperationCodes.VegetableFruitSpaceRental || CollectorOperationCodes.IsSpaceObligation(OnlyOperation) ? "Search registered space holder" : VendorOnly ? "Search registered vendor" : OnlyOperation == CollectorOperationCodes.FishMeatVendorFee ? "Search vendor or payer" : "Search payer or vendor";
    private IReadOnlyList<CollectionSourceSearchResult> VisibleSources => _found.Where(x => OnlyOperation switch
    {
        CollectorOperationCodes.WeightAndMeasure or CollectorOperationCodes.FishMeatVendorFee => x.Identity.Kind == SourceIdentityKind.FishMeatVendorRegistration,
        "ECF" => x.Identity.Kind == SourceIdentityKind.Occupancy,
        CollectorOperationCodes.VegetableFruitSpaceRental or CollectorOperationCodes.KanmanggaySpaceRental or CollectorOperationCodes.FiestaArawLotRental => x.Identity.Kind == SourceIdentityKind.SpaceAccount && x.OperationCode == OnlyOperation,
        _ => true
    }).ToList();
    private string SourceName => _source?.DisplayName ?? (_direct && !string.IsNullOrWhiteSpace(_snapshot) ? _snapshot.Trim() : "");

    // A source with nothing collectible says so; the collector may then start a separate direct collection.
    private bool NothingDue => _source is not null && _discovery is not null && !_discovery.Operations.Any(x => x.CanAdd && Allows(x.OperationCode));
    // A facility-only rental authority cannot become a direct collection when no canonical period is prepared.
    private string? MonthlyFacilityCode => _source?.Identity.Kind == SourceIdentityKind.Occupancy
        && _source.OperationCode is "FACILITY_TCC" or "FACILITY_NCC" or "FACILITY_BBQ" or "FACILITY_ICE"
        ? _source.OperationCode["FACILITY_".Length..] : null;

    private IReadOnlyList<CollectionSessionCapability> Offered => (_discovery?.Operations ?? [])
        .Where(x => x.Supported && x.CanAdd && Allows(x.OperationCode)).ToList();

    private static string FamilyName(CollectionFamily? family) => family switch
    {
        CollectionFamily.Rent => "Rent Income (Stall Rental)",
        CollectionFamily.Space => "Space Rental",
        CollectionFamily.Terminal => "Income from Terminal",
        CollectionFamily.Slaughterhouse => "Income from Slaughterhouse",
        _ => "Income from Market"
    };

    // What this collection already holds is not offered again: a charge whose every choice is already an item here is hidden (editing an item keeps its own
    // choice visible). Only the walk-up services (Terminal sections, Slaughterhouse animals) repeat by nature; a vendor's fee and weighing are taken once per collection.
    private static bool Repeatable(string code) => code is CollectorOperationCodes.Terminal or CollectorOperationCodes.Slaughterhouse;
    private HashSet<(string Operation, string Choice)> UsedChoices => _drafts.Where(d => d.Key != _editingId).Select(d => (d.Value.OperationCode, d.Value.ChoiceKey)).ToHashSet();
    private bool Used(string operation, string choiceKey) => !Repeatable(operation) && UsedChoices.Contains((operation, choiceKey));
    // A utility is one source and period however its choice is keyed after the server re-reads it: the same stall and month already in this collection is taken.
    private bool UsedSource(CollectionSessionSourceChoice c) => c.Kind is CollectionSessionItemKind.Electricity or CollectionSessionItemKind.Water && c.Identity.StallId is { } stall
        && _items.Any(x => x.ClientItemId != _editingId && x.Kind == c.Kind
            && (c.Kind == CollectionSessionItemKind.Electricity ? x.Electricity is { } e && (e.StallId ?? stall) == stall && e.Year == (c.Identity.Year ?? c.Identity.PeriodStart?.Year ?? BusinessDate.Year) && e.Month == (c.Identity.Month ?? c.Identity.PeriodStart?.Month ?? BusinessDate.Month)
                : x.Water is { } w && w.StallId == stall && w.Year == (c.Identity.Year ?? c.Identity.PeriodStart?.Year ?? BusinessDate.Year) && w.Month == (c.Identity.Month ?? c.Identity.PeriodStart?.Month ?? BusinessDate.Month)));
    private bool Taken(CollectionSessionCapability o, CollectionSessionSourceChoice c) => Used(o.OperationCode, c.SelectionKey) || !Repeatable(o.OperationCode) && UsedSource(c);
    private IReadOnlyList<CollectionSessionCapability> Selectable => Offered
        .Where(o => Repeatable(o.OperationCode) || o.Choices is not { Count: > 0 } || o.Choices.Any(c => !Taken(o, c))).ToList();

    // Display groups only: what is offered at all is the server's answer; the family is just where its row sits. Utilities are their own group.
    private static (int Order, string Name) SectionOf(CollectionSessionCapability x) =>
        x.OperationCode is "ECF" or "WCF" ? (100, "Utilities") : ((int)(x.Family ?? CollectionFamily.Market), FamilyName(x.Family ?? CollectionFamily.Market));
    private IReadOnlyList<(string Name, IReadOnlyList<CollectionSessionCapability> Items)> PickerSections =>
        Selectable.GroupBy(SectionOf).OrderBy(g => g.Key.Order)
            .Select(g => (g.Key.Name, (IReadOnlyList<CollectionSessionCapability>)g.ToList())).ToList();

    // The source header already says New Public Market and the stall, so the NPM items read as what they are. The names are by operation code; the amounts are the server's.
    private string OperationLabel(CollectionSessionCapability row) => row.OperationCode switch
    {
        "NPM_DAILY" => "Daily stall payment",
        "NPM_WHOLE_PAYMENT" => "Whole payment",
        _ => row.DisplayName
    };

    private string? OperationDetail(CollectionSessionCapability row) => row.OperationCode switch
    {
        "NPM_DAILY" when row.Choices is [{ ServerAmount: { } amount }] => Money(amount) + " · Today",
        "NPM_WHOLE_PAYMENT" when row.Choices is [{ ServerAmount: { } amount }] => Money(amount) + " remaining",
        "NPM_PART_PAYMENT" when row.Choices is [{ MaximumAmount: { } most }] => "Any amount up to " + Money(most),
        _ => null
    };

    private IReadOnlyList<CollectionSessionSourceChoice> Choices => (_operation?.Choices ?? []).Where(c => _operation is null || !Taken(_operation, c)).ToList();
    private string ChoiceLabel => _operation?.OperationCode switch
    {
        CollectorOperationCodes.Terminal => "Section",
        _ => "Source"
    };
    private IReadOnlyList<MobileChoice.Choice> ChoiceOptions => Choices.Select(x => new MobileChoice.Choice(x.SelectionKey, x.DisplayName,
        string.IsNullOrWhiteSpace(x.Context) || x.Context == _operation?.DisplayName ? (x.ServerAmount is { } amount ? Money(amount) : null) : x.Context)).ToArray();
    private bool IsWeighing => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.WeightAndMeasure };
    private bool IsTerminal => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.Terminal };
    private bool TakesTypedAmount => _choice is { } c && !IsWeighing && c.Kind is not (CollectionSessionItemKind.Slaughter or CollectionSessionItemKind.NpmWholePayment)
        && c.AmountRule is CollectionSessionAmountRule.DirectAmount or CollectionSessionAmountRule.PreparedBalance;
    private bool NeedsPayerName => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.FishMeatVendorFee } c
        && c.Identity.VendorRegistrationId is null;

    private bool CanAddItem => _choice is { } c && (IsWeighing ? _quantity > 0 && _serverAmount is > 0m
        : c.Kind == CollectionSessionItemKind.Slaughter ? _heads > 0 && (_source is not null || !string.IsNullOrWhiteSpace(_snapshot) || !string.IsNullOrWhiteSpace(_owner))
            && (_slhTerms is not { Itemized: true } || _slhPicked.Count > 0)
        : c.Kind == CollectionSessionItemKind.NpmWholePayment ? true
        : c.Kind == CollectionSessionItemKind.NpmPartPayment ? _amount > 0m && (c.MaximumAmount is not { } cap || _amount <= cap)
        : (c.AmountRule == CollectionSessionAmountRule.FixedAmount ? c.ServerAmount ?? 0m : _amount) > 0m)
        && (!NeedsPayerName || !string.IsNullOrWhiteSpace(_snapshot))
        && !(UtilityChoice is not null && _recent == RecentUtilityNotice.Check.Loading);   // never before the earlier-collections check has answered

    private IDisposable? _leaveGuard;
    private string? _leaveTarget;
    private bool _leaveAllowed;

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_leaveAllowed || _items.Count == 0 || _queued || _correctionResult is not null) return ValueTask.CompletedTask;
        context.PreventNavigation();
        _leaveTarget = context.TargetLocation;
        _ = InvokeAsync(StateHasChanged);
        return ValueTask.CompletedTask;
    }
    private void StayOnCollection() => _leaveTarget = null;
    private void LeaveCollection()
    {
        var target = _leaveTarget; _leaveTarget = null; _leaveAllowed = true;
        if (target is not null) Navigation.NavigateTo(target);
    }
    public void Dispose() => _leaveGuard?.Dispose();

    protected override async Task OnInitializedAsync()
    {
        _leaveGuard = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        if (ResumeSessionId is { } id && (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == id)?.CollectionSession?.Intent is { } saved)
        {
            _sessionId = id; BusinessDate = saved.BusinessDate; _items.AddRange(saved.Items);
            if (saved.SourceIdentity is { } identity) _source = new(identity, "Selected source", "", OnlyOperation ?? "");
            else { _direct = true; _snapshot = saved.PayerSnapshot ?? ""; }
            _queued = true; await RefreshResultAsync();
        }
        else if (Correction is not null) await PrepareCorrectionAsync();
        else if (OnlyOperation == CollectorOperationCodes.Terminal) { _direct = true; await LoadAsync(); }
        _loading = false;
    }

    // ── Correcting a recorded collection ─────────────────────────────────────────────────────────────
    private MobileCorrectionReasonIntent? _reason;
    private MobileCollectionCorrectionResult? _correctionResult;

    // The form opens on what the server resolved from the original: its source, and the item with the facts it was recorded with. The choice comes from
    // the server's discovery for that source (never rebuilt from a name); a Daily stall payment, which is no longer offered once paid, is described from
    // the recorded source. A kind of collection this form has no entry for says so rather than offering a wrong form.
    private async Task PrepareCorrectionAsync()
    {
        _sessionId = Guid.NewGuid();                                   // the correction's operation ID: the replacement session carries the same one
        if (Correction?.EditSource is not { } edit || Correction.Collection.CollectionId is null)
        { _message = "This collection can't be edited here. Remove it and record the correct one."; return; }
        if (edit.SourceIdentity is { } identity) _source = new(identity, Correction.Collection.PayerName ?? "Selected source", Correction.Collection.Subject ?? "", edit.OperationCode);
        else { _direct = true; _snapshot = edit.PayerSnapshot ?? ""; }
        await LoadAsync();
        var choice = _discovery?.Operations.SelectMany(o => o.Choices ?? []).FirstOrDefault(c => MatchesRecorded(c, edit));
        if (choice is null && edit.Kind == CollectionSessionItemKind.NpmDaily && edit.Identity.StallId is not null)
        {
            var instrument = Correction.Collection.InstrumentType ?? RevenueInstrumentType.CashTicket;
            choice = new($"Daily|{edit.Identity.StallId:N}", CollectionSessionItemKind.NpmDaily, edit.OperationCode, "Daily stall payment",
                Correction.Collection.Subject ?? "", edit.Identity, instrument, CollectionSessionAmountRule.FixedAmount, Correction.Collection.Amount, RequiredInputs: []);
            _discovery = (_discovery ?? new(null, BusinessDate, [])) with { Operations = [.. _discovery?.Operations ?? [], new(CollectionSessionItemKind.NpmDaily, edit.OperationCode, "Daily stall payment", true, true, null, null, false, [], true, [choice], CollectionFamily.Rent)] };
        }
        if (choice is null) { _message = "This collection can't be edited here. Remove it and record the correct one."; return; }
        Choose(choice.OperationCode);
        if (edit.Native is { } native && choice.OperationCode == CollectorOperationCodes.Terminal)
        { _termSection = native.Section; _byVehicle = native.VehicleClassId is not null; }
        ChooseChoice(choice.SelectionKey);
        if (choice.CanEnterAmount) _amount = Correction.Collection.Amount;
        _quantity = edit.Native?.Kilograms ?? 0m;
        if (IsWeighing) await QuoteWeighingAsync();
        _picker = true;
    }

    private static bool MatchesRecorded(CollectionSessionSourceChoice c, MobileCollectionEditSource edit) =>
        c.OperationCode == edit.OperationCode && c.Kind == edit.Kind && edit.Kind switch
        {
            CollectionSessionItemKind.SourceNative => c.Identity.VendorRegistrationId == edit.Identity.VendorRegistrationId
                && c.Identity.TerminalSection == edit.Native?.Section && c.Identity.VehicleClassId == edit.Native?.VehicleClassId,
            CollectionSessionItemKind.GovernedService => true,
            CollectionSessionItemKind.NpmDaily => c.Identity.StallId == edit.Identity.StallId,
            _ => false
        };

    // A changed reason or item is a different proposed correction: it gets a fresh operation ID, as the server requires.
    private void ReasonChanged(MobileCorrectionReasonIntent? reason) { _reason = reason; _sessionId = Guid.NewGuid(); _quote = null; }

    private EditMobileCollectionIntent EditIntent => new(_sessionId, Correction!.Collection.CollectionId!.Value, _reason! with { Note = _reason!.Note?.Trim() }, Intent);

    private async Task RecordCorrectionAsync()
    {
        if (_quote?.CanRecord != true || _busy) return;
        if (!Sync.IsOnline) { _message = "Connect to correct a collection."; return; }
        _busy = true; _message = null;
        try
        {
            var result = await Api.EditCollectionAsync(new RecordMobileCollectionEditRequest(EditIntent, _quote.QuoteFingerprint));
            if (result.IsSuccess && result.Value is { } outcome) _correctionResult = outcome;
            else _message = RecentCollections.ProblemText(result.Error);
        }
        catch { _message = "Couldn't confirm the result. Check today's recent collections before trying again."; }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        _discovery = null;
        if (_source is null && !_direct) return;
        try
        {
            var response = await Api.GetSourceCollectionDiscoveryAsync(_source?.Identity);
            _discovery = response.Value;
            if (!response.IsSuccess) _message = "Collection sources are unavailable.";
        }
        catch { _message = "Connection required to review."; }
    }

    // ── Finding the source ─────────────────────────────────────────────────────────────────────────
    // Tapping the field opens a bounded list of what the server returns, about five rows then scrolling; typing searches after a short pause.
    private CancellationTokenSource? _searchDelay;
    private bool _searching, _searched, _suggestOpen, _browsed;

    private async Task OnSearchFocusAsync()
    {
        _suggestOpen = true;
        if (_browsed || _searched || _found.Count > 0) return;
        _browsed = true;
        await RunSearchAsync(_search, announceFailure: false);
    }

    // Fish / Meat registration request: offered when the vendor search finds no eligible registered vendor.
    private bool CanRequestRegistration => Correction is null && OnlyOperation is CollectorOperationCodes.FishMeatVendorFee or CollectorOperationCodes.WeightAndMeasure;
    private bool _requestOpen;
    private string? _requestName;
    private FishMeatRegistrationRequestDto? _requestSaved;
    private void OpenRequest() { _requestName = _search.Trim(); _requestSaved = null; _requestOpen = true; _suggestOpen = false; }
    private void CloseRequest() => _requestOpen = false;
    private Task RequestSubmitted(FishMeatRegistrationRequestDto saved) { _requestSaved = saved; _requestOpen = false; return Task.CompletedTask; }
    // The source list is read from the office again, so a vendor the Head has just registered appears for selection.
    private async Task SearchAfterRequestAsync() { _requestSaved = null; _suggestOpen = true; await SearchAsync(); }

    private void OnSearchChanged()
    {
        _searchDelay?.Cancel();
        _suggestOpen = true;
        _searchDelay = new CancellationTokenSource();
        _ = DebouncedSearchAsync(_searchDelay.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken token)
    {
        try { await Task.Delay(300, token); } catch (OperationCanceledException) { return; }
        await InvokeAsync(() => RunSearchAsync(_search, announceFailure: true));
    }

    private async Task OnSearchKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter") return;
        _searchDelay?.Cancel();
        await SearchAsync();
    }

    private async Task SearchAsync() { _searchDelay?.Cancel(); _suggestOpen = true; await RunSearchAsync(_search, announceFailure: true); }

    private async Task RunSearchAsync(string term, bool announceFailure)
    {
        if (_source is not null || _direct) return;
        _searching = true;
        StateHasChanged();     // the debounced path has no event handler to re-render for it
        try
        {
            var response = await Api.SearchCollectionSourcesAsync(term);
            if (_source is not null || _direct || term != _search) return;     // a newer search or a chosen source supersedes this answer
            _found = response?.Value ?? [];
            _searched = response is { IsSuccess: true };
            if (response is { IsSuccess: false } && announceFailure) _message = "Search is unavailable.";
        }
        catch { if (announceFailure) _message = "Connect to search."; }
        finally { _searching = false; StateHasChanged(); }
    }

    // A source chosen from the browser goes straight to what the server says it can be collected for: the Add item sheet opens on the eligible
    // charges instead of leaving the collector at an empty items list. Nothing is opened when the server offers nothing.
    // The utilities a vendor's office-linked NPM stall offers this collector, by the stall's own identity. Choosing one opens the stall as its own source
    // and its own checkout: the instrument, amount and eligibility are the stall's, exactly as if the stall had been picked directly.
    private async Task SelectBrowsedAsync(CollectionSourceSearchResult found)
    {
        await SelectSourceAsync(found);
        if (_items.Count == 0 && _discovery is not null && Offered.Count > 0) await OpenPickerAsync();
    }

    private async Task SelectSourceAsync(CollectionSourceSearchResult found)
    {
        _linkedNpmContext = false;
        _source = found; _found = []; _suggestOpen = false; _searched = false; _quote = null; _direct = false;
        await LoadAsync();
    }

    // A direct collection has no Source Identity; the typed name is only the payer's name on the receipt.
    private async Task StartDirectAsync(string name)
    {
        if (!DirectAllowed) return;
        _linkedNpmContext = false;
        _source = null; _direct = true; _snapshot = name.Trim(); _found = []; _suggestOpen = false; _searched = false; _quote = null;
        await LoadAsync();
    }

    private async Task ClearSourceAsync()
    {
        _linkedNpmContext = false;
        _source = null; _direct = false; _snapshot = ""; _quote = null; _search = ""; _found = []; _searched = false; _browsed = false; _suggestOpen = false;
        _discovery = null; _message = null;
        await Task.CompletedTask;
    }

    // ── Adding an item ──────────────────────────────────────────────────────────────────────────────
    private async Task OpenOfferedAsync(string operationCode)
    {
        if (_busy || _items.Count > 0 || _source is null) return;
        await OpenPickerAsync();
        if (_picker && Offered.Any(x => x.OperationCode == operationCode)) { Choose(operationCode); _pickerFromList = false; }
    }

    private async Task OpenPickerAsync()
    {
        _message = null; _editingId = null; await LoadAsync(); _operation = null; _choice = null; _choiceKey = ""; _pickerFromList = false;
        // A dedicated page with a single thing on offer goes straight to it; one with several (Fish / Meat: Vendor Fee and Weight & Measure) lists them.
        if (OnlyOperation is not null && Selectable is [{ } only] && !VendorHasLinkedStall) Choose(only.OperationCode);
        // Never open a sheet with nothing to choose: say why, in the page, where the collector is looking.
        if (_operation is null && !PickerSections.Any())
        {
            _message ??= Offered.Count > 0 ? "Everything available for this source is already in this collection." : "Nothing available for this source.";
            return;
        }
        _pickerFromList = _operation is null;
        _picker = true;
    }

    private void Choose(string code)
    {
        _pickerFromList = _operation is null && _picker;
        _operation = Offered.FirstOrDefault(x => x.OperationCode == code);
        _choice = null; _choiceKey = ""; _amount = _quantity = 0; _serverAmount = null; _heads = 1; _owner = ""; _termSection = null; _byVehicle = false;
        _slhPicked.Clear(); _slhTerms = null;
        if (_operation?.Choices is { Count: 1 } only) ChooseChoice(only[0].SelectionKey);
    }

    private string _npmReceipt = "";
    private void ChooseChoice(string key)
    {
        _choiceKey = key; _confirmRepeat = false; _recent = RecentUtilityNotice.Check.Loading;
        _npmReceipt = "";
        _choice = Choices.FirstOrDefault(x => x.SelectionKey == key);
        if (Correction is null && _items.Count == 0 && _choice is { Kind: CollectionSessionItemKind.NpmWholePayment,
                Identity.StallId: { } rentStall, Identity.OccupancyId: { } rentContract })
        {
            Navigation.NavigateTo($"/npm/whole-payment/{rentStall}?contractId={rentContract}");
            return;
        }
        // A prepared balance pre-fills its balance; a choice with an approved rate (a vehicle type at the terminal) pre-fills that rate. Either way the
        // collector can still edit what was actually received, and the server revalidates the amount.
        _amount = _choice is { AmountRule: CollectionSessionAmountRule.PreparedBalance, ServerAmount: { } balance } ? balance
            : _choice is { Rate: { } rate and > 0m } && TakesTypedAmount ? rate : 0m;
        _quantity = 0; _serverAmount = null;
        if (_choice?.Kind == CollectionSessionItemKind.Slaughter) _ = LoadSlhTermsAsync();   // per-head charges start ticked once loaded
    }

    // The amount of a weighing is the server's: kilograms are quoted there, never multiplied here.
    private async Task QuoteWeighingAsync()
    {
        _serverAmount = null;
        if (!IsWeighing || _choice is null || _quantity <= 0m) return;
        try
        {
            var charge = new SourceNativeChargeIntent(_choice.OperationCode, _choice.Identity.VendorRegistrationId, Kilograms: _quantity);
            var quote = await Api.QuoteOfficeCollectionAsync(new SourceNativeCollectionRequest(Guid.NewGuid(), BusinessDate, 1m, charge));
            _serverAmount = quote.IsSuccess ? quote.Value?.Amount : null;
        }
        catch { _serverAmount = null; }
    }

    private void ClosePicker() { _picker = false; _editingId = null; _confirmRepeat = false; }

    // Editing re-opens the same sheet with what was entered; the original row stays until the changed one is added, so closing loses nothing.
    private async Task EditAsync(CollectionSessionItemIntent item)
    {
        if (!_drafts.TryGetValue(item.ClientItemId, out var draft)) return;
        _message = null; _editingId = item.ClientItemId;      // before the choice is looked up: the item's own choice must not count as already taken
        await LoadAsync();
        Choose(draft.OperationCode);
        _termSection = draft.Section; _byVehicle = draft.ByVehicle;
        ChooseChoice(draft.ChoiceKey);
        if (_choice is null) { _editingId = null; _message = "This item is no longer available. Remove it and add it again."; return; }
        _amount = draft.Amount; _quantity = draft.Quantity; _heads = draft.Heads; _owner = draft.Owner;
        _slhPicked.Clear(); foreach (var (id, qty) in draft.Charges ?? new Dictionary<Guid, int>()) _slhPicked[id] = qty;
        if (IsWeighing) await QuoteWeighingAsync();
        _editingId = item.ClientItemId; _picker = true;
    }

    // What a Collector is told before taking a second utility payment for one source and period: the server shows what was already
    // posted, and a repeat is a separate payment they confirm, never a silent second tap. A reversed collection does not count, and an
    // answer that could not be had never blocks (the server still decides what posts).
    private sealed record UtilityContext(string Code, Guid StallId, int Year, int Month);
    private UtilityContext? UtilityChoice => _choice is { Identity.StallId: { } stall } c && c.Kind is CollectionSessionItemKind.Electricity or CollectionSessionItemKind.Water
        ? new(c.Kind == CollectionSessionItemKind.Electricity ? "ECF" : "WCF", stall, c.Identity.Year ?? c.Identity.PeriodStart?.Year ?? BusinessDate.Year, c.Identity.Month ?? c.Identity.PeriodStart?.Month ?? BusinessDate.Month)
        : null;
    private RecentUtilityNotice.Check _recent = RecentUtilityNotice.Check.Loading;
    private bool _confirmRepeat;
    private void OnRecentResolved(RecentUtilityNotice.Check state) { _recent = state; StateHasChanged(); }
    // Close steps back one view: from a charge's entry to the list it was chosen from, and from the list to the collection. Cancel on the repeat notice
    // returns to the entry. Nothing entered in the collection itself is lost by any of them.
    private void CancelPicker()
    {
        if (_confirmRepeat) { _confirmRepeat = false; return; }
        if (_operation is not null && _pickerFromList && _editingId is null)
        { _operation = null; _choice = null; _choiceKey = ""; _amount = _quantity = 0; _serverAmount = null; return; }
        ClosePicker();
    }
    private bool _pickerFromList;

    private void AddItem()
    {
        if (!CanAddItem || _choice is not { } c) return;
        if (UtilityChoice is { } repeat)
        {
            // The same source and period already in this unsent collection is one line: edit it, never add a twin.
            // Only the SAME utility: Water on a stall and month never blocks Electricity on it (they are different charges).
            var repeatKind = repeat.Code == "ECF" ? CollectionSessionItemKind.Electricity : CollectionSessionItemKind.Water;
            var already = _items.FirstOrDefault(x => x.ClientItemId != _editingId && x.Kind == repeatKind && (repeatKind == CollectionSessionItemKind.Electricity
                ? x.Electricity is { } e && e.StallId == repeat.StallId && e.Year == repeat.Year && e.Month == repeat.Month
                : x.Water is { } w && w.StallId == repeat.StallId && w.Year == repeat.Year && w.Month == repeat.Month));
            if (already is not null)
            {
                _message = $"{repeat.Code} for this source is already in this collection. Edit that item instead of adding another.";
                _picker = false; _confirmRepeat = false; return;
            }
            if (_recent == RecentUtilityNotice.Check.Prior && !_confirmRepeat) { _confirmRepeat = true; return; }
        }
        _confirmRepeat = false;
        var id = Guid.NewGuid(); var identity = c.Identity;
        SessionWaterIntent? water = null; SessionElectricityIntent? electricity = null; SessionObligationIntent? obligation = null;
        SessionGovernedIntent? service = null; SessionSlaughterIntent? slaughter = null; SessionNpmWholeIntent? npmWhole = null; SessionNpmDailyIntent? npmDaily = null; SessionNpmPartIntent? npmPart = null;
        SourceNativeChargeIntent? native = null; SessionMonthlyRentIntent? rent = null;
        var year = identity.Year ?? identity.PeriodStart?.Year ?? BusinessDate.Year;
        var month = identity.Month ?? identity.PeriodStart?.Month ?? BusinessDate.Month;
        switch (c.Kind)
        {
            case CollectionSessionItemKind.Water: water = new(identity.StallId!.Value, year, month, identity.UtilityBillId, identity.SourceVersion); break;
            case CollectionSessionItemKind.Electricity: electricity = new(identity.UtilityBillId!.Value, identity.SourceVersion, identity.StallId, year, month); break;
            case CollectionSessionItemKind.Obligation: obligation = new(identity.AccountId!.Value, year, month); break;
            case CollectionSessionItemKind.NpmWholePayment: npmWhole = new(identity.StallId!.Value, year, month); break;
            case CollectionSessionItemKind.NpmDaily: npmDaily = new(identity.StallId!.Value, string.IsNullOrWhiteSpace(_npmReceipt) ? null : _npmReceipt.Trim()); break;
            case CollectionSessionItemKind.NpmPartPayment: npmPart = new(identity.StallId!.Value, year, month); break;
            case CollectionSessionItemKind.MonthlyRent: rent = new(identity.StallId!.Value, year, month, identity.SourceVersion); break;
            case CollectionSessionItemKind.GovernedService: service = new(c.OperationCode, identity.Mode, identity.FeeOptionId, identity.VehicleClassCode); break;
            case CollectionSessionItemKind.Slaughter:
                slaughter = new(identity.Animal!.Value, _heads, identity.CustomAnimalName, _source is null && string.IsNullOrWhiteSpace(_snapshot) ? _owner.Trim() : null, SlhSelected()); break;
            case CollectionSessionItemKind.SourceNative:
                native = new(c.OperationCode, identity.VendorRegistrationId, identity.TerminalSection, identity.VehicleClassId,
                    null, IsWeighing ? _quantity : null); break;
        }
        var amount = c.Kind is CollectionSessionItemKind.Slaughter or CollectionSessionItemKind.NpmWholePayment ? 0m
            : IsWeighing ? _serverAmount ?? 0m
            : c.AmountRule == CollectionSessionAmountRule.FixedAmount ? c.ServerAmount ?? 0m : _amount;
        var added = new CollectionSessionItemIntent(id, c.Kind, amount, water, service, obligation, electricity, null, slaughter, null, npmWhole, native, rent, npmDaily, npmPart);
        var at = _editingId is { } editing ? _items.FindIndex(x => x.ClientItemId == editing) : -1;
        if (at >= 0) { _items[at] = added; _shown.Remove(_editingId!.Value); _drafts.Remove(_editingId.Value); }
        else _items.Add(added);
        // A utility reads as the charge ("Electricity"), with who and which stall as its context; the payer's name is never the row's title.
        _shown[id] = IsTerminal ? new(TerminalDraftName(c), TerminalDraftContext(c))
            : c.Kind is CollectionSessionItemKind.Electricity or CollectionSessionItemKind.Water
                ? new(_operation?.DisplayName ?? c.DisplayName, CleanContext(SourceName, c.DisplayName, c.Context))
            : new(c.DisplayName, CleanContext(SourceName, c.Context));
        _drafts[id] = new(c.OperationCode, c.SelectionKey, _amount, _quantity, _heads, _owner, _termSection, _byVehicle, _slhPicked.Count > 0 ? new Dictionary<Guid, int>(_slhPicked) : null);
        if (Correction is not null) _sessionId = Guid.NewGuid();
        _quote = null; _picker = false; _editingId = null;
    }

    // Context parts joined by a single separator: empty parts dropped, repeats (the vendor named twice) shown once.
    private static string CleanContext(params string?[] parts) => string.Join(" · ", parts.SelectMany(p => (p ?? "").Split('·'))
        .Select(p => p.Trim()).Where(p => p.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase));

    private void Remove(CollectionSessionItemIntent item) { if (Correction is not null) _sessionId = Guid.NewGuid(); _items.Remove(item); _shown.Remove(item.ClientItemId); _drafts.Remove(item.ClientItemId); _quote = null; }

    // ── Review, record, result ──────────────────────────────────────────────────────────────────────
    private async Task ReviewAsync()
    {
        if (Correction is not null && !CorrectionReason.IsComplete(_reason)) { _message = "Choose a reason first."; return; }
        _busy = true; _message = null;
        try { var response = Correction is null ? await Api.QuoteCollectionSessionAsync(Intent) : await Api.QuoteCollectionEditAsync(EditIntent); _quote = response.Value; if (!response.IsSuccess) _message = "Collection review is unavailable."; }
        catch { _message = "Connection required to review."; }
        finally { _busy = false; }
    }

    private async Task RecordAsync()
    {
        if (Correction is not null) { await RecordCorrectionAsync(); return; }
        if (_quote?.CanRecord != true || _busy) return;
        _busy = true;
        try
        {
            await Sync.EnqueueCollectionSessionAsync(new(Intent, _quote.QuoteFingerprint), _quote.GrandTotal);
            if (_supersededSessionId is { } old) { await Sync.DiscardAsync(old); _supersededSessionId = null; }
            _queued = true;
            if (Sync.IsOnline) await Sync.SyncNowAsync(force: true);
            await RefreshResultAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException) { _message = "The collection could not be safely saved. Check device storage."; }
        finally { _busy = false; }
    }

    private async Task RefreshResultAsync()
    {
        var pending = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == _sessionId);
        _result = pending?.CollectionSessionResult; _needsReview = pending?.LocalStatus == PendingLocalStatus.ReconciliationRequired;
        if (_result is null && Sync.IsOnline)
            try { _result = (await Api.GetCollectionSessionAsync(_sessionId)).Value; } catch { }
    }

    private async Task ReviewQueuedAsync()
    {
        if (!Sync.IsOnline) { _message = "Connection required to review."; return; }
        _busy = true;
        try
        {
            // Reconcile unknown responses before offering any correction. Posted money is immutable.
            var current = await Api.GetCollectionSessionAsync(_sessionId);
            if (current.Value?.Status == CollectionSessionStatus.Recorded) { _result = current.Value; return; }
            var pending = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == _sessionId);
            if (current.StatusCode != 404 || pending is null || !EEMOCantilanSDS.Mobile.Services.MobileSyncService.CanReviewUnpostedSession(pending))
            { _message = "This collection needs office review."; return; }
            _supersededSessionId = _sessionId; _sessionId = Guid.NewGuid();
            _queued = _needsReview = false; _result = null; _quote = null; await LoadAsync();
        }
        catch { _message = "Connection required to review."; }
        finally { _busy = false; }
    }

    private async Task StartAnotherAsync()
    {
        _linkedNpmContext = false;
        _sessionId = Guid.NewGuid(); _items.Clear(); _shown.Clear(); _drafts.Clear(); _result = null; _quote = null; _queued = _needsReview = false;
        _source = null; _snapshot = ""; _search = ""; _found = []; _searched = _browsed = _suggestOpen = false; _discovery = null;
        _direct = OnlyOperation == CollectorOperationCodes.Terminal;
        await LoadAsync();
    }

    private string ProblemName(CollectionSessionProblem problem) => problem.ClientItemId is { } id && _shown.TryGetValue(id, out var shown) ? shown.Name + ": " : "";
    private string CollectionName(CollectionSessionCollection collection) => string.Join(", ", collection.ClientItemIds.Select(id => _shown.GetValueOrDefault(id)?.Name).Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string InstrumentCode(RevenueInstrumentType instrument) => instrument == RevenueInstrumentType.CashTicket ? "CT" : "OR";
    private static string Instrument(RevenueInstrumentType instrument) => instrument == RevenueInstrumentType.CashTicket ? "CT · Cash Ticket" : "OR · Official Receipt";
    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
