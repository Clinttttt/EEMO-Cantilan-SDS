@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Entities.Revenue
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Mobile.Models
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IMobileApiClient Api
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync

@* New Collection is source-native: the collector finds the real source (an occupant, a space holder, a registered vendor), the server says what
   that source can be collected for, and only those items are offered. With no source the collector can continue as a direct collection, which
   offers only the walk-up operations the server approves. Nothing here matches names, calculates an amount or invents eligibility. *@
@if (_loading)
{
    <LoadingState Text="Loading collection sources…" />
}
else if (_correctionResult is { } corrected)
{
    <section class="collection-entry" aria-live="polite">
        <h2 class="done-title">Collection corrected</h2>
        <div class="done-total"><strong>@(corrected.Replacement is { } replacement ? Money(replacement.Amount) : "Removed")</strong><span>@corrected.OriginalSRC stays on record</span></div>
        @if (corrected.Replacement is { } replaced)
        {
            <div class="item-row">
                <div class="item-main"><strong class="item-name">Replacement</strong><span class="item-context">@replaced.ReferenceCode</span></div>
                <div class="item-amount"><strong>@Money(replaced.Amount)</strong><span>@InstrumentCode(replaced.Instrument)</span></div>
            </div>
        }
        <button class="collection-primary done-action" type="button" @onclick='() => Navigation.NavigateTo("/menu")'>Done</button>
    </section>
}
else if (_queued)
{
    <section class="collection-entry" aria-live="polite">
        <h2 class="done-title">@(_result?.Status == CollectionSessionStatus.Recorded ? "Collection recorded" : _needsReview ? "Needs review" : "Waiting to sync")</h2>
        @if (_result?.Status == CollectionSessionStatus.Recorded)
        {
            <div class="done-total"><strong>@Money(_result.GrandTotal)</strong><span>@_result.Collections.Count @(_result.Collections.Count == 1 ? "collection record" : "collection records")</span></div>
            @foreach (var collection in _result.Collections)
            {
                <div class="item-row">
                    <div class="item-main"><strong class="item-name">@CollectionName(collection)</strong><span class="item-context">@collection.ReferenceCode</span></div>
                    <div class="item-amount"><strong>@Money(collection.Amount)</strong><span>@InstrumentCode(collection.Instrument)</span></div>
                </div>
            }
            <button class="collection-primary done-action" type="button" @onclick="StartAnotherAsync">New Collection</button>
        }
        else
        {
            <p>@(_needsReview ? "Review the affected items." : "SRC references appear after synchronization.")</p>
            @if (_needsReview)
            { <button class="btn-primary" type="button" disabled="@_busy" @onclick="ReviewQueuedAsync">Review</button> }
            <button class="btn-cancel" type="button" @onclick="RefreshResultAsync">Refresh</button>
        }
    </section>
}
else
{
    @if (OnlyOperation != CollectorOperationCodes.Terminal && !BrowserMode)
    {
    <section class="collection-entry collection-payer">
        <h2>@(SourceHeading)</h2>
        @if (_source is not null)
        {
            <div class="payer-selected"><span class="payer-option-text"><strong class="payer-name">@_source.DisplayName</strong><small>@_source.Context</small></span><button class="collection-small" type="button" disabled="@(_items.Count > 0 || Correction is not null)" @onclick="ClearSourceAsync">Change</button></div>
        }
        else if (_direct)
        {
            @if (OnlyOperation != CollectorOperationCodes.Terminal)
            {
                <div class="payer-selected"><span class="payer-option-text"><strong class="payer-name">@(string.IsNullOrWhiteSpace(_snapshot) ? "Direct collection" : _snapshot.Trim())</strong><small>No linked source</small></span><button class="collection-small" type="button" disabled="@(_items.Count > 0)" @onclick="ClearSourceAsync">Change</button></div>
                <label class="form-field"><span class="form-label">Payer name</span>
                    <input class="form-input" type="text" autocomplete="off" maxlength="200" placeholder="As given by the payer" @bind="_snapshot" @bind:event="oninput" /></label>
            }
        }
        else
        {
            <div class="collection-search">
                <label class="form-field"><span class="form-label">@(SearchLabel)</span>
                    <input class="form-input" type="search" autocomplete="off" enterkeyhint="search" placeholder="Name"
                           @bind="_search" @bind:event="oninput" @bind:after="OnSearchChanged" @onfocus="OnSearchFocusAsync" @onkeydown="OnSearchKeyAsync" /></label>
                <button class="collection-small" type="button" disabled="@_searching" @onclick="SearchAsync">Search</button>
            </div>
            @if (_suggestOpen)
            {
                <div class="payer-panel" aria-label="Sources" aria-busy="@(_searching ? "true" : "false")">
                    @if (VisibleSources.Count > 0)
                    {
                        <div class="payer-list" role="list">
                            @foreach (var found in VisibleSources)
                            {
                                <button class="collection-option payer-option" type="button" role="listitem" @onclick="() => SelectSourceAsync(found)">
                                    <span class="payer-option-text"><strong>@found.DisplayName</strong><small>@found.Context</small></span>
                                    <span aria-hidden="true">›</span></button>
                            }
                        </div>
                        @if (_searching) { <div class="payer-status payer-status-inline" role="status">Searching…</div> }
                    }
                    else if (_searching) { <div class="payer-status" role="status">Searching…</div> }
                    else if (_searched) { <div class="payer-status" role="status">No match found.</div> }
                    @if (DirectAllowed && !_searching && _search.Trim().Length >= 2 && VisibleSources.Count == 0)
                    {
                        <button class="collection-option payer-option" type="button" @onclick="() => StartDirectAsync(_search)">
                            <span class="payer-option-text"><strong>Continue with payer name</strong><small>@_search.Trim()</small></span><span aria-hidden="true">›</span></button>
                    }
                    @if (CanRequestRegistration && !_searching && _searched && _search.Trim().Length >= 2 && VisibleSources.Count == 0)
                    {
                        @* No eligible registered vendor: the Collector may ask the office to register one. A separate request, never a source or a payer. *@
                        <button class="collection-option payer-option" type="button" @onclick="OpenRequest">
                            <span class="payer-option-text"><strong>Request registration</strong><small>Ask the office to register “@_search.Trim()”</small></span><span aria-hidden="true">›</span></button>
                    }
                </div>
            }
        }
    </section>
    }
    @if (_requestOpen)
    {
        <section class="collection-entry" aria-label="Request vendor registration">
            <h2>Request registration</h2>
            <FishMeatRegistrationRequestForm InitialName="@_requestName" OnSubmitted="RequestSubmitted" OnCancel="CloseRequest" />
        </section>
    }
    else if (_requestSaved is { } requested)
    {
        <section class="collection-entry" aria-live="polite">
            <h2>Request submitted</h2>
            <p>@requested.VendorName is with the office. No cash or SRC is created. Once registered, search the vendor again.</p>
            <div class="collection-source-actions">
                <button class="collection-small" type="button" @onclick="SearchAfterRequestAsync">Search again</button>
                <button class="collection-small" type="button" @onclick='() => Navigation.NavigateTo("/fish-meat-requests")'>My registration requests</button>
            </div>
        </section>
    }
    @* The empty space under the finder: today's own collections, until a source is chosen or the finder's list needs the room. *@
    @if (OnlyOperation == CollectorOperationCodes.FishMeatVendorFee && Correction is null && _source is null && !_direct)
    {
        <section class="collection-entry" aria-label="Other collection sources">
            <h2>Other collections this visit</h2>
            <p>Electricity and NPM rent require their own stall account. Record them separately.</p>
            <div class="collection-source-actions">
                <button class="collection-small" type="button" disabled="@(_items.Count > 0 || _busy || _picker)" @onclick='() => Navigation.NavigateTo("/ecf")'>Choose electricity / ECF account</button>
                <button class="collection-small" type="button" disabled="@(_items.Count > 0 || _busy || _picker)" @onclick='() => Navigation.NavigateTo("/market")'>Choose NPM stall</button>
                <button class="collection-small" type="button" disabled="@(_items.Count > 0 || _busy || _picker)" @onclick='() => Navigation.NavigateTo("/npm-requests")'>My NPM requests</button>
                <button class="collection-small" type="button" disabled="@(_items.Count > 0 || _busy || _picker)" @onclick='() => Navigation.NavigateTo("/fish-meat-requests")'>My registration requests</button>
            </div>
            @if (_items.Count > 0) { <p>Record or remove current items before switching sources.</p> }
        </section>
    }
@* The landing: the registered sources assigned to this collector, by type. Today's collections and their corrections live in Records. *@    @if (BrowserMode)    {        <SourceBrowser OnSelect="SelectBrowsedAsync" DirectAllowed="DirectAllowed" OnDirect="StartDirectAsync" />        <div class="collection-source-actions landing-actions">            @if (DirectAllowed) { <button class="collection-small" type="button" @onclick="() => StartDirectAsync(string.Empty)">Direct collection</button> }            <button class="collection-small" type="button" @onclick='() => Navigation.NavigateTo("/records")'>Records</button>        </div>    }
    @if (_source is not null || _direct)
    {
        <section class="collection-entry">
            <div class="collection-row"><h2>Items</h2><button class="collection-small" type="button" disabled="@(_busy || (Correction is not null && _items.Count > 0))" @onclick="OpenPickerAsync">+ Add item</button></div>
            @if (_items.Count == 0)
            {
                <p>@(NothingDue && MonthlyFacilityCode is not null ? "No collectible monthly rent is prepared for this stall in New Collection." : NothingDue ? "No linked collection is due for this source." : "No items added.")</p>
                @if (_source is not null && Selectable.Count > 0)
                {
                    <div class="collection-available-fees" role="group" aria-label="Available charges">
                        <span class="collection-available-caption">Available charges</span>
                        @foreach (var offered in Selectable)
                        {
                            <button type="button" class="collection-option" disabled="@_busy" @onclick="() => OpenOfferedAsync(offered.OperationCode)">
                                <span class="option-text"><strong>@OperationLabel(offered)</strong><small>@(OperationDetail(offered) ?? (offered.Choices?.Count > 1 ? offered.Choices.Count + " approved options" : "Review office-approved charge"))</small></span>
                                <span aria-hidden="true">›</span>
                            </button>
                        }
                    </div>
                }
                @if (NothingDue && MonthlyFacilityCode is { } monthly)
                {
                    <div class="collection-monthly-route">
                        <strong>Monthly stall rental</strong>
                        <p>No canonical rental balance is available in New Collection. Review rental dues and authorized collection options in this facility's existing monthly operation.</p>
                        <button type="button" class="collection-small" @onclick='() => Navigation.NavigateTo("/collect/" + monthly)'>Open @monthly collections</button>
                    </div>
                }
                @if (NothingDue && OnlyOperation == CollectorOperationCodes.VegetableFruitSpaceRental)
                {
                    <p role="status">No collectible Monthly periods are available. Ask the office to check the account and OR collection setup.</p>
                    @foreach (var unavailable in _discovery!.Operations.Where(x => Allows(x.OperationCode) && !x.CanAdd && !string.IsNullOrWhiteSpace(x.Reason)))
                    { <p>@unavailable.Reason</p> }
                }
                @* The linked stall's rent and utilities are listed with the vendor's own charges (see Available charges / Add item); the request form shows only once the server has answered that there is no link. *@
                @if (!_picker && _source?.Identity.Kind == SourceIdentityKind.FishMeatVendorRegistration && Correction is null && _discovery is not null && (_discovery.LinkedSources?.Count ?? 0) == 0)
                {
                    @NpmLinkContent
                }
                @if (NothingDue && DirectAllowed && MonthlyFacilityCode is null)
                {
                    <button class="collection-small" type="button" @onclick="() => StartDirectAsync(_source!.DisplayName)">Continue as direct collection</button>
                }
            }
            @foreach (var item in _items)
            {
                var quote = _quote?.Items.FirstOrDefault(x => x.ClientItemId == item.ClientItemId);
                var problem = _quote?.Problems.Any(x => x.ClientItemId == item.ClientItemId) == true;
                var shown = _shown.GetValueOrDefault(item.ClientItemId);
                @* A Terminal row always reads as the official section with how it was entered, never as the server's repeated operation name. *@
                var own = (item.Native?.OperationCode == CollectorOperationCodes.Terminal || item.Kind is CollectionSessionItemKind.Electricity or CollectionSessionItemKind.Water) && shown is not null;
                <div class="item-row @(problem ? "item-row-problem" : "")">
                    <div class="item-main">
                        <strong class="item-name">@(own ? shown!.Name : quote?.DisplayName ?? shown?.Name ?? "Collection item")</strong>
                        <span class="item-context">@(own ? shown!.Context : quote?.Context is { Length: > 0 } qc && !qc.Equals(quote.DisplayName, StringComparison.OrdinalIgnoreCase) ? qc : shown?.Context ?? "Confirmed on review")</span>
                        <span class="item-actions">
                            @if (_drafts.ContainsKey(item.ClientItemId)) { <button class="collection-link" type="button" disabled="@_busy" @onclick="() => EditAsync(item)">Edit</button> }
                            <button class="collection-link" type="button" @onclick="() => Remove(item)">Remove</button>
                        </span>
                    </div>
                    <div class="item-amount">
                        <strong>@(quote is not null ? Money(quote.Amount) : item.ConfirmedAmount > 0 ? Money(item.ConfirmedAmount) : "Review")</strong>
                        @if (quote is not null) { <span>@InstrumentCode(quote.Instrument)</span> }
                    </div>
                </div>
            }
        </section>
        @if (_quote is not null)
        {
            <section class="collection-entry review-summary" aria-live="polite" aria-label="Collection total">
                @foreach (var total in _quote.InstrumentTotals)
                { <div class="review-row"><span>@Instrument(total.Instrument)</span><strong>@Money(total.Amount)</strong></div> }
                <div class="review-row review-total"><span>Total</span><strong>@Money(_quote.GrandTotal)</strong></div>
                @foreach (var problem in _quote.Problems)
                { <p class="review-problem" role="alert"><strong>Needs review</strong>@ProblemName(problem)@problem.Message</p> }
            </section>
        }
        @if (Correction is not null)
        {
            <section class="collection-entry" aria-label="Reason">
                <h2>Reason</h2>
                <CorrectionReason Value="_reason" ValueChanged="ReasonChanged" />
            </section>
        }
        @* One primary action that follows the state: review the items first, then confirm. Changing an item discards the reviewed quote, so the
           action returns to Review and nothing is ever confirmed against a stale quote. *@
        <div class="collection-actions collection-actions-one">
            @if (_quote is null)
            {
                <button class="collection-primary" type="button" disabled="@(_busy || _items.Count == 0)" @onclick="ReviewAsync">Review collection</button>
            }
            else
            {
                <button class="collection-primary" type="button" disabled="@(_busy || _quote.CanRecord != true || Sync.HasStorageFault || (Correction is not null && !Sync.IsOnline))" @onclick="RecordAsync">@(Correction is null ? "Record collection" : "Save changes")</button>
            }
        </div>
        @if (OnlyOperation == CollectorOperationCodes.Terminal) { <RecentCollections OnlyOperation="@CollectorOperationCodes.Terminal" Heading="Today's Terminal collections" /> }
    }
}
@if (!string.IsNullOrWhiteSpace(_message)) { <p class="collection-message" role="status">@_message</p> }

@* Leaving with items that are not yet recorded asks first, so a slip of the back button never loses the collector's progress. *@
@if (_leaveTarget is not null)
{
    <div class="sheet-overlay" @onclick="StayOnCollection">
        <section class="sheet" role="alertdialog" aria-modal="true" aria-labelledby="leave-title" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <header class="sheet-head">
                <h2 id="leave-title" class="sheet-title">Leave this collection?</h2>
                <div class="sheet-context">The items you added have not been recorded and will be lost.</div>
            </header>
            <div class="sheet-actions">
                <button class="btn-cancel" type="button" @onclick="StayOnCollection">Cancel</button>
                <button class="btn-primary" type="button" @onclick="LeaveCollection">OK</button>
            </div>
        </section>
    </div>
}

@if (_picker)
{
    <div class="sheet-overlay" @onclick="ClosePicker">
        <section class="sheet sheet-flex" role="dialog" aria-modal="true" aria-label="Add item" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <header class="sheet-head">
                <h2 class="sheet-title">Select charges</h2>
                <div class="sheet-context">@(_operation is null ? SourceName : _operation.DisplayName + (SourceName is { Length: > 0 } ? " · " + SourceName : ""))</div>
            </header>
            <div class="sheet-body">
            @if (_operation is null)
            {
                @if (_source?.Identity.Kind == SourceIdentityKind.FishMeatVendorRegistration && Correction is null && _discovery is not null && (_discovery.LinkedSources?.Count ?? 0) == 0)
                {
                    @NpmLinkContent
                }
                @foreach (var section in PickerSections)
                {
                    <div class="sheet-group">@section.Name</div>
                    @foreach (var row in section.Items)
                    {
                        <button class="collection-option" type="button" @onclick="() => Choose(row.OperationCode!)"><span class="option-text"><strong>@OperationLabel(row)</strong>@if (OperationDetail(row) is { } detail) { <small>@detail</small> }</span> <span aria-hidden="true">›</span></button>
                    }
                }
                @if (!PickerSections.Any()) { <div class="sheet-note">@(Offered.Count > 0 ? "Everything available for this source is already in this collection." : "Nothing available for this source.")</div> }
            }
            else
            {
                @if (_operation.OperationCode == CollectorOperationCodes.Terminal)
                {
                    @* The three official sections are the only top-level choices; a vehicle class is an optional aid inside its own section. *@
                    <div class="term-label" id="term-section-label">Section</div>
                    <div class="term-sections" role="radiogroup" aria-labelledby="term-section-label">
                        @foreach (var section in SectionChoices)
                        {
                            var chosen = section.Identity.TerminalSection == _termSection;
                            <button type="button" role="radio" aria-checked="@(chosen ? "true" : "false")" class="term-section @(chosen ? "selected" : "")" @onclick="() => PickSection(section)">
                                <span class="term-name">@section.DisplayName</span>
                                @if (chosen) { <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5 13 10 18 19 7" /></svg> }
                            </button>
                        }
                    </div>
                    @if (_termSection is not null && VehicleChoices.Count > 0)
                    {
                        <div class="term-mode" role="group" aria-label="Collection mode">
                            <button type="button" class="@(_byVehicle ? "" : "on")" aria-pressed="@(_byVehicle ? "false" : "true")" @onclick="() => SetMode(false)">Section total</button>
                            <button type="button" class="@(_byVehicle ? "on" : "")" aria-pressed="@(_byVehicle ? "true" : "false")" @onclick="() => SetMode(true)">By vehicle type</button>
                        </div>
                    }
                    @if (_byVehicle)
                    {
                        <div class="term-label" id="term-vehicle-label">Vehicle type</div>
                        <div class="term-sections" role="listbox" aria-labelledby="term-vehicle-label">
                            @foreach (var vehicle in VehicleChoices)
                            {
                                var chosen = vehicle.SelectionKey == _choiceKey;
                                <button type="button" role="option" aria-selected="@(chosen ? "true" : "false")" class="term-section @(chosen ? "selected" : "")" @onclick="() => ChooseChoice(vehicle.SelectionKey)">
                                    <span class="term-name">@vehicle.DisplayName@if (vehicle.Rate is { } rate) { <small>@Money(rate)</small> }</span>
                                    @if (chosen) { <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5 13 10 18 19 7" /></svg> }
                                </button>
                            }
                        </div>
                        @if (_choice is { Rate: { } approved }) { <div class="sheet-meta"><span>Approved rate</span><strong>@Money(approved)</strong></div> }
                    }
                    @if (_choice?.Identity.VehicleClassId is not null)
                    {
                        @* A selected vehicle may carry optional frozen driver/payer evidence. *@
                        <label class="form-field"><span class="form-label">Name <span class="form-optional">optional</span></span><input class="form-input" type="text" maxlength="200" autocomplete="off" @bind="_snapshot" @bind:event="oninput" /></label>
                        @if (_items.Count > 0) { <div class="sheet-note">Shared by every item in this collection</div> }
                    }
                }
                else if (Choices.Count == 1)
                {
                    <div class="sheet-source"><strong>@Choices[0].DisplayName</strong>@if (!string.IsNullOrWhiteSpace(Choices[0].Context)) { <span>@Choices[0].Context</span> }</div>
                }
                else
                {
                    <MobileChoice Inline="true" Label="@ChoiceLabel" Options="ChoiceOptions" Value="@_choiceKey" ValueChanged="ChooseChoice" EmptyText="Nothing available for this source." />
                }
                @if (_choice is not null)
                {
                    @if (UtilityChoice is { } utility)
                    {
                        <RecentUtilityNotice StallId="utility.StallId" Utility="@utility.Code" Year="utility.Year" Month="utility.Month" Resolved="OnRecentResolved" />
                        @if (_confirmRepeat)
                        {
                            <StateNotice Tone="StateNotice.NoticeTone.Warning" Title="Record another payment?">
                                A previous @utility.Code collection exists for this source. Confirm that a separate payment was actually received.
                            </StateNotice>
                        }
                    }
                    @if (_choice.AmountRule == CollectionSessionAmountRule.FixedAmount && _choice.ServerAmount is { } fixedAmount)
                    { <div class="sheet-meta"><span>Amount</span><strong>@Money(fixedAmount)</strong></div> }
                    @if (IsWeighing)
                    {
                        <label class="form-field"><span class="form-label">Quantity · kg</span><input class="form-input" type="number" inputmode="decimal" min="0.01" step="0.01" @bind="_quantity" @bind:event="oninput" @bind:after="QuoteWeighingAsync" /></label>
                        @if (_choice.Rate is { } rate) { <div class="sheet-meta"><span>Approved rate</span><strong>@Money(rate) / kg</strong></div> }
                        <div class="sheet-meta"><span>Amount</span><strong>@(_serverAmount is { } computed ? Money(computed) : "Unavailable")</strong></div>
                    }
                    @if (_choice.Kind == CollectionSessionItemKind.Slaughter)
                    {
                        <label class="form-field"><span class="form-label">Heads</span><input class="form-input" type="number" inputmode="numeric" min="1" step="1" @bind="_heads" @bind:event="oninput" /></label>
                        @if (_source is null && string.IsNullOrWhiteSpace(_snapshot))
                        { <label class="form-field"><span class="form-label">Owner</span><input class="form-input" @bind="_owner" /></label> }
                        @if (_slhTerms is { Itemized: true })
                        {
                            <div class="form-label">Approved charges</div>
                            @if (SlhCharges.Count == 0) { <div class="sheet-note">No approved charge applies to this animal. Ask the office.</div> }
                            @foreach (var charge in SlhCharges)
                            {
                                <label class="form-field">
                                    <span class="form-label"><input type="checkbox" checked="@_slhPicked.ContainsKey(charge.Id)" @onchange="e => SlhToggle(charge, e.Value is true)" /> @charge.Name · @Money(charge.Amount ?? 0m) / @(SlhPerHead(charge) ? "head" : "unit")</span>
                                    @if (_slhPicked.ContainsKey(charge.Id) && !SlhPerHead(charge))
                                    { <input class="form-input" type="number" inputmode="numeric" min="1" max="100000" step="1" value="@_slhPicked[charge.Id]" @onchange="e => SlhQuantity(charge, e.Value?.ToString())" /> }
                                </label>
                            }
                        }
                        <div class="sheet-note">Approved amount confirmed on review</div>
                    }
                    @if (_choice.Kind == CollectionSessionItemKind.NpmWholePayment) { <div class="sheet-note">Remaining monthly rent is confirmed on review</div> }
                    @if (_choice.Kind == CollectionSessionItemKind.NpmDaily)
                    {
                        <label class="form-field"><span class="form-label">Official Receipt No. (Optional)</span><input class="form-input" type="text" maxlength="100" @bind="_npmReceipt" /></label>
                    }
                    @if (_choice.Kind == CollectionSessionItemKind.NpmPartPayment) { <div class="sheet-note">Applied to the oldest unpaid day first. The server shows how it is applied on review@(_choice.MaximumAmount is { } most ? $" · up to {Money(most)} is payable now" : "").</div> }
                    @if (TakesTypedAmount)
                    {
                        <label class="form-field"><span class="form-label">Amount received</span><input class="form-input" type="number" inputmode="decimal" min="0.01" step="0.01" max="@(_choice.MaximumAmount?.ToString(CultureInfo.InvariantCulture))" @bind="_amount" @bind:event="oninput" /></label>
                    }
                    <div class="sheet-meta"><span>Instrument</span><strong>@Instrument(_choice.Instrument)</strong></div>
                }
            }
            </div>
            <div class="sheet-actions">
                <button class="btn-cancel" type="button" @onclick="CancelPicker">@(_confirmRepeat ? "Cancel" : "Close")</button>
                @if (_operation is not null)
                {
                    <button class="btn-primary" type="button" disabled="@(!CanAddItem)" @onclick="AddItem">@(_confirmRepeat ? "Continue" : "Add item")</button>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public DateOnly BusinessDate { get; set; }
    [Parameter] public string? OnlyOperation { get; set; }

