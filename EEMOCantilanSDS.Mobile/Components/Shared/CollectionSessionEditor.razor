@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Application.Dtos.Revenue
@using EEMOCantilanSDS.Domain.Constants
@using EEMOCantilanSDS.Domain.Entities.Revenue
@using EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Mobile.Models
@inject IMobileApiClient Api
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync

@* New Collection is source-native: the collector finds the real source (an occupant, a space holder, a registered vendor), the server says what
   that source can be collected for, and only those items are offered. With no source the collector can continue as a direct collection, which
   offers only the walk-up operations the server approves. Nothing here matches names, calculates an amount or invents eligibility. *@
@if (_loading)
{
    <LoadingState Text="Loading collection sources…" />
}
else if (_queued)
{
    <section class="collection-entry" aria-live="polite">
        <h2 class="done-title">@(_result?.Status == CollectionSessionStatus.Recorded ? "Collection recorded" : _needsReview ? "Needs review" : "Waiting to sync")</h2>
        @if (_result?.Status == CollectionSessionStatus.Recorded)
        {
            <div class="done-total"><strong>@Money(_result.GrandTotal)</strong><span>@_result.Collections.Count @(_result.Collections.Count == 1 ? "collection record" : "collection records")</span></div>
            @foreach (var collection in _result.Collections)
            {
                <div class="item-row">
                    <div class="item-main"><strong class="item-name">@CollectionName(collection)</strong><span class="item-context">@collection.ReferenceCode</span></div>
                    <div class="item-amount"><strong>@Money(collection.Amount)</strong><span>@InstrumentCode(collection.Instrument)</span></div>
                </div>
            }
            <button class="collection-primary done-action" type="button" @onclick="StartAnotherAsync">New Collection</button>
        }
        else
        {
            <p>@(_needsReview ? "Review the affected items." : "SRC references appear after synchronization.")</p>
            @if (_needsReview)
            { <button class="btn-primary" type="button" disabled="@_busy" @onclick="ReviewQueuedAsync">Review</button> }
            <button class="btn-cancel" type="button" @onclick="RefreshResultAsync">Refresh</button>
        }
    </section>
}
else
{
    <section class="collection-entry collection-payer">
        <h2>@(SourceHeading)</h2>
        @if (_source is not null)
        {
            <div class="payer-selected"><span class="payer-option-text"><strong class="payer-name">@_source.DisplayName</strong><small>@_source.Context</small></span><button class="collection-small" type="button" disabled="@(_items.Count > 0)" @onclick="ClearSourceAsync">Change</button></div>
        }
        else if (_direct)
        {
            @if (OnlyOperation != CollectorOperationCodes.Terminal)
            {
                <div class="payer-selected"><span class="payer-option-text"><strong class="payer-name">@(string.IsNullOrWhiteSpace(_snapshot) ? "Direct collection" : _snapshot.Trim())</strong><small>No linked source</small></span><button class="collection-small" type="button" disabled="@(_items.Count > 0)" @onclick="ClearSourceAsync">Change</button></div>
                <label class="form-field"><span class="form-label">Payer name</span>
                    <input class="form-input" type="text" autocomplete="off" maxlength="200" placeholder="As given by the payer" @bind="_snapshot" @bind:event="oninput" /></label>
            }
        }
        else
        {
            <div class="collection-search">
                <label class="form-field"><span class="form-label">@(SearchLabel)</span>
                    <input class="form-input" type="search" autocomplete="off" enterkeyhint="search" placeholder="Name"
                           @bind="_search" @bind:event="oninput" @bind:after="OnSearchChanged" @onfocus="OnSearchFocusAsync" @onkeydown="OnSearchKeyAsync" /></label>
                <button class="collection-small" type="button" disabled="@_searching" @onclick="SearchAsync">Search</button>
            </div>
            @if (_suggestOpen)
            {
                <div class="payer-panel" aria-label="Sources" aria-busy="@(_searching ? "true" : "false")">
                    @if (VisibleSources.Count > 0)
                    {
                        <div class="payer-list" role="list">
                            @foreach (var found in VisibleSources)
                            {
                                <button class="collection-option payer-option" type="button" role="listitem" @onclick="() => SelectSourceAsync(found)">
                                    <span class="payer-option-text"><strong>@found.DisplayName</strong><small>@found.Context</small></span>
                                    <span aria-hidden="true">›</span></button>
                            }
                        </div>
                        @if (_searching) { <div class="payer-status payer-status-inline" role="status">Searching…</div> }
                    }
                    else if (_searching) { <div class="payer-status" role="status">Searching…</div> }
                    else if (_searched) { <div class="payer-status" role="status">No match found.</div> }
                    @if (DirectAllowed && !_searching && _search.Trim().Length >= 2 && VisibleSources.Count == 0)
                    {
                        <button class="collection-option payer-option" type="button" @onclick="() => StartDirectAsync(_search)">
                            <span class="payer-option-text"><strong>Continue with payer name</strong><small>@_search.Trim()</small></span><span aria-hidden="true">›</span></button>
                    }
                </div>
            }
        }
    </section>
    @if (_source is not null || _direct)
    {
        <section class="collection-entry">
            <div class="collection-row"><h2>Items</h2><button class="collection-small" type="button" disabled="@_busy" @onclick="OpenPickerAsync">+ Add item</button></div>
            @if (_items.Count == 0)
            {
                <p>@(NothingDue ? "No linked collection is due for this source." : "No items added.")</p>
                @if (NothingDue && DirectAllowed)
                {
                    <button class="collection-small" type="button" @onclick="() => StartDirectAsync(_source!.DisplayName)">Continue as direct collection</button>
                }
            }
            @foreach (var item in _items)
            {
                var quote = _quote?.Items.FirstOrDefault(x => x.ClientItemId == item.ClientItemId);
                var problem = _quote?.Problems.Any(x => x.ClientItemId == item.ClientItemId) == true;
                var shown = _shown.GetValueOrDefault(item.ClientItemId);
                <div class="item-row @(problem ? "item-row-problem" : "")">
                    <div class="item-main">
                        <strong class="item-name">@(quote?.DisplayName ?? shown?.Name ?? "Collection item")</strong>
                        <span class="item-context">@(quote?.Context is { Length: > 0 } qc && !qc.Equals(quote.DisplayName, StringComparison.OrdinalIgnoreCase) ? qc : shown?.Context ?? "Confirmed on review")</span>
                        <span class="item-actions"><button class="collection-link" type="button" @onclick="() => Remove(item)">Remove</button></span>
                    </div>
                    <div class="item-amount">
                        <strong>@(quote is not null ? Money(quote.Amount) : item.ConfirmedAmount > 0 ? Money(item.ConfirmedAmount) : "Review")</strong>
                        @if (quote is not null) { <span>@InstrumentCode(quote.Instrument)</span> }
                    </div>
                </div>
            }
        </section>
        @if (_quote is not null)
        {
            <section class="collection-entry review-summary" aria-live="polite" aria-label="Collection total">
                @foreach (var total in _quote.InstrumentTotals)
                { <div class="review-row"><span>@Instrument(total.Instrument)</span><strong>@Money(total.Amount)</strong></div> }
                <div class="review-row review-total"><span>Total</span><strong>@Money(_quote.GrandTotal)</strong></div>
                @foreach (var problem in _quote.Problems)
                { <p class="review-problem" role="alert"><strong>Needs review</strong>@ProblemName(problem)@problem.Message</p> }
            </section>
        }
        <div class="collection-actions">
            <button class="collection-secondary" type="button" disabled="@(_busy || _items.Count == 0)" @onclick="ReviewAsync">Review collection</button>
            <button class="collection-primary" type="button" disabled="@(_busy || _quote?.CanRecord != true || Sync.HasStorageFault)" @onclick="RecordAsync">Record collection</button>
        </div>
    }
}
@if (!string.IsNullOrWhiteSpace(_message)) { <p class="collection-message" role="status">@_message</p> }

@if (_picker)
{
    <div class="sheet-overlay" @onclick="ClosePicker">
        <section class="sheet sheet-flex" role="dialog" aria-modal="true" aria-label="Add item" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <header class="sheet-head">
                <h2 class="sheet-title">Add item</h2>
                <div class="sheet-context">@(_operation is null ? SourceName : _operation.DisplayName + (SourceName is { Length: > 0 } ? " · " + SourceName : ""))</div>
            </header>
            <div class="sheet-body">
            @if (_operation is null)
            {
                @foreach (var section in PickerSections)
                {
                    <div class="sheet-group">@section.Name</div>
                    @foreach (var row in section.Items)
                    {
                        <button class="collection-option" type="button" @onclick="() => Choose(row.OperationCode!)">@row.DisplayName <span aria-hidden="true">›</span></button>
                    }
                }
                @if (!PickerSections.Any()) { <div class="sheet-note">Nothing available for this source.</div> }
            }
            else
            {
                @if (Choices.Count == 1)
                {
                    <div class="sheet-source"><strong>@Choices[0].DisplayName</strong>@if (!string.IsNullOrWhiteSpace(Choices[0].Context)) { <span>@Choices[0].Context</span> }</div>
                }
                else
                {
                    <MobileChoice Inline="true" Label="@ChoiceLabel" Options="ChoiceOptions" Value="@_choiceKey" ValueChanged="ChooseChoice" EmptyText="Nothing available for this source." />
                }
                @if (_choice is not null)
                {
                    @if (_choice.AmountRule == CollectionSessionAmountRule.FixedAmount && _choice.ServerAmount is { } fixedAmount)
                    { <div class="sheet-meta"><span>Amount</span><strong>@Money(fixedAmount)</strong></div> }
                    @if (IsWeighing)
                    {
                        <label class="form-field"><span class="form-label">Quantity · kg</span><input class="form-input" type="number" inputmode="decimal" min="0.01" step="0.01" @bind="_quantity" @bind:event="oninput" @bind:after="QuoteWeighingAsync" /></label>
                        @if (_choice.Rate is { } rate) { <div class="sheet-meta"><span>Approved rate</span><strong>@Money(rate) / kg</strong></div> }
                        <div class="sheet-meta"><span>Amount</span><strong>@(_serverAmount is { } computed ? Money(computed) : "Unavailable")</strong></div>
                    }
                    @if (_choice.Kind == CollectionSessionItemKind.Slaughter)
                    {
                        <label class="form-field"><span class="form-label">Heads</span><input class="form-input" type="number" inputmode="numeric" min="1" step="1" @bind="_heads" @bind:event="oninput" /></label>
                        @if (_source is null && string.IsNullOrWhiteSpace(_snapshot))
                        { <label class="form-field"><span class="form-label">Owner</span><input class="form-input" @bind="_owner" /></label> }
                        <div class="sheet-note">Approved amount confirmed on review</div>
                    }
                    @if (_choice.Kind == CollectionSessionItemKind.NpmWholePayment) { <div class="sheet-note">Remaining monthly rent is confirmed on review</div> }
                    @if (TakesTypedAmount)
                    {
                        <label class="form-field"><span class="form-label">Amount received</span><input class="form-input" type="number" inputmode="decimal" min="0.01" step="0.01" max="@(_choice.MaximumAmount?.ToString(CultureInfo.InvariantCulture))" @bind="_amount" @bind:event="oninput" /></label>
                    }
                    @if (IsTerminal)
                    {
                        <label class="form-field"><span class="form-label">Cash Ticket count <span class="form-optional">optional</span></span><input class="form-input" type="number" inputmode="numeric" min="0" step="1" @bind="_tickets" @bind:event="oninput" /></label>
                    }
                    <div class="sheet-meta"><span>Instrument</span><strong>@Instrument(_choice.Instrument)</strong></div>
                }
            }
            </div>
            <div class="sheet-actions">
                <button class="btn-cancel" type="button" @onclick="ClosePicker">Close</button>
                @if (_operation is not null)
                {
                    <button class="btn-primary" type="button" disabled="@(!CanAddItem)" @onclick="AddItem">Add item</button>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public DateOnly BusinessDate { get; set; }
    [Parameter] public string? OnlyOperation { get; set; }
    [Parameter] public Guid? ResumeSessionId { get; set; }

    private sealed record Shown(string Name, string Context);

    private CollectionSessionDiscovery? _discovery;
    private CollectionSessionCapability? _operation;
    private CollectionSessionSourceChoice? _choice;
    private CollectionSourceSearchResult? _source;
    private IReadOnlyList<CollectionSourceSearchResult> _found = [];
    private readonly List<CollectionSessionItemIntent> _items = [];
    private readonly Dictionary<Guid, Shown> _shown = [];
    private CollectionSessionQuote? _quote;
    private CollectionSessionResult? _result;
    private Guid _sessionId = Guid.NewGuid();
    private Guid? _supersededSessionId;
    private bool _loading = true, _busy, _picker, _queued, _needsReview, _direct;
    private string _search = "", _snapshot = "", _choiceKey = "", _owner = "";
    private decimal _amount, _quantity;
    private decimal? _serverAmount;
    private int _heads = 1, _tickets;
    private string? _message;

    private CollectionSessionIntent Intent => new(_sessionId, BusinessDate, null, _items.ToArray(),
        SourceIdentity: _source?.Identity, PayerSnapshot: _direct && !string.IsNullOrWhiteSpace(_snapshot) ? _snapshot.Trim() : null);

    // What kind of finder this page is: a registered vendor only, an occupant only, or any source.
    private bool VendorOnly => OnlyOperation is CollectorOperationCodes.WeightAndMeasure;
    private bool DirectAllowed => !VendorOnly && OnlyOperation != CollectorOperationCodes.Wcf;
    private string SourceHeading => OnlyOperation == CollectorOperationCodes.Terminal ? "Income From Terminal" : "Source";
    private string SearchLabel => VendorOnly ? "Search registered vendor" : OnlyOperation == CollectorOperationCodes.FishMeatVendorFee ? "Search vendor or payer" : "Search payer or vendor";
    private IReadOnlyList<CollectionSourceSearchResult> VisibleSources => _found.Where(x => OnlyOperation switch
    {
        CollectorOperationCodes.WeightAndMeasure or CollectorOperationCodes.FishMeatVendorFee => x.Identity.Kind == SourceIdentityKind.FishMeatVendorRegistration,
        "ECF" => x.Identity.Kind == SourceIdentityKind.Occupancy,
        _ => true
    }).ToList();
    private string SourceName => _source?.DisplayName ?? (_direct && !string.IsNullOrWhiteSpace(_snapshot) ? _snapshot.Trim() : "");

    // A source with nothing collectible says so; the collector may then start a separate direct collection.
    private bool NothingDue => _source is not null && _discovery is not null && !_discovery.Operations.Any(x => x.CanAdd && (OnlyOperation is null || x.OperationCode == OnlyOperation));

    private IReadOnlyList<CollectionSessionCapability> Offered => (_discovery?.Operations ?? [])
        .Where(x => x.Supported && x.CanAdd && (OnlyOperation is null || x.OperationCode == OnlyOperation)).ToList();

    private static string FamilyName(CollectionFamily? family) => family switch
    {
        CollectionFamily.Rent => "Rent Income (Stall Rental)",
        CollectionFamily.Space => "Space Rental",
        CollectionFamily.Terminal => "Income from Terminal",
        CollectionFamily.Slaughterhouse => "Income from Slaughterhouse",
        _ => "Income from Market"
    };

    // Display groups only: what is offered at all is the server's answer; the family is just where its row sits.
    private IReadOnlyList<(string Name, IReadOnlyList<CollectionSessionCapability> Items)> PickerSections =>
        Offered.GroupBy(x => x.Family ?? CollectionFamily.Market).OrderBy(g => (int)g.Key)
            .Select(g => (FamilyName(g.Key), (IReadOnlyList<CollectionSessionCapability>)g.ToList())).ToList();

    private IReadOnlyList<CollectionSessionSourceChoice> Choices => _operation?.Choices ?? [];
    private string ChoiceLabel => _operation?.OperationCode switch
    {
        CollectorOperationCodes.Terminal => "Section",
        _ => "Source"
    };
    private IReadOnlyList<MobileChoice.Choice> ChoiceOptions => Choices.Select(x => new MobileChoice.Choice(x.SelectionKey, x.DisplayName,
        string.IsNullOrWhiteSpace(x.Context) ? (x.ServerAmount is { } amount ? Money(amount) : null) : x.Context)).ToArray();
    private bool IsWeighing => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.WeightAndMeasure };
    private bool IsTerminal => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.Terminal };
    private bool TakesTypedAmount => _choice is { } c && !IsWeighing && c.Kind is not (CollectionSessionItemKind.Slaughter or CollectionSessionItemKind.NpmWholePayment)
        && c.AmountRule is CollectionSessionAmountRule.DirectAmount or CollectionSessionAmountRule.PreparedBalance;
    private bool NeedsPayerName => _choice is { Kind: CollectionSessionItemKind.SourceNative, OperationCode: CollectorOperationCodes.FishMeatVendorFee } c
        && c.Identity.VendorRegistrationId is null;

    private bool CanAddItem => _choice is { } c && (IsWeighing ? _quantity > 0 && _serverAmount is > 0m
        : c.Kind == CollectionSessionItemKind.Slaughter ? _heads > 0 && (_source is not null || !string.IsNullOrWhiteSpace(_snapshot) || !string.IsNullOrWhiteSpace(_owner))
        : c.Kind == CollectionSessionItemKind.NpmWholePayment ? true
        : (c.AmountRule == CollectionSessionAmountRule.FixedAmount ? c.ServerAmount ?? 0m : _amount) > 0m)
        && (!NeedsPayerName || !string.IsNullOrWhiteSpace(_snapshot));

    protected override async Task OnInitializedAsync()
    {
        if (ResumeSessionId is { } id && (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == id)?.CollectionSession?.Intent is { } saved)
        {
            _sessionId = id; BusinessDate = saved.BusinessDate; _items.AddRange(saved.Items);
            if (saved.SourceIdentity is { } identity) _source = new(identity, "Selected source", "", OnlyOperation ?? "");
            else { _direct = true; _snapshot = saved.PayerSnapshot ?? ""; }
            _queued = true; await RefreshResultAsync();
        }
        else if (OnlyOperation == CollectorOperationCodes.Terminal) { _direct = true; await LoadAsync(); }
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _discovery = null;
        if (_source is null && !_direct) return;
        try
        {
            var response = await Api.GetSourceCollectionDiscoveryAsync(_source?.Identity);
            _discovery = response.Value;
            if (!response.IsSuccess) _message = "Collection sources are unavailable.";
        }
        catch { _message = "Connection required to review."; }
    }

    // ── Finding the source ─────────────────────────────────────────────────────────────────────────
    // Tapping the field opens a bounded list of what the server returns, about five rows then scrolling; typing searches after a short pause.
    private CancellationTokenSource? _searchDelay;
    private bool _searching, _searched, _suggestOpen, _browsed;

    private async Task OnSearchFocusAsync()
    {
        _suggestOpen = true;
        if (_browsed || _searched || _found.Count > 0) return;
        _browsed = true;
        await RunSearchAsync(_search, announceFailure: false);
    }

    private void OnSearchChanged()
    {
        _searchDelay?.Cancel();
        _suggestOpen = true;
        _searchDelay = new CancellationTokenSource();
        _ = DebouncedSearchAsync(_searchDelay.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken token)
    {
        try { await Task.Delay(300, token); } catch (OperationCanceledException) { return; }
        await InvokeAsync(() => RunSearchAsync(_search, announceFailure: true));
    }

    private async Task OnSearchKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter") return;
        _searchDelay?.Cancel();
        await SearchAsync();
    }

    private async Task SearchAsync() { _searchDelay?.Cancel(); _suggestOpen = true; await RunSearchAsync(_search, announceFailure: true); }

    private async Task RunSearchAsync(string term, bool announceFailure)
    {
        if (_source is not null || _direct) return;
        _searching = true;
        StateHasChanged();     // the debounced path has no event handler to re-render for it
        try
        {
            var response = await Api.SearchCollectionSourcesAsync(term);
            if (_source is not null || _direct || term != _search) return;     // a newer search or a chosen source supersedes this answer
            _found = response?.Value ?? [];
            _searched = response is { IsSuccess: true };
            if (response is { IsSuccess: false } && announceFailure) _message = "Search is unavailable.";
        }
        catch { if (announceFailure) _message = "Connect to search."; }
        finally { _searching = false; StateHasChanged(); }
    }

    private async Task SelectSourceAsync(CollectionSourceSearchResult found)
    {
        _source = found; _found = []; _suggestOpen = false; _searched = false; _quote = null; _direct = false;
        await LoadAsync();
    }

    // A direct collection has no Source Identity; the typed name is only the payer's name on the receipt.
    private async Task StartDirectAsync(string name)
    {
        _source = null; _direct = true; _snapshot = name.Trim(); _found = []; _suggestOpen = false; _searched = false; _quote = null;
        await LoadAsync();
    }

    private async Task ClearSourceAsync()
    {
        _source = null; _direct = false; _snapshot = ""; _quote = null; _search = ""; _found = []; _searched = false; _browsed = false; _suggestOpen = false;
        _discovery = null; _message = null;
        await Task.CompletedTask;
    }

    // ── Adding an item ──────────────────────────────────────────────────────────────────────────────
    private async Task OpenPickerAsync()
    {
        _message = null; await LoadAsync(); _operation = null; _choice = null; _choiceKey = "";
        if (OnlyOperation is not null && Offered.FirstOrDefault(x => x.OperationCode == OnlyOperation) is not null) Choose(OnlyOperation);
        // Never open a sheet with nothing to choose: say why, in the page, where the collector is looking.
        if (_operation is null && !PickerSections.Any())
        {
            _message ??= "Nothing available for this source.";
            return;
        }
        _picker = true;
    }

    private void Choose(string code)
    {
        _operation = Offered.FirstOrDefault(x => x.OperationCode == code);
        _choice = null; _choiceKey = ""; _amount = _quantity = 0; _serverAmount = null; _tickets = 0; _heads = 1; _owner = "";
        if (_operation?.Choices is { Count: 1 } only) ChooseChoice(only[0].SelectionKey);
    }

    private void ChooseChoice(string key)
    {
        _choiceKey = key;
        _choice = Choices.FirstOrDefault(x => x.SelectionKey == key);
        _amount = _choice is { AmountRule: CollectionSessionAmountRule.PreparedBalance, ServerAmount: { } balance } ? balance : 0m;
        _quantity = 0; _serverAmount = null;
    }

    // The amount of a weighing is the server's: kilograms are quoted there, never multiplied here.
    private async Task QuoteWeighingAsync()
    {
        _serverAmount = null;
        if (!IsWeighing || _choice is null || _quantity <= 0m) return;
        try
        {
            var charge = new SourceNativeChargeIntent(_choice.OperationCode, _choice.Identity.VendorRegistrationId, Kilograms: _quantity);
            var quote = await Api.QuoteOfficeCollectionAsync(new SourceNativeCollectionRequest(Guid.NewGuid(), BusinessDate, 1m, charge));
            _serverAmount = quote.IsSuccess ? quote.Value?.Amount : null;
        }
        catch { _serverAmount = null; }
    }

    private void ClosePicker() => _picker = false;

    private void AddItem()
    {
        if (!CanAddItem || _choice is not { } c) return;
        var id = Guid.NewGuid(); var identity = c.Identity;
        SessionWaterIntent? water = null; SessionElectricityIntent? electricity = null; SessionObligationIntent? obligation = null;
        SessionGovernedIntent? service = null; SessionSlaughterIntent? slaughter = null; SessionNpmWholeIntent? npmWhole = null;
        SourceNativeChargeIntent? native = null; SessionMonthlyRentIntent? rent = null;
        var year = identity.Year ?? identity.PeriodStart?.Year ?? BusinessDate.Year;
        var month = identity.Month ?? identity.PeriodStart?.Month ?? BusinessDate.Month;
        switch (c.Kind)
        {
            case CollectionSessionItemKind.Water: water = new(identity.StallId!.Value, year, month, identity.UtilityBillId, identity.SourceVersion); break;
            case CollectionSessionItemKind.Electricity: electricity = new(identity.UtilityBillId!.Value, identity.SourceVersion, identity.StallId, year, month); break;
            case CollectionSessionItemKind.Obligation: obligation = new(identity.AccountId!.Value, year, month); break;
            case CollectionSessionItemKind.NpmWholePayment: npmWhole = new(identity.StallId!.Value, year, month); break;
            case CollectionSessionItemKind.MonthlyRent: rent = new(identity.StallId!.Value, year, month, identity.SourceVersion); break;
            case CollectionSessionItemKind.GovernedService: service = new(c.OperationCode, identity.Mode, identity.FeeOptionId, identity.VehicleClassCode); break;
            case CollectionSessionItemKind.Slaughter:
                slaughter = new(identity.Animal!.Value, _heads, identity.CustomAnimalName, _source is null && string.IsNullOrWhiteSpace(_snapshot) ? _owner.Trim() : null); break;
            case CollectionSessionItemKind.SourceNative:
                native = new(c.OperationCode, identity.VendorRegistrationId, identity.TerminalSection, identity.VehicleClassId,
                    IsTerminal && _tickets > 0 ? _tickets : null, IsWeighing ? _quantity : null); break;
        }
        var amount = c.Kind is CollectionSessionItemKind.Slaughter or CollectionSessionItemKind.NpmWholePayment ? 0m
            : IsWeighing ? _serverAmount ?? 0m
            : c.AmountRule == CollectionSessionAmountRule.FixedAmount ? c.ServerAmount ?? 0m : _amount;
        _items.Add(new CollectionSessionItemIntent(id, c.Kind, amount, water, service, obligation, electricity, null, slaughter, null, npmWhole, native, rent));
        _shown[id] = new(c.DisplayName, string.Join(" · ", new[] { SourceName, c.Context }.Where(x => !string.IsNullOrWhiteSpace(x))));
        _quote = null; _picker = false;
    }

    private void Remove(CollectionSessionItemIntent item) { _items.Remove(item); _shown.Remove(item.ClientItemId); _quote = null; }

    // ── Review, record, result ──────────────────────────────────────────────────────────────────────
    private async Task ReviewAsync()
    {
        _busy = true; _message = null;
        try { var response = await Api.QuoteCollectionSessionAsync(Intent); _quote = response.Value; if (!response.IsSuccess) _message = "Collection review is unavailable."; }
        catch { _message = "Connection required to review."; }
        finally { _busy = false; }
    }

    private async Task RecordAsync()
    {
        if (_quote?.CanRecord != true || _busy) return;
        _busy = true;
        try
        {
            await Sync.EnqueueCollectionSessionAsync(new(Intent, _quote.QuoteFingerprint), _quote.GrandTotal);
            if (_supersededSessionId is { } old) { await Sync.DiscardAsync(old); _supersededSessionId = null; }
            _queued = true;
            if (Sync.IsOnline) await Sync.SyncNowAsync(force: true);
            await RefreshResultAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException) { _message = "The collection could not be safely saved. Check device storage."; }
        finally { _busy = false; }
    }

    private async Task RefreshResultAsync()
    {
        var pending = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == _sessionId);
        _result = pending?.CollectionSessionResult; _needsReview = pending?.LocalStatus == PendingLocalStatus.ReconciliationRequired;
        if (_result is null && Sync.IsOnline)
            try { _result = (await Api.GetCollectionSessionAsync(_sessionId)).Value; } catch { }
    }

    private async Task ReviewQueuedAsync()
    {
        if (!Sync.IsOnline) { _message = "Connection required to review."; return; }
        _busy = true;
        try
        {
            // Reconcile unknown responses before offering any correction. Posted money is immutable.
            var current = await Api.GetCollectionSessionAsync(_sessionId);
            if (current.Value?.Status == CollectionSessionStatus.Recorded) { _result = current.Value; return; }
            var pending = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == _sessionId);
            if (current.StatusCode != 404 || pending is null || !EEMOCantilanSDS.Mobile.Services.MobileSyncService.CanReviewUnpostedSession(pending))
            { _message = "This collection needs office review."; return; }
            _supersededSessionId = _sessionId; _sessionId = Guid.NewGuid();
            _queued = _needsReview = false; _result = null; _quote = null; await LoadAsync();
        }
        catch { _message = "Connection required to review."; }
        finally { _busy = false; }
    }

    private async Task StartAnotherAsync()
    {
        _sessionId = Guid.NewGuid(); _items.Clear(); _shown.Clear(); _result = null; _quote = null; _queued = _needsReview = false;
        _source = null; _snapshot = ""; _search = ""; _found = []; _searched = _browsed = _suggestOpen = false; _discovery = null;
        _direct = OnlyOperation == CollectorOperationCodes.Terminal;
        await LoadAsync();
    }

    private string ProblemName(CollectionSessionProblem problem) => problem.ClientItemId is { } id && _shown.TryGetValue(id, out var shown) ? shown.Name + ": " : "";
    private string CollectionName(CollectionSessionCollection collection) => string.Join(", ", collection.ClientItemIds.Select(id => _shown.GetValueOrDefault(id)?.Name).Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string InstrumentCode(RevenueInstrumentType instrument) => instrument == RevenueInstrumentType.CashTicket ? "CT" : "OR";
    private static string Instrument(RevenueInstrumentType instrument) => instrument == RevenueInstrumentType.CashTicket ? "CT · Cash Ticket" : "OR · Official Receipt";
    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
