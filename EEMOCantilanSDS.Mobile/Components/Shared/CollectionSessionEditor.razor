    // Slaughterhouse on approved charges: the collector selects charges (and counts per-unit ones); the server prices them on review.
    private SlaughterTermsDto? _slhTerms;
    private readonly Dictionary<Guid, int> _slhPicked = [];
    private static bool SlhPerHead(FeeOptionTermDto c) => (c.QuantityBasis ?? FeeQuantityBasis.PerHead) == FeeQuantityBasis.PerHead;
    private IReadOnlyList<FeeOptionTermDto> SlhCharges => _slhTerms is null || _choice?.Identity.Animal is not { } animal ? []
        : _slhTerms.Charges.Where(c => c.Amount is > 0 && SlaughterAnimalScopes.Includes(c.ApplicableAnimals, animal)).ToList();
    private void SlhToggle(FeeOptionTermDto c, bool on) { if (on) _slhPicked[c.Id] = 1; else _slhPicked.Remove(c.Id); }
    private void SlhQuantity(FeeOptionTermDto c, string? raw) => _slhPicked[c.Id] = int.TryParse(raw, out var n) ? Math.Clamp(n, 1, 100_000) : 1;
    private IReadOnlyList<SlaughterChargeSelectionDto>? SlhSelected() => _slhTerms is not { Itemized: true } ? null
        : SlhCharges.Where(c => _slhPicked.ContainsKey(c.Id)).Select(c => new SlaughterChargeSelectionDto(c.Id, SlhPerHead(c) ? _heads : _slhPicked[c.Id])).ToList();
    private async Task LoadSlhTermsAsync()
    {
        _slhTerms = null;
        try { var r = await Api.GetSlaughterTermsAsync(BusinessDate); _slhTerms = r.IsSuccess ? r.Value : null; }
        catch { _slhTerms = null; }
        if (_slhPicked.Count == 0 && _slhTerms is { Itemized: true } && _choice?.Identity.Animal != AnimalType.Other)
            foreach (var c in SlhCharges.Where(SlhPerHead)) _slhPicked[c.Id] = 1;
        await InvokeAsync(StateHasChanged);
    }
