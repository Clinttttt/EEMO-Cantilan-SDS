    [Parameter] public IReadOnlyCollection<string>? AlsoOperations { get; set; }
    [Parameter] public Guid? ResumeSessionId { get; set; }

    /// <summary>The collection being corrected. The form opens on its recorded source and facts; the server reverses the original and posts one replacement
