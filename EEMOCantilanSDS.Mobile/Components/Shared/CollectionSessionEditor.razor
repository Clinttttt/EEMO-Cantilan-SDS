    [Parameter] public MobileRecentCollection? Correction { get; set; }

    private bool _linkedNpmContext;
    // A registered vendor the office has linked to an NPM stall is collected with that stall's own rent and utilities in one list: the server lists them
    // under the vendor's source, so the page's single-operation filter stands aside for them.
    private bool VendorHasLinkedStall => _source?.Identity.Kind == SourceIdentityKind.FishMeatVendorRegistration && (_discovery?.LinkedSources?.Count ?? 0) > 0;
    private RenderFragment NpmLinkContent => @<div>
        @if (_discovery?.NpmLinkStatus == LinkedNpmStatus.NotLinked)
        {
            <NpmRegistrationRequestForm VendorId="_source!.Identity.Id" />
        }
        else
        {
            <p role="status">@(_discovery?.NpmLinkStatus switch {
                LinkedNpmStatus.NotAuthorized => "NPM collection is not assigned to your account. Ask the office to review your facility access.",
                LinkedNpmStatus.AwaitingVerification => "NPM registration is awaiting office verification.",
                LinkedNpmStatus.Withdrawn => "The previous NPM link was withdrawn. Ask the office to verify the current occupancy.",
                LinkedNpmStatus.NotEligibleForDate => "No linked NPM occupancy is eligible for this collection date. Ask the office to review it.",
                _ => "NPM link status is unavailable. Refresh before requesting registration."
            })</p>
        }
    </div>;
    private bool Allows(string? code) => _linkedNpmContext || OnlyOperation is null || code == OnlyOperation || (AlsoOperations?.Contains(code ?? "") ?? false) || VendorHasLinkedStall;

