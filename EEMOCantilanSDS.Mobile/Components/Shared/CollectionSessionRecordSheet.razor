@using System.Globalization
@using EEMOCantilanSDS.Mobile.Records
@using EEMOCantilanSDS.Domain.Enums

<div class="sheet-overlay" @onclick="OnClose">
    <section class="sheet sheet-flex session-record-sheet" role="dialog" aria-modal="true"
             aria-label="Session collection details" @onclick:stopPropagation="true">
        <div class="sheet-handle"></div>
        <header class="sheet-head">
            <div class="sheet-title">@(Records.FirstOrDefault()?.PayorName ?? "Collection session")</div>
            <div class="sheet-context">@Records.Count separate collections · One checkout</div>
            <div class="session-total">
                <span>Total net collected</span>
                <strong>@Money(Records.Sum(r => r.Total))</strong>
            </div>
            @if (Records.Count > 0)
            {
                <div class="session-date">Business date · @Records[0].BusinessDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</div>
            }
        </header>
        <div class="sheet-body" role="region" aria-label="Individual collections">
            @foreach (var (record, index) in Records.Select((item, i) => (item, i)))
            {
                <section class="session-item" aria-label="@($"Collection {index + 1}")">
                    <div class="session-item-header">
                        <div class="session-item-heading">
                            <span class="session-counter">Collection @(index + 1)</span>
                            <strong>@string.Join(", ", record.Lines.Select(x => CollectorRecordLabels.Display(x.ClassificationName)).Distinct())</strong>
                        </div>
                        <strong class="session-amount">@Money(record.Total)</strong>
                    </div>
                    <div class="session-identity">
                        <span>StallTrack reference</span>
                        <strong>@record.ReferenceCode</strong>
                    </div>
                    @foreach (var line in record.Lines)
                    {
                        <div class="session-line">
                            <span>@CollectorRecordLabels.Display(line.ItemLabel ?? line.ClassificationName)</span>
                            <strong>@Money(line.Amount)</strong>
                        </div>
                    }
                    <div class="session-evidence">
                        <div><span>Instrument</span><strong>@(CollectorRecordLabels.InstrumentCode(record.Instrument) ?? "Not specified")</strong></div>
                        <div><span>Receipt</span><strong>@(string.IsNullOrWhiteSpace(record.DocumentNumber) ? "None recorded" : record.DocumentNumber)</strong></div>
                        <div><span>Status</span><strong>@record.Status</strong></div>
                    </div>
                </section>
            }
        </div>
        <footer class="sheet-actions">
            <button type="button" class="btn-primary session-close" @onclick="OnClose">Close</button>
        </footer>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OperationRecord> Records { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
