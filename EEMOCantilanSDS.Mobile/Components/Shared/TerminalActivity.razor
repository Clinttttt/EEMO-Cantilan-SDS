@using System.Globalization
@using EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using EEMOCantilanSDS.Application.Common.Revenue
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Domain.Constants
@inject IMobileApiClient Api

@* Today's Terminal collections for this collector: the server's canonical activity, shown as it was recorded. Only facts that exist are
   shown (a ticket count, a vehicle type), nothing is inferred. A posted Collection is never edited or deleted from here: a correction is
   the office's, so the original Collection and its SRC always stay on record. *@
<section class="ta" aria-label="Today's Terminal collections">
    <h2 class="ta-title">Today's Terminal collections</h2>
    @if (_loading)
    {
        <p class="ta-note" role="status">Loading…</p>
    }
    else if (_error)
    {
        <p class="ta-note" role="status">Today's collections are unavailable offline.</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="ta-note">No Terminal collection recorded today.</p>
    }
    else
    {
        <div class="ta-list" role="list">
            @foreach (var row in _rows)
            {
                <button type="button" class="ta-row" role="listitem" @onclick="() => _open = row">
                    <span class="ta-main">
                        <strong class="ta-name">@Name(row)</strong>
                        <small>@Detail(row)</small>
                        <small class="ta-src">@row.SRC</small>
                    </span>
                    <span class="ta-amount @(row.State == "Reversed" ? "ta-reversed" : "")">
                        <strong>@Money(row.NetAmount)</strong>
                        @if (row.State == "Reversed") { <small>Corrected</small> }
                    </span>
                </button>
            }
        </div>
    }
</section>

@if (_open is { } shown)
{
    <div class="sheet-overlay" @onclick="() => _open = null">
        <section class="sheet sheet-flex" role="dialog" aria-modal="true" aria-label="Terminal collection" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <header class="sheet-head">
                <h2 class="sheet-title">@Name(shown)</h2>
                <div class="sheet-context">@shown.SRC</div>
            </header>
            <div class="sheet-body">
                <div class="sheet-meta"><span>Section</span><strong>@Name(shown)</strong></div>
                @if (!string.IsNullOrWhiteSpace(shown.VehicleClassName))
                {
                    <div class="sheet-meta"><span>Vehicle type</span><strong>@shown.VehicleClassName</strong></div>
                    @if (shown.Rate is { } rate) { <div class="sheet-meta"><span>Approved rate</span><strong>@Money(rate)</strong></div> }
                }
                <div class="sheet-meta"><span>Amount</span><strong>@Money(shown.Amount)</strong></div>
                @if (shown.State == "Reversed")
                { <div class="sheet-meta"><span>After correction</span><strong>@Money(shown.NetAmount)</strong></div> }
                <div class="sheet-meta"><span>Instrument</span><strong>CT · Cash Ticket</strong></div>
                @if (shown.CashTicketCount is > 0 and var count)
                { <div class="sheet-meta"><span>Cash Tickets</span><strong>@count.ToString(CultureInfo.InvariantCulture)</strong></div> }
                @if (!string.IsNullOrWhiteSpace(shown.CollectorName))
                { <div class="sheet-meta"><span>Collector</span><strong>@shown.CollectorName</strong></div> }
                <div class="sheet-meta"><span>Recorded</span><strong>@shown.RecordedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt", CultureInfo.InvariantCulture)</strong></div>
                <div class="ta-correct">
                    <strong>Correct collection</strong>
                    <p>@(shown.State == "Reversed"
                        ? "The office has corrected this collection. The original SRC and its history stay on record."
                        : "A recorded collection is never edited or deleted. If it is wrong, ask the office to correct it: the original SRC and its history stay on record.")</p>
                </div>
            </div>
            <div class="sheet-actions">
                <button class="btn-cancel" type="button" @onclick="() => _open = null">Close</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public DateOnly BusinessDate { get; set; }

    private IReadOnlyList<SourceNativeActivityDto> _rows = [];
    private SourceNativeActivityDto? _open;
    private bool _loading = true, _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Api.GetOfficeActivityAsync(BusinessDate, BusinessDate, CollectorOperationCodes.Terminal);
            if (response.IsSuccess) _rows = response.Value ?? []; else _error = true;
        }
        catch { _error = true; }
        finally { _loading = false; }
    }

    private static string Name(SourceNativeActivityDto row) => row.Section is { } section ? OfficeCollectionWorkflow.SectionName(section) : "Income From Terminal";

    private static string Detail(SourceNativeActivityDto row)
    {
        var parts = new List<string> { string.IsNullOrWhiteSpace(row.VehicleClassName) ? "Section total" : row.VehicleClassName };
        if (row.CashTicketCount is > 0 and var count) parts.Add(count + " CT");
        parts.Add(row.RecordedAtUtc.ToLocalTime().ToString("h:mm tt", CultureInfo.InvariantCulture));
        return string.Join(" · ", parts);
    }

    private static string Money(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
