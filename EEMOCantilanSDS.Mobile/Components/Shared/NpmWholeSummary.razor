@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Domain.Enums
<section class="whole-review" aria-label="Whole payment">
    <div class="whole-period-label">@(new DateOnly(Quote.Year, Quote.Month, 1).ToString("MMMM yyyy"))</div>
    <dl>
        @if (Quote.MonthlyObligation is { } obligation) { <div><dt>Monthly obligation</dt><dd>@Money(obligation)</dd></div> }
        @if (Quote.Collected is { } collected) { <div><dt>Collected</dt><dd>@Money(collected)</dd></div> }
        @if (Quote.Credits is > 0m) { <div><dt>Credits</dt><dd>@Money(Quote.Credits.Value)</dd></div> }
        <div class="whole-total"><dt>Remaining due</dt><dd>@Money(Quote.Amount)</dd></div>
    </dl>
    <div class="whole-instrument">@(Quote.Instrument == RevenueInstrumentType.CashTicket ? "CT · Cash Ticket" : "OR · Official Receipt")</div>
</section>
@code {
    [Parameter, EditorRequired] public NpmWholePaymentQuoteDto Quote { get; set; } = null!;
    private static string Money(decimal amount) => amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-PH"));
}
