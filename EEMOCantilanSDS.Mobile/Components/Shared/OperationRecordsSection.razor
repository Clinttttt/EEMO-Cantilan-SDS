@using System.Globalization
@using EEMOCantilanSDS.Mobile.Records
@using global::EEMOCantilanSDS.Domain.Enums
@inject global::EEMOCantilanSDS.Application.Common.Interface.ApiClients.IMobileApiClient Api

@* Canonical operation collections the server holds for this collector (Market Fees, Landing, Transportation, ...). The
   server is the authority: a collection appears here once, after it has synced, and the local queue is shown separately as
   Pending / Failed / Needs review, so a synced collection is never listed twice. *@
@if (_failed)
{
    <p class="ors-note" role="status">Operation collections could not be loaded. Showing what is saved on this device.</p>
}
else if (_records.Count > 0)
{
    <section class="ors" aria-labelledby="ors-title">
        <h2 id="ors-title" class="ors-title">Operation collections</h2>
        @* A mistake in today's own collection is corrected where the server decides who may: the recent-collections sheet (replacement under a new SRC or an
           audited reversal, never an in-place edit). It is offered only while the range includes today, and a closed window shows the server's reason. *@
        @if (IncludesToday)
        {
            <button type="button" class="ors-correct" aria-expanded="@(_correcting ? "true" : "false")" @onclick="() => _correcting = !_correcting">
                @(_correcting ? "Hide today's collections" : "Correct a collection recorded today")
            </button>
            @if (_correcting)
            {
                <div class="ors-today"><RecentCollections Heading="Today's collections" OnChanged="LoadAsync" /></div>
            }
        }
        <ul class="ors-list">
            @foreach (var record in VisibleRecords)
            {
                <li>
                    @* One clean row per SRC: what it was (the operation once, with the animal and the number of charges), and the itemized
                       charges only when the row is opened - never one repeated line per charge. *@
                    <CollectionRecordRow Identity="@(string.IsNullOrWhiteSpace(record.DocumentNumber) ? "None recorded" : Kind(record.Instrument) + " " + record.DocumentNumber)" Amount="record.Total"
                        DateText="@(record.BusinessDate.ToString("MMM d", CultureInfo.InvariantCulture) + (string.IsNullOrWhiteSpace(record.PayorName) ? "" : " · " + record.PayorName))"
                        Status="@(record.Status == "Posted" ? null : record.Status)"
                        OnOpen="@OpenFor(record)">
                        <Details>
                            <div class="ors-what">@Summary(record)</div>
                        </Details>
                    </CollectionRecordRow>
                </li>
            }
        </ul>
    </section>
}

@if (_selected is { } selected)
{
    <CanonicalRecordDetailSheet Record="selected" OnClose="CloseDetail" />
}

@code {
    [Parameter, EditorRequired] public DateOnly From { get; set; }
    [Parameter, EditorRequired] public DateOnly To { get; set; }
    [Parameter] public string? Search { get; set; }
    private IEnumerable<OperationRecord> VisibleRecords => string.IsNullOrWhiteSpace(Search) ? _records : _records.Where(x =>
        (x.ReferenceCode + " " + x.PayorName + " " + string.Join(" ", x.Lines.Select(l => l.ClassificationName + " " + l.SourceLabel)))
        .Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<OperationRecord> _records = Array.Empty<OperationRecord>();
    private OperationRecord? _selected;
    private EventCallback OpenFor(OperationRecord record) =>
        EventCallback.Factory.Create(this, () => _selected = record);
    private void CloseDetail() => _selected = null;

    // "Slaughterhouse · Carabao × 2 · 6 charges": the operation once, what it was for, and how many charges it itemizes.
    private static string Summary(OperationRecord record)
    {
        var parts = record.Lines.Select(l => CollectorRecordLabels.Display(l.ClassificationName)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();
        if (!string.IsNullOrWhiteSpace(record.Subject)) parts.Add(record.Subject!);
        if (record.Lines.Count > 1) parts.Add($"{record.Lines.Count} charges");
        return string.Join(" · ", parts);
    }
    private bool _failed, _correcting;
    private DateOnly _loadedFrom;
    private DateOnly _loadedTo;
    private bool IncludesToday => From <= EEMOCantilanSDS.Domain.Common.PhilippineTime.Today && To >= EEMOCantilanSDS.Domain.Common.PhilippineTime.Today;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFrom == From && _loadedTo == To) return;
        _loadedFrom = From;
        _loadedTo = To;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _failed = false;
        try
        {
            var result = await Api.GetMyCollectionsAsync(From, To);
            if (result.IsSuccess && result.Value is not null) _records = OperationRecordGrouping.Group(result.Value.Rows);
            else _failed = true;
        }
        catch { _failed = true; }
    }

    private static string Kind(RevenueInstrumentType? instrument) => instrument switch
    {
        RevenueInstrumentType.OfficialReceipt => "Official Receipt",
        RevenueInstrumentType.CashTicket => "Cash Ticket",
        _ => "Collection",
    };

    private static string Peso(decimal amount) => "₱" + amount.ToString("N2", CultureInfo.InvariantCulture);
}
