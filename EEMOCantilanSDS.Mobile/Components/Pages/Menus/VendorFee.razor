@page "/vendor-fee"
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session

<div class="page-shell">
    <div class="header">
        <div class="header-eyebrow">Operation</div>
        <div class="header-row">
            <button class="back-btn" type="button" @onclick='() => Navigation.NavigateTo("/menu")' aria-label="Back to menu"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg></button>
            <div class="header-title-block"><div class="header-title">Fish / Meat Vendor Fee</div><div class="header-sub">Vendor fee collection</div></div>
            <img class="header-logo" src="@Session.BrandingSeal" alt="Municipality seal" />
        </div>
    </div>
    <main class="content">
        @if (_ready) { <VendorFeeEntry BusinessDate="@(Session.Menu!.Today)" /> }
    </main>
    <BottomNav ActiveTab="menu" />
</div>

@code {
    private bool _ready;
    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.Menu is null) { Navigation.NavigateTo("/login"); return; }
        _ready = true;
    }
}
