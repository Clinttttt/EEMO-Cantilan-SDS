@page "/npm-requests"
@using EEMOCantilanSDS.Application.Common
@using EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Domain.Entities.Revenue
@inject EEMOCantilanSDS.Application.Common.Interface.ApiClients.IMobileApiClient Api
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session

<div class="page-shell">
    <AppHeader CollectorName="@Session.CollectorName" />
    <main class="content npm-history">
        <header class="npm-history-hero">
            <span class="npm-history-eyebrow">NPM · REGISTRATION</span>
            <h1>My NPM requests</h1>
            <p>Track stall registration reviews from the office.</p>
        </header>

        @if (_loading)
        {
            <section class="npm-history-state" role="status">
                <strong>Loading requests…</strong>
                <p>Checking your office review history.</p>
            </section>
        }
        else if (_error is not null)
        {
            <section class="npm-history-state npm-history-error" role="alert">
                <strong>Request history unavailable</strong>
                <p>@_error</p>
                <div class="npm-history-actions">
                    <button type="button" class="npm-history-retry" @onclick="Load" disabled="@_loading">Try again</button>
                </div>
            </section>
        }
        else if (_data is { Total: 0 })
        {
            <section class="npm-history-state">
                <strong>No requests yet</strong>
                <p>When you submit a registration request, its review status will appear here.</p>
            </section>
        }
        else if (_data is { } history)
        {
            <div class="npm-history-list-head">
                <span>@history.Total total</span>
            </div>
            <div class="npm-history-list">
                @foreach (var row in history.Rows)
                {
                    <article class="npm-history-card" @key="row.Id">
                        <div class="npm-history-card-top">
                            <strong>@row.VendorName</strong>
                            <span class="npm-history-status @StatusClass(row.Status)">@StatusText(row.Status)</span>
                        </div>
                        <div class="npm-history-meta">
                            @EEMOCantilanSDS.Domain.Common.PhilippineTime.ToPhilippineTime(row.SubmittedAtUtc).ToString("MMM d, yyyy · h:mm tt")
                        </div>
                        <div class="npm-history-stall">
                            <span>Proposed stall</span>
                            <strong>@row.ProposedStall</strong>
                            @if (row.ProposedSection is not null) { <span>· @SectionName(row.ProposedSection.Value)</span> }
                        </div>
                        @if (row.Status == NpmRegistrationRequestStatus.Returned)
                        {
                            <p class="npm-history-feedback">Returned for correction. Review the office note below.</p>
                        }
                        else if (row.Status == NpmRegistrationRequestStatus.Approved)
                        {
                            <p class="npm-history-feedback">Registration verified by the office. No payment recorded by this review.</p>
                        }
                        @if (row.Status == NpmRegistrationRequestStatus.Submitted)
                        {
                            <div class="npm-history-cancel-actions">
                                @if (_confirmCancel == row.Id)
                                {
                                    <p>Cancel this pending request? It will remain in your history, and no payment is affected.</p>
                                    @if (_cancelError is not null) { <p role="alert" class="npm-history-cancel-error">@_cancelError</p> }
                                    <div class="npm-history-cancel-buttons">
                                        <button type="button" class="npm-history-cancel-confirm" disabled="@_cancelling" @onclick="() => CancelRequest(row)">
                                            @(_cancelling ? "Cancelling…" : "Confirm cancellation")
                                        </button>
                                        <button type="button" disabled="@_cancelling" @onclick="ResetCancel">Keep request</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="npm-history-cancel-trigger" type="button" @onclick="() => AskCancel(row.Id)">Cancel request</button>
                                }
                            </div>
                        }
                        <details class="npm-history-details">
                            <summary>Request details</summary>
                            <dl>
                                <dt>Office reference</dt><dd>@row.Note</dd>
                                @if (!string.IsNullOrWhiteSpace(row.ReviewReason))
                                {
                                    <dt>Office response</dt><dd>@row.ReviewReason</dd>
                                }
                                <dt>Financial state</dt><dd>@row.FinancialState</dd>
                            </dl>
                        </details>
                        @if (row.Status == NpmRegistrationRequestStatus.Returned)
                        {
                            <details class="npm-history-correction">
                                <summary>Submit a corrected request</summary>
                                <NpmRegistrationRequestForm VendorId="row.VendorRegistrationId" ReplacesRequestId="row.Id" />
                            </details>
                        }
                    </article>
                }
            </div>
            @if (history.Total > history.PageSize)
            {
                <nav class="npm-history-paging" aria-label="Request pages">
                    <button type="button" disabled="@(_loading || _page <= 1)" @onclick="Previous">Previous</button>
                    <span>Page @_page of @Math.Max(1, (int)Math.Ceiling(history.Total / (double)history.PageSize))</span>
                    <button type="button" disabled="@(_loading || _page * history.PageSize >= history.Total)" @onclick="Next">Next</button>
                </nav>
            }
        }
    </main>
    <BottomNav ActiveTab="records" />
</div>

@code {
    private NpmRegistrationRequestPage? _data;
    private string? _error;
    private bool _loading;
    private int _page = 1;
    private Guid? _confirmCancel;
    private bool _cancelling;
    private string? _cancelError;
    private readonly Dictionary<Guid, Guid> _cancelOperations = new();

    private void AskCancel(Guid id) { _confirmCancel = id; _cancelError = null; }
    private void ResetCancel() { _confirmCancel = null; _cancelError = null; }
    private async Task CancelRequest(NpmRegistrationRequestDto row)
    {
        if (_cancelling || _confirmCancel != row.Id || row.Status != NpmRegistrationRequestStatus.Submitted) return;
        _cancelling = true;
        _cancelError = null;
        try
        {
            if (!_cancelOperations.TryGetValue(row.Id, out var operation))
                _cancelOperations[row.Id] = operation = Guid.NewGuid();
            var result = await Api.CancelNpmRequestAsync(row.Id, new(operation, row.Version));
            if (result.IsSuccess && result.Value is { Status: NpmRegistrationRequestStatus.Cancelled })
            {
                _cancelOperations.Remove(row.Id);
                ResetCancel();
                await Load();
            }
            else _cancelError = result.Error ?? "Could not cancel. Check the latest request status and try again.";
        }
        catch { _cancelError = "Cancellation could not be confirmed. Check your connection before retrying."; }
        finally { _cancelling = false; }
    }
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetNpmRequestsAsync(_page);
            if (result.IsSuccess && result.Value is not null)
            {
                _data = result.Value;
            }
            else
            {
                _data = null;
                _error = result.Status switch
                {
                    ResultStatus.NotFound => "The local API does not have the NPM request feature enabled yet. The updated server and its approved migration are required.",
                    ResultStatus.Unauthorized or ResultStatus.Forbidden => "Your session is not authorized to view these requests. Sign in with your assigned collector account.",
                    _ => result.Error ?? "The office request service could not respond. Check your connection or ask the office to verify the API version."
                };
            }
        }
        catch
        {
            _data = null;
            _error = "Could not contact the office service. Check your connection and try again.";
        }
        finally { _loading = false; }
    }
    private async Task Previous() { if (_page > 1) { _page--; await Load(); } }
    private async Task Next() { if (_data is { } d && _page * d.PageSize < d.Total) { _page++; await Load(); } }
    private static string SectionName(EEMOCantilanSDS.Domain.Enums.MarketSection section) => section switch
    {
        EEMOCantilanSDS.Domain.Enums.MarketSection.FishSection => "Fish Area",
        EEMOCantilanSDS.Domain.Enums.MarketSection.MeatSection => "Meat Area",
        EEMOCantilanSDS.Domain.Enums.MarketSection.VegetableArea => "Vegetable Area",
        _ => section.ToString()
    };
    private static string StatusClass(NpmRegistrationRequestStatus status) => status switch
    {
        NpmRegistrationRequestStatus.Approved => "is-approved",
        NpmRegistrationRequestStatus.Returned => "is-returned",
        NpmRegistrationRequestStatus.Rejected => "is-rejected",
        NpmRegistrationRequestStatus.Cancelled => "is-cancelled",
        _ => "is-pending"
    };
    private static string StatusText(NpmRegistrationRequestStatus status) => status switch
    {
        NpmRegistrationRequestStatus.Submitted => "Pending review",
        NpmRegistrationRequestStatus.Approved => "Approved",
        NpmRegistrationRequestStatus.Returned => "Returned",
        NpmRegistrationRequestStatus.Rejected => "Rejected",
        NpmRegistrationRequestStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };
}
