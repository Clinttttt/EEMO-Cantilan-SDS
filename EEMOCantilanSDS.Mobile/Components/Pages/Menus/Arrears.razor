@page "/arrears"
@using global::EEMOCantilanSDS.Application.Dtos.Mobile
@using global::EEMOCantilanSDS.Application.Dtos.Payors
@using EEMOCantilanSDS.Mobile.Presentation
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@inject EEMOCantilanSDS.Application.Common.Interface.ApiClients.IMobileApiClient Api

@* Arrears and Delinquency: one row per liable ACCOUNT (never per month), read from the same sources as the Head's Arrears page. Amounts are the server's;
   this page filters and words them. Collecting opens the ordinary checkout on the original contract / obligation account. Online only: it never shows stale debt. *@
<div class="page-shell">
    <div class="header">
        <div class="header-eyebrow">Collection</div>
        <div class="header-row">
            <button class="back-btn" type="button" aria-label="Back to Menu" @onclick='() => Navigation.NavigateTo("/menu")'><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg></button>
            <div class="header-title-block"><div class="header-title">Arrears &amp; Delinquency</div><div class="header-sub">@Session.CollectorName</div></div>
            <img class="header-logo" src="@Session.BrandingSeal" alt="Municipality seal" />
        </div>
    </div>
    <main class="content">
        @if (_loading) { <p class="ar-note" role="status">Loading accounts…</p> }
        else if (_failed) { <p class="ar-note" role="alert">Connect to view arrears and delinquency.</p><button type="button" class="ar-more" @onclick="LoadAsync">Try again</button> }
        else if (_all.Count == 0) { <p class="ar-note" role="status">No account assigned to you has arrears or delinquency.</p> }
        else
        {
            <label class="ar-search">
                <span class="ar-label">Find an account</span>
                <input class="form-input" type="search" autocomplete="off" enterkeyhint="search" placeholder="Name, stall or space" aria-label="Search accounts" value="@_search" @oninput="OnSearch" />
            </label>
            <div class="ar-filter" role="group" aria-label="Reason">
                <button type="button" class="ar-chip @(_filter.Reason == ArrearsView.AllReasons ? "on" : "")" aria-pressed="@(_filter.Reason == ArrearsView.AllReasons)" @onclick="() => Reason(ArrearsView.AllReasons)">All</button>
                <button type="button" class="ar-chip @(_filter.Reason == ArrearsView.ArrearsOnly ? "on" : "")" aria-pressed="@(_filter.Reason == ArrearsView.ArrearsOnly)" @onclick="() => Reason(ArrearsView.ArrearsOnly)">Arrears</button>
                <button type="button" class="ar-chip @(_filter.Reason == ArrearsView.DelinquentOnly ? "on" : "")" aria-pressed="@(_filter.Reason == ArrearsView.DelinquentOnly)" @onclick="() => Reason(ArrearsView.DelinquentOnly)">Delinquent</button>
            </div>
            @if (_operations.Count > 1)
            {
                <div class="ar-filter" role="group" aria-label="Operation">
                    <button type="button" class="ar-chip @(_filter.OperationCode is null ? "on" : "")" aria-pressed="@(_filter.OperationCode is null)" @onclick="() => Operation(null)">All</button>
                    @foreach (var op in _operations)
                    {
                        var code = op.Code;
                        <button type="button" class="ar-chip @(_filter.OperationCode == code ? "on" : "")" aria-pressed="@(_filter.OperationCode == code)" @onclick="() => Operation(code)">@op.Name</button>
                    }
                </div>
            }
            <p class="ar-total" role="status"><strong>@Peso(_totals.Total)</strong> across @_totals.Accounts @(_totals.Accounts == 1 ? "account" : "accounts")<small>Arrears @Peso(_totals.Arrears) · Delinquent @Peso(_totals.Delinquent)</small></p>
            @if (_shown.Count == 0) { <p class="ar-note" role="status">No account matches.</p> }
            else
            {
                <ul class="ar-list">
                    @foreach (var a in _shown)
                    {
                        var open = _open == a.AccountKey;
                        <li @key="a.AccountKey" class="ar-item">
                            <button type="button" class="ar-row" aria-expanded="@open" @onclick="() => Toggle(a.AccountKey)">
                                <span class="ar-text">
                                    <strong>@a.Payer</strong>
                                    <small>@a.OperationName · @a.Space@(a.Section is null ? "" : " · " + a.Section)</small>
                                    <small>@a.Status · @ArrearsView.ReasonLabel(a) · @ArrearsView.MonthsLabel(a)@(ArrearsView.Span(a) is { } span ? " · " + span : "")</small>
                                </span>
                                <span class="ar-amount">@Peso(a.Total)</span>
                            </button>
                            @if (open)
                            {
                                <dl class="ar-detail">
                                    @if (a.ArrearsAmount > 0m) { <div><dt>Arrears@(a.ArrearsBasis is null ? "" : $" ({a.ArrearsBasis.ToLowerInvariant()})")</dt><dd>@Peso(a.ArrearsAmount)</dd></div> }
                                    @if (a.DelinquentAmount > 0m) { <div><dt>Delinquent</dt><dd>@Peso(a.DelinquentAmount)</dd></div> }
                                    @if (a.PriorTermAmount > 0m) { <div><dt>Earlier term</dt><dd>@Peso(a.PriorTermAmount)</dd></div><div><dt>Current term</dt><dd>@Peso(a.CurrentTermAmount)</dd></div> }
                                </dl>
                                @if (ArrearsView.CollectBlockedReason(a) is { } blocked) { <p class="ar-note ar-left">@blocked</p> }
                                else { <button type="button" class="ar-collect" @onclick="() => Collect(a)">Collect arrears</button> }
                                <button type="button" class="ar-secondary" @onclick="() => OpenIssue(a)">Issue payor code</button>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </main>
    <BottomNav ActiveTab="menu" />
</div>

@* Issue payor code: a one-time code for THIS liable account (the original contract / obligation account). The server decides whether the payor activates a
   new account or links an existing one, and refuses unless the account still has an unpaid balance you may see. Online only. *@
@if (_issuing is { } target)
{
    <div class="ar-overlay" @onclick="CloseIssue">
        <div class="ar-sheet" role="dialog" aria-modal="true" aria-labelledby="ar-issue-title" @onclick:stopPropagation="true">
            <h2 id="ar-issue-title" class="ar-sheet-title">Payor code</h2>
            <p class="ar-sheet-sub">A one-time code so the person liable for this account can see what they owe in the Payor Portal.</p>
            <div class="ar-preview"><strong>@target.Payer</strong><small>@target.OperationName · @target.Space · @target.Status</small></div>
            @if (_issued is null)
            {
                <label class="ar-label" for="ar-phone">Payor's mobile number</label>
                <input id="ar-phone" class="form-input" type="tel" inputmode="numeric" maxlength="20" placeholder="09xx xxx xxxx" value="@_phone" @oninput="e => _phone = e.Value?.ToString() ?? string.Empty" />
                <p class="ar-hint">The payor must enter this exact number when using the code.</p>
                <label class="ar-confirm"><input type="checkbox" checked="@_confirmed" @onchange="e => _confirmed = e.Value is true" /> I confirmed the person is <strong>@target.Payer</strong>, the liable payer of this account.</label>
                @if (!string.IsNullOrWhiteSpace(_issueError)) { <p class="ar-error" role="alert">@_issueError</p> }
                <div class="ar-sheet-row">
                    <button type="button" class="ar-cancel" disabled="@_busy" @onclick="CloseIssue">Cancel</button>
                    <button type="button" class="ar-collect ar-inline" disabled="@(_busy || !_confirmed)" @onclick="IssueAsync">@(_busy ? "Generating…" : "Generate code")</button>
                </div>
            }
            else
            {
                <div class="ar-code-box"><small>@(_issued.Mode == "Link" ? "Link code" : "Activation code")</small><strong>@_issued.Code</strong></div>
                <dl class="ar-detail ar-flush">
                    <div><dt>For mobile</dt><dd>@_issued.ContactNumber</dd></div>
                    <div><dt>Expires</dt><dd>@_issued.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
                </dl>
                <p class="ar-hint">@(_issued.Mode == "Link" ? "This number already has a Payor Portal account. The payor signs in and links this account with the code; it is never merged by number or name." : "The payor activates a Payor Portal account with this code and the number above.") Generating a new code voids this one.</p>
                <div class="ar-sheet-row"><button type="button" class="ar-collect ar-inline" @onclick="CloseIssue">Done</button></div>
            }
        </div>
    </div>
}

@code {
    private IReadOnlyList<ArrearsAccountDto> _all = [];
    private IReadOnlyList<ArrearsAccountDto> _shown = [];
    private IReadOnlyList<(string Code, string Name)> _operations = [];
    private (int Accounts, decimal Total, decimal Arrears, decimal Delinquent) _totals;
    private ArrearsFilter _filter = new();
    private string _search = "";
    private string? _open;
    private bool _loading = true, _failed;

    private void OnSearch(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; Refresh(); }
    private static string Peso(decimal amount) => "₱" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.Menu is null) { Navigation.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _failed = false;
        try
        {
            var result = await Api.GetArrearsWorkspaceAsync();
            if (result.IsSuccess && result.Value is { } workspace) { _all = workspace.Accounts; _operations = ArrearsView.Operations(_all); }
            else _failed = true;
        }
        catch { _failed = true; }
        _loading = false;
        Refresh();
    }

    private void Refresh()
    {
        _filter = _filter with { Search = _search };
        _shown = ArrearsView.Apply(_all, _filter);
        _totals = ArrearsView.Totals(_shown);
    }
    private void Reason(string reason) { _filter = _filter with { Reason = reason }; Refresh(); }
    private void Operation(string? code) { _filter = _filter with { OperationCode = code }; Refresh(); }
    private void Toggle(string key) => _open = _open == key ? null : key;
    private ArrearsAccountDto? _issuing;
    private HistoricalAccessCodeDto? _issued;
    private string _phone = string.Empty, _issueError = string.Empty;
    private bool _confirmed, _busy;
    private void OpenIssue(ArrearsAccountDto a) { _issuing = a; _issued = null; _phone = string.Empty; _issueError = string.Empty; _confirmed = false; }
    private void CloseIssue() { if (!_busy) { _issuing = null; _issued = null; } }
    private async Task IssueAsync()
    {
        if (_issuing is not { } a || !_confirmed) return;
        if (string.IsNullOrWhiteSpace(_phone)) { _issueError = "Enter the payor's mobile number."; return; }
        _busy = true; _issueError = string.Empty;
        try
        {
            var liable = a.Kind == ArrearsAccountKind.StallRent ? a.ContractId : a.ObligationAccountId;
            var result = await Api.IssueHistoricalAccessCodeAsync(new(a.Kind, liable ?? Guid.Empty, _phone.Trim(), a.Payer, null));
            if (result.IsSuccess && result.Value is not null) _issued = result.Value;
            else _issueError = result.Error ?? "Could not generate the code. Please try again.";
        }
        catch { _issueError = "Couldn't reach the server. Check your connection and try again."; }
        finally { _busy = false; }
    }
    private void Collect(ArrearsAccountDto a) => Navigation.NavigateTo($"/arrears/collect?kind={(int)a.Kind}&id={a.Identity.Id}");
}
