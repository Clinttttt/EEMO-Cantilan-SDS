@page "/collect/{Facility}"
@using System.Globalization
@using Microsoft.JSInterop
@using global::EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using global::EEMOCantilanSDS.Application.Command.Payors.GenerateStallActivationCode
@using global::EEMOCantilanSDS.Application.Dtos.Mobile
@using global::EEMOCantilanSDS.Application.Dtos.Payors
@using global::EEMOCantilanSDS.Application.Requests.Mobile
@using global::EEMOCantilanSDS.Application.Common.Payments
@using global::EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Mobile.Collections
@using EEMOCantilanSDS.Mobile.Models
@using EEMOCantilanSDS.Mobile.Services
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@inject EEMOCantilanSDS.Mobile.Services.MobilePaymentHubService PaymentHub
@inject IMobileApiClient MobileApi
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync
@inject IJSRuntime JS
@implements IDisposable

<div class="page-shell">
    <div class="header">
        <div class="header-row">
            <button class="back-btn" type="button" @onclick="GoBack" aria-label="Back to menu">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div class="header-title-block">
                <div class="header-title">@(Collection?.FacilityName ?? FacilityTitle)</div>
                <div class="header-sub">Monthly billing · @MonthLabel</div>
            </div>
        </div>
    </div>

    <div class="date-strip">
        <div class="date-strip-left">Collector: <span>@Session.CollectorName</span></div>
        <div class="collection-month-pill" aria-label="Collection period">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            @MonthLabel
        </div>
    </div>

    <div class="content">
        @if (IsLoading)
        {
            <LoadingState Text="Loading collections…" />
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <ErrorState Title="Couldn't load collections" Message="@ErrorMessage" OnRetry="LoadCollectionAsync" />
        }
        else if (Collection is not null)
        {
            @* One context strip for the month: what was collected, what remains, and how many accounts are paid. *@
            <div class="npm-context" aria-label="Month position">
                <div class="npm-context-figures">
                    <div class="npm-figure">
                        <div class="npm-figure-value">@FormatCurrency(Collection.CollectedAmount)</div>
                        <div class="npm-figure-key">Collected</div>
                    </div>
                    <div class="npm-figure">
                        <div class="npm-figure-value">@FormatCurrency(Collection.OutstandingAmount + Collection.Stalls.Sum(s => s.PenaltiesDue))</div>
                        <div class="npm-figure-key">Outstanding</div>
                    </div>
                    <div class="npm-figure">
                        <div class="npm-figure-value">@SettledCount of @Collection.TotalStalls</div>
                        <div class="npm-figure-key">Paid in full</div>
                    </div>
                </div>
                <div class="month-progress-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@PaidPercent" aria-label="Share of accounts paid in full">
                    <div class="month-progress-fill" style="width:@PaidPercent%"></div>
                </div>
            </div>

            <div class="npm-tools">
            <div class="search-wrap">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" placeholder="Search stall no. or name" aria-label="Search stall or payor" @bind="SearchQuery" @bind:event="oninput" />
            </div>

            <div class="seg-filter">
                @foreach (var tab in FilterOptions)
                {
                    <button class="seg-filter-btn @(ActiveFilter == tab ? "active" : "")" type="button" @onclick="() => ActiveFilter = tab">
                        @tab
                    </button>
                }
            </div>
            </div>

            @if (!FilteredStalls.Any())
            {
                <div class="state-card">
                    <div class="state-title">No matching stalls</div>
                    <div class="state-text">Try another search or filter.</div>
                </div>
            }
            else
            {
@if (!string.IsNullOrWhiteSpace(RentNotice) && !RecordConfirmed) { <RecordedNotice Message="@RentNotice" /> }
                <div class="section-label">@Collection.TotalStalls Occupied Stalls</div>
                @foreach (var stall in FilteredStalls)
                {
                    <button class="tx-card" type="button" @onclick="() => OnCardTap(stall)">
                        <div class="tx-left-bar @MonthBarClass(stall)"></div>
                        <div class="tx-body">
                            <div class="tx-top">
                                <span class="tx-owner">@stall.PayorName</span>
                                <span class="tx-amount">@FormatCurrency(stall.MonthlyRate)<span class="tx-amount-cap"> / month</span></span>
                            </div>

                            <div class="tx-meta">
                                <span>Stall No. @stall.StallNo</span>
                                @if (!string.IsNullOrWhiteSpace(stall.AreaLabel))
                                {
                                    <span class="tx-meta-sep">·</span><span>@stall.AreaLabel</span>
                                }
                                @if (stall.Status != PaymentStatus.Unpaid && !string.IsNullOrWhiteSpace(stall.ORNumber))
                                {
                                    <span class="tx-meta-sep">·</span><span>OR @stall.ORNumber</span>
                                }
                                @if (stall.Status == PaymentStatus.Partial)
                                {
                                    <span class="tx-meta-sep">·</span><span>Paid @FormatCurrency(stall.AmountPaid) · Remaining @FormatCurrency(stall.Balance)</span>
                                }
                                @if (stall.PenaltiesDue > 0m)
                                {
                                    <span class="tx-meta-sep">·</span><span>Penalties @FormatCurrency(stall.PenaltiesDue)</span>
                                }
                            </div>

                            <div class="tx-statusrow">
                                <div class="tx-statuschips">
                                    @if (IsQueuedOffline(stall))
                                    {
                                        <span class="tx-badge badge-queued">
                                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                            Queued
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tx-badge @GetBadgeClass(stall)">
                                            @if (IsSettled(stall))
                                            {
                                                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                            }
                                            else if (stall.Status != PaymentStatus.Unpaid)
                                            {
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                            }
                                            @StatusLabel(stall)
                                        </span>
                                    }
                                    @if (stall.PaidOnline)
                                    {
                                        <span class="tx-online">
                                            <svg viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14 0" /><path d="M8.5 16.1a6 6 0 0 1 7 0" /><line x1="12" y1="20" x2="12" y2="20" /></svg>
                                            Online
                                        </span>
                                    }
                                    @if (stall.AwaitingOr)
                                    {
                                        <span class="tx-pending">OR pending</span>
                                    }
                                </div>

                                <span class="tx-action @(IsCollectAction(stall) ? "tx-action-collect" : "tx-action-view")" role="button" tabindex="0"
                                      @onclick="() => OnCardTap(stall)" @onclick:stopPropagation="true">
                                    @if (IsCollectAction(stall))
                                    {
                                        <svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" /><path d="M3 5v14a2 2 0 0 0 2 2h16v-5" /><path d="M18 12a2 2 0 0 0 0 4h4v-4z" /></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                                    }
                                    <span>@ActionLabel(stall)</span>
                                </span>
                            </div>
                        </div>
                    </button>
                }
            }
        }
    </div>

    <BottomNav ActiveTab="menu" />
</div>

@if (ShowSheet && SelectedStall is not null)
{
    <div class="sheet-overlay" @onclick="CloseSheet">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-title">Record Monthly Payment</div>
            <div class="sheet-sub">Update this stall's payment status for @MonthLabel.</div>

            <div class="sheet-preview">
                <div class="preview-num" title="@SelectedStall.StallNo">@SelectedStall.StallNo</div>
                <div class="preview-info">
                    <div class="preview-name">@SelectedStall.PayorName</div>
                    <div class="preview-detail">@MonthLabel · monthly billing</div>
                </div>
            </div>

            @if (_earlier.Count > 0)
            {
                @* The space's older unpaid months, as the server lists them. Tapping opens the unpaid-months screen, which collects them oldest first. *@
                <button class="earlier-card" type="button" @onclick="OpenEarlier">
                    <span class="earlier-info">
                        <span class="earlier-label">Unpaid before @MonthLabel</span>
                        <span class="earlier-detail">@_earlier.Count @(_earlier.Count == 1 ? "month" : "months") · from @(new DateTime(_earlier[0].Year, _earlier[0].Month, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture))</span>
                    </span>
                    <span class="earlier-amount">₱@_earlier.Sum(m => m.BalanceDue).ToString("N2", CultureInfo.InvariantCulture)</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
            }

            @* The server's own figures for this account and month: obligation, what has been paid, and what remains. *@
            <dl class="money-rows" aria-label="Monthly obligation">
                <div class="money-row"><dt>Monthly obligation</dt><dd>@FormatCurrency(SelectedStall.MonthlyRate)</dd></div>
                <div class="money-row"><dt>Paid</dt><dd>@FormatCurrency(SelectedStall.AmountPaid)</dd></div>
                <div class="money-row strong"><dt>Remaining</dt><dd>@FormatCurrency(SelectedStall.Balance)</dd></div>
            </dl>

            @if (SelectedStall.Status != PaymentStatus.Paid && HasPenalties(SelectedStall))
            {
                @PenaltyRows(SelectedStall.Balance)
            }

            <button class="status-option @(SelectedStatus == PaymentStatus.Paid ? "status-option-active paid" : "")" type="button" @onclick="() => SelectStatus(PaymentStatus.Paid)">
                <div class="status-option-icon paid-icon-sm">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                </div>
                <div class="status-option-info">
                    <div class="status-option-label">Paid in Full</div>
                    @if (SelectedStall.Status != PaymentStatus.Paid && PenaltiesOpen > 0m)
                    {
                        <div class="status-option-sub">Rent and penalties on one receipt - @FormatCurrency(SelectedStall.Balance + PenaltiesOpen)</div>
                    }
                    else
                    {
                        <div class="status-option-sub">Full monthly rental collected - @FormatCurrency(SelectedStall.MonthlyRate)</div>
                    }
                </div>
                @if (SelectedStatus == PaymentStatus.Paid)
                {
                    <div class="status-option-check">✓</div>
                }
            </button>

            <button class="status-option @(SelectedStatus == PaymentStatus.Partial ? "status-option-active partial" : "")" type="button" @onclick="() => SelectStatus(PaymentStatus.Partial)">
                <div class="status-option-icon partial-icon-sm">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                </div>
                <div class="status-option-info">
                    <div class="status-option-label">Partial Payment</div>
                    <div class="status-option-sub">Collected less than the full monthly rental.</div>
                </div>
                @if (SelectedStatus == PaymentStatus.Partial)
                {
                    <div class="status-option-check">✓</div>
                }
            </button>

            @if (SelectedStatus == PaymentStatus.Partial)
            {
                <div class="or-number-wrap">
                    <div class="form-label">Amount collected</div>
                    <div class="fish-input-row">
                        <span>₱</span>
                        <input class="form-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0" aria-label="Amount collected" @bind="PartialAmount" @bind:event="oninput" />
                    </div>
                    <div class="form-hint">Must be greater than 0 and less than @FormatCurrency(SelectedStall.MonthlyRate).@(PenaltiesOpen > 0m ? " Penalties are collected with a full payment." : "")</div>
                </div>
            }

            @if (SelectedStatus != PaymentStatus.Unpaid && SelectedStall is { RentCanonical: false })
            {
                <details class="or-number-wrap">
                    <summary>Receipt details (optional entry)</summary>
                    <div class="form-label">Official receipt no.</div>
                    <input class="form-input mono-input"
                           type="text"
                           inputmode="numeric"
                           maxlength="30"
                           placeholder="000001"
                           @bind="ORNumber"
                           @bind:event="oninput" />
                    <div class="form-hint">Use the pre-numbered OR from the issued receipt.@(SelectedStatus == PaymentStatus.Paid && SelectedStall.Status != PaymentStatus.Paid && PenaltiesOpen > 0m ? " The same receipt covers the penalties." : "")</div>
                </details>
            }
            else if (SelectedStatus != PaymentStatus.Unpaid && SelectedStall is { RentCanonical: true })
            {
                <div class="sheet-meta-row"><span>Reference</span><strong>SRC assigned after recording</strong></div>
            }

            <button class="status-option @(SelectedStatus == PaymentStatus.Unpaid ? "status-option-active unpaid" : "")" type="button" @onclick="() => SelectStatus(PaymentStatus.Unpaid)">
                <div class="status-option-icon unpaid-icon-sm">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                </div>
                <div class="status-option-info">
                    <div class="status-option-label">Unpaid</div>
                    <div class="status-option-sub">Mark this stall as unpaid for the month.</div>
                </div>
                @if (SelectedStatus == PaymentStatus.Unpaid)
                {
                    <div class="status-option-check">✓</div>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(SheetError))
            {
                <div class="form-error">@SheetError</div>
            }

            @if (Sync.IsOnline)
            {
                <button class="sheet-activation-link" type="button" @onclick="OpenActivationFromSheet">
                    <svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="5.5" /><path d="m21 2-9.6 9.6" /><path d="m15.5 7.5 3 3L22 7l-3-3" /></svg>
                    Issue payor activation code
                </button>
            }

            <SlowSaveHint Active="IsSaving" />
            <div class="sheet-btn-row">
                @* Cancel stays live while saving. It was disabled beside Confirm, so a save that hung left no way out of the sheet at all. Backing out cannot lose money: a write already sent either lands or is queued whatever this screen does. *@
                    <button class="btn-cancel" type="button" @onclick="CloseSheet">Cancel</button>
                <button class="btn-confirm" type="button" @onclick="ConfirmAsync" disabled="@(IsSaving || _penaltiesLoading)">
                    @(IsSaving ? "Saving..." : "Confirm")
                </button>
            </div>
        </div>
    </div>
}

@if (ShowReceipt && SelectedStall is not null && Collection is not null)
{
    <div class="sheet-overlay" @onclick="CloseReceipt">
        <div class="sheet receipt-sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="receipt">
                <div class="receipt-head">
                    <img src="@Session.BrandingSeal" class="receipt-seal" alt="Municipal seal" />
                    <div class="receipt-gov">Republic of the Philippines</div>
                    <div class="receipt-org">@Session.BrandingOffice</div>
                    <div class="receipt-muni">@Session.BrandingMunicipalityLine</div>
                    <div class="receipt-doc">@(Collection.FacilityName)</div>
                </div>
                <div class="receipt-divider"></div>
                <div class="receipt-meta">
                    <div class="receipt-meta-row"><span>Period</span><strong>@MonthLabel</strong></div>
                    <div class="receipt-meta-row"><span>Stall No.</span><strong>@SelectedStall.StallNo</strong></div>
                    <div class="receipt-meta-row"><span>Payor</span><strong>@SelectedStall.PayorName</strong></div>
                    @if (!string.IsNullOrWhiteSpace(SelectedStall.AreaLabel))
                    {
                        <div class="receipt-meta-row"><span>Area</span><strong>@SelectedStall.AreaLabel</strong></div>
                    }
                    <div class="receipt-meta-row"><span>Status</span><strong>@SelectedStall.Status</strong></div>
                    @if (SelectedStall.Status == PaymentStatus.Partial)
                    {
                        <div class="receipt-meta-row"><span>Amount Paid</span><strong>@FormatCurrency(SelectedStall.AmountPaid)</strong></div>
                        <div class="receipt-meta-row"><span>Balance</span><strong>@FormatCurrency(SelectedStall.Balance)</strong></div>
                    }
                    <div class="receipt-meta-row"><span>OR No.</span><strong>@(string.IsNullOrWhiteSpace(SelectedStall.ORNumber) ? "—" : SelectedStall.ORNumber)</strong></div>
                </div>
                <div class="receipt-divider"></div>
                <div class="receipt-total-row receipt-grand">
                    <span>Monthly Rental</span>
                    <span>&#8369;@SelectedStall.MonthlyRate.ToString("N2")</span>
                </div>
                <div class="receipt-divider dashed"></div>
                <div class="receipt-foot">
                    <div class="receipt-foot-row">
                        <span>Collected by</span>
                        <strong>@Session.CollectorName</strong>
                    </div>
                    <div class="receipt-note">Acknowledgement of this payment on your device. It does not replace the pre-numbered Official Receipt.</div>
                </div>
            </div>
            @if (SelectedStall.Status == PaymentStatus.Partial && SelectedStall.Balance > 0)
            {
                <button class="btn-receipt-collect" type="button" @onclick="OpenCollectBalance">
                    Collect Balance · @FormatCurrency(SelectedStall.Balance)
                </button>
            }
            @if (Sync.IsOnline)
            {
                <button class="sheet-activation-link" type="button" @onclick="OpenActivationFromSheet">
                    <svg viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="5.5" /><path d="m21 2-9.6 9.6" /><path d="m15.5 7.5 3 3L22 7l-3-3" /></svg>
                    Issue payor activation code
                </button>
            }
            <div class="receipt-close-row">
                <button class="btn-receipt-edit" type="button" @onclick="OpenEditFromReceipt">Edit</button>
                <button class="btn-receipt-close" type="button" @onclick="CloseReceipt">Close</button>
            </div>
        </div>
    </div>
}

@if (ShowCollectBalance && SelectedStall is not null)
{
    <div class="sheet-overlay" @onclick="CloseCollectBalance">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-title">Collect Remaining Balance</div>
            <div class="sheet-sub">Add a payment toward this stall's balance for @MonthLabel.</div>

            <div class="sheet-preview">
                <div class="preview-num" title="@SelectedStall.StallNo">@SelectedStall.StallNo</div>
                <div class="preview-info">
                    <div class="preview-name">@SelectedStall.PayorName</div>
                    <div class="preview-detail">Monthly rental · @FormatCurrency(SelectedStall.MonthlyRate)</div>
                </div>
            </div>

            <div class="balance-recap">
                <div class="balance-recap-row"><span>Already paid</span><strong>@FormatCurrency(SelectedStall.AmountPaid)</strong></div>
                <div class="balance-recap-row balance-recap-due"><span>Remaining balance</span><strong>@FormatCurrency(SelectedStall.Balance)</strong></div>
            </div>

            <div class="or-number-wrap">
                <div class="form-label">Amount collected now</div>
                <div class="fish-input-row">
                    <span>₱</span>
                    <input class="form-input" type="number" min="0" step="0.01" max="@SelectedStall.Balance" placeholder="0" @bind="BalanceCollectNow" @bind:event="oninput" />
                </div>
                <div class="form-hint">Up to the remaining balance of @FormatCurrency(SelectedStall.Balance). Paying it in full marks the stall Paid.@(PenaltiesOpen > 0m ? " Clearing it also collects the penalties on the same receipt." : "")</div>
            </div>

            @if (HasPenalties(SelectedStall) && ClearsBalance)
            {
                @PenaltyRows(SelectedStall.Balance)
            }

            @if (SelectedStall is { RentCanonical: false })
            {
            <div class="or-number-wrap">
                <div class="form-label">Official receipt no. <span>optional</span></div>
                <input class="form-input mono-input"
                       type="text"
                       inputmode="numeric"
                       maxlength="30"
                       placeholder="000001"
                       @bind="BalanceOrNumber"
                       @bind:event="oninput" />
                <div class="form-hint">Use the pre-numbered OR from the issued receipt.</div>
            </div>
            }
            else if (SelectedStall is { RentCanonical: true })
            {
                @* Canonical: the server issues the reference when it records the collection; nothing is typed and nothing is invented here. *@
                <div class="sheet-meta-row"><span>Reference</span><strong>SRC assigned after recording</strong></div>
            }

            @if (!string.IsNullOrWhiteSpace(CollectBalanceError))
            {
                <div class="form-error">@CollectBalanceError</div>
            }

            <SlowSaveHint Active="IsSaving" />
            <div class="sheet-btn-row">
                @* Cancel stays live while saving. It was disabled beside Confirm, so a save that hung left no way out of the sheet at all. Backing out cannot lose money: a write already sent either lands or is queued whatever this screen does. *@
                    <button class="btn-cancel" type="button" @onclick="CloseCollectBalance">Cancel</button>
                <button class="btn-confirm" type="button" @onclick="ConfirmCollectBalanceAsync" disabled="@(IsSaving || _penaltiesLoading)">
                    @(IsSaving ? "Saving..." : "Confirm Payment")
                </button>
            </div>
        </div>
    </div>
}

@if (ShowPenalties && SelectedStall is not null)
{
    @* The month's rent is paid but the account still owes penalties: the same register figures, collected in full in one step. *@
    <div class="sheet-overlay" @onclick="CloseSheet">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-title">Collect Penalties</div>
            <div class="sheet-sub">@MonthLabel rent is paid. These penalties are still open on the account.</div>

            <div class="sheet-preview">
                <div class="preview-num" title="@SelectedStall.StallNo">@SelectedStall.StallNo</div>
                <div class="preview-info">
                    <div class="preview-name">@SelectedStall.PayorName</div>
                    <div class="preview-detail">@MonthLabel · rent paid</div>
                </div>
            </div>

            @PenaltyRows(0m)

            <details class="or-number-wrap">
                <summary>Receipt details (optional entry)</summary>
                <div class="form-label">Official receipt no.</div>
                <input class="form-input mono-input"
                       type="text"
                       inputmode="numeric"
                       maxlength="30"
                       placeholder="000001"
                       aria-label="Official receipt number"
                       @bind="ORNumber"
                       @bind:event="oninput" />
                <div class="form-hint">Use the pre-numbered OR from the issued receipt.</div>
            </details>

            @if (!string.IsNullOrWhiteSpace(SheetError))
            {
                <div class="form-error">@SheetError</div>
            }

            <SlowSaveHint Active="IsSaving" />
            <div class="sheet-btn-row">
                <button class="btn-cancel" type="button" @onclick="CloseSheet">Cancel</button>
                <button class="btn-confirm" type="button" @onclick="ConfirmPenaltiesAsync" disabled="@(IsSaving || PenaltiesOpen <= 0m)">
                    @(IsSaving ? "Saving..." : $"Collect {FormatCurrency(PenaltiesOpen)}")
                </button>
            </div>
        </div>
    </div>
}

@if (ShowActivation && ActivationStall is not null)
{
    <div class="sheet-overlay" @onclick="CloseActivation">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-title">Payor Activation Code</div>
            <div class="sheet-sub">Issue a one-time code so this payor can activate their online account.</div>

            <div class="sheet-preview">
                <div class="preview-num" title="@ActivationStall.StallNo">@ActivationStall.StallNo</div>
                <div class="preview-info">
                    <div class="preview-name">@ActivationStall.PayorName</div>
                    <div class="preview-detail">Monthly rental - @FormatCurrency(ActivationStall.MonthlyRate)</div>
                </div>
            </div>

            @if (ActivationResult is null)
            {
                <div class="or-number-wrap">
                    <div class="form-label">Payor's mobile number</div>
                    <input class="form-input mono-input"
                           type="tel"
                           inputmode="numeric"
                           maxlength="20"
                           placeholder="09xx xxx xxxx"
                           @bind="ActivationContact"
                           @bind:event="oninput" />
                    <div class="form-hint">The payor must enter this exact number when activating.</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ActivationError))
                {
                    <div class="form-error">@ActivationError</div>
                }

                <SlowSaveHint Active="IsSaving" />
                <div class="sheet-btn-row">
                    <button class="btn-cancel" type="button" @onclick="CloseActivation" disabled="@IsGenerating">Cancel</button>
                    <button class="btn-confirm" type="button" @onclick="GenerateActivationAsync" disabled="@IsGenerating">
                        @(IsGenerating ? "Generating..." : "Generate Code")
                    </button>
                </div>
            }
            else
            {
                <div class="activation-code-box">
                    <div class="activation-code-label">Activation code</div>
                    <div class="activation-code-value">@ActivationResult.Code</div>
                    <button class="btn-copy" type="button" @onclick="CopyCodeAsync">@CopyLabel</button>
                </div>
                <div class="activation-meta">
                    <div class="activation-meta-row"><span>For mobile</span><strong>@ActivationResult.ContactNumber</strong></div>
                    <div class="activation-meta-row"><span>Expires</span><strong>@ActivationResult.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                </div>
                <div class="form-hint">
                    Give this code to the payor. They activate at the Payor Portal using this code and the mobile
                    number above. Generating a new code voids this one.
                </div>
                <SlowSaveHint Active="IsSaving" />
                <div class="sheet-btn-row">
                    <button class="btn-confirm" type="button" @onclick="CloseActivation">Done</button>
                </div>
            }
        </div>
    </div>
}

@if (ShowEncodeOr && EncodeStall is not null)
{
    <div class="sheet-overlay" @onclick="CloseEncodeOr">
        <div class="sheet" @onclick:stopPropagation="true">
            <div class="sheet-handle"></div>
            <div class="sheet-title">Encode Official Receipt</div>
            <div class="sheet-sub">This stall was paid online. Enter the OR number you issued for it.</div>

            <div class="sheet-preview">
                <div class="preview-num" title="@EncodeStall.StallNo">@EncodeStall.StallNo</div>
                <div class="preview-info">
                    <div class="preview-name">@EncodeStall.PayorName</div>
                    <div class="preview-detail">Paid online · @FormatCurrency(EncodeStall.MonthlyRate)</div>
                </div>
            </div>

            <div class="or-number-wrap">
                <div class="form-label">Official receipt no.</div>
                <input class="form-input mono-input"
                       type="text"
                       maxlength="50"
                       placeholder="e.g. OR-2026-0301"
                       @bind="EncodeOrInput"
                       @bind:event="oninput" />
                <div class="form-hint">The online payment is already received; this only records the OR.</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(EncodeError))
            {
                <div class="form-error">@EncodeError</div>
            }

            <SlowSaveHint Active="IsSaving" />
            <div class="sheet-btn-row">
                <button class="btn-cancel" type="button" @onclick="CloseEncodeOr" disabled="@EncodeBusy">Cancel</button>
                <button class="btn-confirm" type="button" @onclick="ConfirmEncodeOrAsync" disabled="@EncodeBusy">
                    @(EncodeBusy ? "Saving..." : "Save OR")
                </button>
            </div>
        </div>
    </div>
}

@if (RecordConfirmed)
{
    <CollectionRecordedSheet Message="@RentNotice" OnClose="DismissRecorded" />
}

@code {
    private bool RecordConfirmed => RentNotice?.StartsWith("Collection recorded", StringComparison.Ordinal) == true || RentNotice == "Payment recorded successfully.";
    private void DismissRecorded() => RentNotice = null;
    [Parameter] public string Facility { get; set; } = string.Empty;

    private FacilityCode FacilityCode;
    private MobileMonthlyCollectionDto? Collection;
    // Stall ids with a locally-queued (not-yet-synced) offline payment for this facility/period.
    private HashSet<Guid> QueuedOfflineStalls = new();
    private bool IsLoading = true;
    private bool IsSaving;
    private string? ErrorMessage;
    private string? SheetError;
    private string SearchQuery = string.Empty;
    private string ActiveFilter = "All";
    private int SelectedYear;
    private int SelectedMonth;
    private bool ShowSheet;
    private bool ShowReceipt;
    private MobileMonthlyStallCollectionDto? SelectedStall;
    private PaymentStatus SelectedStatus = PaymentStatus.Paid;
    private decimal? PartialAmount;
    private string ORNumber = string.Empty;

    // Payor activation-code issuance
    private bool ShowActivation;
    private bool IsGenerating;
    private MobileMonthlyStallCollectionDto? ActivationStall;
    private string ActivationContact = string.Empty;
    private string? ActivationError;
    private StallActivationCodeDto? ActivationResult;
    private string CopyLabel = "Copy";

    // Encode OR for an online payment that is awaiting OR
    private bool ShowEncodeOr;
    private bool EncodeBusy;
    private MobileMonthlyStallCollectionDto? EncodeStall;
    private string EncodeOrInput = string.Empty;
    private string? EncodeError;

    // Online · OR-pending stalls open the Encode-OR sheet (preserves online attribution — uses the
    // dedicated command, not generic record-payment); everything else opens the record-payment sheet.
    private void OnCardTap(MobileMonthlyStallCollectionDto stall)
    {
        // A payment saved on this device is already taken: the server still reads the month as unpaid until it syncs, so reopening the
        // sheet would offer the same month again (a second collection offline, a confusing refusal online). Say where it stands instead.
        if (IsQueuedOffline(stall))
        {
            RentNotice = $"{stall.PayorName}'s payment is saved on this device. It is recorded when the app reaches the office; Records lists it until then.";
            return;
        }
        // Encoding an OR for an online payment needs the server, so offline we just open the read-only view.
        if (Sync.IsOnline && stall.AwaitingOr && stall.OnlinePaymentTransactionId.HasValue)
            OpenEncodeOr(stall);
        else
            OpenStall(stall);
    }

    private void OpenEncodeOr(MobileMonthlyStallCollectionDto stall)
    {
        EncodeStall = stall;
        EncodeOrInput = string.Empty;
        EncodeError = null;
        ShowEncodeOr = true;
    }

    private void CloseEncodeOr()
    {
        ShowEncodeOr = false;
        EncodeStall = null;
        EncodeError = null;
    }

    private async Task ConfirmEncodeOrAsync()
    {
        if (EncodeStall?.OnlinePaymentTransactionId is not { } txnId) return;

        if (string.IsNullOrWhiteSpace(EncodeOrInput))
        {
            EncodeError = "Enter the OR number.";
            return;
        }

        if (!Sync.IsOnline)
        {
            EncodeError = "You're offline. Encoding the OR for an online payment needs a connection.";
            return;
        }

        EncodeBusy = true;
        try
        {
            var result = await MobileApi.IssueOnlinePaymentOrNumberAsync(txnId, EncodeOrInput.Trim());
            if (result.IsSuccess)
            {
                ShowEncodeOr = false;
                EncodeStall = null;
                await LoadCollectionAsync();
            }
            else
            {
                EncodeError = result.Error ?? "Could not save the OR. It may already be in use.";
            }
        }
        catch
        {
            EncodeError = "Couldn't reach the server. Please check your connection and try again.";
        }
        finally
        {
            EncodeBusy = false;
        }
    }

    private void OpenActivation(MobileMonthlyStallCollectionDto stall)
    {
        if (!Sync.IsOnline)
            return; // activation needs the server to issue a one-time code — locked offline

        ActivationStall = stall;
        ActivationContact = string.Empty;
        ActivationError = null;
        ActivationResult = null;
        CopyLabel = "Copy";
        ShowActivation = true;
    }

    // Activation lives in the stall's detail sheets now (not on the card): close the open sheet, then open it.
    private void OpenActivationFromSheet()
    {
        var stall = SelectedStall;
        ShowSheet = false;
        ShowReceipt = false;
        if (stall is not null) OpenActivation(stall);
    }

    private void CloseActivation()
    {
        ShowActivation = false;
        ActivationStall = null;
        ActivationResult = null;
        ActivationError = null;
    }

    private async Task GenerateActivationAsync()
    {
        if (ActivationStall is null) return;
        ActivationError = null;

        if (!Sync.IsOnline)
        {
            ActivationError = "You're offline. Activation codes can only be generated online.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ActivationContact))
        {
            ActivationError = "Enter the payor's mobile number.";
            return;
        }

        IsGenerating = true;
        try
        {
            var result = await MobileApi.GenerateActivationCodeAsync(
                new GenerateStallActivationCodeCommand(ActivationStall.StallId, ActivationContact.Trim(), null));

            if (result.IsSuccess && result.Value is not null)
                ActivationResult = result.Value;
            else
                ActivationError = result.Error ?? "Could not generate the code. Please try again.";
        }
        catch
        {
            ActivationError = "Couldn't reach the server. Please check your connection and try again.";
        }
        finally
        {
            IsGenerating = false;
        }
    }

    private async Task CopyCodeAsync()
    {
        if (ActivationResult is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ActivationResult.Code);
            CopyLabel = "Copied!";
        }
        catch
        {
            CopyLabel = "Copy failed";
        }
    }

    private readonly string[] FilterOptions = ["All", "Paid", "Partial", "Unpaid"];

    private string FacilityCodeUpper => Facility.ToUpperInvariant();
    private string FacilityTitle => FacilityCodeUpper;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Session.InitializeAsync();
        }
        catch (HttpRequestException)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!Enum.TryParse(Facility, ignoreCase: true, out FacilityCode))
        {
            Navigation.NavigateTo("/menu", forceLoad: false);
            return;
        }

        var hasAccess = Session.Menu?.Facilities.Any(f => f.Code == FacilityCode && f.IsAvailable) == true;
        if (!hasAccess)
        {
            Navigation.NavigateTo("/menu", forceLoad: false);
            return;
        }

        var today = Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now);
        SelectedYear = today.Year;
        SelectedMonth = today.Month;

        PaymentHub.PaymentReceived += OnOnlinePaymentReceived;

        // Anything that arrived while the connection was down was never delivered - SignalR does not queue for an
        // absent client. Without re-reading here, a payor could pay online while the collector was out of signal,
        // the card would still read Unpaid, and the collector would take the same money again in person.
        PaymentHub.ConnectionRestored += OnConnectionRestored;

        await LoadCollectionAsync();
    }

    // Realtime: when a payor pays online for a stall in THIS facility/month, refresh so the card flips
    // Unpaid → Paid · Online (awaiting OR) live. The hub event fires off the UI thread — marshal onto it.
    private void OnOnlinePaymentReceived(OnlinePaymentNotification n)
    {
        if (n.BillingYear != SelectedYear || n.BillingMonth != SelectedMonth)
            return;
        if (Collection?.Stalls is null || !Collection.Stalls.Any(s => s.StallId == n.StallId))
            return;

        _ = InvokeAsync(RefreshCollectionSoftlyAsync);
    }

    // A background refresh must NOT tear down the working list: unlike LoadCollectionAsync (initial
    // load) it never flips IsLoading or shows the error screen. It swaps in fresh data only on success;
    // on a transient failure it retries once, then silently keeps the current list (the toast already
    // told the collector a payment came in).
    private async Task RefreshCollectionSoftlyAsync()
    {
        for (var attempt = 0; attempt < 2; attempt++)
        {
            var result = await MobileApi.GetMonthlyCollectionAsync(FacilityCode, SelectedYear, SelectedMonth);
            if (result.IsSuccess && result.Value is not null)
            {
                Collection = result.Value;
                await RefreshQueuedOfflineAsync();
                StateHasChanged();
                return;
            }

            if (attempt == 0)
                await Task.Delay(800);
        }
        // Keep the existing list as-is — no error screen for a non-critical realtime refresh.
    }

    // The connection came back after a gap. What was missed cannot be recovered from the hub, so the month is
    // re-read from the API - the only source that knows what actually happened while the app was offline.
    private void OnConnectionRestored()
        => _ = InvokeAsync(async () =>
        {
            try { await LoadCollectionAsync(); }
            catch { /* best-effort: a failed refresh must not disturb the collector's screen */ }
        });

    public void Dispose()
    {
        PaymentHub.PaymentReceived -= OnOnlinePaymentReceived;
        PaymentHub.ConnectionRestored -= OnConnectionRestored;
    }

    private async Task LoadCollectionAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await MobileApi.GetMonthlyCollectionAsync(FacilityCode, SelectedYear, SelectedMonth);
            if (!result.IsSuccess || result.Value is null)
            {
                ErrorMessage = result.Error ?? "Unable to load assigned stalls.";
                return;
            }

            Collection = result.Value;
            await RefreshQueuedOfflineAsync();
        }
        catch
        {
            // The HTTP layer throws on a connection failure/timeout; keep the retry path safe and unstuck.
            ErrorMessage = "Unable to connect to the server. Please check the connection and try again.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Build the set of stalls that already have a locally-queued offline payment for this facility/period,
    // so the card can show "Queued · Offline" instead of a misleading "Unpaid".
    private async Task RefreshQueuedOfflineAsync()
    {
        var pending = await Sync.GetAllAsync();
        QueuedOfflineStalls = pending
            .Where(o => o.Kind == OfflineOperationKind.MonthlyRental
                     && o.StallId is not null
                     && string.Equals(o.FacilityLabel, FacilityCodeUpper, StringComparison.OrdinalIgnoreCase)
                     && o.BusinessDate.Year == SelectedYear && o.BusinessDate.Month == SelectedMonth
                     && o.LocalStatus is PendingLocalStatus.Pending or PendingLocalStatus.Failed)
            .Select(o => o.StallId!.Value)
            .ToHashSet();
        // Penalties saved on this device and not yet recorded: the server still lists them as owed until they sync.
        QueuedPenaltyContracts = pending
            .Where(o => o.Kind == OfflineOperationKind.ItemizedCollectionSession
                     && o.LocalStatus is PendingLocalStatus.Pending or PendingLocalStatus.Failed
                     && o.CollectionSession?.Intent is { SourceIdentity.Kind: SourceIdentityKind.Occupancy } intent
                     && intent.Items.Count > 0 && intent.Items.All(i => i.Kind == CollectionSessionItemKind.FineAssessment))
            .Select(o => o.CollectionSession!.Intent.SourceIdentity!.Id)
            .ToHashSet();
    }

    private bool IsQueuedOffline(MobileMonthlyStallCollectionDto stall) => QueuedOfflineStalls.Contains(stall.StallId)
        || (HasPenalties(stall) && QueuedPenaltyContracts.Contains(stall.ContractId!.Value));

    // Paid means the month's rent AND the account's penalties are cleared, as on the Statement of Account.
    private static bool IsSettled(MobileMonthlyStallCollectionDto stall) => stall.Status == PaymentStatus.Paid && stall.PenaltiesDue <= 0m;
    private int SettledCount => Collection?.Stalls.Count(IsSettled) ?? 0;
    private static string StatusLabel(MobileMonthlyStallCollectionDto stall) =>
        stall.Status == PaymentStatus.Paid && !IsSettled(stall) ? "Penalties due" : stall.Status.ToString();

    private IEnumerable<MobileMonthlyStallCollectionDto> FilteredStalls =>
        (Collection?.Stalls ?? Array.Empty<MobileMonthlyStallCollectionDto>())
        .Where(s =>
        {
            var matchesSearch = string.IsNullOrWhiteSpace(SearchQuery)
                || s.StallNo.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
                || s.PayorName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase);

            var matchesFilter = ActiveFilter switch
            {
                "Paid" => IsSettled(s),
                "Partial" => s.Status == PaymentStatus.Partial || (s.Status == PaymentStatus.Paid && !IsSettled(s)),
                "Unpaid" => s.Status == PaymentStatus.Unpaid,
                _ => true
            };

            return matchesSearch && matchesFilter;
        })
        .OrderBy(s => s.StallNo);

    private string MonthLabel =>
        new DateTime(SelectedYear == 0 ? DateTime.Now.Year : SelectedYear, SelectedMonth == 0 ? DateTime.Now.Month : SelectedMonth, 1)
            .ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private int PaidPercent =>
        Collection is null || Collection.TotalStalls == 0
            ? 0
            : Math.Clamp((int)Math.Round((decimal)SettledCount / Collection.TotalStalls * 100m), 0, 100);

    private void GoBack() => Navigation.NavigateTo("/menu", forceLoad: false);

    // Paid/Partial stalls open a receipt (view) with Edit; Unpaid opens the record sheet directly.
    private void OpenStall(MobileMonthlyStallCollectionDto stall)
    {
        SelectedStall = stall;
        if (stall.Status == PaymentStatus.Paid && HasPenalties(stall))
        {
            OpenPenalties(stall);
        }
        else if (stall.Status != PaymentStatus.Unpaid)
        {
            SheetError = null;
            ShowReceipt = true;
        }
        else
        {
            OpenSheet(stall);
        }
    }

    private void OpenEditFromReceipt()
    {
        ShowReceipt = false;
        if (SelectedStall is not null) OpenSheet(SelectedStall);
    }

    private void CloseReceipt()
    {
        ShowReceipt = false;
        SelectedStall = null;
    }

    // ── Collect the remaining balance on a partial record ──
    private bool ShowCollectBalance;
    private decimal? BalanceCollectNow;
    private string BalanceOrNumber = string.Empty;
    private string? CollectBalanceError;

    private void OpenCollectBalance()
    {
        if (SelectedStall is null) return;
        ShowReceipt = false;
        BalanceCollectNow = SelectedStall.Balance; // default to clearing the whole balance
        BalanceOrNumber = SelectedStall.ORNumber ?? string.Empty; // carry the existing OR forward, if any
        CollectBalanceError = null;
        ShowCollectBalance = true;
        LoadPenalties(SelectedStall);
    }

    private void CloseCollectBalance()
    {
        ShowCollectBalance = false;
        BalanceCollectNow = null;
        BalanceOrNumber = string.Empty;
        CollectBalanceError = null;
        SelectedStall = null;
        ResetPenalties();
    }

    private bool ClearsBalance => SelectedStall is not null && BalanceCollectNow == SelectedStall.Balance;

    /// <summary>
    /// Collects part of an outstanding balance, and is answerable for the sheet never being left locked.
    /// </summary>
    private async Task ConfirmCollectBalanceAsync()
    {
        try
        {
            await ConfirmCollectBalanceCoreAsync();
        }
        catch (Exception ex) when (IsConnectivityShaped(ex))
        {
            // The figures were settled before the write was attempted, so they can be queued as they stood. Recomputing them here
            // would risk quoting a different amount from the one the payor was shown.
            if (SelectedStall is not null && BalanceCollectNow is > 0m)
            {
                var newTotalPaid = SelectedStall.AmountPaid + BalanceCollectNow.Value;
                var status = newTotalPaid >= SelectedStall.MonthlyRate ? PaymentStatus.Paid : PaymentStatus.Partial;

                await QueueBalanceCollectionAsync(
                    status,
                    newTotalPaid,
                    !string.IsNullOrWhiteSpace(BalanceOrNumber) ? BalanceOrNumber.Trim() : null);
                await SavePenaltiesAsync();

                CloseCollectBalance();
                return;
            }

            CollectBalanceError = "The connection is too weak to reach the office. Try again where the signal is better.";
        }
        catch (Exception)
        {
            CollectBalanceError = "Unable to save the payment. Nothing was recorded.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ConfirmCollectBalanceCoreAsync()
    {
        if (SelectedStall is null || Collection is null) return;

        var balance = SelectedStall.Balance;
        if (BalanceCollectNow is null or <= 0m)
        {
            CollectBalanceError = "Enter an amount greater than 0.";
            return;
        }
        if (BalanceCollectNow.Value > balance)
        {
            CollectBalanceError = $"Amount can't exceed the remaining balance of {FormatCurrency(balance)}.";
            return;
        }

        // PartialAmount is the ABSOLUTE total paid; add what's collected now. Clearing the balance
        // (or reaching the monthly rate) marks the stall Paid — the domain also auto-upgrades.
        var newTotalPaid = SelectedStall.AmountPaid + BalanceCollectNow.Value;
        var status = newTotalPaid >= SelectedStall.MonthlyRate ? PaymentStatus.Paid : PaymentStatus.Partial;
        var orNumber = !string.IsNullOrWhiteSpace(BalanceOrNumber) ? BalanceOrNumber.Trim() : null;
        // Clearing the balance also clears the account's penalties on the same receipt, confirmed before anything is recorded.
        IsSaving = true;
        CollectBalanceError = null;
        if (ClearsBalance && !await QuotePenaltiesAsync(SelectedStall.RentCanonical ? null : orNumber, e => CollectBalanceError = e))
        {
            IsSaving = false;
            return;
        }
        IsSaving = false;
if (SelectedStall.RentCanonical)        {            IsSaving = true;            if (await CaptureCanonicalRentAsync(BalanceCollectNow.Value)) await SavePenaltiesAsync();            CloseCollectBalance();            await LoadCollectionAsync();            IsSaving = false;            return;        }

        IsSaving = true;
        CollectBalanceError = null;

        if (!Sync.IsOnline)
        {
            await QueueBalanceCollectionAsync(status, newTotalPaid, orNumber);
            await SavePenaltiesAsync();
            CloseCollectBalance();
            IsSaving = false;
            return;
        }

        var request = new RecordMobileMonthlyCollectionRequest(
            SelectedStall.StallId,
            status,
            status == PaymentStatus.Partial ? newTotalPaid : null,
            orNumber);

        var result = await MobileApi.RecordMonthlyCollectionAsync(request);
        if (!result.IsSuccess)
        {
            // A thin signal is the same situation as no signal for the collector standing at the space, and it is answered the
            // same way: the payment goes to the queue and replays idempotently. Transient failures only; a definitive refusal is
            // the server's ruling and is shown, never queued, or it would replay for ever.
            if (IsTransientFailure(result.StatusCode))
            {
                await QueueBalanceCollectionAsync(status, newTotalPaid, orNumber);
                await SavePenaltiesAsync();
                CloseCollectBalance();
                IsSaving = false;
                return;
            }

            CollectBalanceError = result.Error ?? "Unable to save the payment.";
            IsSaving = false;
            return;
        }

        await SavePenaltiesAsync();
        CloseCollectBalance();
        try
        {
            await LoadCollectionAsync();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenSheet(MobileMonthlyStallCollectionDto stall)
    {
        SelectedStall = stall;
        SelectedStatus = stall.Status == PaymentStatus.Unpaid ? PaymentStatus.Paid : stall.Status;
        PartialAmount = stall.Status == PaymentStatus.Partial ? stall.AmountPaid : null;
        ORNumber = stall.ORNumber ?? string.Empty;
        SheetError = null;
        ShowSheet = true;
        _earlier = [];
        _ = LoadEarlierAsync(stall.StallId);
        // A month already paid is opened here only to edit its record; its penalties are collected from their own sheet, never by an edit.
        if (stall.Status != PaymentStatus.Paid) LoadPenalties(stall);
    }

    // The space's unpaid months before the one on screen, read live each time the sheet opens (never from a device cache). Empty when none or unreadable:
    // the card only adds information, and the server still refuses a newer month while an older one is open.
    private IReadOnlyList<MobileUnpaidMonthDto> _earlier = [];

    private async Task LoadEarlierAsync(Guid stallId)
    {
        try
        {
            var result = await MobileApi.GetUnpaidMonthsAsync(stallId);
            if (!result.IsSuccess || result.Value is not { } months || SelectedStall?.StallId != stallId) return;
            var shown = new DateOnly(SelectedYear, SelectedMonth, 1);
            _earlier = months.Where(m => m.BalanceDue > 0m && new DateOnly(m.Year, m.Month, 1) < shown).OrderBy(m => m.Year).ThenBy(m => m.Month).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { /* offline or refused: the sheet works without the card */ }
    }

    private void OpenEarlier()
    {
        if (SelectedStall is not { } stall) return;
        Navigation.NavigateTo($"/arrears/months?stall={stall.StallId}&back={Uri.EscapeDataString("/collect/" + Facility)}"
            + $"&payer={Uri.EscapeDataString(stall.PayorName)}&space={Uri.EscapeDataString("Stall " + stall.StallNo)}");
    }

    private void SelectStatus(PaymentStatus status)
    {
        SelectedStatus = status;
        SheetError = null;
    }

    /// <summary>
    /// Records the sheet's payment, and is answerable for the sheet never being left locked.
    /// </summary>
    /// <remarks>
    /// The write throws on a timeout and nothing caught it, so <c>IsSaving</c> stayed true for the life of the page with Cancel
    /// disabled beside it: a thin signal became a dead screen and the only way out was killing the app. IsSaving is now cleared in
    /// a finally, and a connectivity-shaped failure queues the payment the way being offline already does.
    /// </remarks>
    private async Task ConfirmAsync()
    {
        try
        {
            await ConfirmCoreAsync();
        }
        catch (Exception ex) when (IsConnectivityShaped(ex))
        {
            if (await QueueMonthlyCollectionAsync())
            {
                await SavePenaltiesAsync();
                CloseSheet();
                return;
            }

            SheetError = "The connection is too weak to reach the office. Try again where the signal is better.";
        }
        catch (Exception)
        {
            SheetError = "Unable to save the payment. Nothing was recorded.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    /// <summary>A failure the collector cannot answer for: no usable response, or the office's own server faulting.</summary>
    /// <remarks>
    /// Deliberately narrow. A definitive refusal is the server's ruling and belongs on the screen; queueing it would replay that
    /// refusal every time the signal returned.
    /// </remarks>
    private static bool IsTransientFailure(int? statusCode) => statusCode is null or 0 or >= 500;

    /// <summary>A timeout or an unreachable server, as opposed to a fault in this app.</summary>
    private static bool IsConnectivityShaped(Exception ex) =>
        ex is HttpRequestException or TaskCanceledException or OperationCanceledException;

    /// <summary>
    /// Writes the sheet's payment to the on-device queue, to replay when the signal returns.
    /// </summary>
    /// <returns>
    /// False where the answer cannot be queued, which is "Unpaid": it carries no money to replay and is a plain state change the
    /// server must make, so it has to be recorded online or not at all.
    /// </returns>
    private async Task<bool> QueueMonthlyCollectionAsync()
    {
        if (SelectedStall is null || SelectedStatus == PaymentStatus.Unpaid)
            return false;

        await Sync.EnqueueAsync(new PendingOperation
        {
            Kind = OfflineOperationKind.MonthlyRental,
            BusinessDate = new DateOnly(SelectedYear, SelectedMonth, 1),
            StallId = SelectedStall.StallId,
            Status = SelectedStatus,
            PartialAmount = SelectedStatus == PaymentStatus.Partial ? PartialAmount : null,
            ORNumber = !string.IsNullOrWhiteSpace(ORNumber) ? ORNumber.Trim() : null,
            FacilityLabel = FacilityCodeUpper,
            Title = SelectedStall.PayorName,
            Detail = $"No. {SelectedStall.StallNo}",
            Amount = SelectedStatus == PaymentStatus.Partial ? (PartialAmount ?? 0m) : SelectedStall.MonthlyRate
        });

        QueuedOfflineStalls.Add(SelectedStall.StallId); // reflect immediately on the card
        return true;
    }

    /// <summary>Writes a balance collection to the on-device queue, to replay when the signal returns.</summary>
    private async Task QueueBalanceCollectionAsync(PaymentStatus status, decimal newTotalPaid, string? orNumber)
    {
        if (SelectedStall is null)
            return;

        await Sync.EnqueueAsync(new PendingOperation
        {
            Kind = OfflineOperationKind.MonthlyRental,
            BusinessDate = new DateOnly(SelectedYear, SelectedMonth, 1),
            StallId = SelectedStall.StallId,
            Status = status,
            PartialAmount = status == PaymentStatus.Partial ? newTotalPaid : null,
            ORNumber = orNumber,
            FacilityLabel = FacilityCodeUpper,
            Title = SelectedStall.PayorName,
            Detail = $"No. {SelectedStall.StallNo} · balance",
            Amount = BalanceCollectNow ?? 0m
        });

        QueuedOfflineStalls.Add(SelectedStall.StallId);
    }

    // Canonical rent (IA-051/IA-062): the amount is what is collected now against a canonical PaymentRecord. No OR number is asked
    // for; the collection is queued under its ClientOperationId and the server returns the SRC when it syncs.
    private string? RentNotice;

    /// <returns>False when the rent was refused or could not be saved; true once it is recorded or safely queued.</returns>
    private async Task<bool> CaptureCanonicalRentAsync(decimal amount)
    {
        if (SelectedStall is not { RentCanonical: true } stall) return false;
        var operationId = Guid.NewGuid();
        try
        {
            await Sync.EnqueueIssuedDocumentAsync(new PendingOperation
            {
                ClientOperationId = operationId,
                Kind = OfflineOperationKind.RentCollection,
                PayloadVersion = 1,
                BusinessDate = Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now),
                StallId = stall.StallId,
                BillingYear = SelectedYear,
                BillingMonth = SelectedMonth,
                ReceivedAmount = amount,
                RentSourceVersion = stall.RentSourceVersion,
                FacilityLabel = FacilityCodeUpper,
                Title = stall.PayorName,
                Detail = $"No. {stall.StallNo} · {MonthLabel}",
                Amount = amount
            });
            RentNotice = "Saved on this device. Waiting to sync.";
            if (Sync.IsOnline)
                await Sync.SyncNowAsync(force: true);
            var result = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == operationId);
            if (result?.LocalStatus == PendingLocalStatus.Synced)
                RentNotice = result.ReferenceCode is { } src ? $"Collection recorded · {src}" : "Collection recorded.";
            else if (result?.LocalStatus is PendingLocalStatus.Rejected or PendingLocalStatus.ReconciliationRequired)
            {
                RentNotice = result.ResultMessage ?? "The server could not accept this collection. It was not recorded.";
                return false;
            }
            else
                QueuedOfflineStalls.Add(stall.StallId);
            return true;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            RentNotice = "The collection could not be safely saved on this device. Do not rely on it; resolve device storage attention first.";
            return false;
        }
    }

    private async Task ConfirmCoreAsync()
    {
        if (SelectedStall is null || Collection is null)
            return;

        if (SelectedStatus == PaymentStatus.Partial && (PartialAmount is null or <= 0))
        {
            SheetError = "Enter the partial amount collected (greater than 0).";
            return;
        }

        // Paying the month in full also clears the account's penalties on the same receipt. They are confirmed first; if they cannot be,
        // nothing at all is recorded.
        IsSaving = true;
        SheetError = null;
        if (SelectedStatus == PaymentStatus.Paid && SelectedStall.Status != PaymentStatus.Paid
            && !await QuotePenaltiesAsync(SelectedStall.RentCanonical ? null : ORNumber, e => SheetError = e))
        {
            IsSaving = false;
            return;
        }
        IsSaving = false;

if (SelectedStall.RentCanonical && SelectedStatus != PaymentStatus.Unpaid)        {            var now = SelectedStatus == PaymentStatus.Paid ? SelectedStall.Balance : Math.Max(0m, (PartialAmount ?? 0m) - SelectedStall.AmountPaid);            if (now <= 0m) { SheetError = "Nothing to collect for this amount."; return; }            IsSaving = true;            if (await CaptureCanonicalRentAsync(now)) await SavePenaltiesAsync();            CloseSheet();            await LoadCollectionAsync();            IsSaving = false;            return;        }
        IsSaving = true;
        SheetError = null;

        // Offline: queue Paid/Partial collections locally; "Unpaid" is a no-money state change needing the server.
        if (!Sync.IsOnline)
        {
            if (SelectedStatus == PaymentStatus.Unpaid)
            {
                SheetError = "You're offline. Marking a stall 'Unpaid' needs a connection.";
                IsSaving = false;
                return;
            }

            await QueueMonthlyCollectionAsync();
            await SavePenaltiesAsync();
            CloseSheet();
            IsSaving = false;
            return;
        }

        var request = new RecordMobileMonthlyCollectionRequest(
            SelectedStall.StallId,
            SelectedStatus,
            SelectedStatus == PaymentStatus.Partial ? PartialAmount : null,
            SelectedStatus != PaymentStatus.Unpaid && !string.IsNullOrWhiteSpace(ORNumber) ? ORNumber.Trim() : null);

        var result = await MobileApi.RecordMonthlyCollectionAsync(request);
        if (!result.IsSuccess)
        {
            // A thin signal is answered as no signal is: the payment goes to the queue and replays idempotently. Transient
            // failures only, and never for "Unpaid" - that carries no money to replay and the offline branch above refuses it
            // too, so the guard inside the queue write covers both paths.
            if (IsTransientFailure(result.StatusCode) && await QueueMonthlyCollectionAsync())
            {
                await SavePenaltiesAsync();
                CloseSheet();
                IsSaving = false;
                return;
            }

            SheetError = result.Error ?? "Unable to save the payment.";
            IsSaving = false;
            return;
        }

        RentNotice = SelectedStatus == PaymentStatus.Unpaid ? "Status updated successfully." : "Payment recorded successfully.";
        await SavePenaltiesAsync();
        CloseSheet();
        try
        {
            await LoadCollectionAsync();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void CloseSheet()
    {
        ShowSheet = false;
        ShowPenalties = false;
        SelectedStall = null;
        _earlier = [];
        SelectedStatus = PaymentStatus.Paid;
        PartialAmount = null;
        ORNumber = string.Empty;
        SheetError = null;
        ResetPenalties();
    }

    // ── Penalties on the account (surcharge, interest, assessed fines) ──
    // Read live from the server when a sheet opens (never from a device cache) and collected IN FULL on the rent's receipt, through the account's own
    // fine source: one checkout, every open penalty at its remaining amount, no choosing. The rent keeps its own writer; nothing here prices anything.
    private IReadOnlyList<CollectionSessionSourceChoice>? _penalties;
    private bool _penaltiesLoading;
    private bool _penaltiesUnreadable;
    private RecordCollectionSessionRequest? _penaltyCheckout; // quoted, not yet saved
    private bool ShowPenalties;
    private HashSet<Guid> QueuedPenaltyContracts = new();

    private static bool HasPenalties(MobileMonthlyStallCollectionDto stall) => stall.PenaltiesDue > 0m && stall.ContractId is not null;
    private decimal PenaltiesOpen => _penalties is { } open ? AccountPenalties.Total(open) : 0m;

    // The account's open penalties as register rows (Surcharge, Interest, …) and the total collected together with `rent` on one receipt.
    // A template of this page so the page's own scoped styles apply.
    private RenderFragment PenaltyRows(decimal rent) =>@<dl class="money-rows" aria-label="Penalties">
        @if (_penalties is { Count: > 0 } open)
        {
            @foreach (var line in AccountPenalties.Lines(open))
            {
                <div class="money-row"><dt>@line.Name</dt><dd>@FormatCurrency(line.Amount)</dd></div>
            }
            <div class="money-row strong"><dt>@(rent > 0m ? "Total amount due" : "Total penalties")</dt><dd>@FormatCurrency(rent + AccountPenalties.Total(open))</dd></div>
        }
        else if (_penaltiesLoading)
        {
            <div class="money-row"><dt>Penalties</dt><dd>Loading…</dd></div>
        }
        else if (_penaltiesUnreadable)
        {
            <div class="money-row"><dt>Penalties @FormatCurrency(SelectedStall?.PenaltiesDue ?? 0m)</dt><dd>Not included · offline</dd></div>
        }
        else
        {
            <div class="money-row"><dt>Penalties</dt><dd>None open to collect</dd></div>
        }
    </dl>;

    private void ResetPenalties()
    {
        _penalties = null;
        _penaltiesLoading = _penaltiesUnreadable = false;
        _penaltyCheckout = null;
    }

    private void OpenPenalties(MobileMonthlyStallCollectionDto stall)
    {
        SelectedStall = stall;
        ORNumber = string.Empty;
        SheetError = null;
        ShowPenalties = true;
        LoadPenalties(stall);
    }

    private void LoadPenalties(MobileMonthlyStallCollectionDto stall)
    {
        ResetPenalties();
        if (!HasPenalties(stall)) return;
        if (!Sync.IsOnline) { _penaltiesUnreadable = true; return; }
        _penaltiesLoading = true;
        _ = LoadPenaltiesAsync(stall);
    }

    private async Task LoadPenaltiesAsync(MobileMonthlyStallCollectionDto stall)
    {
        IReadOnlyList<CollectionSessionSourceChoice>? open = null;
        try
        {
            var result = await MobileApi.GetSourceCollectionDiscoveryAsync(new(SourceIdentityKind.Occupancy, stall.ContractId!.Value));
            if (result.IsSuccess) open = AccountPenalties.Open(result.Value);
        }
        catch (Exception) { /* offline or refused: the sheet says the penalties need a connection */ }
        if (SelectedStall?.StallId != stall.StallId) return;
        _penalties = open;
        _penaltiesUnreadable = open is null;
        _penaltiesLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prices every open penalty of the selected account as one checkout BEFORE any money is recorded. False, with the reason on the sheet, when they
    /// cannot be confirmed: nothing is recorded then, so the collector never takes the whole total while only the rent is saved.
    /// </summary>
    private async Task<bool> QuotePenaltiesAsync(string? receiptNumber, Action<string> fail)
    {
        _penaltyCheckout = null;
        if (_penalties is not { Count: > 0 } open || SelectedStall?.ContractId is not { } contractId) return true;
        try
        {
            var intent = AccountPenalties.Intent(Guid.NewGuid(), Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now), contractId, open, receiptNumber);
            var quote = await MobileApi.QuoteCollectionSessionAsync(intent);
            if (quote.IsSuccess && quote.Value is { CanRecord: true } q)
            {
                _penaltyCheckout = new(intent, q.QuoteFingerprint);
                return true;
            }
            fail((quote.Value?.Problems.FirstOrDefault()?.Message ?? "The penalties could not be confirmed.") + " Nothing was recorded.");
        }
        catch (Exception)
        {
            fail("Couldn't reach the office to confirm the penalties. Nothing was recorded; try again where the signal is better.");
        }
        return false;
    }

    /// <summary>
    /// Saves the quoted penalties on this device (the durable boundary, as every checkout is) and records them now when online. Called only once the
    /// rent itself was recorded or queued. A refusal is said plainly; the queued item also stays in Records until it is resolved.
    /// </summary>
    private async Task<PendingLocalStatus?> SavePenaltiesAsync()
    {
        if (_penaltyCheckout is not { } checkout) return null;
        _penaltyCheckout = null;
        try
        {
            await Sync.EnqueueCollectionSessionAsync(checkout);
            if (Sync.IsOnline)
                await Sync.SyncNowAsync(force: true);
            var saved = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == checkout.Intent.ClientCollectionSessionId);
            if (saved?.LocalStatus is PendingLocalStatus.Rejected or PendingLocalStatus.ReconciliationRequired)
                RentNotice = $"The penalties were not recorded: {saved.ResultMessage ?? "the office could not accept them."} Review them in Records.";
            else if (saved?.LocalStatus is PendingLocalStatus.Synced)
                QueuedPenaltyContracts.Remove(checkout.Intent.SourceIdentity!.Id);
            else
                QueuedPenaltyContracts.Add(checkout.Intent.SourceIdentity!.Id); // reflect immediately on the card
            return saved?.LocalStatus;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            RentNotice = "The penalties could not be saved on this device and were not recorded. Collect them again from this account.";
            return null;
        }
    }

    private async Task ConfirmPenaltiesAsync()
    {
        if (SelectedStall is null || IsSaving) return;
        IsSaving = true;
        SheetError = null;
        try
        {
            if (!await QuotePenaltiesAsync(ORNumber, e => SheetError = e)) return;
            var status = await SavePenaltiesAsync();
            if (status == PendingLocalStatus.Synced) RentNotice = "Payment recorded successfully.";
            else if (status is PendingLocalStatus.Pending or PendingLocalStatus.Failed) RentNotice = "Saved on this device. Waiting to sync.";
            CloseSheet();
            await LoadCollectionAsync();
        }
        finally
        {
            IsSaving = false;
        }
    }

    // Whole pesos as before; centavos only when an amount has them (interest often does), so no figure is shown rounded.
    private static string FormatCurrency(decimal value) => value == decimal.Truncate(value) ? $"₱{value:N0}" : $"₱{value:N2}";

    // The not-yet-collected states (unpaid rent, or paid rent with penalties still open) get the prominent "Collect" action; everything else is view-only.
    private bool IsCollectAction(MobileMonthlyStallCollectionDto stall) => ActionLabel(stall) == "Collect";

    private string ActionLabel(MobileMonthlyStallCollectionDto stall)
    {
        if (IsQueuedOffline(stall)) return "View";
        if (stall.Status == PaymentStatus.Unpaid) return "Collect";
        if (stall.AwaitingOr && stall.OnlinePaymentTransactionId.HasValue) return "Encode OR";
        if (stall.Status == PaymentStatus.Paid && HasPenalties(stall)) return "Collect";
        return "View Receipt";
    }

    private static string GetBadgeClass(MobileMonthlyStallCollectionDto stall) =>
        IsSettled(stall) ? "badge-paid" :
        stall.Status != PaymentStatus.Unpaid ? "badge-partial" :
        "badge-unpaid";

    // Status-coloured left accent for the card (paid = green, partial or penalties due = gold, else neutral).
    private static string MonthBarClass(MobileMonthlyStallCollectionDto stall) =>
        IsSettled(stall) ? "bar-paid" :
        stall.Status != PaymentStatus.Unpaid ? "bar-partial" :
        string.Empty;
}
