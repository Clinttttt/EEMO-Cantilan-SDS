@page "/collections/new"
@page "/ecf"
@page "/weight-measure"
@page "/vendor-fee"
@page "/income-terminal"
@using EEMOCantilanSDS.Domain.Constants
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@inject EEMOCantilanSDS.Application.Common.Interface.ApiClients.IMobileApiClient Api

<div class="page-shell">
    <div class="header">
        <div class="header-eyebrow">@(CorrectId is not null ? "Correction" : OnlyOperation is null ? "Collection" : "Operation")</div>
        <div class="header-row">
            <button class="back-btn" type="button" aria-label="Back to Menu" @onclick='() => Navigation.NavigateTo("/menu")'><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg></button>
            <div class="header-title-block"><div class="header-title">@Title</div><div class="header-sub">@Session.CollectorName</div></div>
            <img class="header-logo" src="@Session.BrandingSeal" alt="Municipality seal" />
        </div>
    </div>
    <main class="content collection-workspace">
        @if (_ready && CorrectId is not null && _correction is null) { <p class="collection-message" role="status">This collection can't be edited. It may be remitted, from an earlier day, or already corrected.</p> }
        else if (_ready) { <CollectionSessionEditor @key="(OnlyOperation, SessionId, CorrectId)" Correction="_correction" BusinessDate="@Today" OnlyOperation="@OnlyOperation" AlsoOperations="@AlsoOperations" ResumeSessionId="@SessionId" /> }
    </main>
    <BottomNav ActiveTab="menu" />
</div>

@code {
    [SupplyParameterFromQuery] public Guid? SessionId { get; set; }
    [SupplyParameterFromQuery(Name = "operation")] public string? RequestedSpaceOperation { get; set; }

    /// <summary>The recent collection being edited (opened from Today's recent collections).</summary>
    [SupplyParameterFromQuery(Name = "correct")] public Guid? CorrectId { get; set; }
    private EEMOCantilanSDS.Application.Dtos.Mobile.MobileRecentCollection? _correction;
    private bool _ready;
    private DateOnly Today => Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now);
    // Only space-obligation codes may be supplied by the menu deep link; all other values fall back to normal New Collection.
    private string? OnlyOperation => CorrectId is not null ? null : Last switch
    {
        "ecf" => "ECF",
        "weight-measure" => "WEIGHT_AND_MEASURE",
        "vendor-fee" => "FISH_MEAT_VENDOR_FEE",
        "income-terminal" => "TERMINAL",
        _ => CollectorOperationCodes.IsSpaceObligation(RequestedSpaceOperation) ? RequestedSpaceOperation : null
    };
    // The Fish / Meat page is the collection family, not one item: a registered vendor can pay the Vendor Fee and Weight & Measure here, as in New Collection.
    private IReadOnlyCollection<string>? AlsoOperations => Last == "vendor-fee" ? ["WEIGHT_AND_MEASURE"] : null;
    private string Last => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Split('/').Last().ToLowerInvariant();
    private string Title => CorrectId is not null ? "Edit collection" : OnlyOperation switch
    {
        "ECF" => "Electricity Consumption Fee",
        "WEIGHT_AND_MEASURE" => "Weight & Measure",
        "FISH_MEAT_VENDOR_FEE" => "Fish / Meat Collection",
        "TERMINAL" => "Income From Terminal",
        CollectorOperationCodes.KanmanggaySpaceRental => "Kanmanggay Space Rental",
        CollectorOperationCodes.FiestaArawLotRental => "Fiesta / Araw Lot Rental",
        _ => "New Collection"
    };
    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.Menu is null) { Navigation.NavigateTo("/login"); return; }
    }

    private Guid? _loadedCorrectId;
    private string? _loadedOnlyOperation;

    // Editing navigates from this same page to /collections/new?correct=..., which reuses this component: the correction is therefore resolved whenever the
    // query changes, not only on first load. Only what the server still lets this collector edit opens, taken from the same recent list that offered it.
    protected override async Task OnParametersSetAsync()
    {
        if (Session.Menu is null || (_ready && CorrectId == _loadedCorrectId && OnlyOperation == _loadedOnlyOperation)) return;
        _ready = false;
        _correction = null;
        if (CorrectId is { } id)
        {
            var recent = await Api.GetRecentCollectionsAsync();
            _correction = recent.IsSuccess ? recent.Value?.Rows.FirstOrDefault(r => r.Collection.CollectionId == id && r.CanEdit) : null;
        }
        _loadedCorrectId = CorrectId;
        _loadedOnlyOperation = OnlyOperation;
        _ready = true;
    }
}
