@page "/menu"
@using global::EEMOCantilanSDS.Application.Dtos.Mobile
@using global::EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Mobile.Presentation
@using EEMOCantilanSDS.Mobile.Services
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync
@inject global::EEMOCantilanSDS.Application.Common.Interface.ApiClients.IMobileApiClient MobileApi

<div class="page-shell">
    <AppHeader CollectorName="@Session.CollectorName" />

    <main class="content">
        @if (Update is not null && !Update.Mandatory)
        {
            <div class="update-banner" role="status">
                @* The version on offer comes from the server's own answer, so the banner names it rather than saying
                   "a new version" and leaving the collector to guess what they are being asked to install. *@
                <div class="update-banner-text">@(string.IsNullOrWhiteSpace(Update.LatestVersion) ? "A new version is available." : $"Version {Update.LatestVersion} is available.")</div>
                <button class="update-banner-btn" type="button" @onclick="DownloadUpdate">Update</button>
                <button class="update-banner-x" type="button" @onclick="() => Update = null" aria-label="Dismiss">×</button>
            </div>
        }
        @if (IsLoading)
        {
            <div class="menu-skeleton" aria-busy="true" aria-label="Loading today's work">
                <div class="sk-line sk-title"></div>
                <div class="sk-line"></div>
                <div class="sk-line"></div>
                <div class="sk-line"></div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="menu-state error" role="alert">@ErrorMessage</div>
        }
        else
        {
            <h1 class="menu-title">Today's work</h1>

            @if (Work.Attention.Count > 0)
            {
                <section class="menu-group attention" aria-labelledby="menu-attention">
                    <h2 id="menu-attention" class="menu-group-title">Needs attention</h2>
                    <ul class="menu-list">
                        @foreach (var item in Work.Attention)
                        {
                            <li>
                                <button class="menu-row" type="button" @onclick='() => Navigation.NavigateTo("/records", forceLoad: false)'>
                                    <span class="menu-row-main">
                                        <span class="menu-row-name">@(item.Count > 1 ? $"{item.Count} " : "")@item.Text</span>
                                    </span>
                                    <span class="menu-row-chevron" aria-hidden="true">›</span>
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="menu-group" aria-labelledby="menu-available">
                <h2 id="menu-available" class="menu-group-title">Available now</h2>
                @if (Work.Available.Count == 0)
                {
                    <div class="menu-state">Nothing is ready to collect right now.</div>
                }
                else
                {
                    <ul class="menu-list">
                        @foreach (var item in Work.Available)
                        {
                            <li>
                                @if (item.CanOpen)
                                {
                                    <button class="menu-row" type="button" @onclick="() => Open(item)">
                                        <span class="menu-row-main">
                                            <span class="menu-row-name">@item.Name</span>
                                            <span class="menu-row-status ready">@item.Status</span>
                                        </span>
                                        <span class="menu-row-chevron" aria-hidden="true">›</span>
                                    </button>
                                }
                                else
                                {
                                    @* Ready, but collected from inside another screen (for example WCF from a market stall). *@
                                    <div class="menu-row plain">
                                        <span class="menu-row-main">
                                            <span class="menu-row-name">@item.Name</span>
                                            <span class="menu-row-status ready">@item.Status · collected from the stall sheet</span>
                                        </span>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (Work.AssignedUnavailable.Count > 0)
            {
                @* Assignment alone is never collectibility: these are plain status rows with no action. *@
                <section class="menu-group" aria-labelledby="menu-unavailable">
                    <h2 id="menu-unavailable" class="menu-group-title">Assigned, not available</h2>
                    <ul class="menu-list">
                        @foreach (var item in Work.AssignedUnavailable)
                        {
                            <li>
                                <div class="menu-row plain">
                                    <span class="menu-row-main">
                                        <span class="menu-row-name">@item.Name</span>
                                        <span class="menu-row-status">@item.Status</span>
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (OperationsUnavailable)
            {
                <div class="menu-state" role="status">Some assigned operations could not be checked. Retry while online.</div>
            }

            @if (!Facilities.Any(f => f.IsAssigned) && Operations.Count == 0 && !OperationsUnavailable)
            {
                <div class="menu-state">Nothing is assigned to this account yet. Ask the office to assign your collections.</div>
            }
        }
    </main>

    <BottomNav ActiveTab="menu" />

    @if (Update is not null && Update.Mandatory)
    {
        <div class="update-overlay" role="alertdialog" aria-modal="true" aria-labelledby="update-title">
            <div class="update-modal">
                <div id="update-title" class="update-modal-title">Update required</div>
                <div class="update-modal-sub">This version is no longer supported.@(string.IsNullOrWhiteSpace(Update.LatestVersion) ? " Please update to continue using StallTrack." : $" Please install version {Update.LatestVersion} to continue using StallTrack.")</div>
                @if (!string.IsNullOrWhiteSpace(Update.Notes))
                {
                    <div class="update-modal-notes">@Update.Notes</div>
                }
                <button class="update-modal-btn" type="button" @onclick="DownloadUpdate">Download update</button>
            </div>
        </div>
    }
</div>

@code {
    bool IsLoading = true;
    string ErrorMessage = string.Empty;
    AppUpdateInfo? Update;

    IReadOnlyList<MobileFacilityMenuItemDto> Facilities =>
        Session.Menu?.Facilities ?? Array.Empty<MobileFacilityMenuItemDto>();

    // Non-facility operations (WCF, Landing/Berthing, …) come from GET api/Mobile/operations/capabilities. A failed read
    // is shown as "could not be checked", never as "none assigned"; it does not block the facility menu.
    IReadOnlyList<CollectorOperationCapabilityDto> Operations = Array.Empty<CollectorOperationCapabilityDto>();
    IReadOnlyList<EEMOCantilanSDS.Mobile.Models.PendingOperation> Queue = Array.Empty<EEMOCantilanSDS.Mobile.Models.PendingOperation>();
    bool OperationsUnavailable;

    TodaysWork Work => TodaysWorkBuilder.Build(Facilities, Operations, Queue);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Session.InitializeAsync();

            if (Session.Menu is null)
            {
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            await LoadOperationCapabilitiesAsync();
            Queue = await Sync.GetAllAsync();

            // Best-effort update check (once per session; internally fail-open → no prompt on any failure).
            Update = await Session.GetUpdateInfoAsync();
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Unable to connect to the server. Please check the connection and try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    async Task LoadOperationCapabilitiesAsync()
    {
        try
        {
            var result = await MobileApi.GetOperationCapabilitiesAsync();
            OperationsUnavailable = !result.IsSuccess || result.Value is null;
            Operations = OperationsUnavailable
                ? Array.Empty<CollectorOperationCapabilityDto>()
                : result.Value!.Operations.Where(x => x.IsAssigned).ToList();
        }
        catch (HttpRequestException)
        {
            OperationsUnavailable = true;
        }
    }

    void Open(WorkItem item)
    {
        if (!item.CanOpen)
            return;

        if (item.Target == WorkTarget.Operation && item.OperationCode is not null)
            Navigation.NavigateTo($"/operation/{Uri.EscapeDataString(item.OperationCode)}", forceLoad: false);
        else if (item.Target == WorkTarget.Facility)
        {
            var facility = Facilities.FirstOrDefault(f => f.Code.ToString() == item.FacilityCode);
            if (facility is not null)
                OpenFacility(facility);
        }
    }

    async Task DownloadUpdate()
    {
        if (Update is null)
        {
            return;
        }

        try
        {
            // Opens the APK URL in the browser to download; the user taps to install (side-loaded apps
            // cannot self-install silently).
            await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(Update.ApkUrl);
        }
        catch
        {
            // Best-effort — a launch failure just leaves the prompt visible.
        }
    }

    void OpenFacility(MobileFacilityMenuItemDto facility)
    {
        // Guard: only assigned + built facilities are navigable. The server independently
        // enforces assignment on every collection endpoint, so this is UX-only defence.
        if (!facility.IsAvailable)
        {
            return;
        }

        // Route by billing ARCHETYPE, not a fixed code list, so a tenant's custom facility (which bills as
        // MonthlyRental) opens the monthly collection screen instead of being unreachable.
        switch (facility.Archetype)
        {
            case BillingArchetype.DailyStall:
                Navigation.NavigateTo("/market", forceLoad: false);
                break;
            case BillingArchetype.MonthlyRental:
                Navigation.NavigateTo($"/collect/{facility.Code}", forceLoad: false);
                break;
            case BillingArchetype.PerHead:
                Navigation.NavigateTo("/slaughter", forceLoad: false);
                break;
            case BillingArchetype.PerTrip:
                Navigation.NavigateTo("/terminal", forceLoad: false);
                break;
            case BillingArchetype.WeeklyMarket:
                Navigation.NavigateTo("/taboan", forceLoad: false);
                break;
        }
    }

}
