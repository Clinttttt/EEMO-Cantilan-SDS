@page "/npm/whole-payment/{StallId:guid}"
@using global::EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using global::EEMOCantilanSDS.Application.Dtos.Mobile
@using EEMOCantilanSDS.Mobile.Models
@using EEMOCantilanSDS.Mobile.Services
@inject IMobileApiClient Api
@inject MobileSyncService Sync
@inject NavigationManager Navigation
@inject MobileSessionService Session

<div class="page-shell">
    <div class="header">
        <div class="header-eyebrow">Facility</div>
        <div class="header-row">
            <button type="button" class="back-btn" aria-label="Back to stalls" @onclick='() => Navigation.NavigateTo("/market")'><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg></button>
            <div class="header-title-block"><div class="header-title">New Public Market</div><div class="header-sub">Stall collection</div></div>
            <img class="header-logo" src="@Session.BrandingSeal" alt="Municipality seal" />
        </div>
    </div>
    <main class="whole-workspace">
        <div class="whole-modes" aria-label="Payment type">
            <button type="button" @onclick='() => Navigation.NavigateTo("/market")'>Daily</button>
            <button type="button" class="selected" aria-pressed="true">Whole payment</button>
        </div>
        <h1>@Occupant</h1>
        <p class="whole-payor">Stall @SpaceNo</p>
        <div class="whole-period" role="group" aria-label="Period">
            <MobileChoice @ref="MonthChoice" Label="Month" Options="MonthOptions" Value="@Month.ToString()" ValueChanged="ChooseMonthAsync" Disabled="@(Saving || Captured)" Popover="true" OnOpening="CloseYear" />
            <MobileChoice @ref="YearChoice" Label="Year" Options="YearOptions" Value="@Year.ToString()" ValueChanged="ChooseYearAsync" Disabled="@(Saving || Captured)" Popover="true" OnOpening="CloseMonth" />
        </div>
        @if (Loading)
        {
            <p role="status">Loading amount…</p>
        }
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="whole-error" role="alert">@Error</p>
        }
        @if (Quote is { } quote)
        {
            <NpmWholeSummary Quote="quote" />
            @if (!Sync.IsOnline) { <p class="whole-note">Offline · last reviewed amount. The server verifies it when synced.</p> }
            @if (!Captured)
            { <button type="button" class="btn-primary whole-confirm" disabled="@(Saving || quote.Amount <= 0m || quote.Year != Year || quote.Month != Month)" @onclick="ConfirmAsync">
                @(Saving ? "Recording…" : quote.Amount <= 0m ? "Nothing remaining" : "Confirm whole payment")
            </button> }
        }
        @if (!string.IsNullOrWhiteSpace(Notice)) { <div class="state-card" role="status">@Notice</div> }
    </main>
    <BottomNav ActiveTab="menu" />
</div>

@code {
    [Parameter] public Guid StallId { get; set; }
    [SupplyParameterFromQuery] public int Year { get; set; }
    [SupplyParameterFromQuery] public int Month { get; set; }
    [SupplyParameterFromQuery] public string? Occupant { get; set; }
    [SupplyParameterFromQuery] public string? SpaceNo { get; set; }
    private NpmWholePaymentQuoteDto? Quote;
    private MobileChoice? MonthChoice, YearChoice;
    private void CloseYear() => YearChoice?.Close();
    private void CloseMonth() => MonthChoice?.Close();
    private bool Loading, Saving, Captured;
    private string? Error, Notice;
    private readonly Guid OperationId = Guid.NewGuid();

    private static readonly IReadOnlyList<MobileChoice.Choice> MonthOptions = Enumerable.Range(1, 12)
        .Select(m => new MobileChoice.Choice(m.ToString(), System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m))).ToArray();
    private IReadOnlyList<MobileChoice.Choice> YearOptions => Enumerable.Range(Math.Min(Year, DateTime.Now.Year) - 2, 4 + Math.Max(0, Year - DateTime.Now.Year)).Select(y => new MobileChoice.Choice(y.ToString(), y.ToString())).ToArray();
    private Task ChooseMonthAsync(string value) { Month = int.Parse(value); return LoadQuoteAsync(); }
    private Task ChooseYearAsync(string value) { Year = int.Parse(value); return LoadQuoteAsync(); }
    private static string Money(decimal amount) => amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-PH"));

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.Menu is null) { Navigation.NavigateTo("/login"); return; }
        var today = Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now);
        if (Year == 0) Year = today.Year;
        if (Month == 0) Month = today.Month;
        await LoadQuoteAsync();
    }

    private async Task LoadQuoteAsync()
    {
        if (Year is < 2000 or > 2100 || Month is < 1 or > 12) { Error = "Choose a valid period."; Quote = null; return; }
        Loading = true;
        Error = null;
        Quote = null;
        try
        {
            var queued = (await Sync.GetAllAsync()).Any(o => o.Kind == OfflineOperationKind.NpmWholePayment
                && o.StallId == StallId && o.BillingYear == Year && o.BillingMonth == Month
                && o.LocalStatus != PendingLocalStatus.Synced);
            if (queued) { Error = "A payment for this period is waiting to sync or needs review. Open Records."; return; }
            var result = await Api.GetNpmWholePaymentQuoteAsync(StallId, Year, Month);
            if (result.IsSuccess) Quote = result.Value;
            else Error = result.Error ?? "The amount could not be reviewed.";
        }
        catch (Exception) { Error = "The amount is unavailable. Connect and review it before collecting."; }
        finally { Loading = false; }
    }

    private async Task ConfirmAsync()
    {
        if (Quote is not { Amount: > 0m } quote || Captured || Saving || quote.Year != Year || quote.Month != Month) return;
        Saving = true;
        Error = null;
        try
        {
            await Sync.EnqueueIssuedDocumentAsync(new PendingOperation
            {
                ClientOperationId = OperationId, Kind = OfflineOperationKind.NpmWholePayment,
                StallId = StallId, BillingYear = quote.Year, BillingMonth = quote.Month,
                BusinessDate = quote.BusinessDate, ReceivedAmount = quote.Amount, NpmQuoteToken = quote.QuoteToken,
                PayloadVersion = 1, FacilityLabel = "NPM", Title = Occupant ?? "Stall payment",
                Detail = $"Stall {SpaceNo} · {quote.Year:D4}-{quote.Month:D2}", Amount = quote.Amount
            });
            Captured = true;
            Notice = "Waiting to sync";
            if (Sync.IsOnline) await Sync.SyncNowAsync();
            var result = (await Sync.GetAllAsync()).FirstOrDefault(o => o.ClientOperationId == OperationId);
            if (result?.ReferenceCode is { } src) Notice = $"Collection recorded · {src}";
            else if (result?.LocalStatus is PendingLocalStatus.Rejected or PendingLocalStatus.ReconciliationRequired)
                Notice = result.ResultMessage ?? "Office review required.";
        }
        catch (Exception) { Error = "The payment could not be saved on this device. Check Records before trying again."; }
        finally { Saving = false; }
    }
}
