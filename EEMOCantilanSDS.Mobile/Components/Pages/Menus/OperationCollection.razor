@page "/operation/{Code}"
@using System.Globalization
@using global::EEMOCantilanSDS.Application.Common.Interface.ApiClients
@using global::EEMOCantilanSDS.Application.Common.Revenue
@using global::EEMOCantilanSDS.Application.Dtos.Mobile
@using global::EEMOCantilanSDS.Application.Dtos.Revenue
@using global::EEMOCantilanSDS.Domain.Enums
@using EEMOCantilanSDS.Mobile.Models
@using EEMOCantilanSDS.Mobile.Services
@using EEMOCantilanSDS.Mobile.Presentation
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@inject IMobileApiClient MobileApi
@inject EEMOCantilanSDS.Mobile.Services.MobileSyncService Sync

@* Focused field collection for a governed configurable service (Market Fees, Landing / Berthing, Transfer Large Cattle,
   Vegetable / Fruit). The collector records transaction facts only: the amount rule, classification and OR/CT
   instrument come from the server's approved setup, and the physical document must be one assigned to this collector.
   The issue is durably queued (with the document's identity) BEFORE it is reported as captured, exactly like WCF. *@
<div class="page-shell">
    <div class="header">
        <div class="header-eyebrow">Operation</div>
        <div class="header-row">
            <button class="back-btn" type="button" @onclick="GoBack" aria-label="Back to menu">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div class="header-title-block">
                <div class="header-title">@Title</div>
                <div class="header-sub">@Subtitle</div>
            </div>
            <img class="header-logo" src="@Session.BrandingSeal" alt="Municipality seal" />
        </div>
    </div>

    <div class="content">
        @if (_loading)
        {
            <LoadingState Text="Loading operation…" />
        }
        else if (_blocked is not null)
        {
            <div class="menu-state-card" role="status">@_blocked</div>
            <button class="btn-primary op-back" type="button" @onclick="GoBack">Back to menu</button>
        }
        else
        {
            @if (_entry is { ModeAware: true })
            {
                <div class="op-modes" role="radiogroup" aria-label="Collection mode">
                    @foreach (var variant in _variants)
                    {
                        <label class="op-mode @(variant.Mode == _mode ? "selected" : "") @(variant.Available ? "" : "disabled")">
                            <input type="radio" name="op-mode" checked="@(variant.Mode == _mode)" disabled="@(!variant.Available)"
                                   @onchange="() => SelectMode(variant.Mode)" />
                            <span class="op-mode-title">@ModeLabel(variant.Mode)</span>
                            <span class="op-mode-sub">@variant.Note</span>
                        </label>
                    }
                </div>
            }

            @if (Variant?.Terms is null)
            {
                <div class="menu-state-card" role="status">@(Variant?.Note ?? "Choose a collection mode.")</div>
            }
            else
            {
                var terms = Variant.Terms;
                var instrument = InstrumentName(terms.Instrument);
                var shortCode = terms.Instrument == RevenueInstrumentType.OfficialReceipt ? "OR" : "CT";

                @* 1 — What the office approved: system-provided, never edited here. *@
                <section class="op-facts" aria-label="Approved terms">
                    <div class="op-facts-main">
                        <span class="op-facts-key">@(terms.Basis switch
                        {
                            GovernedServiceBasis.FixedAmount => "Approved amount",
                            GovernedServiceBasis.VehicleClassRate => "Approved rate",
                            _ => "Amount rule"
                        })</span>
                        <span class="op-facts-amount">@AmountHeadline(terms)</span>
                    </div>
                    <dl class="op-facts-grid">
                        <div><dt>Receipt</dt><dd><span class="op-chip">@shortCode</span> @instrument</dd></div>
                        <div><dt>Business date</dt><dd>@Today.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</dd></div>
                        @if (_mode is { } activeMode)
                        {
                            <div><dt>Mode</dt><dd>@ModeLabel(activeMode)</dd></div>
                        }
                    </dl>
                </section>

                @if (Sync.HasStorageFault)
                {
                    <div class="menu-state-card error" role="alert">Local queue storage needs attention. Do not issue a document until it is healthy.</div>
                }
                else if (NextDocument is null)
                {
                    @* No assigned form: nothing to collect with, and nothing to pick from. *@
                    <section class="op-form op-form-empty" role="status" aria-label="@($"No assigned {instrument}")">
                        <span class="op-form-badge warn">!</span>
                        <div>
                            <div class="op-form-title">No assigned @instrument available</div>
                            <p class="op-form-note">Ask the office to assign @(shortCode == "CT" ? "a Cash Ticket" : "an Official Receipt") range before collecting this operation.</p>
                        </div>
                    </section>
                }
                else
                {
                    @* 2 — What the collector enters. *@
                    <section class="op-entry" aria-labelledby="op-entry-title">
                        <h2 id="op-entry-title" class="op-section-title">Collection details</h2>
                        @if (terms.Basis == GovernedServiceBasis.VehicleClassRate)
                        {
                            @* The collector states the vehicle class; the server's approved rate for it is the amount. A class with no
                               rate in force is never offered, and no price can be typed. *@
                            <label class="form-field">
                                <span class="form-label">Vehicle class</span>
                                <select class="form-input" @bind="_vehicleClass" aria-label="Vehicle class">
                                    <option value="">Select vehicle class</option>
                                    @foreach (var vehicle in terms.VehicleClasses ?? [])
                                    {
                                        <option value="@vehicle.Code">@vehicle.Name · @Money(vehicle.Amount)</option>
                                    }
                                </select>
                            </label>
                        }
                        else if (terms.Basis != GovernedServiceBasis.FixedAmount)
                        {
                            <label class="form-field">
                                <span class="form-label">Amount received</span>
                                <input class="form-input mono-input" type="number" inputmode="decimal" min="0.01" step="0.01"
                                       max="@(terms.MaximumAmount?.ToString(CultureInfo.InvariantCulture))"
                                       placeholder="0.00" @bind="_amount" @bind:event="oninput" />
                            </label>
                        }
                        <label class="form-field">
                            <span class="form-label">Payer <span class="form-optional">optional</span></span>
                            <input class="form-input" type="text" maxlength="200" placeholder="Name as given by the payer" @bind="_payer" @bind:event="oninput" />
                        </label>
                        <label class="form-field">
                            <span class="form-label">Reference <span class="form-optional">optional</span></span>
                            <input class="form-input" type="text" maxlength="200" placeholder="Short note for the record" @bind="_reference" @bind:event="oninput" />
                        </label>
                    </section>

                    @* 3 — The accountable form: resolved for the collector, not picked from a list. *@
                    <section class="op-form" aria-labelledby="op-form-title">
                        <div class="op-form-head">
                            <span class="op-form-badge">@shortCode</span>
                            <div class="op-form-headtext">
                                <h2 id="op-form-title" class="op-form-title">Next assigned @instrument</h2>
                                <span class="op-form-ready">Ready · assigned to you</span>
                            </div>
                        </div>
                        <div class="op-form-serial" aria-label="@($"{instrument} number")">@NextDocument.DocumentNumber</div>
                        <p class="op-form-note">This @(shortCode == "CT" ? "ticket" : "receipt") will be issued when you record the collection.</p>
                        <dl class="op-form-custody">
                            <div><dt>Remaining assigned</dt><dd>@UsableDocuments.Count</dd></div>
                            <div><dt>Range on hand</dt><dd>@NextAccountableDocument.RangeLabel(UsableDocuments)</dd></div>
                        </dl>
                        @if (UsableDocuments.Count > 1)
                        {
                            <button type="button" class="op-form-change" aria-expanded="@(_showDocuments ? "true" : "false")"
                                    @onclick="() => _showDocuments = !_showDocuments">
                                @(_showDocuments ? "Hide assigned forms" : $"Change {(shortCode == "CT" ? "ticket" : "receipt")}")
                            </button>
                            @if (_showDocuments)
                            {
                                <ul class="op-form-list" role="listbox" aria-label="@($"Assigned {instrument}s")">
                                    @foreach (var document in UsableDocuments)
                                    {
                                        var isNext = document.DocumentId == NextDocument.DocumentId;
                                        <li>
                                            <button type="button" role="option" aria-selected="@(isNext ? "true" : "false")"
                                                    class="op-form-option @(isNext ? "selected" : "")"
                                                    @onclick="() => ChooseDocument(document.DocumentId)">
                                                <span>@document.DocumentNumber</span>
                                                @if (isNext) { <span class="op-form-option-tag">Will issue</span> }
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    </section>

                    @* 4 — One action. *@
                    <div class="op-action">
                        <button class="op-cta" type="button" disabled="@(!CanCapture)" @onclick="CaptureAsync">
                            @(_saving ? "Saving…" : $"Record and issue {instrument}")
                        </button>
                        @if (!CanCapture && !_saving && DisabledReason(terms) is { } why)
                        {
                            <p class="op-action-why">@why</p>
                        }
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="op-message" role="status">@_message</div>
            }

            <h2 class="op-section-title op-month-title">This month</h2>
            @if (_recordsFailed)
            {
                <div class="menu-state-card">Your collections could not be loaded. Retry while online.</div>
            }
            else if (_records.Count == 0)
            {
                <div class="menu-state-card">Nothing recorded yet for this operation this month.</div>
            }
            else
            {
                <ul class="op-records">
                    @foreach (var record in _records)
                    {
                        <li class="op-record-row">
                            <div class="op-record-main">
                                <span class="op-record-doc">@record.DocumentNumber</span>
                                <span class="op-record-sub">@record.BusinessDate.ToString("MMM d", CultureInfo.InvariantCulture)@(string.IsNullOrWhiteSpace(record.PayerName) ? "" : " · " + record.PayerName)@(record.Mode is { } m ? " · " + ModeLabel(m) : "")</span>
                            </div>
                            <div class="op-record-side">
                                <span class="op-record-amount">@Money(record.Amount)</span>
                                <span class="op-record-status @(record.Disposition == "Posted" ? "ok" : "")">@record.Disposition</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        }
    </div>
    <BottomNav ActiveTab="menu" />
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private sealed record ModeOption(GovernedServiceMode? Mode, GovernedServiceTermsDto? Terms,
        IReadOnlyList<CashTicketDocumentDto> Documents, string Note)
    {
        public bool Available => Terms is not null && Documents.Count > 0;
    }

    private GovernedServiceCatalog.Entry? _entry;
    private List<ModeOption> _variants = [];
    private GovernedServiceMode? _mode;
    private List<GovernedServiceRecordDto> _records = [];
    private HashSet<Guid> _locallyIssued = [];
    private bool _loading = true;
    private bool _recordsFailed;
    private bool _saving;
    private string? _blocked;
    private string? _message;
    private decimal _amount;
    private string? _payer;
    private string? _reference;
    private Guid? _documentId;
    private string _vehicleClass = string.Empty;

    private string Title => _entry?.Name ?? "Operation";
    private string Subtitle => _entry is { ModeAware: true } ? "Choose whole payment or daily transaction" : "Field collection";
    private DateOnly Today => Session.Menu?.Today ?? DateOnly.FromDateTime(DateTime.Now);
    private ModeOption? Variant => _variants.FirstOrDefault(v => v.Mode == _mode);

    // The assigned forms still usable on this device, in serial order: anything already issued here (including an issue
    // waiting in the offline queue) is excluded, so it can never be offered twice.
    private IReadOnlyList<CashTicketDocumentDto> UsableDocuments =>
        NextAccountableDocument.Usable(Variant?.Documents ?? [], _locallyIssued);

    // The form to issue: the next in serial order, unless the collector deliberately chose another assigned one.
    private CashTicketDocumentDto? NextDocument => NextAccountableDocument.Resolve(UsableDocuments, _documentId);

    private CashTicketDocumentDto? SelectedDocument => NextDocument;

    private bool _showDocuments;

    private void ChooseDocument(Guid documentId)
    {
        _documentId = documentId;
        _showDocuments = false;
    }

    // Why the primary action is unavailable, in the collector's terms.
    private string? DisabledReason(GovernedServiceTermsDto terms) =>
        terms.Basis == GovernedServiceBasis.VehicleClassRate && SelectedVehicleClass is null ? "Select the vehicle class to continue."
        : terms.Basis == GovernedServiceBasis.DirectApprovedAmount && _amount <= 0m ? "Enter the amount received to continue."
        : terms.Basis == GovernedServiceBasis.DirectApprovedAmount && terms.MaximumAmount is { } cap && _amount > cap ? $"The amount cannot exceed {Money(cap)}."
        : terms.Basis == GovernedServiceBasis.DirectApprovedAmount && decimal.Round(_amount, 2, MidpointRounding.ToZero) != _amount ? "Use at most two decimal places."
        : null;

    private static string AmountHeadline(GovernedServiceTermsDto terms) => terms.Basis switch
    {
        GovernedServiceBasis.FixedAmount => Money(terms.FixedAmount ?? 0m),
        GovernedServiceBasis.VehicleClassRate => "By vehicle class",
        _ => terms.MaximumAmount is { } ceiling ? $"As charged · up to {Money(ceiling)}" : "As charged",
    };

    private VehicleClassTermDto? SelectedVehicleClass => Variant?.Terms is { Basis: GovernedServiceBasis.VehicleClassRate } t
        ? t.VehicleClasses?.FirstOrDefault(v => v.Code == _vehicleClass) : null;

    private decimal ExpectedAmount => Variant?.Terms is { Basis: GovernedServiceBasis.VehicleClassRate }
        ? SelectedVehicleClass?.Amount ?? 0m
        : Variant?.Terms is { Basis: GovernedServiceBasis.FixedAmount } fixedTerms
        ? fixedTerms.FixedAmount ?? 0m : _amount;

    // The server revalidates every one of these; they only keep an obviously wrong entry from becoming an issued document.
    private bool CanCapture => !_saving && !Sync.HasStorageFault && Variant is { Available: true, Terms: { } t }
        && SelectedDocument is not null && ExpectedAmount > 0m
        && decimal.Round(ExpectedAmount, 2, MidpointRounding.ToZero) == ExpectedAmount
        && (t.Basis != GovernedServiceBasis.DirectApprovedAmount || t.MaximumAmount is not { } ceiling || ExpectedAmount <= ceiling)
        && (t.Basis != GovernedServiceBasis.VehicleClassRate || SelectedVehicleClass is not null);

    protected override async Task OnInitializedAsync()
    {
        try { await Session.InitializeAsync(); }
        catch (HttpRequestException)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }
        if (Session.Menu is null)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        _entry = GovernedServiceCatalog.Find(Code);
        if (_entry is null)
        {
            _blocked = "This operation is not available on Collector Mobile.";
            _loading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            var capabilities = await MobileApi.GetOperationCapabilitiesAsync();
            if (!capabilities.IsSuccess || capabilities.Value is null)
            {
                _blocked = "Eligibility could not be verified. Retry while online.";
                return;
            }
            var capability = capabilities.Value.Operations.FirstOrDefault(x => x.OperationCode == Code);
            if (capability is null || !capability.IsAssigned)
            {
                _blocked = "This operation is not assigned to you. Ask the office to assign it.";
                return;
            }
            if (!capability.IsCollectible)
            {
                _blocked = CapabilityMessage(capability.Status);
                return;
            }

            _blocked = null;
            var modes = _entry!.ModeAware
                ? new GovernedServiceMode?[] { GovernedServiceMode.WholePayment, GovernedServiceMode.DailyTransaction }
                : new GovernedServiceMode?[] { null };
            _variants = [];
            foreach (var mode in modes)
            {
                var terms = await MobileApi.GetOperationTermsAsync(Code, mode);
                var documents = terms.IsSuccess
                    ? await MobileApi.GetOperationDocumentsAsync(Code, mode)
                    : null;
                var list = documents is { IsSuccess: true, Value: not null } ? documents.Value : [];
                _variants.Add(new ModeOption(mode, terms.IsSuccess ? terms.Value : null, list,
                    terms.IsSuccess
                        ? list.Count == 0
                            ? $"You hold no assigned {InstrumentName(terms.Value!.Instrument)}."
                            : $"{InstrumentName(terms.Value!.Instrument)} · {list.Count} held"
                        : terms.Error ?? "Not available today."));
            }
            _mode = _variants.FirstOrDefault(v => v.Available)?.Mode ?? _variants[0].Mode;

            _locallyIssued.Clear();
            foreach (var queued in await Sync.GetAllAsync())
                if (queued.Kind == OfflineOperationKind.GovernedService && queued.AccountableDocumentId is { } id)
                    _locallyIssued.Add(id);
            if (_documentId is { } selected && !UsableDocuments.Any(d => d.DocumentId == selected))
                _documentId = null;

            await LoadRecordsAsync();
        }
        catch (HttpRequestException)
        {
            _blocked = "Eligibility could not be verified. Retry while online.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRecordsAsync()
    {
        var start = new DateOnly(Today.Year, Today.Month, 1);
        var result = await MobileApi.GetOperationRecordsAsync(start, Today);
        _recordsFailed = !result.IsSuccess || result.Value is null;
        _records = _recordsFailed ? [] : result.Value!.Where(x => x.OperationCode == Code).ToList();
    }

    private void SelectMode(GovernedServiceMode? mode)
    {
        _mode = mode;
        _documentId = null;
        _amount = 0m;
        _vehicleClass = string.Empty;
        _message = null;
    }

    private async Task CaptureAsync()
    {
        if (!CanCapture || Variant?.Terms is not { } terms || SelectedDocument is not { } document)
        {
            _message = Sync.HasStorageFault
                ? "Local queue storage is not healthy. Do not issue a document."
                : "Check the amount and choose one of your assigned documents.";
            return;
        }

        _saving = true;
        _message = null;
        var operationId = Guid.NewGuid();
        var amount = ExpectedAmount;
        var operation = new PendingOperation
        {
            ClientOperationId = operationId,
            Kind = OfflineOperationKind.GovernedService,
            PayloadVersion = 1,
            BusinessDate = Today,
            OperationCode = Code,
            CollectionMode = _mode,
            PayerName = string.IsNullOrWhiteSpace(_payer) ? null : _payer.Trim(),
            Reference = string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim(),
            VehicleClassCode = terms.Basis == GovernedServiceBasis.VehicleClassRate ? _vehicleClass : null,
            ReceivedAmount = amount,
            AccountableDocumentId = document.DocumentId,
            DocumentNumber = document.DocumentNumber,
            IssuedAtUtc = DateTime.UtcNow,
            FacilityLabel = Title,
            Title = string.IsNullOrWhiteSpace(_payer) ? Title : _payer!.Trim(),
            Detail = $"{Title}{(_mode is { } m ? " · " + ModeLabel(m) : "")}{(SelectedVehicleClass is { } vc ? " · " + vc.Name : "")} · {InstrumentName(terms.Instrument)} {document.DocumentNumber}",
            Amount = amount
        };

        try
        {
            // The durable local write binds the physical document to its immutable operation before this screen
            // reports the issue as captured or starts synchronization.
            await Sync.EnqueueIssuedDocumentAsync(operation);
            _locallyIssued.Add(document.DocumentId);
            _message = $"{InstrumentName(terms.Instrument)} issue saved on this device. The document is unavailable for reuse.";
            if (Sync.IsOnline)
                await Sync.SyncNowAsync(force: true);
            var result = (await Sync.GetAllAsync()).FirstOrDefault(x => x.ClientOperationId == operationId);
            if (result?.LocalStatus == PendingLocalStatus.Synced)
                _message = $"{InstrumentName(terms.Instrument)} acknowledged by the server. It remains consumed.";
            else if (result?.LocalStatus == PendingLocalStatus.ReconciliationRequired)
                _message = $"RECONCILIATION REQUIRED. Keep this physical {InstrumentName(terms.Instrument)}; office review is required.";
            else if (result is not null)
                _message = $"{InstrumentName(terms.Instrument)} issue is durably queued and awaiting synchronization.";
            _amount = 0m;
            _vehicleClass = string.Empty;
            _documentId = null;
            _payer = null;
            _reference = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            _message = "The physical document and operation could not be safely saved. Do not issue the document; resolve device storage attention first.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/menu", forceLoad: false);

    private static string Money(decimal amount) => $"₱{amount.ToString("N2", CultureInfo.InvariantCulture)}";

    private static string ModeLabel(GovernedServiceMode? mode) =>
        mode == GovernedServiceMode.WholePayment ? "Whole payment" : "Daily transaction";

    private static string InstrumentName(RevenueInstrumentType instrument) =>
        instrument == RevenueInstrumentType.OfficialReceipt ? "Official Receipt" : "Cash Ticket";

    private static string AmountRule(GovernedServiceTermsDto terms) => terms.Basis switch
    {
        GovernedServiceBasis.FixedAmount => $"{Money(terms.FixedAmount ?? 0m)} (fixed)",
        GovernedServiceBasis.VehicleClassRate => "Approved rate by vehicle class",
        _ => terms.MaximumAmount is { } ceiling ? $"As charged, up to {Money(ceiling)}" : "As charged"
    };

    private static string CapabilityMessage(CollectorOperationCapabilityStatus status) => status switch
    {
        CollectorOperationCapabilityStatus.AssignedButInactive => "Your authorization is not active. Contact the office.",
        CollectorOperationCapabilityStatus.NeedsPolicy => "The office has not finished setting this operation up.",
        CollectorOperationCapabilityStatus.NeedsDocument => "You hold no assigned document for this operation. Request one from the office.",
        CollectorOperationCapabilityStatus.Unsupported => "This operation is not available on Collector Mobile yet.",
        _ => "This operation is not collectible right now."
    };
}
