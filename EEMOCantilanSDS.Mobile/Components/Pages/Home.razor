@page "/"
@inject NavigationManager Navigation
@inject EEMOCantilanSDS.Mobile.Services.MobileSessionService Session
@implements IDisposable
@using EEMOCantilanSDS.Mobile.Presentation

@* The launch continuation (Mobile V3). The native splash shows the StallTrack icon on the same light canvas; this screen
   picks up from it with the seal at a similar scale, so the start reads as one state handing over to the app — not a
   second, promotional splash. It is tenant-neutral (a device bound to another LGU never sees Cantilan first), adds no
   fixed wait, and says something only once the wait is noticeable. Session restore semantics are unchanged. *@
<main class="launch">
    <div class="launch-mark">
        <img class="launch-seal" src="images/stalltrack-seal-circle.png" alt="" aria-hidden="true" />
        <h1 class="launch-word">StallTrack</h1>
        <p class="launch-sub">Collector Mobile</p>
        <span class="launch-rule" aria-hidden="true"></span>
    </div>

    @if (_status is not null)
    {
        <div class="launch-status" role="status">
            <span class="launch-spinner" aria-hidden="true"></span>
            <span>@_status</span>
        </div>
    }
</main>

@code {
    private string? _status;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // Restore begins at once; nothing waits for the brand to be admired.
            var started = DateTime.UtcNow;
            var restoreTask = Session.RestoreSessionAsync();

            while (!restoreTask.IsCompleted && !_cts.IsCancellationRequested)
            {
                var elapsed = DateTime.UtcNow - started;
                var next = elapsed < LaunchState.QuietPeriod ? LaunchState.QuietPeriod
                    : elapsed < LaunchState.LongWait ? LaunchState.LongWait
                    : (TimeSpan?)null;
                if (next is { } threshold)
                    await Task.WhenAny(restoreTask, Task.Delay(threshold - elapsed, _cts.Token));
                else
                    await restoreTask;

                var status = LaunchState.StatusFor(DateTime.UtcNow - started);
                if (!restoreTask.IsCompleted && status != _status)
                {
                    _status = status;
                    StateHasChanged();
                }
            }

            var restored = await restoreTask;
            if (_cts.IsCancellationRequested) return;
            Navigation.NavigateTo(LaunchState.RouteFor(restored), forceLoad: false);
        }
        catch (HttpRequestException)
        {
            Navigation.NavigateTo(LaunchState.RouteFor(false), forceLoad: false);
        }
        catch (TaskCanceledException) when (!_cts.IsCancellationRequested)
        {
            Navigation.NavigateTo(LaunchState.RouteFor(false), forceLoad: false);
        }
        catch (TaskCanceledException)
        {
            // Component disposed before navigation — safe to ignore.
        }
    }

    public void Dispose() => _cts.Cancel();
}
