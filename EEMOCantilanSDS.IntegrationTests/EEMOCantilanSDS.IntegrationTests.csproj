<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests that run against a REAL PostgreSQL, in two flavours:

    · Throwaway database (default). A container is started for the test run, the EF migrations are applied to a
      blank database, each test seeds only what it needs, and the container is dropped afterwards. Nothing has to
      be installed or restored by hand; it needs a Docker-compatible runtime, and skips honestly when there is
      none. This is what proves the SQL our repositories actually emit.

    · Restored snapshot (opt-in, read-only). Set STALLTRACK_SNAPSHOT_DB to check the office's real history for
      agreement between screens — something a blank database cannot tell us. Those tests never write, the target
      must be a local host whose database name looks like a snapshot, and they report as skipped when it is unset.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EEMOCantilanSDS.Application\EEMOCantilanSDS.Application.csproj" />
    <ProjectReference Include="..\EEMOCantilanSDS.Domain\EEMOCantilanSDS.Domain.csproj" />
    <ProjectReference Include="..\EEMOCantilanSDS.Infrastructure\EEMOCantilanSDS.Infrastructure.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Result<T> and CursorPagedResult<T> moved from Domain.Common to Application.Common. Declared globally rather
         than adding one using line to several hundred files: the move is about where the types BELONG, and a diff that
         touched every handler would have buried that. -->
    <Using Include="EEMOCantilanSDS.Application.Common" />
  </ItemGroup>
</Project>
