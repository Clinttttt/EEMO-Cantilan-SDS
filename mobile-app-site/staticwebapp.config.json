{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/.well-known/assetlinks.json",
      "headers": { "content-type": "application/json" }
    },
    {
      "route": "/download/stalltrack-collector-latest.apk",
      "redirect": "https://github.com/Clinttttt/EEMO-Cantilan-SDS/releases/latest/download/stalltrack-collector-latest.apk",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/download/*", "/assets/*", "/.well-known/*", "*.apk", "*.png", "*.css", "*.js"]
  },
  "mimeTypes": {
    ".apk": "application/vnd.android.package-archive",
    ".json": "application/json"
  },
  "globalHeaders": {
    "cache-control": "no-cache"
  }
}
